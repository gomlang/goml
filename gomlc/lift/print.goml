package lift;

use module::pretty;
use module::repr;
use std::text;

fn arguments(values: Vec[pretty::Doc]) -> pretty::Doc {
    pretty::delimited("(", ",", ")", values)
}

fn dyn_method_name(value: string) -> string {
    match text::rfind(value, "#") {
        Some(index) => value.byte_slice(index + 1, value.byte_len()),
        None => value,
    }
}

fn callable_doc(value: repr::Callable) -> pretty::Doc {
    match value {
        Function(name) => pretty::text(name),
        LangItem { item: _, function_name } => pretty::text(function_name),
        Runtime(name) => pretty::text("@runtime(" + name + ")"),
        CallbackAdapter(value) => pretty::text(
            if value.to_go {
                "@callback(to_go)"
            } else {
                "@callback(to_closure)"
            },
        ),
        Intrinsic(name) => pretty::text("@intrinsic(" + name + ")"),
        InterfaceBridge(value) => pretty::text(
            "@go_interface_bridge(" + repr::diagnostic_type_text(value.target) + ")",
        ),
        GoMethod { symbol, binding } => pretty::text("@go_method(" + symbol + ")"),
        GoForeign { import_path, symbol, binding } => {
            pretty::text("@go_ffi(" + import_path + ", " + symbol + ")")
        },
        TraitMethod { trait_ref: reference, method_name: name, .. } => pretty::concat(
            Vec::from_array([repr::trait_ref_doc(reference), pretty::text("::" + name)]),
        ),
        DynTraitMethod { trait_name: owner, dispatch_name: _, method_name: name } => {
            pretty::text("dyn " + owner + "::" + name)
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            pretty::text(repr::inherent_method_name(owner, name))
        },
    }
}

fn exprs_doc(values: Vec[Expr]) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(expr_doc(value))
    }
    result
}

fn constructor_doc(constructor: repr::Constructor, args: Vec[Expr]) -> pretty::Doc {
    if constructor.is_struct {
        if constructor.fields.is_empty() && args.is_empty() {
            pretty::text(constructor.name + " {}")
        } else if constructor.fields.len() == args.len() {
            let fields: Vec[pretty::Doc] = Vec::with_capacity(args.len());
            for index in 0..args.len() {
                fields.push(
                    pretty::concat(
                        Vec::from_array(
                            [pretty::text(constructor.fields[index] + ": "), expr_doc(args[index])],
                        ),
                    ),
                )
            }
            pretty::record(constructor.name, fields)
        } else if !args.is_empty() {
            pretty::append(pretty::text(constructor.name), arguments(exprs_doc(args)))
        } else {
            pretty::text(constructor.name)
        }
    } else if !args.is_empty() {
        pretty::append(pretty::text(constructor.name), arguments(exprs_doc(args)))
    } else {
        pretty::text(constructor.name)
    }
}

fn block_docs(value: Block) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(value.stmts.len() + 1);
    for statement in value.stmts {
        result.push(
            pretty::group(
                pretty::concat(
                    Vec::from_array(
                        [
                            pretty::text("let " + statement.name + " ="),
                            pretty::nest(
                                2,
                                pretty::append(pretty::line(), expr_doc(statement.value)),
                            ),
                            pretty::text(" in"),
                        ],
                    ),
                ),
            ),
        )
    }
    match value.tail {
        Some(tail) => result.push(expr_doc(tail)),
        None => result.push(pretty::text("()")),
    }
    result
}

fn arm_doc(value: Arm) -> pretty::Doc {
    pretty::concat(
        Vec::from_array(
            [
                pretty::append(expr_doc(value.lhs), pretty::text(" => ")),
                pretty::braced(Vec::from_array([expr_doc(value.body)]), 2),
                pretty::text(","),
            ],
        ),
    )
}

fn select_arm_doc(value: SelectArm) -> pretty::Doc {
    match value {
        Receive { channel, guard, binding, binding_ty: _, body } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("recv("),
                    expr_doc(channel),
                    match guard {
                        Some(value) => pretty::concat(
                            Vec::from_array(
                                [
                                    pretty::text(") when "),
                                    expr_doc(value),
                                    pretty::text(" as " + binding + " => "),
                                ],
                            ),
                        ),
                        None => pretty::text(") as " + binding + " => "),
                    },
                    pretty::braced(Vec::from_array([expr_doc(body)]), 2),
                    pretty::text(","),
                ],
            ),
        ),
        Send { channel, value, guard, body } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("send("),
                    expr_doc(channel),
                    pretty::text(", "),
                    expr_doc(value),
                    match guard {
                        Some(value) => pretty::concat(
                            Vec::from_array(
                                [pretty::text(") when "), expr_doc(value), pretty::text(" => ")],
                            ),
                        ),
                        None => pretty::text(") => "),
                    },
                    pretty::braced(Vec::from_array([expr_doc(body)]), 2),
                    pretty::text(","),
                ],
            ),
        ),
    }
}

fn expr_doc(value: Expr) -> pretty::Doc {
    match value {
        Var { name, ty: _ } => pretty::text(name),
        Callable { callable, ty: _ } => callable_doc(callable),
        Prim { value, ty: _ } => repr::primitive_doc(value),
        Constr { constructor, args, ty: _ } => constructor_doc(constructor, args),
        Tuple { items: values, ty: _ } => arguments(exprs_doc(values)),
        Array { items: values, ty: _ } => {
            pretty::delimited("[", ",", "]", exprs_doc(values))
        },
        Block { block, ty: _ } => pretty::stack(block_docs(block)),
        Match { expr: source, arms, default, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(arm_doc(arm))
            }
            if let Some(value) = default {
                values.push(
                    pretty::group(
                        pretty::concat(
                            Vec::from_array(
                                [
                                    pretty::text("_ =>"),
                                    pretty::nest(2, pretty::append(pretty::line(), expr_doc(value))),
                                    pretty::text(","),
                                ],
                            ),
                        ),
                    ),
                )
            }
            pretty::block(pretty::append(pretty::text("match "), expr_doc(source)), values)
        },
        Select { mode, arms, default, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(select_arm_doc(arm))
            }
            if let Some(value) = default {
                values.push(
                    pretty::concat(
                        Vec::from_array(
                            [
                                pretty::text("default => "),
                                pretty::braced(Vec::from_array([expr_doc(value)]), 2),
                                pretty::text(","),
                            ],
                        ),
                    ),
                )
            }
            pretty::block(
                pretty::text(
                    match mode {
                        Normal => "select",
                        Priority => "select priority",
                    },
                ),
                values,
            )
        },
        If { cond, then_branch, else_branch, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::append(pretty::text("if "), expr_doc(cond)),
                    pretty::text(" "),
                    pretty::braced(Vec::from_array([expr_doc(then_branch)]), 4),
                    pretty::text(" else "),
                    pretty::braced(Vec::from_array([expr_doc(else_branch)]), 4),
                ],
            ),
        ),
        While { cond, body, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::append(pretty::text("while "), expr_doc(cond)),
                    pretty::text(" "),
                    pretty::braced(Vec::from_array([expr_doc(body)]), 4),
                ],
            ),
        ),
        Loop { body, ty: _ } => {
            pretty::append(pretty::text("loop "), expr_doc(body))
        },
        Break { target, value, ty: _ } => match value {
            Some(value) => pretty::append(
                pretty::text(
                    if target == 0 {
                        "break "
                    } else {
                        f"break@{target} "
                    },
                ),
                expr_doc(value),
            ),
            None => pretty::text(
                if target == 0 {
                    "break"
                } else {
                    f"break@{target}"
                },
            ),
        },
        Continue { target, ty: _ } => pretty::text(
            if target == 0 {
                "continue"
            } else {
                f"continue@{target}"
            },
        ),
        Return { expr: value, ty: _ } => match value {
            Some(value) => pretty::append(pretty::text("return "), expr_doc(value)),
            None => pretty::text("return"),
        },
        Go { expr: value, ty: _ } => {
            pretty::append(pretty::text("go "), expr_doc(value))
        },
        ConstrGet { expr: value, constructor, field_index, ty: _ } => {
            let field = if constructor.is_struct && field_index < constructor.fields.len() {
                constructor.fields[field_index]
            } else {
                f"_{field_index}"
            };
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(constructor.name + "." + field),
                        arguments(Vec::from_array([expr_doc(value)])),
                    ],
                ),
            )
        },
        Unary { op, expr: value, ty: _ } => pretty::concat(
            Vec::from_array(
                [pretty::text("(" + repr::unary_symbol(op)), expr_doc(value), pretty::text(")")],
            ),
        ),
        Cast { expr: value, ty } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("("),
                    expr_doc(value),
                    pretty::text(" as "),
                    repr::type_doc(ty),
                    pretty::text(")"),
                ],
            ),
        ),
        Binary { op, lhs, rhs, ty: _ } => pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text("("),
                        expr_doc(lhs),
                        pretty::text(" " + repr::binary_symbol(op)),
                        pretty::nest(2, pretty::append(pretty::line(), expr_doc(rhs))),
                        pretty::text(")"),
                    ],
                ),
            ),
        ),
        Assign { name, value, target_ty: _, ty: _ } => pretty::concat(
            Vec::from_array([pretty::text(name + " = "), expr_doc(value)]),
        ),
        Call { func: function, args, ty: _ } => {
            pretty::append(expr_doc(function), arguments(exprs_doc(args)))
        },
        ToDyn { trait_name, for_ty, expr: value, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("to_dyn[" + trait_name + "]{"),
                    repr::type_doc(for_ty),
                    pretty::text("}"),
                    arguments(Vec::from_array([expr_doc(value)])),
                ],
            ),
        ),
        DynCall { trait_name, method_name, receiver, args, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(args.len() + 1);
            values.push(expr_doc(receiver));
            for arg in args {
                values.push(expr_doc(arg))
            }
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(
                            "dyn_call[" + trait_name + "::" + dyn_method_name(method_name) + "]",
                        ),
                        arguments(values),
                    ],
                ),
            )
        },
        PackClosure { environment, apply, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("pack_closure[" + apply + "]"),
                    arguments(Vec::from_array([expr_doc(environment)])),
                ],
            ),
        ),
        Proj { tuple: value, index, ty: _ } => {
            pretty::append(expr_doc(value), pretty::text(f".{index}"))
        },
    }
}

fn params_doc(values: Vec[(string, repr::Type)]) -> pretty::Doc {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            pretty::concat(Vec::from_array([pretty::text(value.0 + ": "), repr::type_doc(value.1)])),
        )
    }
    arguments(result)
}

fn function_doc(value: Function) -> pretty::Doc {
    pretty::block(
        pretty::concat(
            Vec::from_array(
                [
                    pretty::text("fn " + value.name),
                    params_doc(value.params),
                    pretty::text(" -> "),
                    repr::type_doc(value.ret_ty),
                ],
            ),
        ),
        block_docs(value.body),
    )
}

pub fn encode(value: File) -> string {
    let constants: Vec[pretty::Doc] = Vec::with_capacity(value.constants.len());
    for value in value.constants {
        constants.push(repr::constant_doc(value))
    }
    for value in value.statics {
        constants.push(repr::static_doc(value))
    }
    let functions: Vec[pretty::Doc] = Vec::with_capacity(value.functions.len());
    for value in value.functions {
        functions.push(function_doc(value))
    }
    let constants_doc = pretty::stack(constants);
    let functions_doc = pretty::join(
        pretty::concat(Vec::from_array([pretty::hardline(), pretty::hardline()])),
        functions,
    );
    let result = if !constants.is_empty() && !value.functions.is_empty() {
        pretty::concat(
            Vec::from_array([constants_doc, pretty::hardline(), pretty::hardline(), functions_doc]),
        )
    } else {
        pretty::append(constants_doc, functions_doc)
    };
    pretty::pretty(100, result)
}
