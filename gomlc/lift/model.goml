package lift;

use module::ast;
use module::repr;

pub struct File {
    pub functions: Vec[Function],
    pub enums: Vec[repr::EnumDef],
    pub structs: Vec[repr::StructDef],
    pub type_instances: Vec[repr::TypeInstance],
    pub constants: Vec[repr::Constant],
    pub statics: Vec[repr::Static],
    pub closure_defs: Vec[repr::ClosureDef],
}

pub struct Function {
    pub name: string,
    pub origin: FunctionOrigin,
    pub root: bool,
    pub trait_impl: Option[TraitImpl],
    pub params: Vec[(string, repr::Type)],
    pub ret_ty: repr::Type,
    pub body: Block,
}

pub enum FunctionOrigin {
    Source,
    Inherent {
        owner: repr::Type,
        method_name: string,
    },
    TraitImplementation {
        method_name: string,
    },
}

pub struct TraitImpl {
    pub trait_ref: repr::TraitRef,
    pub for_ty: repr::Type,
    pub associated_types: Vec[(string, repr::Type)],
}

pub struct LetStmt {
    pub name: string,
    pub value: Expr,
    pub ty: repr::Type,
}

pub struct Block {
    pub stmts: Vec[LetStmt],
    pub tail: Option[Expr],
}

pub enum SelectArm {
    Receive {
        channel: Expr,
        guard: Option[Expr],
        binding: string,
        binding_ty: repr::Type,
        body: Expr,
    },
    Send {
        channel: Expr,
        value: Expr,
        guard: Option[Expr],
        body: Expr,
    },
}

pub enum Expr {
    Var {
        name: string,
        ty: repr::Type,
    },
    Callable {
        callable: repr::Callable,
        ty: repr::Type,
    },
    Prim {
        value: repr::Primitive,
        ty: repr::Type,
    },
    Constr {
        constructor: repr::Constructor,
        args: Vec[Expr],
        ty: repr::Type,
    },
    Tuple {
        items: Vec[Expr],
        ty: repr::Type,
    },
    Array {
        items: Vec[Expr],
        ty: repr::Type,
    },
    Block {
        block: Block,
        ty: repr::Type,
    },
    Match {
        expr: Expr,
        arms: Vec[Arm],
        default: Option[Expr],
        ty: repr::Type,
    },
    Select {
        mode: ast::SelectMode,
        arms: Vec[SelectArm],
        default: Option[Expr],
        ty: repr::Type,
    },
    If {
        cond: Expr,
        then_branch: Expr,
        else_branch: Expr,
        ty: repr::Type,
    },
    While {
        cond: Expr,
        body: Expr,
        ty: repr::Type,
    },
    Loop {
        body: Expr,
        ty: repr::Type,
    },
    Break {
        target: isize,
        value: Option[Expr],
        ty: repr::Type,
    },
    Continue {
        target: isize,
        ty: repr::Type,
    },
    Return {
        expr: Option[Expr],
        ty: repr::Type,
    },
    Go {
        expr: Expr,
        ty: repr::Type,
    },
    ConstrGet {
        expr: Expr,
        constructor: repr::Constructor,
        field_index: isize,
        ty: repr::Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: Expr,
        ty: repr::Type,
    },
    Cast {
        expr: Expr,
        ty: repr::Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: Expr,
        rhs: Expr,
        ty: repr::Type,
    },
    Assign {
        name: string,
        value: Expr,
        target_ty: repr::Type,
        ty: repr::Type,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
        ty: repr::Type,
    },
    ToDyn {
        trait_name: string,
        for_ty: repr::Type,
        expr: Expr,
        ty: repr::Type,
    },
    DynCall {
        trait_name: string,
        method_name: string,
        receiver: Expr,
        args: Vec[Expr],
        ty: repr::Type,
    },
    Proj {
        tuple: Expr,
        index: isize,
        ty: repr::Type,
    },
    PackClosure {
        environment: Expr,
        apply: string,
        ty: repr::Type,
    },
}

pub struct Arm {
    pub lhs: Expr,
    pub body: Expr,
}

pub fn expr_type(value: Expr) -> repr::Type {
    match value {
        Var { ty, .. } | Callable { ty, .. } | Prim { ty, .. } | Constr { ty, .. } | Tuple {
            ty,
            ..,
        } | Array { ty, .. } | Block { ty, .. } | Match { ty, .. } | Select { ty, .. } | If {
            ty,
            ..,
        } | While { ty, .. } | Loop { ty, .. } | Break { ty, .. } | Continue { ty, .. } | Return {
            ty,
            ..,
        } | Go { ty, .. } | ConstrGet { ty, .. } | Unary { ty, .. } | Cast { ty, .. } | Binary {
            ty,
            ..,
        } | Assign { ty, .. } | Call { ty, .. } | ToDyn { ty, .. } | DynCall { ty, .. } | Proj {
            ty,
            ..,
        } | PackClosure { ty, .. } => ty,
    }
}
