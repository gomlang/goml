package lift;

use module::mono;

fn empty_file() -> File {
    File {
        functions: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
        closure_defs: Vec::new(),
    }
}

fn finish_lowering(value: LambdaLiftResult) -> Result[File, string] {
    match value.error {
        Some(message) => Result::Err(message),
        None => {
            let file = detach_file(value.file);
            validate(file).map(|_| file).map_err(|message| "invalid Lift IR: " + message)
        },
    }
}

pub fn lower_checked(value: mono::File) -> Result[File, string] {
    finish_lowering(lambda_lift(value))
}

pub fn lower_checked_with_counter(value: mono::File, counter: Ref[isize]) -> Result[File, string] {
    finish_lowering(lambda_lift_with_counter(value, counter))
}

pub fn lower(value: mono::File) -> File {
    lower_checked(value).unwrap_or_else(|_| empty_file())
}

pub fn lower_with_counter(value: mono::File, counter: Ref[isize]) -> File {
    lower_checked_with_counter(value, counter).unwrap_or_else(|_| empty_file())
}

pub fn lower_checked_with_source_names(
    value: mono::File,
    counter: Ref[isize],
    source_names: Vec[(string, string)],
) -> Result[File, string] {
    finish_lowering(lambda_lift_with_source_names(value, counter, source_names))
}
