package lift;

use module::mono;
use std::ascii;
use std::collections;
use std::text;

struct ScopeEntry {
    name: string,
    ty: mono::Type,
    closure_struct: Option[string],
}

struct ClosureInfo {
    struct_name: string,
    apply_name: string,
    apply_ty: mono::Type,
    signature: mono::Type,
}

struct Capture {
    name: string,
    ty: mono::Type,
}

struct State {
    source_names: Vec[(string, string)],
    source_owner: Ref[string],
    next_env: Ref[isize],
    next_name: Ref[isize],
    generated: Vec[LowerFunction],
    generated_structs: Vec[mono::StructDef],
    closures_by_struct: collections::IndexMap[string, ClosureInfo],
    closures_by_apply: HashMap[string, ClosureInfo],
    used_types: collections::HashSet[string],
    error: Ref[Option[string]],
}

struct LambdaLiftResult {
    file: LowerFile,
    error: Option[string],
}

fn invalid_expr(state: State, ty: mono::Type, message: string) -> LowerExpr {
    if let None = state.error.get() {
        state.error.set(Option::Some(message))
    }
    LowerExpr::Prim { value: mono::Primitive::Unit, ty }
}

fn copy_scope(values: Vec[ScopeEntry]) -> Vec[ScopeEntry] {
    let result: Vec[ScopeEntry] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn find_scope(values: Vec[ScopeEntry], name: string) -> Option[ScopeEntry] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_closure(state: State, name: string) -> Option[ClosureInfo] {
    state.closures_by_struct.get(name)
}

fn find_closure_by_apply(state: State, name: string) -> Option[ClosureInfo] {
    state.closures_by_apply[name]
}

fn record_closure(state: State, value: ClosureInfo) -> () {
    let _ = state.closures_by_struct.insert(value.struct_name, value);
    state.closures_by_apply[value.apply_name] = value;
}

fn closure_for_type(state: State, ty: mono::Type) -> Option[ClosureInfo] {
    match ty {
        Named { name } => find_closure(state, name),
        _ => Option::None,
    }
}

fn record_used_type(values: collections::HashSet[string], name: string) -> () {
    let _ = values.insert(name);
}

fn collect_used_types(values: collections::HashSet[string], ty: mono::Type) -> () {
    match ty {
        Named { name } => record_used_type(values, name),
        Tuple { items } => {
            for item in items {
                collect_used_types(values, item)
            }
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => collect_used_types(
            values,
            elem,
        ),
        HashMap { key, value } => {
            collect_used_types(values, key);
            collect_used_types(values, value)
        },
        GoMap { key, value } => {
            collect_used_types(values, key);
            collect_used_types(values, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_used_types(values, param)
            }
            collect_used_types(values, ret_ty)
        },
        _ => (),
    }
}

fn collect_used_exprs(values: collections::HashSet[string], exprs: Vec[mono::Expr]) -> () {
    for expr in exprs {
        collect_used_expr(values, expr)
    }
}

fn collect_used_optional_expr(values: collections::HashSet[string], expr: Option[mono::Expr]) -> () {
    if let Some(expr) = expr {
        collect_used_expr(values, expr)
    }
}

fn collect_used_block(values: collections::HashSet[string], block: mono::Block) -> () {
    for stmt in block.stmts {
        collect_used_types(values, stmt.ty);
        collect_used_expr(values, stmt.value)
    }
    collect_used_optional_expr(values, block.tail)
}

fn collect_used_expr(values: collections::HashSet[string], expr: mono::Expr) -> () {
    collect_used_types(values, mono::expr_type(expr));
    match expr {
        Constr { constructor: _, args, ty: _ } => collect_used_exprs(values, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            collect_used_exprs(values, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                collect_used_types(values, param.ty)
            }
            collect_used_expr(values, body)
        },
        Block { block, ty: _ } => collect_used_block(values, block),
        Match { expr: scrutinee, arms, default, ty: _ } => {
            collect_used_expr(values, scrutinee);
            for arm in arms {
                collect_used_expr(values, arm.lhs);
                collect_used_expr(values, arm.body)
            }
            collect_used_optional_expr(values, default)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty, body } => {
                        collect_used_types(values, binding_ty);
                        collect_used_expr(values, channel);
                        collect_used_optional_expr(values, guard);
                        collect_used_expr(values, body)
                    },
                    Send { channel, value, guard, body } => {
                        collect_used_expr(values, channel);
                        collect_used_expr(values, value);
                        collect_used_optional_expr(values, guard);
                        collect_used_expr(values, body)
                    },
                }
            }
            collect_used_optional_expr(values, default)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            collect_used_expr(values, cond);
            collect_used_expr(values, then_);
            collect_used_expr(values, else_)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            collect_used_expr(values, cond);
            collect_used_expr(values, body)
        },
        Loop { body, ty: _ } => collect_used_expr(values, body),
        Return { expr, ty: _ } => collect_used_optional_expr(values, expr),
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | Proj { tuple: expr, index: _, ty: _ } => collect_used_expr(
            values,
            expr,
        ),
        Assign { name: _, value: expr, target_ty, ty: _ } => {
            collect_used_types(values, target_ty);
            collect_used_expr(values, expr)
        },
        Call { func, args, ty: _ } => {
            collect_used_expr(values, func);
            collect_used_exprs(values, args)
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            collect_used_types(values, for_ty);
            collect_used_expr(values, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_used_expr(values, receiver);
            collect_used_exprs(values, args)
        },
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_used_expr(values, expr)
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
    }
}

fn initial_used_types(value: mono::File) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    for function in value.functions {
        for param in function.params {
            collect_used_types(result, param.1)
        }
        collect_used_types(result, function.ret_ty);
        if let Some(value) = function.trait_impl {
            collect_used_types(result, value.for_ty);
            for associated in value.associated_types {
                collect_used_types(result, associated.1)
            }
        }
        collect_used_block(result, function.body)
    }
    result
}

fn primary_name(value: string) -> string {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'/' {
            return value.byte_slice(0, index)
        }
    }
    value
}

fn sanitize_name(value: string) -> Option[string] {
    let value = primary_name(value);
    let builder = text::StringBuilder::new();
    let mut pending_separator = false;
    let mut wrote = false;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if ascii::is_alphanumeric(byte) {
            if pending_separator && wrote {
                builder.write_char('_')
            }
            if !wrote && byte >= b'0' && byte <= b'9' {
                builder.write_char('_')
            }
            builder.write_string(value.byte_slice(index, index + 1));
            pending_separator = false;
            wrote = true;
        } else if wrote {
            pending_separator = true;
        }
    }
    if wrote {
        Option::Some(builder.finish())
    } else {
        Option::None
    }
}

fn fresh_struct_name(state: State, hint: Option[string]) -> string {
    loop {
        let index = state.next_env.get();
        state.next_env.set(index + 1);
        let candidate = match hint {
            Some(name) => f"closure_env_{name}_{index}",
            None => f"closure_env_{index}",
        };
        if state.used_types.insert(candidate) {
            return candidate
        }
    }
}

fn fresh_name(state: State, prefix: string) -> string {
    let index = state.next_name.get();
    state.next_name.set(index + 1);
    f"{prefix}{index}"
}

fn trailing_number(value: string) -> Option[isize] {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'/' {
            return Option::None
        }
    }
    if value.byte_len() == 0 {
        Option::None
    } else {
        let mut start = value.byte_len();
        let mut index = value.byte_len();
        while index > 0 {
            let next = index - 1;
            let byte = value.byte_get(next);
            if byte >= b'0' && byte <= b'9' {
                start = next;
                index = next;
            } else {
                break
            }
        }
        if start == value.byte_len() {
            Option::None
        } else {
            Option::Some(parse_digits(value, start))
        }
    }
}

fn parse_digits(value: string, start: isize) -> isize {
    let mut result = 0;
    for index in start..value.byte_len() {
        let byte = value.byte_get(index);
        let digit = if byte == b'0' {
            0
        } else if byte == b'1' {
            1
        } else if byte == b'2' {
            2
        } else if byte == b'3' {
            3
        } else if byte == b'4' {
            4
        } else if byte == b'5' {
            5
        } else if byte == b'6' {
            6
        } else if byte == b'7' {
            7
        } else if byte == b'8' {
            8
        } else {
            9
        };
        result = result * 10 + digit;
    }
    result
}

fn observe_name(maximum: Ref[isize], name: string) -> () {
    if let Some(value) = trailing_number(name) {
        if value > maximum.get() {
            maximum.set(value)
        }
    }
}

fn observe_exprs(maximum: Ref[isize], values: Vec[mono::Expr]) -> () {
    for value in values {
        observe_expr(maximum, value)
    }
}

fn observe_optional_expr(maximum: Ref[isize], value: Option[mono::Expr]) -> () {
    if let Some(value) = value {
        observe_expr(maximum, value)
    }
}

fn observe_block(maximum: Ref[isize], value: mono::Block) -> () {
    for stmt in value.stmts {
        observe_name(maximum, stmt.name);
        observe_expr(maximum, stmt.value)
    }
    observe_optional_expr(maximum, value.tail)
}

fn observe_expr(maximum: Ref[isize], value: mono::Expr) -> () {
    match value {
        Var { name: _, ty: _ } => (),
        Constr { constructor: _, args, ty: _ } => observe_exprs(maximum, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            observe_exprs(maximum, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                observe_name(maximum, param.name)
            }
            observe_expr(maximum, body)
        },
        Block { block, ty: _ } => observe_block(maximum, block),
        Match { expr, arms, default, ty: _ } => {
            observe_expr(maximum, expr);
            for arm in arms {
                observe_expr(maximum, arm.lhs);
                observe_expr(maximum, arm.body)
            }
            observe_optional_expr(maximum, default)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, binding_ty: _, body } => {
                        observe_expr(maximum, channel);
                        observe_name(maximum, binding);
                        observe_optional_expr(maximum, guard);
                        observe_expr(maximum, body)
                    },
                    Send { channel, value, guard, body } => {
                        observe_expr(maximum, channel);
                        observe_expr(maximum, value);
                        observe_optional_expr(maximum, guard);
                        observe_expr(maximum, body)
                    },
                }
            }
            observe_optional_expr(maximum, default)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            observe_expr(maximum, cond);
            observe_expr(maximum, then_);
            observe_expr(maximum, else_)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            observe_expr(maximum, cond);
            observe_expr(maximum, body)
        },
        Loop { body, ty: _ } => observe_expr(maximum, body),
        Return { expr, ty: _ } => observe_optional_expr(maximum, expr),
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => observe_expr(maximum, expr),
        Assign { name: _, value: expr, target_ty: _, ty: _ } => observe_expr(maximum, expr),
        Call { func, args, ty: _ } => {
            observe_expr(maximum, func);
            observe_exprs(maximum, args)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            observe_expr(maximum, receiver);
            observe_exprs(maximum, args)
        },
        Break { value, ty: _, .. } => observe_optional_expr(maximum, value),
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue { ty: _, .. } => (),
    }
}

fn initial_name_counter(value: mono::File) -> isize {
    let maximum = Ref::new(-1);
    for function in value.functions {
        for param in function.params {
            observe_name(maximum, param.0)
        }
        observe_block(maximum, function.body)
    }
    maximum.get() + 1
}

fn transform_exprs(
    state: State,
    scope: Vec[ScopeEntry],
    values: Vec[mono::Expr],
    context: Option[string],
) -> Vec[LowerExpr] {
    let result: Vec[LowerExpr] = Vec::new();
    for value in values {
        result.push(transform_expr(state, scope, value, context))
    }
    result
}

fn transform_optional_expr(
    state: State,
    scope: Vec[ScopeEntry],
    value: Option[mono::Expr],
    context: Option[string],
) -> Option[LowerExpr] {
    match value {
        Some(value) => {
            Option::Some(transform_expr(state, scope, value, context))
        },
        None => Option::None,
    }
}

fn block_type(value: LowerBlock) -> mono::Type {
    match value.tail {
        Some(value) => lower_expr_type(value),
        None => mono::Type::Unit,
    }
}

fn transform_block(
    state: State,
    outer_scope: Vec[ScopeEntry],
    value: mono::Block,
    context: Option[string],
) -> LowerBlock {
    let scope = copy_scope(outer_scope);
    let stmts: Vec[LowerLetStmt] = Vec::new();
    for stmt in value.stmts {
        let transformed = match stmt.value {
            Closure { params, body, ty } => transform_closure(
                state,
                scope,
                params,
                body,
                ty,
                Option::Some(stmt.name),
                context,
            ),
            other => transform_expr(state, scope, other, context),
        };
        let ty = lower_expr_type(transformed);
        let closure_struct = closure_for_type(state, ty).map(|info| info.struct_name);
        stmts.push(LowerLetStmt { name: stmt.name, value: transformed, ty });
        scope.push(ScopeEntry { name: stmt.name, ty, closure_struct })
    }
    LowerBlock { stmts, tail: transform_optional_expr(state, scope, value.tail, context) }
}

fn transform_arm(state: State, scope: Vec[ScopeEntry], value: mono::Arm, context: Option[string]) -> LowerArm {
    LowerArm {
        lhs: transform_expr(state, scope, value.lhs, context),
        body: transform_expr(state, scope, value.body, context),
    }
}

fn transform_arms(
    state: State,
    scope: Vec[ScopeEntry],
    values: Vec[mono::Arm],
    context: Option[string],
) -> Vec[LowerArm] {
    let result: Vec[LowerArm] = Vec::new();
    for value in values {
        result.push(transform_arm(state, scope, value, context))
    }
    result
}

fn transform_select_arms(
    state: State,
    scope: Vec[ScopeEntry],
    values: Vec[mono::SelectArm],
    context: Option[string],
) -> Vec[LowerSelectArm] {
    let result: Vec[LowerSelectArm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            match value {
                Receive { channel, guard, binding, binding_ty, body } => {
                    let body_scope = copy_scope(scope);
                    body_scope.push(
                        ScopeEntry { name: binding, ty: binding_ty, closure_struct: Option::None },
                    );
                    LowerSelectArm::Receive {
                        channel: transform_expr(state, scope, channel, context),
                        guard: transform_optional_expr(state, scope, guard, context),
                        binding,
                        binding_ty,
                        body: transform_expr(state, body_scope, body, context),
                    }
                },
                Send { channel, value, guard, body } => LowerSelectArm::Send {
                    channel: transform_expr(state, scope, channel, context),
                    value: transform_expr(state, scope, value, context),
                    guard: transform_optional_expr(state, scope, guard, context),
                    body: transform_expr(state, scope, body, context),
                },
            },
        )
    }
    result
}

fn transform_call(
    state: State,
    scope: Vec[ScopeEntry],
    func: mono::Expr,
    args: Vec[mono::Expr],
    ty: mono::Type,
    context: Option[string],
) -> LowerExpr {
    let func = transform_expr(state, scope, func, context);
    let args = transform_exprs(state, scope, args, context);
    match func {
        PackClosure { environment, apply, ty: _ } => {
            let Some(info) = find_closure_by_apply(state, apply) else {
                return invalid_expr(state, ty, "closure apply metadata is missing for " + apply)
            };
            let call_args: Vec[LowerExpr] = Vec::new();
            call_args.push(environment);
            for arg in args {
                call_args.push(arg)
            }
            LowerExpr::Call {
                func: LowerExpr::Var { name: info.apply_name, ty: info.apply_ty },
                args: call_args,
                ty,
            }
        },
        other => LowerExpr::Call { func: other, args, ty },
    }
}

fn transform_expr(state: State, scope: Vec[ScopeEntry], value: mono::Expr, context: Option[string]) -> LowerExpr {
    match value {
        Var { name, ty } => match find_scope(scope, name) {
            Some(entry) => LowerExpr::Var { name, ty: entry.ty },
            None => LowerExpr::Var { name, ty },
        },
        Callable { callable, ty } => LowerExpr::Callable { callable, ty },
        Prim { value, ty } => LowerExpr::Prim { value, ty },
        Constr { constructor, args, ty } => LowerExpr::Constr {
            constructor,
            args: transform_exprs(state, scope, args, context),
            ty,
        },
        Tuple { items, ty } => LowerExpr::Tuple {
            items: transform_exprs(state, scope, items, context),
            ty,
        },
        Array { items, ty } => LowerExpr::Array {
            items: transform_exprs(state, scope, items, context),
            ty,
        },
        Closure { params, body, ty } => transform_closure(
            state,
            scope,
            params,
            body,
            ty,
            Option::None,
            context,
        ),
        Block { block, ty: _ } => {
            let block = transform_block(state, scope, block, context);
            LowerExpr::Block { block, ty: block_type(block) }
        },
        Match { expr, arms, default, ty } => LowerExpr::Match {
            expr: transform_expr(state, scope, expr, context),
            arms: transform_arms(state, scope, arms, context),
            default: transform_optional_expr(state, scope, default, context),
            ty,
        },
        Select { mode, arms, default, ty } => LowerExpr::Select {
            mode,
            arms: transform_select_arms(state, scope, arms, context),
            default: transform_optional_expr(state, scope, default, context),
            ty,
        },
        If { cond, then_branch: then_, else_branch: else_, ty } => LowerExpr::If {
            cond: transform_expr(state, scope, cond, context),
            then_branch: transform_expr(state, scope, then_, context),
            else_branch: transform_expr(state, scope, else_, context),
            ty,
        },
        While { cond, body, ty } => LowerExpr::While {
            cond: transform_expr(state, scope, cond, context),
            body: transform_expr(state, scope, body, context),
            ty,
        },
        Loop { body, ty } => {
            LowerExpr::Loop { body: transform_expr(state, scope, body, context), ty }
        },
        Break { target, value, ty } => LowerExpr::Break {
            target,
            value: transform_optional_expr(state, scope, value, context),
            ty,
        },
        Continue { target, ty } => LowerExpr::Continue { target, ty },
        Return { expr, ty } => LowerExpr::Return {
            expr: transform_optional_expr(state, scope, expr, context),
            ty,
        },
        Go { expr, ty } => LowerExpr::Go { expr: transform_expr(state, scope, expr, context), ty },
        ConstrGet { expr, constructor, field_index: index, ty } => LowerExpr::ConstrGet {
            expr: transform_expr(state, scope, expr, context),
            constructor,
            field_index: index,
            ty,
        },
        Unary { op, expr, ty } => LowerExpr::Unary {
            op,
            expr: transform_expr(state, scope, expr, context),
            ty,
        },
        Cast { expr, ty } => LowerExpr::Cast {
            expr: transform_expr(state, scope, expr, context),
            ty,
        },
        Binary { op, lhs, rhs, ty } => LowerExpr::Binary {
            op,
            lhs: transform_expr(state, scope, lhs, context),
            rhs: transform_expr(state, scope, rhs, context),
            ty,
        },
        Assign { name, value: expr, target_ty, ty } => LowerExpr::Assign {
            name,
            value: transform_expr(state, scope, expr, context),
            target_ty,
            ty,
        },
        Call { func, args, ty } => {
            transform_call(state, scope, func, args, ty, context)
        },
        ToDyn { trait_name, for_ty, expr, ty } => LowerExpr::ToDyn {
            trait_name,
            for_ty,
            expr: transform_expr(state, scope, expr, context),
            ty,
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            LowerExpr::DynCall {
                trait_name,
                method_name,
                receiver: transform_expr(state, scope, receiver, context),
                args: transform_exprs(state, scope, args, context),
                ty,
            }
        },
        Proj { tuple: expr, index, ty } => LowerExpr::Proj {
            tuple: transform_expr(state, scope, expr, context),
            index,
            ty,
        },
    }
}

fn capture_exists(values: Vec[Capture], name: string) -> bool {
    for value in values {
        if value.name == name {
            return true
        }
    }
    false
}

fn collect_captured_exprs(
    values: Vec[LowerExpr],
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> () {
    for value in values {
        collect_captured(value, bound, captured, scope)
    }
}

fn collect_captured_optional(
    value: Option[LowerExpr],
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> () {
    if let Some(value) = value {
        collect_captured(value, bound, captured, scope)
    }
}

fn collect_captured_block(
    value: LowerBlock,
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> () {
    let mut added = 0;
    for stmt in value.stmts {
        collect_captured(stmt.value, bound, captured, scope);
        bound.push(stmt.name);
        added += 1;
    }
    collect_captured_optional(value.tail, bound, captured, scope);
    for _ in 0..added {
        let _ = bound.pop();
    }
}

fn collect_captured(
    value: LowerExpr,
    bound: Vec[string],
    captured: Vec[Capture],
    scope: Vec[ScopeEntry],
) -> () {
    match value {
        Var { name, ty: _ } => if bound.contains(name) {} else {
            if let Some(entry) = find_scope(scope, name) {
                if capture_exists(captured, name) {} else {
                    captured.push(Capture { name, ty: entry.ty })
                }
            }
        },
        Constr { constructor: _, args, ty: _ } => {
            collect_captured_exprs(args, bound, captured, scope)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            collect_captured_exprs(items, bound, captured, scope)
        },
        Block { block, ty: _ } => {
            collect_captured_block(block, bound, captured, scope)
        },
        Match { expr, arms, default, ty: _ } => {
            collect_captured(expr, bound, captured, scope);
            for arm in arms {
                collect_captured(arm.lhs, bound, captured, scope);
                collect_captured(arm.body, bound, captured, scope)
            }
            collect_captured_optional(default, bound, captured, scope)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, binding_ty: _, body } => {
                        collect_captured(channel, bound, captured, scope);
                        collect_captured_optional(guard, bound, captured, scope);
                        bound.push(binding);
                        collect_captured(body, bound, captured, scope);
                        let _ = bound.pop();
                    },
                    Send { channel, value, guard, body } => {
                        collect_captured(channel, bound, captured, scope);
                        collect_captured(value, bound, captured, scope);
                        collect_captured_optional(guard, bound, captured, scope);
                        collect_captured(body, bound, captured, scope)
                    },
                }
            }
            collect_captured_optional(default, bound, captured, scope)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            collect_captured(cond, bound, captured, scope);
            collect_captured(then_, bound, captured, scope);
            collect_captured(else_, bound, captured, scope)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            collect_captured(cond, bound, captured, scope);
            collect_captured(body, bound, captured, scope)
        },
        Loop { body, ty: _ } => collect_captured(body, bound, captured, scope),
        Return { expr, ty: _ } => {
            collect_captured_optional(expr, bound, captured, scope)
        },
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => {
            collect_captured(expr, bound, captured, scope)
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => {
            collect_captured(expr, bound, captured, scope)
        },
        Call { func, args, ty: _ } => {
            collect_captured(func, bound, captured, scope);
            collect_captured_exprs(args, bound, captured, scope)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_captured(receiver, bound, captured, scope);
            collect_captured_exprs(args, bound, captured, scope)
        },
        PackClosure { environment, apply: _, ty: _ } => {
            collect_captured(environment, bound, captured, scope)
        },
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_captured(expr, bound, captured, scope)
        },
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue { ty: _, .. } => (),
    }
}

fn make_field_name(name: string, index: isize) -> string {
    match sanitize_name(name) {
        Some(name) => f"{name}_{index}",
        None => f"field_{index}",
    }
}

fn closure_body_block(value: LowerExpr) -> LowerBlock {
    match value {
        Block { block, ty: _ } => block,
        other => LowerBlock { stmts: Vec::new(), tail: Option::Some(other) },
    }
}

fn prepend_captures(
    body: LowerBlock,
    captures: Vec[Capture],
    env_name: string,
    env_ty: mono::Type,
    constructor: mono::Constructor,
) -> LowerBlock {
    let stmts: Vec[LowerLetStmt] = Vec::new();
    for index in 0..captures.len() {
        let capture = captures[index];
        stmts.push(
            LowerLetStmt {
                name: capture.name,
                value: LowerExpr::ConstrGet {
                    expr: LowerExpr::Var { name: env_name, ty: env_ty },
                    constructor,
                    field_index: index,
                    ty: capture.ty,
                },
                ty: capture.ty,
            },
        )
    }
    for stmt in body.stmts {
        stmts.push(stmt)
    }
    LowerBlock { stmts, tail: body.tail }
}

fn transform_closure(
    state: State,
    outer_scope: Vec[ScopeEntry],
    params: Vec[mono::ClosureParam],
    body: mono::Expr,
    ty: mono::Type,
    name_hint: Option[string],
    context: Option[string],
) -> LowerExpr {
    let signature = match ty {
        Func { params: param_tys, ret_ty } => Option::Some((param_tys, ret_ty)),
        _ => Option::None,
    };
    match signature {
        Some(signature) => {
            let closure_scope = copy_scope(outer_scope);
            let lowered_params: Vec[(string, mono::Type)] = Vec::new();
            let bound: Vec[string] = Vec::new();
            for index in 0..params.len() {
                let param = params[index];
                let param_ty = signature.0[index];
                closure_scope.push(
                    ScopeEntry {
                        name: param.name,
                        ty: param_ty,
                        closure_struct: closure_for_type(state, param_ty).map(
                            |info| info.struct_name,
                        ),
                    },
                );
                lowered_params.push((param.name, param_ty));
                bound.push(param.name)
            }
            let hint = match name_hint {
                Some(name) => match sanitize_name(name) {
                    Some(name) => Option::Some(name),
                    None => context,
                },
                None => context,
            };
            let body = transform_expr(state, closure_scope, body, hint);
            let captures: Vec[Capture] = Vec::new();
            collect_captured(body, bound, captures, outer_scope);
            let struct_name = fresh_struct_name(state, hint);
            let env_ty = mono::Type::Named { name: struct_name };
            let fields: Vec[string] = Vec::new();
            let struct_fields: Vec[(string, mono::Type)] = Vec::new();
            let captured_args: Vec[LowerExpr] = Vec::new();
            for index in 0..captures.len() {
                let capture = captures[index];
                let field_name = make_field_name(capture.name, index);
                fields.push(field_name);
                struct_fields.push((field_name, capture.ty));
                captured_args.push(LowerExpr::Var { name: capture.name, ty: capture.ty })
            }
            let constructor = mono::Constructor {
                name: struct_name,
                fields,
                is_struct: true,
                tag: Option::None,
            };
            let apply_name = "inherent#" + struct_name + "#" + struct_name + "#apply";
            let env_name = fresh_name(state, "env");
            let fn_params: Vec[(string, mono::Type)] = Vec::new();
            fn_params.push((env_name, env_ty));
            let apply_param_types: Vec[mono::Type] = Vec::new();
            apply_param_types.push(env_ty);
            for param in lowered_params {
                fn_params.push(param);
                apply_param_types.push(param.1)
            }
            let apply_ty = mono::Type::Func { params: apply_param_types, ret_ty: signature.1 };
            record_closure(state, ClosureInfo { struct_name, apply_name, apply_ty, signature: ty });
            state.generated_structs.push(
                mono::StructDef {
                    name: struct_name,
                    fields: struct_fields,
                    public_fields: Vec::new(),
                    has_hidden_fields: false,
                },
            );
            let fn_body = prepend_captures(
                closure_body_block(body),
                captures,
                env_name,
                env_ty,
                constructor,
            );
            state.source_names.push((apply_name, state.source_owner.get()));
            state.generated.push(
                LowerFunction {
                    name: apply_name,
                    origin: LowerFunctionOrigin::Inherent { owner: env_ty, method_name: "apply" },
                    root: true,
                    trait_impl: Option::None,
                    params: fn_params,
                    ret_ty: signature.1,
                    body: fn_body,
                },
            );
            LowerExpr::PackClosure {
                environment: LowerExpr::Constr { constructor, args: captured_args, ty: env_ty },
                apply: apply_name,
                ty,
            }
        },
        None => invalid_expr(state, ty, "closure has a non-function type"),
    }
}

fn transform_function_origin(value: mono::FunctionOrigin) -> LowerFunctionOrigin {
    match value {
        Source => LowerFunctionOrigin::Source,
        Inherent { owner, method_name } => LowerFunctionOrigin::Inherent { owner, method_name },
        TraitImplementation { method_name } => LowerFunctionOrigin::TraitImplementation {
            method_name,
        },
    }
}

fn transform_trait_impl(value: Option[mono::TraitImpl]) -> Option[LowerTraitImpl] {
    value.map(
        |value| LowerTraitImpl {
            trait_ref: value.trait_ref,
            for_ty: value.for_ty,
            associated_types: value.associated_types,
        },
    )
}

fn transform_function(state: State, value: mono::Function) -> LowerFunction {
    state.source_owner.set(value.name);
    let scope: Vec[ScopeEntry] = Vec::new();
    for param in value.params {
        scope.push(
            ScopeEntry {
                name: param.0,
                ty: param.1,
                closure_struct: closure_for_type(state, param.1).map(|info| info.struct_name),
            },
        )
    }
    let context = sanitize_name(value.name);
    LowerFunction {
        name: value.name,
        origin: transform_function_origin(value.origin),
        root: value.root,
        trait_impl: transform_trait_impl(value.trait_impl),
        params: value.params,
        ret_ty: value.ret_ty,
        body: transform_block(state, scope, value.body, context),
    }
}

fn lambda_lift_with_counter(value: mono::File, counter: Ref[isize]) -> LambdaLiftResult {
    lambda_lift_with_source_names(value, counter, Vec::new())
}

fn lambda_lift_with_source_names(
    value: mono::File,
    counter: Ref[isize],
    source_names: Vec[(string, string)],
) -> LambdaLiftResult {
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let constants = value.constants;
    let state = State {
        source_names,
        source_owner: Ref::new(""),
        next_env: Ref::new(0),
        next_name: counter,
        generated: Vec::new(),
        generated_structs: Vec::new(),
        closures_by_struct: collections::IndexMap::new(),
        closures_by_apply: HashMap::new(),
        used_types: initial_used_types(value),
        error: Ref::new(Option::None),
    };
    let functions: Vec[LowerFunction] = Vec::new();
    for function in value.functions {
        functions.push(transform_function(state, function))
    }
    for function in state.generated {
        functions.push(function)
    }
    for generated_struct in state.generated_structs {
        structs.push(generated_struct)
    }
    let closure_defs: Vec[LowerClosureDef] = Vec::with_capacity(state.closures_by_struct.len());
    for entry in state.closures_by_struct {
        let info = entry.1;
        closure_defs.push(
            LowerClosureDef {
                environment: info.struct_name,
                apply: info.apply_name,
                signature: info.signature,
            },
        )
    }
    LambdaLiftResult {
        file: LowerFile {
            functions,
            enums,
            structs,
            type_instances,
            constants,
            statics: value.statics,
            closure_defs,
        },
        error: state.error.get(),
    }
}

fn lambda_lift(value: mono::File) -> LambdaLiftResult {
    let counter = Ref::new(initial_name_counter(value));
    lambda_lift_with_counter(value, counter)
}
