package lift;

use module::ast;
use module::pretty;
use module::repr;
use std::text;

struct PrintStyle {
    mono_style: bool,
    flatten_blocks: bool,
}

fn arguments(values: Vec[pretty::Doc]) -> pretty::Doc {
    pretty::delimited("(", ",", ")", values)
}

fn dyn_method_name(value: string) -> string {
    match text::rfind(value, "#") {
        Some(index) => value.byte_slice(index + 1, value.byte_len()),
        None => value,
    }
}

fn callable_doc(value: repr::Callable) -> pretty::Doc {
    match value {
        Function(name) => pretty::text(name),
        LangItem { item: _, function_name } => pretty::text(function_name),
        Runtime(name) => pretty::text("@runtime(" + name + ")"),
        CallbackAdapter(value) => pretty::text(
            if value.to_go {
                "@callback(to_go)"
            } else {
                "@callback(to_closure)"
            },
        ),
        Intrinsic(name) => pretty::text("@intrinsic(" + name + ")"),
        InterfaceBridge(value) => pretty::text(
            "@go_interface_bridge(" + repr::diagnostic_type_text(value.target) + ")",
        ),
        GoMethod { symbol, binding } => pretty::text("@go_method(" + symbol + ")"),
        GoForeign { import_path, symbol, binding } => {
            pretty::text("@go_ffi(" + import_path + ", " + symbol + ")")
        },
        TraitMethod { trait_ref: reference, method_name: name, .. } => pretty::concat(
            Vec::from_array([repr::trait_ref_doc(reference), pretty::text("::" + name)]),
        ),
        DynTraitMethod { trait_name: owner, dispatch_name: _, method_name: name } => {
            pretty::text("dyn " + owner + "::" + name)
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            pretty::text(repr::inherent_method_name(owner, name))
        },
    }
}

fn exprs_doc(values: Vec[Expr], style: PrintStyle) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(expr_doc(value, style))
    }
    result
}

fn record_doc(name: string, values: Vec[pretty::Doc]) -> pretty::Doc {
    if values.is_empty() {
        pretty::text(name + " {}")
    } else {
        pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(name + " {"),
                        pretty::nest(
                            2,
                            pretty::append(
                                pretty::line(),
                                pretty::join(
                                    pretty::append(pretty::text(","), pretty::line()),
                                    values,
                                ),
                            ),
                        ),
                        pretty::line(),
                        pretty::text("}"),
                    ],
                ),
            ),
        )
    }
}

fn constructor_doc(constructor: repr::Constructor, args: Vec[Expr], style: PrintStyle) -> pretty::Doc {
    if constructor.is_struct {
        if constructor.fields.is_empty() && args.is_empty() {
            pretty::text(constructor.name + " {}")
        } else if constructor.fields.len() == args.len() {
            let fields: Vec[pretty::Doc] = Vec::with_capacity(args.len());
            for index in 0..args.len() {
                fields.push(
                    pretty::concat(
                        Vec::from_array(
                            [
                                pretty::text(constructor.fields[index] + ": "),
                                expr_doc(args[index], style),
                            ],
                        ),
                    ),
                )
            }
            record_doc(constructor.name, fields)
        } else if !args.is_empty() {
            pretty::append(pretty::text(constructor.name), arguments(exprs_doc(args, style)))
        } else {
            pretty::text(constructor.name)
        }
    } else if !args.is_empty() {
        pretty::append(pretty::text(constructor.name), arguments(exprs_doc(args, style)))
    } else {
        pretty::text(constructor.name)
    }
}

fn block_docs(value: Block, style: PrintStyle) -> Vec[pretty::Doc] {
    let result: Vec[pretty::Doc] = Vec::with_capacity(value.stmts.len() + 1);
    if value.stmts.is_empty() {
        match value.tail {
            Some(tail) => result.push(expr_doc(tail, style)),
            None => result.push(pretty::text("()")),
        }
    } else {
        for statement in value.stmts {
            result.push(
                pretty::group(
                    pretty::concat(
                        Vec::from_array(
                            [
                                pretty::text("let " + statement.name + " ="),
                                pretty::nest(
                                    2,
                                    pretty::append(pretty::line(), expr_doc(statement.value, style)),
                                ),
                                pretty::text(" in"),
                            ],
                        ),
                    ),
                ),
            )
        }
        match value.tail {
            Some(tail) => result.push(expr_doc(tail, style)),
            None => if style.flatten_blocks {
                result.push(pretty::text("()"))
            },
        }
    }
    result
}

fn braced_docs(values: Vec[pretty::Doc], indentation: isize) -> pretty::Doc {
    if values.is_empty() {
        pretty::text("{}")
    } else {
        pretty::concat(
            Vec::from_array(
                [
                    pretty::text("{"),
                    pretty::nest(
                        indentation,
                        pretty::append(pretty::hardline(), pretty::stack(values)),
                    ),
                    pretty::hardline(),
                    pretty::text("}"),
                ],
            ),
        )
    }
}

fn arm_doc(value: Arm, style: PrintStyle) -> pretty::Doc {
    pretty::concat(
        Vec::from_array(
            [
                pretty::append(expr_doc(value.lhs, style), pretty::text(" => ")),
                braced_docs(Vec::from_array([expr_doc(value.body, style)]), 2),
                pretty::text(","),
            ],
        ),
    )
}

fn select_arm_doc(value: SelectArm, style: PrintStyle) -> pretty::Doc {
    match value {
        Receive { channel, guard, binding, binding_ty: _, body } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("recv("),
                    expr_doc(channel, style),
                    match guard {
                        Some(value) => pretty::concat(
                            Vec::from_array(
                                [
                                    pretty::text(") when "),
                                    expr_doc(value, style),
                                    pretty::text(" as " + binding + " => "),
                                ],
                            ),
                        ),
                        None => pretty::text(") as " + binding + " => "),
                    },
                    braced_docs(Vec::from_array([expr_doc(body, style)]), 2),
                    pretty::text(","),
                ],
            ),
        ),
        Send { channel, value, guard, body } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("send("),
                    expr_doc(channel, style),
                    pretty::text(", "),
                    expr_doc(value, style),
                    match guard {
                        Some(value) => pretty::concat(
                            Vec::from_array(
                                [
                                    pretty::text(") when "),
                                    expr_doc(value, style),
                                    pretty::text(" => "),
                                ],
                            ),
                        ),
                        None => pretty::text(") => "),
                    },
                    braced_docs(Vec::from_array([expr_doc(body, style)]), 2),
                    pretty::text(","),
                ],
            ),
        ),
    }
}

fn expr_doc(value: Expr, style: PrintStyle) -> pretty::Doc {
    match value {
        Var { name, ty: _ } => pretty::text(name),
        Callable { callable, ty: _ } => callable_doc(callable),
        Prim { value, ty: _ } => repr::primitive_doc(value),
        Constr { constructor, args, ty: _ } => constructor_doc(constructor, args, style),
        Tuple { items: values, ty: _ } => arguments(exprs_doc(values, style)),
        Array { items: values, ty: _ } => {
            pretty::delimited("[", ",", "]", exprs_doc(values, style))
        },
        Block { block, ty: _ } => if style.flatten_blocks {
            pretty::stack(block_docs(block, style))
        } else {
            braced_docs(block_docs(block, style), 2)
        },
        Match { expr: source, arms, default, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(arm_doc(arm, style))
            }
            if let Some(value) = default {
                values.push(
                    pretty::group(
                        pretty::concat(
                            Vec::from_array(
                                [
                                    pretty::text("_ =>"),
                                    pretty::nest(
                                        2,
                                        pretty::append(pretty::line(), expr_doc(value, style)),
                                    ),
                                    pretty::text(","),
                                ],
                            ),
                        ),
                    ),
                )
            }
            pretty::block(pretty::append(pretty::text("match "), expr_doc(source, style)), values)
        },
        Select { mode, arms, default, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(
                arms.len()
                    + if default.is_some() {
                        1
                    } else {
                        0
                    },
            );
            for arm in arms {
                values.push(select_arm_doc(arm, style))
            }
            if let Some(value) = default {
                values.push(
                    pretty::concat(
                        Vec::from_array(
                            [
                                pretty::text("default => "),
                                braced_docs(Vec::from_array([expr_doc(value, style)]), 2),
                                pretty::text(","),
                            ],
                        ),
                    ),
                )
            }
            pretty::block(
                pretty::text(
                    match mode {
                        ast::SelectMode::Normal => "select",
                        ast::SelectMode::Priority => "select priority",
                    },
                ),
                values,
            )
        },
        If { cond, then_branch, else_branch, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::append(pretty::text("if "), expr_doc(cond, style)),
                    pretty::text(" "),
                    braced_docs(Vec::from_array([expr_doc(then_branch, style)]), 4),
                    pretty::text(" else "),
                    braced_docs(Vec::from_array([expr_doc(else_branch, style)]), 4),
                ],
            ),
        ),
        While { cond, body, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::append(pretty::text("while "), expr_doc(cond, style)),
                    pretty::text(" "),
                    braced_docs(Vec::from_array([expr_doc(body, style)]), 4),
                ],
            ),
        ),
        Loop { body, ty: _ } => {
            pretty::append(pretty::text("loop "), expr_doc(body, style))
        },
        Break { target, value, ty: _ } => match value {
            Some(value) => pretty::append(
                pretty::text(
                    if target == 0 {
                        "break "
                    } else {
                        f"break@{target} "
                    },
                ),
                expr_doc(value, style),
            ),
            None => pretty::text(
                if target == 0 {
                    "break"
                } else {
                    f"break@{target}"
                },
            ),
        },
        Continue { target, ty: _ } => pretty::text(
            if target == 0 {
                "continue"
            } else {
                f"continue@{target}"
            },
        ),
        Return { expr: value, ty: _ } => match value {
            Some(value) => pretty::append(pretty::text("return "), expr_doc(value, style)),
            None => pretty::text("return"),
        },
        Go { expr: value, ty: _ } => {
            pretty::append(pretty::text("go "), expr_doc(value, style))
        },
        ConstrGet { expr: value, constructor, field_index, ty: _ } => {
            let field = if constructor.is_struct && field_index < constructor.fields.len() {
                constructor.fields[field_index]
            } else {
                f"_{field_index}"
            };
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(constructor.name + "." + field),
                        arguments(Vec::from_array([expr_doc(value, style)])),
                    ],
                ),
            )
        },
        Unary { op, expr: value, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("(" + repr::unary_symbol(op)),
                    expr_doc(value, style),
                    pretty::text(")"),
                ],
            ),
        ),
        Cast { expr: value, ty } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("("),
                    expr_doc(value, style),
                    pretty::text(" as "),
                    repr::type_doc(ty),
                    pretty::text(")"),
                ],
            ),
        ),
        Binary { op, lhs, rhs, ty: _ } => pretty::group(
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text("("),
                        expr_doc(lhs, style),
                        pretty::text(" " + repr::binary_symbol(op)),
                        pretty::nest(2, pretty::append(pretty::line(), expr_doc(rhs, style))),
                        pretty::text(")"),
                    ],
                ),
            ),
        ),
        Assign { name, value, target_ty: _, ty: _ } => pretty::concat(
            Vec::from_array([pretty::text(name + " = "), expr_doc(value, style)]),
        ),
        Call { func: function, args, ty: _ } => {
            pretty::append(expr_doc(function, style), arguments(exprs_doc(args, style)))
        },
        ToDyn { trait_name, for_ty, expr: value, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("to_dyn[" + trait_name + "]{"),
                    repr::type_doc(for_ty),
                    pretty::text("}"),
                    arguments(Vec::from_array([expr_doc(value, style)])),
                ],
            ),
        ),
        DynCall { trait_name, method_name, receiver, args, ty: _ } => {
            let values: Vec[pretty::Doc] = Vec::with_capacity(args.len() + 1);
            values.push(expr_doc(receiver, style));
            for arg in args {
                values.push(expr_doc(arg, style))
            }
            pretty::concat(
                Vec::from_array(
                    [
                        pretty::text(
                            "dyn_call[" + trait_name + "::" + dyn_method_name(method_name) + "]",
                        ),
                        arguments(values),
                    ],
                ),
            )
        },
        PackClosure { environment, apply, ty: _ } => pretty::concat(
            Vec::from_array(
                [
                    pretty::text("pack_closure[" + apply + "]"),
                    arguments(Vec::from_array([expr_doc(environment, style)])),
                ],
            ),
        ),
        Proj { tuple: value, index, ty: _ } => {
            pretty::append(expr_doc(value, style), pretty::text(f".{index}"))
        },
    }
}

fn params_doc(values: Vec[(string, repr::Type)]) -> pretty::Doc {
    let result: Vec[pretty::Doc] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            pretty::concat(Vec::from_array([pretty::text(value.0 + ": "), repr::type_doc(value.1)])),
        )
    }
    arguments(result)
}

fn function_doc(value: Function, style: PrintStyle) -> pretty::Doc {
    pretty::block(
        pretty::concat(
            Vec::from_array(
                [
                    pretty::text("fn " + value.name),
                    params_doc(value.params),
                    pretty::text(" -> "),
                    repr::type_doc(value.ret_ty),
                ],
            ),
        ),
        block_docs(value.body, style),
    )
}

fn encode_with_style(value: File, style: PrintStyle) -> string {
    let constants: Vec[pretty::Doc] = Vec::with_capacity(value.constants.len());
    for value in value.constants {
        constants.push(repr::constant_doc(value))
    }
    for value in value.statics {
        constants.push(repr::static_doc(value))
    }
    let functions: Vec[pretty::Doc] = Vec::with_capacity(value.functions.len());
    for value in value.functions {
        functions.push(function_doc(value, style))
    }
    let constants_doc = pretty::stack(constants);
    let functions_doc = pretty::join(
        pretty::concat(Vec::from_array([pretty::hardline(), pretty::hardline()])),
        functions,
    );
    let result = if !constants.is_empty() && !value.functions.is_empty() {
        pretty::concat(
            Vec::from_array([constants_doc, pretty::hardline(), pretty::hardline(), functions_doc]),
        )
    } else {
        pretty::append(constants_doc, functions_doc)
    };
    pretty::pretty(100, result)
}

pub fn encode(value: File) -> string {
    encode_with_style(value, PrintStyle { mono_style: true, flatten_blocks: true })
}
