package names;

fn short_name_start(value: string) -> isize {
    let mut index = value.byte_len() - 2;
    while index >= 0 {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            return index + 2
        }
        index -= 1;
    }
    0
}

pub fn short_name(value: string) -> string {
    let start = short_name_start(value);
    if start == 0 {
        value
    } else {
        value.byte_slice(start, value.byte_len())
    }
}

pub fn names_match(left: string, right: string) -> bool {
    if left == right {
        return true
    }
    let left_start = short_name_start(left);
    let right_start = short_name_start(right);
    if left_start > 0 && right_start > 0 {
        return false
    }
    let length = left.byte_len() - left_start;
    if length != right.byte_len() - right_start {
        return false
    }
    for index in 0..length {
        if left.byte_get(left_start + index) != right.byte_get(right_start + index) {
            return false
        }
    }
    true
}
