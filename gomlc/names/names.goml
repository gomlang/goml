package names;

fn short_name_start(value: string) -> isize {
    let mut index = value.byte_len() - 2;
    while index >= 0 {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            return index + 2
        }
        index -= 1;
    }
    0
}

pub fn short_name(value: string) -> string {
    let start = short_name_start(value);
    if start == 0 {
        value
    } else {
        value.byte_slice(start, value.byte_len())
    }
}

fn unqualified_name_matches(short: string, long: string) -> bool {
    let start = long.byte_len() - short.byte_len();
    if start < 2 || long.byte_get(start - 2) != b':' || long.byte_get(start - 1) != b':'
        || (short.byte_len() > 0 && short.byte_get(0) == b':')
        || short_name_start(short) != 0 {
        return false
    }
    for index in 0..short.byte_len() {
        if long.byte_get(start + index) != short.byte_get(index) {
            return false
        }
    }
    true
}

pub fn names_match(left: string, right: string) -> bool {
    if left == right {
        true
    } else if left.byte_len() < right.byte_len() {
        unqualified_name_matches(left, right)
    } else if right.byte_len() < left.byte_len() {
        unqualified_name_matches(right, left)
    } else {
        false
    }
}
