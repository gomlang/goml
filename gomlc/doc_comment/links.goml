package doc_comment;

use std::text;

pub struct Link {
    pub start: isize,
    pub end: isize,
    pub label: string,
    pub destination: string,
    pub reference: bool,
}

fn link_close(value: string, start: isize, delimiter: u8) -> Option[isize] {
    let mut cursor = start;
    while cursor < value.byte_len() {
        let character = value.byte_get(cursor);
        if character == delimiter {
            return Option::Some(cursor)
        }
        if character == b'\n' {
            return Option::None
        }
        cursor += 1;
    }
    Option::None
}

pub fn link_at(value: string, start: isize) -> Option[Link] {
    if start >= value.byte_len() || value.byte_get(start) != b'[' {
        return Option::None
    }
    let close = link_close(value, start + 1, b']')?;
    let label = value.byte_slice(start + 1, close);
    let end = close + 1;
    let (end, destination, reference) = if end < value.byte_len() && value.byte_get(end) == b'(' {
        let close = link_close(value, end + 1, b')')?;
        let destination = value.byte_slice(end + 1, close);
        if destination.starts_with("goml:") {
            (close + 1, destination.byte_slice(5, destination.byte_len()), true)
        } else {
            (close + 1, destination, false)
        }
    } else {
        (end, label, true)
    };
    let destination = if destination.starts_with("`") && destination.ends_with("`")
        && destination.byte_len() >= 2 {
        destination.byte_slice(1, destination.byte_len() - 1)
    } else {
        destination
    };
    Option::Some(Link { start, end, label, destination, reference })
}

pub fn references(value: string) -> Vec[string] {
    let result = Vec::new();
    let mut fenced = false;
    for line in text::split(value, "\n") {
        if line.starts_with("```") {
            fenced = !fenced;
        } else if !fenced {
            let mut cursor = 0;
            let mut code = false;
            while cursor < line.byte_len() {
                if line.byte_get(cursor) == b'`' {
                    code = !code;
                } else if !code {
                    if let Some(link) = link_at(line, cursor) {
                        if link.reference && !result.contains(link.destination) {
                            result.push(link.destination)
                        }
                        cursor = link.end;
                        continue
                    }
                }
                cursor += 1;
            }
        }
    }
    result
}
