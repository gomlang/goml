package doc_comment;

use std::text;

pub struct Link {
    pub start: isize,
    pub end: isize,
    pub label: string,
    pub destination: string,
    pub reference: bool,
}

pub fn link_at(value: string, start: isize) -> Option[Link] {
    if start >= value.byte_len() || value.byte_get(start) != b'[' {
        return Option::None
    }
    let mut close = start + 1;
    while close < value.byte_len() && value.byte_get(close) != b']'
        && value.byte_get(close) != b'\n' {
        close += 1;
    }
    if close == value.byte_len() || value.byte_get(close) != b']' {
        return Option::None
    }
    let label = value.byte_slice(start + 1, close);
    let mut destination = label;
    let mut end = close + 1;
    let mut reference = true;
    if end < value.byte_len() && value.byte_get(end) == b'(' {
        let mut cursor = end + 1;
        while cursor < value.byte_len() && value.byte_get(cursor) != b')'
            && value.byte_get(cursor) != b'\n' {
            cursor += 1;
        }
        if cursor == value.byte_len() || value.byte_get(cursor) != b')' {
            return Option::None
        }
        destination = value.byte_slice(end + 1, cursor);
        end = cursor + 1;
        reference = destination.starts_with("goml:");
        if reference {
            destination = destination.byte_slice(5, destination.byte_len());
        }
    }
    if destination.starts_with("`") && destination.ends_with("`") && destination.byte_len() >= 2 {
        destination = destination.byte_slice(1, destination.byte_len() - 1);
    }
    Option::Some(Link { start, end, label, destination, reference })
}

pub fn references(value: string) -> Vec[string] {
    let result = Vec::new();
    let mut fenced = false;
    for line in text::split(value, "\n") {
        if line.starts_with("```") {
            fenced = !fenced;
        } else if !fenced {
            let mut cursor = 0;
            let mut code = false;
            while cursor < line.byte_len() {
                if line.byte_get(cursor) == b'`' {
                    code = !code;
                    cursor += 1;
                } else if !code {
                    if let Some(link) = link_at(line, cursor) {
                        if link.reference && !result.contains(link.destination) {
                            result.push(link.destination)
                        }
                        cursor = link.end;
                    } else {
                        cursor += 1;
                    }
                } else {
                    cursor += 1;
                }
            }
        }
    }
    result
}
