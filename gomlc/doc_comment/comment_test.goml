package doc_comment;

use std::testing;

#[test]
fn documentation_comments_respect_lines_and_literals() -> () {
    let source = "//! 包说明\r\npackage sample;\r\n/// First\r\n/// 第二行\r\n#[derive(Debug)]\r\npub struct Value {}\r\n/// detached\r\n\r\nfn hidden() {}\r\nfn other() {} /// trailing\r\nfn next() {}\r\nconst text: string = \"/// literal\";\r\n//// ordinary\r\nfn last() {}\r\n";
    let result = collect(source);
    testing::assert_eq(result.package_text, "包说明");
    testing::assert_eq(result.items.len(), 1);
    testing::assert_eq(result.items[0].text, "First\n第二行");
    testing::assert_eq(source.byte_get(result.items[0].target), b'#');
}

#[test]
fn documentation_references_skip_code() -> () {
    let result = references(
        "[Item] [label](goml:alias::Item) ` [ignored] `\n```goml\n[ignored]\n```\n[site](https://example.com)",
    );
    testing::assert_eq(result.len(), 2);
    testing::assert_eq(result[0], "Item");
    testing::assert_eq(result[1], "alias::Item");
}

#[test]
fn documentation_links_preserve_targets_and_byte_offsets() -> () {
    let value = "λ [`标签`](goml:`alias::Item`) suffix";
    let link = testing::expect_some(link_at(value, 3), "Unicode documentation link");
    testing::assert_eq(link.start, 3);
    testing::assert_eq(link.end, "λ [`标签`](goml:`alias::Item`)".byte_len());
    testing::assert_eq(link.label, "`标签`");
    testing::assert_eq(link.destination, "alias::Item");
    testing::assert(link.reference);
    let external = testing::expect_some(link_at("[site](https://example.com)", 0), "external link");
    testing::assert_eq(external.destination, "https://example.com");
    testing::assert(!external.reference);
    for value in["[missing", "[label](missing", "[label\nbreak]", "[label](target\nbreak)"] {
        testing::assert(link_at(value, 0).is_none())
    }
}

#[test]
fn documentation_references_preserve_first_seen_order() -> () {
    let result = references(
        "[Item] [`Item`] [label](goml:alias::Item) [again](goml:Item) `[hidden]` ` [unfinished]\n[Next]\n```\n[hidden]\n```\n[site](https://example.com)",
    );
    testing::assert_eq(result.len(), 3);
    testing::assert_eq(result[0], "Item");
    testing::assert_eq(result[1], "alias::Item");
    testing::assert_eq(result[2], "Next");
}

#[test]
fn documentation_link_offsets_reject_out_of_bounds_positions() -> () {
    for offset in[-1, 6, 7] {
        testing::assert(link_at("[Item]", offset).is_none())
    }
    testing::assert(link_at("", 0).is_none());
}

#[test]
fn signature_identity_preserves_significant_token_boundaries() -> () {
    testing::assert_eq(
        signature_identity("fn value[T,](left: T, right: T, // trailing\n) -> T"),
        signature_identity("fn value[T](left:T,right:T)->T"),
    );
    testing::assert(signature_identity("a b") != signature_identity("ab"));
    testing::assert(signature_identity("(a,b)") != signature_identity("(ab)"));
    testing::assert_eq(signature_identity("value,"), "5:value1:,");
    testing::assert_eq(signature_identity("value, // trailing"), "5:value1:,");
}
