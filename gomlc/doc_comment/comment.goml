package doc_comment;

use module::lexer;
use std::text;

pub struct Comment {
    pub start: isize,
    pub target: isize,
    pub text: string,
}

pub struct Comments {
    pub package_text: string,
    pub items: Vec[Comment],
}

pub fn is_outer(value: string) -> bool {
    value.starts_with("///") && !value.starts_with("////")
}

fn content(value: string) -> string {
    let value = value.byte_slice(3, value.byte_len());
    let value = if value.starts_with(" ") {
        value.byte_slice(1, value.byte_len())
    } else {
        value
    };
    if value.ends_with("\r") {
        value.byte_slice(0, value.byte_len() - 1)
    } else {
        value
    }
}

pub fn collect(source: string) -> Comments {
    let items = Vec::new();
    let package_lines: Vec[string] = Vec::new();
    let pending: Vec[string] = Vec::new();
    let mut offset = 0;
    let mut header = true;
    let mut line_start = true;
    let mut pending_start = 0;
    for token in lexer::lex(source) {
        if token.kind == lexer::TokenKind::Whitespace {
            let mut newlines = 0;
            for character in token.text.chars() {
                if character == '\n' {
                    newlines += 1;
                    line_start = true;
                }
            }
            if newlines > 1 {
                pending.clear()
            }
        } else if token.kind == lexer::TokenKind::Comment {
            if is_outer(token.text) && line_start {
                if pending.is_empty() {
                    pending_start = offset;
                }
                pending.push(content(token.text))
            } else {
                pending.clear();
                if header && line_start && token.text.starts_with("//!") {
                    package_lines.push(content(token.text))
                }
            }
            line_start = false;
        } else {
            if !pending.is_empty() {
                items.push(
                    Comment {
                        start: pending_start,
                        target: offset,
                        text: text::join(pending, "\n"),
                    },
                );
                pending.clear()
            }
            header = false;
            line_start = false;
        }
        offset += token.text.byte_len();
    }
    Comments { package_text: text::join(package_lines, "\n"), items }
}

pub fn signature_identity(value: string) -> string {
    let tokens = lexer::lex(value);
    let parts = Vec::new();
    for index in 0..tokens.len() {
        let token = tokens[index];
        if !lexer::token_is_trivia(token.kind) {
            let mut next = index + 1;
            while next < tokens.len() && lexer::token_is_trivia(tokens[next].kind) {
                next += 1;
            }
            if token.kind == lexer::TokenKind::Comma && next < tokens.len()
                && (tokens[next].kind == lexer::TokenKind::RBracket
                    || tokens[next].kind == lexer::TokenKind::RParen) {} else {
                parts.push(token.text.byte_len().to_string() + ":" + token.text)
            }
        }
    }
    text::join(parts, "")
}
