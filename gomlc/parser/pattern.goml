package parser;

use module::cst;
use module::lexer;

fn is_pattern_first(kind: lexer::TokenKind) -> bool {
    match kind {
        TrueKeyword | FalseKeyword | Ident | MutKeyword | LParen | LBracket | WildcardKeyword | Minus | IntLit | Float | Str | RawStr | CharLit | ByteCharLit => true,
        _ => false,
    }
}

fn pattern(parser: Parser) -> Option[MarkerClosed] {
    if !parser.enter_pattern() {
        Option::None
    } else {
        let result = or_pattern(parser);
        parser.leave_pattern();
        result
    }
}

fn or_pattern(parser: Parser) -> Option[MarkerClosed] {
    match alias_pattern(parser) {
        None => Option::None,
        Some(initial) => {
            if !parser.at(lexer::TokenKind::Pipe) {
                Option::Some(initial)
            } else {
                let marker = initial.precede(parser);
                while parser.eat(lexer::TokenKind::Pipe) {
                    if is_pattern_first(parser.peek()) {
                        let _ = alias_pattern(parser);
                    } else {
                        parser.error("expected a pattern after `|`");
                        break
                    }
                }
                Option::Some(marker.completed(parser, cst::NodeKind::PATTERN_OR))
            }
        },
    }
}

fn alias_pattern(parser: Parser) -> Option[MarkerClosed] {
    if parser.at_lower_ident() && token_is(parser.nth(1), lexer::TokenKind::At) {
        let marker = parser.open();
        parser.expect_lower_ident("pattern binding");
        parser.expect(lexer::TokenKind::At);
        if parser.enter_pattern() {
            if marker_is_none(alias_pattern(parser)) {
                parser.error("expected a pattern after `@`")
            }
            parser.leave_pattern()
        }
        Option::Some(parser.close(marker, cst::NodeKind::PATTERN_ALIAS))
    } else {
        range_pattern(parser)
    }
}

fn range_pattern(parser: Parser) -> Option[MarkerClosed] {
    match simple_pattern(parser) {
        None => Option::None,
        Some(value) => {
            let kind = parser.peek();
            if !token_is(kind, lexer::TokenKind::DotDot)
                && !token_is(kind, lexer::TokenKind::DotDotEq) {
                Option::Some(value)
            } else {
                let marker = value.precede(parser);
                parser.advance();
                if marker_is_none(simple_pattern(parser)) {
                    parser.error("expected a range pattern endpoint")
                }
                Option::Some(marker.completed(parser, cst::NodeKind::PATTERN_RANGE))
            }
        },
    }
}

fn parse_pattern_list(parser: Parser) -> () {
    if !is_pattern_first(parser.peek()) {} else {
        let _ = pattern(parser);
        loop {
            if parser.at(lexer::TokenKind::Comma) {
                parser.expect(lexer::TokenKind::Comma);
                if parser.at(lexer::TokenKind::RParen) {
                    break
                } else if is_pattern_first(parser.peek()) {
                    let _ = pattern(parser);
                } else {
                    parser.advance_with_error("expected a pattern")
                }
            } else if parser.at(lexer::TokenKind::RParen) || parser.eof() {
                break
            } else if is_pattern_first(parser.peek()) {
                parser.missing("expected `,` between patterns");
                let _ = pattern(parser);
            } else {
                parser.advance_with_error("expected `,` or `)` in pattern")
            }
        }
    }
}

fn numeric_pattern(parser: Parser, kind: cst::NodeKind) -> MarkerClosed {
    let marker = parser.open();
    parser.advance();
    parser.close(marker, kind)
}

fn negative_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.advance();
    let kind = match parser.peek() {
        IntLit => Option::Some(cst::NodeKind::PATTERN_INT),
        Float => Option::Some(cst::NodeKind::PATTERN_FLOAT),
        _ => Option::None,
    };
    match kind {
        Some(value) => {
            parser.advance();
            parser.close(marker, value)
        },
        None => {
            parser.error("expected a numeric literal after '-' in pattern");
            parser.close(marker, cst::NodeKind::ErrorTree)
        },
    }
}

fn simple_pattern(parser: Parser) -> Option[MarkerClosed] {
    if !is_pattern_first(parser.peek()) {
        let marker = parser.open();
        parser.error("expected a pattern");
        let _ = parser.close(marker, cst::NodeKind::ErrorTree);
        Option::None
    } else {
        let result = match parser.peek() {
            TrueKeyword | FalseKeyword => numeric_pattern(parser, cst::NodeKind::PATTERN_BOOL),
            Minus => negative_pattern(parser),
            IntLit => numeric_pattern(parser, cst::NodeKind::PATTERN_INT),
            Float => numeric_pattern(parser, cst::NodeKind::PATTERN_FLOAT),
            Str | RawStr => numeric_pattern(parser, cst::NodeKind::PATTERN_STRING),
            CharLit => numeric_pattern(parser, cst::NodeKind::PATTERN_CHAR),
            ByteCharLit => numeric_pattern(parser, cst::NodeKind::PATTERN_BYTE),
            WildcardKeyword => numeric_pattern(parser, cst::NodeKind::PATTERN_WILDCARD),
            LParen => tuple_pattern(parser),
            LBracket => array_pattern(parser),
            Ident => ident_pattern(parser),
            MutKeyword => mutable_pattern(parser),
            _ => {
                let marker = parser.open();
                parser.close(marker, cst::NodeKind::ErrorTree)
            },
        };
        Option::Some(result)
    }
}

fn mutable_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::MutKeyword);
    parser.expect_lower_ident("mutable pattern binding");
    parser.close(marker, cst::NodeKind::PATTERN_VARIABLE)
}

fn tuple_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.advance();
    if parser.at(lexer::TokenKind::RParen) {
        parser.expect(lexer::TokenKind::RParen);
        parser.close(marker, cst::NodeKind::PATTERN_UNIT)
    } else {
        parse_pattern_list(parser);
        parser.expect(lexer::TokenKind::RParen);
        parser.close(marker, cst::NodeKind::PATTERN_TUPLE)
    }
}

fn ident_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    let next = parser.nth(1);
    let simple = !token_is(next, lexer::TokenKind::ColonColon)
        && !token_is(next, lexer::TokenKind::LParen)
        && !token_is(next, lexer::TokenKind::LBrace);
    if simple && parser.at_lower_ident() {
        parser.expect_lower_ident("pattern binding");
        parser.close(marker, cst::NodeKind::PATTERN_VARIABLE)
    } else {
        parse_path_always(parser);
        if parser.at(lexer::TokenKind::LParen) {
            parser.expect(lexer::TokenKind::LParen);
            parse_pattern_list(parser);
            parser.expect(lexer::TokenKind::RParen)
        } else if parser.at(lexer::TokenKind::LBrace) {
            struct_pattern_field_list(parser)
        }
        parser.close(marker, cst::NodeKind::PATTERN_CONSTR)
    }
}

fn array_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBracket);
    let mut has_rest = false;
    while !parser.eof() && !parser.at(lexer::TokenKind::RBracket)
        && !is_list_boundary(parser.peek()) {
        let bound_rest = parser.at(lexer::TokenKind::Ident)
            && token_is(parser.nth(1), lexer::TokenKind::At)
            && token_is(parser.nth(2), lexer::TokenKind::DotDot);
        if parser.at(lexer::TokenKind::DotDot) || bound_rest {
            if has_rest {
                parser.error("array pattern can contain at most one `..`")
            }
            let _ = rest_pattern(parser);
            has_rest = true;
        } else if is_pattern_first(parser.peek()) {
            let _ = pattern(parser);
        } else {
            parser.advance_with_error("expected an array pattern element")
        }
        if parser.eat(lexer::TokenKind::Comma) {} else if !parser.at(lexer::TokenKind::RBracket)
            && !is_list_boundary(parser.peek()) {
            parser.error("expected `,` or `]` in array pattern");
            if !parser.eof() && !is_pattern_first(parser.peek()) {
                parser.advance()
            }
        }
    }
    parser.expect(lexer::TokenKind::RBracket);
    parser.close(marker, cst::NodeKind::PATTERN_ARRAY)
}

fn rest_pattern(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    if parser.at_lower_ident() {
        parser.expect_lower_ident("rest pattern binding");
        parser.expect(lexer::TokenKind::At)
    }
    parser.expect(lexer::TokenKind::DotDot);
    parser.close(marker, cst::NodeKind::PATTERN_REST)
}

fn struct_pattern_field_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    let mut has_rest = false;
    while !parser.eof() && !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
        if parser.at(lexer::TokenKind::DotDot) {
            if has_rest {
                parser.error("struct pattern can contain at most one `..`")
            }
            let _ = rest_pattern(parser);
            has_rest = true;
            parser.eat(lexer::TokenKind::Comma);
            if !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
                parser.error("`..` must be the last item in a struct pattern")
            }
        } else if parser.at(lexer::TokenKind::Ident) {
            struct_pattern_field(parser);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
                || is_list_boundary(parser.peek()) {} else {
                parser.error("expected `,` between struct pattern fields")
            }
        } else {
            parser.advance_with_error("expected a struct pattern field")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::STRUCT_PATTERN_FIELD_LIST);
}

fn struct_pattern_field(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect_lower_ident("struct pattern field name");
    if parser.at(lexer::TokenKind::Colon) {
        parser.expect(lexer::TokenKind::Colon);
        if is_pattern_first(parser.peek()) {
            let _ = pattern(parser);
        } else {
            parser.advance_with_error("expected a pattern")
        }
    }
    let _ = parser.close(marker, cst::NodeKind::STRUCT_PATTERN_FIELD);
}
