package parser;

use module::cst;
use module::lexer;

fn let_stmt(parser: Parser) -> Option[MarkerClosed] {
    if !parser.at(lexer::TokenKind::LetKeyword) {
        Option::None
    } else {
        let marker = parser.open();
        parser.expect(lexer::TokenKind::LetKeyword);
        parser.eat(lexer::TokenKind::MutKeyword);
        if marker_is_none(pattern(parser)) {
            parser.advance_with_error("expected a pattern in let statement")
        }
        if parser.at(lexer::TokenKind::Colon) {
            parser.expect(lexer::TokenKind::Colon);
            type_expr(parser)
        }
        parser.expect(lexer::TokenKind::Eq);
        expect_expr_with_message(parser, "let statement expected an expression");
        if parser.eat(lexer::TokenKind::ElseKeyword) {
            if parser.at(lexer::TokenKind::LBrace) {
                block(parser)
            } else {
                parser.error("`let else` requires a block after `else`")
            }
        }
        parser.expect(lexer::TokenKind::Semi);
        Option::Some(parser.close(marker, cst::NodeKind::STMT_LET))
    }
}

fn finish_assign_stmt(parser: Parser, target: MarkerClosed, operator: lexer::TokenKind) -> MarkerClosed {
    let marker = target.precede(parser);
    parser.expect(operator);
    expect_expr_with_message(parser, "assignment statement expected an expression");
    parser.expect(lexer::TokenKind::Semi);
    parser.close(marker, cst::NodeKind::STMT_ASSIGN)
}

fn wrap_expr_stmt(parser: Parser, expression: MarkerClosed) -> MarkerClosed {
    let marker = expression.precede(parser);
    parser.close(marker, cst::NodeKind::STMT_EXPR)
}

fn defer_stmt(parser: Parser) -> Option[MarkerClosed] {
    if !parser.at(lexer::TokenKind::DeferKeyword) {
        Option::None
    } else {
        let marker = parser.open();
        parser.expect(lexer::TokenKind::DeferKeyword);
        expect_expr_with_message(parser, "defer statement expected an expression");
        parser.expect(lexer::TokenKind::Semi);
        Option::Some(parser.close(marker, cst::NodeKind::STMT_DEFER))
    }
}
