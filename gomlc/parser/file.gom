package parser;

use module::cst;
use module::lexer;

fn is_type_first(kind: lexer::TokenKind) -> bool {
    match kind {
        BoolKeyword | IsizeKeyword | I8Keyword | I16Keyword | I32Keyword | I64Keyword | UsizeKeyword | U8Keyword | U16Keyword | U32Keyword | U64Keyword | F32Keyword | F64Keyword | StringKeyword | CharKeyword | DynKeyword | LBracket | LParen | Ident => true,
        _ => false,
    }
}

fn is_param_list_recovery(kind: lexer::TokenKind) -> bool {
    match kind {
        Arrow | LBrace | RBrace | RBracket | Semi | WhereKeyword => true,
        _ => is_block_recovery(kind),
    }
}

fn is_block_recovery(kind: lexer::TokenKind) -> bool {
    match kind {
        Pound | PubKeyword | FnKeyword | ExternKeyword | StructKeyword | EnumKeyword | TraitKeyword | ImplKeyword | TypeKeyword | ConstKeyword | StaticKeyword | PackageKeyword | UseKeyword => true,
        _ => false,
    }
}

fn is_list_boundary(kind: lexer::TokenKind) -> bool {
    match kind {
        RParen | RBrace | RBracket | Semi => true,
        _ => false,
    }
}

fn is_generic_list_recovery(kind: lexer::TokenKind) -> bool {
    match kind {
        LParen | LBrace | Arrow | Eq | WhereKeyword => true,
        _ => is_list_boundary(kind),
    }
}

fn is_type_list_recovery(kind: lexer::TokenKind) -> bool {
    match kind {
        LBrace | Arrow | FatArrow => true,
        _ => is_list_boundary(kind),
    }
}

fn is_enum_body_recovery(kind: lexer::TokenKind) -> bool {
    is_block_recovery(kind) && !token_is(kind, lexer::TokenKind::Pound)
}

fn is_struct_body_recovery(kind: lexer::TokenKind) -> bool {
    is_enum_body_recovery(kind) && !token_is(kind, lexer::TokenKind::PubKeyword)
}

fn is_trait_body_recovery(kind: lexer::TokenKind) -> bool {
    is_block_recovery(kind) && !token_is(kind, lexer::TokenKind::FnKeyword)
        && !token_is(kind, lexer::TokenKind::TypeKeyword)
}

fn is_impl_body_recovery(kind: lexer::TokenKind) -> bool {
    is_trait_body_recovery(kind) && !token_is(kind, lexer::TokenKind::PubKeyword)
}

fn parse_file(parser: Parser) -> () {
    let marker = parser.open();
    if parser.at(lexer::TokenKind::PackageKeyword) {
        package_decl(parser)
    }
    while parser.at(lexer::TokenKind::UseKeyword)
        || (parser.at(lexer::TokenKind::PubKeyword) && parser.nth(1) == lexer::TokenKind::UseKeyword) {
        use_decl(parser)
    }
    while !parser.eof() {
        if parser.at(lexer::TokenKind::Pound) {
            let attrs = attribute_list(parser);
            item_with_attrs(parser, attrs)
        } else if parser.at(lexer::TokenKind::PubKeyword) {
            public_item(parser)
        } else if parser.at(lexer::TokenKind::PackageKeyword) {
            parser.advance_with_error("package declaration must appear at the top of the file")
        } else if parser.at(lexer::TokenKind::UseKeyword) {
            parser.advance_with_error("use declaration must appear before top-level items")
        } else if parser.at(lexer::TokenKind::ExternKeyword) {
            extern_decl(parser)
        } else if parser.at(lexer::TokenKind::FnKeyword) {
            func(parser)
        } else if parser.at(lexer::TokenKind::EnumKeyword) {
            enum_def(parser)
        } else if parser.at(lexer::TokenKind::StructKeyword) {
            struct_def(parser)
        } else if parser.at(lexer::TokenKind::TraitKeyword) {
            trait_def(parser)
        } else if parser.at(lexer::TokenKind::ImplKeyword) {
            impl_block(parser)
        } else if parser.at(lexer::TokenKind::TypeKeyword) {
            type_alias(parser)
        } else if parser.at(lexer::TokenKind::ConstKeyword) {
            constant(parser)
        } else if parser.at(lexer::TokenKind::StaticKeyword) {
            static_item(parser)
        } else if is_expr_first(parser.peek()) {
            if marker_is_none(expr(parser)) {
                parser.advance_with_error("expected an expression")
            }
        } else {
            parser.advance_with_error("expected a function")
        }
    }
    let _ = parser.close(marker, cst::NodeKind::FILE);
}

fn package_decl(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::PackageKeyword);
    parser.expect_lower_ident("package name");
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::PACKAGE);
}

fn use_decl(parser: Parser) -> () {
    let marker = parser.open();
    use_decl_with_marker(parser, marker)
}

fn use_decl_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    if parser.at(lexer::TokenKind::PubKeyword) {
        parser.expect(lexer::TokenKind::PubKeyword)
    }
    parser.expect(lexer::TokenKind::UseKeyword);
    if parser.at(lexer::TokenKind::Ident) {
        use_path(parser)
    } else if !parser.eof() {
        parser.advance_with_error("expected a path after `use`")
    }
    if parser.at(lexer::TokenKind::LBrace) {
        use_item_list(parser)
    } else if parser.eat(lexer::TokenKind::AsKeyword) {
        parser.expect(lexer::TokenKind::Ident)
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::USE);
}

fn use_path(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    while parser.at(lexer::TokenKind::ColonColon) && parser.nth(1) == lexer::TokenKind::Ident {
        parser.advance();
        parser.advance()
    }
    if parser.at(lexer::TokenKind::ColonColon) && parser.nth(1) == lexer::TokenKind::LBrace {
        parser.advance()
    }
    let _ = parser.close(marker, cst::NodeKind::PATH);
}

fn use_item_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    if parser.at(lexer::TokenKind::RBrace) {
        parser.error("use item list cannot be empty")
    }
    while !parser.eof() && !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
        let item = parser.open();
        parser.expect(lexer::TokenKind::Ident);
        if parser.eat(lexer::TokenKind::AsKeyword) {
            parser.expect(lexer::TokenKind::Ident)
        }
        let _ = parser.close(item, cst::NodeKind::USE_ITEM);
        if parser.eat(lexer::TokenKind::Comma) {} else if !parser.at(lexer::TokenKind::RBrace)
            && !is_list_boundary(parser.peek()) {
            parser.advance_with_error("expected ',' or '}' in use item list")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::USE_ITEM_LIST);
}

fn item_with_attrs(parser: Parser, attrs: MarkerClosed) -> () {
    let marker = attrs.precede(parser);
    if parser.at(lexer::TokenKind::PubKeyword) {
        public_item_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::ExternKeyword) {
        extern_decl_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::FnKeyword) {
        func_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::EnumKeyword) {
        enum_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::StructKeyword) {
        struct_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::TraitKeyword) {
        trait_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::ImplKeyword) {
        impl_block_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::TypeKeyword) {
        type_alias_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::ConstKeyword) {
        constant_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::StaticKeyword) {
        static_with_marker(parser, marker)
    } else {
        parser.error("expected a top-level item after attributes");
        if !parser.eof() {
            parser.advance()
        }
        let _ = parser.close(marker, cst::NodeKind::ErrorTree);
    }
}

fn public_item(parser: Parser) -> () {
    let marker = parser.open();
    public_item_with_marker(parser, marker)
}

fn public_item_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::PubKeyword);
    if parser.at(lexer::TokenKind::UseKeyword) {
        use_decl_after_pub(parser, marker)
    } else if parser.at(lexer::TokenKind::ExternKeyword) {
        extern_decl_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::FnKeyword) {
        func_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::EnumKeyword) {
        enum_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::StructKeyword) {
        struct_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::TraitKeyword) {
        trait_def_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::TypeKeyword) {
        type_alias_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::ConstKeyword) {
        constant_with_marker(parser, marker)
    } else if parser.at(lexer::TokenKind::StaticKeyword) {
        static_with_marker(parser, marker)
    } else {
        parser.error("expected a public top-level item");
        if !parser.eof() {
            parser.advance()
        }
        let _ = parser.close(marker, cst::NodeKind::ErrorTree);
    }
}

fn use_decl_after_pub(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::UseKeyword);
    if parser.at(lexer::TokenKind::Ident) {
        use_path(parser)
    } else if !parser.eof() {
        parser.advance_with_error("expected a path after `use`")
    }
    if parser.at(lexer::TokenKind::LBrace) {
        use_item_list(parser)
    } else if parser.eat(lexer::TokenKind::AsKeyword) {
        parser.expect(lexer::TokenKind::Ident)
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::USE);
}

fn type_alias(parser: Parser) -> () {
    let marker = parser.open();
    type_alias_with_marker(parser, marker)
}

fn type_alias_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::TypeKeyword);
    parser.expect_upper_ident("type alias name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, false)
    }
    parser.expect(lexer::TokenKind::Eq);
    if is_type_first(parser.peek()) {
        type_expr(parser)
    } else {
        parser.error("expected a type after `=`")
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::TYPE_ALIAS);
}

fn constant(parser: Parser) -> () {
    let marker = parser.open();
    constant_with_marker(parser, marker)
}

fn constant_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::ConstKeyword);
    parser.expect(lexer::TokenKind::Ident);
    parser.expect(lexer::TokenKind::Colon);
    if is_type_first(parser.peek()) {
        type_expr(parser)
    } else {
        parser.error("expected a constant type after `:`")
    }
    parser.expect(lexer::TokenKind::Eq);
    if marker_is_none(expr(parser)) {
        parser.error("expected a constant expression after `=`")
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::CONST);
}

fn static_item(parser: Parser) -> () {
    let marker = parser.open();
    static_with_marker(parser, marker)
}

fn static_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::StaticKeyword);
    parser.expect(lexer::TokenKind::Ident);
    parser.expect(lexer::TokenKind::Colon);
    if is_type_first(parser.peek()) {
        type_expr(parser)
    } else {
        parser.error("expected a static type after `:`")
    }
    parser.expect(lexer::TokenKind::Eq);
    if marker_is_none(expr(parser)) {
        parser.error("expected a static initializer after `=`")
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::STATIC);
}

fn attribute_list(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    while parser.at(lexer::TokenKind::Pound) {
        attribute(parser)
    }
    parser.close(marker, cst::NodeKind::ATTRIBUTE_LIST)
}

fn attribute(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Pound);
    parser.eat(lexer::TokenKind::Bang);
    if parser.eat(lexer::TokenKind::LBracket) {
        attribute_body(parser)
    } else {
        parser.error("expected '[' after '#'")
    }
    let _ = parser.close(marker, cst::NodeKind::ATTRIBUTE);
}

fn attribute_body(parser: Parser) -> () {
    let mut depth = 1;
    while depth > 0 && !parser.eof() {
        if parser.at(lexer::TokenKind::LBracket) {
            depth += 1;
            parser.advance()
        } else if parser.at(lexer::TokenKind::RBracket) {
            depth -= 1;
            parser.advance()
        } else if depth == 1 && is_block_recovery(parser.peek()) {
            parser.missing("unterminated attribute, expected `]`");
            return
        } else {
            parser.advance()
        }
    }
    if depth > 0 {
        parser.error("unterminated attribute")
    }
}

fn extern_decl(parser: Parser) -> () {
    let marker = parser.open();
    extern_decl_with_marker(parser, marker)
}

fn extern_decl_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::ExternKeyword);
    if parser.eat(lexer::TokenKind::TypeKeyword) {
        parser.expect_upper_ident("external type name");
        if parser.at(lexer::TokenKind::LBracket) {
            generic_list(parser, false)
        }
        parser.expect(lexer::TokenKind::Semi);
        let _ = parser.close(marker, cst::NodeKind::EXTERN_TYPE);
    } else if !parser.eat(lexer::TokenKind::FnKeyword) {
        parser.error("expected `fn` or `type` after `extern`");
        while !parser.eof() && !is_block_recovery(parser.peek()) {
            parser.advance()
        }
        let _ = parser.close(marker, cst::NodeKind::ErrorTree);
    } else {
        parser.expect_lower_ident("function name");
        if parser.at(lexer::TokenKind::LBracket) {
            generic_list(parser, true)
        }
        param_list(parser);
        if parser.eat(lexer::TokenKind::Arrow) {
            type_expr(parser)
        }
        if parser.at(lexer::TokenKind::WhereKeyword) {
            where_clause(parser)
        }
        parser.expect(lexer::TokenKind::Semi);
        let _ = parser.close(marker, cst::NodeKind::EXTERN);
    }
}

fn func(parser: Parser) -> () {
    let marker = parser.open();
    func_with_marker(parser, marker)
}

fn func_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::FnKeyword);
    parser.expect_lower_ident("function name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, true)
    }
    param_list(parser);
    if parser.eat(lexer::TokenKind::Arrow) {
        type_expr(parser)
    }
    if parser.at(lexer::TokenKind::WhereKeyword) {
        where_clause(parser)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("functions must have a body");
        parser.eat(lexer::TokenKind::Semi);
    }
    let _ = parser.close(marker, cst::NodeKind::FN);
}

fn impl_block(parser: Parser) -> () {
    let marker = parser.open();
    impl_block_with_marker(parser, marker)
}

fn impl_block_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::ImplKeyword);
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, true)
    }
    type_expr(parser);
    if parser.eat(lexer::TokenKind::ForKeyword) {
        type_expr(parser)
    }
    if parser.at(lexer::TokenKind::WhereKeyword) {
        where_clause(parser)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        parser.advance();
        while !parser.at(lexer::TokenKind::RBrace) && !parser.eof()
            && !is_impl_body_recovery(parser.peek()) {
            if parser.at(lexer::TokenKind::FnKeyword) {
                func(parser)
            } else if parser.at(lexer::TokenKind::PubKeyword) {
                let marker = parser.open();
                parser.expect(lexer::TokenKind::PubKeyword);
                if parser.at(lexer::TokenKind::FnKeyword) {
                    func_with_marker(parser, marker)
                } else {
                    parser.error("expected a function after `pub`");
                    if !parser.eof() {
                        parser.advance()
                    }
                    let _ = parser.close(marker, cst::NodeKind::ErrorTree);
                }
            } else if parser.at(lexer::TokenKind::TypeKeyword) {
                impl_associated_type(parser)
            } else {
                parser.advance_with_error("expected a function or associated type binding")
            }
        }
        parser.expect(lexer::TokenKind::RBrace)
    } else {
        parser.error("impl declarations require a brace-delimited body")
    }
    let _ = parser.close(marker, cst::NodeKind::IMPL);
}

fn trait_def(parser: Parser) -> () {
    let marker = parser.open();
    trait_def_with_marker(parser, marker)
}

fn trait_def_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::TraitKeyword);
    parser.expect_upper_ident("trait name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, true)
    }
    if parser.eat(lexer::TokenKind::Colon) {
        trait_set(parser)
    }
    if parser.at(lexer::TokenKind::WhereKeyword) {
        where_clause(parser)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        trait_method_list(parser)
    } else {
        parser.error("trait declarations require a brace-delimited body")
    }
    let _ = parser.close(marker, cst::NodeKind::TRAIT);
}

fn trait_method_list(parser: Parser) -> () {
    parser.expect(lexer::TokenKind::LBrace);
    let marker = parser.open();
    while !parser.at(lexer::TokenKind::RBrace) && !parser.eof()
        && !is_trait_body_recovery(parser.peek()) {
        if parser.at(lexer::TokenKind::FnKeyword) {
            trait_method(parser);
        } else if parser.at(lexer::TokenKind::TypeKeyword) {
            trait_associated_type(parser)
        } else {
            parser.advance_with_error("expected a method or associated type")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::TRAIT_METHOD_SIG_LIST);
}

fn trait_method(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::FnKeyword);
    parser.expect_lower_ident("method name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, true)
    }
    param_list(parser);
    if parser.eat(lexer::TokenKind::Arrow) {
        type_expr(parser)
    }
    if parser.at(lexer::TokenKind::WhereKeyword) {
        where_clause(parser)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.expect(lexer::TokenKind::Semi)
    }
    let _ = parser.close(marker, cst::NodeKind::TRAIT_METHOD_SIG);
}

fn trait_associated_type(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::TypeKeyword);
    parser.expect_upper_ident("associated type name");
    if parser.eat(lexer::TokenKind::Colon) {
        trait_set(parser)
    }
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::TRAIT_ASSOCIATED_TYPE);
}

fn impl_associated_type(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::TypeKeyword);
    parser.expect_upper_ident("associated type name");
    parser.expect(lexer::TokenKind::Eq);
    type_expr(parser);
    parser.expect(lexer::TokenKind::Semi);
    let _ = parser.close(marker, cst::NodeKind::IMPL_ASSOCIATED_TYPE);
}

fn enum_def(parser: Parser) -> () {
    let marker = parser.open();
    enum_def_with_marker(parser, marker)
}

fn enum_def_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::EnumKeyword);
    parser.expect_upper_ident("enum name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, false)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        variant_list(parser)
    } else {
        parser.error("enum declarations require a brace-delimited body")
    }
    let _ = parser.close(marker, cst::NodeKind::ENUM);
}

fn struct_def(parser: Parser) -> () {
    let marker = parser.open();
    struct_def_with_marker(parser, marker)
}

fn struct_def_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect(lexer::TokenKind::StructKeyword);
    parser.expect_upper_ident("struct name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, false)
    }
    if parser.at(lexer::TokenKind::LBrace) {
        struct_field_list(parser)
    } else if parser.at(lexer::TokenKind::LParen) {
        newtype_field(parser);
        parser.expect(lexer::TokenKind::Semi)
    } else {
        parser.error(
            "struct declarations require a brace-delimited body or one parenthesized field",
        )
    }
    let _ = parser.close(marker, cst::NodeKind::STRUCT);
}

fn newtype_field(parser: Parser) -> () {
    parser.expect(lexer::TokenKind::LParen);
    if parser.at(lexer::TokenKind::RParen) {
        parser.error("newtype structs require exactly one field")
    } else {
        let marker = if parser.at(lexer::TokenKind::Pound) {
            attribute_list(parser).precede(parser)
        } else {
            parser.open()
        };
        parser.eat(lexer::TokenKind::PubKeyword);
        if is_type_first(parser.peek()) {
            type_expr(parser)
        } else {
            parser.error("expected a newtype field type")
        }
        let _ = parser.close(marker, cst::NodeKind::NEWTYPE_FIELD);
        parser.eat(lexer::TokenKind::Comma);
        while !parser.at(lexer::TokenKind::RParen) && !parser.eof()
            && !is_type_list_recovery(parser.peek()) {
            parser.advance_with_error("newtype structs require exactly one field")
        }
    }
    parser.expect(lexer::TokenKind::RParen)
}

fn variant_list(parser: Parser) -> () {
    parser.expect(lexer::TokenKind::LBrace);
    let marker = parser.open();
    while !parser.at(lexer::TokenKind::RBrace) && !parser.eof()
        && !is_enum_body_recovery(parser.peek()) {
        if parser.at(lexer::TokenKind::Ident) || parser.at(lexer::TokenKind::Pound) {
            if parser.at(lexer::TokenKind::Pound) {
                let attrs = attribute_list(parser);
                variant_with_marker(parser, attrs.precede(parser))
            } else {
                variant(parser)
            }
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
                || is_enum_body_recovery(parser.peek()) {} else {
                parser.error("expected `,` between enum variants")
            }
        } else {
            parser.advance_with_error("expected a variant")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::VARIANT_LIST);
}

fn struct_field_list(parser: Parser) -> () {
    parser.expect(lexer::TokenKind::LBrace);
    let marker = parser.open();
    while !parser.at(lexer::TokenKind::RBrace) && !parser.eof()
        && !is_struct_body_recovery(parser.peek()) {
        if parser.at(lexer::TokenKind::Ident) || parser.at(lexer::TokenKind::PubKeyword)
            || parser.at(lexer::TokenKind::Pound) {
            if parser.at(lexer::TokenKind::Pound) {
                let attrs = attribute_list(parser);
                struct_field_with_marker(parser, attrs.precede(parser))
            } else {
                struct_field(parser)
            }
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
                || is_struct_body_recovery(parser.peek()) {} else {
                parser.error("expected `,` between struct fields")
            }
        } else {
            parser.advance_with_error("expected a field")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::STRUCT_FIELD_LIST);
}

fn struct_field(parser: Parser) -> () {
    let marker = parser.open();
    struct_field_with_marker(parser, marker)
}

fn struct_field_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.eat(lexer::TokenKind::PubKeyword);
    parser.expect_lower_ident("field name");
    parser.expect(lexer::TokenKind::Colon);
    type_expr(parser);
    let _ = parser.close(marker, cst::NodeKind::STRUCT_FIELD);
}

fn variant(parser: Parser) -> () {
    let marker = parser.open();
    variant_with_marker(parser, marker)
}

fn variant_with_marker(parser: Parser, marker: MarkerOpened) -> () {
    parser.expect_upper_ident("enum variant name");
    if parser.at(lexer::TokenKind::LParen) {
        variant_type_list(parser)
    } else if parser.at(lexer::TokenKind::LBrace) {
        struct_field_list(parser)
    }
    let _ = parser.close(marker, cst::NodeKind::VARIANT);
}

fn variant_type_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LParen);
    while !parser.at(lexer::TokenKind::RParen) && !parser.eof()
        && !is_type_list_recovery(parser.peek()) {
        if parser.at(lexer::TokenKind::Pound) || is_type_first(parser.peek()) {
            let field_marker = if parser.at(lexer::TokenKind::Pound) {
                attribute_list(parser).precede(parser)
            } else {
                parser.open()
            };
            if is_type_first(parser.peek()) {
                type_expr(parser)
            } else {
                parser.error("expected a type after enum field attributes")
            }
            let _ = parser.close(field_marker, cst::NodeKind::ENUM_TUPLE_FIELD);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RParen)
                || is_type_list_recovery(parser.peek()) {} else {
                parser.error("expected `,` between types")
            }
        } else {
            parser.advance_with_error("expected a type")
        }
    }
    parser.expect(lexer::TokenKind::RParen);
    let _ = parser.close(marker, cst::NodeKind::TYPE_LIST);
}

fn type_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LParen);
    while !parser.at(lexer::TokenKind::RParen) && !parser.eof()
        && !is_type_list_recovery(parser.peek()) {
        if is_type_first(parser.peek()) {
            type_expr(parser);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RParen)
                || is_type_list_recovery(parser.peek()) {} else {
                parser.error("expected `,` between types")
            }
        } else {
            parser.advance_with_error("expected a type")
        }
    }
    parser.expect(lexer::TokenKind::RParen);
    let _ = parser.close(marker, cst::NodeKind::TYPE_LIST);
}

fn generic(parser: Parser, allow_bounds: bool) -> () {
    let marker = parser.open();
    parser.expect_upper_ident("generic parameter name");
    if parser.at(lexer::TokenKind::LBracket) {
        generic_list(parser, false)
    }
    if allow_bounds && parser.eat(lexer::TokenKind::Colon) {
        trait_set(parser)
    }
    let _ = parser.close(marker, cst::NodeKind::GENERIC);
}

fn trait_set(parser: Parser) -> () {
    let marker = parser.open();
    if parser.at(lexer::TokenKind::Ident) {
        trait_ref(parser)
    } else {
        parser.advance_with_error("expected a trait name");
        let _ = parser.close(marker, cst::NodeKind::TRAIT_SET);
        return
    }
    while parser.eat(lexer::TokenKind::Plus) {
        if parser.at(lexer::TokenKind::Ident) {
            trait_ref(parser)
        } else {
            parser.advance_with_error("expected a trait name after '+'");
            break
        }
    }
    let _ = parser.close(marker, cst::NodeKind::TRAIT_SET);
}

fn trait_ref(parser: Parser) -> () {
    let marker = parser.open();
    parse_path_always(parser);
    if parser.at(lexer::TokenKind::LBracket) {
        type_param_list(parser)
    }
    let _ = parser.close(marker, cst::NodeKind::TYPE_TAPP);
}

fn where_clause(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::WhereKeyword);
    while !parser.eof() && !parser.at(lexer::TokenKind::LBrace)
        && !parser.at(lexer::TokenKind::Semi) {
        where_predicate(parser);
        if !parser.eat(lexer::TokenKind::Comma) {
            break
        }
    }
    let _ = parser.close(marker, cst::NodeKind::WHERE_CLAUSE);
}

fn where_predicate(parser: Parser) -> () {
    let marker = parser.open();
    if is_type_first(parser.peek()) {
        type_expr(parser)
    } else {
        parser.advance_with_error("expected a type in where predicate");
        let _ = parser.close(marker, cst::NodeKind::WHERE_PREDICATE);
        return
    }
    if parser.eat(lexer::TokenKind::Colon) {
        trait_set(parser)
    } else if parser.eat(lexer::TokenKind::Eq) {
        if is_type_first(parser.peek()) {
            type_expr(parser)
        } else {
            parser.advance_with_error("expected a type after '='")
        }
    } else {
        parser.error("expected ':' or '=' in where predicate")
    }
    let _ = parser.close(marker, cst::NodeKind::WHERE_PREDICATE);
}

fn generic_list(parser: Parser, allow_bounds: bool) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBracket);
    while !parser.at(lexer::TokenKind::RBracket) && !parser.eof()
        && !is_generic_list_recovery(parser.peek()) {
        if parser.at(lexer::TokenKind::Ident) {
            generic(parser, allow_bounds);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBracket)
                || is_generic_list_recovery(parser.peek()) {} else {
                parser.error("expected `,` between generic parameters")
            }
        } else {
            parser.advance_with_error("expected a generic")
        }
    }
    parser.expect(lexer::TokenKind::RBracket);
    let _ = parser.close(marker, cst::NodeKind::GENERIC_LIST);
}

fn param_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LParen);
    while !parser.at(lexer::TokenKind::RParen) && !parser.eof() {
        if parser.at(lexer::TokenKind::Ident) {
            param(parser)
        } else if is_param_list_recovery(parser.peek()) {
            break
        } else {
            parser.advance_with_error("expected a parameter")
        }
    }
    parser.expect(lexer::TokenKind::RParen);
    let _ = parser.close(marker, cst::NodeKind::PARAM_LIST);
}

fn param(parser: Parser) -> () {
    let marker = parser.open();
    let self_shorthand = parser.at_contextual("self") && parser.nth(1) != lexer::TokenKind::Colon;
    parser.expect_lower_ident("parameter name");
    if parser.eat(lexer::TokenKind::Colon) {
        type_expr(parser)
    } else if !self_shorthand {
        parser.error("only the first trait or impl parameter may use the `self` shorthand")
    }
    if !parser.at(lexer::TokenKind::RParen) && !is_param_list_recovery(parser.peek()) {
        parser.expect(lexer::TokenKind::Comma)
    }
    let _ = parser.close(marker, cst::NodeKind::PARAM);
}

fn type_expr(parser: Parser) -> () {
    if marker_is_none(type_expr_bp(parser, 0)) && !parser.eof() {
        parser.advance_with_error("expected a type")
    }
}

fn type_expr_bp(parser: Parser, min_bp: isize) -> Option[MarkerClosed] {
    if !parser.enter_type() {
        Option::None
    } else {
        match type_atom(parser) {
            None => {
                parser.leave_type();
                Option::None
            },
            Some(initial) => {
                let mut lhs = initial;
                while !parser.eof() {
                    if parser.at(lexer::TokenKind::Arrow) {
                        let left_bp = 5;
                        let right_bp = 4;
                        if left_bp < min_bp {
                            break
                        } else {
                            let marker = lhs.precede(parser);
                            parser.expect(lexer::TokenKind::Arrow);
                            if marker_is_none(type_expr_bp(parser, right_bp)) {
                                parser.error("expected a return type")
                            }
                            lhs = marker.completed(parser, cst::NodeKind::TYPE_FUNC);
                        }
                    } else {
                        break
                    }
                }
                let result = lhs;
                parser.leave_type();
                Option::Some(result)
            },
        }
    }
}

fn type_atom(parser: Parser) -> Option[MarkerClosed] {
    let marker = parser.open();
    let result = match parser.peek() {
        BoolKeyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_BOOL)
        },
        IsizeKeyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_INT)
        },
        I8Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_INT8)
        },
        I16Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_INT16)
        },
        I32Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_INT32)
        },
        I64Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_INT64)
        },
        UsizeKeyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_UINT)
        },
        U8Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_UINT8)
        },
        U16Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_UINT16)
        },
        U32Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_UINT32)
        },
        U64Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_UINT64)
        },
        F32Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_FLOAT32)
        },
        F64Keyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_FLOAT64)
        },
        StringKeyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_STRING)
        },
        CharKeyword => {
            parser.advance();
            parser.close(marker, cst::NodeKind::TYPE_CHAR)
        },
        LParen => {
            type_list(parser);
            parser.close(marker, cst::NodeKind::TYPE_TUPLE)
        },
        LBracket => {
            parser.expect(lexer::TokenKind::LBracket);
            if is_type_first(parser.peek()) {
                if marker_is_none(type_expr_bp(parser, 0)) {
                    parser.error("expected array element type")
                }
            } else if is_list_boundary(parser.peek()) {
                parser.error("expected array element type")
            } else {
                parser.advance_with_error("expected array element type")
            }
            parser.expect(lexer::TokenKind::Semi);
            if parser.at(lexer::TokenKind::IntLit) {
                parser.advance()
            } else if is_list_boundary(parser.peek()) {
                parser.error("expected array length")
            } else {
                parser.advance_with_error("expected array length")
            }
            parser.expect(lexer::TokenKind::RBracket);
            parser.close(marker, cst::NodeKind::TYPE_ARRAY)
        },
        Ident => {
            parse_path_always(parser);
            if parser.at(lexer::TokenKind::LBracket) {
                type_param_list(parser)
            }
            parser.close(marker, cst::NodeKind::TYPE_TAPP)
        },
        DynKeyword => {
            parser.expect(lexer::TokenKind::DynKeyword);
            dyn_bound(parser);
            while parser.eat(lexer::TokenKind::Plus) {
                dyn_bound(parser)
            }
            parser.close(marker, cst::NodeKind::TYPE_DYN)
        },
        _ => {
            let _ = parser.events.pop();
            return Option::None
        },
    };
    Option::Some(result)
}

fn dyn_bound(parser: Parser) -> () {
    let marker = parser.open();
    if parser.at(lexer::TokenKind::Ident) {
        parse_path_always(parser)
    } else {
        parser.advance_with_error("expected a trait name in dyn type")
    }
    if parser.at(lexer::TokenKind::LBracket) {
        dyn_arg_list(parser)
    }
    let _ = parser.close(marker, cst::NodeKind::DYN_BOUND);
}

fn dyn_arg_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBracket);
    let mut saw_associated_binding = false;
    while !parser.at(lexer::TokenKind::RBracket) && !parser.eof()
        && !is_list_boundary(parser.peek()) {
        if parser.at(lexer::TokenKind::Ident) && parser.nth(1) == lexer::TokenKind::Eq {
            saw_associated_binding = true;
            let binding = parser.open();
            parser.advance();
            parser.advance();
            if is_type_first(parser.peek()) {
                type_expr(parser)
            } else {
                parser.advance_with_error("expected a type in dyn associated type binding")
            }
            let _ = parser.close(binding, cst::NodeKind::DYN_ASSOC_BINDING);
        } else if is_type_first(parser.peek()) {
            if saw_associated_binding {
                parser.error("dyn type arguments must precede associated type bindings")
            }
            type_expr(parser)
        } else {
            parser.advance_with_error("expected a type argument or associated type binding")
        }
        if parser.eat(lexer::TokenKind::Comma) {} else if !parser.at(lexer::TokenKind::RBracket)
            && !is_list_boundary(parser.peek()) {
            parser.error("expected `,` between dyn arguments")
        }
    }
    parser.expect(lexer::TokenKind::RBracket);
    let _ = parser.close(marker, cst::NodeKind::DYN_ARG_LIST);
}

fn type_param_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBracket);
    while !parser.at(lexer::TokenKind::RBracket) && !parser.eof()
        && !is_list_boundary(parser.peek()) {
        if is_type_first(parser.peek()) {
            type_expr(parser);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBracket)
                || is_list_boundary(parser.peek()) {} else {
                parser.error("expected `,` between type arguments")
            }
        } else {
            parser.advance_with_error("expected a type")
        }
    }
    parser.expect(lexer::TokenKind::RBracket);
    let _ = parser.close(marker, cst::NodeKind::TYPE_PARAM_LIST);
}

fn block(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    let previous = parser.set_struct_literals_allowed(true);
    let mut trailing_expr_seen = false;
    let mut parsing = true;
    while parsing && !parser.eof() && !parser.at(lexer::TokenKind::RBrace) {
        if trailing_expr_seen {
            if !is_block_recovery(parser.peek()) {
                parser.advance_with_error("expected `}` after block expression");
            }
            parsing = false;
        } else if parser.at(lexer::TokenKind::LetKeyword) {
            let _ = let_stmt(parser);
        } else if parser.at(lexer::TokenKind::DeferKeyword) {
            let _ = defer_stmt(parser);
        } else if is_expr_first(parser.peek()) {
            let semicolon_optional = match parser.peek() {
                IfKeyword | MatchKeyword | WhileKeyword | LoopKeyword | ForKeyword => true,
                Ident if parser.at_contextual("select")
                    && token_is(parser.nth(1), lexer::TokenKind::LBrace) => true,
                _ => false,
            };
            match expr(parser) {
                Some(expr_marker) => {
                    let assignment_operator = match parser.peek() {
                        Eq | PlusEq | MinusEq | StarEq | SlashEq | PercentEq | AmpEq | PipeEq | CaretEq | LessLessEq | GreaterGreaterEq => Option::Some(
                            parser.peek(),
                        ),
                        _ => Option::None,
                    };
                    match assignment_operator {
                        Some(operator) => {
                            let _ = finish_assign_stmt(parser, expr_marker, operator);
                        },
                        None => if parser.eat(lexer::TokenKind::Semi) {
                            let _ = wrap_expr_stmt(parser, expr_marker);
                        } else if semicolon_optional && !parser.at(lexer::TokenKind::RBrace) {
                            let _ = wrap_expr_stmt(parser, expr_marker);
                        } else if parser.at(lexer::TokenKind::LetKeyword)
                            || parser.at(lexer::TokenKind::DeferKeyword)
                            || is_expr_first(parser.peek()) {
                            parser.expect(lexer::TokenKind::Semi);
                            let _ = wrap_expr_stmt(parser, expr_marker);
                        } else {
                            trailing_expr_seen = true;
                        },
                    }
                },
                None => {
                    parsing = false;
                },
            }
        } else if parser.eat(lexer::TokenKind::Semi) {} else if is_block_recovery(parser.peek()) {
            parser.error("expected `}` to close block");
            parsing = false;
        } else {
            parser.advance_with_error("expected a statement or expression")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    parser.set_struct_literals_allowed(previous);
    let _ = parser.close(marker, cst::NodeKind::BLOCK);
}
