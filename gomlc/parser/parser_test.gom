package parser;

use module::cst;
use std::testing;
use std::text;

fn append_source(node: cst::CstNode, builder: text::StringBuilder) -> () {
    for child in cst::node_children(node) {
        match child {
            Node(inner) => append_source(inner, builder),
            Token(token) => builder.write_string(token.text),
        }
    }
}

fn count_nodes(node: cst::CstNode, kind: cst::NodeKind) -> isize {
    let count = Ref::new(
        if cst::node_kind_equal(cst::node_kind(node), kind) {
            1
        } else {
            0
        },
    );
    for child in cst::node_children(node) {
        match child {
            Node(inner) => count.set(count.get() + count_nodes(inner, kind)),
            Token(_) => (),
        }
    }
    count.get()
}

fn has_prefix_with_direct_child(node: cst::CstNode, kind: cst::NodeKind) -> bool {
    let found = Ref::new(false);
    for child in cst::node_children(node) {
        match child {
            Node(inner) => {
                if cst::node_kind_equal(cst::node_kind(node), cst::NodeKind::EXPR_PREFIX)
                    && cst::node_kind_equal(cst::node_kind(inner), kind) {
                    found.set(true)
                } else if has_prefix_with_direct_child(inner, kind) {
                    found.set(true)
                }
            },
            Token(_) => (),
        }
    }
    found.get()
}

fn source_offset(source: string, expected: string) -> isize {
    let mut index = 0;
    while index + expected.byte_len() <= source.byte_len() {
        if text::starts_with_at(source, index, expected) {
            return index
        } else {
            index += 1;
        }
    };
    -1
}

fn diagnostic_containing(diagnostics: Vec[cst::Diagnostic], expected: string) -> Option[
    cst::Diagnostic,
] {
    for diagnostic in diagnostics {
        if diagnostic.message.contains(expected) {
            return Option::Some(diagnostic)
        }
    }
    Option::None
}

#[test]
fn parses_lossless_precedence_tree() -> () {
    let source =
        \\fn main() -> i32 {
        \\    1 + 2 * 3 // keep
        \\}
        \\
    ;
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(cst::node_kind_equal(cst::node_kind(result.root), cst::NodeKind::FILE));
    testing::assert_eq(cst::node_byte_len(result.root), source.byte_len());
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BINARY), 2);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn parses_half_open_and_inclusive_range_expressions() -> () {
    let source = "fn main() -> () { for value in 1..4 { println(value) }; for value in 4..=6 { println(value) }; }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_RANGE), 2);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn parses_empty_tuple_type() -> () {
    let source = "type Callback = () -> (); fn consume(value: (), callback: Callback) -> () { callback() } fn one_unit_argument(callback: (()) -> ()) -> () { callback(()) }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_FUNC), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_TUPLE), 8)
}

#[test]
fn parses_braced_imports_with_item_aliases() -> () {
    let source = "package main; use alice::render::{Canvas, Color as Paint, render}; fn main() -> () {}";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::USE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::USE_ITEM_LIST), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::USE_ITEM), 3);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn rejects_unsupported_braced_import_forms() -> () {
    testing::assert(!parse("use alice::api::{};").diagnostics.is_empty());
    testing::assert(!parse("use alice::api::{*};").diagnostics.is_empty());
    testing::assert(!parse("use alice::api::{thing::{nested}};").diagnostics.is_empty())
}

#[test]
fn reports_recoverable_syntax_errors() -> () {
    let source = "fn main( { let value = ; } trailing";
    let result = parse(source);
    testing::assert(!result.diagnostics.is_empty());
    testing::assert(cst::node_kind_equal(cst::node_kind(result.root), cst::NodeKind::FILE));
    testing::assert_eq(cst::node_byte_len(result.root), source.byte_len())
}

#[test]
fn recovers_missing_semicolons_without_consuming_following_expressions() -> () {
    let source =
        \\fn main() -> () {
        \\    let first = 1
        \\    println(first)
        \\    let second = 2;
        \\    ()
        \\}
        \\fn after() -> () {}
        \\
    ;
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STMT_LET), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_CALL), 1);
    let first_end = source_offset(source, "1\n") + 1;
    match diagnostic_containing(result.diagnostics, "expect \";\"") {
        Some(diagnostic) => {
            testing::assert_eq(diagnostic.start, first_end);
            testing::assert_eq(diagnostic.end, first_end)
        },
        None => testing::fail("expected missing semicolon diagnostic"),
    }
}

#[test]
fn recovers_missing_closing_delimiters_at_outer_boundaries() -> () {
    let params = parse(
        \\fn first(value: i32 -> () { () }
        \\fn after() -> () { () }
        ,
    );
    testing::assert_eq(params.diagnostics.len(), 1);
    testing::assert_eq(count_nodes(params.root, cst::NodeKind::FN), 2);
    testing::assert(diagnostic_containing(params.diagnostics, "expect \")\"").is_some());
    let array = parse("fn main() -> () { let values = [1, 2; println(\"ok\"); let _ = values; }");
    testing::assert_eq(count_nodes(array.root, cst::NodeKind::STMT_LET), 2);
    testing::assert_eq(count_nodes(array.root, cst::NodeKind::EXPR_CALL), 1);
    testing::assert(diagnostic_containing(array.diagnostics, "expect \"]\"").is_some());
    let call = parse("fn main() -> () { println(1; let value = 2; let _ = value; }");
    testing::assert_eq(call.diagnostics.len(), 1);
    testing::assert_eq(count_nodes(call.root, cst::NodeKind::EXPR_CALL), 1);
    testing::assert_eq(count_nodes(call.root, cst::NodeKind::STMT_LET), 2);
    testing::assert(diagnostic_containing(call.diagnostics, "expect \")\"").is_some());
    let block = parse(
        \\fn first() -> () { ()
        \\fn after() -> () { () }
        ,
    );
    testing::assert_eq(count_nodes(block.root, cst::NodeKind::FN), 2);
    testing::assert(diagnostic_containing(block.diagnostics, "expect \"}\"").is_some())
}

#[test]
fn reports_unterminated_literals_and_continues_parsing() -> () {
    let source =
        \\fn main() -> () {
        \\    let text = "unterminated
        \\    let letter = 'x;
        \\    println("ok");
        \\}
        \\
    ;
    let result = parse(source);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STMT_LET), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_CALL), 1);
    let string_end = source_offset(source, "\n    let letter");
    match diagnostic_containing(result.diagnostics, "unterminated string literal") {
        Some(diagnostic) => {
            testing::assert_eq(diagnostic.start, string_end);
            testing::assert_eq(diagnostic.end, string_end)
        },
        None => testing::fail("expected unterminated string diagnostic"),
    }
    let character_end = source_offset(source, "'x;") + 2;
    match diagnostic_containing(result.diagnostics, "unterminated character literal") {
        Some(diagnostic) => {
            testing::assert_eq(diagnostic.start, character_end);
            testing::assert_eq(diagnostic.end, character_end)
        },
        None => testing::fail("expected unterminated character diagnostic"),
    }
}

#[test]
fn recovers_missing_closure_pipe_and_array_type_separator() -> () {
    let closure = parse("fn main() -> isize { let add = |value value + 1; add(1) }");
    testing::assert_eq(count_nodes(closure.root, cst::NodeKind::EXPR_CLOSURE), 1);
    testing::assert_eq(count_nodes(closure.root, cst::NodeKind::EXPR_BINARY), 1);
    testing::assert_eq(count_nodes(closure.root, cst::NodeKind::EXPR_CALL), 1);
    testing::assert(diagnostic_containing(closure.diagnostics, "expect \"|\"").is_some());
    let array = parse("fn consume(value: [isize 3]) -> () { () }");
    testing::assert_eq(count_nodes(array.root, cst::NodeKind::FN), 1);
    testing::assert(diagnostic_containing(array.diagnostics, "expect \";\"").is_some())
}

#[test]
fn places_missing_tokens_at_the_exact_end_of_input() -> () {
    let source = "fn main(";
    let result = parse(source);
    match diagnostic_containing(result.diagnostics, "expect \")\"") {
        Some(diagnostic) => {
            testing::assert_eq(diagnostic.start, source.byte_len());
            testing::assert_eq(diagnostic.end, source.byte_len())
        },
        None => testing::fail("expected missing closing parenthesis diagnostic"),
    }
}

#[test]
fn parses_control_flow_patterns_and_types() -> () {
    let source = "fn map[T: Eq](value: T, f: (T) -> T) -> T where T: Hash { match value { item if true => f(item), _ => value } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::GENERIC_LIST), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::WHERE_CLAUSE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_FUNC), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::MATCH_ARM), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::MATCH_ARM_GUARD), 1)
}

#[test]
fn parses_type_aliases_constants_and_byte_patterns() -> () {
    let source = "pub type Pair[T] = (T, T); pub const MARKER: byte = b'\\x41'; fn classify(value: byte) -> bool { match value { MARKER => true, b'B' => false, _ => false } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::TYPE_ALIAS), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::CONST), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BYTE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::PATTERN_CONSTR), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::PATTERN_BYTE), 1)
}

#[test]
fn parses_newtype_structs_and_rejects_multiple_fields() -> () {
    let source = "struct UserId(i32); pub struct Name[T](pub T,);";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STRUCT), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::NEWTYPE_FIELD), 2);
    let invalid = parse("struct Pair(i32, i32);");
    testing::assert(
        diagnostic_containing(invalid.diagnostics, "newtype structs require exactly one field").is_some(),
    )
}

#[test]
fn parses_practical_expression_syntax() -> () {
    let source = "fn main() -> () { let a = Vec::from_array([1, 2]); let b = HashMap::from_array([(\"x\", 1)]); let c: Vec[isize] = Vec::new(); let d = Vec::[isize]::new(); let p = Point { x: 3, ..base, }; a[0] += 2; let text = f\"value={a.get(0)} {{ok}}\"; }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_ARRAY_LITERAL), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_TUPLE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STRUCT_LITERAL_UPDATE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_INTERPOLATED_STRING), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::INTERPOLATED_STRING_EXPR), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STMT_ASSIGN), 1);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn parses_lexical_task_scope_contextual_forms() -> () {
    let source = "fn main() -> () { let task = scope { spawn |cancel| cancel.is_cancelled() }; let scope = 1; let spawn = |value: isize| value; println(spawn(scope)); let _ = task; }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_SCOPE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_SPAWN), 1);
    let builder = text::StringBuilder::new();
    append_source(result.root, builder);
    testing::assert_eq(builder.finish(), source)
}

#[test]
fn parses_comptime_contextually_without_reserving_the_identifier() -> () {
    let source = "struct Value { comptime: isize } fn comptime() -> isize { 1 } fn main() -> isize { let value = Value { comptime: 2 }; let folded = comptime { comptime() + value.comptime }; let comptime = 0; match comptime { 0 => folded, _ => 0 } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_COMPTIME), 1)
}

#[test]
fn parses_comptime_as_a_control_flow_operand() -> () {
    let source = "fn main() -> isize { match comptime { 1 } { 1 => 2, _ => 3 } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_COMPTIME), 1)
}

#[test]
fn parses_raw_strings_let_else_and_value_loops() -> () {
    let source = "enum Choice { Value(isize), Empty } fn choose(value: Choice) -> isize { let Value(item) = value else { return -1; }; loop { break item; } } fn raw() -> string { r#\"quoted \"text\"\"# }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_RAW_STR), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_LOOP), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BREAK), 1)
}

#[test]
fn parses_block_expressions_and_byte_strings() -> () {
    let source = "fn value() -> isize { return { let base = 40; base + 2 }; } fn main() -> () { let bytes: Vec[byte] = b\"A\\n\\x42\"; let raw = br#\"raw \\\\ bytes\"#; let nested = consume({ let item = value(); item }); if ({ true }) { let _ = nested; } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BLOCK), 3);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BYTE_STRING), 2)
}

#[test]
fn keeps_control_flow_body_braces_out_of_header_expressions() -> () {
    let source = "fn main() -> () { while break { () } if return { () } for _ in return { () } match return { _ => () } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_BLOCK), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_WHILE), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_IF), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_FOR), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_MATCH), 1)
}

#[test]
fn postfix_expressions_bind_tighter_than_prefix_operators() -> () {
    let source = "fn main() -> bool { let values = Vec::from_array([false]); !values[0] }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(has_prefix_with_direct_child(result.root, cst::NodeKind::EXPR_INDEX))
}

#[test]
fn recovers_non_function_extern_declarations() -> () {
    let source =
        \\extern bogus;
        \\fn main() -> () { () }
    ;
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 1);
    testing::assert_eq(result.diagnostics.get(0).message, "expected `fn` or `type` after `extern`");
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 1)
}

#[test]
fn parses_select_arms_and_keeps_contextual_names_available() -> () {
    let source = "fn select(value: isize) -> isize { value } fn main(ch: Channel[isize]) -> isize { select { recv(ch) as value => value.unwrap_or(0), send(ch, select(1)) => 2, default => 3, } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_SELECT), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::SELECT_RECV_ARM), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::SELECT_SEND_ARM), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::SELECT_DEFAULT_ARM), 1)
}

#[test]
fn accepts_select_as_a_semicolon_free_control_statement() -> () {
    let source = "fn main(ch: Channel[isize]) -> () { select { recv(ch) as _ => (), } let value = 1; let _ = value; }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_SELECT), 1)
}

#[test]
fn parses_select_guards_receive_matches_and_priority() -> () {
    let source = "fn main(ch: Channel[isize]) -> isize { select priority { recv(ch) when true match { Some(value) => value, None => 0, }, send(ch, 1) when false => 2, default => 3, } }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXPR_SELECT), 1);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::SELECT_ARM_GUARD), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::MATCH_ARM), 2)
}

#[test]
fn diagnoses_invalid_select_arm_lists_recoverably() -> () {
    let missing_communication = parse("fn main() -> () { select { default => (), } }");
    testing::assert(
        diagnostic_containing(
            missing_communication.diagnostics,
            "select requires at least one recv or send arm",
        ).is_some(),
    );
    let misplaced_default = parse(
        "fn main(ch: Channel[isize]) -> () { select { default => (), recv(ch) as _ => (), } }",
    );
    testing::assert(
        diagnostic_containing(misplaced_default.diagnostics, "default must be the last select arm").is_some(),
    );
    let unknown_arm = parse("fn main() -> () { select { wait(ch) => (), } }");
    testing::assert(
        diagnostic_containing(
            unknown_arm.diagnostics,
            "expected `recv`, `send`, or `default` select arm",
        ).is_some(),
    );
    let missing_priority_default = parse(
        "fn main(ch: Channel[isize]) -> () { select priority { recv(ch) as _ => (), } }",
    );
    testing::assert(
        diagnostic_containing(
            missing_priority_default.diagnostics,
            "priority select requires a final default arm",
        ).is_some(),
    )
}

#[test]
fn parses_external_type_declarations_and_generic_parameters() -> () {
    let source = "#[go_type(\"time\", \"Duration\")] pub extern type Duration; #[go_type(\"host\", \"Box\")] extern type Box[T]; fn after() -> () {}";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::EXTERN_TYPE), 2);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 1);
}

#[test]
fn recovers_invalid_external_type_bodies_and_missing_names() -> () {
    for source in Vec::from_array(
        [
            "extern type Value = i64; fn after() -> () {}",
            "extern type Value { field: i64 } fn after() -> () {}",
            "extern type; fn after() -> () {}",
            "extern type value; fn after() -> () {}",
        ],
    ) {
        let result = parse(source);
        testing::assert(!result.diagnostics.is_empty());
        testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 1)
    }
}
