package parser;

use module::cst;
use std::testing;

#[test]
fn external_struct_literals_accept_exported_go_field_names() -> () {
    let source = "fn make() -> Point { Point { X: 3, Y: 4 } } fn read(value: Point) -> i64 { value.X }";
    let result = parse(source);
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert_eq(count_nodes(result.root, cst::NodeKind::STRUCT_LITERAL_FIELD), 2);
}
