package parser;

use module::cst;
use std::testing;
use std::text;

#[test]
fn empty_generic_argument_lists_report_errors_and_preserve_following_items() -> () {
    for expression in Vec::from_array(
        ["identity::[](1)", "Value::[]::Item(1)", "Value::Item::[](1)", "value.method::[]()"],
    ) {
        let source = "fn main() -> () { let _ = " + expression + "; } fn next() -> () {}";
        let result = parse(source);
        testing::assert(
            diagnostic_containing(result.diagnostics, "generic argument list cannot be empty").is_some(),
        );
        testing::assert_eq(count_nodes(result.root, cst::NodeKind::FN), 2);
        let builder = text::StringBuilder::new();
        append_source(result.root, builder);
        testing::assert_eq(builder.finish(), source);
    }
}
