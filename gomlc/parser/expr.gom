package parser;

use module::cst;
use module::lexer;

fn is_expr_first(kind: lexer::TokenKind) -> bool {
    match kind {
        IntLit | Float | Str | RawStr | MultilineStr | FStringStart | CharLit | ByteCharLit | ByteStr | RawByteStr | Ident | Label | TrueKeyword | FalseKeyword | Minus | Bang | Tilde | LParen | LBrace | LBracket | IfKeyword | MatchKeyword | WhileKeyword | LoopKeyword | ForKeyword | BreakKeyword | ContinueKeyword | ReturnKeyword | Pipe | OrOr | GoKeyword => true,
        _ => false,
    }
}

fn is_expr_first_here(parser: Parser) -> bool {
    is_expr_first(parser.peek())
        && (!parser.at(lexer::TokenKind::LBrace) || parser.struct_literals_allowed.get())
}

fn is_expr_recovery(kind: lexer::TokenKind) -> bool {
    match kind {
        RParen | RBrace | RBracket | Semi | Comma | FatArrow | ElseKeyword | Eof => true,
        _ => false,
    }
}

fn expect_expr_with_message(parser: Parser, message: string) -> bool {
    if !marker_is_none(expr(parser)) {
        true
    } else {
        if is_expr_recovery(parser.peek()) {
            parser.error(message)
        } else if !parser.eof() {
            parser.advance_with_error(message)
        }
        false
    }
}

fn expect_expr_bp_with_message(parser: Parser, min_bp: isize, message: string) -> bool {
    if !marker_is_none(expr_bp(parser, min_bp)) {
        true
    } else {
        if is_expr_recovery(parser.peek()) {
            parser.error(message)
        } else if !parser.eof() {
            parser.advance_with_error(message)
        }
        false
    }
}

fn simple_expression(parser: Parser, kind: cst::NodeKind) -> MarkerClosed {
    let marker = parser.open();
    parser.advance();
    parser.close(marker, kind)
}

fn block_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    block(parser);
    parser.close(marker, cst::NodeKind::EXPR_BLOCK)
}

fn interpolated_string(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::FStringStart);
    while !parser.eof() && !parser.at(lexer::TokenKind::FStringEnd) {
        if parser.eat(lexer::TokenKind::FStringText) {} else if parser.eat(
            lexer::TokenKind::FStringExprStart,
        ) {
            let part = parser.open();
            expect_expr_with_message(parser, "expected an expression in interpolated string");
            parser.expect(lexer::TokenKind::FStringExprEnd);
            let _ = parser.close(part, cst::NodeKind::INTERPOLATED_STRING_EXPR);
        } else {
            parser.advance_with_error("expected interpolated string text or expression")
        }
    }
    parser.expect(lexer::TokenKind::FStringEnd);
    parser.close(marker, cst::NodeKind::EXPR_INTERPOLATED_STRING)
}

fn array_literal(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBracket);
    let previous = parser.set_struct_literals_allowed(true);
    let mut parsing = !parser.at(lexer::TokenKind::RBracket) && !parser.eof();
    while parsing {
        if !expect_expr_with_message(parser, "expected an expression in array literal") {
            parsing = false;
        } else if parser.eat(lexer::TokenKind::Comma) {
            if parser.at(lexer::TokenKind::RBracket) {
                parsing = false;
            }
        } else if is_expr_first_here(parser) {
            parser.missing("expected `,` between array elements")
        } else {
            parsing = false;
        }
    }
    parser.expect(lexer::TokenKind::RBracket);
    parser.set_struct_literals_allowed(previous);
    parser.close(marker, cst::NodeKind::EXPR_ARRAY_LITERAL)
}

fn ident_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    if path_has_type_args(parser) {
        type_applied_expression_path(parser);
        if parser.eat(lexer::TokenKind::ColonColon) {
            if path_has_type_args(parser) {
                type_applied_expression_path(parser)
            } else {
                parse_path_always(parser)
            }
        }
    } else {
        parse_path_always(parser)
    }
    if parser.struct_literals_allowed.get() && looks_like_struct_literal(parser) {
        struct_literal_field_list(parser);
        parser.close(marker, cst::NodeKind::EXPR_STRUCT_LITERAL)
    } else {
        parser.close(marker, cst::NodeKind::EXPR_IDENT)
    }
}

fn type_applied_expression_path(parser: Parser) -> () {
    let marker = parser.open();
    parse_path_always(parser);
    parser.expect(lexer::TokenKind::ColonColon);
    type_param_list(parser);
    let _ = parser.close(marker, cst::NodeKind::TYPE_TAPP);
}

fn paren_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LParen);
    let previous = parser.set_struct_literals_allowed(true);
    let result = if parser.at(lexer::TokenKind::RParen) {
        parser.expect(lexer::TokenKind::RParen);
        parser.close(marker, cst::NodeKind::EXPR_UNIT)
    } else {
        expect_expr_with_message(parser, "expected an expression in paren or tuple literal");
        let mut tuple = false;
        while parser.at(lexer::TokenKind::Comma) || is_expr_first_here(parser) {
            tuple = true;
            if parser.at(lexer::TokenKind::Comma) {
                parser.expect(lexer::TokenKind::Comma);
                if is_expr_first_here(parser) {
                    expect_expr_with_message(parser, "expected an expression in tuple literal");
                }
            } else {
                parser.missing("expected `,` between tuple elements");
                expect_expr_with_message(parser, "expected an expression in tuple literal");
            }
        }
        if tuple {
            parser.expect(lexer::TokenKind::RParen);
            parser.close(marker, cst::NodeKind::EXPR_TUPLE)
        } else {
            parser.expect(lexer::TokenKind::RParen);
            parser.close(marker, cst::NodeKind::EXPR_PAREN)
        }
    };
    parser.set_struct_literals_allowed(previous);
    result
}

fn if_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::IfKeyword);
    let condition = parser.open();
    let previous = parser.set_struct_literals_allowed(false);
    if parser.eat(lexer::TokenKind::LetKeyword) {
        let _ = pattern(parser);
        parser.expect(lexer::TokenKind::Eq);
        if is_expr_first_here(parser) {
            expect_expr_with_message(parser, "expected an expression after `=` in `if let`");
        } else {
            parser.error("expected an expression after `=` in `if let`")
        };
    } else if is_expr_first_here(parser) {
        expect_expr_with_message(parser, "expected an expression after `if`");
    } else if parser.at(lexer::TokenKind::LBrace) {
        parser.error("expected an expression after `if`")
    } else {
        parser.advance_with_error("expected an expression after `if`")
    }
    parser.set_struct_literals_allowed(previous);
    let _ = parser.close(condition, cst::NodeKind::EXPR_IF_COND);
    let then_marker = parser.open();
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("`if` then branches require a block");
        if is_expr_first_here(parser) {
            let _ = expect_expr_with_message(parser, "expected a then-branch block for `if`");
        }
    }
    let _ = parser.close(then_marker, cst::NodeKind::EXPR_IF_THEN);
    if parser.at(lexer::TokenKind::ElseKeyword) {
        parser.expect(lexer::TokenKind::ElseKeyword);
        let else_marker = parser.open();
        if parser.at(lexer::TokenKind::LBrace) {
            block(parser)
        } else if parser.at(lexer::TokenKind::IfKeyword) {
            let _ = if_expression(parser);
        } else {
            parser.error("`else` branches require a block or another `if`");
            if is_expr_first_here(parser) {
                let _ = expect_expr_with_message(parser, "expected an else-branch block for `if`");
            }
        }
        let _ = parser.close(else_marker, cst::NodeKind::EXPR_IF_ELSE);
    }
    parser.close(marker, cst::NodeKind::EXPR_IF)
}

fn match_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::MatchKeyword);
    let previous = parser.set_struct_literals_allowed(false);
    if is_expr_first_here(parser) {
        expect_expr_with_message(parser, "expected a scrutinee expression for `match`");
    } else {
        parser.error("expected a scrutinee expression for `match`")
    }
    parser.set_struct_literals_allowed(previous);
    if parser.at(lexer::TokenKind::LBrace) {
        match_arm_list(parser)
    } else {
        parser.error("`match` requires a brace-delimited arm list")
    }
    parser.close(marker, cst::NodeKind::EXPR_MATCH)
}

fn select_arm_body(parser: Parser) -> () {
    parser.expect(lexer::TokenKind::FatArrow);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        let _ = expect_expr_with_message(parser, "expected an expression in select arm");
    }
}

fn select_arm_guard(parser: Parser) -> () {
    if parser.at_contextual("when") {
        let marker = parser.open();
        parser.expect(lexer::TokenKind::Ident);
        let previous = parser.enter_select_guard();
        expect_expr_with_message(parser, "expected an expression after select guard `when`");
        parser.leave_select_guard(previous);
        let _ = parser.close(marker, cst::NodeKind::SELECT_ARM_GUARD);
    }
}

fn select_recv_arm(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    parser.expect(lexer::TokenKind::LParen);
    expect_expr_with_message(parser, "expected a channel expression in recv arm");
    parser.expect(lexer::TokenKind::RParen);
    select_arm_guard(parser);
    if parser.eat(lexer::TokenKind::AsKeyword) {
        let binding = parser.open();
        if parser.eat(lexer::TokenKind::WildcardKeyword) {} else {
            parser.expect_lower_ident("recv binding")
        }
        let _ = parser.close(binding, cst::NodeKind::SELECT_RECV_BINDING);
        select_arm_body(parser)
    } else if parser.at(lexer::TokenKind::MatchKeyword) {
        parser.expect(lexer::TokenKind::MatchKeyword);
        match_arm_list(parser)
    } else {
        parser.error("expected `as` or `match` after recv select arm")
    }
    let _ = parser.close(marker, cst::NodeKind::SELECT_RECV_ARM);
}

fn select_send_arm(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    parser.expect(lexer::TokenKind::LParen);
    expect_expr_with_message(parser, "expected a channel expression in send arm");
    parser.expect(lexer::TokenKind::Comma);
    expect_expr_with_message(parser, "expected a value expression in send arm");
    parser.expect(lexer::TokenKind::RParen);
    select_arm_guard(parser);
    select_arm_body(parser);
    let _ = parser.close(marker, cst::NodeKind::SELECT_SEND_ARM);
}

fn select_default_arm(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    select_arm_body(parser);
    let _ = parser.close(marker, cst::NodeKind::SELECT_DEFAULT_ARM);
}

fn select_arm_list(parser: Parser, priority: bool) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    let mut communication_arms = 0;
    let mut has_default = false;
    while !parser.eof() && !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
        if has_default {
            parser.error("default must be the last select arm")
        }
        if parser.at_contextual("recv") {
            communication_arms += 1;
            select_recv_arm(parser)
        } else if parser.at_contextual("send") {
            communication_arms += 1;
            select_send_arm(parser)
        } else if parser.at_contextual("default") {
            has_default = true;
            select_default_arm(parser)
        } else {
            parser.advance_with_error("expected `recv`, `send`, or `default` select arm")
        }
        if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
            || is_list_boundary(parser.peek()) {} else {
            parser.error("expected `,` between select arms")
        }
    }
    if communication_arms == 0 {
        parser.error("select requires at least one recv or send arm")
    }
    if priority && !has_default {
        parser.error("priority select requires a final default arm")
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::SELECT_ARM_LIST);
}

fn select_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    let priority = if parser.at_contextual("priority") {
        parser.expect(lexer::TokenKind::Ident);
        true
    } else {
        false
    };
    select_arm_list(parser, priority);
    parser.close(marker, cst::NodeKind::EXPR_SELECT)
}

fn while_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    while_expression_with_marker(parser, marker)
}

fn while_expression_with_marker(parser: Parser, marker: MarkerOpened) -> MarkerClosed {
    parser.expect(lexer::TokenKind::WhileKeyword);
    let condition = parser.open();
    let previous = parser.set_struct_literals_allowed(false);
    if parser.eat(lexer::TokenKind::LetKeyword) {
        let _ = pattern(parser);
        parser.expect(lexer::TokenKind::Eq);
        if is_expr_first_here(parser) {
            expect_expr_with_message(parser, "expected an expression after `=` in `while let`");
        } else {
            parser.error("expected an expression after `=` in `while let`")
        };
    } else if is_expr_first_here(parser) {
        expect_expr_with_message(parser, "expected an expression after `while`");
    } else if parser.at(lexer::TokenKind::LBrace) {
        parser.error("expected an expression after `while`")
    } else {
        parser.advance_with_error("expected an expression after `while`")
    }
    parser.set_struct_literals_allowed(previous);
    let _ = parser.close(condition, cst::NodeKind::EXPR_WHILE_COND);
    let body = parser.open();
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("`while` bodies require a block");
        if is_expr_first_here(parser) {
            let _ = expect_expr_with_message(parser, "expected a body block for `while`");
        }
    }
    let _ = parser.close(body, cst::NodeKind::EXPR_WHILE_BODY);
    parser.close(marker, cst::NodeKind::EXPR_WHILE)
}

fn for_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    for_expression_with_marker(parser, marker)
}

fn for_expression_with_marker(parser: Parser, marker: MarkerOpened) -> MarkerClosed {
    parser.expect(lexer::TokenKind::ForKeyword);
    let _ = pattern(parser);
    if !parser.eat(lexer::TokenKind::InKeyword) {
        parser.error("expected `in` after `for` pattern")
    }
    let previous = parser.set_struct_literals_allowed(false);
    if is_expr_first_here(parser) {
        expect_expr_with_message(parser, "expected an iterator expression after `in`");
    } else {
        parser.error("expected an iterator expression after `in`")
    }
    parser.set_struct_literals_allowed(previous);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("expected a block for `for` loop body");
        if is_expr_first_here(parser) {
            let _ = expr(parser);
        }
    }
    parser.close(marker, cst::NodeKind::EXPR_FOR)
}

fn loop_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    loop_expression_with_marker(parser, marker)
}

fn loop_expression_with_marker(parser: Parser, marker: MarkerOpened) -> MarkerClosed {
    parser.expect(lexer::TokenKind::LoopKeyword);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("`loop` requires a block body")
    }
    parser.close(marker, cst::NodeKind::EXPR_LOOP)
}

fn return_stops_expression(parser: Parser, kind: lexer::TokenKind) -> bool {
    match kind {
        Semi | Comma | RParen | RBracket | RBrace | Eof => true,
        LBrace => !parser.struct_literals_allowed.get(),
        _ => false,
    }
}

fn return_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::ReturnKeyword);
    if !return_stops_expression(parser, parser.peek())
        && !expect_expr_with_message(parser, "expected an expression after `return`") {
        while !parser.eof() && !return_stops_expression(parser, parser.peek()) {
            parser.advance()
        }
    }
    parser.close(marker, cst::NodeKind::EXPR_RETURN)
}

fn break_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::BreakKeyword);
    if parser.at(lexer::TokenKind::Label) {
        parser.advance()
    }
    if !return_stops_expression(parser, parser.peek())
        && !expect_expr_with_message(parser, "expected an expression after `break`") {
        while !parser.eof() && !return_stops_expression(parser, parser.peek()) {
            parser.advance()
        }
    }
    parser.close(marker, cst::NodeKind::EXPR_BREAK)
}

fn continue_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::ContinueKeyword);
    if parser.at(lexer::TokenKind::Label) {
        parser.advance()
    }
    parser.close(marker, cst::NodeKind::EXPR_CONTINUE)
}

fn labeled_loop_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Label);
    parser.expect(lexer::TokenKind::Colon);
    match parser.peek() {
        WhileKeyword => while_expression_with_marker(parser, marker),
        ForKeyword => for_expression_with_marker(parser, marker),
        LoopKeyword => loop_expression_with_marker(parser, marker),
        _ => {
            parser.error("loop label must precede `while`, `for`, or `loop`");
            if !parser.eof() {
                parser.advance()
            }
            parser.close(marker, cst::NodeKind::ErrorTree)
        },
    }
}

fn go_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::GoKeyword);
    if !expect_expr_with_message(parser, "expected an expression after `go`") {
        while !parser.eof() && !parser.at(lexer::TokenKind::Semi)
            && !parser.at(lexer::TokenKind::RBrace) {
            parser.advance()
        }
    }
    parser.close(marker, cst::NodeKind::EXPR_GO)
}

fn scope_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("`scope` requires a block body")
    }
    parser.close(marker, cst::NodeKind::EXPR_SCOPE)
}

fn comptime_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        parser.error("`comptime` requires a block body")
    }
    parser.close(marker, cst::NodeKind::EXPR_COMPTIME)
}

fn contextual_block_is_followed_by_block(parser: Parser) -> bool {
    let mut depth = 0;
    let mut index = 1;
    while index < 4096 {
        let token = parser.nth(index);
        if token_is(token, lexer::TokenKind::Eof) {
            return false;
        } else if token_is(token, lexer::TokenKind::LBrace) {
            depth += 1;
        } else if token_is(token, lexer::TokenKind::RBrace) {
            depth -= 1;
            if depth == 0 {
                return token_is(parser.nth(index + 1), lexer::TokenKind::LBrace);
            }
        }
        index += 1;
    }
    false
}

fn looks_like_comptime_expression(parser: Parser) -> bool {
    parser.contextual_blocks_allowed.get() && parser.at_contextual("comptime")
        && token_is(parser.nth(1), lexer::TokenKind::LBrace)
        && (parser.struct_literals_allowed.get() || contextual_block_is_followed_by_block(parser))
}

fn spawn_expression(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    if parser.at(lexer::TokenKind::Pipe) || parser.at(lexer::TokenKind::OrOr) {
        let _ = closure_expr(parser);
    } else {
        parser.error("`spawn` requires a closure")
    }
    parser.close(marker, cst::NodeKind::EXPR_SPAWN)
}

fn atom(parser: Parser) -> Option[MarkerClosed] {
    let result = match parser.peek() {
        IntLit => simple_expression(parser, cst::NodeKind::EXPR_INT),
        Float => simple_expression(parser, cst::NodeKind::EXPR_FLOAT),
        LBracket => array_literal(parser),
        Str => simple_expression(parser, cst::NodeKind::EXPR_STR),
        RawStr => simple_expression(parser, cst::NodeKind::EXPR_RAW_STR),
        MultilineStr => simple_expression(parser, cst::NodeKind::EXPR_MULTILINE_STR),
        FStringStart => interpolated_string(parser),
        CharLit => simple_expression(parser, cst::NodeKind::EXPR_CHAR),
        ByteCharLit => simple_expression(parser, cst::NodeKind::EXPR_BYTE),
        ByteStr | RawByteStr => simple_expression(parser, cst::NodeKind::EXPR_BYTE_STRING),
        TrueKeyword | FalseKeyword => simple_expression(parser, cst::NodeKind::EXPR_BOOL),
        Ident => if parser.at_contextual("select")
            && (token_is(parser.nth(1), lexer::TokenKind::LBrace)
                || (parser.nth_text(1) == "priority"
                    && token_is(parser.nth(2), lexer::TokenKind::LBrace))) {
            select_expression(parser)
        } else if parser.at_contextual("scope") && token_is(parser.nth(1), lexer::TokenKind::LBrace) {
            scope_expression(parser)
        } else if looks_like_comptime_expression(parser) {
            comptime_expression(parser)
        } else if parser.at_contextual("spawn")
            && (token_is(parser.nth(1), lexer::TokenKind::Pipe)
                || token_is(parser.nth(1), lexer::TokenKind::OrOr)) {
            spawn_expression(parser)
        } else {
            ident_expression(parser)
        },
        LParen => paren_expression(parser),
        LBrace => if parser.struct_literals_allowed.get() {
            block_expression(parser)
        } else {
            return Option::None
        },
        IfKeyword => if_expression(parser),
        MatchKeyword => match_expression(parser),
        WhileKeyword => while_expression(parser),
        LoopKeyword => loop_expression(parser),
        ForKeyword => for_expression(parser),
        Label => if token_is(parser.nth(1), lexer::TokenKind::Colon) {
            labeled_loop_expression(parser)
        } else {
            let marker = parser.open();
            if token_is(parser.nth(1), lexer::TokenKind::WhileKeyword)
                || token_is(parser.nth(1), lexer::TokenKind::ForKeyword)
                || token_is(parser.nth(1), lexer::TokenKind::LoopKeyword) {
                parser.advance_with_error("expected `:` after loop label")
            } else {
                parser.error_after_current("unterminated character literal");
                parser.advance()
            }
            parser.close(marker, cst::NodeKind::ErrorTree)
        },
        BreakKeyword => break_expression(parser),
        ContinueKeyword => continue_expression(parser),
        ReturnKeyword => return_expression(parser),
        GoKeyword => go_expression(parser),
        Pipe | OrOr => closure_expr(parser),
        _ => return Option::None,
    };
    Option::Some(result)
}

fn path_has_type_args(parser: Parser) -> bool {
    let mut index = 1;
    while token_is(parser.nth(index), lexer::TokenKind::ColonColon)
        && token_is(parser.nth(index + 1), lexer::TokenKind::Ident) {
        index += 2;
    }
    token_is(parser.nth(index), lexer::TokenKind::ColonColon)
        && token_is(parser.nth(index + 1), lexer::TokenKind::LBracket)
}

fn closure_expr(parser: Parser) -> MarkerClosed {
    let marker = parser.open();
    closure_param_list(parser);
    closure_body(parser);
    parser.close(marker, cst::NodeKind::EXPR_CLOSURE)
}

fn closure_param_list(parser: Parser) -> () {
    let marker = parser.open();
    if parser.at(lexer::TokenKind::OrOr) {
        parser.expect(lexer::TokenKind::OrOr);
        let _ = parser.close(marker, cst::NodeKind::CLOSURE_PARAM_LIST);
    } else {
        parser.expect(lexer::TokenKind::Pipe);
        while !parser.at(lexer::TokenKind::Pipe) && !parser.eof()
            && !is_list_boundary(parser.peek()) {
            closure_param(parser);
            if parser.at(lexer::TokenKind::Comma) {
                parser.expect(lexer::TokenKind::Comma)
            } else if parser.at(lexer::TokenKind::Pipe) {
                break
            } else if (parser.at_lower_ident()
                && (token_is(parser.nth(1), lexer::TokenKind::Colon)
                    || token_is(parser.nth(1), lexer::TokenKind::Comma)
                    || token_is(parser.nth(1), lexer::TokenKind::Pipe)))
                || (parser.at(lexer::TokenKind::WildcardKeyword)
                    && (token_is(parser.nth(1), lexer::TokenKind::Comma)
                        || token_is(parser.nth(1), lexer::TokenKind::Pipe))) {
                parser.missing("expected `,` between closure parameters")
            } else if is_expr_first_here(parser) {
                break
            } else {
                parser.advance_with_error("expected `,` or `|` after closure parameter")
            }
        }
        parser.expect(lexer::TokenKind::Pipe);
        let _ = parser.close(marker, cst::NodeKind::CLOSURE_PARAM_LIST);
    }
}

fn closure_param(parser: Parser) -> () {
    let marker = parser.open();
    let valid = if parser.at_lower_ident() {
        parser.expect_lower_ident("closure parameter name");
        true
    } else if parser.at(lexer::TokenKind::WildcardKeyword) {
        parser.expect(lexer::TokenKind::WildcardKeyword);
        true
    } else {
        if !parser.at(lexer::TokenKind::Pipe) && !parser.eof() {
            parser.advance_with_error("expected an identifier in closure parameter")
        }
        false
    };
    if valid && parser.at(lexer::TokenKind::Colon) {
        parser.expect(lexer::TokenKind::Colon);
        type_expr(parser)
    }
    let _ = parser.close(marker, cst::NodeKind::CLOSURE_PARAM);
}

fn closure_body(parser: Parser) -> () {
    let marker = parser.open();
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else if parser.at(lexer::TokenKind::Arrow) {
        let recovery = parser.open();
        parser.error("expected a closure body");
        parser.advance();
        if is_type_first(parser.peek()) {
            type_expr(parser)
        }
        if parser.at(lexer::TokenKind::LBrace) {
            block(parser)
        }
        let _ = parser.close(recovery, cst::NodeKind::ErrorTree);
    } else if is_expr_first(parser.peek()) {
        expect_expr_with_message(parser, "expected a closure body");
    } else {
        parser.advance_with_error("expected a closure body")
    }
    let _ = parser.close(marker, cst::NodeKind::EXPR_CLOSURE_BODY);
}

fn match_arm_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    while !parser.eof() && !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
        match_arm(parser);
        if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
            || is_list_boundary(parser.peek()) {} else {
            parser.error("expected `,` between match arms")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    let _ = parser.close(marker, cst::NodeKind::MATCH_ARM_LIST);
}

fn match_arm(parser: Parser) -> () {
    let marker = parser.open();
    let _ = pattern(parser);
    if parser.at(lexer::TokenKind::IfKeyword) {
        let guard = parser.open();
        parser.expect(lexer::TokenKind::IfKeyword);
        expect_expr_with_message(parser, "expected an expression after match guard `if`");
        let _ = parser.close(guard, cst::NodeKind::MATCH_ARM_GUARD);
    }
    parser.expect(lexer::TokenKind::FatArrow);
    if parser.at(lexer::TokenKind::LBrace) {
        block(parser)
    } else {
        expect_expr_with_message(parser, "expected an expression in match arm");
    }
    let _ = parser.close(marker, cst::NodeKind::MATCH_ARM);
}

fn struct_literal_field_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LBrace);
    let previous = parser.set_struct_literals_allowed(true);
    while !parser.eof() && !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
        if parser.at(lexer::TokenKind::DotDot) {
            let update = parser.open();
            parser.expect(lexer::TokenKind::DotDot);
            expect_expr_with_message(parser, "expected a base expression after `..`");
            let _ = parser.close(update, cst::NodeKind::STRUCT_LITERAL_UPDATE);
            parser.eat(lexer::TokenKind::Comma);
            if !parser.at(lexer::TokenKind::RBrace) && !is_list_boundary(parser.peek()) {
                parser.error("struct update must be the last item in a struct literal")
            }
            break
        } else if parser.at(lexer::TokenKind::Ident) {
            struct_literal_field(parser);
            if parser.eat(lexer::TokenKind::Comma) {} else if parser.at(lexer::TokenKind::RBrace)
                || is_list_boundary(parser.peek()) {} else {
                parser.error("expected `,` between struct literal fields")
            }
        } else {
            parser.advance_with_error("expected a struct field")
        }
    }
    parser.expect(lexer::TokenKind::RBrace);
    parser.set_struct_literals_allowed(previous);
    let _ = parser.close(marker, cst::NodeKind::STRUCT_LITERAL_FIELD_LIST);
}

fn struct_literal_field(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::Ident);
    if parser.eat(lexer::TokenKind::Colon) {
        if is_expr_first(parser.peek()) {
            expect_expr_with_message(parser, "expected an expression");
        } else {
            parser.advance_with_error("expected an expression")
        }
    } else if is_expr_first_here(parser) {
        parser.missing("expected `:` after struct literal field name");
        expect_expr_with_message(parser, "expected an expression");
    }
    let _ = parser.close(marker, cst::NodeKind::STRUCT_LITERAL_FIELD);
}

fn looks_like_struct_literal(parser: Parser) -> bool {
    if !parser.at(lexer::TokenKind::LBrace) {
        false
    } else {
        match parser.nth(1) {
            RBrace => true,
            DotDot => true,
            Ident => match parser.nth(2) {
                Colon | Comma => true,
                RBrace => {
                    let following = parser.nth(3);
                    !token_is(following, lexer::TokenKind::ElseKeyword)
                        && !token_is(following, lexer::TokenKind::LBrace)
                },
                _ => false,
            },
            _ => false,
        }
    }
}

fn postfix_binding_power(kind: lexer::TokenKind) -> Option[isize] {
    match kind {
        LParen | LBracket => Option::Some(25),
        Question => Option::Some(26),
        _ => Option::None,
    }
}

fn prefix_binding_power(kind: lexer::TokenKind) -> Option[isize] {
    match kind {
        Minus | Bang | Tilde => Option::Some(23),
        _ => Option::None,
    }
}

fn infix_binding_power(kind: lexer::TokenKind) -> Option[(isize, isize)] {
    match kind {
        OrOr => Option::Some((1, 2)),
        AndAnd => Option::Some((3, 4)),
        EqEq | NotEq | Less | Greater | LessEq | GreaterEq => Option::Some((5, 6)),
        Pipe => Option::Some((7, 8)),
        Caret => Option::Some((8, 9)),
        Amp => Option::Some((9, 10)),
        LessLess | GreaterGreater => Option::Some((12, 13)),
        Plus | Minus => Option::Some((13, 14)),
        Star | Slash | Percent => Option::Some((15, 16)),
        Dot => Option::Some((27, 28)),
        _ => Option::None,
    }
}

fn is_comparison(kind: lexer::TokenKind) -> bool {
    match kind {
        EqEq | NotEq | Less | Greater | LessEq | GreaterEq => true,
        _ => false,
    }
}

fn expr(parser: Parser) -> Option[MarkerClosed] {
    expr_bp(parser, 0)
}

fn expr_bp(parser: Parser, min_bp: isize) -> Option[MarkerClosed] {
    if !parser.enter_expr() {
        Option::None
    } else {
        let initial = match prefix_binding_power(parser.peek()) {
            Some(right_bp) => {
                let marker = parser.open();
                parser.advance();
                expect_expr_bp_with_message(
                    parser,
                    right_bp,
                    "expected an operand for prefix operator",
                );
                Option::Some(parser.close(marker, cst::NodeKind::EXPR_PREFIX))
            },
            None => atom(parser),
        };
        match initial {
            None => {
                parser.leave_expr();
                Option::None
            },
            Some(value) => {
                let mut lhs = value;
                let mut parsed_range = false;
                let mut parsed_comparison = false;
                while !parser.eof() {
                    let operator = parser.peek();
                    if token_is(operator, lexer::TokenKind::DotDot)
                        || token_is(operator, lexer::TokenKind::DotDotEq) {
                        if min_bp > 0 {
                            break
                        } else if parsed_range {
                            parser.advance_with_error("range expressions cannot be chained");
                            expect_expr_bp_with_message(
                                parser,
                                1,
                                "expected a range endpoint after range operator",
                            );
                        } else {
                            let marker = lhs.precede(parser);
                            parser.advance();
                            expect_expr_bp_with_message(
                                parser,
                                1,
                                "expected a range endpoint after range operator",
                            );
                            lhs = marker.completed(parser, cst::NodeKind::EXPR_RANGE);
                            parsed_range = true;
                        }
                    } else if token_is(operator, lexer::TokenKind::AsKeyword)
                        && parser.at_select_guard_delimiter() {
                        break
                    } else if token_is(operator, lexer::TokenKind::AsKeyword) {
                        let left_bp = 17;
                        if left_bp < min_bp {
                            break
                        } else {
                            let marker = lhs.precede(parser);
                            parser.advance();
                            type_expr(parser);
                            lhs = marker.completed(parser, cst::NodeKind::EXPR_CAST);
                        }
                    } else {
                        match postfix_binding_power(operator) {
                            Some(left_bp) => {
                                if left_bp < min_bp {
                                    break
                                } else if parser.at(lexer::TokenKind::LParen) {
                                    let marker = lhs.precede(parser);
                                    arg_list(parser);
                                    lhs = marker.completed(parser, cst::NodeKind::EXPR_CALL);
                                } else if parser.at(lexer::TokenKind::LBracket) {
                                    let marker = lhs.precede(parser);
                                    parser.expect(lexer::TokenKind::LBracket);
                                    let previous = parser.set_struct_literals_allowed(true);
                                    if is_expr_first_here(parser) {
                                        expect_expr_with_message(
                                            parser,
                                            "expected an index expression",
                                        );
                                    } else if !parser.at(lexer::TokenKind::RBracket) {
                                        parser.advance_with_error("expected an index expression")
                                    }
                                    parser.expect(lexer::TokenKind::RBracket);
                                    parser.set_struct_literals_allowed(previous);
                                    lhs = marker.completed(parser, cst::NodeKind::EXPR_INDEX);
                                } else if parser.at(lexer::TokenKind::Question) {
                                    let marker = lhs.precede(parser);
                                    parser.advance();
                                    lhs = marker.completed(parser, cst::NodeKind::EXPR_TRY);
                                } else {
                                    parser.advance_with_error(
                                        "unexpected postfix operator "
                                            + lexer::token_kind_name(operator),
                                    )
                                }
                            },
                            None => match infix_binding_power(operator) {
                                Some((left_bp, right_bp)) => {
                                    if left_bp < min_bp {
                                        break
                                    } else if is_comparison(operator) && parsed_comparison {
                                        parser.advance_with_error(
                                            "comparison operators cannot be chained",
                                        );
                                        expect_expr_bp_with_message(
                                            parser,
                                            right_bp,
                                            "expected a right-hand side for comparison operator",
                                        );
                                    } else {
                                        let marker = lhs.precede(parser);
                                        let contextual_blocks_allowed = if token_is(
                                            operator,
                                            lexer::TokenKind::Dot,
                                        ) {
                                            parser.set_contextual_blocks_allowed(false)
                                        } else {
                                            parser.contextual_blocks_allowed.get()
                                        };
                                        parser.advance();
                                        expect_expr_bp_with_message(
                                            parser,
                                            right_bp,
                                            "expected a right-hand side for binary operator",
                                        );
                                        parser.set_contextual_blocks_allowed(
                                            contextual_blocks_allowed,
                                        );
                                        lhs = marker.completed(parser, cst::NodeKind::EXPR_BINARY);
                                        if is_comparison(operator) {
                                            parsed_comparison = true;
                                        }
                                    }
                                },
                                None => break,
                            },
                        }
                    }
                }
                let result = lhs;
                parser.leave_expr();
                Option::Some(result)
            },
        }
    }
}

fn arg_list(parser: Parser) -> () {
    let marker = parser.open();
    parser.expect(lexer::TokenKind::LParen);
    let previous = parser.set_struct_literals_allowed(true);
    while !parser.at(lexer::TokenKind::RParen) && !parser.eof() && !is_list_boundary(parser.peek()) {
        if is_expr_first_here(parser) {
            arg(parser)
        } else {
            parser.advance_with_error("expected an expression in argument list")
        }
    }
    parser.expect(lexer::TokenKind::RParen);
    parser.set_struct_literals_allowed(previous);
    let _ = parser.close(marker, cst::NodeKind::ARG_LIST);
}

fn arg(parser: Parser) -> () {
    let marker = parser.open();
    if marker_is_none(expr(parser)) {
        parser.advance_with_error("expected an expression")
    }
    if !parser.at(lexer::TokenKind::RParen) && !is_list_boundary(parser.peek()) {
        parser.expect(lexer::TokenKind::Comma)
    }
    let _ = parser.close(marker, cst::NodeKind::ARG);
}
