package bind_go;

use module::ast;
use module::ffi;
use module::go_backend;
use std::text;

pub struct TypeBinding {
    pub name: string,
    pub identity: ffi::GoTypeIdentity,
}

pub fn native_type(value: ffi::GoTypeIdentity, imports: HashMap[string, string]) -> Result[
    go_backend::Type,
    string,
] {
    native_type_inner(value, imports, 0)
}

fn native_type_inner(value: ffi::GoTypeIdentity, imports: HashMap[string, string], depth: isize) -> Result[
    go_backend::Type,
    string,
] {
    if depth > 128 {
        return Result::Err("bind-go: native type exceeds depth limit")
    }
    let lower = |value| native_type_inner(value, imports, depth + 1);
    match value {
        Basic(name) => match name {
            "bool" => Result::Ok(go_backend::Type::Bool),
            "int" => Result::Ok(go_backend::Type::Int),
            "int8" => Result::Ok(go_backend::Type::Int8),
            "int16" => Result::Ok(go_backend::Type::Int16),
            "int32" => Result::Ok(go_backend::Type::Int32),
            "int64" => Result::Ok(go_backend::Type::Int64),
            "uint" => Result::Ok(go_backend::Type::Uint),
            "uint8" => Result::Ok(go_backend::Type::Uint8),
            "uint16" => Result::Ok(go_backend::Type::Uint16),
            "uint32" => Result::Ok(go_backend::Type::Uint32),
            "uint64" => Result::Ok(go_backend::Type::Uint64),
            "float32" => Result::Ok(go_backend::Type::Float32),
            "float64" => Result::Ok(go_backend::Type::Float64),
            "string" => Result::Ok(go_backend::Type::String),
            _ => Result::Err("bind-go: unsupported native scalar " + name),
        },
        Named { import_path, name, arguments } => {
            if !ffi::named_bridge_identity_valid(import_path, name) {
                return Result::Err("bind-go: unnameable Go type")
            }
            let base = go_backend::Type::Named {
                name: if import_path == "" {
                    name
                } else {
                    let qualifier = imports[import_path].ok_or(
                        "bind-go: missing native import " + import_path,
                    )?;
                    if qualifier == "" {
                        name
                    } else {
                        qualifier + "." + name
                    }
                },
            };
            if arguments.is_empty() {
                return Result::Ok(base)
            }
            let args = Vec::new();
            for argument in arguments {
                args.push(lower(argument)?);
            }
            Result::Ok(go_backend::Type::Apply { base, args })
        },
        Pointer(element) => Result::Ok(go_backend::Type::Pointer { elem: lower(element)? }),
        Slice(element) => Result::Ok(go_backend::Type::Slice { elem: lower(element)? }),
        Array { element, length } => {
            if length < 0 {
                return Result::Err("bind-go: negative array length")
            }
            Result::Ok(go_backend::Type::Array { len: length, elem: lower(element)? })
        },
        Map { key, element } => Result::Ok(
            go_backend::Type::Map { key: lower(key)?, value: lower(element)? },
        ),
        Channel { element, direction } => Result::Ok(
            go_backend::Type::Chan {
                elem: lower(element)?,
                direction: match direction {
                    "both" => ast::ChannelDirection::Both,
                    "send" => ast::ChannelDirection::Send,
                    "receive" => ast::ChannelDirection::Receive,
                    _ => return Result::Err("bind-go: invalid channel direction"),
                },
            },
        ),
        Function { parameters, results } => {
            let params = Vec::new();
            let returns = Vec::new();
            for parameter in parameters {
                params.push(lower(parameter)?);
            }
            for result in results {
                returns.push(lower(result)?);
            }
            Result::Ok(
                go_backend::Type::Func {
                    params,
                    ret_ty: if returns.is_empty() {
                        go_backend::Type::Void
                    } else if returns.len() == 1 {
                        returns[0]
                    } else {
                        go_backend::Type::Multi { items: returns }
                    },
                },
            )
        },
        Parameter(_) => Result::Err("bind-go: unresolved native type parameter"),
    }
}

pub fn goml_type(value: ffi::GoTypeIdentity, names: Vec[TypeBinding]) -> Result[string, string] {
    goml_type_inner(value, names, 0)
}

fn goml_return_types(values: Vec[ffi::GoTypeIdentity], names: Vec[TypeBinding], depth: isize) -> Result[
    string,
    string,
] {
    if values.is_empty() {
        return Result::Ok("()")
    }
    if values.len() == 1 {
        return goml_type_inner(values[0], names, depth + 1)
    }
    let result = Vec::new();
    for value in values {
        result.push(goml_type_inner(value, names, depth + 1)?);
    }
    Result::Ok("(" + text::join(result, ", ") + ")")
}

pub fn goml_results(values: Vec[ffi::GoTypeIdentity], names: Vec[TypeBinding]) -> Result[
    string,
    string,
] {
    goml_return_types(values, names, 0)
}

fn goml_type_inner(value: ffi::GoTypeIdentity, names: Vec[TypeBinding], depth: isize) -> Result[
    string,
    string,
] {
    if depth > 128 {
        return Result::Err("bind-go: GoML type exceeds depth limit")
    }
    let lower = |value| goml_type_inner(value, names, depth + 1);
    match value {
        Basic(name) => match name {
            "bool" => Result::Ok("bool"),
            "int" => Result::Ok("isize"),
            "int8" => Result::Ok("i8"),
            "int16" => Result::Ok("i16"),
            "int32" => Result::Ok("i32"),
            "int64" => Result::Ok("i64"),
            "uint" => Result::Ok("usize"),
            "uint8" => Result::Ok("u8"),
            "uint16" => Result::Ok("u16"),
            "uint32" => Result::Ok("u32"),
            "uint64" => Result::Ok("u64"),
            "float32" => Result::Ok("f32"),
            "float64" => Result::Ok("f64"),
            "string" => Result::Ok("ffi::String"),
            _ => Result::Err("bind-go: unsupported GoML scalar " + name),
        },
        Named { import_path, name, arguments } => {
            if import_path == "" && name == "error" && arguments.is_empty() {
                return Result::Ok("ffi::Error")
            }
            let key = ffi::go_type_identity_key(value);
            let mut result: Option[string] = Option::None;
            for binding in names {
                if ffi::go_type_identity_key(binding.identity) == key {
                    if result.is_some() {
                        return Result::Err(
                            "bind-go: ambiguous type allowlist for " + import_path + "." + name,
                        )
                    }
                    result = Option::Some(binding.name);
                }
            }
            result.ok_or("bind-go: add native type to allowlist: " + import_path + "." + name)
        },
        Pointer(element) => Result::Ok("ffi::Ptr[" + lower(element)? + "]"),
        Slice(element) => Result::Ok("ffi::RawSlice[" + lower(element)? + "]"),
        Array { element, length } => {
            if length < 0 {
                return Result::Err("bind-go: negative array length")
            }
            Result::Ok("[" + lower(element)? + "; " + length.to_string() + "]")
        },
        Map { key, element } => Result::Ok(
            "ffi::RawMap[" + lower(key)? + ", " + lower(element)? + "]",
        ),
        Channel { element, direction } => {
            let owner = match direction {
                "both" => "Channel",
                "send" => "Sender",
                "receive" => "Receiver",
                _ => return Result::Err("bind-go: invalid channel direction"),
            };
            Result::Ok(owner + "[" + lower(element)? + "]")
        },
        Function { parameters, results } => {
            let params = Vec::new();
            for parameter in parameters {
                params.push(lower(parameter)?);
            }
            Result::Ok(
                "ffi::Func[(" + text::join(params, ", ") + ") -> "
                    + goml_return_types(results, names, depth + 1)?
                    + "]",
            )
        },
        Parameter(_) => Result::Err("bind-go: unresolved GoML binding type parameter"),
    }
}
