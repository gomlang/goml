package bind_go;

use module::ffi;
use module::hash;
use std::fs;
use std::io;
use std::json;
use std::path;

fn optional_output(file: string) -> Result[Option[string], string] {
    match fs::symlink_metadata(file) {
        Ok(metadata) => {
            if !metadata.file_type().is_file() || metadata.len() > 8388608 {
                return Result::Err(
                    "bind-go: output must be a regular file of at most 8 MiB: " + file,
                )
            }
            Result::Ok(
                Option::Some(fs::read_file_structured(file).map_err(|error| error.to_string())?),
            )
        },
        Err(error) => if error.kind() == io::ErrorKind::NotFound {
            Result::Ok(Option::None)
        } else {
            Result::Err(error.to_string())
        },
    }
}

fn output_files(outputs: Outputs) -> Vec[string] {
    Vec::from_array([outputs.goml, outputs.go_file, outputs.manifest])
}

fn read_outputs(outputs: Outputs) -> Result[Vec[Option[string]], string] {
    let result = Vec::new();
    for file in output_files(outputs) {
        let _ = checked_output(outputs.root, file)?;
        result.push(optional_output(file)?);
    }
    Result::Ok(result)
}

fn output_manifest(outputs: Outputs, generated: Generated) -> string {
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("generator", json::Value::String("goml-bind-go")),
                    ("protocol", json::Value::Number("1")),
                    (
                        "goml",
                        json::Value::String(
                            outputs.goml.byte_slice(
                                outputs.root.byte_len() + 1,
                                outputs.goml.byte_len(),
                            ),
                        ),
                    ),
                    (
                        "go",
                        json::Value::String(
                            outputs.go_file.byte_slice(
                                outputs.root.byte_len() + 1,
                                outputs.go_file.byte_len(),
                            ),
                        ),
                    ),
                    ("goml_sha256", json::Value::String(hash::sha256_hex(generated.goml_source))),
                    ("go_sha256", json::Value::String(hash::sha256_hex(generated.go_source))),
                ],
            ),
        ),
    )
        + "\n"
}

fn check_previous(outputs: Outputs, previous: Vec[Option[string]]) -> Result[(), string] {
    match (previous[0], previous[1], previous[2]) {
        (None, None, None) => Result::Ok(()),
        (Some(goml_source), Some(go_source), Some(manifest)) => {
            let _ = ffi::parse_bounded_json(manifest)?;
            if manifest != output_manifest(outputs, Generated { goml_source, go_source }) {
                return Result::Err(
                    "bind-go: generated files or ownership manifest were modified; refusing to overwrite",
                )
            }
            Result::Ok(())
        },
        _ => Result::Err(
            "bind-go: existing outputs lack a complete ownership manifest; refusing to overwrite",
        ),
    }
}

fn same_outputs(left: Vec[Option[string]], right: Vec[Option[string]]) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if left[index] != right[index] {
            return false
        }
    }
    true
}

fn restore_outputs(files: Vec[string], previous: Vec[Option[string]], count: isize, staging: string) -> Result[
    (),
    string,
] {
    let mut index = count;
    while index > 0 {
        index -= 1;
        match previous[index] {
            Some(source) => {
                let restore = path::join(staging, "restore_" + index.to_string());
                fs::write_file_structured(restore, source).map_err(|error| error.to_string())?;
                fs::rename(restore, files[index]).map_err(|error| error.to_string())?;
            },
            None => {
                fs::remove_file(files[index]).map_err(|error| error.to_string())?;
            },
        }
    }
    Result::Ok(())
}

fn commit_outputs(
    files: Vec[string],
    previous: Vec[Option[string]],
    staging: string,
    preserve: Ref[bool],
) -> Result[(), string] {
    for index in 0..files.len() {
        if let Err(error) = fs::rename(
            path::join(staging, "new_" + index.to_string()),
            files[index],
        ) {
            if let Err(rollback) = restore_outputs(files, previous, index, staging) {
                preserve.set(true);
                return Result::Err(
                    "bind-go: publication failed: " + error.to_string() + "; rollback failed: "
                        + rollback
                        + "; recovery files retained at "
                        + staging,
                )
            }
            return Result::Err("bind-go: publication failed: " + error.to_string())
        }
    }
    Result::Ok(())
}

fn publish_locked(
    outputs: Outputs,
    staging: string,
    preserve: Ref[bool],
    produce: () -> Result[Generated, string],
) -> Result[(), string] {
    let previous = read_outputs(outputs)?;
    check_previous(outputs, previous)?;
    let generated = produce()?;
    if generated.goml_source.byte_len() > 8388608 || generated.go_source.byte_len() > 8388608 {
        return Result::Err("bind-go: generated source exceeds 8 MiB")
    }
    let contents = Vec::from_array(
        [generated.goml_source, generated.go_source, output_manifest(outputs, generated)],
    );
    let next = Vec::new();
    for source in contents {
        next.push(Option::Some(source));
    }
    if !same_outputs(previous, read_outputs(outputs)?) {
        return Result::Err("bind-go: output changed during generation")
    }
    if same_outputs(previous, next) {
        return Result::Ok(())
    }
    let files = output_files(outputs);
    for index in 0..files.len() {
        fs::create_dir_all(path::parent(files[index]).ok_or("bind-go: missing output directory")?).map_err(
            |error| error.to_string(),
        )?;
        fs::write_file_structured(path::join(staging, "new_" + index.to_string()), contents[index]).map_err(
            |error| error.to_string(),
        )?;
        if let Some(source) = previous[index] {
            fs::write_file_structured(path::join(staging, "old_" + index.to_string()), source).map_err(
                |error| error.to_string(),
            )?;
        }
    }
    if !same_outputs(previous, read_outputs(outputs)?) {
        return Result::Err("bind-go: output changed before publication")
    }
    commit_outputs(files, previous, staging, preserve)
}

pub fn publish(outputs: Outputs, produce: () -> Result[Generated, string]) -> Result[(), string] {
    let staging = path::join(outputs.root, ".goml-bind-go-lock");
    fs::create_dir(staging).map_err(
        |error| if error.kind() == io::ErrorKind::AlreadyExists {
            "bind-go: module is locked by another generation: " + outputs.root
        } else {
            error.to_string()
        },
    )?;
    let preserve = Ref::new(false);
    let result = publish_locked(outputs, staging, preserve, produce);
    if !preserve.get() {
        if let Err(error) = fs::remove_dir_all(staging) {
            return Result::Err("bind-go: lock cleanup failed: " + error.to_string())
        }
    }
    result
}
