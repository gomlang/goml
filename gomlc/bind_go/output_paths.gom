package bind_go;

use std::fs;
use std::io;
use std::path;

pub struct Outputs {
    pub root: string,
    pub goml: string,
    pub go_file: string,
    pub manifest: string,
}

fn inside_root(root: string, value: string) -> bool {
    value == root || value.starts_with(root + "/")
}

fn checked_output(root: string, value: string) -> Result[string, string] {
    if !inside_root(root, value) || value == root {
        return Result::Err("bind-go: output is outside the module root")
    }
    let mut current = root;
    let parts = path::components(value.byte_slice(root.byte_len() + 1, value.byte_len()));
    for index in 0..parts.len() {
        if parts[index] == ".goml-bind-go-lock" || parts[index] == ".goml-bind-go-query" {
            return Result::Err("bind-go: output conflicts with generator recovery directory")
        }
        current = path::join(current, parts[index]);
        match fs::symlink_metadata(current) {
            Ok(metadata) => {
                if metadata.file_type().is_symlink() {
                    return Result::Err("bind-go: output path contains a symbolic link: " + current)
                }
                if index + 1 < parts.len() && !metadata.file_type().is_dir() {
                    return Result::Err("bind-go: output ancestor is not a directory: " + current)
                }
                if index + 1 == parts.len() && !metadata.file_type().is_file() {
                    return Result::Err("bind-go: output must be a regular file: " + current)
                }
            },
            Err(error) => if error.kind() != io::ErrorKind::NotFound {
                return Result::Err(error.to_string())
            },
        }
        if index + 1 < parts.len() {
            for manifest in Vec::from_array(["go.mod", "goml.toml"]) {
                match fs::symlink_metadata(path::join(current, manifest)) {
                    Ok(_) => return Result::Err(
                        "bind-go: output crosses a nested module: " + current,
                    ),
                    Err(error) => if error.kind() != io::ErrorKind::NotFound {
                        return Result::Err(error.to_string())
                    },
                }
            }
        }
    }
    Result::Ok(value)
}

fn configured_output(root: string, directory: string, value: string) -> Result[string, string] {
    if path::is_absolute(value) || value == "" {
        return Result::Err("bind-go: output must be a relative file path")
    }
    for component in path::components(value) {
        if component == ".." {
            return Result::Err("bind-go: parent traversal is not allowed")
        }
    }
    checked_output(root, path::clean(path::join(directory, value)))
}

pub fn resolve_outputs(root: string, config_file: string, config: Config) -> Result[Outputs, string] {
    let root = fs::canonicalize(root).map_err(|error| error.to_string())?;
    let config_file = path::absolute_structured(config_file).map_err(|error| error.to_string())?;
    let _ = checked_output(root, config_file)?;
    let directory = path::parent(config_file).ok_or("bind-go: missing configuration directory")?;
    let goml = configured_output(root, directory, config.output)?;
    let go_file = configured_output(root, directory, config.go_output)?;
    let manifest = checked_output(root, config_file + ".goml-bind.json")?;
    if goml == go_file || goml == manifest || go_file == manifest || goml == config_file
        || go_file == config_file {
        return Result::Err("bind-go: configuration and output paths must be distinct")
    }
    Result::Ok(Outputs { root, goml, go_file, manifest })
}
