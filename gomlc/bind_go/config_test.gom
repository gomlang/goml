package bind_go;

use module::ffi;
use std::testing;

fn config_source() -> string {
    "{\"version\":1,\"package\":\"bindings\",\"output\":\"bindings/generated.gom\",\"go_package\":\"native_bindings\",\"go_output\":\"native_bindings/generated.go\",\"go_import_path\":\"example.com/host/native_bindings\",\"functions\":[{\"name\":\"identity\",\"import_path\":\"example.com/shim\",\"symbol\":\"Identity\",\"type_arguments\":[{\"tag\":\"int64\"}]}],\"types\":[{\"name\":\"BoxInt\",\"import_path\":\"example.com/shim\",\"symbol\":\"Box\",\"type_arguments\":[{\"tag\":\"int64\"}]}]}"
}

#[test]
fn bind_go_config_preserves_explicit_queries_and_outputs() -> () {
    let Ok(config) = parse_config(config_source()) else {
        testing::fail("expected binding configuration");
        return
    };
    testing::assert_eq(config.package_name, "bindings");
    testing::assert_eq(config.output, "bindings/generated.gom");
    testing::assert_eq(config.go_output, "native_bindings/generated.go");
    testing::assert_eq(config.go_import_path, "example.com/host/native_bindings");
    let functions = function_queries(config);
    testing::assert_eq(functions.len(), 1);
    testing::assert_eq(functions[0].id, "identity");
    testing::assert_eq(functions[0].name, "Identity");
    testing::assert(
        ffi::bridge_types_equal(functions[0].arguments[0], ffi::BridgeType::Scalar("int64")),
    );
    let types = type_queries(config);
    testing::assert_eq(types.len(), 1);
    testing::assert_eq(types[0].declaration.type_id, "BoxInt");
    testing::assert_eq(types[0].declaration.name, "Box");
}

#[test]
fn bind_go_config_rejects_ambiguous_and_unbounded_inputs() -> () {
    for change in Vec::from_array(
        [
            ("\"version\":1", "\"version\":2"),
            ("\"version\":1", "\"version\":1,\"version\":1"),
            ("\"version\":1", "\"version\":1,\"implicit_adapters\":true"),
            ("\"name\":\"identity\"", "\"name\":\"fn\""),
            ("\"name\":\"identity\"", "\"name\":\"ffi\""),
            ("\"name\":\"identity\"", "\"name\":\"__goml_bind_helper\""),
            ("\"name\":\"BoxInt\"", "\"name\":\"identity\""),
            ("\"name\":\"BoxInt\"", "\"name\":\"lower_type\""),
            ("\"name\":\"BoxInt\"", "\"name\":\"GomlBindType_Hidden\""),
            ("\"name\":\"identity\"", "\"name\":\"UpperFunction\""),
            ("\"package\":\"bindings\"", "\"package\":\"UpperPackage\""),
            ("\"symbol\":\"Identity\"", "\"symbol\":\"private\""),
            ("\"go_package\":\"native_bindings\"", "\"go_package\":\"map\""),
            ("\"package\":\"bindings\"", "\"package\":\"main\""),
            ("generated.gom", "generated.txt"),
            ("\"tag\":\"int64\"", "\"tag\":\"unknown\""),
        ],
    ) {
        if parse_config(config_source().replace(change.0, change.1)).is_ok() {
            testing::fail("accepted invalid configuration: " + change.1);
        }
    }
    testing::assert(parse_config("{}").is_err());
    let mut nested = "";
    for index in 0..65 {
        nested = nested + "[";
    }
    for index in 0..65 {
        nested = nested + "]";
    }
    testing::assert(parse_config(nested).is_err());
}
