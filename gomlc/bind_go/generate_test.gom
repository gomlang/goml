package bind_go;

use module::ffi;
use std::testing;

fn generation_metadata() -> ffi::TypeDeclarations {
    ffi::TypeDeclarations {
        go_world_identity: "test",
        declarations: Vec::new(),
        nodes: HashMap::new(),
    }
}

#[test]
fn bind_go_generation_is_deterministic_and_preserves_variadic_instances() -> () {
    let binding = Binding {
        name: "sum",
        import_path: "example.com/native",
        symbol: "Sum",
        arguments: Vec::from_array([ffi::BridgeType::Scalar("int64")]),
    };
    let config = Config {
        package_name: "bindings",
        output: "bindings/generated.gom",
        go_package: "native_bindings",
        go_output: "native_bindings/generated.go",
        go_import_path: "example.com/host/native_bindings",
        functions: Vec::from_array([binding]),
        types: Vec::new(),
    };
    let integer = ffi::GoTypeIdentity::Basic("int64");
    let functions = ffi::FunctionQueries {
        metadata: generation_metadata(),
        functions: Vec::from_array(
            [
                ffi::QueriedFunction {
                    query: function_queries(config)[0],
                    signature: ffi::GoTypeIdentity::Function {
                        parameters: Vec::from_array([ffi::GoTypeIdentity::Slice(integer)]),
                        results: Vec::from_array([integer]),
                    },
                    variadic: true,
                },
            ],
        ),
    };
    let types = ffi::TypeInstances { declarations: generation_metadata(), instances: Vec::new() };
    let Ok(first) = generate(config, functions, types) else {
        testing::fail("generation failed");
        return
    };
    let Ok(second) = generate(config, functions, types) else {
        testing::fail("repeat generation failed");
        return
    };
    testing::assert_eq(first.goml_source, second.goml_source);
    testing::assert_eq(first.go_source, second.go_source);
    testing::assert(first.goml_source.contains("pub extern fn sum(p0: ffi::RawSlice[i64]) -> i64;"));
    testing::assert(first.go_source.contains("native_0.Sum[int64](p0...)"));
    testing::assert(first.go_source.contains("func GomlBind_sum(p0 []int64) int64"));
    testing::assert(
        generate(
            config,
            ffi::FunctionQueries { metadata: generation_metadata(), functions: Vec::new() },
            types,
        ).is_err(),
    );
}
