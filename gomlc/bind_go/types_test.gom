package bind_go;

use module::ffi;
use module::go_backend;
use module::formatter;
use std::testing;

#[test]
fn bind_go_types_preserve_raw_boundaries_and_explicit_names() -> () {
    let named = ffi::GoTypeIdentity::Named {
        import_path: "example.com/shim",
        name: "Box",
        arguments: Vec::from_array([ffi::GoTypeIdentity::Basic("int64")]),
    };
    let names = Vec::from_array([TypeBinding { name: "BoxInt", identity: named }]);
    let parameter = ffi::GoTypeIdentity::Map {
        key: ffi::GoTypeIdentity::Basic("string"),
        element: ffi::GoTypeIdentity::Slice(ffi::GoTypeIdentity::Pointer(named)),
    };
    testing::assert_eq(
        goml_type(parameter, names).unwrap_or(""),
        "ffi::RawMap[ffi::String, ffi::RawSlice[ffi::Ptr[BoxInt]]]",
    );
    let results = Vec::from_array(
        [
            ffi::GoTypeIdentity::Basic("int"),
            ffi::GoTypeIdentity::Named { import_path: "", name: "error", arguments: Vec::new() },
        ],
    );
    testing::assert_eq(goml_results(results, names).unwrap_or(""), "(isize, ffi::Error)");
    let function = ffi::GoTypeIdentity::Function {
        parameters: Vec::from_array([parameter]),
        results,
    };
    let rendered = goml_type(function, names).unwrap_or("");
    testing::assert(rendered.starts_with("ffi::Func[(ffi::RawMap["));
    testing::assert(formatter::format_source("fn take(value: " + rendered + ") -> () {}").is_ok());
    let imports: HashMap[string, string] = HashMap::new();
    imports["example.com/shim"] = "native";
    let Ok(ty) = native_type(function, imports) else {
        testing::fail("expected native function type");
        return
    };
    let source = go_backend::encode_package(
        go_backend::File {
            items: Vec::from_array(
                [
                    go_backend::Item::Global(
                        go_backend::Global {
                            name: "Value",
                            ty: Option::Some(ty),
                            value: go_backend::Expr::Nil,
                        },
                    ),
                ],
            ),
        },
        "bindings",
    );
    testing::assert(source.contains("map[string][]*native.Box[int64]"));
    testing::assert(source.contains("(int, error)"));
}

#[test]
fn bind_go_types_reject_missing_names_and_unsupported_values() -> () {
    let named = ffi::GoTypeIdentity::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    testing::assert(goml_type(named, Vec::new()).is_err());
    testing::assert(native_type(named, HashMap::new()).is_err());
    let names = Vec::from_array(
        [
            TypeBinding { name: "First", identity: named },
            TypeBinding { name: "Second", identity: named },
        ],
    );
    testing::assert(goml_type(named, names).is_err());
    for invalid in Vec::from_array(
        [
            ffi::GoTypeIdentity::Parameter(0),
            ffi::GoTypeIdentity::Basic("complex128"),
            ffi::GoTypeIdentity::Array { element: ffi::GoTypeIdentity::Basic("int64"), length: -1 },
            ffi::GoTypeIdentity::Channel {
                element: ffi::GoTypeIdentity::Basic("int64"),
                direction: "invalid",
            },
        ],
    ) {
        testing::assert(goml_type(invalid, Vec::new()).is_err());
        testing::assert(native_type(invalid, HashMap::new()).is_err());
    }
}
