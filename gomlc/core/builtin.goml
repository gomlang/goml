package core;

use module::ast;
use module::hir;
use module::parser;
use module::resources;
use module::tast;

fn non_root(value: Function) -> Function {
    Function {
        name: value.name,
        origin: value.origin,
        root: false,
        generics: value.generics,
        predicates: value.predicates,
        trait_impl: value.trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: value.body,
    }
}

fn lower_toolchain_hir_files(sources: Vec[resources::Source], package_name: string) -> Result[
    Vec[hir::File],
    string,
] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, package_name) {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err(
                "failed to lower " + package_name + " source " + lowered.source_path,
            ),
        }
    }
    Result::Ok(files)
}

pub fn without_roots(value: File) -> File {
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        functions.push(non_root(function))
    }
    File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
    }
}

pub fn lower_builtins(counter: Ref[isize]) -> Result[File, string] {
    let hir_files = lower_toolchain_hir_files(resources::builtin_layer_sources()?, "builtin")?;
    let checked = tast::check_builtin_package_files(hir_files);
    if checked.tast.is_none() {
        return Result::Err("failed to typecheck builtin package")
    }
    Result::Ok(lower_with_counter(checked, counter))
}

pub fn lower_prelude(builtins: File, counter: Ref[isize]) -> Result[File, string] {
    let builtin_files = lower_toolchain_hir_files(resources::builtin_layer_sources()?, "builtin")?;
    let prelude_files = lower_toolchain_hir_files(resources::prelude_sources()?, "prelude")?;
    let checked = tast::check_package_files_for_link_with_dependencies(prelude_files, builtin_files);
    if checked.tast.is_none() || !checked.diagnostics.is_empty() {
        return Result::Err("failed to typecheck prelude package")
    }
    Result::Ok(
        without_roots(
            lower_with_counter_types_and_options(
                checked,
                counter,
                enum_defs_to_tast(builtins.enums),
                struct_defs_to_tast(builtins.structs),
                true,
            ),
        ),
    )
}

pub fn link_with_dependencies(builtins: File, dependencies: Vec[File], user: File) -> File {
    let functions: Vec[Function] = Vec::new();
    for function in builtins.functions {
        functions.push(non_root(function))
    }
    for dependency in dependencies {
        for function in dependency.functions {
            functions.push(function)
        }
    }
    for function in user.functions {
        functions.push(function)
    }
    let enums: Vec[EnumDef] = Vec::new();
    for value in builtins.enums {
        enums.push(value)
    }
    for dependency in dependencies {
        for value in dependency.enums {
            enums.push(value)
        }
    }
    for value in user.enums {
        enums.push(value)
    }
    let structs: Vec[StructDef] = Vec::new();
    for value in builtins.structs {
        structs.push(value)
    }
    for dependency in dependencies {
        for value in dependency.structs {
            structs.push(value)
        }
    }
    for value in user.structs {
        structs.push(value)
    }
    let type_instances: Vec[TypeInstance] = Vec::new();
    for value in builtins.type_instances {
        type_instances.push(value)
    }
    for dependency in dependencies {
        for value in dependency.type_instances {
            type_instances.push(value)
        }
    }
    for value in user.type_instances {
        type_instances.push(value)
    }
    let constants: Vec[Constant] = Vec::new();
    let statics: Vec[Static] = Vec::new();
    for value in builtins.constants {
        constants.push(value)
    }
    for dependency in dependencies {
        for value in dependency.constants {
            constants.push(value)
        }
    }
    for value in user.constants {
        constants.push(value)
    }
    for value in builtins.statics {
        statics.push(value)
    }
    for dependency in dependencies {
        for value in dependency.statics {
            statics.push(value)
        }
    }
    for value in user.statics {
        statics.push(value)
    }
    File { functions, enums, structs, type_instances, constants, statics }
}

pub fn link_with_builtins(builtins: File, user: File) -> File {
    link_with_dependencies(builtins, Vec::new(), user)
}
