package core;

use std::testing;

fn reachable_source(source: string) -> File {
    let value = lower_source(source);
    testing::assert(!value.functions.is_empty());
    eliminate_unreachable_functions(core_with_only_named_root(eliminate_dead_locals(value), "main"))
}

#[test]
fn reachability_distinguishes_inherent_method_owners() -> () {
    let value = reachable_source(
        "struct Used {} struct Unused {} impl Used { fn name(self: Self) -> string { \"used\" } } impl Unused { fn name(self: Self) -> string { noise() } } fn noise() -> string { \"noise\" } fn main() -> string { Used {}.name() }",
    );
    let output = encode(value);
    testing::assert(output.contains("inherent#Used#Used#name"));
    testing::assert(!output.contains("inherent#Unused#Unused#name"));
    testing::assert(!output.contains("fn noise("))
}

#[test]
fn reachability_unions_concrete_generic_calls_and_function_values() -> () {
    let value = reachable_source(
        "struct First {} struct Second {} struct Unused {} trait Render { fn render(self: Self) -> string; } impl Render for First { fn render(self: Self) -> string { \"first\" } } impl Render for Second { fn render(self: Self) -> string { \"second\" } } impl Render for Unused { fn render(self: Self) -> string { \"unused\" } } fn render[T: Render](value: T) -> string { value.render() } fn main() -> string { let callback: (Second) -> string = render; render(First {}) + callback(Second {}) }",
    );
    let output = encode(value);
    testing::assert(output.contains("trait_impl#Render#First#render"));
    testing::assert(output.contains("trait_impl#Render#Second#render"));
    testing::assert(!output.contains("trait_impl#Render#Unused#render"));
    testing::assert(output.contains("fn render[T]("))
}

#[test]
fn reachability_tracks_erased_generic_arguments() -> () {
    let value = reachable_source(
        "struct First {} struct Unused {} trait Label { fn label() -> string; } impl Label for First { fn label() -> string { \"first\" } } impl Label for Unused { fn label() -> string { \"unused\" } } fn erased[T: Label]() -> string { T::label() } fn forward[T: Label]() -> string { erased::[T]() } fn main() -> string { let callback: () -> string = forward::[First]; callback() }",
    );
    let output = encode(value);
    testing::assert(output.contains("trait_impl#Label#First#label"));
    testing::assert(!output.contains("trait_impl#Label#Unused#label"));
    testing::assert(output.contains("fn erased[T]("));
    testing::assert(output.contains("fn forward[T]("))
}

#[test]
fn reachability_preserves_dynamic_trait_dispatch() -> () {
    let value = reachable_source(
        "struct Value {} trait Render { fn render(self: Self) -> string; } impl Render for Value { fn render(self: Self) -> string { \"value\" } } fn render(value: dyn Render) -> string { value.render() } fn main() -> string { render(Value {}) }",
    );
    testing::assert(encode(value).contains("trait_impl#Render#Value#render"))
}

#[test]
fn reachability_preserves_runtime_key_implementations() -> () {
    let value = reachable_source(
        "struct Key { value: i32 } struct Unused {} impl PartialEq for Key { fn eq(self: Self, other: Self) -> bool { self.value == other.value } } impl Eq for Key {} impl Hash for Key { fn hash(self: Self) -> u64 { self.value as u64 } } impl PartialEq for Unused { fn eq(self: Self, other: Self) -> bool { true } } impl Eq for Unused {} impl Hash for Unused { fn hash(self: Self) -> u64 { 0 } } fn main() -> HashMap[(Key, [Key; 2]), i32] { HashMap::new() }",
    );
    let output = encode(value);
    testing::assert(output.contains("trait_impl#PartialEq#Key#eq"));
    testing::assert(output.contains("trait_impl#Hash#Key#hash"));
    testing::assert(!output.contains("trait_impl#PartialEq#Unused#eq"));
    testing::assert(!output.contains("trait_impl#Hash#Unused#hash"))
}

#[test]
fn reachability_preserves_constant_dependencies_and_patterns() -> () {
    let source = lower_source("fn main() -> i32 { 4 }");
    let function = source.functions[0];
    let literal = Expr::Prim { value: Primitive::Int32 { value: "4" }, ty: Type::Int32 };
    let constants = Vec::from_array(
        [
            Constant {
                name: "BASE",
                ty: Type::Int32,
                value: ConstExpr::Prim { value: Primitive::Int32 { value: "4" }, ty: Type::Int32 },
            },
            Constant {
                name: "PATTERN",
                ty: Type::Int32,
                value: ConstExpr::Ref { name: "BASE", ty: Type::Int32 },
            },
            Constant {
                name: "UNUSED",
                ty: Type::String,
                value: ConstExpr::Prim {
                    value: Primitive::String { value: "unused" },
                    ty: Type::String,
                },
            },
        ],
    );
    let body = Block {
        stmts: Vec::new(),
        tail: Option::Some(
            Expr::Match {
                expr: literal,
                arms: Vec::from_array(
                    [Arm { lhs: Expr::Var { name: "PATTERN", ty: Type::Int32 }, body: literal }],
                ),
                default: Option::Some(literal),
                ty: Type::Int32,
            },
        ),
    };
    let value = eliminate_unreachable_functions(
        File {
            functions: Vec::from_array(
                [
                    Function {
                        name: function.name,
                        origin: function.origin,
                        root: function.root,
                        generics: function.generics,
                        predicates: function.predicates,
                        trait_impl: function.trait_impl,
                        params: function.params,
                        ret_ty: function.ret_ty,
                        body,
                    },
                ],
            ),
            enums: source.enums,
            structs: source.structs,
            type_instances: source.type_instances,
            constants,
            statics: source.statics,
        },
    );
    let output = encode(value);
    testing::assert(output.contains("const BASE:"));
    testing::assert(output.contains("const PATTERN:"));
    testing::assert(!output.contains("const UNUSED:"))
}

#[test]
fn reachability_preserves_structural_default_methods() -> () {
    let value = reachable_source(
        "struct Value { number: i32 } impl Default for Value { fn default() -> Self { Value { number: 7 } } } fn main() -> (Value, [Value; 2]) { Default::default() }",
    );
    testing::assert(encode(value).contains("trait_impl#Default#Value#default"))
}

#[test]
fn reachability_bounds_recursive_generic_type_growth() -> () {
    let value = reachable_source(
        "fn grow[T](value: T) -> () { grow((value, value)); } fn main() -> () { grow(1); }",
    );
    let output = encode(value);
    testing::assert(output.contains("fn grow[T]("));
    testing::assert(output.contains("fn main("))
}
