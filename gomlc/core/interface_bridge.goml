package core;

fn interface_bridge_queue_block(pending: Vec[Expr], block: Block) -> () {
    for binding in block.stmts {
        pending.push(binding.value);
    }
    if let Some(tail) = block.tail {
        pending.push(tail);
    }
}

pub fn interface_bridge_uses(value: File) -> Vec[(string, Vec[string], Type)] {
    let pending: Vec[Expr] = Vec::new();
    let result: Vec[(string, Vec[string], Type)] = Vec::new();
    for function in value.functions {
        interface_bridge_queue_block(pending, function.body);
    }
    let mut index = 0;
    while index < pending.len() {
        let value = pending[index];
        index += 1;
        match value {
            Callable { callable: GoInterfaceBridge { binding, methods }, ty } => result.push(
                (binding, methods, ty),
            ),
            Var { .. } | Callable { .. } | Prim { .. } | Continue { .. } => (),
            Tuple { items, .. } | Array { items, .. } | Constr { args: items, .. } => for item in items {
                pending.push(item);
            },
            Closure { body, .. } | Loop { body, .. } => pending.push(body),
            Block { block, .. } => interface_bridge_queue_block(pending, block),
            Match { expr, arms, default, .. } => {
                pending.push(expr);
                for arm in arms {
                    pending.push(arm.lhs);
                    pending.push(arm.body);
                }
                if let Some(value) = default {
                    pending.push(value);
                }
            },
            Select { arms, default, .. } => {
                for arm in arms {
                    match arm {
                        Receive { channel, guard, body, .. } => {
                            pending.push(channel);
                            pending.push(body);
                            if let Some(value) = guard {
                                pending.push(value);
                            }
                        },
                        Send { channel, value, guard, body } => {
                            pending.push(channel);
                            pending.push(value);
                            pending.push(body);
                            if let Some(value) = guard {
                                pending.push(value);
                            }
                        },
                    }
                }
                if let Some(value) = default {
                    pending.push(value);
                }
            },
            If { cond, then_branch, else_branch, .. } => {
                pending.push(cond);
                pending.push(then_branch);
                pending.push(else_branch);
            },
            While { cond, body, .. } => {
                pending.push(cond);
                pending.push(body);
            },
            Break { value, .. } | Return { expr: value, .. } => if let Some(value) = value {
                pending.push(value);
            },
            Go { expr, .. } | ConstrGet { expr, .. } | Unary { expr, .. } | Cast { expr, .. } | ToDyn {
                expr,
                ..,
            } | Proj { tuple: expr, .. } => pending.push(expr),
            Binary { lhs, rhs, .. } => {
                pending.push(lhs);
                pending.push(rhs);
            },
            Assign { value, .. } => pending.push(value),
            Call { func, args, .. } | DynCall { receiver: func, args, .. } => {
                pending.push(func);
                for arg in args {
                    pending.push(arg);
                }
            },
            TraitCall { receiver, args, .. } => {
                if let Some(value) = receiver {
                    pending.push(value);
                }
                for arg in args {
                    pending.push(arg);
                }
            },
        }
    }
    result
}
