package core;

pub fn with_function_roots(value: File, roots: Vec[string]) -> Result[File, string] {
    let remaining: HashMap[string, bool] = HashMap::new();
    for name in roots {
        if remaining[name].is_some() {
            return Result::Err("duplicate function root " + name)
        }
        remaining[name] = false;
    }
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        let root = remaining[function.name].is_some();
        if root {
            if remaining[function.name] == Option::Some(true) {
                return Result::Err("ambiguous function root " + function.name)
            }
            if !function.generics.is_empty() || !type_is_concrete(function.ret_ty) {
                return Result::Err("function root must be monomorphic: " + function.name)
            }
            for param in function.params {
                if !type_is_concrete(param.1) {
                    return Result::Err("function root must be monomorphic: " + function.name)
                }
            }
            remaining[function.name] = true;
        }
        functions.push(
            Function {
                name: function.name,
                origin: function.origin,
                root,
                generics: function.generics,
                predicates: function.predicates,
                trait_impl: function.trait_impl,
                params: function.params,
                ret_ty: function.ret_ty,
                body: function.body,
            },
        )
    }
    for name in roots {
        if remaining[name] != Option::Some(true) {
            return Result::Err("missing function root " + name)
        }
    }
    Result::Ok(
        File {
            functions,
            enums: value.enums,
            structs: value.structs,
            type_instances: value.type_instances,
            constants: value.constants,
            statics: value.statics,
        },
    )
}
