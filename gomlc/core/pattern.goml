package core;

use module::tast;
use std::text;

struct PatternBinding {
    name: string,
    source: string,
    ty: tast::Type,
}

struct PatternPlan {
    projections: Vec[LowerLetStmt],
    bindings: Vec[PatternBinding],
}

struct PatternColumn {
    source: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
}

struct PatternRow {
    columns: Vec[PatternColumn],
    bindings: Vec[PatternBinding],
    body: tast::Expr,
}

struct PatternEnumCase {
    constructor: tast::Constructor,
    variables: Vec[(string, tast::Type)],
    rows: Vec[PatternRow],
}

struct PrimitivePatternCase {
    key: string,
    value: tast::Primitive,
    ty: tast::Type,
}

fn flat_pattern_items(items: Vec[tast::Pat]) -> bool {
    for item in items {
        match item {
            Var { name: _, is_mut: _, ty: _ } | Wild { ty: _ } => (),
            _ => return false,
        }
    }
    true
}

fn pattern_contains_constant(value: tast::Pat) -> bool {
    match value {
        Constant { name: _, ty: _ } => true,
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Or {
            pats: args,
            ty: _,
        } => {
            for arg in args {
                if pattern_contains_constant(arg) {
                    return true
                }
            }
            false
        },
        Array { prefix, rest: _, suffix, ty: _ } => {
            for arg in prefix {
                if pattern_contains_constant(arg) {
                    return true
                }
            }
            for arg in suffix {
                if pattern_contains_constant(arg) {
                    return true
                }
            }
            false
        },
        Alias { name: _, pat, ty: _ } => pattern_contains_constant(pat),
        _ => false,
    }
}

fn plan_flat_pattern(ctx: Lowerer, source: string, pattern: tast::Pat) -> Option[PatternPlan] {
    match pattern {
        Tuple { items, ty: tuple_ty } => match tast::resolve_type(tuple_ty) {
            Tuple { items: types } => if items.len() == types.len() && flat_pattern_items(items) {
                let names: Vec[string] = Vec::new();
                for _ in types {
                    names.push(gensym(ctx, "x"))
                }
                let projections: Vec[LowerLetStmt] = Vec::new();
                let bindings: Vec[PatternBinding] = Vec::new();
                for index in 0..items.len() {
                    let item_ty = types[index];
                    let projection_name = names[index];
                    projections.push(
                        LowerLetStmt {
                            name: projection_name,
                            value: LowerExpr::Proj {
                                tuple: LowerExpr::Var { name: source, ty: tuple_ty },
                                index,
                                ty: item_ty,
                            },
                            ty: item_ty,
                        },
                    );
                    match items[index] {
                        Var { name, is_mut: _, ty } => bindings.push(
                            PatternBinding { name, source: projection_name, ty },
                        ),
                        Wild { ty: _ } => (),
                        _ => (),
                    }
                }
                Option::Some(PatternPlan { projections, bindings })
            } else {
                Option::None
            },
            _ => Option::None,
        },
        Constr { constructor, args: items, ty: struct_ty } => if constructor.is_struct
            && flat_pattern_items(items) {
            let names: Vec[string] = Vec::new();
            for _ in items {
                names.push(gensym(ctx, "x"))
            }
            let projections: Vec[LowerLetStmt] = Vec::new();
            let bindings: Vec[PatternBinding] = Vec::new();
            for index in 0..items.len() {
                let item = items[index];
                let item_ty = tast::pat_type(item);
                let projection_name = names[index];
                projections.push(
                    LowerLetStmt {
                        name: projection_name,
                        value: LowerExpr::ConstrGet {
                            expr: LowerExpr::Var { name: source, ty: struct_ty },
                            constructor,
                            field_index: index,
                            ty: item_ty,
                        },
                        ty: item_ty,
                    },
                );
                match item {
                    Var { name, is_mut: _, ty } => bindings.push(
                        PatternBinding { name, source: projection_name, ty },
                    ),
                    Wild { ty: _ } => (),
                    _ => (),
                }
            }
            Option::Some(PatternPlan { projections, bindings })
        } else {
            Option::None
        },
        _ => Option::None,
    }
}

fn apply_pattern_plan(plan: PatternPlan, body: LowerExpr, body_ty: tast::Type) -> LowerExpr {
    let mut result = body;
    for binding in plan.bindings {
        let stmts: Vec[LowerLetStmt] = Vec::new();
        stmts.push(
            LowerLetStmt {
                name: binding.name,
                value: LowerExpr::Var { name: binding.source, ty: binding.ty },
                ty: binding.ty,
            },
        );
        result = LowerExpr::Block {
            block: LowerBlock { stmts, tail: Option::Some(result) },
            ty: body_ty,
        };
    }
    LowerExpr::Block {
        block: LowerBlock { stmts: plan.projections, tail: Option::Some(result) },
        ty: body_ty,
    }
}

fn normalize_pattern_rows(rows: Vec[PatternRow]) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        let columns: Vec[PatternColumn] = Vec::new();
        let bindings: Vec[PatternBinding] = Vec::new();
        for binding in row.bindings {
            bindings.push(binding)
        }
        for column in row.columns {
            match column.pattern {
                Var { name, is_mut: _, ty } => bindings.push(
                    PatternBinding { name, source: column.source, ty },
                ),
                Wild { ty: _ } => (),
                _ => columns.push(column),
            }
        }
        result.push(PatternRow { columns, bindings, body: row.body })
    }
    result
}

fn expand_or_pattern_rows(rows: Vec[PatternRow], source: string) -> Option[Vec[PatternRow]] {
    let result: Vec[PatternRow] = Vec::new();
    let mut expanded = false;
    for row in rows {
        match or_pattern_column_index(row, source) {
            Some(index) => {
                let column = row.columns[index];
                match column.pattern {
                    Or { pats: patterns, ty: _ } => for pattern in patterns {
                        let columns: Vec[PatternColumn] = Vec::new();
                        for column_index in 0..row.columns.len() {
                            let value = row.columns[column_index];
                            if column_index == index {
                                columns.push(
                                    PatternColumn {
                                        source: value.source,
                                        source_ty: value.source_ty,
                                        pattern,
                                    },
                                )
                            } else {
                                columns.push(value)
                            }
                        }
                        result.push(PatternRow { columns, bindings: row.bindings, body: row.body })
                    },
                    _ => result.push(row),
                }
                expanded = true;
            },
            None => result.push(row),
        }
    }
    if expanded {
        Option::Some(result)
    } else {
        Option::None
    }
}

fn or_pattern_column_index(row: PatternRow, source: string) -> Option[isize] {
    for index in 0..row.columns.len() {
        let column = row.columns[index];
        if column.source == source {
            if let Or { pats: _, ty: _ } = column.pattern {
                return Option::Some(index)
            }
        }
    }
    Option::None
}

fn pattern_source_count(rows: Vec[PatternRow], source: string) -> isize {
    let mut count = 0;
    for row in rows {
        for column in row.columns {
            if column.source == source {
                count += 1;
            }
        }
    }
    count
}

fn branch_pattern_column(rows: Vec[PatternRow]) -> Option[PatternColumn] {
    if rows.is_empty() || rows[0].columns.is_empty() {
        Option::None
    } else {
        let mut selected = 0;
        let mut best = -1;
        let columns = rows[0].columns;
        for index in 0..columns.len() {
            let column = columns[index];
            let count = pattern_source_count(rows, column.source);
            if count >= best {
                best = count;
                selected = index;
            }
        }
        Option::Some(columns[selected])
    }
}

fn lower_pattern_row_body(ctx: Lowerer, row: PatternRow) -> LowerExpr {
    let body_ty = tast::expr_type(row.body);
    let mut result = lower_expr(ctx, row.body);
    for binding in row.bindings {
        let stmts: Vec[LowerLetStmt] = Vec::new();
        stmts.push(
            LowerLetStmt {
                name: binding.name,
                value: LowerExpr::Var { name: binding.source, ty: binding.ty },
                ty: binding.ty,
            },
        );
        result = LowerExpr::Block {
            block: LowerBlock { stmts, tail: Option::Some(result) },
            ty: body_ty,
        };
    }
    result
}

fn bool_pattern_row(row: PatternRow, source: string, expected: bool) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value: Bool { value }, ty: _ } => if value == expected {} else {
                    return Option::None
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn bool_pattern_rows(rows: Vec[PatternRow], source: string, expected: bool) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = bool_pattern_row(row, source, expected) {
            result.push(value)
        }
    }
    result
}

fn tuple_pattern_row(row: PatternRow, source: string, names: Vec[string], types: Vec[tast::Type]) -> Option[
    PatternRow,
] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Tuple { items, ty: _ } => if items.len() == names.len() {
                    for index in 0..items.len() {
                        columns.push(
                            PatternColumn {
                                source: names[index],
                                source_ty: types[index],
                                pattern: items[index],
                            },
                        )
                    }
                } else {
                    return Option::None
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn tuple_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    types: Vec[tast::Type],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = tuple_pattern_row(row, source, names, types) {
            result.push(value)
        }
    }
    result
}

fn lower_tuple_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    types: Vec[tast::Type],
    ty: tast::Type,
) -> LowerExpr {
    let names: Vec[string] = Vec::new();
    for _ in types {
        names.push(gensym(ctx, "x"))
    }
    let inner = lower_pattern_rows(ctx, tuple_pattern_rows(rows, column.source, names, types), ty);
    let stmts: Vec[LowerLetStmt] = Vec::new();
    for index in 0..types.len() {
        stmts.push(
            LowerLetStmt {
                name: names[index],
                value: LowerExpr::Proj {
                    tuple: LowerExpr::Var { name: column.source, ty: column.source_ty },
                    index,
                    ty: types[index],
                },
                ty: types[index],
            },
        )
    }
    LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(inner) }, ty }
}

fn struct_pattern_row(
    row: PatternRow,
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Constr { constructor, args: patterns, ty: _ } => {
                    if constructor.is_struct && patterns.len() == names.len() {
                        for index in 0..patterns.len() {
                            columns.push(
                                PatternColumn {
                                    source: names[index],
                                    source_ty: fields[index].1,
                                    pattern: patterns[index],
                                },
                            )
                        }
                    } else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn struct_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    names: Vec[string],
    fields: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = struct_pattern_row(row, source, names, fields) {
            result.push(value)
        }
    }
    result
}

fn lower_struct_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    constructor: tast::Constructor,
    fields: Vec[(string, tast::Type)],
    ty: tast::Type,
) -> LowerExpr {
    let names: Vec[string] = Vec::new();
    for _ in fields {
        names.push(gensym(ctx, "x"))
    }
    let inner = lower_pattern_rows(ctx, struct_pattern_rows(rows, column.source, names, fields), ty);
    let stmts: Vec[LowerLetStmt] = Vec::new();
    for index in 0..fields.len() {
        stmts.push(
            LowerLetStmt {
                name: names[index],
                value: LowerExpr::ConstrGet {
                    expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
                    constructor,
                    field_index: index,
                    ty: fields[index].1,
                },
                ty: fields[index].1,
            },
        )
    }
    LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(inner) }, ty }
}

fn enum_pattern_row(
    row: PatternRow,
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Constr { constructor, args: patterns, ty: _ } => {
                    if constructor.name == constructor_name && patterns.len() == variables.len() {
                        for index in 0..patterns.len() {
                            let variable = variables[index];
                            columns.push(
                                PatternColumn {
                                    source: variable.0,
                                    source_ty: variable.1,
                                    pattern: patterns[index],
                                },
                            )
                        }
                    } else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn enum_pattern_rows(
    rows: Vec[PatternRow],
    source: string,
    constructor_name: string,
    variables: Vec[(string, tast::Type)],
) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = enum_pattern_row(row, source, constructor_name, variables) {
            result.push(value)
        }
    }
    result
}

fn enum_pattern_present(rows: Vec[PatternRow], source: string, constructor_name: string) -> bool {
    for row in rows {
        for column in row.columns {
            if column.source == source {
                if let Constr { constructor, args: _, ty: _ } = column.pattern {
                    if constructor.name == constructor_name {
                        return true
                    }
                }
            }
        }
    }
    false
}

fn pattern_default_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if pattern_row_has_source(row, source) {} else {
            result.push(row)
        }
    }
    result
}

fn pattern_row_has_source(row: PatternRow, source: string) -> bool {
    for column in row.columns {
        if column.source == source {
            return true
        }
    }
    false
}

fn lower_enum_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    definition: tast::EnumDef,
    type_args: Vec[tast::Type],
    ty: tast::Type,
) -> LowerExpr {
    let cases: Vec[PatternEnumCase] = Vec::new();
    for variant_index in 0..definition.variants.len() {
        let variant = definition.variants[variant_index];
        let constructor_name = definition.name + "::" + variant.name;
        let variables: Vec[(string, tast::Type)] = Vec::new();
        for field in tast::enum_variant_field_types(variant.fields) {
            variables.push(
                (gensym(ctx, "x"), tast::substitute_params(field, definition.generics, type_args)),
            )
        }
        if enum_pattern_present(rows, column.source, constructor_name) {
            cases.push(
                PatternEnumCase {
                    constructor: tast::Constructor {
                        name: constructor_name,
                        fields: Vec::new(),
                        is_struct: false,
                        tag: Option::Some(variant_index),
                    },
                    variables,
                    rows: enum_pattern_rows(rows, column.source, constructor_name, variables),
                },
            )
        }
    }
    let complete = cases.len() == definition.variants.len();
    let arms: Vec[LowerArm] = Vec::new();
    for case in cases {
        let args: Vec[LowerExpr] = Vec::new();
        let stmts: Vec[LowerLetStmt] = Vec::new();
        for index in 0..case.variables.len() {
            let variable = case.variables[index];
            args.push(LowerExpr::Var { name: variable.0, ty: variable.1 });
            stmts.push(
                LowerLetStmt {
                    name: variable.0,
                    value: LowerExpr::ConstrGet {
                        expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
                        constructor: case.constructor,
                        field_index: index,
                        ty: variable.1,
                    },
                    ty: variable.1,
                },
            )
        }
        let inner = lower_pattern_rows(ctx, case.rows, ty);
        let body = if stmts.is_empty() {
            inner
        } else {
            LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(inner) }, ty }
        };
        arms.push(
            LowerArm {
                lhs: LowerExpr::Constr { constructor: case.constructor, args, ty: column.source_ty },
                body,
            },
        )
    }
    let defaults = pattern_default_rows(rows, column.source);
    let default = if complete || defaults.is_empty() {
        Option::None
    } else {
        Option::Some(lower_pattern_rows(ctx, defaults, ty))
    };
    LowerExpr::Match {
        expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
        arms,
        default,
        ty,
    }
}

fn lower_bool_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> LowerExpr {
    let arms: Vec[LowerArm] = Vec::new();
    for expected in Vec::from_array([true, false]) {
        arms.push(
            LowerArm {
                lhs: bool_expr(expected),
                body: lower_pattern_rows(ctx, bool_pattern_rows(rows, column.source, expected), ty),
            },
        )
    }
    LowerExpr::Match {
        expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
        arms,
        default: Option::None,
        ty,
    }
}

fn unit_pattern_row(row: PatternRow, source: string) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value: Unit, ty: _ } => (),
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn unit_pattern_rows(rows: Vec[PatternRow], source: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = unit_pattern_row(row, source) {
            result.push(value)
        }
    }
    result
}

fn lower_unit_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> LowerExpr {
    let arms: Vec[LowerArm] = Vec::new();
    arms.push(
        LowerArm {
            lhs: LowerExpr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit },
            body: lower_pattern_rows(ctx, unit_pattern_rows(rows, column.source), ty),
        },
    );
    LowerExpr::Match {
        expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
        arms,
        default: Option::None,
        ty,
    }
}

fn primitive_pattern_key(value: tast::Primitive, ty: tast::Type) -> string {
    let builder = text::StringBuilder::new();
    tast::write_type(builder, ty);
    builder.write_char(':');
    tast::write_primitive(builder, value);
    builder.finish()
}

fn primitive_pattern_case_exists(values: Vec[PrimitivePatternCase], key: string) -> bool {
    for value in values {
        if value.key == key {
            return true
        }
    }
    false
}

fn primitive_pattern_cases(rows: Vec[PatternRow], source: string) -> Vec[PrimitivePatternCase] {
    let result: Vec[PrimitivePatternCase] = Vec::new();
    for row in rows {
        for column in row.columns {
            if column.source == source {
                if let Prim { value, ty } = column.pattern {
                    let key = primitive_pattern_key(value, ty);
                    if primitive_pattern_case_exists(result, key) {} else {
                        result.push(PrimitivePatternCase { key, value, ty })
                    }
                }
            }
        }
    }
    result
}

fn primitive_pattern_row(row: PatternRow, source: string, key: string) -> Option[PatternRow] {
    let columns: Vec[PatternColumn] = Vec::new();
    for column in row.columns {
        if column.source == source {
            match column.pattern {
                Prim { value, ty } => {
                    if primitive_pattern_key(value, ty) == key {} else {
                        return Option::None
                    }
                },
                _ => return Option::None,
            }
        } else {
            columns.push(column)
        }
    }
    Option::Some(PatternRow { columns, bindings: row.bindings, body: row.body })
}

fn primitive_pattern_rows(rows: Vec[PatternRow], source: string, key: string) -> Vec[PatternRow] {
    let result: Vec[PatternRow] = Vec::new();
    for row in rows {
        if let Some(value) = primitive_pattern_row(row, source, key) {
            result.push(value)
        }
    }
    result
}

fn lower_primitive_pattern_rows(
    ctx: Lowerer,
    rows: Vec[PatternRow],
    column: PatternColumn,
    ty: tast::Type,
) -> LowerExpr {
    let arms: Vec[LowerArm] = Vec::new();
    for case in primitive_pattern_cases(rows, column.source) {
        arms.push(
            LowerArm {
                lhs: LowerExpr::Prim { value: case.value, ty: case.ty },
                body: lower_pattern_rows(
                    ctx,
                    primitive_pattern_rows(rows, column.source, case.key),
                    ty,
                ),
            },
        )
    }
    let defaults = pattern_default_rows(rows, column.source);
    let default = if defaults.is_empty() {
        Option::None
    } else {
        Option::Some(lower_pattern_rows(ctx, defaults, ty))
    };
    LowerExpr::Match {
        expr: LowerExpr::Var { name: column.source, ty: column.source_ty },
        arms,
        default,
        ty,
    }
}

fn primitive_pattern_type(value: tast::Type) -> bool {
    match tast::resolve_type(value) {
        Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        _ => false,
    }
}

fn lower_pattern_rows(ctx: Lowerer, values: Vec[PatternRow], ty: tast::Type) -> LowerExpr {
    let rows = normalize_pattern_rows(values);
    if rows.is_empty() {
        missing_expr(ty)
    } else if rows[0].columns.is_empty() {
        lower_pattern_row_body(ctx, rows[0])
    } else {
        match branch_pattern_column(rows) {
            Some(column) => match expand_or_pattern_rows(rows, column.source) {
                Some(expanded) => lower_pattern_rows(ctx, expanded, ty),
                None => match nominal_parts(column.source_ty) {
                    Some((name, type_args)) => match find_enum(ctx, name) {
                        Some(definition) => lower_enum_pattern_rows(
                            ctx,
                            rows,
                            column,
                            definition,
                            type_args,
                            ty,
                        ),
                        None => match struct_place_details(ctx, column.source_ty) {
                            Some((constructor, fields)) => lower_struct_pattern_rows(
                                ctx,
                                rows,
                                column,
                                constructor,
                                fields,
                                ty,
                            ),
                            None => lower_pattern_row_body(ctx, rows[0]),
                        },
                    },
                    None => match tast::resolve_type(column.source_ty) {
                        Unit => lower_unit_pattern_rows(ctx, rows, column, ty),
                        Bool => lower_bool_pattern_rows(ctx, rows, column, ty),
                        Tuple { items: types } => {
                            lower_tuple_pattern_rows(ctx, rows, column, types, ty)
                        },
                        _ => if primitive_pattern_type(column.source_ty) {
                            lower_primitive_pattern_rows(ctx, rows, column, ty)
                        } else {
                            lower_pattern_row_body(ctx, rows[0])
                        },
                    },
                },
            },
            None => missing_expr(ty),
        }
    }
}

fn pattern_rows_from_arms(source: string, source_ty: tast::Type, arms: Vec[tast::Arm]) -> Option[
    Vec[PatternRow],
] {
    let rows: Vec[PatternRow] = Vec::new();
    for arm in arms {
        if pattern_contains_constant(arm.pat) {
            return Option::None
        }
        match arm.guard {
            Some(_) => return Option::None,
            None => {
                let columns: Vec[PatternColumn] = Vec::new();
                columns.push(PatternColumn { source, source_ty, pattern: arm.pat });
                rows.push(PatternRow { columns, bindings: Vec::new(), body: arm.body })
            },
        }
    }
    Option::Some(rows)
}
