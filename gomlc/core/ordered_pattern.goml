package core;

use module::ast;
use module::tast;

fn pattern_requires_ordered(value: tast::Pat) -> bool {
    match value {
        Constant { name: _, ty: _ } | Array { prefix: _, rest: _, suffix: _, ty: _ } | Alias {
            name: _,
            pat: _,
            ty: _,
        } | Range { start: _, end: _, inclusive: _, ty: _ } => true,
        Or { pats: patterns, ty: _ } => {
            for pattern in patterns {
                if pattern_requires_ordered(pattern) {
                    return true
                }
            }
            false
        },
        Constr { constructor: _, args: patterns, ty: _ } | Tuple { items: patterns, ty: _ } => {
            for pattern in patterns {
                if pattern_requires_ordered(pattern) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn arms_require_ordered(arms: Vec[tast::Arm]) -> bool {
    for arm in arms {
        match arm.guard {
            Some(_) => return true,
            None => if pattern_requires_ordered(arm.pat) {
                return true
            },
        }
    }
    false
}

fn ordered_int(value: isize) -> LowerExpr {
    LowerExpr::Prim {
        value: tast::Primitive::Int { value: value.to_string() },
        ty: tast::Type::Int,
    }
}

fn ordered_binary(op: ast::BinaryOp, left: LowerExpr, right: LowerExpr, ty: tast::Type) -> LowerExpr {
    LowerExpr::Binary { op, lhs: left, rhs: right, ty }
}

fn ordered_if(cond: LowerExpr, then_branch: LowerExpr, else_branch: LowerExpr, ty: tast::Type) -> LowerExpr {
    LowerExpr::If { cond, then_branch, else_branch, ty }
}

fn bind_ordered_value(name: string, value: LowerExpr, body: LowerExpr, ty: tast::Type) -> LowerExpr {
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(LowerLetStmt { name, ty: lower_expr_type(value), value });
    LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(body) }, ty }
}

fn ordered_len(value: LowerExpr, container_ty: tast::Type) -> Option[LowerExpr] {
    match tast::resolve_type(container_ty) {
        Array { len: length, elem: _ } => Option::Some(ordered_int(length)),
        VecType { elem: _ } => {
            let params: Vec[tast::Type] = Vec::new();
            params.push(container_ty);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(value);
            Option::Some(place_intrinsic_call("vec.len", params, tast::Type::Int, args))
        },
        Slice { elem: _ } => {
            let params: Vec[tast::Type] = Vec::new();
            params.push(container_ty);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(value);
            Option::Some(place_intrinsic_call("slice.len", params, tast::Type::Int, args))
        },
        MutSlice { elem: _ } => {
            let params: Vec[tast::Type] = Vec::new();
            params.push(container_ty);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(value);
            Option::Some(place_intrinsic_call("mut_slice.len", params, tast::Type::Int, args))
        },
        _ => Option::None,
    }
}

fn ordered_container_parts(container_ty: tast::Type) -> Option[(tast::Type, Option[isize])] {
    match tast::resolve_type(container_ty) {
        Array { len: length, elem } => Option::Some((elem, Option::Some(length))),
        VecType { elem } | Slice { elem } | MutSlice { elem } => {
            Option::Some((elem, Option::None))
        },
        _ => Option::None,
    }
}

fn ordered_rest_value(
    value: LowerExpr,
    container_ty: tast::Type,
    elem_ty: tast::Type,
    fixed_len: Option[isize],
    prefix_len: isize,
    suffix_len: isize,
    len_expr: LowerExpr,
    rest_ty: tast::Type,
) -> LowerExpr {
    match tast::resolve_type(container_ty) {
        Array { len: _, elem: _ } => {
            let items: Vec[LowerExpr] = Vec::new();
            let end = match fixed_len {
                Some(length) => length - suffix_len,
                None => prefix_len,
            };
            for index in prefix_len..end {
                items.push(place_index_read(value, container_ty, ordered_int(index), elem_ty))
            }
            LowerExpr::Array { items, ty: rest_ty }
        },
        VecType { elem: _ } => {
            let end = if suffix_len == 0 {
                len_expr
            } else {
                ordered_binary(
                    ast::BinaryOp::Sub,
                    len_expr,
                    ordered_int(suffix_len),
                    tast::Type::Int,
                )
            };
            let params: Vec[tast::Type] = Vec::new();
            params.push(container_ty);
            params.push(tast::Type::Int);
            params.push(tast::Type::Int);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(value);
            args.push(ordered_int(prefix_len));
            args.push(end);
            place_intrinsic_call("slice.new", params, rest_ty, args)
        },
        Slice { elem: _ } => {
            let end = if suffix_len == 0 {
                len_expr
            } else {
                ordered_binary(
                    ast::BinaryOp::Sub,
                    len_expr,
                    ordered_int(suffix_len),
                    tast::Type::Int,
                )
            };
            let params: Vec[tast::Type] = Vec::new();
            params.push(container_ty);
            params.push(tast::Type::Int);
            params.push(tast::Type::Int);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(value);
            args.push(ordered_int(prefix_len));
            args.push(end);
            place_intrinsic_call("slice.sub", params, rest_ty, args)
        },
        MutSlice { elem: _ } => {
            let end = if suffix_len == 0 {
                len_expr
            } else {
                ordered_binary(
                    ast::BinaryOp::Sub,
                    len_expr,
                    ordered_int(suffix_len),
                    tast::Type::Int,
                )
            };
            let read_ty = tast::Type::Slice { elem: elem_ty };
            let read_params: Vec[tast::Type] = Vec::new();
            read_params.push(container_ty);
            let read_args: Vec[LowerExpr] = Vec::new();
            read_args.push(value);
            let read = place_intrinsic_call("mut_slice.as_slice", read_params, read_ty, read_args);
            let params: Vec[tast::Type] = Vec::new();
            params.push(read_ty);
            params.push(tast::Type::Int);
            params.push(tast::Type::Int);
            let args: Vec[LowerExpr] = Vec::new();
            args.push(read);
            args.push(ordered_int(prefix_len));
            args.push(end);
            place_intrinsic_call("slice.sub", params, rest_ty, args)
        },
        _ => missing_expr(rest_ty),
    }
}

fn ordered_suffix_index(
    fixed_len: Option[isize],
    len_expr: LowerExpr,
    suffix_len: isize,
    offset: isize,
) -> LowerExpr {
    match fixed_len {
        Some(length) => ordered_int(length - suffix_len + offset),
        None => ordered_binary(
            ast::BinaryOp::Add,
            ordered_binary(ast::BinaryOp::Sub, len_expr, ordered_int(suffix_len), tast::Type::Int),
            ordered_int(offset),
            tast::Type::Int,
        ),
    }
}

fn lower_ordered_array_pattern(
    ctx: Lowerer,
    prefix: Vec[tast::Pat],
    rest: Option[tast::ArrayPatRest],
    suffix: Vec[tast::Pat],
    container_ty: tast::Type,
    value: LowerExpr,
    success: LowerExpr,
    failure: LowerExpr,
    result_ty: tast::Type,
) -> LowerExpr {
    match ordered_container_parts(container_ty) {
        Some((elem_ty, fixed_len)) => match ordered_len(value, container_ty) {
            Some(len_expr) => {
                let mut next = success;
                if let Some(rest_value) = rest {
                    if let Some(binding) = rest_value.binding {
                        next = bind_ordered_value(
                            binding,
                            ordered_rest_value(
                                value,
                                container_ty,
                                elem_ty,
                                fixed_len,
                                prefix.len(),
                                suffix.len(),
                                len_expr,
                                rest_value.ty,
                            ),
                            next,
                            result_ty,
                        );
                    }
                }
                for offset in 0..suffix.len() {
                    let index = suffix.len() - 1 - offset;
                    let item = place_index_read(
                        value,
                        container_ty,
                        ordered_suffix_index(fixed_len, len_expr, suffix.len(), index),
                        elem_ty,
                    );
                    next = lower_ordered_pattern(ctx, suffix[index], item, next, failure, result_ty);
                }
                for offset in 0..prefix.len() {
                    let index = prefix.len() - 1 - offset;
                    let item = place_index_read(value, container_ty, ordered_int(index), elem_ty);
                    next = lower_ordered_pattern(ctx, prefix[index], item, next, failure, result_ty);
                }
                match fixed_len {
                    Some(_) => next,
                    None => {
                        let op = match rest {
                            Some(_) => ast::BinaryOp::GreaterEq,
                            None => ast::BinaryOp::Eq,
                        };
                        ordered_if(
                            ordered_binary(
                                op,
                                len_expr,
                                ordered_int(prefix.len() + suffix.len()),
                                tast::Type::Bool,
                            ),
                            next,
                            failure,
                            result_ty,
                        )
                    },
                }
            },
            None => failure,
        },
        None => failure,
    }
}

fn lower_ordered_pattern(
    ctx: Lowerer,
    pattern: tast::Pat,
    value: LowerExpr,
    success: LowerExpr,
    failure: LowerExpr,
    result_ty: tast::Type,
) -> LowerExpr {
    match pattern {
        Wild { ty: _ } => success,
        Var { name, is_mut: _, ty: _ } => bind_ordered_value(name, value, success, result_ty),
        Alias { name, pat: inner, ty } => {
            let matched = lower_ordered_pattern(
                ctx,
                inner,
                LowerExpr::Var { name, ty },
                success,
                failure,
                result_ty,
            );
            bind_ordered_value(name, value, matched, result_ty)
        },
        Or { pats: patterns, ty: _ } => {
            let mut next = failure;
            for offset in 0..patterns.len() {
                let index = patterns.len() - 1 - offset;
                next = lower_ordered_pattern(ctx, patterns[index], value, success, next, result_ty);
            }
            next
        },
        Constant { name, ty } => ordered_if(
            ordered_binary(ast::BinaryOp::Eq, value, LowerExpr::Var { name, ty }, tast::Type::Bool),
            success,
            failure,
            result_ty,
        ),
        Prim { value: expected, ty } => ordered_if(
            ordered_binary(
                ast::BinaryOp::Eq,
                value,
                LowerExpr::Prim { value: expected, ty },
                tast::Type::Bool,
            ),
            success,
            failure,
            result_ty,
        ),
        Range { start, end, inclusive, ty } => {
            let upper_op = if inclusive {
                ast::BinaryOp::LessEq
            } else {
                ast::BinaryOp::Less
            };
            let upper = ordered_if(
                ordered_binary(
                    upper_op,
                    value,
                    LowerExpr::Prim { value: end, ty },
                    tast::Type::Bool,
                ),
                success,
                failure,
                result_ty,
            );
            ordered_if(
                ordered_binary(
                    ast::BinaryOp::GreaterEq,
                    value,
                    LowerExpr::Prim { value: start, ty },
                    tast::Type::Bool,
                ),
                upper,
                failure,
                result_ty,
            )
        },
        Tuple { items, ty: tuple_ty } => match tast::resolve_type(tuple_ty) {
            Tuple { items: types } => {
                let mut next = success;
                for offset in 0..items.len() {
                    let index = items.len() - 1 - offset;
                    next = lower_ordered_pattern(
                        ctx,
                        items[index],
                        LowerExpr::Proj { tuple: value, index, ty: types[index] },
                        next,
                        failure,
                        result_ty,
                    );
                }
                next
            },
            _ => failure,
        },
        Constr { constructor, args, ty: pattern_ty } => {
            let mut next = success;
            for offset in 0..args.len() {
                let index = args.len() - 1 - offset;
                let arg = args[index];
                next = lower_ordered_pattern(
                    ctx,
                    arg,
                    LowerExpr::ConstrGet {
                        expr: value,
                        constructor,
                        field_index: index,
                        ty: tast::pat_type(arg),
                    },
                    next,
                    failure,
                    result_ty,
                );
            }
            if constructor.is_struct {
                next
            } else {
                let lhs_args: Vec[LowerExpr] = Vec::new();
                for arg in args {
                    lhs_args.push(
                        LowerExpr::Var { name: gensym(ctx, "p"), ty: tast::pat_type(arg) },
                    )
                }
                let arms: Vec[LowerArm] = Vec::new();
                arms.push(
                    LowerArm {
                        lhs: LowerExpr::Constr { constructor, args: lhs_args, ty: pattern_ty },
                        body: next,
                    },
                );
                LowerExpr::Match {
                    expr: value,
                    arms,
                    default: Option::Some(failure),
                    ty: result_ty,
                }
            }
        },
        Array { prefix, rest, suffix, ty: container_ty } => {
            lower_ordered_array_pattern(
                ctx,
                prefix,
                rest,
                suffix,
                container_ty,
                value,
                success,
                failure,
                result_ty,
            )
        },
    }
}

fn lower_ordered_match(ctx: Lowerer, source: tast::Expr, arms: Vec[tast::Arm], ty: tast::Type) -> LowerExpr {
    let source_ty = tast::expr_type(source);
    let source_value = lower_expr(ctx, source);
    let source_name = gensym(ctx, "match");
    let source_var = LowerExpr::Var { name: source_name, ty: source_ty };
    let mut next = missing_expr(ty);
    for offset in 0..arms.len() {
        let index = arms.len() - 1 - offset;
        let arm = arms[index];
        let body = lower_expr(ctx, arm.body);
        let success = match arm.guard {
            Some(guard) => ordered_if(lower_expr(ctx, guard), body, next, ty),
            None => body,
        };
        next = lower_ordered_pattern(ctx, arm.pat, source_var, success, next, ty);
    }
    bind_ordered_value(source_name, source_value, next, ty)
}
