package core;

use module::ast;

pub enum Primitive {
    Unit,
    Bool { value: bool },
    Int { value: string },
    Int8 { value: string },
    Int16 { value: string },
    Int32 { value: string },
    Int64 { value: string },
    Uint { value: string },
    Uint8 { value: string },
    Uint16 { value: string },
    Uint32 { value: string },
    Uint64 { value: string },
    Float { value: string },
    Float32 { value: string },
    Float64 { value: string },
    String { value: string },
    Char { value: char },
    Bytes { values: Vec[string] },
}

pub struct Constructor {
    pub name: string,
    pub fields: Vec[string],
    pub is_struct: bool,
    pub tag: Option[isize],
}

pub enum TypePredicate {
    GoComparable(Type),
    Trait {
        for_ty: Type,
        trait_ref: TraitRef,
    },
    Equality {
        lhs: Type,
        rhs: Type,
    },
}

pub enum Callable {
    GoInterfaceBridge {
        binding: string,
        methods: Vec[string],
    },
    Function(string),
    FunctionInstance {
        name: string,
        bindings: Vec[(string, Type)],
    },
    LangItem {
        item: string,
        function_name: string,
    },
    Runtime(string),
    Intrinsic(string),
    GoMethod {
        binding: string,
        symbol: string,
    },
    GoForeign {
        binding: string,
        import_path: string,
        symbol: string,
    },
    TraitMethod {
        trait_ref: TraitRef,
        method_name: string,
        for_ty: Type,
        has_receiver: bool,
    },
    DynTraitMethod {
        trait_name: string,
        dispatch_name: string,
        method_name: string,
    },
    InherentMethod {
        receiver_ty: Type,
        method_name: string,
    },
}

pub struct ClosureParam {
    pub name: string,
    pub ty: Type,
}

pub enum ConstExpr {
    Prim {
        value: Primitive,
        ty: Type,
    },
    Ref {
        name: string,
        ty: Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: ConstExpr,
        ty: Type,
    },
    Cast {
        expr: ConstExpr,
        ty: Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: ConstExpr,
        rhs: ConstExpr,
        ty: Type,
    },
    Tuple {
        items: Vec[ConstExpr],
        ty: Type,
    },
    Array {
        items: Vec[ConstExpr],
        ty: Type,
    },
    Constr {
        constructor: Constructor,
        args: Vec[ConstExpr],
        ty: Type,
    },
    Error {
        ty: Type,
    },
}

pub struct Constant {
    pub name: string,
    pub ty: Type,
    pub value: ConstExpr,
}

pub struct Static {
    pub name: string,
    pub ty: Type,
}

pub struct EnumVariantDef {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[Type]),
    Struct(Vec[(string, Type)]),
}

pub fn enum_variant_field_types(value: EnumVariantFields) -> Vec[Type] {
    match value {
        Unit => Vec::new(),
        Tuple(values) => values,
        Struct(fields) => {
            let result: Vec[Type] = Vec::with_capacity(fields.len());
            for field in fields {
                result.push(field.1)
            }
            result
        },
    }
}

pub struct EnumDef {
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariantDef],
    pub option_variants: Option[(string, string)],
}

pub struct StructDef {
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, Type)],
    pub public_fields: Vec[string],
    pub has_hidden_fields: bool,
}
