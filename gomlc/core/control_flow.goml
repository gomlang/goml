package core;

use module::tast;

fn tast_exprs_exit(values: Vec[tast::Expr]) -> bool {
    for value in values {
        if tast_expr_exits(value) {
            return true
        }
    }
    false
}

fn tast_stmt_exits(value: tast::Stmt) -> bool {
    match value {
        Expr { expr } => tast_expr_exits(expr),
        Defer { expr: _ } | Let { is_mut: _, pat: _, value: _ } | LetElse {
            is_mut: _,
            pat: _,
            value: _,
            else_branch: _,
        } | Assign { target: _, op: _, value: _ } => false,
    }
}

fn tast_block_exits(value: tast::Block) -> bool {
    for stmt in value.stmts {
        if tast_stmt_exits(stmt) {
            return true
        }
    }
    match value.tail {
        Some(tail) => tast_expr_exits(tail),
        None => false,
    }
}

fn tast_match_arms_exit(arms: Vec[tast::Arm]) -> bool {
    for arm in arms {
        if !tast_expr_exits(arm.body) {
            return false
        }
    }
    true
}

fn tast_expr_exits(value: tast::Expr) -> bool {
    match value {
        Break { ty: _, .. } | Continue { ty: _, .. } | Return { expr: _, ty: _ } => true,
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => tast_exprs_exit(args),
        Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Go { expr, ty: _ } | Field {
            expr,
            field_name: _,
            ty: _,
        } => tast_expr_exits(expr),
        Call { func: function, args, ty: _ } => {
            tast_expr_exits(function) || tast_exprs_exit(args)
        },
        Proj { tuple, index: _, ty: _ } => tast_expr_exits(tuple),
        Index { base, index, ty: _ } => {
            tast_expr_exits(base) || tast_expr_exits(index)
        },
        Binary { op, lhs: left, rhs: right, ty: _, resolution: _ } => {
            tast_expr_exits(left)
                || match op {
                    And | Or => false,
                    _ => tast_expr_exits(right),
                }
        },
        Block { block, ty: _ } => tast_block_exits(block),
        If { cond: _, then_branch, else_branch, ty: _ } => {
            tast_expr_exits(then_branch) && tast_expr_exits(else_branch)
        },
        While { cond, body: _, ty: _ } => tast_expr_exits(cond),
        Loop { body: _, ty } => match tast::resolve_type(ty) {
            Never => true,
            _ => false,
        },
        For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body: _,
            ty: _,
        } => tast_expr_exits(iterator),
        Match { expr: _, arms, ty: _, .. } => tast_match_arms_exit(arms),
        _ => false,
    }
}

fn exit_expr_as(ctx: Lowerer, value: LowerExpr, ty: tast::Type) -> LowerExpr {
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(LowerLetStmt { name: gensym(ctx, "_wild"), ty: lower_expr_type(value), value });
    LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(missing_expr(ty)) }, ty }
}
