package core;

use module::ffi;

pub struct ExternalTypeApplication {
    pub function_name: string,
    pub declaration: ffi::TypeDeclarationQuery,
    pub arguments: Vec[Type],
}

pub fn validate_external_applications(value: File, applications: Vec[ExternalTypeApplication]) -> Result[
    (),
    string,
] {
    for application in applications {
        if application.declaration.type_id == ""
            || !ffi::named_bridge_identity_valid(
                application.declaration.import_path,
                application.declaration.name,
            ) {
            return Result::Err("invalid external application declaration")
        }
        for argument in application.arguments {
            if type_contains_error(argument) {
                return Result::Err("invalid external application argument")
            }
        }
        let mut found = false;
        for function in value.functions {
            if function.name == application.function_name {
                found = true;
                let parameters = Vec::new();
                for parameter in function.generics {
                    parameters.push(parameter)
                }
                for (_, ty) in function.params {
                    for parameter in type_parameters(ty) {
                        parameters.push(parameter)
                    }
                }
                for parameter in type_parameters(function.ret_ty) {
                    parameters.push(parameter)
                }
                for argument in application.arguments {
                    for parameter in type_parameters(argument) {
                        if !parameters.contains(parameter) {
                            return Result::Err(
                                "unknown external application parameter " + parameter + " in "
                                    + function.name,
                            )
                        }
                    }
                }
            }
        }
        if !found {
            return Result::Err("missing external application owner " + application.function_name)
        }
    }
    Result::Ok(())
}
