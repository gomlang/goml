package core;

use module::consts;
use module::ast;
use module::tast;

pub fn const_type_value(value: Type) -> Option[isize] {
    match resolve_type(value) {
        Con { name } => consts::value_number(name),
        _ => Option::None,
    }
}

pub fn const_application(base: Type, args: Vec[Type]) -> Type {
    if let Con { name } = base {
        if name == "$array" && args.len() == 2 {
            if let Some(len) = const_type_value(args[0]) {
                if len >= 0 {
                    return Type::Array { len, elem: args[1] }
                }
            }
        } else if name.starts_with("$const_op:") && args.len() == 2 {
            if let (Some(left), Some(right)) = (
                const_type_value(args[0]),
                const_type_value(args[1]),
            ) {
                if let Ok(value) = consts::binary(name.byte_slice(10, name.byte_len()), left, right) {
                    return Type::Con { name: consts::value_name(value) }
                }
            }
        }
    }
    Type::App { ty: base, args }
}

pub fn symbolic_array(value: Type) -> Option[(Type, Type)] {
    match resolve_type(value) {
        App { ty, args } => match ty {
            Con { name } if name == "$array" && args.len() == 2 => Option::Some((args[0], args[1])),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn const_binary_operator(op: string) -> ast::BinaryOp {
    match op {
        "+" => ast::BinaryOp::Add,
        "-" => ast::BinaryOp::Sub,
        "*" => ast::BinaryOp::Mul,
        "/" => ast::BinaryOp::Div,
        "%" => ast::BinaryOp::Rem,
        "&" => ast::BinaryOp::BitAnd,
        "|" => ast::BinaryOp::BitOr,
        "^" => ast::BinaryOp::BitXor,
        "<<" => ast::BinaryOp::Shl,
        _ => ast::BinaryOp::Shr,
    }
}

fn lower_const_length(value: tast::Type) -> LowerExpr {
    match tast::resolve_type(value) {
        Con { name } => ordered_int(consts::value_number(name).unwrap_or(0)),
        Param { name } => LowerExpr::Cast {
            expr: LowerExpr::Var { name, ty: tast::Type::Uint },
            ty: tast::Type::Int,
        },
        App { ty: tast::Type::Con { name }, args } if name.starts_with("$const_op:")
            && args.len() == 2 => LowerExpr::Binary {
            op: const_binary_operator(name.byte_slice(10, name.byte_len())),
            lhs: lower_const_length(args[0]),
            rhs: lower_const_length(args[1]),
            ty: tast::Type::Int,
        },
        _ => ordered_int(0),
    }
}
