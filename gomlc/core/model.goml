package core;

use module::ast;

pub struct File {
    pub functions: Vec[Function],
    pub enums: Vec[EnumDef],
    pub structs: Vec[StructDef],
    pub type_instances: Vec[TypeInstance],
    pub constants: Vec[Constant],
    pub statics: Vec[Static],
}

pub struct TypeInstance {
    pub base_name: string,
    pub args: Vec[Type],
    pub name: string,
}

pub struct Function {
    pub name: string,
    pub origin: FunctionOrigin,
    pub root: bool,
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub trait_impl: Option[TraitImpl],
    pub params: Vec[(string, Type)],
    pub ret_ty: Type,
    pub body: Block,
}

pub enum FunctionOrigin {
    Source,
    Inherent {
        owner: Type,
        method_name: string,
    },
    TraitImplementation {
        method_name: string,
    },
}

pub struct TraitImpl {
    pub trait_ref: TraitRef,
    pub for_ty: Type,
    pub associated_types: Vec[(string, Type)],
    pub generic_count: isize,
    pub predicate_count: isize,
}

pub struct LetStmt {
    pub name: string,
    pub value: Expr,
    pub ty: Type,
}

pub struct Block {
    pub stmts: Vec[LetStmt],
    pub tail: Option[Expr],
}

pub enum SelectArm {
    Receive {
        channel: Expr,
        guard: Option[Expr],
        binding: string,
        binding_ty: Type,
        body: Expr,
    },
    Send {
        channel: Expr,
        value: Expr,
        guard: Option[Expr],
        body: Expr,
    },
}

pub enum Expr {
    Var {
        name: string,
        ty: Type,
    },
    Callable {
        callable: Callable,
        ty: Type,
    },
    Prim {
        value: Primitive,
        ty: Type,
    },
    Constr {
        constructor: Constructor,
        args: Vec[Expr],
        ty: Type,
    },
    Tuple {
        items: Vec[Expr],
        ty: Type,
    },
    Array {
        items: Vec[Expr],
        ty: Type,
    },
    Closure {
        params: Vec[ClosureParam],
        body: Expr,
        ty: Type,
    },
    Block {
        block: Block,
        ty: Type,
    },
    Match {
        expr: Expr,
        arms: Vec[Arm],
        default: Option[Expr],
        ty: Type,
    },
    Select {
        mode: ast::SelectMode,
        arms: Vec[SelectArm],
        default: Option[Expr],
        ty: Type,
    },
    If {
        cond: Expr,
        then_branch: Expr,
        else_branch: Expr,
        ty: Type,
    },
    While {
        cond: Expr,
        body: Expr,
        ty: Type,
    },
    Loop {
        body: Expr,
        ty: Type,
    },
    Break {
        target: isize,
        value: Option[Expr],
        ty: Type,
    },
    Continue {
        target: isize,
        ty: Type,
    },
    Return {
        expr: Option[Expr],
        ty: Type,
    },
    Go {
        expr: Expr,
        ty: Type,
    },
    ConstrGet {
        expr: Expr,
        constructor: Constructor,
        field_index: isize,
        ty: Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: Expr,
        ty: Type,
    },
    Cast {
        expr: Expr,
        ty: Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: Expr,
        rhs: Expr,
        ty: Type,
    },
    Assign {
        name: string,
        value: Expr,
        target_ty: Type,
        ty: Type,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
        ty: Type,
    },
    ToDyn {
        trait_name: string,
        for_ty: Type,
        expr: Expr,
        ty: Type,
    },
    DynCall {
        trait_name: string,
        method_name: string,
        receiver: Expr,
        args: Vec[Expr],
        ty: Type,
    },
    TraitCall {
        trait_ref: TraitRef,
        method_name: string,
        instance_name: Option[string],
        for_ty: Type,
        receiver: Option[Expr],
        args: Vec[Expr],
        ty: Type,
    },
    Proj {
        tuple: Expr,
        index: isize,
        ty: Type,
    },
}

pub struct Arm {
    pub lhs: Expr,
    pub body: Expr,
}

pub fn expr_type(value: Expr) -> Type {
    match value {
        Var { ty, .. } | Callable { ty, .. } | Prim { ty, .. } | Constr { ty, .. } | Tuple {
            ty,
            ..,
        } | Array { ty, .. } | Closure { ty, .. } | Block { ty, .. } | Match { ty, .. } | Select {
            ty,
            ..,
        } | If { ty, .. } | While { ty, .. } | Loop { ty, .. } | Break { ty, .. } | Continue {
            ty,
            ..,
        } | Return { ty, .. } | Go { ty, .. } | ConstrGet { ty, .. } | Unary { ty, .. } | Cast {
            ty,
            ..,
        } | Binary { ty, .. } | Assign { ty, .. } | Call { ty, .. } | ToDyn { ty, .. } | DynCall {
            ty,
            ..,
        } | TraitCall { ty, .. } | Proj { ty, .. } => ty,
    }
}
