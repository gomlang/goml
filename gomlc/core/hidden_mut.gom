package core;

use module::tast;
use std::collections;

fn push_name(values: collections::IndexSet[string], value: string) -> () {
    let _ = values.insert(value);
}

fn push_mutable(values: collections::IndexMap[string, tast::Type], name: string, ty: tast::Type) -> () {
    if !values.contains(name) {
        let _ = values.insert(name, ty);
    }
}

fn collect_mutable_exprs(values: Vec[tast::Expr], result: collections::IndexMap[string, tast::Type]) -> () {
    for value in values {
        collect_mutable_expr(value, result)
    }
}

fn collect_mutable_block(value: tast::Block, result: collections::IndexMap[string, tast::Type]) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_mutable_expr(expr, result),
            Let { is_mut, pat: pattern, value: expr } => {
                collect_mutable_pattern(pattern, is_mut, result);
                collect_mutable_expr(expr, result)
            },
            LetElse { is_mut, pat: pattern, value: expr, else_branch } => {
                collect_mutable_pattern(pattern, is_mut, result);
                collect_mutable_expr(expr, result);
                collect_mutable_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_mutable_expr(target, result);
                collect_mutable_expr(expr, result)
            },
            Expr { expr } => collect_mutable_expr(expr, result),
        }
    }
    if let Some(expr) = value.tail {
        collect_mutable_expr(expr, result)
    }
}

fn collect_mutable_expr(value: tast::Expr, result: collections::IndexMap[string, tast::Type]) -> () {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_mutable_expr(expr, result)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_mutable_exprs(args, result),
        Closure { params: _, body, ty: _ } => collect_mutable_expr(body, result),
        Block { block, ty: _ } => collect_mutable_block(block, result),
        Comptime { body, .. } => collect_mutable_expr(body, result),
        Match { expr: source, arms, ty: _, .. } => {
            collect_mutable_expr(source, result);
            for arm in arms {
                collect_mutable_pattern(arm.pat, false, result);
                if let Some(guard) = arm.guard {
                    collect_mutable_expr(guard, result)
                }
                collect_mutable_expr(arm.body, result)
            }
        },
        Select { arms, .. } => for arm in arms {
            match arm {
                Receive { channel, guard, binding: _, binding_ty: _, body } => {
                    collect_mutable_expr(channel, result);
                    if let Some(value) = guard {
                        collect_mutable_expr(value, result)
                    }
                    collect_mutable_expr(body, result)
                },
                Send { channel, value, guard, body } => {
                    collect_mutable_expr(channel, result);
                    collect_mutable_expr(value, result);
                    if let Some(value) = guard {
                        collect_mutable_expr(value, result)
                    }
                    collect_mutable_expr(body, result)
                },
                Default { body } => collect_mutable_expr(body, result),
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(then_branch, result);
            collect_mutable_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_mutable_expr(cond, result);
            collect_mutable_expr(body, result)
        },
        Loop { body, ty: _ } => collect_mutable_expr(body, result),
        For {
            pat,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_mutable_pattern(pat, false, result);
            collect_mutable_expr(iterator, result);
            collect_mutable_expr(body, result)
        },
        Return { expr, ty: _ } => if let Some(value) = expr {
            collect_mutable_expr(value, result)
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_mutable_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_mutable_expr(function, result);
            collect_mutable_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_mutable_expr(base, result);
            collect_mutable_expr(index, result)
        },
    }
}

fn collect_mutable_pattern(
    value: tast::Pat,
    inherited: bool,
    result: collections::IndexMap[string, tast::Type],
) -> () {
    match value {
        Var { name, is_mut, ty } => if inherited || is_mut {
            push_mutable(result, name, ty)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Or {
            pats: args,
            ty: _,
        } => for arg in args {
            collect_mutable_pattern(arg, inherited, result)
        },
        Array { prefix, rest, suffix, ty: _ } => {
            for item in prefix {
                collect_mutable_pattern(item, inherited, result)
            }
            if let Some(value) = rest {
                if let Some(name) = value.binding {
                    if inherited {
                        push_mutable(result, name, value.ty)
                    }
                }
            }
            for item in suffix {
                collect_mutable_pattern(item, inherited, result)
            }
        },
        Alias { name, pat, ty } => {
            if inherited {
                push_mutable(result, name, ty)
            }
            collect_mutable_pattern(pat, inherited, result)
        },
        Constant { name: _, ty: _ } | Prim { value: _, ty: _ } | Range {
            start: _,
            end: _,
            inclusive: _,
            ty: _,
        } | Wild { ty: _ } => (),
    }
}

fn collect_pattern_names(value: tast::Pat, result: collections::IndexSet[string]) -> () {
    match value {
        Var { name, is_mut: _, ty: _ } => push_name(result, name),
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Or {
            pats: args,
            ty: _,
        } => {
            for arg in args {
                collect_pattern_names(arg, result)
            }
        },
        Array { prefix, rest, suffix, ty: _ } => {
            for item in prefix {
                collect_pattern_names(item, result)
            }
            if let Some(value) = rest {
                if let Some(name) = value.binding {
                    push_name(result, name)
                }
            }
            for item in suffix {
                collect_pattern_names(item, result)
            }
        },
        Alias { name, pat: pattern, ty: _ } => {
            push_name(result, name);
            collect_pattern_names(pattern, result)
        },
        Constant { name: _, ty: _ } | Prim { value: _, ty: _ } | Range {
            start: _,
            end: _,
            inclusive: _,
            ty: _,
        } | Wild { ty: _ } => (),
    }
}

fn collect_bound_exprs(values: Vec[tast::Expr], result: collections::IndexSet[string]) -> () {
    for value in values {
        collect_bound_expr(value, result)
    }
}

fn collect_bound_block(value: tast::Block, result: collections::IndexSet[string]) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_bound_expr(expr, result),
            Let { is_mut: _, pat: pattern, value: expr } => {
                collect_pattern_names(pattern, result);
                collect_bound_expr(expr, result)
            },
            LetElse { is_mut: _, pat: pattern, value: expr, else_branch } => {
                collect_pattern_names(pattern, result);
                collect_bound_expr(expr, result);
                collect_bound_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_bound_expr(target, result);
                collect_bound_expr(expr, result)
            },
            Expr { expr } => collect_bound_expr(expr, result),
        }
    }
    if let Some(expr) = value.tail {
        collect_bound_expr(expr, result)
    }
}

fn collect_bound_expr(value: tast::Expr, result: collections::IndexSet[string]) -> () {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Closure {
            params: _,
            body: _,
            ty: _,
        } | Continue { ty: _, .. } => (),
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_bound_expr(expr, result)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_bound_exprs(args, result),
        Block { block, ty: _ } => collect_bound_block(block, result),
        Comptime { body, .. } => collect_bound_expr(body, result),
        Match { expr: source, arms, ty: _, .. } => {
            collect_bound_expr(source, result);
            for arm in arms {
                collect_pattern_names(arm.pat, result);
                if let Some(guard) = arm.guard {
                    collect_bound_expr(guard, result)
                }
                collect_bound_expr(arm.body, result)
            }
        },
        Select { arms, .. } => for arm in arms {
            match arm {
                Receive { channel, guard, binding, binding_ty: _, body } => {
                    push_name(result, binding);
                    collect_bound_expr(channel, result);
                    if let Some(value) = guard {
                        collect_bound_expr(value, result)
                    }
                    collect_bound_expr(body, result)
                },
                Send { channel, value, guard, body } => {
                    collect_bound_expr(channel, result);
                    collect_bound_expr(value, result);
                    if let Some(value) = guard {
                        collect_bound_expr(value, result)
                    }
                    collect_bound_expr(body, result)
                },
                Default { body } => collect_bound_expr(body, result),
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_bound_expr(cond, result);
            collect_bound_expr(then_branch, result);
            collect_bound_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_bound_expr(cond, result);
            collect_bound_expr(body, result)
        },
        Loop { body, ty: _ } => collect_bound_expr(body, result),
        For {
            pat: pattern,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_pattern_names(pattern, result);
            collect_bound_expr(iterator, result);
            collect_bound_expr(body, result)
        },
        Return { expr, ty: _ } => if let Some(value) = expr {
            collect_bound_expr(value, result)
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_bound_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_bound_expr(function, result);
            collect_bound_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_bound_expr(base, result);
            collect_bound_expr(index, result)
        },
    }
}

fn collect_reference_exprs(values: Vec[tast::Expr], result: collections::IndexSet[string]) -> () {
    for value in values {
        collect_reference_expr(value, result)
    }
}

fn collect_reference_block(value: tast::Block, result: collections::IndexSet[string]) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_reference_expr(expr, result),
            Let { is_mut: _, pat: _, value: expr } => collect_reference_expr(expr, result),
            LetElse { is_mut: _, pat: _, value: expr, else_branch } => {
                collect_reference_expr(expr, result);
                collect_reference_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_reference_expr(target, result);
                collect_reference_expr(expr, result)
            },
            Expr { expr } => collect_reference_expr(expr, result),
        }
    }
    if let Some(expr) = value.tail {
        collect_reference_expr(expr, result)
    }
}

fn collect_reference_expr(value: tast::Expr, result: collections::IndexSet[string]) -> () {
    match value {
        Var { name, ty: _ } => push_name(result, name),
        Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Closure {
            params: _,
            body: _,
            ty: _,
        } | Continue { ty: _, .. } => (),
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_reference_expr(expr, result)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_reference_exprs(args, result),
        Block { block, ty: _ } => collect_reference_block(block, result),
        Comptime { body, .. } => collect_reference_expr(body, result),
        Match { expr: source, arms, ty: _, .. } => {
            collect_reference_expr(source, result);
            for arm in arms {
                if let Some(guard) = arm.guard {
                    collect_reference_expr(guard, result)
                }
                collect_reference_expr(arm.body, result)
            }
        },
        Select { arms, .. } => for arm in arms {
            match arm {
                Receive { channel, guard, binding: _, binding_ty: _, body } => {
                    collect_reference_expr(channel, result);
                    if let Some(value) = guard {
                        collect_reference_expr(value, result)
                    }
                    collect_reference_expr(body, result)
                },
                Send { channel, value, guard, body } => {
                    collect_reference_expr(channel, result);
                    collect_reference_expr(value, result);
                    if let Some(value) = guard {
                        collect_reference_expr(value, result)
                    }
                    collect_reference_expr(body, result)
                },
                Default { body } => collect_reference_expr(body, result),
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_reference_expr(cond, result);
            collect_reference_expr(then_branch, result);
            collect_reference_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_reference_expr(cond, result);
            collect_reference_expr(body, result)
        },
        Loop { body, ty: _ } => collect_reference_expr(body, result),
        For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_reference_expr(iterator, result);
            collect_reference_expr(body, result)
        },
        Return { expr, ty: _ } => if let Some(value) = expr {
            collect_reference_expr(value, result)
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_reference_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_reference_expr(function, result);
            collect_reference_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_reference_expr(base, result);
            collect_reference_expr(index, result)
        },
    }
}

fn collect_capture_exprs(values: Vec[tast::Expr], result: collections::IndexSet[string]) -> () {
    for value in values {
        collect_capture_expr(value, result)
    }
}

fn collect_capture_block(value: tast::Block, result: collections::IndexSet[string]) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => collect_closure_captures(Vec::new(), expr, result),
            Let { is_mut: _, pat: _, value: expr } => collect_capture_expr(expr, result),
            LetElse { is_mut: _, pat: _, value: expr, else_branch } => {
                collect_capture_expr(expr, result);
                collect_capture_expr(else_branch, result)
            },
            Assign { target, op: _, value: expr } => {
                collect_capture_expr(target, result);
                collect_capture_expr(expr, result)
            },
            Expr { expr } => collect_capture_expr(expr, result),
        }
    }
    if let Some(expr) = value.tail {
        collect_capture_expr(expr, result)
    }
}

fn collect_closure_captures(
    params: Vec[tast::ClosureParam],
    body: tast::Expr,
    result: collections::IndexSet[string],
) -> () {
    let bound = collections::IndexSet::new();
    for param in params {
        push_name(bound, param.name)
    }
    collect_bound_expr(body, bound);
    let references = collections::IndexSet::new();
    collect_reference_expr(body, references);
    for name in references {
        if bound.contains(name) {} else {
            push_name(result, name)
        }
    }
    collect_capture_expr(body, result)
}

fn collect_capture_expr(value: tast::Expr, result: collections::IndexSet[string]) -> () {
    match value {
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
        Break { value, ty: _, .. } => if let Some(expr) = value {
            collect_capture_expr(expr, result)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => collect_capture_exprs(args, result),
        Closure { params, body, ty: _ } => collect_closure_captures(params, body, result),
        Block { block, ty: _ } => collect_capture_block(block, result),
        Comptime { body, .. } => collect_capture_expr(body, result),
        Match { expr: source, arms, ty: _, .. } => {
            collect_capture_expr(source, result);
            for arm in arms {
                if let Some(guard) = arm.guard {
                    collect_capture_expr(guard, result)
                }
                collect_capture_expr(arm.body, result)
            }
        },
        Select { arms, .. } => for arm in arms {
            match arm {
                Receive { channel, guard, binding: _, binding_ty: _, body } => {
                    collect_capture_expr(channel, result);
                    if let Some(value) = guard {
                        collect_capture_expr(value, result)
                    }
                    collect_capture_expr(body, result)
                },
                Send { channel, value, guard, body } => {
                    collect_capture_expr(channel, result);
                    collect_capture_expr(value, result);
                    if let Some(value) = guard {
                        collect_capture_expr(value, result)
                    }
                    collect_capture_expr(body, result)
                },
                Default { body } => collect_capture_expr(body, result),
            }
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_capture_expr(cond, result);
            collect_capture_expr(then_branch, result);
            collect_capture_expr(else_branch, result)
        },
        While { cond, body, ty: _ } => {
            collect_capture_expr(cond, result);
            collect_capture_expr(body, result)
        },
        Loop { body, ty: _ } => collect_capture_expr(body, result),
        For {
            pat: _,
            iterator,
            into_iter_trait_ref: _,
            iterator_trait_ref: _,
            iterator_ty: _,
            body,
            ty: _,
        } => {
            collect_capture_expr(iterator, result);
            collect_capture_expr(body, result)
        },
        Return { expr, ty: _ } => if let Some(value) = expr {
            collect_capture_expr(value, result)
        },
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } | Field { expr, field_name: _, ty: _ } | ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => collect_capture_expr(
            expr,
            result,
        ),
        Call { func: function, args, ty: _ } => {
            collect_capture_expr(function, result);
            collect_capture_exprs(args, result)
        },
        Index { base, index, ty: _ } | Binary { op: _, lhs: base, rhs: index, ty: _, resolution: _ } => {
            collect_capture_expr(base, result);
            collect_capture_expr(index, result)
        },
    }
}

fn hidden_mutable_cells(value: tast::Block) -> Vec[(string, tast::Type)] {
    let mutables: collections::IndexMap[string, tast::Type] = collections::IndexMap::new();
    collect_mutable_block(value, mutables);
    let captures = collections::IndexSet::new();
    collect_capture_block(value, captures);
    let result: Vec[(string, tast::Type)] = Vec::new();
    for value in mutables {
        if captures.contains(value.0) {
            result.push(value)
        }
    }
    result
}

fn hidden_cell_type(value: tast::Type) -> tast::Type {
    tast::Type::RefType { elem: value }
}

fn hidden_cell_inner(cells: Vec[(string, tast::Type)], name: string) -> Option[tast::Type] {
    let mut index = cells.len() - 1;
    while index >= 0 {
        let value = cells[index];
        if value.0 == name {
            return Option::Some(value.1)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn intrinsic_expr(name: string, params: Vec[tast::Type], ret_ty: tast::Type) -> LowerExpr {
    LowerExpr::Callable {
        callable: tast::Callable::Intrinsic(name),
        ty: tast::Type::Func { params, ret_ty },
    }
}

fn hidden_cell_var(name: string, inner_ty: tast::Type) -> LowerExpr {
    LowerExpr::Var { name, ty: hidden_cell_type(inner_ty) }
}

fn hidden_ref_alloc(value: LowerExpr, inner_ty: tast::Type) -> LowerExpr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(inner_ty);
    let args: Vec[LowerExpr] = Vec::new();
    args.push(value);
    LowerExpr::Call { func: intrinsic_expr("ref.new", params, ref_ty), args, ty: ref_ty }
}

fn hidden_ref_get(name: string, inner_ty: tast::Type) -> LowerExpr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    let args: Vec[LowerExpr] = Vec::new();
    args.push(hidden_cell_var(name, inner_ty));
    LowerExpr::Call { func: intrinsic_expr("ref.get", params, inner_ty), args, ty: inner_ty }
}

fn hidden_ref_set(name: string, inner_ty: tast::Type, value: LowerExpr) -> LowerExpr {
    let ref_ty = hidden_cell_type(inner_ty);
    let params: Vec[tast::Type] = Vec::new();
    params.push(ref_ty);
    params.push(inner_ty);
    let args: Vec[LowerExpr] = Vec::new();
    args.push(hidden_cell_var(name, inner_ty));
    args.push(value);
    LowerExpr::Call {
        func: intrinsic_expr("ref.set", params, tast::Type::Unit),
        args,
        ty: tast::Type::Unit,
    }
}

fn lower_hidden_exprs(values: Vec[LowerExpr], cells: Vec[(string, tast::Type)]) -> Vec[LowerExpr] {
    let result: Vec[LowerExpr] = Vec::new();
    for value in values {
        result.push(lower_hidden_expr(value, cells))
    }
    result
}

fn lower_hidden_block(value: LowerBlock, cells: Vec[(string, tast::Type)]) -> LowerBlock {
    let stmts: Vec[LowerLetStmt] = Vec::new();
    for stmt in value.stmts {
        let lowered = lower_hidden_expr(stmt.value, cells);
        match hidden_cell_inner(cells, stmt.name) {
            Some(inner_ty) => stmts.push(
                LowerLetStmt {
                    name: stmt.name,
                    value: hidden_ref_alloc(lowered, inner_ty),
                    ty: hidden_cell_type(inner_ty),
                },
            ),
            None => stmts.push(LowerLetStmt { name: stmt.name, value: lowered, ty: stmt.ty }),
        }
    }
    LowerBlock { stmts, tail: value.tail.map(|expr| lower_hidden_expr(expr, cells)) }
}

fn lower_hidden_arms(values: Vec[LowerArm], cells: Vec[(string, tast::Type)]) -> Vec[LowerArm] {
    let result: Vec[LowerArm] = Vec::new();
    for value in values {
        result.push(
            LowerArm {
                lhs: lower_hidden_expr(value.lhs, cells),
                body: lower_hidden_expr(value.body, cells),
            },
        )
    }
    result
}

fn lower_hidden_select_arms(values: Vec[LowerSelectArm], cells: Vec[(string, tast::Type)]) -> Vec[
    LowerSelectArm,
] {
    let result: Vec[LowerSelectArm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            match value {
                Receive { channel, guard, binding, binding_ty, body } => LowerSelectArm::Receive {
                    channel: lower_hidden_expr(channel, cells),
                    guard: guard.map(|value| lower_hidden_expr(value, cells)),
                    binding,
                    binding_ty,
                    body: lower_hidden_expr(body, cells),
                },
                Send { channel, value, guard, body } => LowerSelectArm::Send {
                    channel: lower_hidden_expr(channel, cells),
                    value: lower_hidden_expr(value, cells),
                    guard: guard.map(|value| lower_hidden_expr(value, cells)),
                    body: lower_hidden_expr(body, cells),
                },
            },
        )
    }
    result
}

fn lower_hidden_expr(value: LowerExpr, cells: Vec[(string, tast::Type)]) -> LowerExpr {
    match value {
        Var { name, ty } => match hidden_cell_inner(cells, name) {
            Some(inner_ty) => hidden_ref_get(name, inner_ty),
            None => LowerExpr::Var { name, ty },
        },
        Callable { callable, ty } => LowerExpr::Callable { callable, ty },
        Prim { value, ty } => LowerExpr::Prim { value, ty },
        Constr { constructor, args, ty } => {
            LowerExpr::Constr { constructor, args: lower_hidden_exprs(args, cells), ty }
        },
        Tuple { items, ty } => LowerExpr::Tuple { items: lower_hidden_exprs(items, cells), ty },
        Array { items, ty } => LowerExpr::Array { items: lower_hidden_exprs(items, cells), ty },
        Closure { params, body, ty } => {
            LowerExpr::Closure { params, body: lower_hidden_expr(body, cells), ty }
        },
        Block { block, ty } => LowerExpr::Block { block: lower_hidden_block(block, cells), ty },
        Match { expr: source, arms, default, ty } => LowerExpr::Match {
            expr: lower_hidden_expr(source, cells),
            arms: lower_hidden_arms(arms, cells),
            default: default.map(|expr| lower_hidden_expr(expr, cells)),
            ty,
        },
        Select { mode, arms, default, ty } => LowerExpr::Select {
            mode,
            arms: lower_hidden_select_arms(arms, cells),
            default: default.map(|expr| lower_hidden_expr(expr, cells)),
            ty,
        },
        If { cond, then_branch, else_branch, ty } => LowerExpr::If {
            cond: lower_hidden_expr(cond, cells),
            then_branch: lower_hidden_expr(then_branch, cells),
            else_branch: lower_hidden_expr(else_branch, cells),
            ty,
        },
        While { cond, body, ty } => {
            LowerExpr::While {
                cond: lower_hidden_expr(cond, cells),
                body: lower_hidden_expr(body, cells),
                ty,
            }
        },
        Loop { body, ty } => LowerExpr::Loop { body: lower_hidden_expr(body, cells), ty },
        Break { target, value, ty } => LowerExpr::Break {
            target,
            value: value.map(|expr| lower_hidden_expr(expr, cells)),
            ty,
        },
        Continue { target, ty } => LowerExpr::Continue { target, ty },
        Return { expr, ty } => LowerExpr::Return {
            expr: expr.map(|value| lower_hidden_expr(value, cells)),
            ty,
        },
        Go { expr, ty } => LowerExpr::Go { expr: lower_hidden_expr(expr, cells), ty },
        ConstrGet { expr, constructor, field_index, ty } => LowerExpr::ConstrGet {
            expr: lower_hidden_expr(expr, cells),
            constructor,
            field_index,
            ty,
        },
        Unary { op, expr, ty } => LowerExpr::Unary { op, expr: lower_hidden_expr(expr, cells), ty },
        Cast { expr, ty } => LowerExpr::Cast { expr: lower_hidden_expr(expr, cells), ty },
        Binary { op, lhs: left, rhs: right, ty } => LowerExpr::Binary {
            op,
            lhs: lower_hidden_expr(left, cells),
            rhs: lower_hidden_expr(right, cells),
            ty,
        },
        Assign { name, value: expr, target_ty, ty } => {
            let expr = lower_hidden_expr(expr, cells);
            match hidden_cell_inner(cells, name) {
                Some(inner_ty) => hidden_ref_set(name, inner_ty, expr),
                None => LowerExpr::Assign { name, value: expr, target_ty, ty },
            }
        },
        Call { func: function, args, ty } => LowerExpr::Call {
            func: lower_hidden_expr(function, cells),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        ToDyn { trait_name: name, for_ty, expr, ty } => {
            LowerExpr::ToDyn { trait_name: name, for_ty, expr: lower_hidden_expr(expr, cells), ty }
        },
        DynCall { trait_name: owner, method_name: name, receiver, args, ty } => LowerExpr::DynCall {
            trait_name: owner,
            method_name: name,
            receiver: lower_hidden_expr(receiver, cells),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        TraitCall {
            trait_ref: reference,
            method_name: name,
            instance_name,
            for_ty,
            receiver,
            args,
            ty,
        } => LowerExpr::TraitCall {
            trait_ref: reference,
            method_name: name,
            instance_name,
            for_ty,
            receiver: receiver.map(|value| lower_hidden_expr(value, cells)),
            args: lower_hidden_exprs(args, cells),
            ty,
        },
        Proj { tuple: expr, index, ty } => {
            LowerExpr::Proj { tuple: lower_hidden_expr(expr, cells), index, ty }
        },
    }
}
