package core;

use module::ast;
use module::ctir;
use module::hir;
use module::parser;
use module::tast;
use std::testing;

fn test_builtins(counter: Ref[isize]) -> File {
    match lower_builtins(counter) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn lower_source(source: string) -> File {
    lower(tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")))
}

fn lower_optimized_source(source: string) -> File {
    lower_with_counter_types_and_options(
        tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
        Ref::new(0),
        Vec::new(),
        Vec::new(),
        true,
    )
}

#[test]
fn snapshot_names_restart_for_each_function() -> () {
    let output = encode_snapshot(
        lower_source("fn first(value: i32) -> i32 { value } fn second(value: i32) -> i32 { value }"),
    );
    testing::assert(output.contains("fn first(value/0: i32)"));
    testing::assert(output.contains("fn second(value/0: i32)"))
}

#[test]
fn detaches_tast_type_variables_at_the_core_boundary() -> () {
    let variable = Ref::new(tast::TypeVar::Unbound { id: 7, kind: tast::VarKind::Any });
    let unbound = lower_type(tast::Type::Var(variable));
    match unbound {
        Error => (),
        _ => testing::fail("expected an unbound type variable to become Core Error"),
    }
    variable.set(tast::TypeVar::Link(tast::Type::String));
    let linked = lower_type(tast::Type::Var(variable));
    match linked {
        String => (),
        _ => testing::fail("expected a linked type variable to detach as string"),
    }
    variable.set(tast::TypeVar::Link(tast::Type::Bool));
    match linked {
        String => (),
        _ => testing::fail("expected the detached Core type to remain immutable"),
    }
}

#[test]
fn preserves_open_core_types_without_tast_state() -> () {
    let value = lower_type(
        tast::Type::Dyn {
            trait_name: "Iterator",
            args: Vec::from_array([tast::Type::Param { name: "T" }]),
            associated_types: Vec::from_array(
                [
                    (
                        "Item",
                        tast::Type::Projection {
                            for_ty: tast::Type::Param { name: "T" },
                            name: "Item",
                            trait_ref: Option::Some(
                                tast::TraitRef {
                                    name: "Source",
                                    args: Vec::from_array([tast::Type::Param { name: "U" }]),
                                },
                            ),
                        },
                    ),
                ],
            ),
            additional_bounds: Vec::new(),
        },
    );
    testing::assert_eq(type_parameters(value).len(), 2);
    testing::assert_eq(type_parameters(value)[0], "T");
    testing::assert_eq(type_parameters(value)[1], "U");
    let substituted = substitute_type(
        value,
        Vec::from_array([("T", Type::Int32), ("U", Type::String)]),
    );
    testing::assert_eq(type_key(substituted), "dynIterator[i32,Item=i32::Item]")
}

#[test]
fn rejects_residual_comptime_nodes() -> () {
    let typed = tast::File {
        items: Vec::from_array(
            [
                tast::Item::Function(
                    tast::Function {
                        visibility: ast::Visibility::Private,
                        name: "main",
                        comptime: tast::ComptimeCapability::RuntimeOnly,
                        derive_export_name: Option::None,
                        name_span: ast::Span { start: 0, end: 0 },
                        source_path: "main.gom",
                        start: 0,
                        end: 0,
                        comptime_origins: Vec::new(),
                        generics: Vec::new(),
                        predicates: Vec::new(),
                        params: Vec::new(),
                        ret_ty: tast::Type::Unit,
                        body: tast::Block {
                            stmts: Vec::new(),
                            tail: Option::Some(
                                tast::Expr::Comptime {
                                    site_id: 0,
                                    source_path: "main.gom",
                                    start: 0,
                                    end: 8,
                                    origins: Vec::new(),
                                    body: tast::Expr::Prim {
                                        value: tast::Primitive::Unit,
                                        ty: tast::Type::Unit,
                                    },
                                    ty: tast::Type::Unit,
                                },
                            ),
                        },
                    },
                ),
            ],
        ),
        enums: Vec::new(),
        structs: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
    };
    let lowered = lower(
        tast::CheckResult {
            tast: Option::Some(typed),
            comptime: ctir::empty_module("main"),
            pending_constants: Vec::new(),
            diagnostics: Vec::new(),
            typeck_results: tast::empty_typeck_results(),
        },
    );
    match lowered.functions[0].body.tail {
        Some(Expr::Prim { value: Primitive::Unit, ty: Type::Error }) => (),
        _ => testing::fail("expected residual comptime rejection"),
    }
}

fn string_contains(value: string, expected: string) -> bool {
    value.contains(expected)
}

#[test]
fn lowers_basic_functions_and_let_chains() -> () {
    let source = "fn take(value: u16) -> u16 { value } fn main() -> u16 { let value = take(1000); value }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn take(value/0: u16) -> u16 {
        \\  value/0
        \\}
        \\
        \\fn main() -> u16 {
        \\  let value/1 = take(1000) in
        \\  value/1
        \\}
        ,
    )
}

#[test]
fn folds_negative_integer_primitives() -> () {
    testing::assert_eq(
        encode(lower_source("fn main() -> i32 { -1 }")),
        \\fn main() -> i32 {
        \\  -1
        \\}
        ,
    )
}

#[test]
fn preserves_exiting_accessor_subexpressions() -> () {
    let source = "fn proj_case() -> i32 { let _: i32 = (return 1).0; 0 } fn index_case() -> i32 { let _: i32 = (return 1)[0]; 0 } fn field_case() -> i32 { let _: i32 = (return 1).value; 0 }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn proj_case() -> i32 {
        \\  let mtmp1 =
        \\    {
        \\      let _wild0 = return 1 in
        \\      @intrinsic(compiler.missing)("")
        \\    } in
        \\  {
        \\    0
        \\  }
        \\}
        \\
        \\fn index_case() -> i32 {
        \\  let mtmp3 =
        \\    {
        \\      let _wild2 = return 1 in
        \\      @intrinsic(compiler.missing)("")
        \\    } in
        \\  {
        \\    0
        \\  }
        \\}
        \\
        \\fn field_case() -> i32 {
        \\  let mtmp5 =
        \\    {
        \\      let _wild4 = return 1 in
        \\      @intrinsic(compiler.missing)("")
        \\    } in
        \\  {
        \\    0
        \\  }
        \\}
        ,
    )
}

#[test]
fn nests_discard_patterns_around_the_continuation() -> () {
    testing::assert_eq(
        encode(lower_source("fn main() -> () { let _ = (); () }")),
        \\fn main() -> () {
        \\  let mtmp0 = () in
        \\  {
        \\    ()
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_enum_payload_patterns_in_definition_order() -> () {
    let source = "enum Weird[T] { Next(Ref[Weird[(i32) -> i32]]), Done(T) } fn main() -> () { let x: Weird[i32] = Weird::Done(1); match x { Weird::Done(v) => println(v.to_string()), Weird::Next(_) => println(\"next\"), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  let x/0 = Weird::Done(1) in
        \\  match x/0 {
        \\    Weird::Next(x0) => {
        \\      {
        \\        let x0 = Weird::Next._0(x/0) in
        \\        println("next")
        \\      }
        \\    },
        \\    Weird::Done(x1) => {
        \\      {
        \\        let x1 = Weird::Done._0(x/0) in
        \\        {
        \\          let v/1 = x1 in
        \\          println(inherent#i32#i32#to_string(v/1))
        \\        }
        \\      }
        \\    },
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_or_patterns_in_match_matrices() -> () {
    let source = "enum Flag { A, B, C } fn is_first(value: Flag) -> bool { match value { Flag::A | Flag::B => true, _ => false, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn is_first(value/0: Flag) -> bool {
        \\  match value/0 {
        \\    Flag::A => {
        \\      true
        \\    },
        \\    Flag::B => {
        \\      true
        \\    },
        \\    _ => false,
        \\  }
        \\}
        ,
    )
}

#[test]
fn allocates_statement_names_after_lowering_the_value() -> () {
    let file = lower_source(
        "fn f(flag: bool) -> i32 { while true { if flag { return 1 } else { break }; }; 2 }",
    );
    match file.functions.get(0).body.stmts.get(0) {
        LetStmt { name, value: While { cond: _, body: Block { block: body, ty: _ }, ty: _ }, ty: _ } => {
            testing::assert_eq(name, "_wild1");
            testing::assert_eq(body.stmts.get(0).name, "_wild0")
        },
        _ => testing::fail("expected nested while statement bindings"),
    }
}

#[test]
fn lowers_builtin_option_matches_with_nonvariable_sources() -> () {
    let source = "fn build() -> Option[() -> i32] { Option::Some(|| 1) } fn main() -> () { match build() { Option::Some(f) => println(f()), Option::None => println(0), } }";
    let file = lower_source(source);
    match file.functions.get(1).body.tail {
        Some(Block { block, ty: _ }) => {
            testing::assert_eq(block.stmts.get(0).name, "mtmp0");
            match block.tail {
                Some(Match { expr: _, arms, default: None, ty: _ }) => {
                    match arms.get(0).lhs {
                        Constr { constructor, args: _, ty: _ } => {
                            testing::assert_eq(constructor.name, "Option::None");
                            match constructor.tag {
                                Some(tag) => testing::assert_eq(tag, 0),
                                None => testing::fail("expected None tag"),
                            }
                        },
                        _ => testing::fail("expected None arm"),
                    }
                    match arms.get(1).lhs {
                        Constr { constructor, args: _, ty: _ } => {
                            testing::assert_eq(constructor.name, "Option::Some");
                            match constructor.tag {
                                Some(tag) => testing::assert_eq(tag, 1),
                                None => testing::fail("expected Some tag"),
                            }
                        },
                        _ => testing::fail("expected Some arm"),
                    }
                },
                _ => testing::fail("expected Option match"),
            }
        },
        _ => testing::fail("expected scrutinee binding block"),
    }
}

#[test]
fn lowers_linked_builtin_option_payload_patterns() -> () {
    let counter = Ref::new(0);
    let builtins = test_builtins(counter);
    let user = lower_with_counter_and_types(
        tast::check_for_link(
            hir::lower(
                ast::lower(
                    parser::parse(
                        "fn unwrap(input: Option[char]) -> char { match input { Option::Some(value) => value, Option::None => '?' } }",
                    ),
                ),
                "main.gom",
            ),
        ),
        counter,
        enum_defs_to_tast(builtins.enums),
        struct_defs_to_tast(builtins.structs),
    );
    match user.functions.get(0).body.tail {
        Some(Match { expr: _, arms, default: None, ty: _ }) => {
            match arms.get(1).lhs {
                Constr { constructor, args: _, ty: _ } => {
                    testing::assert_eq(constructor.name, "Option::Some")
                },
                _ => testing::fail("expected Some arm"),
            }
            match arms.get(1).body {
                Block { block: extraction, ty: _ } => match extraction.tail {
                    Some(Block { block: binding, ty: _ }) => {
                        testing::assert_eq(binding.stmts.get(0).name, "value/1");
                        match binding.tail {
                            Some(Var { name, ty: _ }) => {
                                testing::assert_eq(name, "value/1")
                            },
                            _ => testing::fail("expected bound payload result"),
                        }
                    },
                    _ => testing::fail("expected payload binding block"),
                },
                _ => testing::fail("expected payload extraction block"),
            }
        },
        _ => testing::fail("expected Option match"),
    }
}

#[test]
fn boxes_mutable_locals_captured_by_closures() -> () {
    let source = "fn main() -> i32 { let mut x = 0; let inc = || { x = x + 1; x }; inc() }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> i32 {
        \\  let x/0 = @intrinsic(ref.new)(0) in
        \\  let inc/1 =
        \\    || => {
        \\      let _wild0 = @intrinsic(ref.set)(x/0, (@intrinsic(ref.get)(x/0) + 1)) in
        \\      @intrinsic(ref.get)(x/0)
        \\    } in
        \\  inc/1()
        \\}
        ,
    )
}

#[test]
fn binds_nested_match_sources_before_lowering_them() -> () {
    let source = "fn main() -> bool { match match Option::Some(true) { Option::Some(value) => value, Option::None => false, } { false => false, true => true, } }";
    let file = lower_source(source);
    match file.functions.get(0).body.tail {
        Some(Block { block: outer, ty: _ }) => {
            testing::assert_eq(outer.stmts.get(0).name, "mtmp0");
            match outer.stmts.get(0).value {
                Block { block: inner, ty: _ } => testing::assert_eq(
                    inner.stmts.get(0).name,
                    "mtmp1",
                ),
                _ => testing::fail("expected inner match binding"),
            }
            match outer.tail {
                Some(Match { expr: _, arms, default: None, ty: _ }) => {
                    match arms.get(0).lhs {
                        Prim { value: Bool { value }, ty: _ } => {
                            testing::assert_eq(value, true)
                        },
                        _ => testing::fail("expected true arm"),
                    }
                    match arms.get(1).lhs {
                        Prim { value: Bool { value }, ty: _ } => {
                            testing::assert_eq(value, false)
                        },
                        _ => testing::fail("expected false arm"),
                    }
                },
                _ => testing::fail("expected outer bool match"),
            }
        },
        _ => testing::fail("expected outer match binding"),
    }
}

#[test]
fn evaluates_index_assignment_places_once() -> () {
    let file = lower_source("fn main() -> () { let mut values = [1, 2]; values[0] = 3; }");
    let body = file.functions.get(0).body;
    testing::assert_eq(body.stmts.get(1).name, "_wild4");
    match body.stmts.get(1).value {
        Block { block: place, ty: _ } => {
            testing::assert_eq(place.stmts.get(0).name, "place_root0");
            testing::assert_eq(place.stmts.get(1).name, "index1");
            testing::assert_eq(place.stmts.get(2).name, "place2");
            testing::assert_eq(place.stmts.get(3).name, "value3");
            match place.tail {
                Some(Assign {
                    name,
                    value: Call {
                        func: Callable { callable: Intrinsic(intrinsic), ty: _ },
                        args: _,
                        ty: _,
                    },
                    target_ty: _,
                    ty: _,
                }) => {
                    testing::assert_eq(name, "values/0");
                    testing::assert_eq(intrinsic, "array.set")
                },
                _ => testing::fail("expected array writeback"),
            }
        },
        _ => testing::fail("expected indexed place block"),
    }
}

#[test]
fn lowers_flat_tuple_bindings_in_matrix_order() -> () {
    let source = "fn split(pair: (i32, string)) -> string { let (left, right) = pair; right }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn split(pair/0: (i32, string)) -> string {
        \\  let mtmp0 = pair/0 in
        \\  {
        \\    let x1 = mtmp0.0 in
        \\    let x2 = mtmp0.1 in
        \\    {
        \\      let right/2 = x2 in
        \\      {
        \\        let left/1 = x1 in
        \\        {
        \\          right/2
        \\        }
        \\      }
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_nested_boolean_enum_payload_patterns() -> () {
    let source = "enum Pair { Values(bool, bool) } fn choose(value: Pair) -> i32 { match value { Pair::Values(false, false) => 2, Pair::Values(false, true) => 3, _ => 4, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn choose(value/0: Pair) -> i32 {
        \\  match value/0 {
        \\    Pair::Values(x0, x1) => {
        \\      {
        \\        let x0 = Pair::Values._0(value/0) in
        \\        let x1 = Pair::Values._1(value/0) in
        \\        match x1 {
        \\          true => {
        \\            match x0 {
        \\              true => {
        \\                4
        \\              },
        \\              false => {
        \\                3
        \\              },
        \\            }
        \\          },
        \\          false => {
        \\            match x0 {
        \\              true => {
        \\                4
        \\              },
        \\              false => {
        \\                2
        \\              },
        \\            }
        \\          },
        \\        }
        \\      }
        \\    },
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_for_loops_through_iterator_protocols() -> () {
    let source = "fn each(values: Vec[i32]) -> () { for value in values { println(value) } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn each(values/0: Vec[i32]) -> () {
        \\  {
        \\    let for_iter0 = trait_call[IntoIterator::into_iter](values/0) in
        \\    while true {
        \\        {
        \\          let for_next1 = trait_call[Iterator::next](for_iter0) in
        \\          match for_next1 {
        \\            Option::None => {
        \\              break
        \\            },
        \\            Option::Some(x2) => {
        \\              {
        \\                let x2 = Option::Some._0(for_next1) in
        \\                {
        \\                  let value/1 = x2 in
        \\                  {
        \\                    println(value/1)
        \\                  }
        \\                }
        \\              }
        \\            },
        \\          }
        \\        }
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_builtin_iterators_without_iterator_protocols() -> () {
    let source = "fn each(values: Vec[i32]) -> () { for value in values { if value == 0 { continue } else { println(value) } }; for value in range(2, 4) { println(value) }; for value in values.slice(0, 1) { println(value) } }";
    let encoded = encode(lower_optimized_source(source));
    testing::assert(!string_contains(encoded, "trait_call[IntoIterator::into_iter]"));
    testing::assert(!string_contains(encoded, "trait_call[Iterator::next]"));
    testing::assert(string_contains(encoded, "@intrinsic(vec.len)"));
    testing::assert(string_contains(encoded, "@intrinsic(vec.get)"));
    testing::assert(string_contains(encoded, "@intrinsic(slice.len)"));
    testing::assert(string_contains(encoded, "@intrinsic(slice.get)"));
    testing::assert(string_contains(encoded, "for_index"));
    testing::assert(string_contains(encoded, " = (for_index"))
}

#[test]
fn lowers_inclusive_ranges_without_overflowing_the_endpoint() -> () {
    let source = "fn each(start: isize, end: isize) -> () { for value in start..=end { if value == 0 { continue } else { println(value) } } }";
    let encoded = encode(lower_optimized_source(source));
    testing::assert(!string_contains(encoded, "trait_call[IntoIterator::into_iter]"));
    testing::assert(!string_contains(encoded, "trait_call[Iterator::next]"));
    testing::assert(string_contains(encoded, "for_done"));
    testing::assert(string_contains(encoded, "if (for_index"))
}

#[test]
fn does_not_optimize_user_function_named_range() -> () {
    let source = "fn range(start: isize, end: isize) -> FnIterator[isize] { FnIterator::from_fn(|| Option::None) } fn each() -> () { for value in range(2, 4) { println(value) } }";
    let encoded = encode(lower_optimized_source(source));
    testing::assert(string_contains(encoded, "trait_call[IntoIterator::into_iter]"));
    testing::assert(string_contains(encoded, "trait_call[Iterator::next]"));
    testing::assert(!string_contains(encoded, "for_index"))
}

#[test]
fn lowers_flat_struct_bindings_in_field_order() -> () {
    let source = "struct Pair { left: i32, right: string } fn right(pair: Pair) -> string { let Pair { left: _, right } = pair; right }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn right(pair/0: Pair) -> string {
        \\  let mtmp0 = pair/0 in
        \\  {
        \\    let x1 = Pair.left(mtmp0) in
        \\    let x2 = Pair.right(mtmp0) in
        \\    {
        \\      let right/1 = x2 in
        \\      {
        \\        right/1
        \\      }
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn links_builtin_core_before_user_core() -> () {
    let counter = Ref::new(0);
    let builtins = test_builtins(counter);
    testing::assert(builtins.functions.len() > 20);
    let first_builtin_name = builtins.functions.get(0).name;
    let user = lower_with_counter_and_types(
        tast::check_for_link(
            hir::lower(ast::lower(parser::parse("fn main() -> () { print(true) }")), "main.gom"),
        ),
        counter,
        enum_defs_to_tast(builtins.enums),
        struct_defs_to_tast(builtins.structs),
    );
    let linked = link_with_builtins(builtins, user);
    testing::assert(!linked.functions.get(0).root);
    testing::assert_eq(linked.functions.get(0).name, first_builtin_name);
    testing::assert_eq(linked.functions.get(linked.functions.len() - 1).name, "main");
    testing::assert(counter.get() > 50)
}

#[test]
fn lowers_nested_tuple_and_enum_pattern_matrices() -> () {
    let source = "enum Key { A, B(i32) } fn equal_pair(left: Key, right: Key) -> bool { match (left, right) { (Key::A, Key::A) => true, (Key::B(x), Key::B(y)) => x == y, _ => false, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn equal_pair(left/0: Key, right/1: Key) -> bool {
        \\  {
        \\    let mtmp0 = (left/0, right/1) in
        \\    {
        \\      let x1 = mtmp0.0 in
        \\      let x2 = mtmp0.1 in
        \\      match x2 {
        \\        Key::A => {
        \\          match x1 {
        \\            Key::A => {
        \\              true
        \\            },
        \\            _ => false,
        \\          }
        \\        },
        \\        Key::B(x3) => {
        \\          {
        \\            let x3 = Key::B._0(x2) in
        \\            match x1 {
        \\              Key::B(x5) => {
        \\                {
        \\                  let x5 = Key::B._0(x1) in
        \\                  {
        \\                    let x/2 = x5 in
        \\                    {
        \\                      let y/3 = x3 in
        \\                      (x/2 == y/3)
        \\                    }
        \\                  }
        \\                }
        \\              },
        \\              _ => false,
        \\            }
        \\          }
        \\        },
        \\      }
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_ordered_and_uninhabited_patterns() -> () {
    let source = "enum Never {} enum Single { Only(i32) } fn absurd(value: Never) -> i32 { match value {} } fn unwrap(value: Single) -> i32 { let (Single::Only(inner)) = value; inner } fn classify(values: Vec[bool]) -> i32 { match values { [] => 0, [true, .., _] => 1, _ => 2, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn absurd(value/0: Never) -> i32 {
        \\  {
        \\    let _wild0 = value/0 in
        \\    @intrinsic(compiler.missing)("")
        \\  }
        \\}
        \\
        \\fn unwrap(value/1: Single) -> i32 {
        \\  let mtmp1 = value/1 in
        \\  match mtmp1 {
        \\    Single::Only(x2) => {
        \\      {
        \\        let x2 = Single::Only._0(mtmp1) in
        \\        {
        \\          let inner/2 = x2 in
        \\          {
        \\            inner/2
        \\          }
        \\        }
        \\      }
        \\    },
        \\  }
        \\}
        \\
        \\fn classify(values/3: Vec[bool]) -> i32 {
        \\  {
        \\    let match3 = values/3 in
        \\    if (@intrinsic(vec.len)(match3) == 0) {
        \\        0
        \\    } else {
        \\        if (@intrinsic(vec.len)(match3) >= 2) {
        \\            if (@intrinsic(vec.get)(match3, 0) == true) {
        \\                1
        \\            } else {
        \\                2
        \\            }
        \\        } else {
        \\            2
        \\        }
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn preserves_scalar_pattern_precedence() -> () {
    let source = "fn choose(value: i32) -> i32 { match value { 1 => 10, _ => 20, 1 => 30, 2 => 40, } } fn first(value: i32) -> i32 { match value { _ => 50, 0 => 60, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn choose(value/0: i32) -> i32 {
        \\  match value/0 {
        \\    1 => {
        \\      10
        \\    },
        \\    2 => {
        \\      20
        \\    },
        \\    _ => 20,
        \\  }
        \\}
        \\
        \\fn first(value/1: i32) -> i32 {
        \\  50
        \\}
        ,
    )
}

#[test]
fn lowers_unit_columns_inside_enum_patterns() -> () {
    let source = "enum T { A, B(bool, ()) } fn main() -> () { let value = T::B(true, ()); match value { T::A => println(1), T::B(true, ()) => println(2), T::B(false, ()) => println(3), } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn main() -> () {
        \\  let value/0 = T::B(true, ()) in
        \\  match value/0 {
        \\    T::A => {
        \\      println(1)
        \\    },
        \\    T::B(x0, x1) => {
        \\      {
        \\        let x0 = T::B._0(value/0) in
        \\        let x1 = T::B._1(value/0) in
        \\        match x1 {
        \\          () => {
        \\            match x0 {
        \\              true => {
        \\                println(2)
        \\              },
        \\              false => {
        \\                println(3)
        \\              },
        \\            }
        \\          },
        \\        }
        \\      }
        \\    },
        \\  }
        \\}
        ,
    )
}

#[test]
fn lowers_struct_pattern_matrices_by_field_order() -> () {
    let source = "struct Pair { left: i32, right: i32 } fn matches(value: Pair) -> bool { match value { Pair { left: 4, right: 9 } => true, Pair { left: _, right: 6 } => true, _ => false, } }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\fn matches(value/0: Pair) -> bool {
        \\  {
        \\    let x0 = Pair.left(value/0) in
        \\    let x1 = Pair.right(value/0) in
        \\    match x1 {
        \\      9 => {
        \\        match x0 {
        \\          4 => {
        \\            true
        \\          },
        \\          _ => false,
        \\        }
        \\      },
        \\      6 => {
        \\        true
        \\      },
        \\      _ => false,
        \\    }
        \\  }
        \\}
        ,
    )
}

#[test]
fn eliminates_dead_locals_without_dropping_effects() -> () {
    let source = "fn effect() -> i32 { 1 } fn main() -> () { let dead = 1; let dead_pair = (dead, 2); let unused = |value: i32| value + dead; let kept = effect(); let divisor = 2; let quotient = 8 / divisor; () }";
    let output = encode(eliminate_dead_locals(lower_source(source)));
    testing::assert(!string_contains(output, "dead/"));
    testing::assert(!string_contains(output, "dead_pair/"));
    testing::assert(!string_contains(output, "unused/"));
    testing::assert(string_contains(output, "let kept/"));
    testing::assert(string_contains(output, "let divisor/"));
    testing::assert(string_contains(output, "let quotient/"))
}

fn core_with_only_named_root(value: File, root_name: string) -> File {
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        functions.push(
            Function {
                name: function.name,
                origin: function.origin,
                root: function.name == root_name,
                generics: function.generics,
                predicates: function.predicates,
                trait_impl: function.trait_impl,
                params: function.params,
                ret_ty: function.ret_ty,
                body: function.body,
            },
        )
    }
    File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
    }
}

#[test]
fn eliminates_unreachable_functions_transitively() -> () {
    let source = "fn helper() -> i32 { 7 } fn id[T](value: T) -> T { value } fn live() -> i32 { id(helper()) } fn dead() -> i32 { 9 } fn main() -> i32 { live() }";
    let value = eliminate_unreachable_functions(
        core_with_only_named_root(eliminate_dead_locals(lower_source(source)), "main"),
    );
    let output = encode(value);
    testing::assert(string_contains(output, "fn helper("));
    testing::assert(string_contains(output, "fn id("));
    testing::assert(string_contains(output, "fn live("));
    testing::assert(string_contains(output, "fn main("));
    testing::assert(!string_contains(output, "fn dead("))
}

#[test]
fn retains_reachable_inherent_method_candidates() -> () {
    let source = "struct Shape {} impl Shape { fn name(self: Self) -> string { \"Shape\" } fn unused(self: Self) -> string { \"unused\" } } fn main() -> string { Shape {}.name() }";
    let value = eliminate_unreachable_functions(
        core_with_only_named_root(eliminate_dead_locals(lower_source(source)), "main"),
    );
    let output = encode(value);
    testing::assert(string_contains(output, "#name("));
    testing::assert(!string_contains(output, "#unused("))
}

#[test]
fn retains_reachable_trait_method_candidates() -> () {
    let source = "struct Value {} trait Render { fn render(self: Self) -> string; } impl Render for Value { fn render(self: Value) -> string { \"value\" } } trait Unused { fn unused(self: Self) -> string; } impl Unused for Value { fn unused(self: Value) -> string { \"unused\" } } fn main() -> string { Render::render(Value {}) }";
    let value = eliminate_unreachable_functions(
        core_with_only_named_root(eliminate_dead_locals(lower_source(source)), "main"),
    );
    let output = encode(value);
    testing::assert(string_contains(output, "trait_impl#Render#Value#render"));
    testing::assert(!string_contains(output, "trait_impl#Unused#Value#unused"))
}

#[test]
fn validates_core_binding_types() -> () {
    let file = lower_source("fn main() -> () { let value = 1; () }");
    if let Err(message) = validate(file) {
        testing::fail(message)
    }
    let function = file.functions[0];
    let statement = function.body.stmts[0];
    let invalid_statements = Vec::from_array(
        [LetStmt { name: statement.name, value: statement.value, ty: Type::String }],
    );
    let invalid_functions = Vec::from_array(
        [
            Function {
                name: function.name,
                origin: function.origin,
                root: function.root,
                generics: function.generics,
                predicates: function.predicates,
                trait_impl: function.trait_impl,
                params: function.params,
                ret_ty: function.ret_ty,
                body: Block { stmts: invalid_statements, tail: function.body.tail },
            },
        ],
    );
    match validate(
        File {
            functions: invalid_functions,
            enums: file.enums,
            structs: file.structs,
            type_instances: file.type_instances,
            constants: file.constants,
            statics: file.statics,
        },
    ) {
        Ok(_) => testing::fail("expected invalid Core IR"),
        Err(message) => testing::assert(message.contains("let value/0")),
    }
}

#[test]
fn external_types_survive_core_conversion_and_generic_substitution() -> () {
    let original = tast::Type::External {
        import_path: "unique",
        name: "Handle",
        args: Vec::from_array([tast::Type::Param { name: "T" }]),
    };
    let detached = lower_type(original);
    testing::assert(tast::types_equal(type_to_tast(detached), original));
    testing::assert_eq(type_parameters(detached).len(), 1);
    testing::assert(!type_is_concrete(detached));
    let instantiated = substitute_type(detached, Vec::from_array([("T", Type::Int64)]));
    testing::assert(type_is_concrete(instantiated));
    testing::assert(
        types_equal(
            instantiated,
            Type::External {
                import_path: "unique",
                name: "Handle",
                args: Vec::from_array([Type::Int64]),
            },
        ),
    );
    testing::assert(
        type_contains_error(substitute_type(detached, Vec::from_array([("T", Type::Error)]))),
    );
}
