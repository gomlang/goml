package core;

use module::ast;
use module::resources;
use module::tast;
use std::text;

struct Lowerer {
    builtin: tast::BuiltinContract,
    counter: Ref[isize],
    enums: Vec[tast::EnumDef],
    structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
    cleanups: Vec[tast::Expr],
    loop_cleanup_depths: Vec[isize],
    cleanup_lowering_depth: Ref[isize],
}

struct EnumCase {
    constructor: tast::Constructor,
    variables: Vec[(string, tast::Type)],
    rows: Vec[PatternRow],
}

fn gensym(ctx: Lowerer, prefix: string) -> string {
    let current = ctx.counter.get();
    ctx.counter.set(current + 1);
    f"{prefix}{current}"
}

fn type_text(value: tast::Type) -> string {
    let builder = text::StringBuilder::new();
    tast::write_type(builder, value);
    builder.finish()
}

fn compact_text(value: string) -> string {
    let builder = text::StringBuilder::new();
    for character in value.chars() {
        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn compact_type(value: tast::Type) -> string {
    compact_text(type_text(value))
}

fn inherent_base(builtin: tast::BuiltinContract, value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Unit => "()",
        Bool => "bool",
        Int => "isize",
        Int8 => "i8",
        Int16 => "i16",
        Int32 => "i32",
        Int64 => "i64",
        Uint => "usize",
        Uint8 => "u8",
        Uint16 => "u16",
        Uint32 => "u32",
        Uint64 => "u64",
        Float32 => "f32",
        Float64 => "f64",
        String => "string",
        Char => "char",
        Con { name } => name,
        App { ty: base, args: _ } => inherent_base(builtin, base),
        Slice { elem: _ } => builtin.slice.name,
        MutSlice { elem: _ } => builtin.mut_slice.name,
        VecType { elem: _ } => builtin.vec.name,
        GoPointer { elem: _ } => "std::ffi::Ptr",
        GoFunction { signature: _ } => "std::ffi::Func",
        GoMap { .. } => "std::ffi::RawMap",
        RefType { elem: _ } => builtin.ref_type.name,
        HashMap { key: _, value: _ } => builtin.hashmap.name,
        Channel { elem: _, direction } => match direction {
            ast::ChannelDirection::Both => builtin.channel.name,
            ast::ChannelDirection::Send => builtin.sender.name,
            ast::ChannelDirection::Receive => builtin.receiver.name,
        },
        other => compact_type(other),
    }
}

fn inherent_method_name(builtin: tast::BuiltinContract, owner: tast::Type, name: string) -> string {
    "inherent#" + inherent_base(builtin, owner) + "#" + compact_type(owner) + "#" + name
}

fn nominal_parts(value: tast::Type) -> Option[(string, Vec[tast::Type])] {
    match tast::resolve_type(value) {
        Con { name } => Option::Some((name, Vec::new())),
        App { ty: Con { name }, args } => Option::Some((name, args)),
        _ => Option::None,
    }
}

fn find_enum(ctx: Lowerer, name: string) -> Option[tast::EnumDef] {
    let mut index = ctx.enums.len() - 1;
    while index >= 0 {
        let value = ctx.enums[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_struct(ctx: Lowerer, name: string) -> Option[tast::StructDef] {
    let mut index = ctx.structs.len() - 1;
    while index >= 0 {
        let value = ctx.structs[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn trait_impl_method_name(reference: tast::TraitRef, for_ty: tast::Type, name: string) -> string {
    let dispatch = if reference.args.is_empty() {
        compact_type(for_ty)
    } else {
        let builder = text::StringBuilder::new();
        builder.write_char('[');
        for index in 0..reference.args.len() {
            if index > 0 {
                builder.write_char(',')
            }
            builder.write_string(compact_type(reference.args[index]))
        }
        builder.write_string("]@");
        builder.write_string(compact_type(for_ty));
        builder.finish()
    };
    "trait_impl#" + reference.name + "#" + dispatch + "#" + name
}

fn lower_exprs(ctx: Lowerer, values: Vec[tast::Expr]) -> Vec[LowerExpr] {
    let result: Vec[LowerExpr] = Vec::new();
    for value in values {
        result.push(lower_expr(ctx, value))
    }
    result
}

fn arguments_after_first(values: Vec[LowerExpr]) -> Vec[LowerExpr] {
    let result: Vec[LowerExpr] = Vec::new();
    for index in 1..values.len() {
        result.push(values[index])
    }
    result
}

fn bool_expr(value: bool) -> LowerExpr {
    LowerExpr::Prim { value: tast::Primitive::Bool { value }, ty: tast::Type::Bool }
}

fn trait_bool_call(trait_name: string, method_name: string, left: LowerExpr, right: LowerExpr) -> LowerExpr {
    let args: Vec[LowerExpr] = Vec::new();
    args.push(right);
    let for_ty = lower_expr_type(left);
    LowerExpr::TraitCall {
        trait_ref: tast::TraitRef { name: trait_name, args: Vec::new() },
        method_name,
        instance_name: Option::None,
        for_ty,
        receiver: Option::Some(left),
        args,
        ty: tast::Type::Bool,
    }
}

fn trait_eq_call(trait_name: string, left: LowerExpr, right: LowerExpr) -> LowerExpr {
    trait_bool_call(trait_name, "eq", left, right)
}

fn order_method_name(op: ast::BinaryOp) -> string {
    match op {
        Less => "lt",
        Greater => "gt",
        LessEq => "le",
        GreaterEq => "ge",
        _ => "lt",
    }
}

fn lower_order_expr(
    ctx: Lowerer,
    trait_name: string,
    op: ast::BinaryOp,
    left: tast::Expr,
    right: tast::Expr,
) -> LowerExpr {
    trait_bool_call(
        trait_name,
        order_method_name(op),
        lower_expr(ctx, left),
        lower_expr(ctx, right),
    )
}

fn eq_conjunction(values: Vec[LowerExpr]) -> LowerExpr {
    if values.is_empty() {
        bool_expr(true)
    } else {
        let mut result = values[values.len() - 1];
        let mut index = values.len() - 2;
        while index >= 0 {
            result = LowerExpr::If {
                cond: values[index],
                then_branch: result,
                else_branch: bool_expr(false),
                ty: tast::Type::Bool,
            };
            index -= 1;
        }
        result
    }
}

fn structural_eq(trait_name: string, left: LowerExpr, right: LowerExpr, ty: tast::Type) -> LowerExpr {
    match tast::resolve_type(ty) {
        Tuple { items: types } => {
            let values: Vec[LowerExpr] = Vec::new();
            for index in 0..types.len() {
                let item_ty = types[index];
                values.push(
                    structural_eq(
                        trait_name,
                        LowerExpr::Proj { tuple: left, index, ty: item_ty },
                        LowerExpr::Proj { tuple: right, index, ty: item_ty },
                        item_ty,
                    ),
                )
            }
            eq_conjunction(values)
        },
        Array { len: length, elem: element } => {
            let values: Vec[LowerExpr] = Vec::new();
            for index in 0..length {
                let index_expr = LowerExpr::Prim {
                    value: tast::Primitive::Int { value: index.to_string() },
                    ty: tast::Type::Int,
                };
                let parameter_types: Vec[tast::Type] = Vec::new();
                parameter_types.push(ty);
                parameter_types.push(tast::Type::Int);
                let function_ty = tast::Type::Func { params: parameter_types, ret_ty: element };
                let left_args: Vec[LowerExpr] = Vec::new();
                left_args.push(left);
                left_args.push(index_expr);
                let right_args: Vec[LowerExpr] = Vec::new();
                right_args.push(right);
                right_args.push(index_expr);
                values.push(
                    structural_eq(
                        trait_name,
                        LowerExpr::Call {
                            func: LowerExpr::Callable {
                                callable: tast::Callable::Intrinsic("array.get"),
                                ty: function_ty,
                            },
                            args: left_args,
                            ty: element,
                        },
                        LowerExpr::Call {
                            func: LowerExpr::Callable {
                                callable: tast::Callable::Intrinsic("array.get"),
                                ty: function_ty,
                            },
                            args: right_args,
                            ty: element,
                        },
                        element,
                    ),
                )
            }
            eq_conjunction(values)
        },
        _ => trait_eq_call(trait_name, left, right),
    }
}

fn lower_eq_expr(
    ctx: Lowerer,
    trait_name: string,
    op: ast::BinaryOp,
    left: tast::Expr,
    right: tast::Expr,
) -> LowerExpr {
    let operand_ty = tast::expr_type(left);
    let left_value = lower_expr(ctx, left);
    let right_value = lower_expr(ctx, right);
    let eq = match tast::resolve_type(operand_ty) {
        Tuple { items: _ } | Array { len: _, elem: _ } => {
            let left_name = gensym(ctx, "_eq_lhs");
            let right_name = gensym(ctx, "_eq_rhs");
            let stmts: Vec[LowerLetStmt] = Vec::new();
            stmts.push(LowerLetStmt { name: left_name, value: left_value, ty: operand_ty });
            stmts.push(LowerLetStmt { name: right_name, value: right_value, ty: operand_ty });
            LowerExpr::Block {
                block: LowerBlock {
                    stmts,
                    tail: Option::Some(
                        structural_eq(
                            trait_name,
                            LowerExpr::Var { name: left_name, ty: operand_ty },
                            LowerExpr::Var { name: right_name, ty: operand_ty },
                            operand_ty,
                        ),
                    ),
                },
                ty: tast::Type::Bool,
            }
        },
        _ => trait_eq_call(trait_name, left_value, right_value),
    };
    if match op {
        NotEq => true,
        _ => false,
    } {
        LowerExpr::Unary { op: ast::UnaryOp::Not, expr: eq, ty: tast::Type::Bool }
    } else {
        eq
    }
}

fn negated_integer(value: tast::Primitive) -> Option[tast::Primitive] {
    match value {
        Int { value } => Option::Some(tast::Primitive::Int { value: "-" + value }),
        _ => Option::None,
    }
}

fn lower_call(ctx: Lowerer, function: tast::Expr, arguments: Vec[tast::Expr], ty: tast::Type) -> LowerExpr {
    let args = lower_exprs(ctx, arguments);
    match function {
        Callable {
            callable: TraitMethod { trait_ref: reference, method_name: name, for_ty, has_receiver },
            ty: _,
        } => if !has_receiver || !args.is_empty() {
            LowerExpr::TraitCall {
                trait_ref: reference,
                method_name: name,
                instance_name: Option::None,
                for_ty,
                receiver: if has_receiver {
                    Option::Some(args[0])
                } else {
                    Option::None
                },
                args: if has_receiver {
                    arguments_after_first(args)
                } else {
                    args
                },
                ty,
            }
        } else {
            LowerExpr::Call {
                func: LowerExpr::Callable {
                    callable: tast::Callable::TraitMethod {
                        trait_ref: reference,
                        method_name: name,
                        for_ty,
                        has_receiver,
                    },
                    ty: tast::Type::Error,
                },
                args,
                ty,
            }
        },
        Callable {
            callable: DynTraitMethod {
                trait_name: owner,
                dispatch_name: dispatch,
                method_name: name,
            },
            ty: _,
        } => if !args.is_empty() {
            LowerExpr::DynCall {
                trait_name: owner,
                method_name: dispatch + "#" + name,
                receiver: args[0],
                args: arguments_after_first(args),
                ty,
            }
        } else {
            LowerExpr::Call {
                func: LowerExpr::Callable {
                    callable: tast::Callable::DynTraitMethod {
                        trait_name: owner,
                        dispatch_name: dispatch,
                        method_name: name,
                    },
                    ty: tast::Type::Error,
                },
                args,
                ty,
            }
        },
        Callable {
            callable: InherentMethod { receiver_ty: owner, method_name: name },
            ty: method_ty,
        } => {
            match tast::builtin_numeric_conversion_target(owner, name) {
                Some(target) => if args.len() == 1 {
                    LowerExpr::Cast { expr: args[0], ty: target }
                } else {
                    LowerExpr::Call {
                        func: LowerExpr::Callable {
                            callable: tast::Callable::InherentMethod {
                                receiver_ty: owner,
                                method_name: name,
                            },
                            ty: method_ty,
                        },
                        args,
                        ty,
                    }
                },
                None => LowerExpr::Call {
                    func: LowerExpr::Callable {
                        callable: tast::Callable::InherentMethod {
                            receiver_ty: owner,
                            method_name: name,
                        },
                        ty: method_ty,
                    },
                    args,
                    ty,
                },
            }
        },
        other => LowerExpr::Call { func: lower_expr(ctx, other), args, ty },
    }
}

fn lower_pattern_expr(value: tast::Pat) -> Option[LowerExpr] {
    match value {
        Prim { value: primitive, ty } => Option::Some(LowerExpr::Prim { value: primitive, ty }),
        Constr { constructor, args, ty } => {
            let result: Vec[LowerExpr] = Vec::new();
            for arg in args {
                result.push(lower_pattern_expr(arg)?)
            }
            Option::Some(LowerExpr::Constr { constructor, args: result, ty })
        },
        Tuple { items, ty } => {
            let result: Vec[LowerExpr] = Vec::new();
            for item in items {
                result.push(lower_pattern_expr(item)?)
            }
            Option::Some(LowerExpr::Tuple { items: result, ty })
        },
        _ => Option::None,
    }
}

fn missing_expr(ty: tast::Type) -> LowerExpr {
    let params: Vec[tast::Type] = Vec::new();
    params.push(tast::Type::String);
    let args: Vec[LowerExpr] = Vec::new();
    args.push(
        LowerExpr::Prim { value: tast::Primitive::String { value: "" }, ty: tast::Type::String },
    );
    LowerExpr::Call {
        func: LowerExpr::Callable {
            callable: tast::Callable::Intrinsic("compiler.missing"),
            ty: tast::Type::Func { params, ret_ty: ty },
        },
        args,
        ty,
    }
}

fn bind_match_pattern(
    source_name: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
    ty: tast::Type,
    body: LowerExpr,
) -> LowerExpr {
    match pattern {
        Var { name, is_mut: _, ty: pat_ty } => {
            let stmts: Vec[LowerLetStmt] = Vec::new();
            stmts.push(
                LowerLetStmt {
                    name,
                    value: LowerExpr::Var { name: source_name, ty: source_ty },
                    ty: pat_ty,
                },
            );
            LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(body) }, ty }
        },
        _ => body,
    }
}

fn lower_generic_match(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
    ty: tast::Type,
) -> LowerExpr {
    let result: Vec[LowerArm] = Vec::new();
    let mut default: Option[LowerExpr] = Option::None;
    for arm in arms {
        match arm.pat {
            Wild { ty: _ } | Var { name: _, is_mut: _, ty: _ } => {
                default = Option::Some(
                    bind_match_pattern(
                        source_name,
                        source_ty,
                        arm.pat,
                        ty,
                        lower_expr(ctx, arm.body),
                    ),
                );
            },
            pattern => match lower_pattern_expr(pattern) {
                Some(lhs) => result.push(LowerArm { lhs, body: lower_expr(ctx, arm.body) }),
                None => if default.is_none() {
                    default = Option::Some(lower_expr(ctx, arm.body));
                },
            },
        }
    }
    LowerExpr::Match {
        expr: LowerExpr::Var { name: source_name, ty: source_ty },
        arms: result,
        default,
        ty,
    }
}

fn pattern_matches_bool(value: tast::Pat, expected: bool) -> bool {
    match value {
        Prim { value: Bool { value }, ty: _ } => value == expected,
        Wild { ty: _ } | Var { name: _, is_mut: _, ty: _ } => true,
        _ => false,
    }
}

fn bool_arm(arms: Vec[tast::Arm], expected: bool) -> Option[tast::Arm] {
    for arm in arms {
        if pattern_matches_bool(arm.pat, expected) {
            return Option::Some(arm)
        }
    }
    Option::None
}

fn lower_bool_match(ctx: Lowerer, source_name: string, arms: Vec[tast::Arm], ty: tast::Type) -> LowerExpr {
    let result: Vec[LowerArm] = Vec::new();
    for expected in Vec::from_array([true, false]) {
        let body = match bool_arm(arms, expected) {
            Some(arm) => bind_match_pattern(
                source_name,
                tast::Type::Bool,
                arm.pat,
                ty,
                lower_expr(ctx, arm.body),
            ),
            None => missing_expr(ty),
        };
        result.push(LowerArm { lhs: bool_expr(expected), body })
    }
    LowerExpr::Match {
        expr: LowerExpr::Var { name: source_name, ty: tast::Type::Bool },
        arms: result,
        default: Option::None,
        ty,
    }
}

fn lower_unit_match(ctx: Lowerer, source_name: string, arms: Vec[tast::Arm], ty: tast::Type) -> LowerExpr {
    let body = if !arms.is_empty() {
        let arm = arms[0];
        bind_match_pattern(source_name, tast::Type::Unit, arm.pat, ty, lower_expr(ctx, arm.body))
    } else {
        missing_expr(ty)
    };
    let result: Vec[LowerArm] = Vec::new();
    result.push(
        LowerArm {
            lhs: LowerExpr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit },
            body,
        },
    );
    LowerExpr::Match {
        expr: LowerExpr::Var { name: source_name, ty: tast::Type::Unit },
        arms: result,
        default: Option::None,
        ty,
    }
}

fn lower_match_on_variable(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    arms: Vec[tast::Arm],
    ty: tast::Type,
) -> LowerExpr {
    match nominal_parts(source_ty) {
        Some((name, type_args)) => match find_enum(ctx, name) {
            Some(_) => match pattern_rows_from_arms(source_name, source_ty, arms) {
                Some(rows) => lower_pattern_rows(ctx, rows, ty),
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
            None => match find_struct(ctx, name) {
                Some(_) => match pattern_rows_from_arms(source_name, source_ty, arms) {
                    Some(rows) => lower_pattern_rows(ctx, rows, ty),
                    None => {
                        lower_generic_match(ctx, source_name, source_ty, arms, ty)
                    },
                },
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
        },
        None => match tast::resolve_type(source_ty) {
            Bool => lower_bool_match(ctx, source_name, arms, ty),
            Unit => lower_unit_match(ctx, source_name, arms, ty),
            Tuple { items: _ } => match pattern_rows_from_arms(source_name, source_ty, arms) {
                Some(rows) => lower_pattern_rows(ctx, rows, ty),
                None => lower_generic_match(ctx, source_name, source_ty, arms, ty),
            },
            _ => if primitive_pattern_type(source_ty) {
                match pattern_rows_from_arms(source_name, source_ty, arms) {
                    Some(rows) => lower_pattern_rows(ctx, rows, ty),
                    None => {
                        lower_generic_match(ctx, source_name, source_ty, arms, ty)
                    },
                }
            } else {
                lower_generic_match(ctx, source_name, source_ty, arms, ty)
            },
        },
    }
}

fn lower_match(ctx: Lowerer, source: tast::Expr, arms: Vec[tast::Arm], ty: tast::Type) -> LowerExpr {
    let source_ty = tast::expr_type(source);
    if arms_require_ordered(arms) {
        lower_ordered_match(ctx, source, arms, ty)
    } else if arms.is_empty() {
        let source_value = lower_expr(ctx, source);
        let source_name = gensym(ctx, "_wild");
        let stmts: Vec[LowerLetStmt] = Vec::new();
        stmts.push(LowerLetStmt { name: source_name, value: source_value, ty: source_ty });
        LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(missing_expr(ty)) }, ty }
    } else {
        match source {
            Var { name: source_name, ty: _ } => {
                lower_match_on_variable(ctx, source_name, source_ty, arms, ty)
            },
            other => {
                let source_name = gensym(ctx, "mtmp");
                let source_value = lower_expr(ctx, other);
                let body = lower_match_on_variable(ctx, source_name, source_ty, arms, ty);
                let stmts: Vec[LowerLetStmt] = Vec::new();
                stmts.push(LowerLetStmt { name: source_name, value: source_value, ty: source_ty });
                LowerExpr::Block { block: LowerBlock { stmts, tail: Option::Some(body) }, ty }
            },
        }
    }
}

fn lower_index(ctx: Lowerer, base: tast::Expr, index: tast::Expr, ty: tast::Type) -> LowerExpr {
    let base_ty = tast::expr_type(base);
    let index_ty = tast::expr_type(index);
    let callable = match tast::resolve_type(base_ty) {
        Array { len: _, elem: _ } => tast::Callable::Intrinsic("array.get"),
        VecType { elem: _ } => tast::Callable::Intrinsic("vec.get"),
        Slice { elem: _ } => tast::Callable::Intrinsic("slice.get"),
        MutSlice { elem: _ } => tast::Callable::Intrinsic("mut_slice.get"),
        HashMap { key: _, value: _ } => tast::Callable::Intrinsic("hashmap.get"),
        String => match resources::runtime_abi_by_hook(
            resources::RuntimeHook::Core(resources::CoreRuntimeHook::StringGet),
        ) {
            Some(spec) => tast::Callable::Runtime(spec.key),
            None => tast::Callable::Intrinsic("compiler.missing"),
        },
        _ => tast::Callable::Intrinsic("compiler.missing"),
    };
    let params: Vec[tast::Type] = Vec::new();
    params.push(base_ty);
    params.push(index_ty);
    let args: Vec[LowerExpr] = Vec::new();
    args.push(lower_expr(ctx, base));
    args.push(lower_expr(ctx, index));
    LowerExpr::Call {
        func: LowerExpr::Callable { callable, ty: tast::Type::Func { params, ret_ty: ty } },
        args,
        ty,
    }
}

fn lower_field(ctx: Lowerer, value: tast::Expr, name: string, ty: tast::Type) -> LowerExpr {
    let owner = inherent_base(ctx.builtin, tast::expr_type(value));
    match find_struct(ctx, owner) {
        Some(definition) => {
            let fields: Vec[string] = Vec::new();
            let mut field_index = 0;
            for index in 0..definition.fields.len() {
                let field = definition.fields[index];
                fields.push(field.0);
                if field.0 == name {
                    field_index = index;
                }
            }
            LowerExpr::ConstrGet {
                expr: lower_expr(ctx, value),
                constructor: tast::Constructor {
                    name: owner,
                    fields,
                    is_struct: true,
                    tag: Option::None,
                },
                field_index,
                ty,
            }
        },
        None => {
            let fields: Vec[string] = Vec::new();
            fields.push(name);
            LowerExpr::ConstrGet {
                expr: lower_expr(ctx, value),
                constructor: tast::Constructor {
                    name: owner,
                    fields,
                    is_struct: true,
                    tag: Option::None,
                },
                field_index: 0,
                ty,
            }
        },
    }
}

fn direct_for_body(
    ctx: Lowerer,
    pattern: tast::Pat,
    index_name: string,
    item_value: LowerExpr,
    body: tast::Expr,
) -> LowerExpr {
    let item_ty = tast::pat_type(pattern);
    let item_name = gensym(ctx, "for_item");
    let advance_name = gensym(ctx, "_wild");
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(LowerLetStmt { name: item_name, value: item_value, ty: item_ty });
    stmts.push(
        LowerLetStmt {
            name: advance_name,
            value: LowerExpr::Assign {
                name: index_name,
                value: LowerExpr::Binary {
                    op: ast::BinaryOp::Add,
                    lhs: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: ordered_int(1),
                    ty: tast::Type::Int,
                },
                target_ty: tast::Type::Int,
                ty: tast::Type::Unit,
            },
            ty: tast::Type::Unit,
        },
    );
    LowerExpr::Block {
        block: LowerBlock {
            stmts,
            tail: Option::Some(
                lower_pattern_continuation(
                    ctx,
                    item_name,
                    item_ty,
                    pattern,
                    body,
                    Option::None,
                    tast::Type::Unit,
                ),
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_for_loop(
    ctx: Lowerer,
    pattern: tast::Pat,
    source_stmts: Vec[LowerLetStmt],
    index_name: string,
    limit_name: string,
    item_value: LowerExpr,
    body: tast::Expr,
) -> LowerExpr {
    LowerExpr::Block {
        block: LowerBlock {
            stmts: source_stmts,
            tail: Option::Some(
                LowerExpr::While {
                    cond: LowerExpr::Binary {
                        op: ast::BinaryOp::Less,
                        lhs: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                        rhs: LowerExpr::Var { name: limit_name, ty: tast::Type::Int },
                        ty: tast::Type::Bool,
                    },
                    body: direct_for_body(ctx, pattern, index_name, item_value, body),
                    ty: tast::Type::Unit,
                },
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_range_for(ctx: Lowerer, pattern: tast::Pat, args: Vec[tast::Expr], body: tast::Expr) -> Option[
    LowerExpr,
] {
    if args.len() != 2 {
        Option::None
    } else {
        let index_name = gensym(ctx, "for_index");
        let limit_name = gensym(ctx, "for_limit");
        let stmts: Vec[LowerLetStmt] = Vec::new();
        stmts.push(
            LowerLetStmt { name: index_name, value: lower_expr(ctx, args[0]), ty: tast::Type::Int },
        );
        stmts.push(
            LowerLetStmt { name: limit_name, value: lower_expr(ctx, args[1]), ty: tast::Type::Int },
        );
        Option::Some(
            direct_for_loop(
                ctx,
                pattern,
                stmts,
                index_name,
                limit_name,
                LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                body,
            ),
        )
    }
}

fn direct_inclusive_range_body(
    ctx: Lowerer,
    pattern: tast::Pat,
    index_name: string,
    limit_name: string,
    done_name: string,
    body: tast::Expr,
) -> LowerExpr {
    let item_ty = tast::pat_type(pattern);
    let item_name = gensym(ctx, "for_item");
    let advance_name = gensym(ctx, "_wild");
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(
        LowerLetStmt {
            name: item_name,
            value: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
            ty: item_ty,
        },
    );
    stmts.push(
        LowerLetStmt {
            name: advance_name,
            value: LowerExpr::If {
                cond: LowerExpr::Binary {
                    op: ast::BinaryOp::Eq,
                    lhs: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: LowerExpr::Var { name: limit_name, ty: tast::Type::Int },
                    ty: tast::Type::Bool,
                },
                then_branch: LowerExpr::Assign {
                    name: done_name,
                    value: bool_expr(true),
                    target_ty: tast::Type::Bool,
                    ty: tast::Type::Unit,
                },
                else_branch: LowerExpr::Assign {
                    name: index_name,
                    value: LowerExpr::Binary {
                        op: ast::BinaryOp::Add,
                        lhs: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                        rhs: ordered_int(1),
                        ty: tast::Type::Int,
                    },
                    target_ty: tast::Type::Int,
                    ty: tast::Type::Unit,
                },
                ty: tast::Type::Unit,
            },
            ty: tast::Type::Unit,
        },
    );
    LowerExpr::Block {
        block: LowerBlock {
            stmts,
            tail: Option::Some(
                lower_pattern_continuation(
                    ctx,
                    item_name,
                    item_ty,
                    pattern,
                    body,
                    Option::None,
                    tast::Type::Unit,
                ),
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn direct_inclusive_range_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    args: Vec[tast::Expr],
    body: tast::Expr,
) -> Option[LowerExpr] {
    if args.len() != 2 {
        Option::None
    } else {
        let index_name = gensym(ctx, "for_index");
        let limit_name = gensym(ctx, "for_limit");
        let done_name = gensym(ctx, "for_done");
        let stmts: Vec[LowerLetStmt] = Vec::new();
        stmts.push(
            LowerLetStmt { name: index_name, value: lower_expr(ctx, args[0]), ty: tast::Type::Int },
        );
        stmts.push(
            LowerLetStmt { name: limit_name, value: lower_expr(ctx, args[1]), ty: tast::Type::Int },
        );
        stmts.push(
            LowerLetStmt {
                name: done_name,
                value: LowerExpr::Binary {
                    op: ast::BinaryOp::Greater,
                    lhs: LowerExpr::Var { name: index_name, ty: tast::Type::Int },
                    rhs: LowerExpr::Var { name: limit_name, ty: tast::Type::Int },
                    ty: tast::Type::Bool,
                },
                ty: tast::Type::Bool,
            },
        );
        Option::Some(
            LowerExpr::Block {
                block: LowerBlock {
                    stmts,
                    tail: Option::Some(
                        LowerExpr::While {
                            cond: LowerExpr::Unary {
                                op: ast::UnaryOp::Not,
                                expr: LowerExpr::Var { name: done_name, ty: tast::Type::Bool },
                                ty: tast::Type::Bool,
                            },
                            body: direct_inclusive_range_body(
                                ctx,
                                pattern,
                                index_name,
                                limit_name,
                                done_name,
                                body,
                            ),
                            ty: tast::Type::Unit,
                        },
                    ),
                },
                ty: tast::Type::Unit,
            },
        )
    }
}

fn direct_container_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    container_ty: tast::Type,
    len_intrinsic: string,
    get_intrinsic: string,
    body: tast::Expr,
) -> LowerExpr {
    let item_ty = tast::pat_type(pattern);
    let source_name = gensym(ctx, "for_source");
    let limit_name = gensym(ctx, "for_limit");
    let index_name = gensym(ctx, "for_index");
    let len_params: Vec[tast::Type] = Vec::new();
    len_params.push(container_ty);
    let len_args: Vec[LowerExpr] = Vec::new();
    len_args.push(LowerExpr::Var { name: source_name, ty: container_ty });
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(
        LowerLetStmt { name: source_name, value: lower_expr(ctx, iterator), ty: container_ty },
    );
    stmts.push(
        LowerLetStmt {
            name: limit_name,
            value: place_intrinsic_call(len_intrinsic, len_params, tast::Type::Int, len_args),
            ty: tast::Type::Int,
        },
    );
    stmts.push(LowerLetStmt { name: index_name, value: ordered_int(0), ty: tast::Type::Int });
    let get_params: Vec[tast::Type] = Vec::new();
    get_params.push(container_ty);
    get_params.push(tast::Type::Int);
    let get_args: Vec[LowerExpr] = Vec::new();
    get_args.push(LowerExpr::Var { name: source_name, ty: container_ty });
    get_args.push(LowerExpr::Var { name: index_name, ty: tast::Type::Int });
    direct_for_loop(
        ctx,
        pattern,
        stmts,
        index_name,
        limit_name,
        place_intrinsic_call(get_intrinsic, get_params, item_ty, get_args),
        body,
    )
}

fn direct_array_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    container_ty: tast::Type,
    length: isize,
    body: tast::Expr,
) -> LowerExpr {
    let item_ty = tast::pat_type(pattern);
    let source_name = gensym(ctx, "for_source");
    let limit_name = gensym(ctx, "for_limit");
    let index_name = gensym(ctx, "for_index");
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(
        LowerLetStmt { name: source_name, value: lower_expr(ctx, iterator), ty: container_ty },
    );
    stmts.push(LowerLetStmt { name: limit_name, value: ordered_int(length), ty: tast::Type::Int });
    stmts.push(LowerLetStmt { name: index_name, value: ordered_int(0), ty: tast::Type::Int });
    let get_params: Vec[tast::Type] = Vec::new();
    get_params.push(container_ty);
    get_params.push(tast::Type::Int);
    let get_args: Vec[LowerExpr] = Vec::new();
    get_args.push(LowerExpr::Var { name: source_name, ty: container_ty });
    get_args.push(LowerExpr::Var { name: index_name, ty: tast::Type::Int });
    direct_for_loop(
        ctx,
        pattern,
        stmts,
        index_name,
        limit_name,
        place_intrinsic_call("array.get", get_params, item_ty, get_args),
        body,
    )
}

fn lower_direct_for(ctx: Lowerer, pattern: tast::Pat, iterator: tast::Expr, body: tast::Expr) -> Option[
    LowerExpr,
] {
    match iterator {
        Call {
            func: Callable { callable: LangItem { item, function_name: _ }, ty: _ },
            args,
            ty: _,
        } if item == ctx.builtin.range.item => {
            direct_range_for(ctx, pattern, args, body)
        },
        Call {
            func: Callable { callable: LangItem { item, function_name: _ }, ty: _ },
            args,
            ty: _,
        } if item == ctx.builtin.range_inclusive.item => {
            direct_inclusive_range_for(ctx, pattern, args, body)
        },
        other => {
            let container_ty = tast::resolve_type(tast::expr_type(other));
            match container_ty {
                Array { len, elem: _ } => Option::Some(
                    direct_array_for(ctx, pattern, other, container_ty, len, body),
                ),
                VecType { elem: _ } => Option::Some(
                    direct_container_for(
                        ctx,
                        pattern,
                        other,
                        container_ty,
                        "vec.len",
                        "vec.get",
                        body,
                    ),
                ),
                Slice { elem: _ } => Option::Some(
                    direct_container_for(
                        ctx,
                        pattern,
                        other,
                        container_ty,
                        "slice.len",
                        "slice.get",
                        body,
                    ),
                ),
                MutSlice { elem: _ } => Option::Some(
                    direct_container_for(
                        ctx,
                        pattern,
                        other,
                        container_ty,
                        "mut_slice.len",
                        "mut_slice.get",
                        body,
                    ),
                ),
                _ => Option::None,
            }
        },
    }
}

fn lower_iterator_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    into_iterator: tast::TraitRef,
    iterator_trait: tast::TraitRef,
    iterator_ty: tast::Type,
    body: tast::Expr,
) -> LowerExpr {
    let item_ty = tast::pat_type(pattern);
    let option_args: Vec[tast::Type] = Vec::new();
    option_args.push(item_ty);
    let option_name = ctx.builtin.option.name;
    let some_name = ctx.builtin.option.some.name;
    let none_name = ctx.builtin.option.none.name;
    let option_ty = tast::Type::App { ty: tast::Type::Con { name: option_name }, args: option_args };
    let iterator_name = gensym(ctx, "for_iter");
    let next_name = gensym(ctx, "for_next");
    let no_args: Vec[LowerExpr] = Vec::new();
    let iterator_receiver = lower_expr(ctx, iterator);
    let iterator_for_ty = lower_expr_type(iterator_receiver);
    let iterator_value = LowerExpr::TraitCall {
        trait_ref: into_iterator,
        method_name: ctx.builtin.into_iterator.method,
        instance_name: Option::None,
        for_ty: iterator_for_ty,
        receiver: Option::Some(iterator_receiver),
        args: no_args,
        ty: iterator_ty,
    };
    let next_args: Vec[LowerExpr] = Vec::new();
    let next_value = LowerExpr::TraitCall {
        trait_ref: iterator_trait,
        method_name: ctx.builtin.iterator.next,
        instance_name: Option::None,
        for_ty: iterator_ty,
        receiver: Option::Some(LowerExpr::Var { name: iterator_name, ty: iterator_ty }),
        args: next_args,
        ty: option_ty,
    };
    let some_patterns: Vec[tast::Pat] = Vec::new();
    some_patterns.push(pattern);
    let arms: Vec[tast::Arm] = Vec::new();
    arms.push(
        tast::Arm {
            pat: tast::Pat::Constr {
                constructor: tast::Constructor {
                    name: option_name + "::" + some_name,
                    fields: Vec::new(),
                    is_struct: false,
                    tag: Option::Some(ctx.builtin.option.some.tag),
                },
                args: some_patterns,
                ty: option_ty,
            },
            guard: Option::None,
            body,
        },
    );
    arms.push(
        tast::Arm {
            pat: tast::Pat::Constr {
                constructor: tast::Constructor {
                    name: option_name + "::" + none_name,
                    fields: Vec::new(),
                    is_struct: false,
                    tag: Option::Some(ctx.builtin.option.none.tag),
                },
                args: Vec::new(),
                ty: option_ty,
            },
            guard: Option::None,
            body: tast::Expr::Break { target: 0, value: Option::None, ty: tast::Type::Unit },
        },
    );
    let loop_stmts: Vec[LowerLetStmt] = Vec::new();
    loop_stmts.push(LowerLetStmt { name: next_name, value: next_value, ty: option_ty });
    let loop_body = LowerExpr::Block {
        block: LowerBlock {
            stmts: loop_stmts,
            tail: Option::Some(
                lower_match_on_variable(ctx, next_name, option_ty, arms, tast::Type::Unit),
            ),
        },
        ty: tast::Type::Unit,
    };
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(LowerLetStmt { name: iterator_name, value: iterator_value, ty: iterator_ty });
    LowerExpr::Block {
        block: LowerBlock {
            stmts,
            tail: Option::Some(
                LowerExpr::While { cond: bool_expr(true), body: loop_body, ty: tast::Type::Unit },
            ),
        },
        ty: tast::Type::Unit,
    }
}

fn lower_for(
    ctx: Lowerer,
    pattern: tast::Pat,
    iterator: tast::Expr,
    into_iterator: tast::TraitRef,
    iterator_trait: tast::TraitRef,
    iterator_ty: tast::Type,
    body: tast::Expr,
) -> LowerExpr {
    if ctx.optimize_builtin_iterators {
        match lower_direct_for(ctx, pattern, iterator, body) {
            Some(value) => value,
            None => lower_iterator_for(
                ctx,
                pattern,
                iterator,
                into_iterator,
                iterator_trait,
                iterator_ty,
                body,
            ),
        }
    } else {
        lower_iterator_for(ctx, pattern, iterator, into_iterator, iterator_trait, iterator_ty, body)
    }
}

fn lower_expr(ctx: Lowerer, value: tast::Expr) -> LowerExpr {
    match value {
        Var { name, ty } => LowerExpr::Var { name, ty },
        Callable { callable: Function(name), ty } | Callable {
            callable: LangItem { item: _, function_name: name },
            ty,
        } => {
            LowerExpr::Var { name, ty }
        },
        Callable { callable: Intrinsic("compile_error"), ty } => {
            LowerExpr::Callable { callable: tast::Callable::Intrinsic("compiler.missing"), ty }
        },
        Callable { callable, ty } => LowerExpr::Callable { callable, ty },
        Prim { value, ty } => LowerExpr::Prim { value, ty },
        Constr { constructor, args, ty } => {
            LowerExpr::Constr { constructor, args: lower_exprs(ctx, args), ty }
        },
        Tuple { items, ty } => LowerExpr::Tuple { items: lower_exprs(ctx, items), ty },
        Array { items, ty } => LowerExpr::Array { items: lower_exprs(ctx, items), ty },
        Closure { params, body, ty } => {
            let saved_cleanups: Vec[tast::Expr] = Vec::new();
            for value in ctx.cleanups {
                saved_cleanups.push(value)
            }
            let saved_loop_depths: Vec[isize] = Vec::new();
            for value in ctx.loop_cleanup_depths {
                saved_loop_depths.push(value)
            }
            let saved_cleanup_lowering_depth = ctx.cleanup_lowering_depth.get();
            ctx.cleanups.truncate(0);
            ctx.loop_cleanup_depths.truncate(0);
            ctx.cleanup_lowering_depth.set(0);
            let body = lower_expr(ctx, body);
            for value in saved_cleanups {
                ctx.cleanups.push(value)
            }
            for value in saved_loop_depths {
                ctx.loop_cleanup_depths.push(value)
            }
            ctx.cleanup_lowering_depth.set(saved_cleanup_lowering_depth);
            LowerExpr::Closure { params, body, ty }
        },
        Block { block, ty } => LowerExpr::Block { block: lower_block(ctx, block, ty), ty },
        Comptime { .. } => LowerExpr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Error },
        Match { expr: source, arms, ty, .. } => lower_match(ctx, source, arms, ty),
        Select { mode, arms, ty } => {
            let lowered_arms: Vec[LowerSelectArm] = Vec::with_capacity(arms.len());
            let default: Ref[Option[LowerExpr]] = Ref::new(Option::None);
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, binding_ty, body } => lowered_arms.push(
                        LowerSelectArm::Receive {
                            channel: lower_expr(ctx, channel),
                            guard: guard.map(|value| lower_expr(ctx, value)),
                            binding,
                            binding_ty,
                            body: lower_expr(ctx, body),
                        },
                    ),
                    Send { channel, value, guard, body } => lowered_arms.push(
                        LowerSelectArm::Send {
                            channel: lower_expr(ctx, channel),
                            value: lower_expr(ctx, value),
                            guard: guard.map(|value| lower_expr(ctx, value)),
                            body: lower_expr(ctx, body),
                        },
                    ),
                    Default { body } => default.set(Option::Some(lower_expr(ctx, body))),
                }
            }
            LowerExpr::Select { mode, arms: lowered_arms, default: default.get(), ty }
        },
        If { cond, then_branch, else_branch, ty } => LowerExpr::If {
            cond: lower_expr(ctx, cond),
            then_branch: lower_expr(ctx, then_branch),
            else_branch: lower_expr(ctx, else_branch),
            ty,
        },
        While { cond, body, ty } => {
            let cond = lower_expr(ctx, cond);
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let body = lower_expr(ctx, body);
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            LowerExpr::While { cond, body, ty }
        },
        Loop { body, ty } => {
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let body = lower_expr(ctx, body);
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            LowerExpr::Loop { body, ty }
        },
        For {
            pat: pattern,
            iterator,
            into_iter_trait_ref: into_iterator,
            iterator_trait_ref: iterator_trait,
            iterator_ty,
            body,
            ty: _,
        } => {
            ctx.loop_cleanup_depths.push(ctx.cleanups.len());
            let result = lower_for(
                ctx,
                pattern,
                iterator,
                into_iterator,
                iterator_trait,
                iterator_ty,
                body,
            );
            ctx.loop_cleanup_depths.truncate(ctx.loop_cleanup_depths.len() - 1);
            result
        },
        Break { target, value, ty } => lower_break(ctx, target, value, ty),
        Continue { target, ty } => lower_continue(ctx, target, ty),
        Return { expr: value, ty } => lower_return(ctx, value, ty),
        Go { expr: value, ty } => LowerExpr::Go { expr: lower_expr(ctx, value), ty },
        Call { func: function, args, ty } => lower_call(ctx, function, args, ty),
        Unary { op: Neg, expr: Prim { value, ty: _ }, ty } => {
            match negated_integer(value) {
                Some(primitive) => LowerExpr::Prim { value: primitive, ty },
                None => LowerExpr::Unary {
                    op: ast::UnaryOp::Neg,
                    expr: lower_expr(ctx, tast::Expr::Prim { value, ty }),
                    ty,
                },
            }
        },
        Unary { op, expr: value, ty } => LowerExpr::Unary { op, expr: lower_expr(ctx, value), ty },
        Cast { expr: value, ty } => LowerExpr::Cast { expr: lower_expr(ctx, value), ty },
        Proj { tuple: value, index, ty } => if tast_expr_exits(value) {
            exit_expr_as(ctx, lower_expr(ctx, value), ty)
        } else {
            LowerExpr::Proj { tuple: lower_expr(ctx, value), index, ty }
        },
        Field { expr: value, field_name: name, ty } => if tast_expr_exits(value) {
            exit_expr_as(ctx, lower_expr(ctx, value), ty)
        } else {
            lower_field(ctx, value, name, ty)
        },
        Index { base, index, ty } => if tast_expr_exits(base) {
            exit_expr_as(ctx, lower_expr(ctx, base), ty)
        } else if tast_expr_exits(index) {
            let base_ty = tast::expr_type(base);
            let base_value = lower_expr(ctx, base);
            let index_value = lower_expr(ctx, index);
            let stmts: Vec[LowerLetStmt] = Vec::new();
            stmts.push(LowerLetStmt { name: gensym(ctx, "_wild"), value: base_value, ty: base_ty });
            LowerExpr::Block {
                block: LowerBlock { stmts, tail: Option::Some(exit_expr_as(ctx, index_value, ty)) },
                ty,
            }
        } else {
            lower_index(ctx, base, index, ty)
        },
        Binary { op: And, lhs: left, rhs: right, ty, resolution: _ } => LowerExpr::If {
            cond: lower_expr(ctx, left),
            then_branch: lower_expr(ctx, right),
            else_branch: bool_expr(false),
            ty,
        },
        Binary { op: Or, lhs: left, rhs: right, ty, resolution: _ } => LowerExpr::If {
            cond: lower_expr(ctx, left),
            then_branch: bool_expr(true),
            else_branch: lower_expr(ctx, right),
            ty,
        },
        Binary { op, lhs: left, rhs: right, ty: _, resolution: Overloaded { trait_name } } => if match op {
            Eq | NotEq => true,
            _ => false,
        } {
            lower_eq_expr(ctx, trait_name, op, left, right)
        } else {
            lower_order_expr(ctx, trait_name, op, left, right)
        },
        Binary { op, lhs: left, rhs: right, ty, resolution: _ } => {
            LowerExpr::Binary { op, lhs: lower_expr(ctx, left), rhs: lower_expr(ctx, right), ty }
        },
        ToDyn { trait_name: name, for_ty, expr: value, ty } => {
            LowerExpr::ToDyn { trait_name: name, for_ty, expr: lower_expr(ctx, value), ty }
        },
    }
}

fn lower_cleanup_stmts(ctx: Lowerer, start: isize) -> Vec[LowerLetStmt] {
    let result: Vec[LowerLetStmt] = Vec::new();
    let mut index = ctx.cleanups.len();
    while index > start {
        index -= 1;
        ctx.cleanup_lowering_depth.set(ctx.cleanup_lowering_depth.get() + 1);
        let value = lower_expr(ctx, ctx.cleanups[index]);
        ctx.cleanup_lowering_depth.set(ctx.cleanup_lowering_depth.get() - 1);
        result.push(LowerLetStmt { name: gensym(ctx, "_defer"), value, ty: tast::Type::Unit })
    }
    result
}

fn lower_break(ctx: Lowerer, target: isize, value: Option[tast::Expr], ty: tast::Type) -> LowerExpr {
    let start = if ctx.loop_cleanup_depths.is_empty() {
        0
    } else {
        ctx.loop_cleanup_depths[ctx.loop_cleanup_depths.len() - 1 - target]
    };
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.len() == start {
        LowerExpr::Break { target, value: value.map(|expr| lower_expr(ctx, expr)), ty }
    } else {
        match value {
            Some(source) => {
                let value_ty = tast::expr_type(source);
                let name = gensym(ctx, "defer_break");
                let stmts: Vec[LowerLetStmt] = Vec::new();
                stmts.push(LowerLetStmt { name, value: lower_expr(ctx, source), ty: value_ty });
                for stmt in lower_cleanup_stmts(ctx, start) {
                    stmts.push(stmt)
                }
                LowerExpr::Block {
                    block: LowerBlock {
                        stmts,
                        tail: Option::Some(
                            LowerExpr::Break {
                                target,
                                value: Option::Some(LowerExpr::Var { name, ty: value_ty }),
                                ty,
                            },
                        ),
                    },
                    ty,
                }
            },
            None => LowerExpr::Block {
                block: LowerBlock {
                    stmts: lower_cleanup_stmts(ctx, start),
                    tail: Option::Some(LowerExpr::Break { target, value: Option::None, ty }),
                },
                ty,
            },
        }
    }
}

fn lower_continue(ctx: Lowerer, target: isize, ty: tast::Type) -> LowerExpr {
    let start = if ctx.loop_cleanup_depths.is_empty() {
        0
    } else {
        ctx.loop_cleanup_depths[ctx.loop_cleanup_depths.len() - 1 - target]
    };
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.len() == start {
        LowerExpr::Continue { target, ty }
    } else {
        LowerExpr::Block {
            block: LowerBlock {
                stmts: lower_cleanup_stmts(ctx, start),
                tail: Option::Some(LowerExpr::Continue { target, ty }),
            },
            ty,
        }
    }
}

fn lower_return(ctx: Lowerer, value: Option[tast::Expr], ty: tast::Type) -> LowerExpr {
    if ctx.cleanup_lowering_depth.get() > 0 || ctx.cleanups.is_empty() {
        LowerExpr::Return { expr: value.map(|expr| lower_expr(ctx, expr)), ty }
    } else {
        match value {
            Some(source) => {
                let value_ty = tast::expr_type(source);
                let name = gensym(ctx, "defer_return");
                let stmts: Vec[LowerLetStmt] = Vec::new();
                stmts.push(LowerLetStmt { name, value: lower_expr(ctx, source), ty: value_ty });
                for stmt in lower_cleanup_stmts(ctx, 0) {
                    stmts.push(stmt)
                }
                LowerExpr::Block {
                    block: LowerBlock {
                        stmts,
                        tail: Option::Some(
                            LowerExpr::Return {
                                expr: Option::Some(LowerExpr::Var { name, ty: value_ty }),
                                ty,
                            },
                        ),
                    },
                    ty,
                }
            },
            None => LowerExpr::Block {
                block: LowerBlock {
                    stmts: lower_cleanup_stmts(ctx, 0),
                    tail: Option::Some(LowerExpr::Return { expr: Option::None, ty }),
                },
                ty,
            },
        }
    }
}

fn prepend_stmt(value: LowerLetStmt, rest: LowerBlock) -> LowerBlock {
    let stmts: Vec[LowerLetStmt] = Vec::new();
    stmts.push(value);
    for stmt in rest.stmts {
        stmts.push(stmt)
    }
    LowerBlock { stmts, tail: rest.tail }
}

fn remaining_tast_block(
    ctx: Lowerer,
    stmts: Vec[tast::Stmt],
    index: isize,
    tail: Option[tast::Expr],
    ty: tast::Type,
    cleanup_start: isize,
) -> tast::Expr {
    let remaining: Vec[tast::Stmt] = Vec::new();
    for current in index..stmts.len() {
        remaining.push(stmts[current])
    }
    if ctx.cleanups.len() == cleanup_start {
        return tast::Expr::Block { block: tast::Block { stmts: remaining, tail }, ty }
    }
    let tail = match tail {
        Some(value) => {
            let value_ty = tast::expr_type(value);
            let name = gensym(ctx, "defer_tast_result");
            let stmts: Vec[tast::Stmt] = Vec::new();
            stmts.push(
                tast::Stmt::Let {
                    is_mut: false,
                    pat: tast::Pat::Var { name, is_mut: false, ty: value_ty },
                    value,
                },
            );
            let mut cleanup_index = ctx.cleanups.len();
            while cleanup_index > cleanup_start {
                cleanup_index -= 1;
                stmts.push(tast::Stmt::Expr { expr: ctx.cleanups[cleanup_index] })
            }
            Option::Some(
                tast::Expr::Block {
                    block: tast::Block {
                        stmts,
                        tail: Option::Some(tast::Expr::Var { name, ty: value_ty }),
                    },
                    ty: value_ty,
                },
            )
        },
        None => {
            let mut cleanup_index = ctx.cleanups.len();
            while cleanup_index > cleanup_start {
                cleanup_index -= 1;
                remaining.push(tast::Stmt::Expr { expr: ctx.cleanups[cleanup_index] })
            }
            Option::None
        },
    };
    tast::Expr::Block { block: tast::Block { stmts: remaining, tail }, ty }
}

fn lower_pattern_continuation(
    ctx: Lowerer,
    source_name: string,
    source_ty: tast::Type,
    pattern: tast::Pat,
    body: tast::Expr,
    failure: Option[tast::Expr],
    ty: tast::Type,
) -> LowerExpr {
    if pattern_requires_ordered(pattern) {
        lower_ordered_pattern(
            ctx,
            pattern,
            LowerExpr::Var { name: source_name, ty: source_ty },
            lower_expr(ctx, body),
            match failure {
                Some(value) => lower_expr(ctx, value),
                None => missing_expr(ty),
            },
            ty,
        )
    } else {
        let columns: Vec[PatternColumn] = Vec::new();
        columns.push(PatternColumn { source: source_name, source_ty, pattern });
        let rows: Vec[PatternRow] = Vec::new();
        rows.push(PatternRow { columns, bindings: Vec::new(), body });
        if let Some(value) = failure {
            let fallback_columns: Vec[PatternColumn] = Vec::new();
            fallback_columns.push(
                PatternColumn {
                    source: source_name,
                    source_ty,
                    pattern: tast::Pat::Wild { ty: source_ty },
                },
            );
            rows.push(PatternRow { columns: fallback_columns, bindings: Vec::new(), body: value })
        }
        lower_pattern_rows(ctx, rows, ty)
    }
}

fn lower_block_from(
    ctx: Lowerer,
    stmts: Vec[tast::Stmt],
    index: isize,
    tail: Option[tast::Expr],
    ty: tast::Type,
    cleanup_start: isize,
) -> LowerBlock {
    if index >= stmts.len() {
        if ctx.cleanups.len() == cleanup_start {
            LowerBlock { stmts: Vec::new(), tail: tail.map(|value| lower_expr(ctx, value)) }
        } else {
            match tail {
                Some(value) => if tast_expr_exits(value) {
                    LowerBlock { stmts: Vec::new(), tail: Option::Some(lower_expr(ctx, value)) }
                } else {
                    let value_ty = tast::expr_type(value);
                    let name = gensym(ctx, "defer_result");
                    let result: Vec[LowerLetStmt] = Vec::new();
                    result.push(LowerLetStmt { name, value: lower_expr(ctx, value), ty: value_ty });
                    for stmt in lower_cleanup_stmts(ctx, cleanup_start) {
                        result.push(stmt)
                    }
                    LowerBlock {
                        stmts: result,
                        tail: Option::Some(LowerExpr::Var { name, ty: value_ty }),
                    }
                },
                None => LowerBlock {
                    stmts: lower_cleanup_stmts(ctx, cleanup_start),
                    tail: Option::None,
                },
            }
        }
    } else {
        match stmts[index] {
            Defer { expr } => {
                let closure_ty = tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit };
                let body = lower_expr(
                    ctx,
                    tast::Expr::Closure { params: Vec::new(), body: expr, ty: closure_ty },
                );
                let cleanup = tast::Expr::Call {
                    func: tast::Expr::Callable {
                        callable: tast::Callable::Runtime("core.defer.pop"),
                        ty: closure_ty,
                    },
                    args: Vec::new(),
                    ty: tast::Type::Unit,
                };
                ctx.cleanups.push(cleanup);
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(
                    LowerLetStmt {
                        name: gensym(ctx, "_defer_register"),
                        value: LowerExpr::Call {
                            func: LowerExpr::Callable {
                                callable: tast::Callable::Runtime("core.defer.push"),
                                ty: tast::Type::Func {
                                    params: Vec::from_array([closure_ty]),
                                    ret_ty: tast::Type::Unit,
                                },
                            },
                            args: Vec::from_array([body]),
                            ty: tast::Type::Unit,
                        },
                        ty: tast::Type::Unit,
                    },
                    rest,
                )
            },
            Let { is_mut: _, pat: Var { name, is_mut: _, ty: pat_ty }, value } => {
                let core_value = lower_expr(ctx, value);
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(LowerLetStmt { name, value: core_value, ty: pat_ty }, rest)
            },
            Let { is_mut: _, pat: pattern, value } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "mtmp");
                match plan_flat_pattern(ctx, name, pattern) {
                    Some(plan) => {
                        let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                        let result: Vec[LowerLetStmt] = Vec::new();
                        result.push(LowerLetStmt { name, value: core_value, ty: value_ty });
                        LowerBlock {
                            stmts: result,
                            tail: Option::Some(
                                apply_pattern_plan(plan, LowerExpr::Block { block: rest, ty }, ty),
                            ),
                        }
                    },
                    None => {
                        let body = remaining_tast_block(
                            ctx,
                            stmts,
                            index + 1,
                            tail,
                            ty,
                            cleanup_start,
                        );
                        let matched = lower_pattern_continuation(
                            ctx,
                            name,
                            value_ty,
                            pattern,
                            body,
                            Option::None,
                            ty,
                        );
                        let result: Vec[LowerLetStmt] = Vec::new();
                        result.push(LowerLetStmt { name, value: core_value, ty: value_ty });
                        LowerBlock { stmts: result, tail: Option::Some(matched) }
                    },
                }
            },
            LetElse { is_mut: _, pat: pattern, value, else_branch } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "mtmp");
                let body = remaining_tast_block(ctx, stmts, index + 1, tail, ty, cleanup_start);
                let matched = lower_pattern_continuation(
                    ctx,
                    name,
                    value_ty,
                    pattern,
                    body,
                    Option::Some(else_branch),
                    ty,
                );
                let result: Vec[LowerLetStmt] = Vec::new();
                result.push(LowerLetStmt { name, value: core_value, ty: value_ty });
                LowerBlock { stmts: result, tail: Option::Some(matched) }
            },
            Expr { expr: value } => {
                let value_ty = tast::expr_type(value);
                let core_value = lower_expr(ctx, value);
                let name = gensym(ctx, "_wild");
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(LowerLetStmt { name, value: core_value, ty: value_ty }, rest)
            },
            Assign { target, op, value } => {
                let action = lower_assignment(ctx, target, op, value);
                let binding = gensym(ctx, "_wild");
                let rest = lower_block_from(ctx, stmts, index + 1, tail, ty, cleanup_start);
                prepend_stmt(
                    LowerLetStmt { name: binding, value: action, ty: tast::Type::Unit },
                    rest,
                )
            },
        }
    }
}

fn lower_block(ctx: Lowerer, value: tast::Block, ty: tast::Type) -> LowerBlock {
    let cleanup_start = ctx.cleanups.len();
    let result = lower_block_from(ctx, value.stmts, 0, value.tail, ty, cleanup_start);
    ctx.cleanups.truncate(cleanup_start);
    result
}

fn lower_function(
    ctx: Lowerer,
    name: string,
    origin: LowerFunctionOrigin,
    trait_impl: Option[LowerTraitImpl],
    value: tast::Function,
    retain_generics: bool,
) -> LowerFunction {
    let hidden_cells = hidden_mutable_cells(value.body);
    let body = lower_block(ctx, value.body, value.ret_ty);
    LowerFunction {
        name,
        origin,
        root: true,
        generics: if retain_generics {
            value.generics
        } else {
            Vec::new()
        },
        predicates: value.predicates,
        trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: if hidden_cells.is_empty() {
            body
        } else {
            lower_hidden_block(body, hidden_cells)
        },
    }
}

fn lower_marker_trait_witness(block: tast::ImplBlock, reference: tast::TraitRef) -> LowerFunction {
    LowerFunction {
        name: trait_impl_method_name(reference, block.for_type, "__marker"),
        origin: LowerFunctionOrigin::TraitImplementation { method_name: "__marker" },
        root: false,
        generics: block.generics,
        predicates: block.predicates,
        trait_impl: Option::Some(
            LowerTraitImpl {
                trait_ref: reference,
                for_ty: block.for_type,
                associated_types: block.associated_types,
                generic_count: block.generics.len(),
                predicate_count: block.predicates.len(),
            },
        ),
        params: Vec::new(),
        ret_ty: tast::Type::Unit,
        body: LowerBlock {
            stmts: Vec::new(),
            tail: Option::Some(
                LowerExpr::Prim { value: tast::Primitive::Unit, ty: tast::Type::Unit },
            ),
        },
    }
}

fn lower_file_with_types(
    builtin: tast::BuiltinContract,
    value: tast::File,
    counter: Ref[isize],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
) -> LowerFile {
    let enums = value.enums;
    let structs = value.structs;
    let all_enums: Vec[tast::EnumDef] = Vec::new();
    for definition in dependency_enums {
        all_enums.push(definition)
    }
    for definition in enums {
        all_enums.push(definition)
    }
    let all_structs: Vec[tast::StructDef] = Vec::new();
    for definition in dependency_structs {
        all_structs.push(definition)
    }
    for definition in structs {
        all_structs.push(definition)
    }
    let ctx = Lowerer {
        builtin,
        counter,
        enums: all_enums,
        structs: all_structs,
        optimize_builtin_iterators,
        cleanups: Vec::new(),
        loop_cleanup_depths: Vec::new(),
        cleanup_lowering_depth: Ref::new(0),
    };
    let functions: Vec[LowerFunction] = Vec::new();
    for item in value.items {
        match item {
            Function(function) => match function.comptime {
                tast::ComptimeCapability::Derive => (),
                _ => functions.push(
                    lower_function(
                        ctx,
                        function.name,
                        LowerFunctionOrigin::Source,
                        Option::None,
                        function,
                        true,
                    ),
                ),
            },
            ImplBlock(block) => if block.methods.is_empty() {
                if let Some(reference) = block.trait_ref {
                    functions.push(lower_marker_trait_witness(block, reference))
                }
            } else {
                for method in block.methods {
                    let numeric_conversion = match block.trait_ref {
                        Some(_) => false,
                        None => tast::builtin_numeric_conversion_target(block.for_type, method.name).is_some(),
                    };
                    if numeric_conversion {
                        continue
                    }
                    let trait_impl = block.trait_ref.map(
                        |reference| LowerTraitImpl {
                            trait_ref: reference,
                            for_ty: block.for_type,
                            associated_types: block.associated_types,
                            generic_count: block.generics.len(),
                            predicate_count: block.predicates.len(),
                        },
                    );
                    let name = impl_method_name(ctx.builtin, block, method.name);
                    let origin = match block.trait_ref {
                        Some(_) => LowerFunctionOrigin::TraitImplementation {
                            method_name: method.name,
                        },
                        None => LowerFunctionOrigin::Inherent {
                            owner: block.for_type,
                            method_name: method.name,
                        },
                    };
                    functions.push(lower_function(ctx, name, origin, trait_impl, method, true))
                }
            },
        }
    }
    LowerFile {
        functions,
        enums,
        structs,
        type_instances: Vec::new(),
        constants: value.constants,
        statics: value.statics,
    }
}

fn lower_file(builtin: tast::BuiltinContract, value: tast::File, counter: Ref[isize]) -> LowerFile {
    lower_file_with_types(builtin, value, counter, Vec::new(), Vec::new(), false)
}

fn empty_lower_file() -> LowerFile {
    LowerFile {
        functions: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
    }
}

fn lower_raw_with_counter_types_and_options(
    value: tast::CheckResult,
    counter: Ref[isize],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
) -> LowerFile {
    match value.tast {
        Some(file) => match tast::builtin_contract() {
            Ok(builtin) => lower_file_with_types(
                builtin,
                file,
                counter,
                dependency_enums,
                dependency_structs,
                optimize_builtin_iterators,
            ),
            Err(_) => empty_lower_file(),
        },
        None => empty_lower_file(),
    }
}

pub fn lower_with_counter_types_and_options(
    value: tast::CheckResult,
    counter: Ref[isize],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
    optimize_builtin_iterators: bool,
) -> File {
    detach_file(
        lower_raw_with_counter_types_and_options(
            value,
            counter,
            dependency_enums,
            dependency_structs,
            optimize_builtin_iterators,
        ),
    )
}

pub fn lower_with_counter_and_types(
    value: tast::CheckResult,
    counter: Ref[isize],
    dependency_enums: Vec[tast::EnumDef],
    dependency_structs: Vec[tast::StructDef],
) -> File {
    lower_with_counter_types_and_options(
        value,
        counter,
        dependency_enums,
        dependency_structs,
        false,
    )
}

pub fn lower_with_counter(value: tast::CheckResult, counter: Ref[isize]) -> File {
    detach_file(
        match value.tast {
            Some(file) => match tast::builtin_contract() {
                Ok(builtin) => lower_file(builtin, file, counter),
                Err(_) => empty_lower_file(),
            },
            None => empty_lower_file(),
        },
    )
}

pub fn lower(value: tast::CheckResult) -> File {
    lower_with_counter(value, Ref::new(0))
}

pub fn impl_method_name(builtin: tast::BuiltinContract, block: tast::ImplBlock, name: string) -> string {
    match block.trait_ref {
        Some(reference) => trait_impl_method_name(reference, block.for_type, name),
        None => inherent_method_name(builtin, block.for_type, name),
    }
}
