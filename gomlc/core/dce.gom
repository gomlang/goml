package core;

use module::ast;
use std::collections;

type DceNames = collections::IndexSet[string];

fn new_dce_names() -> DceNames {
    collections::IndexSet::new()
}

fn dce_names_contains(values: DceNames, name: string) -> bool {
    values.contains(name)
}

fn dce_names_add(values: DceNames, name: string) -> () {
    let _ = values.insert(name);
}

fn dce_names_add_all(target: DceNames, values: DceNames) -> () {
    for name in values {
        dce_names_add(target, name)
    }
}

fn dce_names_remove(values: DceNames, name: string) -> () {
    let _ = values.remove(name);
}

fn dce_exprs(values: Vec[Expr]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::with_capacity(values.len());
    for value in values {
        result.push(dce_expr(value))
    }
    result
}

fn dce_optional_expr(value: Option[Expr]) -> Option[Expr] {
    value.map(|value| dce_expr(value))
}

fn dce_arms(values: Vec[Arm]) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(Arm { lhs: value.lhs, body: dce_expr(value.body) })
    }
    result
}

fn dce_select_arms(values: Vec[SelectArm]) -> Vec[SelectArm] {
    let result: Vec[SelectArm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            match value {
                Receive { channel, guard, binding, binding_ty, body } => SelectArm::Receive {
                    channel: dce_expr(channel),
                    guard: dce_optional_expr(guard),
                    binding,
                    binding_ty,
                    body: dce_expr(body),
                },
                Send { channel, value, guard, body } => SelectArm::Send {
                    channel: dce_expr(channel),
                    value: dce_expr(value),
                    guard: dce_optional_expr(guard),
                    body: dce_expr(body),
                },
            },
        )
    }
    result
}

fn dce_expr(value: Expr) -> Expr {
    match value {
        Var { name, ty } => Expr::Var { name, ty },
        Callable { callable, ty } => Expr::Callable { callable, ty },
        Prim { value, ty } => Expr::Prim { value, ty },
        Constr { constructor, args, ty } => {
            Expr::Constr { constructor, args: dce_exprs(args), ty }
        },
        Tuple { items, ty } => Expr::Tuple { items: dce_exprs(items), ty },
        Array { items, ty } => Expr::Array { items: dce_exprs(items), ty },
        Closure { params, body, ty } => {
            Expr::Closure { params, body: dce_expr(body), ty }
        },
        Block { block, ty } => Expr::Block { block: dce_block(block), ty },
        Match { expr, arms, default, ty } => Expr::Match {
            expr: dce_expr(expr),
            arms: dce_arms(arms),
            default: dce_optional_expr(default),
            ty,
        },
        Select { mode, arms, default, ty } => Expr::Select {
            mode,
            arms: dce_select_arms(arms),
            default: dce_optional_expr(default),
            ty,
        },
        If { cond, then_branch, else_branch, ty } => Expr::If {
            cond: dce_expr(cond),
            then_branch: dce_expr(then_branch),
            else_branch: dce_expr(else_branch),
            ty,
        },
        While { cond, body, ty } => {
            Expr::While { cond: dce_expr(cond), body: dce_expr(body), ty }
        },
        Loop { body, ty } => Expr::Loop { body: dce_expr(body), ty },
        Break { target, value, ty } => {
            Expr::Break { target, value: dce_optional_expr(value), ty }
        },
        Continue { target, ty } => Expr::Continue { target, ty },
        Return { expr, ty } => Expr::Return { expr: dce_optional_expr(expr), ty },
        Go { expr, ty } => Expr::Go { expr: dce_expr(expr), ty },
        ConstrGet { expr, constructor, field_index, ty } => Expr::ConstrGet {
            expr: dce_expr(expr),
            constructor,
            field_index,
            ty,
        },
        Unary { op, expr, ty } => Expr::Unary { op, expr: dce_expr(expr), ty },
        Cast { expr, ty } => Expr::Cast { expr: dce_expr(expr), ty },
        Binary { op, lhs, rhs, ty } => {
            Expr::Binary { op, lhs: dce_expr(lhs), rhs: dce_expr(rhs), ty }
        },
        Assign { name, value, target_ty, ty } => Expr::Assign {
            name,
            value: dce_expr(value),
            target_ty,
            ty,
        },
        Call { func, args, ty } => {
            Expr::Call { func: dce_expr(func), args: dce_exprs(args), ty }
        },
        ToDyn { trait_name, for_ty, expr, ty } => Expr::ToDyn {
            trait_name,
            for_ty,
            expr: dce_expr(expr),
            ty,
        },
        DynCall { trait_name, method_name, receiver, args, ty } => Expr::DynCall {
            trait_name,
            method_name,
            receiver: dce_expr(receiver),
            args: dce_exprs(args),
            ty,
        },
        TraitCall { trait_ref, method_name, instance_name, for_ty, receiver, args, ty } => Expr::TraitCall {
            trait_ref,
            method_name,
            instance_name,
            for_ty,
            receiver: dce_optional_expr(receiver),
            args: dce_exprs(args),
            ty,
        },
        Proj { tuple, index, ty } => Expr::Proj { tuple: dce_expr(tuple), index, ty },
    }
}

fn dce_pattern_names(value: Expr, result: DceNames) -> () {
    match value {
        Var { name, ty: _ } => dce_names_add(result, name),
        Constr { constructor: _, args, ty: _ } => for value in args {
            dce_pattern_names(value, result)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } => for value in items {
            dce_pattern_names(value, result)
        },
        Callable { .. } | Prim { .. } | Closure { .. } | Block { .. } | Match { .. } | Select { .. } | If {
            ..,
        } | While { .. } | Loop { .. } | Break { .. } | Continue { .. } | Return { .. } | Go { .. } | ConstrGet {
            ..,
        } | Unary { .. } | Cast { .. } | Binary { .. } | Assign { .. } | Call { .. } | ToDyn { .. } | DynCall {
            ..,
        } | TraitCall { .. } | Proj { .. } => (),
    }
}

fn dce_collect_exprs(result: DceNames, values: Vec[Expr]) -> () {
    for value in values {
        dce_collect_expr(result, value)
    }
}

fn dce_collect_optional_expr(result: DceNames, value: Option[Expr]) -> () {
    if let Some(value) = value {
        dce_collect_expr(result, value)
    }
}

fn dce_collect_block(result: DceNames, value: Block) -> () {
    let free = dce_free_block(value);
    dce_names_add_all(result, free)
}

fn dce_collect_expr(result: DceNames, value: Expr) -> () {
    match value {
        Var { name, ty: _ } => dce_names_add(result, name),
        Callable { .. } | Prim { .. } => (),
        Constr { constructor: _, args, ty: _ } => dce_collect_exprs(result, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => dce_collect_exprs(result, items),
        Closure { params, body, ty: _ } => {
            let free = new_dce_names();
            dce_collect_expr(free, body);
            for param in params {
                dce_names_remove(free, param.name)
            }
            dce_names_add_all(result, free)
        },
        Block { block, ty: _ } => dce_collect_block(result, block),
        Match { expr, arms, default, ty: _ } => {
            dce_collect_expr(result, expr);
            for arm in arms {
                let free = new_dce_names();
                dce_collect_expr(free, arm.body);
                let bound = new_dce_names();
                dce_pattern_names(arm.lhs, bound);
                for name in bound {
                    dce_names_remove(free, name)
                }
                dce_names_add_all(result, free)
            }
            dce_collect_optional_expr(result, default)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, binding_ty: _, body } => {
                        dce_collect_expr(result, channel);
                        dce_collect_optional_expr(result, guard);
                        let free = new_dce_names();
                        dce_collect_expr(free, body);
                        dce_names_remove(free, binding);
                        dce_names_add_all(result, free)
                    },
                    Send { channel, value, guard, body } => {
                        dce_collect_expr(result, channel);
                        dce_collect_expr(result, value);
                        dce_collect_optional_expr(result, guard);
                        dce_collect_expr(result, body)
                    },
                }
            }
            dce_collect_optional_expr(result, default)
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            dce_collect_expr(result, cond);
            dce_collect_expr(result, then_branch);
            dce_collect_expr(result, else_branch)
        },
        While { cond, body, ty: _ } => {
            dce_collect_expr(result, cond);
            dce_collect_expr(result, body)
        },
        Loop { body, ty: _ } => dce_collect_expr(result, body),
        Break { target: _, value, ty: _ } => dce_collect_optional_expr(result, value),
        Continue { .. } => (),
        Return { expr, ty: _ } => dce_collect_optional_expr(result, expr),
        Go { expr, ty: _ } => dce_collect_expr(result, expr),
        ConstrGet { expr, .. } | Unary { expr, .. } | Cast { expr, .. } | ToDyn { expr, .. } => {
            dce_collect_expr(result, expr)
        },
        Binary { op: _, lhs, rhs, ty: _ } => {
            dce_collect_expr(result, lhs);
            dce_collect_expr(result, rhs)
        },
        Assign { name, value, .. } => {
            dce_names_add(result, name);
            dce_collect_expr(result, value)
        },
        Call { func, args, ty: _ } => {
            dce_collect_expr(result, func);
            dce_collect_exprs(result, args)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            dce_collect_expr(result, receiver);
            dce_collect_exprs(result, args)
        },
        TraitCall { receiver, args, .. } => {
            dce_collect_optional_expr(result, receiver);
            dce_collect_exprs(result, args)
        },
        Proj { tuple, index: _, ty: _ } => dce_collect_expr(result, tuple),
    }
}

fn dce_free_block(value: Block) -> DceNames {
    let result = new_dce_names();
    dce_collect_optional_expr(result, value.tail);
    let mut index = value.stmts.len();
    while index > 0 {
        index -= 1;
        let stmt = value.stmts[index];
        dce_names_remove(result, stmt.name);
        dce_collect_expr(result, stmt.value)
    }
    result
}

fn dce_exprs_discardable(values: Vec[Expr]) -> bool {
    for value in values {
        if dce_expr_discardable(value) {} else {
            return false
        }
    }
    true
}

fn dce_optional_expr_discardable(value: Option[Expr]) -> bool {
    match value {
        Some(value) => dce_expr_discardable(value),
        None => true,
    }
}

fn dce_binary_discardable(value: ast::BinaryOp) -> bool {
    match value {
        Div | Rem | Shl | Shr => false,
        Add | Sub | Mul | BitAnd | BitOr | BitXor | And | Or | Less | Greater | LessEq | GreaterEq | Eq | NotEq => true,
    }
}

fn dce_block_discardable(value: Block) -> bool {
    for stmt in value.stmts {
        if dce_expr_discardable(stmt.value) {} else {
            return false
        }
    }
    dce_optional_expr_discardable(value.tail)
}

fn dce_expr_discardable(value: Expr) -> bool {
    match value {
        Var { .. } | Callable { .. } | Prim { .. } | Closure { .. } => true,
        Constr { args, .. } => dce_exprs_discardable(args),
        Tuple { items, .. } | Array { items, .. } => dce_exprs_discardable(items),
        Block { block, .. } => dce_block_discardable(block),
        Match { expr, arms, default, .. } => {
            if dce_expr_discardable(expr) && dce_optional_expr_discardable(default) {} else {
                return false
            }
            for arm in arms {
                if dce_expr_discardable(arm.body) {} else {
                    return false
                }
            }
            true
        },
        If { cond, then_branch, else_branch, .. } => dce_expr_discardable(cond)
            && dce_expr_discardable(then_branch)
            && dce_expr_discardable(else_branch),
        ConstrGet { expr, .. } | Unary { expr, .. } | Cast { expr, .. } | ToDyn { expr, .. } => {
            dce_expr_discardable(expr)
        },
        Binary { op, lhs, rhs, .. } => dce_binary_discardable(op) && dce_expr_discardable(lhs)
            && dce_expr_discardable(rhs),
        Proj { tuple, .. } => dce_expr_discardable(tuple),
        Select { .. } | While { .. } | Loop { .. } | Break { .. } | Continue { .. } | Return { .. } | Go {
            ..,
        } | Assign { .. } | Call { .. } | DynCall { .. } | TraitCall { .. } => false,
    }
}

fn dce_reverse_stmts(values: Vec[LetStmt]) -> Vec[LetStmt] {
    let result: Vec[LetStmt] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        result.push(values[values.len() - index - 1])
    }
    result
}

fn dce_block(value: Block) -> Block {
    let tail = dce_optional_expr(value.tail);
    let live = new_dce_names();
    dce_collect_optional_expr(live, tail);
    let result: Vec[LetStmt] = Vec::with_capacity(value.stmts.len());
    let mut index = value.stmts.len();
    while index > 0 {
        index -= 1;
        let stmt = value.stmts[index];
        let lowered = LetStmt { name: stmt.name, value: dce_expr(stmt.value), ty: stmt.ty };
        if dce_names_contains(live, lowered.name) {
            dce_names_remove(live, lowered.name);
            dce_collect_expr(live, lowered.value);
            result.push(lowered)
        } else if dce_expr_discardable(lowered.value) {} else {
            dce_collect_expr(live, lowered.value);
            result.push(lowered)
        }
    }
    Block { stmts: dce_reverse_stmts(result), tail }
}

fn dce_function(value: Function) -> Function {
    Function {
        name: value.name,
        origin: value.origin,
        root: value.root,
        generics: value.generics,
        predicates: value.predicates,
        trait_impl: value.trait_impl,
        params: value.params,
        ret_ty: value.ret_ty,
        body: dce_block(value.body),
    }
}

pub fn eliminate_dead_locals(value: File) -> File {
    let functions: Vec[Function] = Vec::with_capacity(value.functions.len());
    for function in value.functions {
        functions.push(dce_function(function))
    }
    File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
    }
}

struct DceFunctions {
    functions: HashMap[string, Function],
    inherent_methods: HashMap[string, Vec[string]],
    trait_functions: HashMap[string, Vec[string]],
    trait_methods: HashMap[string, Vec[string]],
    trait_names: DceNames,
    reachable: DceNames,
    pending: Vec[string],
}

fn dce_function_names_add(values: HashMap[string, Vec[string]], key: string, name: string) -> () {
    values.entry(key).or_insert_with(|| Vec::new()).push(name)
}

fn dce_trait_method_key(trait_name: string, method_name: string) -> string {
    f"{trait_name.byte_len()}:{trait_name}{method_name}"
}

fn dce_functions_context(value: File) -> DceFunctions {
    let functions: HashMap[string, Function] = HashMap::new();
    let inherent_methods: HashMap[string, Vec[string]] = HashMap::new();
    let trait_functions: HashMap[string, Vec[string]] = HashMap::new();
    let trait_methods: HashMap[string, Vec[string]] = HashMap::new();
    let trait_names = new_dce_names();
    for function in value.functions {
        functions[function.name] = function;
        match function.origin {
            Inherent { owner: _, method_name } => {
                dce_function_names_add(inherent_methods, method_name, function.name)
            },
            TraitImplementation { method_name } => match function.trait_impl {
                Some(metadata) => {
                    dce_names_add(trait_names, metadata.trait_ref.name);
                    dce_function_names_add(trait_functions, metadata.trait_ref.name, function.name);
                    dce_function_names_add(
                        trait_methods,
                        dce_trait_method_key(metadata.trait_ref.name, method_name),
                        function.name,
                    )
                },
                None => (),
            },
            Source => (),
        }
    }
    DceFunctions {
        functions,
        inherent_methods,
        trait_functions,
        trait_methods,
        trait_names,
        reachable: new_dce_names(),
        pending: Vec::new(),
    }
}

fn dce_retain_function(ctx: DceFunctions, name: string) -> () {
    if ctx.functions.contains(name) && ctx.reachable.insert(name) {
        ctx.pending.push(name)
    }
}

fn dce_retain_indexed_functions(
    ctx: DceFunctions,
    values: HashMap[string, Vec[string]],
    key: string,
) -> () {
    if let Some(names) = values[key] {
        for name in names {
            dce_retain_function(ctx, name)
        }
    }
}

fn dce_retain_inherent_methods(ctx: DceFunctions, method_name: string) -> () {
    dce_retain_indexed_functions(ctx, ctx.inherent_methods, method_name)
}

fn dce_retain_trait_functions(ctx: DceFunctions, trait_name: string) -> () {
    dce_retain_indexed_functions(ctx, ctx.trait_functions, trait_name)
}

fn dce_retain_trait_methods(ctx: DceFunctions, trait_name: string, method_name: string) -> () {
    dce_retain_indexed_functions(
        ctx,
        ctx.trait_methods,
        dce_trait_method_key(trait_name, method_name),
    )
}

fn dce_runtime_trait_name(value: string) -> bool {
    value == "PartialEq" || value.ends_with("::PartialEq") || value == "Hash"
        || value.ends_with("::Hash")
}

fn dce_retain_runtime_trait_functions(ctx: DceFunctions) -> () {
    for name in ctx.trait_names {
        if dce_runtime_trait_name(name) {
            dce_retain_trait_functions(ctx, name)
        }
    }
}

fn dce_collect_types(ctx: DceFunctions, values: Vec[Type]) -> () {
    for value in values {
        dce_collect_type(ctx, value)
    }
}

fn dce_collect_named_types(ctx: DceFunctions, values: Vec[(string, Type)]) -> () {
    for value in values {
        dce_collect_type(ctx, value.1)
    }
}

fn dce_collect_trait_ref_types(ctx: DceFunctions, value: TraitRef) -> () {
    dce_collect_types(ctx, value.args)
}

fn dce_collect_dyn_bounds(ctx: DceFunctions, values: Vec[DynTraitBound]) -> () {
    for value in values {
        dce_retain_trait_functions(ctx, value.trait_name);
        dce_collect_types(ctx, value.args);
        dce_collect_named_types(ctx, value.associated_types)
    }
}

fn dce_collect_type(ctx: DceFunctions, value: Type) -> () {
    match value {
        External { import_path: _, name: _, args } => dce_collect_types(ctx, args),
        Tuple { items } => dce_collect_types(ctx, items),
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            dce_retain_trait_functions(ctx, trait_name);
            dce_collect_types(ctx, args);
            dce_collect_named_types(ctx, associated_types);
            dce_collect_dyn_bounds(ctx, additional_bounds)
        },
        Projection { for_ty, name: _, trait_ref } => {
            dce_collect_type(ctx, for_ty);
            if let Some(reference) = trait_ref {
                dce_retain_trait_functions(ctx, reference.name);
                dce_collect_trait_ref_types(ctx, reference)
            }
        },
        App { ty, args } => {
            dce_collect_type(ctx, ty);
            dce_collect_types(ctx, args)
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | Channel {
            elem,
            direction: _,
        } => dce_collect_type(ctx, elem),
        GoPointer { elem } => dce_collect_type(ctx, elem),
        GoFunction { signature } => dce_collect_type(ctx, signature),
        RefType { elem } => {
            dce_retain_runtime_trait_functions(ctx);
            dce_collect_type(ctx, elem)
        },
        HashMap { key, value } => {
            dce_retain_runtime_trait_functions(ctx);
            dce_collect_type(ctx, key);
            dce_collect_type(ctx, value)
        },
        GoMap { key, value } => {
            dce_retain_runtime_trait_functions(ctx);
            dce_collect_type(ctx, key);
            dce_collect_type(ctx, value)
        },
        Func { params, ret_ty } => {
            dce_collect_types(ctx, params);
            dce_collect_type(ctx, ret_ty)
        },
        Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Con {
            ..,
        } | Param { .. } | Error => (),
    }
}

fn dce_collect_callable(ctx: DceFunctions, value: Callable) -> () {
    match value {
        Function(name) => dce_retain_function(ctx, name),
        FunctionInstance { name, bindings } => {
            dce_retain_function(ctx, name);
            for binding in bindings {
                dce_collect_type(ctx, binding.1)
            }
        },
        LangItem { item: _, function_name } => dce_retain_function(ctx, function_name),
        TraitMethod { trait_ref, method_name, for_ty, has_receiver: _ } => {
            dce_retain_trait_methods(ctx, trait_ref.name, method_name);
            dce_collect_trait_ref_types(ctx, trait_ref);
            dce_collect_type(ctx, for_ty)
        },
        DynTraitMethod { trait_name, dispatch_name: _, method_name: _ } => {
            dce_retain_trait_functions(ctx, trait_name)
        },
        InherentMethod { receiver_ty, method_name } => {
            dce_retain_inherent_methods(ctx, method_name);
            dce_collect_type(ctx, receiver_ty)
        },
        Runtime(_) | Intrinsic(_) | GoForeign { .. } | GoMethod { .. } | GoInterfaceBridge { .. } => (),
    }
}

fn dce_collect_function_exprs(ctx: DceFunctions, values: Vec[Expr]) -> () {
    for value in values {
        dce_collect_function_expr(ctx, value)
    }
}

fn dce_collect_optional_function_expr(ctx: DceFunctions, value: Option[Expr]) -> () {
    if let Some(value) = value {
        dce_collect_function_expr(ctx, value)
    }
}

fn dce_collect_function_block(ctx: DceFunctions, value: Block) -> () {
    for stmt in value.stmts {
        dce_collect_type(ctx, stmt.ty);
        dce_collect_function_expr(ctx, stmt.value)
    }
    dce_collect_optional_function_expr(ctx, value.tail)
}

fn dce_collect_function_select_arms(ctx: DceFunctions, values: Vec[SelectArm]) -> () {
    for value in values {
        match value {
            Receive { channel, guard, binding: _, binding_ty, body } => {
                dce_collect_function_expr(ctx, channel);
                dce_collect_optional_function_expr(ctx, guard);
                dce_collect_type(ctx, binding_ty);
                dce_collect_function_expr(ctx, body)
            },
            Send { channel, value, guard, body } => {
                dce_collect_function_expr(ctx, channel);
                dce_collect_function_expr(ctx, value);
                dce_collect_optional_function_expr(ctx, guard);
                dce_collect_function_expr(ctx, body)
            },
        }
    }
}

fn dce_collect_function_expr(ctx: DceFunctions, value: Expr) -> () {
    dce_collect_type(ctx, expr_type(value));
    match value {
        Var { name, ty: _ } => dce_retain_function(ctx, name),
        Callable { callable, ty: _ } => dce_collect_callable(ctx, callable),
        Prim { .. } | Continue { .. } => (),
        Constr { args, .. } | Tuple { items: args, .. } | Array { items: args, .. } => {
            dce_collect_function_exprs(ctx, args)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                dce_collect_type(ctx, param.ty)
            }
            dce_collect_function_expr(ctx, body)
        },
        Block { block, ty: _ } => dce_collect_function_block(ctx, block),
        Match { expr, arms, default, ty: _ } => {
            dce_collect_function_expr(ctx, expr);
            for arm in arms {
                dce_collect_function_expr(ctx, arm.body)
            }
            dce_collect_optional_function_expr(ctx, default)
        },
        Select { arms, default, .. } => {
            dce_collect_function_select_arms(ctx, arms);
            dce_collect_optional_function_expr(ctx, default)
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            dce_collect_function_expr(ctx, cond);
            dce_collect_function_expr(ctx, then_branch);
            dce_collect_function_expr(ctx, else_branch)
        },
        While { cond, body, ty: _ } => {
            dce_collect_function_expr(ctx, cond);
            dce_collect_function_expr(ctx, body)
        },
        Loop { body, ty: _ } => dce_collect_function_expr(ctx, body),
        Break { target: _, value, ty: _ } => dce_collect_optional_function_expr(ctx, value),
        Return { expr, ty: _ } => dce_collect_optional_function_expr(ctx, expr),
        Go { expr, ty: _ } | ConstrGet { expr, .. } | Unary { expr, .. } | Cast { expr, .. } | Proj {
            tuple: expr,
            ..,
        } => dce_collect_function_expr(ctx, expr),
        Binary { op: _, lhs, rhs, ty: _ } => {
            dce_collect_function_expr(ctx, lhs);
            dce_collect_function_expr(ctx, rhs)
        },
        Assign { name: _, value, target_ty, ty: _ } => {
            dce_collect_function_expr(ctx, value);
            dce_collect_type(ctx, target_ty)
        },
        Call { func, args, ty: _ } => {
            dce_collect_function_expr(ctx, func);
            dce_collect_function_exprs(ctx, args)
        },
        ToDyn { trait_name, for_ty, expr, ty: _ } => {
            dce_retain_trait_functions(ctx, trait_name);
            dce_collect_type(ctx, for_ty);
            dce_collect_function_expr(ctx, expr)
        },
        DynCall { trait_name, method_name: _, receiver, args, ty: _ } => {
            dce_retain_trait_functions(ctx, trait_name);
            dce_collect_function_expr(ctx, receiver);
            dce_collect_function_exprs(ctx, args)
        },
        TraitCall { trait_ref, method_name, instance_name, for_ty, receiver, args, ty: _ } => {
            dce_retain_trait_methods(ctx, trait_ref.name, method_name);
            if let Some(name) = instance_name {
                dce_retain_function(ctx, name)
            }
            dce_collect_trait_ref_types(ctx, trait_ref);
            dce_collect_type(ctx, for_ty);
            dce_collect_optional_function_expr(ctx, receiver);
            dce_collect_function_exprs(ctx, args)
        },
    }
}

fn dce_collect_function_predicates(ctx: DceFunctions, values: Vec[TypePredicate]) -> () {
    for value in values {
        match value {
            GoComparable(ty) => dce_collect_type(ctx, ty),
            Trait { for_ty, trait_ref } => {
                dce_retain_trait_functions(ctx, trait_ref.name);
                dce_collect_type(ctx, for_ty);
                dce_collect_trait_ref_types(ctx, trait_ref)
            },
            Equality { lhs, rhs } => {
                dce_collect_type(ctx, lhs);
                dce_collect_type(ctx, rhs)
            },
        }
    }
}

fn dce_collect_function(ctx: DceFunctions, value: Function) -> () {
    for param in value.params {
        dce_collect_type(ctx, param.1)
    }
    dce_collect_type(ctx, value.ret_ty);
    dce_collect_function_predicates(ctx, value.predicates);
    if let Some(metadata) = value.trait_impl {
        dce_collect_trait_ref_types(ctx, metadata.trait_ref);
        dce_collect_type(ctx, metadata.for_ty);
        dce_collect_named_types(ctx, metadata.associated_types)
    }
    dce_collect_function_block(ctx, value.body)
}

pub fn eliminate_unreachable_functions(value: File) -> File {
    let ctx = dce_functions_context(value);
    for function in value.functions {
        if function.root {
            dce_retain_function(ctx, function.name)
        }
    }
    let mut index = 0;
    while index < ctx.pending.len() {
        let name = ctx.pending[index];
        index += 1;
        if let Some(function) = ctx.functions[name] {
            dce_collect_function(ctx, function)
        }
    }
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        if dce_names_contains(ctx.reachable, function.name) {
            functions.push(function)
        }
    }
    File {
        functions,
        enums: value.enums,
        structs: value.structs,
        type_instances: value.type_instances,
        constants: value.constants,
        statics: value.statics,
    }
}
