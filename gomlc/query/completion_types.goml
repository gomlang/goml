package query;

use module::tast;

fn completion_type_head(value: tast::Type) -> tast::Type {
    match value {
        Var(variable) => match variable.get() {
            Link(inner) => completion_type_head(inner),
            Unbound { kind: Integer, .. } => Int,
            Unbound { kind: Float, .. } => Float64,
            Unbound { kind: Any, .. } => Error,
        },
        other => other,
    }
}

fn completion_type_matches(
    pattern: tast::Type,
    receiver: tast::Type,
    generics: Vec[string],
    bindings: Vec[(string, tast::Type)],
) -> bool {
    let pattern = completion_type_head(pattern);
    let receiver = completion_type_head(receiver);
    if let Error = receiver {
        return true
    }
    if let Param { name } = pattern {
        if generics.contains(name) {
            for binding in bindings {
                if binding.0 == name {
                    return completion_type_matches(binding.1, receiver, Vec::new(), Vec::new())
                }
            }
            bindings.push((name, receiver));
            return true
        }
    }
    let left: Vec[tast::Type] = Vec::new();
    let right: Vec[tast::Type] = Vec::new();
    let left_shape = match pattern {
        App { ty, args } => {
            left.push(ty);
            for arg in args {
                left.push(arg)
            }
            tast::Type::App { ty: tast::Type::Unit, args: Vec::new() }
        },
        other => tast::map_child_types(
            other,
            |child| {
                left.push(child);
                tast::Type::Unit
            },
        ),
    };
    let right_shape = match receiver {
        App { ty, args } => {
            right.push(ty);
            for arg in args {
                right.push(arg)
            }
            tast::Type::App { ty: tast::Type::Unit, args: Vec::new() }
        },
        other => tast::map_child_types(
            other,
            |child| {
                right.push(child);
                tast::Type::Unit
            },
        ),
    };
    if !tast::types_equal(left_shape, right_shape) || left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !completion_type_matches(left[index], right[index], generics, bindings) {
            return false
        }
    }
    true
}

fn completion_receiver_matches(pattern: tast::Type, receiver: tast::Type, generics: Vec[string]) -> bool {
    completion_type_matches(pattern, receiver, generics, Vec::new())
}
