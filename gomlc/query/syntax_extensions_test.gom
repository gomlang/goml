package query;

use std::testing;

#[test]
fn syntax_extensions_contextual_constructor_navigation() -> () {
    let source = "enum A { Value(isize), Empty, Named { field: isize } } enum B { Value(string), Empty, Named { field: string } } fn a() -> B { Value(\"ok\") } fn b() -> B { Named { field: \"ok\" } } fn c() -> B { Empty } fn d() -> (string) -> B { Value } fn main() -> () { let _ = a(); let _ = b(); let _ = c(); let _ = d(); }";
    let value = analyze("main.gom", source);
    assert_no_diagnostics(value);
    for target in Vec::from_array(
        [
            ("Value(\"ok\")", "Value(string)"),
            ("Named { field: \"ok\" }", "Named { field: string }"),
            ("Empty }", "Empty, Named { field: string }"),
            ("Value }", "Value(string)"),
        ],
    ) {
        let offset = source.rfind(target.0).unwrap_or(-1);
        let expected = source.find(target.1).unwrap_or(-1);
        let Some(definition) = goto_definition(value, offset) else {
            testing::fail("expected contextual constructor definition");
            return
        };
        testing::assert_eq(definition.span.start, expected)
    }
}

#[test]
fn syntax_extensions_condition_chain_local_navigation() -> () {
    let source = "fn f(input: Option[isize]) -> isize { if let Some(item) = input && let Some(next) = Option::Some(item) && next > 0 { next } else { 0 } } fn main() -> () { let _ = f(Option::Some(1)); }";
    let value = analyze("main.gom", source);
    assert_no_diagnostics(value);
    assert_local_navigation(value, source, "item");
    assert_local_navigation(value, source, "next")
}
