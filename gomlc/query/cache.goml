package query;

use module::diagnostic;
use module::ctir;
use module::project_info;
use module::ast;
use module::parser;
use module::hash;
use module::hir;
use module::expand;
use module::tast;
use module::checker;
use std::collections;
use std::text;

struct CachedPreparedSource {
    source: string,
    module_path: string,
    lowered: ast::LowerResult,
}

fn copied_lower_result(value: ast::LowerResult) -> ast::LowerResult {
    let diagnostics = Vec::new();
    for diagnostic in value.diagnostics {
        diagnostics.push(diagnostic)
    }
    ast::LowerResult { diagnostics, ..value }
}

fn prepared_source(context: AnalysisContext, file: SourceFile, module_path: string) -> ast::LowerResult {
    if let Some(cached) = context.prepared_sources.get(file.path) {
        if cached.source == file.source && cached.module_path == module_path {
            return copied_lower_result(cached.lowered)
        }
    }
    let lowered = ast::resolve_module_paths(
        expand::expand_go_interfaces(ast::lower(parser::parse(file.source))),
        module_path,
    );
    if context.prepared_sources.len() >= 2048 {
        context.prepared_sources.clear()
    }
    let _ = context.prepared_sources.insert(
        file.path,
        CachedPreparedSource { source: file.source, module_path, lowered },
    );
    copied_lower_result(lowered)
}

struct SourceImports {
    source_path: string,
    import_aliases: Vec[hir::ImportAlias],
}

struct CachedDiscovery {
    fingerprint: string,
    files: Vec[SourceImports],
}

struct CachedPackage {
    fingerprint: string,
    lowered: LoweredPackage,
    checked: checker::CheckResult,
}

struct PackageRevision {
    fingerprint: string,
    dependencies: Vec[string],
    cacheable: bool,
}

pub struct AnalysisStats {
    pub checked_packages: Vec[string],
    pub reused_packages: Vec[string],
}

pub fn analysis_stats(context: AnalysisContext) -> AnalysisStats {
    context.stats.get()
}

pub fn clear_analysis_cache(context: AnalysisContext) -> () {
    project_info::clear(context.project_client);
    context.discoveries.clear();
    context.packages.clear();
    context.source_symbols.clear();
    context.prepared_sources.clear()
}

fn package_cache_key(project: Project) -> string {
    project.module_root + "\n" + project.package_name
}

fn package_source_fingerprint(project: Project) -> string {
    let value = text::StringBuilder::new();
    value.write_string(project.module_path + "\n" + project.package_name + "\n");
    for file in project.files {
        value.write_string(file.path.byte_len().to_string() + ":" + file.path);
        value.write_string(file.source.byte_len().to_string() + ":" + file.source)
    }
    hash::sha256_hex(value.finish())
}

fn discover_cached_package(context: AnalysisContext, project: Project) -> Vec[SourceImports] {
    let key = package_cache_key(project);
    let fingerprint = package_source_fingerprint(project);
    if let Some(cached) = context.discoveries.get(key) {
        if cached.fingerprint == fingerprint {
            return cached.files
        }
    }
    let files = Vec::new();
    for source in project.files {
        if let Some(file) = prepared_source(context, source, project.module_path).ast {
            files.push(
                SourceImports {
                    source_path: source.path,
                    import_aliases: hir::source_import_aliases(file),
                },
            )
        }
    }
    if context.discoveries.len() >= 256 {
        context.discoveries.clear()
    }
    let _ = context.discoveries.insert(key, CachedDiscovery { fingerprint, files });
    files
}

fn package_revision(
    project: Project,
    discovery: Vec[SourceImports],
    revisions: collections::IndexMap[string, PackageRevision],
) -> PackageRevision {
    let value = text::StringBuilder::new();
    value.write_string(package_source_fingerprint(project));
    let dependencies: collections::IndexSet[string] = collections::IndexSet::new();
    let mut cacheable = true;
    for file in discovery {
        for import in file.import_aliases {
            if dependencies.insert(import.package_name) {
                if let Some(revision) = revisions.get(import.package_name) {
                    value.write_string(import.package_name + ":" + revision.fingerprint);
                    cacheable = cacheable && revision.cacheable;
                    for name in revision.dependencies {
                        let _ = dependencies.insert(name);
                    }
                } else if import.package_name != "builtin" && import.package_name != "prelude" {
                    cacheable = false;
                }
            }
        }
    }
    PackageRevision {
        fingerprint: hash::sha256_hex(value.finish()),
        dependencies: dependencies.to_vec(),
        cacheable,
    }
}

fn selected_dependency_files(files: Vec[hir::File], revision: PackageRevision) -> Vec[hir::File] {
    let result = Vec::new();
    for file in files {
        if file.package_name == "prelude" || revision.dependencies.contains(file.package_name) {
            result.push(file)
        }
    }
    result
}

fn copied_check_result(value: checker::CheckResult) -> checker::CheckResult {
    let diagnostics = Vec::new();
    for diagnostic in value.diagnostics {
        diagnostics.push(diagnostic)
    }
    checker::CheckResult { diagnostics, ..value }
}

fn check_cached_package(
    context: AnalysisContext,
    project: Project,
    revision: PackageRevision,
    builtin: Option[ctir::CtModule],
    modules: Vec[ctir::CtModule],
    reexports: Vec[(string, string)],
    environments: Vec[tast::DependencyEnvironment],
    external: Vec[checker::ExternalTypeEnvironment],
) -> (LoweredPackage, checker::CheckResult) {
    let key = package_cache_key(project);
    if revision.cacheable && let Some(cached) = context.packages.get(key) && cached.fingerprint
        == revision.fingerprint {
        if let Ok(resolved) = query_external_types(cached.lowered.files) {
            external.push(resolved);
            context.stats.get().reused_packages.push(project.package_name);
            return (cached.lowered, copied_check_result(cached.checked))
        }
    }
    context.stats.get().checked_packages.push(project.package_name);
    let local_inputs = Vec::new();
    for file in project.files {
        local_inputs.push((prepared_source(context, file, project.module_path), file.path));
    }
    let local = checker::local_derive_module(
        local_inputs,
        project.package_name,
        environments,
        external,
    );
    let lowered = lower_package(
        context,
        project,
        builtin,
        modules,
        reexports,
        match local {
            Ok(value) => value,
            Err(_) => None,
        },
    );
    if let Err(message) = local {
        lowered.diagnostics.push(
            query_diagnostic(project.files[0].path, "derive", message, Option::None),
        );
    }
    let checked = check_query_package(lowered.files, environments, external);
    if revision.cacheable && lowered.diagnostics.is_empty()
        && !diagnostic::diagnostics_have_errors(checked.diagnostics) {
        if context.packages.len() >= 256 {
            context.packages.clear()
        }
        let _ = context.packages.insert(
            key,
            CachedPackage {
                fingerprint: revision.fingerprint,
                lowered,
                checked: copied_check_result(checked),
            },
        );
    } else {
        let _ = context.packages.remove(key);
    };
    (lowered, checked)
}
