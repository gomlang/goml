package query;

use gomlang::toolchain_manifest as config;
use gomlang::toolchain_manifest::resolver;
use std::env;
use std::fs;
use std::path;
use std::text;

type DependencyRequirement = config::Dependency;

type ResolvedModule = resolver::ResolvedModule;

fn quoted_values(value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    let mut start: Option[isize] = Option::None;
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'"' {
            match start {
                Some(offset) => {
                    result.push(value.byte_slice(offset, index));
                    start = Option::None;
                },
                None => {
                    start = Option::Some(index + 1);
                },
            }
        }
    }
    result
}

fn manifest_dependencies(source: string) -> Vec[DependencyRequirement] {
    parse_document(source).and_then(parse_dependencies).unwrap_or(Vec::new())
}

fn registry_home() -> Result[string, string] {
    match env::var_structured("GOML_HOME") {
        Ok(value) => if value != "" {
            Result::Ok(value)
        } else {
            Result::Err("GOML_HOME is empty")
        },
        Err(_) => match env::var_structured("HOME") {
            Ok(value) => if value != "" {
                Result::Ok(path::join(value, ".goml"))
            } else {
                Result::Err("HOME is empty")
            },
            Err(_) => match env::var_structured("USERPROFILE") {
                Ok(value) => if value != "" {
                    Result::Ok(path::join(value, ".goml"))
                } else {
                    Result::Err("USERPROFILE is empty")
                },
                Err(_) => {
                    Result::Err("failed to determine GoML home directory")
                },
            },
        },
    }
}

fn registry_root() -> Result[string, string] {
    registry_home().map(|home| path::join(path::join(home, "cache"), "registry"))
}

fn registry_versions(root: string, module_name: string) -> Result[Vec[string], string] {
    let index_path = path::join(root, "index.toml");
    let source = fs::read_file_structured(index_path).map_err(|error| error.to_string())?;
    let result: Vec[string] = Vec::new();
    let mut cursor = 0;
    let mut selected = false;
    while cursor <= source.byte_len() {
        let mut end = cursor;
        while end < source.byte_len() && source.byte_get(end) != b'\n' {
            end += 1;
        }
        let line = trim_ascii(strip_comment(source.byte_slice(cursor, end)));
        if line.starts_with("[") {
            let names = quoted_values(line);
            selected = line.starts_with("[modules.") && !names.is_empty() && names[0] == module_name;
        } else if selected && line.starts_with("versions") {
            for version in quoted_values(line) {
                result.push(version)
            }
        }
        if end == source.byte_len() {
            cursor = source.byte_len() + 1;
        } else {
            cursor = end + 1;
        }
    }
    if result.is_empty() {
        Result::Err(f"module {module_name} not found in registry index")
    } else {
        Result::Ok(result)
    }
}

fn select_registry_version(root: string, requirement: DependencyRequirement) -> Result[
    string,
    string,
] {
    let Some(minimum) = resolver::parse_sem_version(requirement.version) else {
        return Result::Err(f"invalid semver `{requirement.version}`")
    };
    let versions = registry_versions(root, requirement.name)?;
    resolver::minimum_version(versions, minimum, |version| f"invalid registry semver `{version}`")?.ok_or(
        f"registry has no version for {requirement.name} satisfying >= {requirement.version}",
    )
}

fn module_segments(value: string) -> Option[(string, string)] {
    text::find(value, "::").map(
        |separator| (
            value.byte_slice(0, separator),
            value.byte_slice(separator + 2, value.byte_len()),
        ),
    )
}

fn module_directory(registry: string, module_name: string, version: string) -> Result[
    string,
    string,
] {
    match module_segments(module_name) {
        Some((owner, module)) => Result::Ok(
            path::join(path::join(path::join(registry, owner), module), version),
        ),
        None => Result::Err("invalid module coordinate `" + module_name + "`"),
    }
}

fn resolve_external_modules_at(module_root: string, root: string) -> Result[
    Vec[ResolvedModule],
    string,
] {
    resolve_external_modules_with_development(module_root, root, false)
}

fn resolve_external_modules_with_development(module_root: string, root: string, development: bool) -> Result[
    Vec[ResolvedModule],
    string,
] {
    let module_root = fs::canonicalize(module_root).map_err(|error| error.to_string())?;
    let root_manifest = load_dependency_manifest(path::join(module_root, MANIFEST_FILENAME))?;
    let overrides = local_overrides(module_root, root_manifest)?;
    let metadata = resolver::Manifest {
        module_path: root_manifest.module_path,
        dependencies: root_manifest.dependencies,
    };
    if development {
        resolver::resolve_development(
            RegistryProvider {},
            module_root,
            metadata,
            root_manifest.dev_dependencies,
            overrides,
            root,
        )
    } else {
        resolver::resolve(RegistryProvider {}, module_root, metadata, overrides, root)
    }
}

fn resolve_external_modules(module_root: string) -> Result[Vec[ResolvedModule], string] {
    resolve_external_modules_at(module_root, registry_root()?)
}

fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}
