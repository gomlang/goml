package query;

use module::resources;

fn standard_library_sources(package_name: string) -> Result[Option[Vec[SourceFile]], string] {
    match resources::standard_sources(package_name)? {
        Some(values) => {
            let result: Vec[SourceFile] = Vec::new();
            for value in values {
                result.push(SourceFile { path: value.path, source: value.source, package_name })
            }
            Result::Ok(Option::Some(result))
        },
        None => Result::Ok(Option::None),
    }
}
