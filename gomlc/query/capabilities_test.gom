package query;

use std::testing;

#[test]
fn navigates_new_standard_library_apis() -> () {
    for (source, name, package_name) in Vec::from_array(
        [
            (
                "use std::context; fn main() -> () { let _ = context::Context::background(); }",
                "background",
                "std::context",
            ),
            (
                "use std::net::tls; fn main() -> () { let _ = tls::ClientConfig::new(\"localhost\"); }",
                "new",
                "std::net::tls",
            ),
            (
                "use std::num::{ToFloat}; fn main() -> () { let x: u64 = 1; let _ = x.to_f64(); }",
                "to_f64",
                "std::num",
            ),
            ("use std::io; fn main() -> () { let _ = io::stdin(); }", "stdin", "std::io"),
        ],
    ) {
        let analysis = analyze("/tmp/capabilities.gom", source);
        assert_no_diagnostics(analysis);
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "standard source",
        );
        testing::assert_eq(target.package_name, package_name);
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            name,
        );
    }
    for (prefix, name) in Vec::from_array(
        [
            ("use std::", "context"),
            ("use std::net::", "tls"),
            ("use std::net::tls::", "ClientConfig"),
            ("use std::context::", "with_timeout"),
            ("use std::io::", "BufReader"),
            ("use std::num::", "TryToInt"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/capability-import.gom", prefix), prefix.byte_len()),
                name,
            ),
        );
    }
}

#[test]
fn navigates_erased_generic_function_calls_and_values() -> () {
    for suffix in Vec::from_array(["answer::[isize]()", "answer::[isize]"]) {
        let source = "fn answer[T]() -> isize { 42 } fn main() -> () { let _ = " + suffix + "; }";
        let analysis = analyze("/tmp/erased-generic.gom", source);
        assert_no_diagnostics(analysis);
        let definitions = goto_definitions(analysis, last_substring(source, "answer").unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(
            source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            "answer",
        );
    }
}
