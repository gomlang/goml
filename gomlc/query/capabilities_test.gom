            (
                "use std::fs; use fs::{FileSystem, ReadDirFile}; pub fn find[F: FileSystem](filesystem: F, limits: fs::GlobLimits) -> () where F::Handle: ReadDirFile { let _ = fs::glob_from(filesystem, \"*.txt\", limits); } fn main() -> () {}",
                "glob_from",
