    }
}

#[test]
fn navigates_erased_generic_function_calls_and_values() -> () {
    for suffix in Vec::from_array(["answer::[isize]()", "answer::[isize]"]) {
        let source = "fn answer[T]() -> isize { 42 } fn main() -> () { let _ = " + suffix + "; }";
        let analysis = analyze("/tmp/erased-generic.gom", source);
        assert_no_diagnostics(analysis);
        let definitions = goto_definitions(analysis, last_substring(source, "answer").unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(
            source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            "answer",
        );
    }
}
