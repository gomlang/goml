                "use std::fs; fn main() -> () { let mode = fs::FileMode::from_file_type(fs::FileType::File, 0o640); let _ = fs::Metadata::from_mode(mode, 12, 0); }",
                "from_mode",
                "std::fs",
            ),
            (
                "use std::fs; fn main() -> () { let metadata = fs::Metadata::from_parts(fs::FileType::File, 12, 0o640, 0); let _ = fs::format_metadata(\"file\", metadata, 1024); }",
                "format_metadata",
                "std::fs",
            ),
            (
                "use std::fs; use fs::DirectoryEntry; pub fn describe[E: DirectoryEntry](entry: E) -> () { let _ = fs::format_directory_entry(entry, 1024); } fn main() -> () {}",
                "format_directory_entry",
                "std::fs",
