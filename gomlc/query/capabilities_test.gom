                "new",
                "std::hash::adler32",
            ),
            (
                "use std::bytes::endian; fn main() -> () { let _ = endian::uvarint_len(128); }",
                "uvarint_len",
                "std::bytes::endian",
            ),
            (
                "use std::bytes::endian; fn main() -> () { let data = b\"x\"; let reader = endian::Reader::new(data.as_slice()); let _ = reader.read_with(1, |block: endian::Reader| block.read_u8()); }",
                "read_with",
                "std::bytes::endian",
            ),
            (
                "use std::bytes::endian; fn main() -> () { let builder = endian::Builder::new(); let _ = builder.write_with(1, 1, |block: endian::Writer| block.write_u8(1)); }",
                "write_with",
                "std::bytes::endian",
            ),
            (
                "use std::bytes::endian::stream; use std::io; fn main() -> () { let _ = stream::write_uvarint(io::Discard::new(), 0); }",
                "write_uvarint",
                "std::bytes::endian::stream",
            ),
            (
                "use std::encoding::pem; fn main() -> () { let _ = pem::decode(\"\", 0, 0, 0); }",
                "decode",
                "std::encoding::pem",
            ),
        ],
    ) {
        let analysis = analyze("/tmp/capabilities.gom", source);
        if !analysis.checked.diagnostics.is_empty() {
            testing::fail(f"{name}: {analysis.checked.diagnostics.get(0).message}\n{source}");
        }
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        if definitions.len() != 1 {
            testing::fail(f"{name}: expected one definition, found {definitions.len()}\n{source}");
        }
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "standard source",
        );
        testing::assert_eq(target.package_name, package_name);
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            name,
        );
    }
    for (prefix, name) in Vec::from_array(
        [
            ("use std::", "context"),
            ("use std::error::", "Report"),
            ("use std::num::", "format_int"),
            ("use std::num::", "format_uint"),
            ("use std::num::", "write_int"),
            ("use std::num::", "FormatIntError"),
