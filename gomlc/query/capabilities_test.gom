package query;

use std::testing;

#[test]
fn navigates_new_standard_packages() -> () {
    for (source, name, package_name) in Vec::from_array(
        [
            (
                "use std::testing::io as iotest; fn main() -> () { let _ = iotest::FragmentWriter::new(2); }",
                "new",
                "std::testing::io",
            ),
            (
                "use std::math::complex; fn main() -> () { let _ = complex::Complex::new(1.0, 2.0); }",
                "new",
                "std::math::complex",
            ),
            ("use std::rand; fn main() -> () { let _ = rand::Pcg::new(1, 2); }", "new", "std::rand"),
            (
                "use std::crypto; fn main() -> () { let _ = crypto::digest_equal(b\"a\".as_slice(), b\"b\".as_slice()); }",
                "digest_equal",
                "std::crypto",
            ),
            (
                "use std::crypto::hash; fn main() -> () { let _ = hash::Sha256Digest::new256(); }",
                "new256",
                "std::crypto::hash",
            ),
            (
                "use std::crypto::hash; fn main() -> () { let _ = hash::Sha512Digest::new512(); }",
                "new512",
                "std::crypto::hash",
            ),
            (
                "use std::crypto::hash; fn main() -> () { let _ = hash::Sha3Digest::new256(); }",
                "new256",
                "std::crypto::hash",
            ),
            (
                "use std::crypto::hash; use std::crypto::hmac; fn main() -> () { let _ = hmac::sum(|| hash::Sha256Digest::new256(), b\"k\".as_slice(), b\"m\".as_slice()); }",
                "sum",
                "std::crypto::hmac",
            ),
            (
                "use std::crypto::hash; use std::crypto::hkdf; fn main() -> () { let _ = hkdf::derive(|| hash::Sha256Digest::new256(), b\"s\".as_slice(), b\"k\".as_slice(), b\"i\".as_slice(), 32); }",
                "derive",
                "std::crypto::hkdf",
            ),
            (
                "use std::crypto::hash; use std::crypto::pbkdf2; fn main() -> () { let _ = pbkdf2::derive(|| hash::Sha256Digest::new256(), b\"p\".as_slice(), b\"s\".as_slice(), 1, 32); }",
                "derive",
                "std::crypto::pbkdf2",
            ),
        ],
    ) {
        let analysis = analyze("/tmp/capabilities.gom", source);
        if !analysis.checked.diagnostics.is_empty() {
            testing::fail(f"{name}: {analysis.checked.diagnostics.get(0).message}\n{source}");
        }
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "standard source",
        );
        testing::assert_eq(target.package_name, package_name);
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            name,
        );
    }
}

#[test]
fn navigates_new_standard_library_apis() -> () {
    for (source, name, package_name) in Vec::from_array(
        [
            (
                "use std::text::format; fn main() -> () { let _ = format::Formatter::new(32); }",
                "new",
                "std::text::format",
            ),
            (
                "use std::text::format; use std::io; fn main() -> () { let _ = format::write_to(io::Discard::new(), \"hello\"); }",
                "write_to",
                "std::text::format",
            ),
            (
                "use std::testing::fs as memory; pub fn inspect(source: memory::MemoryFS, limits: memory::CheckLimits) -> () { let _ = memory::check_helpers(source, memory::ExpectedTree::Empty, limits); } fn main() -> () {}",
                "check_helpers",
                "std::testing::fs",
            ),
            (
                "use std::testing::fs as memory; pub fn inspect(source: memory::MemoryFS, limits: memory::CheckLimits) -> () { let _ = memory::check_seek(source, memory::ExpectedTree::Empty, limits); } fn main() -> () {}",
                "check_seek",
                "std::testing::fs",
            ),
            (
                "use std::testing::fs as memory; pub fn inspect(source: memory::MemoryFS, limits: memory::CheckLimits) -> () { let _ = memory::check_read_at(source, memory::ExpectedTree::Empty, limits); } fn main() -> () {}",
                "check_read_at",
                "std::testing::fs",
            ),
            (
                "use std::testing::fs as memory; pub fn inspect(source: memory::MemoryFS, limits: memory::CheckLimits) -> () { let _ = memory::check_links(source, memory::ExpectedTree::Empty, limits); } fn main() -> () {}",
                "check_links",
                "std::testing::fs",
            ),
            (
                "use std::testing::fs as memory; pub fn inspect(source: memory::MemoryFS, limits: memory::CheckLimits) -> () { let _ = memory::check_fs(source, memory::ExpectedTree::Empty, limits); } fn main() -> () {}",
                "check_fs",
                "std::testing::fs",
            ),
            (
                "use std::testing::fs as memory; fn main() -> () { let _ = memory::MemoryNode::directory(\".\"); }",
