package query;

use module::ast;
use module::tast;
use std::text;

fn inlay_text_width(value: string) -> isize {
    let mut width = 0;
    for _ in value.chars() {
        width += 1;
    }
    width
}

fn inlay_short_text(value: string, budget: isize) -> string {
    if inlay_text_width(value) <= budget {
        return value
    }
    let result = text::StringBuilder::new();
    let mut count = 0;
    for character in value.chars() {
        if count + 1 >= budget {
            break
        }
        result.write_char(character);
        count += 1;
    }
    result.write_string("…");
    result.finish()
}

fn inlay_type_entries(values: Vec[(string, tast::Type)], budget: isize) -> string {
    let result = text::StringBuilder::new();
    let mut remaining = budget;
    for index in 0..values.len() {
        if index > 0 {
            result.write_string(", ");
            remaining -= 2;
        }
        let reserve = if index + 1 < values.len() {
            3
        } else {
            0
        };
        let (prefix, ty) = values[index];
        let width = inlay_text_width(prefix);
        if remaining <= reserve + width {
            result.write_string("…");
            break
        }
        let value = prefix + inlay_type_text(ty, remaining - reserve - width);
        result.write_string(value);
        remaining -= inlay_text_width(value);
    }
    result.finish()
}

fn inlay_type_group(
    prefix: string,
    values: Vec[(string, tast::Type)],
    suffix: string,
    budget: isize,
) -> string {
    let remaining = budget - inlay_text_width(prefix) - inlay_text_width(suffix);
    if remaining < 0 || (remaining == 0 && !values.is_empty()) {
        return "…"
    }
    prefix + inlay_type_entries(values, remaining) + suffix
}

fn inlay_type_arguments(values: Vec[tast::Type]) -> Vec[(string, tast::Type)] {
    let result: Vec[(string, tast::Type)] = Vec::new();
    for value in values {
        result.push(("", value))
    }
    result
}

fn inlay_type_application(name: string, args: Vec[tast::Type], budget: isize) -> string {
    if args.is_empty() {
        return inlay_short_text(short_type_name(name), budget)
    }
    let name = inlay_short_text(short_type_name(name), budget - 3);
    inlay_type_group(name + "[", inlay_type_arguments(args), "]", budget)
}

fn inlay_bound_text(value: tast::DynTraitBound, budget: isize) -> string {
    let args = inlay_type_arguments(value.args);
    for binding in value.associated_types {
        args.push((binding.0 + " = ", binding.1))
    }
    if args.is_empty() {
        return inlay_short_text(short_type_name(value.trait_name), budget)
    }
    let name = inlay_short_text(short_type_name(value.trait_name), budget - 3);
    inlay_type_group(name + "[", args, "]", budget)
}

fn inlay_bounds_text(prefix: string, value: tast::Type, budget: isize) -> string {
    let tast::Type::Dyn { trait_name, args, associated_types, additional_bounds } = value else {
        return "…"
    };
    let bounds = Vec::from_array([tast::DynTraitBound { trait_name, args, associated_types }]);
    for bound in additional_bounds {
        bounds.push(bound)
    }
    let result = text::StringBuilder::new();
    let mut remaining = budget - inlay_text_width(prefix);
    if remaining < 1 {
        return "…"
    }
    result.write_string(prefix);
    for index in 0..bounds.len() {
        if index > 0 {
            result.write_string(" + ");
            remaining -= 3;
        }
        let reserve = if index + 1 < bounds.len() {
            4
        } else {
            0
        };
        if remaining <= reserve {
            result.write_string("…");
            break
        }
        let value = inlay_bound_text(bounds[index], remaining - reserve);
        result.write_string(value);
        remaining -= inlay_text_width(value);
    }
    result.finish()
}

fn inlay_type_text(value: tast::Type, budget: isize) -> string {
    if budget < 1 {
        return "…"
    }
    if let Some((_, args)) = tast::opaque_parts(value) {
        return inlay_bounds_text("impl ", args[1], budget)
    }
    match value {
        Con { name } => inlay_short_text(short_type_name(name), budget),
        Param { name } => inlay_short_text(name, budget),
        External { name, args, .. } => inlay_type_application(name, args, budget),
        App { ty, args } => {
            if args.is_empty() {
                inlay_type_text(ty, budget)
            } else {
                let name = inlay_type_text(ty, budget - 3);
                inlay_type_group(name + "[", inlay_type_arguments(args), "]", budget)
            }
        },
        Tuple { items } => inlay_type_group("(", inlay_type_arguments(items), ")", budget),
        Array { len, elem } => inlay_type_group(
            "[",
            Vec::from_array([("", elem)]),
            "; " + len.to_string() + "]",
            budget,
        ),
        Slice { elem } => inlay_type_application("Slice", Vec::from_array([elem]), budget),
        MutSlice { elem } => inlay_type_application("MutSlice", Vec::from_array([elem]), budget),
        VecType { elem } => inlay_type_application("Vec", Vec::from_array([elem]), budget),
        GoPointer { elem } => inlay_type_application("Ptr", Vec::from_array([elem]), budget),
        GoFunction { signature } => inlay_type_application(
            "Func",
            Vec::from_array([signature]),
            budget,
        ),
        RefType { elem } => inlay_type_application("Ref", Vec::from_array([elem]), budget),
        HashMap { key, value } => inlay_type_application(
            "HashMap",
            Vec::from_array([key, value]),
            budget,
        ),
        GoMap { key, value } => inlay_type_application(
            "GoMap",
            Vec::from_array([key, value]),
            budget,
        ),
        Channel { elem, direction } => inlay_type_application(
            match direction {
                ast::ChannelDirection::Both => "Channel",
                ast::ChannelDirection::Send => "Sender",
                ast::ChannelDirection::Receive => "Receiver",
            },
            Vec::from_array([elem]),
            budget,
        ),
        Func { params, ret_ty } => {
            if budget < 7 {
                return "…"
            }
            let params = inlay_type_group("(", inlay_type_arguments(params), ")", budget - 5);
            params + " -> " + inlay_type_text(ret_ty, budget - inlay_text_width(params) - 4)
        },
        Projection { for_ty, name, .. } => {
            let name = inlay_short_text(name, budget - 3);
            let remaining = budget - inlay_text_width(name) - 2;
            if remaining < 1 {
                "…"
            } else {
                inlay_type_text(for_ty, remaining) + "::" + name
            }
        },
        Dyn { .. } => inlay_bounds_text("dyn ", value, budget),
        Var(variable) => match variable.get() {
            tast::TypeVar::Link(inner) => inlay_type_text(inner, budget),
            _ => inlay_short_text(tast::diagnostic_type_text(value), budget),
        },
        _ => inlay_short_text(tast::diagnostic_type_text(value), budget),
    }
}
