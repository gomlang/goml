package query;

use std::testing;

#[test]
fn navigates_immutable_collection_methods() -> () {
    let context = analysis_context();
    for (type_name, method, arguments, file_name) in Vec::from_array(
        [
            ("HashMap[string, isize]", "insert", "\"key\", 1", "hash_map.goml"),
            ("HashSet[isize]", "insert", "1", "hash_set.goml"),
            ("Vector[isize]", "push", "1", "vector.goml"),
            ("List[isize]", "push_front", "1", "list.goml"),
            ("BTreeMap[string, isize]", "insert", "\"key\", 1", "btree_map.goml"),
            ("BTreeSet[isize]", "insert", "1", "btree_set.goml"),
        ],
    ) {
        let source = "use std::collections::imm as immutable; fn main() -> () { let values: immutable::"
            + type_name
            + " = Default::default(); let _ = values."
            + method
            + "("
            + arguments
            + "); }";
        let analysis = analyze_with_context(context, "/tmp/immutable.goml", source, Vec::new());
        assert_no_diagnostics(analysis);
        let offset = testing::expect_some(last_substring(source, method), "method offset");
        let definitions = goto_definitions(analysis, offset);
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "immutable collection source",
        );
        testing::assert_eq(target.package_name, "std::collections::imm");
        testing::assert(target.path.ends_with("/collections/imm/" + file_name));
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            method,
        );
    }
}

#[test]
fn keeps_immutable_and_prelude_hash_maps_distinct() -> () {
    let source = "use std::collections::imm; fn main() -> () { let mutable: HashMap[string, isize] = HashMap::new(); mutable.set(\"key\", 1); let persistent: imm::HashMap[string, isize] = imm::HashMap::new(); let updated = persistent.insert(\"key\", 2); let _: Option[isize] = updated.get(\"key\"); }";
    assert_no_diagnostics(analyze("/tmp/distinct-maps.goml", source));
}
