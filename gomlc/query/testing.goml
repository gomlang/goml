package query;

use gomlang::toolchain_manifest as source_files;
use module::ast;
use module::parser;
use std::path;

pub enum TestItemKind {
    Internal,
    External,
}

pub struct TestItem {
    pub name: string,
    pub span: ast::Span,
    pub kind: TestItemKind,
}

fn test_path_kind(source_path: string) -> Option[TestItemKind] {
    let mut current = path::clean(source_path);
    while let Some(parent) = path::parent(current) {
        if let Some(name) = path::file_name(parent) {
            if name == "tests" {
                return Option::Some(TestItemKind::External)
            }
        }
        if parent == current {
            break
        } else {
            current = parent;
        }
    }
    if source_files::is_test_source(source_path) {
        Option::Some(TestItemKind::Internal)
    } else {
        Option::None
    }
}

fn is_test_attribute(value: ast::Attribute) -> bool {
    value.text.contains("test")
}

fn has_test_attribute(values: Vec[ast::Attribute]) -> bool {
    for value in values {
        if is_test_attribute(value) {
            return true
        }
    }
    false
}

fn function_symbol_span(symbols: SymbolIndex, source_path: string, name: string) -> ast::Span {
    for symbol in symbols.symbols {
        if symbol.source_path == source_path && symbol.name == name
            && match symbol.kind {
                Function => true,
                _ => false,
            } {
            return symbol.span
        }
    }
    ast::span(0, 0)
}

pub fn test_items(source_path: string, source: string) -> Vec[TestItem] {
    let result: Vec[TestItem] = Vec::new();
    if let Some(kind) = test_path_kind(source_path) {
        let lowered = ast::lower(parser::parse(source));
        if let Some(file) = lowered.ast {
            let source_file = SourceFile {
                path: source_path,
                source,
                package_name: file.package_name,
            };
            let analysis_sources: Vec[SourceFile] = Vec::new();
            analysis_sources.push(source_file);
            let symbols = build_symbol_index_from_sources(analysis_sources);
            for item in file.items {
                if let Function(function) = item {
                    if has_test_attribute(function.attrs) {
                        result.push(
                            TestItem {
                                name: function.name,
                                span: function_symbol_span(symbols, source_path, function.name),
                                kind,
                            },
                        )
                    }
                }
            }
        }
    }
    result
}
