package query;

use std::testing;
use std::text;

#[test]
fn symbol_visibility_stays_local_across_many_neighboring_declarations() -> () {
    let source = text::StringBuilder::new();
    for index in 0..96 {
        source.write_string(f"pub fn visible_{index}() -> () {{}}\n");
        source.write_string(f"pub(module) fn internal_{index}() -> () {{}}\n");
        source.write_string(f"fn hidden_{index}() -> () {{}}\n");
    }
    let symbols = build_symbol_index_from_sources(
        Vec::from_array(
            [
                SourceFile {
                    path: "/tmp/symbol-visibility.goml",
                    source: source.finish(),
                    package_name: "example",
                },
            ],
        ),
    ).symbols;
    testing::assert_eq(symbols.len(), 288);
    for index in 0..96 {
        let public = symbols[index * 3];
        let internal = symbols[index * 3 + 1];
        let private = symbols[index * 3 + 2];
        testing::assert_eq(public.name, f"visible_{index}");
        testing::assert(public.public && !public.module_visible);
        testing::assert_eq(internal.name, f"internal_{index}");
        testing::assert(!internal.public && internal.module_visible);
        testing::assert_eq(private.name, f"hidden_{index}");
        testing::assert(!private.public && !private.module_visible);
    }
}
