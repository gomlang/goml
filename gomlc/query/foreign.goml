package query;

use module::ctir;
use module::hir;
use module::tast;

fn query_external_types(files: Vec[hir::File]) -> Result[tast::ExternalTypeEnvironment, string] {
    tast::opaque_external_type_environment(tast::external_type_requests(files)?)
}

fn check_query_package(
    files: Vec[hir::File],
    environments: Vec[tast::DependencyEnvironment],
    external: Vec[tast::ExternalTypeEnvironment],
) -> tast::CheckResult {
    if files.is_empty() {
        return tast::CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module(""),
            pending_constants: Vec::new(),
            diagnostics: Vec::new(),
            typeck_results: tast::empty_typeck_results(),
        }
    }
    let resolved = match query_external_types(files) {
        Ok(value) => value,
        Err(error) => {
            let checked = tast::check_package_files_for_link_with_environments(files, environments);
            if !tast::diagnostics_have_errors(checked.diagnostics) {
                checked.diagnostics.push(
                    query_diagnostic(files[0].source_path, "ffi", error, Option::None),
                );
            }
            return checked
        },
    };
    external.push(resolved);
    match tast::check_package_files_for_link_with_external_types(files, environments, resolved) {
        Ok(value) => value,
        Err(error) => failed_check(files[0].source_path, "ffi", error),
    }
}
