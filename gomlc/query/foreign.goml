package query;

use module::diagnostic;
use module::ctir;
use module::hir;
use module::tast;
use module::checker;

fn query_external_types(files: Vec[hir::File]) -> Result[checker::ExternalTypeEnvironment, string] {
    checker::opaque_external_type_environment(checker::external_type_requests(files)?)
}

fn check_query_package(
    files: Vec[hir::File],
    environments: Vec[tast::DependencyEnvironment],
    external: Vec[checker::ExternalTypeEnvironment],
) -> checker::CheckResult {
    if files.is_empty() {
        return checker::CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module(""),
            pending_constants: Vec::new(),
            diagnostics: Vec::new(),
            typeck_results: checker::empty_typeck_results(),
        }
    }
    let resolved = match query_external_types(files) {
        Ok(value) => value,
        Err(error) => {
            let checked = checker::check_package_files_for_link_with_environments(
                files,
                environments,
            );
            if !diagnostic::diagnostics_have_errors(checked.diagnostics) {
                checked.diagnostics.push(
                    query_diagnostic(files[0].source_path, "ffi", error, Option::None),
                );
            }
            return checked
        },
    };
    external.push(resolved);
    match checker::check_package_files_for_link_with_external_types(files, environments, resolved) {
        Ok(value) => value,
        Err(error) => failed_check(files[0].source_path, "ffi", error),
    }
}
