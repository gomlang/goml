package query;

pub struct DocLink {
    pub text: string,
    pub target: string,
}

pub struct DocItem {
    pub id: string,
    pub name: string,
    pub qualified_name: string,
    pub kind: string,
    pub public: bool,
    pub signature: string,
    pub documentation: string,
    pub source: string,
    pub line: isize,
    pub generated: bool,
    pub target: string,
    pub links: Vec[DocLink],
    pub members: Vec[DocItem],
}

pub struct DocSection {
    pub source: string,
    pub documentation: string,
    pub links: Vec[DocLink],
}

pub struct DocPackage {
    pub name: string,
    pub documentation: string,
    pub sections: Vec[DocSection],
    pub items: Vec[DocItem],
}

pub struct DocModule {
    pub name: string,
    pub packages: Vec[DocPackage],
    pub warnings: Vec[string],
}
