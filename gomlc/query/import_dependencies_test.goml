package query;

use std::fs;
use std::testing;

fn assert_undeclared_import(analysis: Analysis, module_name: string) -> () {
    for diagnostic in diagnostics(analysis) {
        if diagnostic.stage == "project"
            && diagnostic.message.contains("undeclared dependency " + module_name) {
            return
        }
    }
    testing::fail("expected undeclared dependency diagnostic for " + module_name)
}

#[test]
fn query_imports_select_longest_module_owner_and_preserve_its_module_paths() -> () {
    let root = "/tmp/gomlc-query-import-prefix";
    let _ = fs::remove_dir_all(root);
    for directory in Vec::from_array(["app/plugin", "plugin/detail"]) {
        testing::expect_ok(fs::create_dir_all(root + "/" + directory), "create package");
    }
    write_query_fixture(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::app::plugin\" = { path = \"../plugin\" }\n",
    );
    write_query_fixture(root + "/plugin/goml.toml", "[module]\npath = \"demo::app::plugin\"\n");
    write_query_fixture(
        root + "/plugin/main.goml",
        "package plugin; use module::detail; pub fn value() -> isize { detail::value() }",
    );
    write_query_fixture(
        root + "/plugin/detail/main.goml",
        "package detail; pub fn value() -> isize { 42 }",
    );
    write_query_fixture(
        root + "/app/plugin/main.goml",
        "package plugin; pub fn value() -> bool { false }",
    );
    let source = "package main; use demo::app::plugin; fn main() -> () { let result: isize = plugin::value(); println(result) }";
    let filename = root + "/app/main.goml";
    write_query_fixture(filename, source);
    let analysis = analyze(filename, source);
    assert_no_diagnostics(analysis);
    let definitions = goto_definitions(analysis, last_substring(source, "value").unwrap_or(0));
    testing::assert_eq(definitions.len(), 1);
    testing::assert_eq(definitions[0].source_path, root + "/plugin/main.goml");
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_imports_require_direct_dependencies_and_recheck_manifest_visibility() -> () {
    let root = "/tmp/gomlc-query-import-transitive";
    let _ = fs::remove_dir_all(root);
    for directory in Vec::from_array(["app", "middle", "leaf"]) {
        testing::expect_ok(fs::create_dir_all(root + "/" + directory), "create module");
    }
    let manifest = "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::middle\" = { path = \"../middle\" }\n";
    write_query_fixture(root + "/app/goml.toml", manifest);
    write_query_fixture(
        root + "/middle/goml.toml",
        "[module]\npath = \"demo::middle\"\n[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    write_query_fixture(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    write_query_fixture(
        root + "/leaf/main.goml",
        "package leaf; pub struct Value { pub number: isize } pub fn value() -> isize { 42 }",
    );
    write_query_fixture(
        root + "/middle/main.goml",
        "package middle; use demo::leaf; pub fn make() -> leaf::Value { leaf::Value { number: 42 } }",
    );
    let source = "package main; use demo::middle; fn main() -> () { let result = middle::make(); println(result.number) }";
    let filename = root + "/app/main.goml";
    write_query_fixture(filename, source);
    let context = analysis_context();
    let initial = analyze_with_context(context, filename, source, Vec::new());
    assert_no_diagnostics(initial);
    let definitions = goto_definitions(initial, last_substring(source, "number").unwrap_or(0));
    testing::assert_eq(definitions.len(), 1);
    testing::assert_eq(definitions[0].source_path, root + "/leaf/main.goml");
    let imported = "package main; use demo::middle; use demo::leaf; fn main() -> () { let result = middle::make(); println(result.number + leaf::value()) }";
    assert_undeclared_import(
        analyze_with_context(context, filename, imported, Vec::new()),
        "demo::leaf",
    );
    write_query_fixture(
        root + "/app/goml.toml",
        manifest + "\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    assert_no_diagnostics(analyze_with_context(context, filename, imported, Vec::new()));
    write_query_fixture(root + "/app/goml.toml", manifest);
    assert_undeclared_import(
        analyze_with_context(context, filename, imported, Vec::new()),
        "demo::leaf",
    );
    assert_no_diagnostics(analyze_with_context(context, filename, source, Vec::new()));
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_imports_reject_explicit_toolchain_namespaces() -> () {
    for name in Vec::from_array(["builtin", "prelude", "builtin::runtime", "prelude::private"]) {
        let source = "package main; use " + name + "; fn main() -> () {}";
        let analysis = analyze("/tmp/gomlc-query-reserved-import.goml", source);
        let mut found = false;
        for diagnostic in diagnostics(analysis) {
            if diagnostic.message == "package " + name + " is internal to the toolchain" {
                found = true;
            }
        }
        if !found {
            let messages: Vec[string] = Vec::new();
            for diagnostic in diagnostics(analysis) {
                messages.push(diagnostic.message)
            }
            testing::fail(
                "missing reserved import diagnostic for " + name + ": " + messages.join("; "),
            )
        }
    }
    assert_no_diagnostics(
        analyze(
            "/tmp/gomlc-query-standard-import.goml",
            "package main; use std::cmp; fn main() -> () { let _result = cmp::compare(1, 2); }",
        ),
    );
}
