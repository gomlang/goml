package query;

use module::ast;
use module::cst;
use module::lexer;
use module::parser;

pub enum SymbolKind {
    Function,
    Struct,
    Enum,
    Trait,
    TypeAlias,
    Constant,
    Variant,
    Method,
    Field,
}

pub enum MethodOrigin {
    NotMethod,
    Inherent,
    TraitDeclaration,
    TraitImplementation,
}

pub struct Symbol {
    pub name: string,
    pub qualified_name: string,
    pub package_name: string,
    pub source_path: string,
    pub span: ast::Span,
    pub kind: SymbolKind,
    pub public: bool,
    pub module_visible: bool,
    pub has_receiver: bool,
    pub method_origin: MethodOrigin,
}

pub struct SymbolIndex {
    pub symbols: Vec[Symbol],
}

struct CachedSourceSymbols {
    source: string,
    package_name: string,
    symbols: Vec[Symbol],
}

fn token_is_inside_node(token: SyntaxToken, node: SyntaxNode) -> bool {
    token.start >= node.start && token.end <= node.end
}

fn token_is_inside_attribute(syntax: SyntaxIndex, token: SyntaxToken) -> bool {
    let mut current = Option::Some(token.parent);
    while let Some(id) = current {
        let node = syntax.nodes[id];
        if node.kind == cst::NodeKind::ATTRIBUTE || node.kind == cst::NodeKind::ATTRIBUTE_LIST {
            return true
        } else {
            current = node.parent;
        }
    }
    false
}

fn first_identifier(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && !token_is_inside_attribute(syntax, token)
            && !token_is_inside_visibility(syntax, token)
            && token.kind == lexer::TokenKind::Ident {
            return Some(token)
        } else {
            index += 1;
        }
    }
    None
}

fn type_node_kind(value: cst::NodeKind) -> bool {
    match value {
        TYPE_BOOL | TYPE_INT | TYPE_INT8 | TYPE_INT16 | TYPE_INT32 | TYPE_INT64 | TYPE_UINT | TYPE_UINT8 | TYPE_UINT16 | TYPE_UINT32 | TYPE_UINT64 | TYPE_FLOAT32 | TYPE_FLOAT64 | TYPE_STRING | TYPE_CHAR | TYPE_TUPLE | TYPE_TAPP | TYPE_DYN | TYPE_ARRAY | TYPE_FUNC => true,
        _ => false,
    }
}

fn first_type_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && !token_is_inside_attribute(syntax, token)
            && !lexer::token_is_trivia(token.kind)
            && token.text.byte_len() > 0
            && ((token.text.byte_get(0) >= b'A' && token.text.byte_get(0) <= b'Z')
                || (token.text.byte_get(0) >= b'a' && token.text.byte_get(0) <= b'z')
                || token.text.byte_get(0) == b'_')
            && token.text != "dyn" {
            return Some(token)
        } else {
            index += 1;
        }
    }
    None
}

fn owner_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    if node.kind == cst::NodeKind::IMPL {
        let mut index = syntax.nodes.len() - 1;
        while index >= 0 {
            let candidate = syntax.nodes[index];
            if match candidate.parent {
                Some(parent) => parent == node.id,
                None => false,
            }
                && type_node_kind(candidate.kind) {
                return first_type_name_token(syntax, candidate)
            } else {
                index -= 1;
            }
        }
        first_identifier(syntax, node)
    } else {
        first_identifier(syntax, node)
    }
}

fn symbol_kind(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SymbolKind] {
    match node.kind {
        FN => match parent_with_kind(syntax, node, cst::NodeKind::IMPL, cst::NodeKind::TRAIT) {
            Some(_) => Some(SymbolKind::Method),
            None => Some(SymbolKind::Function),
        },
        STRUCT => Some(SymbolKind::Struct),
        ENUM => Some(SymbolKind::Enum),
        TRAIT => Some(SymbolKind::Trait),
        TYPE_ALIAS | EXTERN_TYPE => Some(SymbolKind::TypeAlias),
        CONST => Some(SymbolKind::Constant),
        EXTERN => Some(SymbolKind::Function),
        VARIANT => Some(SymbolKind::Variant),
        TRAIT_METHOD_SIG => Some(SymbolKind::Method),
        STRUCT_FIELD => Some(SymbolKind::Field),
        _ => None,
    }
}

fn parent_with_kind(
    syntax: SyntaxIndex,
    node: SyntaxNode,
    first: cst::NodeKind,
    second: cst::NodeKind,
) -> Option[SyntaxNode] {
    let mut current = node.parent;
    while let Some(id) = current {
        let parent = syntax.nodes[id];
        if parent.kind == first || parent.kind == second {
            return Some(parent)
        } else {
            current = parent.parent;
        }
    }
    None
}

fn qualified_symbol_name(
    source: SourceFile,
    syntax: SyntaxIndex,
    node: SyntaxNode,
    name: string,
    kind: SymbolKind,
) -> string {
    let owner = match kind {
        Variant => parent_with_kind(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM),
        Method => parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::IMPL),
        Field => parent_with_kind(syntax, node, cst::NodeKind::STRUCT, cst::NodeKind::VARIANT),
        TypeAlias | Constant => None,
        _ => None,
    };
    match owner {
        Some(owner_node) => match owner_name_token(syntax, owner_node) {
            Some(owner_token) => {
                source.package_name + "::" + owner_token.text + "::" + name
            },
            None => source.package_name + "::" + name,
        },
        None => source.package_name + "::" + name,
    }
}

fn token_is_inside_visibility(syntax: SyntaxIndex, token: SyntaxToken) -> bool {
    let mut current = Option::Some(token.parent);
    while let Some(id) = current {
        let node = syntax.nodes[id];
        if node.kind == cst::NodeKind::VISIBILITY {
            return true
        }
        current = node.parent;
    }
    false
}

fn declaration_visibility(syntax: SyntaxIndex, node: SyntaxNode) -> ast::Visibility {
    for child in syntax.nodes {
        if child.parent == Option::Some(node.id) && child.kind == cst::NodeKind::VISIBILITY {
            return ast::Visibility::Module
        }
    }
    for token in syntax.tokens {
        if token.parent == node.id && token.kind == lexer::TokenKind::PubKeyword {
            return Public
        }
    }
    Private
}

fn symbol_visibility(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> ast::Visibility {
    match kind {
        Variant => match parent_with_kind(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM) {
            Some(owner) => declaration_visibility(syntax, owner),
            None => Private,
        },
        Method => match parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::TRAIT) {
            Some(owner) => declaration_visibility(syntax, owner),
            None => declaration_visibility(syntax, node),
        },
        _ => declaration_visibility(syntax, node),
    }
}

fn symbol_public(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match symbol_visibility(syntax, node, kind) {
        Public => true,
        Module | Private => false,
    }
}

fn symbol_module_visible(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match symbol_visibility(syntax, node, kind) {
        Module => true,
        Public | Private => false,
    }
}

fn symbol_has_receiver(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match kind {
        Method => {
            let mut first: Option[SyntaxNode] = Option::None;
            for candidate in syntax.nodes {
                if candidate.kind == cst::NodeKind::PARAM && candidate.start >= node.start
                    && candidate.end <= node.end
                    && match first {
                        Some(existing) => candidate.start < existing.start,
                        None => true,
                    } {
                    first = Option::Some(candidate);
                }
            }
            match first {
                Some(parameter) => match first_identifier(syntax, parameter) {
                    Some(token) => token.text == "self",
                    None => false,
                },
                None => false,
            }
        },
        _ => false,
    }
}

fn impl_has_trait(syntax: SyntaxIndex, node: SyntaxNode) -> bool {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && token.kind == lexer::TokenKind::ForKeyword {
            return true
        } else if token_is_inside_node(token, node) && token.kind == lexer::TokenKind::LBrace {
            return false
        } else {
            index += 1;
        }
    }
    false
}

fn symbol_method_origin(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> MethodOrigin {
    match kind {
        Method => match parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::IMPL) {
            Some(owner) => if owner.kind == cst::NodeKind::TRAIT {
                TraitDeclaration
            } else if impl_has_trait(syntax, owner) {
                TraitImplementation
            } else {
                Inherent
            },
            None => NotMethod,
        },
        _ => NotMethod,
    }
}

fn index_source_syntax(source: SourceFile, syntax: SyntaxIndex, symbols: Vec[Symbol]) -> () {
    for node in syntax.nodes {
        if let Some(kind) = symbol_kind(syntax, node) {
            if let Some(token) = first_identifier(syntax, node) {
                symbols.push(
                    Symbol {
                        name: token.text,
                        qualified_name: qualified_symbol_name(
                            source,
                            syntax,
                            node,
                            token.text,
                            kind,
                        ),
                        package_name: source.package_name,
                        source_path: source.path,
                        span: ast::span(token.start, token.end),
                        kind,
                        public: source.package_name == "builtin"
                            || symbol_public(syntax, node, kind),
                        module_visible: symbol_module_visible(syntax, node, kind),
                        has_receiver: symbol_has_receiver(syntax, node, kind),
                        method_origin: symbol_method_origin(syntax, node, kind),
                    },
                )
            }
        }
    }
}

fn ast_type_owner_name(value: ast::TypeExpr) -> Option[string] {
    match value {
        Con { path } => if path.segments.is_empty() {
            None
        } else {
            Some(path.segments[path.segments.len() - 1].ident)
        },
        App { ty, args: _ } => ast_type_owner_name(ty),
        _ => None,
    }
}

fn collection_lang_method(attrs: Vec[ast::Attribute], item: string) -> Option[string] {
    for attribute in attrs {
        if attribute.name == "lang" && !attribute.args.is_empty() {
            if let String(name) = attribute.args[0] {
                if name == item {
                    for argument in attribute.args {
                        if let Named { name, value_kind, value } = argument {
                            if name == "from_array" && value_kind == "string" {
                                return Some(value)
                            }
                        }
                    }
                }
            }
        }
    }
    None
}

fn index_builtin_collection_methods(source: SourceFile, symbols: Vec[Symbol]) -> () {
    if source.package_name != "builtin" {
        return
    }
    let lowered = ast::lower(parser::parse(source.source));
    if let Some(file) = lowered.ast {
        for item in file.items {
            if let ImplBlock(block) = item {
                let method = match collection_lang_method(block.attrs, "vec") {
                    Some(value) => Option::Some(value),
                    None => collection_lang_method(block.attrs, "hashmap"),
                };
                if let (Some(owner), Some(name)) = (ast_type_owner_name(block.for_type), method) {
                    symbols.push(
                        Symbol {
                            name,
                            qualified_name: source.package_name + "::" + owner + "::" + name,
                            package_name: source.package_name,
                            source_path: source.path,
                            span: block.for_type_span,
                            kind: SymbolKind::Method,
                            public: true,
                            module_visible: false,
                            has_receiver: false,
                            method_origin: MethodOrigin::Inherent,
                        },
                    )
                }
            }
        }
    }
}

fn index_source(source: SourceFile, symbols: Vec[Symbol]) -> () {
    index_source_syntax(source, syntax_index(parser::parse(source.source).root), symbols);
    index_builtin_collection_methods(source, symbols)
}

fn cached_source_symbols(context: AnalysisContext, source: SourceFile) -> Vec[Symbol] {
    if let Some(cached) = context.source_symbols.get(source.path) {
        if cached.source == source.source && cached.package_name == source.package_name {
            return cached.symbols
        }
    }
    let symbols: Vec[Symbol] = Vec::new();
    index_source(source, symbols);
    if context.source_symbols.len() >= 2048 {
        context.source_symbols.clear();
    }
    let _ = context.source_symbols.insert(
        source.path,
        CachedSourceSymbols { source: source.source, package_name: source.package_name, symbols },
    );
    symbols
}

pub fn build_symbol_index(value: Analysis) -> SymbolIndex {
    match value.symbol_index.get() {
        Some(index) => index,
        None => {
            let symbols: Vec[Symbol] = Vec::new();
            for source in value.sources {
                if source.path == value.source_path {
                    index_source_syntax(source, value.syntax, symbols);
                    index_builtin_collection_methods(source, symbols)
                } else {
                    for symbol in cached_source_symbols(value.context, source) {
                        symbols.push(symbol)
                    }
                }
            }
            let index = SymbolIndex { symbols };
            value.symbol_index.set(Option::Some(index));
            index
        },
    }
}

pub fn build_symbol_index_from_sources(sources: Vec[SourceFile]) -> SymbolIndex {
    let symbols: Vec[Symbol] = Vec::new();
    for source in sources {
        index_source(source, symbols)
    }
    SymbolIndex { symbols }
}

fn symbol_name_ends_with(value: string, expected: string) -> bool {
    value.ends_with("::" + expected)
}

pub fn find_symbol(index: SymbolIndex, qualified_name: string) -> Option[Symbol] {
    for offset in 0..index.symbols.len() {
        let symbol = index.symbols[index.symbols.len() - 1 - offset];
        if symbol.qualified_name == qualified_name {
            return Some(symbol)
        }
    }
    let suffixes: Vec[Symbol] = Vec::new();
    for symbol in index.symbols {
        if symbol_name_ends_with(qualified_name, symbol.qualified_name)
            || symbol_name_ends_with(symbol.qualified_name, qualified_name) {
            suffixes.push(symbol)
        }
    }
    if suffixes.len() == 1 {
        Some(suffixes[0])
    } else {
        None
    }
}
