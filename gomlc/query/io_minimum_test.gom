package query;

#[test]
fn analyzes_minimum_reader_source_dependencies() -> () {
    for source in[
        "use std::io; fn main() -> () { let _ = io::StringReader::new(\"x\"); }",
        "use std::io; fn main() -> () { let output = b\"x\"; let _ = io::read_at_least(io::StringReader::new(\"x\"), output.as_mut_slice(), 1); }",
        "use std::io; fn main() -> () { let output = Vec::from_array([0.to_u8()]); let _ = io::read_at_least(io::StringReader::new(\"x\"), output.as_mut_slice(), 1); }",
    ] {
        assert_no_diagnostics(analyze("/tmp/io_minimum_source.gom", source));
    }
}
