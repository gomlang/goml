package query;

use std::testing;

#[test]
fn resolves_lowercase_simd_types_and_methods() -> () {
    let source = "use std::simd; pub fn combine(a: simd::f32x4, b: simd::f32x4) -> simd::f32x4 { a.mul(b).add(a) }";
    let analysis = analyze("/tmp/simd.gom", source);
    assert_no_diagnostics(analysis);
    let definitions = goto_definitions(analysis, last_substring(source, "mul").unwrap_or(0));
    testing::assert_eq(definitions.len(), 1);
    let target = testing::expect_some(
        source_by_path(analysis.sources, definitions[0].source_path),
        "SIMD source",
    );
    testing::assert_eq(target.package_name, "std::simd");
    testing::assert_eq(
        target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
        "mul",
    );
    for (prefix, expected) in Vec::from_array(
        [("use std::", "simd"), ("use std::simd::", "f32x4"), ("use std::simd::", "mask32x4")],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/simd-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}
