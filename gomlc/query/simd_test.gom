package query;

use std::testing;

#[test]
fn resolves_lowercase_simd_types_and_methods() -> () {
    let source = "use std::simd; pub fn combine(a: simd::f32x4, b: simd::f32x4) -> simd::f32x4 { a.mul(b).add(a) }";
    let analysis = analyze("/tmp/simd.gom", source);
    assert_no_diagnostics(analysis);
    let definitions = goto_definitions(analysis, last_substring(source, "mul").unwrap_or(0));
    testing::assert_eq(definitions.len(), 1);
    let target = testing::expect_some(
        source_by_path(analysis.sources, definitions[0].source_path),
        "SIMD source",
    );
    testing::assert_eq(target.package_name, "std::simd");
    testing::assert_eq(
        target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
        "mul",
    );
    for (prefix, expected) in Vec::from_array(
        [
            ("use std::", "simd"),
            ("use std::simd::", "f32x4"),
            ("use std::simd::", "mask32x4"),
            ("use std::simd::", "f32x8"),
            ("use std::simd::", "mask32x8"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/simd-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}

#[test]
fn resolves_simd_avx2_vector_and_mask_methods() -> () {
    let source = "use std::simd; pub fn choose(a: simd::f32x8, b: simd::f32x8) -> simd::f32x8 { a.simd_lt(b).select(a, b) }";
    let analysis = analyze("/tmp/simd-avx2.gom", source);
    assert_no_diagnostics(analysis);
    for method in Vec::from_array(["simd_lt", "select"]) {
        let definitions = goto_definitions(analysis, last_substring(source, method).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "AVX2 source",
        );
        testing::assert_eq(target.package_name, "std::simd");
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            method,
        );
    }
}

#[test]
fn resolves_integer_double_conversion_and_fma_simd_apis() -> () {
    let source = "use std::simd; pub fn bytes(a: simd::u8x16, b: simd::u8x16) -> simd::u8x16 { a.simd_lt(b).select(a.saturating_add(b), b) } pub fn widen(a: simd::i16x8) -> simd::f32x8 { a.to_i32().to_f32() } pub fn fused(a: simd::f64x4, b: simd::f64x4) -> simd::f64x4 { a.mul_add(b, a).sqrt() }";
    let analysis = analyze("/tmp/simd-numeric.gom", source);
    assert_no_diagnostics(analysis);
    for method in Vec::from_array(["saturating_add", "to_i32", "to_f32", "mul_add", "sqrt"]) {
        let definitions = goto_definitions(analysis, last_substring(source, method).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "numeric SIMD source",
        );
        testing::assert_eq(target.package_name, "std::simd");
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            method,
        );
    }
    let prefix = "use std::simd::";
    let suggestions = completions(
        analyze("/tmp/simd-numeric-import.gom", prefix),
        prefix.byte_len(),
    );
    for name in Vec::from_array(
        [
            "u8x16",
            "u8x32",
            "i16x8",
            "u32x8",
            "i64x2",
            "f64x2",
            "f64x4",
            "mask8x32",
            "mask64x4",
            "SimdSelect",
        ],
    ) {
        testing::assert(has_completion(suggestions, name));
    }
}
