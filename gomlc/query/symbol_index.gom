package query;

use module::ast;
use module::cst;
use module::lexer;
use module::parser;

pub enum SymbolKind {
    Function,
    Struct,
    Enum,
    Trait,
    TypeAlias,
    Constant,
    Variant,
    Method,
    Field,
}

pub enum MethodOrigin {
    NotMethod,
    Inherent,
    TraitDeclaration,
    TraitImplementation,
}

pub struct Symbol {
    pub name: string,
    pub qualified_name: string,
    pub package_name: string,
    pub source_path: string,
    pub span: ast::Span,
    pub kind: SymbolKind,
    pub public: bool,
    pub has_receiver: bool,
    pub method_origin: MethodOrigin,
}

pub struct SymbolIndex {
    pub symbols: Vec[Symbol],
}

fn token_is_inside_node(token: SyntaxToken, node: SyntaxNode) -> bool {
    token.start >= node.start && token.end <= node.end
}

fn token_is_inside_attribute(syntax: SyntaxIndex, token: SyntaxToken) -> bool {
    let mut current = Option::Some(token.parent);
    while current.is_some() {
        if let Some(id) = current {
            let node = syntax.nodes[id];
            if cst::node_kind_equal(node.kind, cst::NodeKind::ATTRIBUTE)
                || cst::node_kind_equal(node.kind, cst::NodeKind::ATTRIBUTE_LIST) {
                return true
            } else {
                current = node.parent;
            }
        }
    }
    false
}

fn first_identifier(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && !token_is_inside_attribute(syntax, token)
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident) {
            return Option::Some(token)
        } else {
            index += 1;
        }
    }
    Option::None
}

fn type_node_kind(value: cst::NodeKind) -> bool {
    cst::node_kind_equal(value, cst::NodeKind::TYPE_BOOL)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT8)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT16)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_INT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT8)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT16)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_UINT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FLOAT32)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FLOAT64)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_STRING)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_CHAR)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_TUPLE)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_TAPP)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_DYN)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_ARRAY)
        || cst::node_kind_equal(value, cst::NodeKind::TYPE_FUNC)
}

fn first_type_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && !token_is_inside_attribute(syntax, token)
            && !lexer::token_is_trivia(token.kind)
            && token.text.byte_len() > 0
            && ((token.text.byte_get(0) >= b'A' && token.text.byte_get(0) <= b'Z')
                || (token.text.byte_get(0) >= b'a' && token.text.byte_get(0) <= b'z')
                || token.text.byte_get(0) == b'_')
            && token.text != "dyn" {
            return Option::Some(token)
        } else {
            index += 1;
        }
    }
    Option::None
}

fn owner_name_token(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxToken] {
    if cst::node_kind_equal(node.kind, cst::NodeKind::IMPL) {
        let mut index = syntax.nodes.len() - 1;
        while index >= 0 {
            let candidate = syntax.nodes[index];
            if match candidate.parent {
                Some(parent) => parent == node.id,
                None => false,
            }
                && type_node_kind(candidate.kind) {
                return first_type_name_token(syntax, candidate)
            } else {
                index -= 1;
            }
        }
        first_identifier(syntax, node)
    } else {
        first_identifier(syntax, node)
    }
}

fn symbol_kind(syntax: SyntaxIndex, node: SyntaxNode) -> Option[SymbolKind] {
    if cst::node_kind_equal(node.kind, cst::NodeKind::FN) {
        match parent_with_kind(syntax, node, cst::NodeKind::IMPL, cst::NodeKind::TRAIT) {
            Some(_) => Option::Some(SymbolKind::Method),
            None => Option::Some(SymbolKind::Function),
        }
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::STRUCT) {
        Option::Some(SymbolKind::Struct)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::ENUM) {
        Option::Some(SymbolKind::Enum)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TRAIT) {
        Option::Some(SymbolKind::Trait)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TYPE_ALIAS)
        || cst::node_kind_equal(node.kind, cst::NodeKind::EXTERN_TYPE) {
        Option::Some(SymbolKind::TypeAlias)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::CONST) {
        Option::Some(SymbolKind::Constant)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::EXTERN) {
        Option::Some(SymbolKind::Function)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::VARIANT) {
        Option::Some(SymbolKind::Variant)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::TRAIT_METHOD_SIG) {
        Option::Some(SymbolKind::Method)
    } else if cst::node_kind_equal(node.kind, cst::NodeKind::STRUCT_FIELD) {
        Option::Some(SymbolKind::Field)
    } else {
        Option::None
    }
}

fn parent_with_kind(
    syntax: SyntaxIndex,
    node: SyntaxNode,
    first: cst::NodeKind,
    second: cst::NodeKind,
) -> Option[SyntaxNode] {
    let mut current = node.parent;
    while current.is_some() {
        if let Some(id) = current {
            let parent = syntax.nodes[id];
            if cst::node_kind_equal(parent.kind, first) || cst::node_kind_equal(parent.kind, second) {
                return Option::Some(parent)
            } else {
                current = parent.parent;
            }
        }
    }
    Option::None
}

fn qualified_symbol_name(
    source: SourceFile,
    syntax: SyntaxIndex,
    node: SyntaxNode,
    name: string,
    kind: SymbolKind,
) -> string {
    let owner = match kind {
        Variant => parent_with_kind(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM),
        Method => parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::IMPL),
        Field => parent_with_kind(syntax, node, cst::NodeKind::STRUCT, cst::NodeKind::VARIANT),
        TypeAlias | Constant => Option::None,
        _ => Option::None,
    };
    match owner {
        Some(owner_node) => match owner_name_token(syntax, owner_node) {
            Some(owner_token) => {
                source.package_name + "::" + owner_token.text + "::" + name
            },
            None => source.package_name + "::" + name,
        },
        None => source.package_name + "::" + name,
    }
}

fn node_has_token(syntax: SyntaxIndex, node: SyntaxNode, kind: lexer::TokenKind) -> bool {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node) && !token_is_inside_attribute(syntax, token)
            && lexer::token_kind_equal(token.kind, kind) {
            return true
        } else {
            index += 1;
        }
    }
    false
}

fn owner_public(syntax: SyntaxIndex, node: SyntaxNode, first: cst::NodeKind, second: cst::NodeKind) -> bool {
    match parent_with_kind(syntax, node, first, second) {
        Some(owner) => node_has_token(syntax, owner, lexer::TokenKind::PubKeyword),
        None => false,
    }
}

fn symbol_public(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match kind {
        Variant => owner_public(syntax, node, cst::NodeKind::ENUM, cst::NodeKind::ENUM),
        Field => node_has_token(syntax, node, lexer::TokenKind::PubKeyword),
        Method => {
            node_has_token(syntax, node, lexer::TokenKind::PubKeyword)
                || owner_public(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::TRAIT)
        },
        _ => node_has_token(syntax, node, lexer::TokenKind::PubKeyword),
    }
}

fn symbol_has_receiver(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> bool {
    match kind {
        Method => {
            let mut first: Option[SyntaxNode] = Option::None;
            for candidate in syntax.nodes {
                if cst::node_kind_equal(candidate.kind, cst::NodeKind::PARAM)
                    && candidate.start >= node.start
                    && candidate.end <= node.end
                    && match first {
                        Some(existing) => candidate.start < existing.start,
                        None => true,
                    } {
                    first = Option::Some(candidate);
                }
            }
            match first {
                Some(parameter) => match first_identifier(syntax, parameter) {
                    Some(token) => token.text == "self",
                    None => false,
                },
                None => false,
            }
        },
        _ => false,
    }
}

fn impl_has_trait(syntax: SyntaxIndex, node: SyntaxNode) -> bool {
    let mut index = token_index_at_or_after(syntax, node.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < node.end {
        let token = syntax.tokens[index];
        if token_is_inside_node(token, node)
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::ForKeyword) {
            return true
        } else if token_is_inside_node(token, node)
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::LBrace) {
            return false
        } else {
            index += 1;
        }
    }
    false
}

fn symbol_method_origin(syntax: SyntaxIndex, node: SyntaxNode, kind: SymbolKind) -> MethodOrigin {
    match kind {
        Method => match parent_with_kind(syntax, node, cst::NodeKind::TRAIT, cst::NodeKind::IMPL) {
            Some(owner) => if cst::node_kind_equal(owner.kind, cst::NodeKind::TRAIT) {
                MethodOrigin::TraitDeclaration
            } else if impl_has_trait(syntax, owner) {
                MethodOrigin::TraitImplementation
            } else {
                MethodOrigin::Inherent
            },
            None => MethodOrigin::NotMethod,
        },
        _ => MethodOrigin::NotMethod,
    }
}

fn index_source_syntax(source: SourceFile, syntax: SyntaxIndex, symbols: Vec[Symbol]) -> () {
    for node in syntax.nodes {
        if let Some(kind) = symbol_kind(syntax, node) {
            if let Some(token) = first_identifier(syntax, node) {
                symbols.push(
                    Symbol {
                        name: token.text,
                        qualified_name: qualified_symbol_name(
                            source,
                            syntax,
                            node,
                            token.text,
                            kind,
                        ),
                        package_name: source.package_name,
                        source_path: source.path,
                        span: ast::span(token.start, token.end),
                        kind,
                        public: source.package_name == "builtin"
                            || symbol_public(syntax, node, kind),
                        has_receiver: symbol_has_receiver(syntax, node, kind),
                        method_origin: symbol_method_origin(syntax, node, kind),
                    },
                )
            }
        }
    }
}

fn ast_type_owner_name(value: ast::TypeExpr) -> Option[string] {
    match value {
        Con { path } => if path.segments.is_empty() {
            Option::None
        } else {
            Option::Some(path.segments[path.segments.len() - 1].ident)
        },
        App { ty, args: _ } => ast_type_owner_name(ty),
        _ => Option::None,
    }
}

fn collection_lang_method(attrs: Vec[ast::Attribute], item: string) -> Option[string] {
    for attribute in attrs {
        if attribute.name == "lang" && !attribute.args.is_empty() {
            if let ast::AttributeArg::String(name) = attribute.args[0] {
                if name == item {
                    for argument in attribute.args {
                        if let ast::AttributeArg::Named { name, value_kind, value } = argument {
                            if name == "from_array" && value_kind == "string" {
                                return Option::Some(value)
                            }
                        }
                    }
                }
            }
        }
    }
    Option::None
}

fn index_builtin_collection_methods(source: SourceFile, symbols: Vec[Symbol]) -> () {
    if source.package_name != "builtin" {
        return
    }
    let lowered = ast::lower(parser::parse(source.source));
    if let Some(file) = lowered.ast {
        for item in file.items {
            if let ImplBlock(block) = item {
                let method = match collection_lang_method(block.attrs, "vec") {
                    Some(value) => Option::Some(value),
                    None => collection_lang_method(block.attrs, "hashmap"),
                };
                if let (Some(owner), Some(name)) = (ast_type_owner_name(block.for_type), method) {
                    symbols.push(
                        Symbol {
                            name,
                            qualified_name: source.package_name + "::" + owner + "::" + name,
                            package_name: source.package_name,
                            source_path: source.path,
                            span: block.for_type_span,
                            kind: SymbolKind::Method,
                            public: true,
                            has_receiver: false,
                            method_origin: MethodOrigin::Inherent,
                        },
                    )
                }
            }
        }
    }
}

fn index_source(source: SourceFile, symbols: Vec[Symbol]) -> () {
    index_source_syntax(source, syntax_index(parser::parse(source.source).root), symbols);
    index_builtin_collection_methods(source, symbols)
}

pub fn build_symbol_index(value: Analysis) -> SymbolIndex {
    match value.symbol_index.get() {
        Some(index) => index,
        None => {
            let symbols: Vec[Symbol] = Vec::new();
            for source in value.sources {
                if source.path == value.source_path {
                    index_source_syntax(source, value.syntax, symbols);
                    index_builtin_collection_methods(source, symbols)
                } else {
                    index_source(source, symbols)
                }
            }
            let index = SymbolIndex { symbols };
            value.symbol_index.set(Option::Some(index));
            index
        },
    }
}

pub fn build_symbol_index_from_sources(sources: Vec[SourceFile]) -> SymbolIndex {
    let symbols: Vec[Symbol] = Vec::new();
    for source in sources {
        index_source(source, symbols)
    }
    SymbolIndex { symbols }
}

fn symbol_name_ends_with(value: string, expected: string) -> bool {
    value.ends_with("::" + expected)
}

pub fn find_symbol(index: SymbolIndex, qualified_name: string) -> Option[Symbol] {
    for offset in 0..index.symbols.len() {
        let symbol = index.symbols[index.symbols.len() - 1 - offset];
        if symbol.qualified_name == qualified_name {
            return Option::Some(symbol)
        }
    }
    let suffixes: Vec[Symbol] = Vec::new();
    for symbol in index.symbols {
        if symbol_name_ends_with(qualified_name, symbol.qualified_name)
            || symbol_name_ends_with(symbol.qualified_name, qualified_name) {
            suffixes.push(symbol)
        }
    }
    if suffixes.len() == 1 {
        Option::Some(suffixes[0])
    } else {
        Option::None
    }
}
