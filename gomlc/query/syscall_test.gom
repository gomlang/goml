package query;

use std::testing;

#[test]
fn resolves_linux_syscall_source_and_completes_namespaces() -> () {
    let source = "use std::os::linux::syscall; fn main() -> () { let _ = syscall::syscall6(39, [0, 0, 0, 0, 0, 0]); }";
    let analysis = analyze("/tmp/linux-syscall.gom", source);
    assert_no_diagnostics(analysis);
    let offset = last_substring(source, "syscall6").unwrap_or(0);
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    match source_by_path(analysis.sources, definitions[0].source_path) {
        Some(target) => {
            testing::assert_eq(target.package_name, "std::os::linux::syscall");
            testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "syscall6",
            )
        },
        None => testing::fail("expected syscall source"),
    }
    for (prefix, expected) in Vec::from_array(
        [
            ("use std::", "os"),
            ("use std::os::", "linux"),
            ("use std::os::linux::", "syscall"),
            ("use std::os::linux::", "abi"),
            ("use std::os::linux::", "fd"),
            ("use std::os::linux::", "process"),
            ("use std::os::linux::", "memory"),
            ("use std::os::linux::", "ipc"),
            ("use std::os::linux::process::", "Command"),
            ("use std::os::linux::memory::", "Mapping"),
            ("use std::os::linux::ipc::", "Epoll"),
            ("use std::os::linux::abi::", "Timespec"),
            ("use std::os::linux::abi::", "Iovecs"),
            ("use std::os::linux::fd::", "Fd"),
            ("use std::os::linux::fd::", "open_at"),
            ("use std::os::linux::syscall::", "syscall6_with_buffers"),
            ("use std::os::linux::syscall::", "syscall6_with_pointers"),
            ("use std::os::linux::syscall::", "Pointer"),
            ("use std::os::linux::syscall::", "SYS_IO_URING_SETUP"),
            ("use std::os::linux::syscall::", "SYS_OPENAT2"),
            ("use std::os::linux::syscall::", "EFAULT"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/linux-syscall-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}

#[test]
fn resolves_linux_syscall_constants_and_pointer_types() -> () {
    let source = "use std::os::linux::syscall; fn main() -> () { let result = syscall::syscall6(syscall::SYS_GETPID, [0, 0, 0, 0, 0, 0]); let _ = syscall::errno_name(syscall::EFAULT); let pointers: Vec[syscall::Pointer] = Vec::new(); }";
    let analysis = analyze("/tmp/linux-syscall-abi.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(["SYS_GETPID", "EFAULT", "Pointer"]) {
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        match source_by_path(analysis.sources, definitions[0].source_path) {
            Some(target) => testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                name,
            ),
            None => testing::fail("expected syscall declaration"),
        }
    }
}

#[test]
fn resolves_linux_record_and_descriptor_sources() -> () {
    let source = "use std::os::linux::abi; use std::os::linux::fd; fn main() -> () { let time = abi::Timespec { seconds: 0, nanoseconds: 1 }; let bytes = time.encode(); let _ = fd::open(\"/dev/null\", fd::O_RDONLY, 0); }";
    let analysis = analyze("/tmp/linux-fd.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(["Timespec", "encode", "open", "O_RDONLY"]) {
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        match source_by_path(analysis.sources, definitions[0].source_path) {
            Some(target) => testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                name,
            ),
            None => testing::fail("expected Linux library declaration"),
        }
    }
}

#[test]
fn resolves_linux_process_memory_and_ipc_sources() -> () {
    let source = "use std::os::linux::process; use std::os::linux::memory; use std::os::linux::ipc; fn main() -> () { let _ = process::pid(); let _ = memory::anonymous(4096, memory::PROT_READ, memory::MAP_PRIVATE); let _ = ipc::eventfd(0, 0); }";
    let analysis = analyze("/tmp/linux-system.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(["pid", "anonymous", "PROT_READ", "MAP_PRIVATE", "eventfd"]) {
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        match source_by_path(analysis.sources, definitions[0].source_path) {
            Some(target) => testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                name,
            ),
            None => testing::fail("expected Linux system declaration"),
        }
    }
}
