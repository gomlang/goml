package query;

use module::checker;
use std::testing;

fn to_string_diagnostics(source: string) -> Vec[checker::Diagnostic] {
    analyze("main.goml", source).checked.diagnostics
}

fn to_string_has_diagnostic(diagnostics: Vec[checker::Diagnostic], expected: string) -> bool {
    for diagnostic in diagnostics {
        if diagnostic.message.contains(expected) {
            return true
        }
    }
    false
}

fn assert_to_string_diagnostic(source: string, expected: string) -> () {
    let diagnostics = to_string_diagnostics(source);
    if !to_string_has_diagnostic(diagnostics, expected) {
        for diagnostic in diagnostics {
            println(diagnostic.message)
        }
        testing::fail("missing diagnostic: " + expected)
    }
}

#[test_case("#[to_string]", "exactly one string template")]
#[test_case("#[to_string()]", "exactly one string template")]
#[test_case("#[to_string(1)]", "requires a string template")]
#[test_case("#[to_string(name = \"x\")]", "requires a string template")]
#[test_case("#[to_string(\"a\", \"b\")]", "exactly one string template")]
#[test_case("#[to_string(\"a\")] #[to_string(\"b\")]", "duplicate to_string attribute")]
#[test_case("#[to_string(\"{\")]", "unclosed placeholder")]
#[test_case("#[to_string(\"}\")]", "unmatched `}`")]
#[test_case("#[to_string(\"{}\")]", "unknown field ``")]
#[test_case("#[to_string(\"{1}\")]", "unknown field `1`")]
#[test_case("#[to_string(\"{00}\")]", "unknown field `00`")]
#[test_case("#[to_string(\"{0:?}\")]", "unknown field `0:?`")]
#[test_case("#[to_string(\"{0.to_string()}\")]", "unknown field `0.to_string()`")]
fn rejects_invalid_to_string_templates(attribute: string, expected: string) -> () {
    let source = "#[derive(ToString)] enum Value { " + attribute + " Item(isize) }";
    assert_to_string_diagnostic(source, expected)
}

#[test_case("#[derive(ToString)] enum Value { #[to_string(\"{missing}\")] Item { value: string } }", "unknown field `missing`")]
#[test_case("#[derive(ToString)] enum Value { #[to_string(\"{0}\")] Item }", "unknown field `0`")]
#[test_case("#[derive(ToString)] #[to_string(\"x\")] enum Value { Item }", "templates belong on enum variants")]
#[test_case("#[derive(ToString)] #[to_string(\"x\")] struct Value {}", "templates belong on enum variants")]
#[test_case("#[derive(ToString)] struct Value { #[to_string(\"x\")] value: string }", "templates belong on enum variants")]
#[test_case("#[derive(ToString)] enum Value { Item(#[to_string(\"x\")] string) }", "templates belong on enum variants")]
#[test_case("#[derive(ToString)] enum Value { Item { #[to_string(\"x\")] value: string } }", "templates belong on enum variants")]
fn rejects_misplaced_to_string_templates(source: string, expected: string) -> () {
    assert_to_string_diagnostic(source, expected)
}

#[test]
fn requires_to_string_only_for_rendered_variant_fields() -> () {
    let prefix = "struct Opaque {} #[derive(ToString)] enum Value[T] { #[to_string(\"ignored\")] Ignored(T), ";
    let used = prefix
        + "#[to_string(\"{0}\")] Used(T) } fn main() -> string { let value: Value[Opaque] = Used(Opaque {}); value.to_string() }";
    assert_to_string_diagnostic(used, "Method to_string not found");
    let default = prefix
        + "Used(T) } fn main() -> string { let value: Value[Opaque] = Used(Opaque {}); value.to_string() }";
    assert_to_string_diagnostic(default, "Method to_string not found");
    let ignored = "struct Opaque {} #[derive(ToString)] enum Value[T] { #[to_string(\"ignored\")] Item(T) } fn main() -> string { let value: Value[Opaque] = Item(Opaque {}); value.to_string() }";
    let diagnostics = to_string_diagnostics(ignored);
    for diagnostic in diagnostics {
        println(diagnostic.message)
    }
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn locates_to_string_template_errors_at_the_argument() -> () {
    let source = "#[derive(ToString)] enum Value { #[to_string(\"{missing}\")] Item { value: string } }";
    let diagnostics = to_string_diagnostics(source);
    let mut found = false;
    for diagnostic in diagnostics {
        if diagnostic.message.contains("unknown field `missing`") {
            let Some(span) = diagnostic.span else {
                testing::fail("expected template argument span");
                return
            };
            testing::assert_eq(source.byte_slice(span.start, span.end), "\"{missing}\"");
            found = true;
        }
    }
    testing::assert(found)
}
