package query;

use gomlang::toolchain_manifest::resolver;
use gomlang::toolchain_manifest as config;
use std::fs;
use std::path;

fn is_toolchain_import(package_name: string) -> bool {
    package_name == "builtin" || package_name.starts_with("builtin::") || package_name == "prelude"
        || package_name.starts_with("prelude::")
}

fn project_module_graph(project: Project) -> Result[Vec[ResolvedModule], string] {
    let manifest_path = path::join(project.module_root, MANIFEST_FILENAME);
    let manifest = if fs::is_file(manifest_path) {
        load_dependency_manifest(manifest_path)?
    } else {
        DependencyManifest {
            module_path: project.module_path,
            dependencies: Vec::new(),
            dev_dependencies: Vec::new(),
            replacements: Vec::new(),
        }
    };
    let mut development = false;
    for file in project.files {
        development = development || config::development_source(project.module_root, file.path);
    }
    let requirements = if development {
        config::development_dependencies(manifest.dependencies, manifest.dev_dependencies)
    } else {
        manifest.dependencies
    };
    let modules = Vec::from_array(
        [
            resolver::ResolvedModule {
                name: manifest.module_path,
                root: project.module_root,
                version: "local",
                dependencies: requirements,
            },
        ],
    );
    if !requirements.is_empty() {
        let resolved = if development {
            resolve_external_modules_with_development(project.module_root, registry_root()?, true)?
        } else {
            resolve_external_modules(project.module_root)?
        };
        for module in resolved {
            modules.push(module)
        }
    }
    Result::Ok(modules)
}

fn import_owner(modules: Vec[ResolvedModule], package_name: string) -> Option[ResolvedModule] {
    let mut owner: Option[ResolvedModule] = Option::None;
    for module in modules {
        if module_matches_package(module.name, package_name)
            && match owner {
                Some(previous) => module.name.byte_len() > previous.name.byte_len(),
                None => true,
            } {
            owner = Option::Some(module);
        }
    }
    owner
}

fn import_is_declared(modules: Vec[ResolvedModule], importer: string, owner: string) -> bool {
    if importer == owner {
        return true
    }
    for module in modules {
        if module.name == importer {
            for dependency in module.dependencies {
                if dependency.name == owner {
                    return true
                }
            }
        }
    }
    false
}

fn imported_project(
    modules: Result[Vec[ResolvedModule], string],
    importer: string,
    package_name: string,
    overrides: Vec[SourceOverride],
    source_path: string,
) -> Result[Project, string] {
    if let Some(files) = standard_library_sources(package_name)? {
        return Result::Ok(
            Project { module_root: "", module_path: "std", package_dir: "", package_name, files },
        )
    }
    let modules = modules?;
    let importer_module = import_owner(modules, importer).ok_or(
        "missing importing module " + importer,
    )?;
    let development = config::development_source(importer_module.root, source_path);
    let owner = import_owner(modules, package_name).ok_or(
        "package " + package_name + " is not provided by a declared dependency of " + importer,
    )?;
    if !import_is_declared(modules, importer, owner.name) {
        return Result::Err(
            "module " + importer + " imports " + package_name + " from undeclared dependency "
                + owner.name,
        )
    }
    if importer != owner.name && !development {
        let manifest = load_dependency_manifest(path::join(importer_module.root, MANIFEST_FILENAME))?;
        let mut declared = false;
        for dependency in manifest.dependencies {
            declared = declared || dependency.name == owner.name;
        }
        if !declared {
            return Result::Err(
                "production source cannot import development dependency " + owner.name,
            )
        }
    }
    if package_name.starts_with(owner.name + "::examples::")
        && (!development || importer != owner.name) {
        return Result::Err(
            "example package " + package_name
                + " cannot be imported by production code or other modules",
        )
    }
    dependency_project(owner.root, owner.name, package_name, overrides)
}
