package query;

use module::project_info;
use module::source as source_files;

type ResolvedModule = project_info::Module;

fn is_toolchain_import(package_name: string) -> bool {
    package_name == "builtin" || package_name.starts_with("builtin::") || package_name == "prelude"
        || package_name.starts_with("prelude::")
}

fn project_module_graph(project: Project) -> Result[Vec[ResolvedModule], string] {
    if let Some(description) = project.description {
        if let Some(error) = description.error {
            return Result::Err(error)
        }
        return Result::Ok(description.modules)
    }
    Result::Ok(
        Vec::from_array(
            [
                project_info::Module {
                    name: project.module_path,
                    root: project.module_root,
                    dependencies: Vec::new(),
                    dev_dependencies: Vec::new(),
                },
            ],
        ),
    )
}

fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}

fn import_owner(modules: Vec[ResolvedModule], package_name: string) -> Option[ResolvedModule] {
    let mut owner: Option[ResolvedModule] = Option::None;
    for module in modules {
        if module_matches_package(module.name, package_name)
            && match owner {
                Some(previous) => module.name.byte_len() > previous.name.byte_len(),
                None => true,
            } {
            owner = Option::Some(module);
        }
    }
    owner
}

fn import_is_declared(modules: Vec[ResolvedModule], importer: string, owner: string) -> bool {
    if importer == owner {
        return true
    }
    for module in modules {
        if module.name == importer {
            for dependency in module.dev_dependencies {
                if dependency == owner {
                    return true
                }
            }
            for dependency in module.dependencies {
                if dependency == owner {
                    return true
                }
            }
        }
    }
    false
}

fn imported_project(
    modules: Result[Vec[ResolvedModule], string],
    importer: string,
    package_name: string,
    overrides: Vec[SourceOverride],
    source_path: string,
) -> Result[Project, string] {
    if let Some(files) = standard_library_sources(package_name)? {
        return Result::Ok(
            Project {
                description: Option::None,
                module_root: "",
                module_path: "std",
                package_dir: "",
                package_name,
                files,
            },
        )
    }
    let modules = modules?;
    let importer_module = import_owner(modules, importer).ok_or(
        "missing importing module " + importer,
    )?;
    let development = source_files::development_source(importer_module.root, source_path);
    let owner = import_owner(modules, package_name).ok_or(
        "package " + package_name + " is not provided by a declared dependency of " + importer,
    )?;
    if !import_is_declared(modules, importer, owner.name) {
        return Result::Err(
            "module " + importer + " imports " + package_name + " from undeclared dependency "
                + owner.name,
        )
    }
    if importer != owner.name && !development {
        let mut declared = false;
        for dependency in importer_module.dependencies {
            declared = declared || dependency == owner.name;
        }
        if !declared {
            return Result::Err(
                "production source cannot import development dependency " + owner.name,
            )
        }
    }
    if package_name.starts_with(owner.name + "::examples::")
        && (!development || importer != owner.name) {
        return Result::Err(
            "example package " + package_name
                + " cannot be imported by production code or other modules",
        )
    }
    dependency_project(owner.root, owner.name, package_name, overrides)
}
