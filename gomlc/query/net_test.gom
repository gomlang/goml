package query;

use std::testing;

#[test]
fn resolves_net_source_and_completes_namespaces() -> () {
    let source = "use std::net; fn main() -> () { let _ = net::SocketAddr::parse(\"127.0.0.1:0\"); }";
    let analysis = analyze("/tmp/net.gom", source);
    assert_no_diagnostics(analysis);
    let offset = last_substring(source, "parse").unwrap_or(0);
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    match source_by_path(analysis.sources, definitions[0].source_path) {
        Some(target) => {
            testing::assert_eq(target.package_name, "std::net");
            testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "parse",
            );
        },
        None => testing::fail("expected net source"),
    }
    for (prefix, expected) in Vec::from_array(
        [
            ("use std::", "net"),
            ("use std::net::", "IpAddr"),
            ("use std::net::", "SocketAddr"),
            ("use std::net::", "TcpListener"),
            ("use std::net::", "TcpStream"),
            ("use std::net::", "UdpSocket"),
            ("use std::net::", "Datagram"),
            ("use std::net::", "WaitOptions"),
            ("use std::net::", "Shutdown"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/net-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}
