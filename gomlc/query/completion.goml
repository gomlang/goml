package query;

use gomlang::toolchain_manifest as source_files;
use module::ast;
use module::cst;
use module::lexer;
use module::resources;
use module::tast;
use std::collections;
use std::fs;
use std::path;
use std::text;

pub enum CompletionKind {
    Package,
    Function,
    Method,
    Struct,
    Enum,
    Trait,
    Variant,
    Field,
    Variable,
    Keyword,
}

pub struct CompletionItem {
    pub label: string,
    pub detail: string,
    pub kind: CompletionKind,
}

struct UseCompletionContext {
    namespace: string,
    prefix: string,
}

fn identifier_byte(value: u8) -> bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || (value >= 48 && value <= 57)
        || value == 95
}

fn prefix_start(source: string, offset: isize) -> isize {
    let mut start = if offset < source.byte_len() {
        offset
    } else {
        source.byte_len()
    };
    while start > 0 && identifier_byte(source.byte_get(start - 1)) {
        start -= 1;
    }
    start
}

fn completion_prefix(source: string, offset: isize) -> string {
    let start = prefix_start(source, offset);
    source.byte_slice(
        start,
        if offset < source.byte_len() {
            offset
        } else {
            source.byte_len()
        },
    )
}

fn active_use_path_start(source: string, limit: isize) -> Option[isize] {
    let mut depth = 0;
    let mut path_start = Option::None;
    for token in lexer::lex(source) {
        if token.start >= limit {} else if lexer::token_is_trivia(token.kind) {} else if lexer::token_kind_equal(
            token.kind,
            lexer::TokenKind::LBrace,
        ) {
            depth += 1;
        } else if lexer::token_kind_equal(token.kind, lexer::TokenKind::RBrace) {
            if depth > 0 {
                depth -= 1;
            }
        } else if depth == 0 && lexer::token_kind_equal(token.kind, lexer::TokenKind::UseKeyword) {
            path_start = Option::Some(token.end);
        } else if depth == 0 && lexer::token_kind_equal(token.kind, lexer::TokenKind::Semi) {
            path_start = Option::None;
        }
    }
    path_start
}

fn normalized_use_namespace(source: string, start: isize, end: isize) -> Option[string] {
    let builder = text::StringBuilder::new();
    let mut expect_ident = true;
    for token in lexer::lex(source) {
        if token.end <= start || token.start >= end || lexer::token_is_trivia(token.kind) {} else if expect_ident
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident) {
            builder.write_string(token.text);
            expect_ident = false;
        } else if !expect_ident && lexer::token_kind_equal(token.kind, lexer::TokenKind::ColonColon) {
            builder.write_string("::");
            expect_ident = true;
        } else {
            return Option::None;
        }
    }
    let namespace = builder.finish();
    if namespace.ends_with("::") {
        Option::Some(namespace.byte_slice(0, namespace.byte_len() - 2))
    } else {
        Option::Some(namespace)
    }
}

fn use_completion_context(source: string, offset: isize) -> Option[UseCompletionContext] {
    let limit = if offset < source.byte_len() {
        offset
    } else {
        source.byte_len()
    };
    let prefix = completion_prefix(source, limit);
    let prefix_start = limit - prefix.byte_len();
    match active_use_path_start(source, prefix_start) {
        Some(path_start) => normalized_use_namespace(source, path_start, prefix_start).map(
            |namespace| UseCompletionContext { namespace, prefix },
        ),
        None => Option::None,
    }
}

fn label_matches(label: string, prefix: string) -> bool {
    label.starts_with(prefix)
}

fn contains_completion(values: Vec[CompletionItem], expected: string) -> bool {
    for value in values {
        if value.label == expected {
            return true
        }
    }
    false
}

fn push_completion(values: Vec[CompletionItem], value: CompletionItem, prefix: string) -> () {
    if label_matches(value.label, prefix) && !contains_completion(values, value.label) {
        values.push(value)
    }
}

fn symbol_completion_kind(value: SymbolKind) -> CompletionKind {
    match value {
        Function => CompletionKind::Function,
        Struct => CompletionKind::Struct,
        Enum => CompletionKind::Enum,
        Trait => CompletionKind::Trait,
        TypeAlias => CompletionKind::Struct,
        Constant => CompletionKind::Variable,
        Variant => CompletionKind::Variant,
        Method => CompletionKind::Method,
        Field => CompletionKind::Field,
    }
}

fn path_text(value: ast::Path) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for segment in value.segments {
        if index > 0 {
            builder.write_string("::")
        }
        builder.write_string(segment.ident);
        index += 1;
    }
    builder.finish()
}

fn expand_module_namespace(module_path: string, namespace: string) -> string {
    if namespace == "module" {
        module_path
    } else if namespace.starts_with("module::") {
        module_path + namespace.byte_slice("module".byte_len(), namespace.byte_len())
    } else {
        namespace
    }
}

fn last_path_segment(value: ast::Path) -> string {
    if !value.segments.is_empty() {
        value.segments[value.segments.len() - 1].ident
    } else {
        ""
    }
}

fn namespace_target(value: Analysis, alias: string) -> Option[string] {
    let lowered = value.lowered;
    match lowered.ast {
        Some(file) => {
            let mut index = file.uses.len() - 1;
            while index >= 0 {
                let use_decl = file.uses[index];
                for item in use_decl.items {
                    let candidate = item.alias.unwrap_or(item.name);
                    if candidate == alias {
                        return Option::Some(
                            expand_module_namespace(value.module_path, path_text(use_decl.path))
                                + "::"
                                + item.name,
                        )
                    }
                }
                let candidate = use_decl.alias.unwrap_or_else(|| last_path_segment(use_decl.path));
                if candidate == alias {
                    return Option::Some(
                        expand_module_namespace(value.module_path, path_text(use_decl.path)),
                    )
                } else {
                    index -= 1;
                }
            }
            Option::None
        },
        None => Option::None,
    }
}

fn namespace_path(source: string, offset: isize) -> Option[string] {
    let start = prefix_start(source, offset);
    if start >= 2 && text::starts_with_at(source, start - 2, "::") {
        let owner_end = start - 2;
        let mut owner_start = owner_end;
        while owner_start > 0 {
            let byte = source.byte_get(owner_start - 1);
            if identifier_byte(byte) || byte == b':' {
                owner_start -= 1;
            } else {
                break
            }
        }
        if owner_start < owner_end {
            Option::Some(source.byte_slice(owner_start, owner_end))
        } else {
            Option::None
        }
    } else {
        Option::None
    }
}

fn first_namespace_segment(value: string) -> string {
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            return value.byte_slice(0, index)
        } else {
            index += 1;
        }
    }
    value
}

fn canonical_namespace(value: Analysis, namespace: string) -> string {
    let first = first_namespace_segment(namespace);
    match namespace_target(value, first) {
        Some(package_name) => {
            package_name + namespace.byte_slice(first.byte_len(), namespace.byte_len())
        },
        None => namespace,
    }
}

fn namespace_is_package(value: Analysis, namespace: string) -> bool {
    for source in value.sources {
        if source.package_name == namespace {
            return true
        }
    }
    false
}

fn qualified_owner(value: string) -> string {
    symbol_owner(value)
}

fn complete_static_namespace(value: Analysis, namespace: string, prefix: string) -> Vec[
    CompletionItem,
] {
    let canonical = canonical_namespace(value, namespace);
    if namespace_is_package(value, canonical) {
        complete_namespace(value, canonical, prefix)
    } else {
        let result: Vec[CompletionItem] = Vec::new();
        for symbol in build_symbol_index(value).symbols {
            let owner = qualified_owner(symbol.qualified_name);
            if completion_owner_matches(value, owner, canonical)
                && match symbol.kind {
                    Variant | Method => true,
                    _ => false,
                }
                && (symbol.package_name == value.package_name || symbol.public) {
                push_completion(
                    result,
                    CompletionItem {
                        label: symbol.name,
                        detail: symbol.qualified_name,
                        kind: symbol_completion_kind(symbol.kind),
                    },
                    prefix,
                )
            }
        }
        for environment in value.environments {
            for definition in environment.enums {
                if completion_owner_matches(value, definition.name, canonical) {
                    for variant in definition.variants {
                        push_completion(
                            result,
                            CompletionItem {
                                label: variant.name,
                                detail: definition.name,
                                kind: CompletionKind::Variant,
                            },
                            prefix,
                        )
                    }
                }
            }
            for method in environment.methods {
                let receiver = tast::diagnostic_type_text(tast::resolve_type(method.for_type));
                if completion_owner_matches(value, receiver, canonical)
                    && visible_environment_method(value, method, false) {
                    push_completion(
                        result,
                        CompletionItem {
                            label: short_type_name(method.function.name),
                            detail: tast::diagnostic_type_text(
                                tast::Type::Func {
                                    params: method.function.params,
                                    ret_ty: method.function.ret_ty,
                                },
                            ),
                            kind: CompletionKind::Method,
                        },
                        prefix,
                    )
                }
            }
        }
        result
    }
}

fn immediate_package_member(qualified_name: string, package_name: string) -> bool {
    let prefix = package_name + "::";
    if qualified_name.byte_len() <= prefix.byte_len() || !qualified_name.starts_with(prefix) {
        false
    } else {
        let remainder = qualified_name.byte_slice(prefix.byte_len(), qualified_name.byte_len());
        let mut index = 0;
        while index + 1 < remainder.byte_len() {
            if remainder.byte_get(index) == b':' && remainder.byte_get(index + 1) == b':' {
                return false
            }
            index += 1;
        }
        true
    }
}

fn analysis_has_package(value: Analysis, package_name: string) -> bool {
    for source in value.sources {
        if source.package_name == package_name {
            return true
        }
    }
    false
}

fn complete_namespace(value: Analysis, package_name: string, prefix: string) -> Vec[CompletionItem] {
    let result: Vec[CompletionItem] = Vec::new();
    for symbol in build_symbol_index(value).symbols {
        if immediate_package_member(symbol.qualified_name, package_name)
            && (symbol.package_name == value.package_name || symbol.public) {
            push_completion(
                result,
                CompletionItem {
                    label: symbol.name,
                    detail: symbol.qualified_name,
                    kind: symbol_completion_kind(symbol.kind),
                },
                prefix,
            )
        }
    }
    append_comptime_derive_completions(result, value, package_name, prefix);
    result
}

fn push_package_completion(
    values: Vec[CompletionItem],
    label: string,
    detail: string,
    prefix: string,
) -> () {
    push_completion(values, CompletionItem { label, detail, kind: CompletionKind::Package }, prefix)
}

fn namespace_next_segment(value: string, namespace: string) -> Option[string] {
    if namespace == "" {
        Option::Some(first_namespace_segment(value))
    } else {
        let prefix = namespace + "::";
        if value.byte_len() <= prefix.byte_len() || !value.starts_with(prefix) {
            Option::None
        } else {
            Option::Some(
                first_namespace_segment(value.byte_slice(prefix.byte_len(), value.byte_len())),
            )
        }
    }
}

fn package_directory_has_source(directory: string) -> bool {
    match fs::read_dir(directory) {
        Ok(names) => {
            for name in names {
                let candidate = path::join(directory, name);
                if fs::is_file(candidate) && source_files::is_source_file(candidate) {
                    return true
                }
            }
            false
        },
        Err(_) => false,
    }
}

fn complete_local_package_children(
    result: Vec[CompletionItem],
    project: Project,
    namespace: string,
    prefix: string,
) -> () {
    if let Some(directory) = local_package_directory(
        project.module_root,
        project.module_path,
        namespace,
    ) {
        if let Ok(names) = fs::read_dir(directory) {
            for name in names {
                let candidate = path::join(directory, name);
                if fs::is_dir(candidate) && package_directory_has_source(candidate) {
                    push_package_completion(result, name, namespace + "::" + name, prefix)
                }
            }
        }
    }
}

fn complete_source_package(source: SourceFile, prefix: string) -> Vec[CompletionItem] {
    let result: Vec[CompletionItem] = Vec::new();
    let sources: Vec[SourceFile] = Vec::new();
    sources.push(source);
    for symbol in build_symbol_index_from_sources(sources).symbols {
        if symbol.public && immediate_package_member(symbol.qualified_name, source.package_name) {
            push_completion(
                result,
                CompletionItem {
                    label: symbol.name,
                    detail: symbol.qualified_name,
                    kind: symbol_completion_kind(symbol.kind),
                },
                prefix,
            )
        }
    }
    result
}

fn complete_import_namespace(value: Analysis, context: UseCompletionContext) -> Vec[CompletionItem] {
    let result: Vec[CompletionItem] = Vec::new();
    if context.namespace == "" {
        push_package_completion(result, "std", "std", context.prefix)
    } else {
        for child in standard_library_children(context.namespace) {
            push_package_completion(result, child, context.namespace + "::" + child, context.prefix)
        }
    }
    match standard_library_sources(context.namespace) {
        Ok(Some(sources)) => for source in sources {
            for item in complete_source_package(source, context.prefix) {
                push_completion(result, item, context.prefix)
            }
        },
        Ok(None) | Err(_) => (),
    }
    if let Ok(Some(project)) = discover_project(value.source_path, value.source, value.overrides) {
        if context.namespace == "" {
            push_package_completion(result, "module", project.module_path, context.prefix)
        }
        let namespace = expand_module_namespace(project.module_path, context.namespace);
        if let Some(segment) = namespace_next_segment(project.module_path, namespace) {
            push_package_completion(result, segment, project.module_path, context.prefix)
        }
        if namespace == project.module_path || namespace.starts_with(project.module_path + "::") {
            complete_local_package_children(result, project, namespace, context.prefix)
        }
        if let Ok(manifest) = fs::read_file_structured(
            path::join(project.module_root, MANIFEST_FILENAME),
        ) {
            for dependency in manifest_dependencies(manifest) {
                if let Some(segment) = namespace_next_segment(dependency.name, namespace) {
                    push_package_completion(result, segment, dependency.name, context.prefix)
                }
            }
        }
    }
    result
}

fn short_type_name(value: string) -> string {
    let mut start = 0;
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            start = index + 2;
            index += 1;
        }
        index += 1;
    }
    value.byte_slice(start, value.byte_len())
}

fn owner_name_matches(actual: string, expected: string) -> bool {
    actual == expected
        || (short_type_name(expected) == expected && short_type_name(actual) == expected)
}

fn completion_owner_matches(value: Analysis, actual: string, expected: string) -> bool {
    let canonical = canonical_namespace(value, expected);
    if short_type_name(canonical) != canonical {
        actual == canonical
    } else {
        actual == canonical || actual == value.package_name + "::" + canonical
            || actual == "builtin::" + canonical
            || actual == "prelude::" + canonical
    }
}

fn completion_symbol_visible(value: Analysis, symbol: Symbol) -> bool {
    symbol.package_name == value.package_name || symbol.public
}

fn visible_method_symbol(value: Analysis, owner: string, name: string, require_receiver: bool) -> bool {
    for symbol in build_symbol_index(value).symbols {
        if match symbol.kind {
            Method => true,
            _ => false,
        }
            && symbol.name == name
            && completion_owner_matches(value, qualified_owner(symbol.qualified_name), owner)
            && completion_symbol_visible(value, symbol)
            && (!require_receiver || symbol.has_receiver) {
            return true
        }
    }
    false
}

fn visible_environment_method(value: Analysis, method: tast::MethodInfo, require_receiver: bool) -> bool {
    visible_method_symbol(
        value,
        method_owner(method),
        short_type_name(method.function.name),
        require_receiver,
    )
}

fn visible_trait_method(
    value: Analysis,
    owner: string,
    method: tast::TraitMethodInfo,
    require_receiver: bool,
) -> bool {
    (!require_receiver || method.has_receiver)
        && visible_method_symbol(value, owner, method.name, require_receiver)
}

fn current_struct_owner(value: Analysis, owner: string) -> bool {
    for symbol in build_symbol_index(value).symbols {
        if match symbol.kind {
            Struct => true,
            _ => false,
        }
            && symbol.package_name == value.package_name
            && completion_owner_matches(value, symbol.qualified_name, owner) {
            return true
        }
    }
    false
}

fn significant_token_before(value: Analysis, offset: isize) -> Option[SyntaxToken] {
    let mut index = token_index_before(value.syntax, offset);
    while index >= 0 {
        let token = value.syntax.tokens[index];
        if token.end <= offset && !lexer::token_is_trivia(token.kind) {
            return Option::Some(token)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn reference_receiver_fallback(value: Analysis, token: SyntaxToken) -> Option[tast::Type] {
    let facts = value.checked.typeck_results.references;
    for distance in 0..facts.len() {
        let fact = facts[facts.len() - 1 - distance];
        if fact.source_path == value.source_path && fact.span.start <= token.start
            && fact.span.end >= token.end {
            match tast::resolve_type(fact.ty) {
                Error => (),
                _ => return Option::Some(fact.ty),
            }
        }
    }
    Option::None
}

fn local_receiver_fallback(value: Analysis, token: SyntaxToken) -> Option[tast::Type] {
    let facts = value.checked.typeck_results.locals;
    for distance in 0..facts.len() {
        let fact = facts[facts.len() - 1 - distance];
        if fact.source_path == value.source_path && fact.local.hint == token.text {
            if let Some(span) = fact.span {
                if span.start < token.start {
                    return Option::Some(fact.ty)
                }
            }
        }
    }
    Option::None
}

fn receiver_type(value: Analysis, dot: isize) -> Option[tast::Type] {
    match significant_token_before(value, dot) {
        Some(token) => {
            let mut result = Option::None;
            let mut width = 2147483647;
            for fact in value.checked.typeck_results.exprs {
                let fact_width = fact.span.end - fact.span.start;
                if fact.source_path == value.source_path && fact.span.start <= token.start
                    && fact.span.end >= token.end
                    && fact_width <= width {
                    result = Option::Some(fact.ty);
                    width = fact_width;
                }
            }
            match result {
                Some(ty) => match tast::resolve_type(ty) {
                    Error => {
                        match local_receiver_fallback(value, token) {
                            Some(value) => Option::Some(value),
                            None => reference_receiver_fallback(value, token),
                        }
                    },
                    _ => Option::Some(ty),
                },
                None => local_receiver_fallback(value, token),
            }
        },
        None => Option::None,
    }
}

fn member_dot(source: string, offset: isize) -> Option[isize] {
    let start = prefix_start(source, offset);
    if start > 0 && source.byte_get(start - 1) == b'.' {
        Option::Some(start - 1)
    } else {
        Option::None
    }
}

fn explicit_type_name(value: ast::TypeExpr) -> Option[string] {
    match value {
        Con { path } => Option::Some(path_text(path)),
        Dyn { bounds } => if bounds.is_empty() {
            Option::None
        } else {
            Option::Some(path_text(bounds[0].trait_path))
        },
        App { ty, args: _ } => explicit_type_name(ty),
        Bool => Option::Some("bool"),
        Int => Option::Some("isize"),
        Int8 => Option::Some("i8"),
        Int16 => Option::Some("i16"),
        Int32 => Option::Some("i32"),
        Int64 => Option::Some("i64"),
        Uint => Option::Some("usize"),
        Uint8 => Option::Some("u8"),
        Uint16 => Option::Some("u16"),
        Uint32 => Option::Some("u32"),
        Uint64 => Option::Some("u64"),
        Float32 => Option::Some("f32"),
        Float64 => Option::Some("f64"),
        String => Option::Some("string"),
        Char => Option::Some("char"),
        _ => Option::None,
    }
}

fn parameter_explicit_type(parameters: Vec[(string, ast::TypeExpr)], name: string) -> Option[string] {
    let mut index = parameters.len() - 1;
    while index >= 0 {
        let parameter = parameters[index];
        if parameter.0 == name {
            return explicit_type_name(parameter.1)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn source_explicit_receiver_type(source: string, name: string, limit: isize) -> Option[string] {
    let mut index = limit - name.byte_len();
    while index >= 0 {
        if source.byte_slice(index, index + name.byte_len()) == name {
            let mut cursor = index + name.byte_len();
            while cursor < limit && completion_whitespace(source.byte_get(cursor)) {
                cursor += 1;
            }
            if cursor < limit && source.byte_get(cursor) == b':' {
                cursor += 1;
                while cursor < limit && completion_whitespace(source.byte_get(cursor)) {
                    cursor += 1;
                }
                if cursor + 3 <= limit && source.byte_slice(cursor, cursor + 3) == "dyn" {
                    cursor += 3;
                    while cursor < limit && completion_whitespace(source.byte_get(cursor)) {
                        cursor += 1;
                    }
                }
                let type_start = cursor;
                while cursor < limit
                    && (identifier_byte(source.byte_get(cursor)) || source.byte_get(cursor) == b':') {
                    cursor += 1;
                }
                if cursor > type_start {
                    return Option::Some(source.byte_slice(type_start, cursor))
                }
            }
        }
        index -= 1;
    }
    Option::None
}

fn file_parameter_explicit_type(file: ast::File, name: string) -> Option[string] {
    let mut item_index = file.items.len() - 1;
    while item_index >= 0 {
        match file.items[item_index] {
            Function(function) => if let Some(value) = parameter_explicit_type(
                function.params,
                name,
            ) {
                return Option::Some(value)
            },
            ImplBlock(block) => {
                let mut method_index = block.methods.len() - 1;
                while method_index >= 0 {
                    match parameter_explicit_type(block.methods[method_index].params, name) {
                        Some(value) => return Option::Some(value),
                        None => {
                            method_index -= 1;
                        },
                    }
                }
            },
            _ => (),
        }
        item_index -= 1;
    }
    Option::None
}

fn explicit_receiver_type(value: Analysis, dot: isize) -> Option[string] {
    match significant_token_before(value, dot) {
        Some(token) => {
            let lowered = value.lowered;
            let explicit = lowered.ast.and_then(
                |file| file_parameter_explicit_type(file, token.text),
            );
            match explicit {
                Some(name) => Option::Some(name),
                None => source_explicit_receiver_type(value.source, token.text, dot),
            }
        },
        None => Option::None,
    }
}

fn complete_named_methods(
    result: Vec[CompletionItem],
    value: Analysis,
    receiver_name: string,
    prefix: string,
) -> () {
    for symbol in build_symbol_index(value).symbols {
        if match symbol.kind {
            Method => true,
            _ => false,
        }
            && completion_owner_matches(
                value,
                qualified_owner(symbol.qualified_name),
                receiver_name,
            )
            && completion_symbol_visible(value, symbol)
            && symbol.has_receiver {
            push_completion(
                result,
                CompletionItem {
                    label: symbol.name,
                    detail: symbol.qualified_name,
                    kind: CompletionKind::Method,
                },
                prefix,
            )
        }
    }
    for environment in value.environments {
        for definition in environment.traits {
            if completion_owner_matches(value, definition.name, receiver_name) {
                for method in definition.methods {
                    if visible_trait_method(value, definition.name, method, true) {
                        push_completion(
                            result,
                            CompletionItem {
                                label: method.name,
                                detail: tast::diagnostic_type_text(
                                    tast::Type::Func {
                                        params: method.params,
                                        ret_ty: method.ret_ty,
                                    },
                                ),
                                kind: CompletionKind::Method,
                            },
                            prefix,
                        )
                    }
                }
            }
        }
    }
}

fn complete_members(value: Analysis, dot: isize, prefix: string) -> Vec[CompletionItem] {
    let result: Vec[CompletionItem] = Vec::new();
    match receiver_type(value, dot) {
        Some(receiver) => {
            let receiver_name = type_owner_name(receiver);
            let receiver_symbol_name = match tast::resolve_type(receiver) {
                Dyn { trait_name, .. } => trait_name,
                _ => receiver_name,
            };
            complete_named_methods(result, value, receiver_symbol_name, prefix);
            for environment in value.environments {
                for info in environment.structs {
                    if completion_owner_matches(value, info.name, receiver_name) {
                        for field in info.fields {
                            if current_struct_owner(value, info.name)
                                || info.public_fields.contains(field.0) {
                                push_completion(
                                    result,
                                    CompletionItem {
                                        label: field.0,
                                        detail: tast::diagnostic_type_text(field.1),
                                        kind: CompletionKind::Field,
                                    },
                                    prefix,
                                )
                            }
                        }
                    }
                }
                for method in environment.methods {
                    let method_receiver = type_owner_name(method.for_type);
                    if completion_owner_matches(value, method_receiver, receiver_name)
                        && visible_environment_method(value, method, true) {
                        push_completion(
                            result,
                            CompletionItem {
                                label: short_type_name(method.function.name),
                                detail: tast::diagnostic_type_text(
                                    tast::Type::Func {
                                        params: method.function.params,
                                        ret_ty: method.function.ret_ty,
                                    },
                                ),
                                kind: CompletionKind::Method,
                            },
                            prefix,
                        )
                    }
                }
                if let Dyn { trait_name, .. } = tast::resolve_type(receiver) {
                    for definition in environment.traits {
                        if completion_owner_matches(value, definition.name, trait_name) {
                            for method in definition.methods {
                                if visible_trait_method(value, definition.name, method, true) {
                                    push_completion(
                                        result,
                                        CompletionItem {
                                            label: method.name,
                                            detail: tast::diagnostic_type_text(
                                                tast::Type::Func {
                                                    params: method.params,
                                                    ret_ty: method.ret_ty,
                                                },
                                            ),
                                            kind: CompletionKind::Method,
                                        },
                                        prefix,
                                    )
                                }
                            }
                        }
                    }
                }
            }
            if let Error = tast::resolve_type(receiver) {
                if let Some(receiver_name) = explicit_receiver_type(value, dot) {
                    complete_named_methods(result, value, receiver_name, prefix)
                }
            }
        },
        None => if let Some(receiver_name) = explicit_receiver_type(value, dot) {
            complete_named_methods(result, value, receiver_name, prefix)
        },
    }
    result
}

fn completion_scope_kind(value: cst::NodeKind) -> bool {
    cst::node_kind_equal(value, cst::NodeKind::FN)
        || cst::node_kind_equal(value, cst::NodeKind::BLOCK)
        || cst::node_kind_equal(value, cst::NodeKind::EXPR_CLOSURE)
        || cst::node_kind_equal(value, cst::NodeKind::MATCH_ARM)
}

fn containing_completion_scope(syntax: SyntaxIndex, span: ast::Span) -> Option[SyntaxNode] {
    let mut current = token_at(syntax, span.start).map(|token| token.parent);
    while current.is_some() {
        if let Some(id) = current {
            let node = syntax.nodes[id];
            if completion_scope_kind(node.kind) {
                return Option::Some(node)
            } else {
                current = node.parent;
            }
        }
    }
    Option::None
}

fn local_visible_at(syntax: SyntaxIndex, span: ast::Span, offset: isize) -> bool {
    if span.start >= offset {
        false
    } else {
        match containing_completion_scope(syntax, span) {
            Some(scope) => {
                scope.start <= offset && offset <= scope.end
            },
            None => true,
        }
    }
}

fn push_local_completion(
    values: collections::IndexMap[string, CompletionItem],
    value: CompletionItem,
    prefix: string,
) -> () {
    if !label_matches(value.label, prefix) {} else {
        let _ = values.insert(value.label, value);
    }
}

fn prelude_builtin_completion_kind(name: string) -> CompletionKind {
    if name == "Iterator" || name == "IntoIterator" || name == "PartialEq" || name == "Eq"
        || name == "Hash"
        || name == "ToString"
        || name == "Debug"
        || name == "Default" {
        CompletionKind::Trait
    } else if name.byte_len() > 0 && name.byte_get(0) >= b'A' && name.byte_get(0) <= b'Z' {
        CompletionKind::Struct
    } else {
        CompletionKind::Function
    }
}

fn prelude_builtin_symbol(value: Symbol) -> bool {
    if value.package_name != "builtin" || !immediate_package_member(value.qualified_name, "builtin") {
        false
    } else {
        match value.kind {
            Method | Variant | Field => false,
            _ => {
                for name in resources::prelude_builtin_export_names() {
                    if value.name == name {
                        return true
                    }
                }
                false
            },
        }
    }
}

fn append_prelude_scope_completions(result: Vec[CompletionItem], value: Analysis, prefix: string) -> () {
    for symbol in build_symbol_index(value).symbols {
        if (symbol.package_name == "prelude" && symbol.public
            && immediate_package_member(symbol.qualified_name, "prelude"))
            || prelude_builtin_symbol(symbol) {
            push_completion(
                result,
                CompletionItem {
                    label: symbol.name,
                    detail: symbol.qualified_name,
                    kind: symbol_completion_kind(symbol.kind),
                },
                prefix,
            )
        }
    }
    for name in resources::prelude_builtin_export_names() {
        push_completion(
            result,
            CompletionItem {
                label: name,
                detail: "prelude",
                kind: prelude_builtin_completion_kind(name),
            },
            prefix,
        )
    }
}

fn complete_scope(value: Analysis, offset: isize, prefix: string) -> Vec[CompletionItem] {
    let locals: collections::IndexMap[string, CompletionItem] = collections::IndexMap::new();
    for fact in value.checked.typeck_results.locals {
        if fact.source_path == value.source_path {
            if let Some(span) = fact.span {
                if local_visible_at(value.syntax, span, offset) {
                    push_local_completion(
                        locals,
                        CompletionItem {
                            label: fact.local.hint,
                            detail: tast::diagnostic_type_text(fact.ty),
                            kind: CompletionKind::Variable,
                        },
                        prefix,
                    )
                }
            }
        }
    }
    let result = locals.values();
    for symbol in build_symbol_index(value).symbols {
        if immediate_package_member(symbol.qualified_name, value.package_name)
            && (symbol.package_name == value.package_name || symbol.public) {
            push_completion(
                result,
                CompletionItem {
                    label: symbol.name,
                    detail: symbol.qualified_name,
                    kind: symbol_completion_kind(symbol.kind),
                },
                prefix,
            )
        }
    }
    append_prelude_scope_completions(result, value, prefix);
    let lowered = value.lowered;
    if let Some(file) = lowered.ast {
        for import in file.uses {
            let package_name = expand_module_namespace(value.module_path, path_text(import.path));
            if analysis_has_package(value, package_name) {
                let alias = import.alias.unwrap_or_else(|| last_path_segment(import.path));
                push_completion(
                    result,
                    CompletionItem {
                        label: alias,
                        detail: package_name,
                        kind: CompletionKind::Package,
                    },
                    prefix,
                )
            }
        }
    }
    let keywords = Vec::from_array(
        [
            "array",
            "bool",
            "char",
            "dyn",
            "else",
            "enum",
            "extern",
            "false",
            "f32",
            "f64",
            "fn",
            "for",
            "go",
            "if",
            "impl",
            "in",
            "i8",
            "i16",
            "i32",
            "i64",
            "isize",
            "let",
            "loop",
            "match",
            "package",
            "pub",
            "return",
            "select",
            "string",
            "struct",
            "trait",
            "true",
            "type",
            "u8",
            "u16",
            "u32",
            "u64",
            "usize",
            "use",
            "while",
            "_",
        ],
    );
    for keyword in keywords {
        push_completion(
            result,
            CompletionItem { label: keyword, detail: "", kind: CompletionKind::Keyword },
            prefix,
        )
    }
    result
}

fn completion_whitespace(value: u8) -> bool {
    value == 9 || value == 10 || value == 13 || value == 32
}

fn previous_completion_byte(source: string, end: isize) -> Option[isize] {
    let mut index = end;
    while index > 0 && completion_whitespace(source.byte_get(index - 1)) {
        index -= 1;
    }
    if index == 0 {
        Option::None
    } else {
        Option::Some(index - 1)
    }
}

fn completion_word_before(source: string, end: isize) -> string {
    match previous_completion_byte(source, end) {
        Some(last) => {
            let mut start = last;
            while start > 0 && identifier_byte(source.byte_get(start - 1)) {
                start -= 1;
            }
            source.byte_slice(start, last + 1)
        },
        None => "",
    }
}

fn call_open_before(source: string, offset: isize) -> Option[isize] {
    let mut index = offset;
    let mut depth = 0;
    while index > 0 {
        index -= 1;
        let byte = source.byte_get(index);
        if byte == b')' {
            depth += 1;
        } else if byte == b'(' {
            if depth == 0 {
                return Option::Some(index)
            } else {
                depth -= 1;
            }
        }
    }
    Option::None
}

fn call_argument_context(source: string, offset: isize) -> bool {
    let start = prefix_start(source, offset);
    match call_open_before(source, start) {
        Some(open) => {
            let previous = completion_word_before(source, open);
            previous != "" && previous != "if" && previous != "while" && previous != "loop"
                && previous != "for"
                && previous != "match"
                && previous != "fn"
        },
        None => false,
    }
}

fn insert_completion_placeholder(source: string, offset: isize) -> string {
    source.byte_slice(0, offset) + "completion_placeholder"
        + source.byte_slice(offset, source.byte_len())
}

fn completion_open_brace(source: string, end: isize) -> Option[isize] {
    let mut index = end;
    let mut depth = 0;
    while index > 0 {
        index -= 1;
        let value = source.byte_get(index);
        if value == b'}' {
            depth += 1;
        } else if value == b'{' {
            if depth == 0 {
                return Option::Some(index)
            } else {
                depth -= 1;
            }
        }
    }
    Option::None
}

fn select_completion_open(source: string, offset: isize) -> Option[isize] {
    match completion_open_brace(source, offset) {
        Some(open) => {
            let previous = completion_word_before(source, open);
            if previous == "select" {
                Option::Some(open)
            } else if previous == "priority" {
                match previous_completion_byte(source, open) {
                    Some(last) => {
                        let mut priority_start = last;
                        while priority_start > 0
                            && identifier_byte(source.byte_get(priority_start - 1)) {
                            priority_start -= 1;
                        }
                        if completion_word_before(source, priority_start) == "select" {
                            Option::Some(open)
                        } else {
                            Option::None
                        }
                    },
                    None => Option::None,
                }
            } else {
                Option::None
            }
        },
        None => Option::None,
    }
}

fn push_contextual_completion(
    result: Vec[CompletionItem],
    label: string,
    detail: string,
    prefix: string,
) -> () {
    push_completion(result, CompletionItem { label, detail, kind: CompletionKind::Keyword }, prefix)
}

fn append_select_completions(
    result: Vec[CompletionItem],
    source: string,
    offset: isize,
    prefix: string,
) -> () {
    let start = prefix_start(source, offset);
    if completion_word_before(source, start) == "select" {
        push_contextual_completion(result, "priority", "priority select", prefix)
    }
    if let Some(open) = select_completion_open(source, start) {
        let content = source.byte_slice(open + 1, start);
        push_contextual_completion(result, "recv", "select receive arm", prefix);
        push_contextual_completion(result, "send", "select send arm", prefix);
        if !content.contains("default") {
            push_contextual_completion(result, "default", "select default arm", prefix)
        }
        let mut arm_start = content.byte_len();
        while arm_start > 0 && content.byte_get(arm_start - 1) != b',' {
            arm_start -= 1;
        }
        let arm = content.byte_slice(arm_start, content.byte_len());
        if arm.contains("recv(") && arm.contains(")") && !arm.contains("=>") {
            push_contextual_completion(result, "when", "select guard", prefix);
            push_contextual_completion(result, "as", "receive binding", prefix);
            push_contextual_completion(result, "match", "receive match", prefix)
        } else if arm.contains("send(") && arm.contains(")") && !arm.contains("=>") {
            push_contextual_completion(result, "when", "select guard", prefix)
        }
    }
}

fn completion_query(value: Analysis, source: string, offset: isize, prefix: string) -> Vec[
    CompletionItem,
] {
    match member_dot(source, offset) {
        Some(dot) => complete_members(value, dot, prefix),
        None => match namespace_path(source, offset) {
            Some(namespace) => {
                complete_static_namespace(value, namespace, prefix)
            },
            None => complete_scope(value, offset, prefix),
        },
    }
}

fn completions_for_source(value: Analysis, source: string, offset: isize, recover: bool) -> Vec[
    CompletionItem,
] {
    let prefix = completion_prefix(source, offset);
    match use_completion_context(source, offset) {
        Some(context) => complete_import_namespace(value, context),
        None => if prefix == "" && member_dot(source, offset).is_none()
            && namespace_path(source, offset).is_none()
            && call_argument_context(source, offset) {
            Vec::new()
        } else {
            let result = completion_query(value, source, offset, prefix);
            append_select_completions(result, source, offset, prefix);
            if !result.is_empty() || !recover
                || (member_dot(source, offset).is_none() && namespace_path(source, offset).is_none()) {
                result
            } else {
                let repaired_source = insert_completion_placeholder(source, offset);
                let repaired = analyze_with_context(
                    value.context,
                    value.source_path,
                    repaired_source,
                    value.overrides,
                );
                completion_query(repaired, source, offset, prefix)
            }
        },
    }
}

pub fn cached_completions(value: Analysis, source: string, offset: isize) -> Vec[CompletionItem] {
    completions_for_source(value, source, offset, false)
}

pub fn completions(value: Analysis, offset: isize) -> Vec[CompletionItem] {
    completions_for_source(value, value.source, offset, true)
}
