package query;

use gomlang::toolchain_manifest::resolver;
use std::fs;

struct RegistryProvider {}

impl resolver::Provider for RegistryProvider {
    type Error = string;

    fn load(self: RegistryProvider, filename: string) -> Result[resolver::Manifest, string] {
        load_dependency_manifest(filename).map(
            |value| resolver::Manifest {
                module_path: value.module_path,
                dependencies: value.dependencies,
            },
        )
    }

    fn canonicalize(self: RegistryProvider, directory: string) -> Result[string, string] {
        fs::canonicalize(directory).map_err(|error| error.to_string())
    }

    fn select(self: RegistryProvider, root: string, dependency: DependencyRequirement) -> Result[
        string,
        string,
    ] {
        module_directory(root, dependency.name)
    }

    fn failure(self: RegistryProvider, message: string) -> string {
        message
    }
}
