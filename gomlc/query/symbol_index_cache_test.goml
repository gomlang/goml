package query;

use std::testing;

fn symbol_cache_analysis(context: AnalysisContext, source: string, dependency: SourceFile) -> Analysis {
    let entry_path = "/tmp/goml-query-symbol-cache-entry.goml";
    let mut analysis = analyze_with_context(context, entry_path, source, Vec::new());
    assert_no_diagnostics(analysis);
    analysis.sources = Vec::from_array(
        [SourceFile { path: entry_path, source, package_name: analysis.package_name }, dependency],
    );
    analysis
}

#[test]
fn symbol_index_cache_tracks_dependency_source_and_package_identity() -> () {
    let context = analysis_context();
    let dependency_path = "/tmp/goml-query-symbol-cache-dependency.goml";
    let source = "pub fn entry() -> () {}";
    let original = build_symbol_index(
        symbol_cache_analysis(
            context,
            source,
            SourceFile {
                path: dependency_path,
                source: "pub fn alpha() -> () {}",
                package_name: "example::first",
            },
        ),
    );
    let alpha = testing::expect_some(
        find_symbol(original, "example::first::alpha"),
        "original symbol",
    );
    testing::assert_eq(alpha.source_path, dependency_path);
    let edited = build_symbol_index(
        symbol_cache_analysis(
            context,
            source,
            SourceFile {
                path: dependency_path,
                source: "pub fn omega() -> () {}",
                package_name: "example::first",
            },
        ),
    );
    testing::assert(find_symbol(edited, "example::first::alpha").is_none());
    let omega = testing::expect_some(find_symbol(edited, "example::first::omega"), "edited symbol");
    testing::assert_eq(omega.source_path, dependency_path);
    let renamed = build_symbol_index(
        symbol_cache_analysis(
            context,
            source,
            SourceFile {
                path: dependency_path,
                source: "pub fn omega() -> () {}",
                package_name: "example::second",
            },
        ),
    );
    let renamed_symbol = testing::expect_some(
        find_symbol(renamed, "example::second::omega"),
        "renamed package symbol",
    );
    testing::assert_eq(renamed_symbol.package_name, "example::second");
    testing::assert_eq(renamed_symbol.qualified_name, "example::second::omega");
    testing::assert_eq(omega.qualified_name, "example::first::omega");
    testing::assert_eq(alpha.name, "alpha");
}

#[test]
fn symbol_index_cache_keeps_results_separate_from_cached_dependencies() -> () {
    let context = analysis_context();
    let dependency = SourceFile {
        path: "/tmp/goml-query-symbol-cache-isolation.goml",
        source: "pub fn dependency() -> () {}",
        package_name: "example::dependency",
    };
    let original = build_symbol_index(
        symbol_cache_analysis(context, "pub fn original() -> () {}", dependency),
    );
    testing::assert_eq(original.symbols.len(), 2);
    original.symbols.push(original.symbols[0]);
    let cached = testing::expect_some(
        context.source_symbols.get(dependency.path),
        "cached dependency",
    );
    testing::assert_eq(cached.symbols.len(), 1);
    testing::assert_eq(cached.symbols[0].name, "dependency");
    let next = build_symbol_index(
        symbol_cache_analysis(context, "pub fn next() -> () {}", dependency),
    );
    testing::assert_eq(next.symbols.len(), 2);
    testing::assert(find_symbol(next, "original").is_none());
    testing::assert(find_symbol(next, "next").is_some());
    testing::assert(find_symbol(next, "example::dependency::dependency").is_some());
    next.symbols.push(next.symbols[0]);
    testing::assert_eq(cached.symbols.len(), 1);
    let independent = build_symbol_index_from_sources(Vec::from_array([dependency]));
    testing::assert_eq(independent.symbols.len(), 1);
    testing::assert_eq(independent.symbols[0].qualified_name, "example::dependency::dependency");
    clear_analysis_cache(context);
    testing::assert(context.source_symbols.get(dependency.path).is_none());
    let rebuilt = build_symbol_index(
        symbol_cache_analysis(context, "pub fn rebuilt() -> () {}", dependency),
    );
    testing::assert_eq(rebuilt.symbols.len(), 2);
    testing::assert(find_symbol(rebuilt, "rebuilt").is_some());
    testing::assert(find_symbol(rebuilt, "example::dependency::dependency").is_some());
}
