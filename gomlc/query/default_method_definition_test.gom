package query;

use std::testing;

#[test]
fn navigates_default_trait_method_by_callable_identity() -> () {
    let source = "struct Item {} trait First { fn select(self: Self, value: isize) -> isize { value } } trait Second { fn select(self: Self, value: string) -> string { value } } impl First for Item {} impl Second for Item {} fn main() -> () { let item = Item {}; let _ = item.select(1); let _ = item.select(\"x\"); }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    for (call, declaration) in[
        ("item.select(1)", "fn select(self: Self, value: isize)"),
        ("item.select(\"x\")", "fn select(self: Self, value: string)"),
    ] {
        let offset = testing::expect_some(last_substring(source, call), "default call");
        let expected = testing::expect_some(
            last_substring(source, declaration),
            "trait declaration",
        )
            + 3;
        let definitions = goto_definitions(analysis, offset + 5);
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(definitions[0].source_path, "main.gom");
        testing::assert_eq(definitions[0].span.start, expected);
    }
}

#[test]
fn navigates_standard_buffered_default_trait_method() -> () {
    let source = "use std::io; use io::BufRead; fn main() -> () { let _ = io::BufReader::new(io::StringReader::new(\"x\")).discard(1); }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    let offset = testing::expect_some(last_substring(source, "discard"), "discard call");
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    testing::assert(definitions[0].source_path.ends_with("/std/io/traits.gom"));
    let target = testing::expect_some(
        source_by_path(analysis.sources, definitions[0].source_path),
        "trait source",
    );
    testing::assert_eq(
        target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
        "discard",
    );
}
