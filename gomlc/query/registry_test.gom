package query;

use std::fs;
use std::testing;

#[test]
fn ignores_commented_dependencies() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\# "alice::unused" = "9.0.0"
        \\"alice::http" = "1.0.0" # "alice::unused" = "9.0.0"
        \\  # "alice::other" = "2.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert_eq(dependencies[0].version, "1.0.0")
}

#[test]
fn recognizes_dependency_sections_with_inline_comments() -> () {
    let dependencies = manifest_dependencies(
        \\[module]
        \\path = "alice::app"
        \\[dependencies] # "ignored" = "9.0.0"
        \\  "alice::http" = "1.0.0"
        \\[build] # end dependencies
        \\target-dir = "output"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert_eq(dependencies[0].version, "1.0.0")
}

#[test]
fn preserves_comment_characters_inside_dependency_strings() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\"alice::http#invalid" = "1.0.0#invalid" # "ignored" = "9.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http#invalid");
    testing::assert_eq(dependencies[0].version, "1.0.0#invalid")
}

#[test]
fn ignores_quoted_comments_in_registry_versions() -> () {
    let root = "/tmp/gomlc-query-registry-comments";
    if let Err(error) = fs::create_dir_all(root) {
        testing::fail(error.to_string())
    }
    write_query_fixture(
        root + "/index.toml",
        \\[modules."alice::http"] # "ignored"
        \\latest = "1.0.0"
        \\versions = ["1.0.0"] # "not-a-version"
        ,
    );
    match select_registry_version(
        root,
        DependencyRequirement { name: "alice::http", version: "1.0.0" },
    ) {
        Ok(version) => testing::assert_eq(version, "1.0.0"),
        Err(error) => testing::fail(error),
    }
}
