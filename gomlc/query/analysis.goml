package query;

use module::ast;
use module::cst;
use module::ctir;
use module::hir;
use module::parser;
use module::tast;
use std::collections;
use std::env;
use std::path;

pub struct Analysis {
    pub source_path: string,
    pub source: string,
    pub package_name: string,
    pub module_path: string,
    pub overrides: Vec[SourceOverride],
    pub sources: Vec[SourceFile],
    pub environments: Vec[tast::DependencyEnvironment],
    pub parse: cst::ParseResult,
    pub syntax: SyntaxIndex,
    pub expanded_source: string,
    pub checked: tast::CheckResult,
    context: AnalysisContext,
    comptime_modules: Vec[ctir::CtModule],
    lowered: ast::LowerResult,
    symbol_index: Ref[Option[SymbolIndex]],
    documentation_index: Ref[Option[DocumentationIndex]],
    expanded_asts: Vec[(string, ast::LowerResult)],
}

pub struct AnalysisContext {
    discoveries: collections::IndexMap[string, CachedDiscovery],
    packages: collections::IndexMap[string, CachedPackage],
    source_symbols: collections::IndexMap[string, CachedSourceSymbols],
    stats: Ref[AnalysisStats],
    foreign_helper: Result[string, string],
    builtin_files: Result[Vec[hir::File], string],
    prelude_files: Result[Vec[hir::File], string],
    builtin_derive: Result[Option[ctir::CtModule], string],
    builtin_sources: Result[Vec[SourceFile], string],
    prelude_sources: Result[Vec[SourceFile], string],
}

struct LoweredPackage {
    name: string,
    files: Vec[hir::File],
    expanded_sources: Vec[(string, string)],
    expanded_asts: Vec[(string, ast::LowerResult)],
    diagnostics: Vec[tast::Diagnostic],
}

struct ProjectCheck {
    checked: tast::CheckResult,
    sources: Vec[SourceFile],
    environments: Vec[tast::DependencyEnvironment],
    expanded_sources: Vec[(string, string)],
    expanded_asts: Vec[(string, ast::LowerResult)],
    comptime_modules: Vec[ctir::CtModule],
}

pub fn analysis_context() -> AnalysisContext {
    let helper = env::current_exe_structured().map_err(|error| error.to_string()).and_then(
        |executable| path::parent(executable).ok_or("compiler has no executable directory"),
    ).map(|directory| path::join(directory, "goml-go-meta"));
    analysis_context_with_foreign_helper(helper)
}

pub fn analysis_context_with_foreign_helper(helper: Result[string, string]) -> AnalysisContext {
    AnalysisContext {
        discoveries: collections::IndexMap::new(),
        packages: collections::IndexMap::new(),
        source_symbols: collections::IndexMap::new(),
        stats: Ref::new(AnalysisStats { checked_packages: Vec::new(), reused_packages: Vec::new() }),
        foreign_helper: helper,
        builtin_files: builtin_hir_files(),
        prelude_files: prelude_hir_files(),
        builtin_derive: builtin_comptime_module(),
        builtin_sources: builtin_navigation_sources(),
        prelude_sources: prelude_navigation_sources(),
    }
}

fn query_diagnostic(source_path: string, stage: string, message: string, span: Option[ast::Span]) -> tast::Diagnostic {
    tast::Diagnostic {
        code: Option::None,
        notes: Vec::new(),
        help: Vec::new(),
        fixes: Vec::new(),
        severity: tast::DiagnosticSeverity::Error,
        stage,
        message,
        source_path,
        span,
        primary_label: Option::None,
        secondary_labels: Vec::new(),
        sort_order: 0,
    }
}

fn failed_check(source_path: string, stage: string, message: string) -> tast::CheckResult {
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    diagnostics.push(query_diagnostic(source_path, stage, message, Option::None));
    tast::CheckResult {
        tast: Option::None,
        comptime: ctir::empty_module(source_path),
        pending_constants: Vec::new(),
        diagnostics,
        typeck_results: tast::empty_typeck_results(),
    }
}

fn lower_package(
    value: Project,
    builtin_derive: Option[ctir::CtModule],
    derive_modules: Vec[ctir::CtModule],
    derive_reexports: Vec[(string, string)],
    local: Option[ctir::CtModule],
) -> LoweredPackage {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    let expanded_sources: Vec[(string, string)] = Vec::new();
    let expanded_asts: Vec[(string, ast::LowerResult)] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    for file in value.files {
        let parsed = ast::resolve_module_paths(
            hir::expand_go_interfaces(ast::lower(parser::parse(file.source))),
            value.module_path,
        );
        if value.module_path != "std" && value.module_path != "builtin"
            && value.module_path != "prelude" {
            if let Some(ast) = parsed.ast {
                for use_decl in ast.uses {
                    let name = path_text(use_decl.path);
                    if is_toolchain_import(name) {
                        diagnostics.push(
                            query_diagnostic(
                                file.path,
                                "project",
                                "package " + name + " is internal to the toolchain",
                                Option::None,
                            ),
                        )
                    }
                }
            }
        }
        let expanded = hir::expand_derives_with_environment(
            parsed,
            hir::DeriveEnvironment {
                local,
                builtin: builtin_derive,
                dependencies: derive_modules,
                reexports: derive_reexports,
            },
        );
        expanded_sources.push((file.path, ast::pretty(expanded)));
        expanded_asts.push((file.path, expanded));
        inputs.push((expanded, file.path))
    }
    let lowered = hir::lower_expanded_package_files(inputs, value.package_name);
    let files: Vec[hir::File] = Vec::new();
    for value in lowered {
        for diagnostic in value.diagnostics {
            diagnostics.push(
                query_diagnostic(value.source_path, "lower", diagnostic.message, diagnostic.span),
            )
        }
        if let Some(file) = value.hir {
            files.push(file)
        }
    }
    LoweredPackage { name: value.package_name, files, expanded_sources, expanded_asts, diagnostics }
}

fn append_derive_reexports(files: Vec[hir::File], result: Vec[(string, string)]) -> () {
    for file in files {
        for value in file.public_reexports {
            result.push(
                (
                    if file.package_name == "main" || file.package_name == "builtin"
                        || file.package_name == "prelude" {
                        value.0
                    } else {
                        file.package_name + "::" + value.0
                    },
                    value.1,
                ),
            )
        }
    }
}

fn expanded_source_for_path(values: Vec[(string, string)], source_path: string) -> string {
    for value in values {
        if value.0 == source_path {
            return value.1
        }
    }
    ""
}

fn environments_with_comptime(
    files: Vec[hir::File],
    modules: Vec[ctir::CtModule],
    checked_dependencies: Vec[tast::File],
    external: Vec[tast::ExternalTypeEnvironment],
) -> Result[Vec[tast::DependencyEnvironment], string] {
    let environments = tast::dependency_environments_with_checked_external_files(
        files,
        checked_dependencies,
        external,
    )?;
    let attached_modules: collections::HashSet[string] = collections::HashSet::new();
    for index in 0..environments.len() {
        let module = Ref::new(Option::None);
        let package_name = files[index].package_name;
        if attached_modules.contains(package_name) {} else {
            for value in modules {
                if value.package_name == package_name {
                    module.set(Option::Some(value));
                    let _ = attached_modules.insert(package_name);
                }
            }
        }
        environments.set(
            index,
            tast::dependency_environment_with_comptime(environments[index], module.get()),
        )
    }
    Result::Ok(environments)
}

fn environments_with_builtin_and_comptime(
    builtin: Option[tast::DependencyEnvironment],
    files: Vec[hir::File],
    modules: Vec[ctir::CtModule],
    checked_dependencies: Vec[tast::File],
    external: Vec[tast::ExternalTypeEnvironment],
) -> Result[Vec[tast::DependencyEnvironment], string] {
    let result: Vec[tast::DependencyEnvironment] = Vec::new();
    if let Some(environment) = builtin {
        result.push(environment)
    }
    for environment in environments_with_comptime(files, modules, checked_dependencies, external)? {
        result.push(environment)
    }
    Result::Ok(result)
}

fn package_has_comptime(files: Vec[hir::File]) -> bool {
    for file in files {
        for item in file.items {
            if let hir::Item::Function(value) = item {
                for attribute in value.attrs {
                    if attribute.name == "comptime" || attribute.name == "comptime_derive" {
                        return true
                    }
                }
            }
        }
    }
    false
}

fn collect_dependency(
    modules: Result[Vec[ResolvedModule], string],
    importer: string,
    package_name: string,
    overrides: Vec[SourceOverride],
    visited: collections::HashSet[string],
    dependencies: Vec[hir::File],
    checked_dependencies: Vec[tast::File],
    diagnostics: Vec[tast::Diagnostic],
    all_sources: Vec[SourceFile],
    source_path: string,
    builtin_environment: Option[tast::DependencyEnvironment],
    builtin_derive: Option[ctir::CtModule],
    derive_modules: Vec[ctir::CtModule],
    derive_reexports: Vec[(string, string)],
    external: Vec[tast::ExternalTypeEnvironment],
    foreign: QueryForeignContext,
    context: AnalysisContext,
    revisions: collections::IndexMap[string, PackageRevision],
) -> () {
    if is_toolchain_import(package_name) {
        return
    }
    match imported_project(modules, importer, package_name, overrides, source_path) {
        Ok(project) => {
            if !visited.insert(package_name) {
                return
            }
            for source in project.files {
                all_sources.push(source)
            }
            let discovery = discover_cached_package(context, project, builtin_derive);
            for file in discovery.files {
                for import in file.import_aliases {
                    collect_dependency(
                        modules,
                        project.module_path,
                        import.package_name,
                        overrides,
                        visited,
                        dependencies,
                        checked_dependencies,
                        diagnostics,
                        all_sources,
                        file.source_path,
                        builtin_environment,
                        builtin_derive,
                        derive_modules,
                        derive_reexports,
                        external,
                        foreign,
                        context,
                        revisions,
                    )
                }
            }
            let revision = package_revision(project, discovery, revisions);
            let selected = selected_dependency_files(dependencies, revision);
            let environments = match environments_with_builtin_and_comptime(
                builtin_environment,
                selected,
                derive_modules,
                checked_dependencies,
                external,
            ) {
                Ok(value) => value,
                Err(error) => {
                    diagnostics.push(query_diagnostic(source_path, "builtin", error, Option::None));
                    Vec::new()
                },
            };
            let (lowered, checked) = check_cached_package(
                context,
                project,
                revision,
                builtin_derive,
                derive_modules,
                derive_reexports,
                environments,
                external,
                foreign,
            );
            let _ = revisions.insert(
                package_name,
                PackageRevision {
                    cacheable: revision.cacheable
                        && !tast::diagnostics_have_errors(lowered.diagnostics)
                        && !tast::diagnostics_have_errors(checked.diagnostics),
                    ..revision,
                },
            );
            for diagnostic in lowered.diagnostics {
                diagnostics.push(diagnostic)
            }
            if package_has_comptime(lowered.files)
                && !tast::diagnostics_have_errors(checked.diagnostics) {
                derive_modules.push(checked.comptime)
            }
            if let Some(file) = checked.tast {
                checked_dependencies.push(file)
            }
            for diagnostic in checked.diagnostics {
                diagnostics.push(diagnostic)
            }
            append_derive_reexports(lowered.files, derive_reexports);
            for file in lowered.files {
                dependencies.push(file)
            }
        },
        Err(error) => diagnostics.push(
            query_diagnostic(source_path, "project", error, Option::None),
        ),
    }
}

fn append_navigation_sources(
    values: Vec[SourceFile],
    sources: Result[Vec[SourceFile], string],
    checked: tast::CheckResult,
) -> () {
    match sources {
        Ok(sources) => for source in sources {
            values.push(source)
        },
        Err(error) => checked.diagnostics.push(
            query_diagnostic("", "resources", error, Option::None),
        ),
    }
}

fn check_project(value: Project, overrides: Vec[SourceOverride], context: AnalysisContext) -> ProjectCheck {
    context.stats.set(AnalysisStats { checked_packages: Vec::new(), reused_packages: Vec::new() });
    let revisions: collections::IndexMap[string, PackageRevision] = collections::IndexMap::new();
    let external: Vec[tast::ExternalTypeEnvironment] = Vec::new();
    let foreign = query_foreign_context(context.foreign_helper, value.module_root);
    let all_sources: Vec[SourceFile] = Vec::new();
    for file in value.files {
        all_sources.push(file)
    }
    let dependencies: Vec[hir::File] = Vec::new();
    let checked_dependencies: Vec[tast::File] = Vec::new();
    let diagnostics: Vec[tast::Diagnostic] = Vec::new();
    let builtin_environment = match context.builtin_files {
        Ok(files) => match tast::builtin_dependency_environment(files) {
            Ok(value) => Option::Some(value),
            Err(error) => {
                diagnostics.push(
                    query_diagnostic(value.files[0].path, "builtin", error, Option::None),
                );
                Option::None
            },
        },
        Err(error) => {
            diagnostics.push(query_diagnostic(value.files[0].path, "builtin", error, Option::None));
            Option::None
        },
    };
    match context.prelude_files {
        Ok(files) => for file in files {
            dependencies.push(file)
        },
        Err(error) => diagnostics.push(
            query_diagnostic(value.files[0].path, "prelude", error, Option::None),
        ),
    }
    let builtin_derive = match context.builtin_derive {
        Ok(value) => value,
        Err(error) => {
            diagnostics.push(query_diagnostic(value.files[0].path, "builtin", error, Option::None));
            Option::None
        },
    };
    let derive_reexports: Vec[(string, string)] = Vec::new();
    let discovery = discover_cached_package(context, value, builtin_derive);
    let modules = project_module_graph(value);
    let visited: collections::HashSet[string] = collections::HashSet::new();
    let derive_modules: Vec[ctir::CtModule] = Vec::new();
    let _ = visited.insert(discovery.name);
    let _ = visited.insert("builtin");
    let _ = visited.insert("prelude");
    for file in discovery.files {
        for import in file.import_aliases {
            collect_dependency(
                modules,
                value.module_path,
                import.package_name,
                overrides,
                visited,
                dependencies,
                checked_dependencies,
                diagnostics,
                all_sources,
                file.source_path,
                builtin_environment,
                builtin_derive,
                derive_modules,
                derive_reexports,
                external,
                foreign,
                context,
                revisions,
            )
        }
    }
    let revision = package_revision(value, discovery, revisions);
    let dependency_environments = environments_with_builtin_and_comptime(
        builtin_environment,
        dependencies,
        derive_modules,
        checked_dependencies,
        external,
    ).unwrap_or_else(
        |error| {
            diagnostics.push(query_diagnostic(value.files[0].path, "builtin", error, Option::None));
            Vec::new()
        },
    );
    let (entry, entry_checked) = check_cached_package(
        context,
        value,
        revision,
        builtin_derive,
        derive_modules,
        derive_reexports,
        dependency_environments,
        external,
        foreign,
    );
    for diagnostic in entry.diagnostics {
        diagnostics.push(diagnostic)
    }
    let environment_files: Vec[hir::File] = Vec::new();
    for file in entry.files {
        environment_files.push(file)
    }
    for file in dependencies {
        environment_files.push(file)
    }
    let environments = match environments_with_builtin_and_comptime(
        builtin_environment,
        environment_files,
        derive_modules,
        checked_dependencies,
        external,
    ) {
        Ok(values) => values,
        Err(error) => {
            diagnostics.push(query_diagnostic(value.files[0].path, "builtin", error, Option::None));
            Vec::new()
        },
    };
    let checked = entry_checked;
    for diagnostic in diagnostics {
        checked.diagnostics.push(diagnostic)
    }
    append_navigation_sources(all_sources, context.builtin_sources, checked);
    append_navigation_sources(all_sources, context.prelude_sources, checked);
    let comptime_modules: Vec[ctir::CtModule] = Vec::new();
    if let Some(module) = builtin_derive {
        comptime_modules.push(module)
    }
    for module in derive_modules {
        comptime_modules.push(module)
    }
    ProjectCheck {
        checked,
        sources: all_sources,
        environments,
        expanded_sources: entry.expanded_sources,
        expanded_asts: entry.expanded_asts,
        comptime_modules,
    }
}

fn single_file_analysis(
    source_path: string,
    source: string,
    parsed: cst::ParseResult,
    lowered: ast::LowerResult,
    syntax: SyntaxIndex,
    overrides: Vec[SourceOverride],
    context: AnalysisContext,
) -> Analysis {
    let hir_value = hir::lower(lowered, source_path);
    let package_name = match hir_value.hir {
        Some(file) => if file.package_name == "" {
            "main"
        } else {
            file.package_name
        },
        None => "main",
    };
    let files: Vec[SourceFile] = Vec::new();
    files.push(SourceFile { path: source_path, source, package_name });
    let directory = source_directory(source_path);
    let result = check_project(
        Project {
            module_root: directory,
            module_path: package_name,
            package_dir: directory,
            package_name,
            files,
        },
        overrides,
        context,
    );
    Analysis {
        source_path,
        source,
        package_name,
        module_path: package_name,
        overrides,
        sources: result.sources,
        environments: result.environments,
        parse: parsed,
        syntax,
        expanded_source: expanded_source_for_path(result.expanded_sources, source_path),
        expanded_asts: result.expanded_asts,
        checked: result.checked,
        context,
        comptime_modules: result.comptime_modules,
        lowered,
        symbol_index: Ref::new(Option::None),
        documentation_index: Ref::new(Option::None),
    }
}

pub fn analyze_with_context(
    context: AnalysisContext,
    source_path: string,
    source: string,
    overrides: Vec[SourceOverride],
) -> Analysis {
    let parsed = parser::parse(source);
    let lowered = ast::lower(parsed);
    let syntax = syntax_index(parsed.root);
    match discover_project(source_path, source, overrides) {
        Ok(Some(project)) => {
            let package_name = project.package_name;
            let module_path = project.module_path;
            let result = check_project(project, overrides, context);
            Analysis {
                source_path,
                source,
                package_name,
                module_path,
                overrides,
                sources: result.sources,
                environments: result.environments,
                parse: parsed,
                syntax,
                expanded_source: expanded_source_for_path(result.expanded_sources, source_path),
                expanded_asts: result.expanded_asts,
                checked: result.checked,
                context,
                comptime_modules: result.comptime_modules,
                lowered,
                symbol_index: Ref::new(Option::None),
                documentation_index: Ref::new(Option::None),
            }
        },
        Ok(None) => {
            single_file_analysis(source_path, source, parsed, lowered, syntax, overrides, context)
        },
        Err(error) => Analysis {
            source_path,
            source,
            package_name: "",
            module_path: "",
            overrides,
            sources: Vec::from_array([SourceFile { path: source_path, source, package_name: "" }]),
            environments: Vec::new(),
            parse: parsed,
            syntax,
            expanded_source: source,
            expanded_asts: Vec::new(),
            checked: failed_check(source_path, "project", error),
            context,
            comptime_modules: Vec::new(),
            lowered,
            symbol_index: Ref::new(Option::None),
            documentation_index: Ref::new(Option::None),
        },
    }
}

pub fn analyze_with_overrides(source_path: string, source: string, overrides: Vec[SourceOverride]) -> Analysis {
    analyze_with_context(analysis_context(), source_path, source, overrides)
}

pub fn analyze(source_path: string, source: string) -> Analysis {
    analyze_with_overrides(source_path, source, Vec::new())
}

pub fn diagnostics(value: Analysis) -> Vec[tast::Diagnostic] {
    value.checked.diagnostics
}

pub fn expanded_derive(value: Analysis) -> string {
    value.expanded_source
}
