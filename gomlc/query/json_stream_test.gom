package query;

use std::testing;

#[test]
fn navigates_json_stream_apis() -> () {
    for (source, name) in Vec::from_array(
        [
            (
                "use std::json; pub fn inspect(input: string, limits: json::DecodeLimits) -> () { let result: Result[bool, json::Error] = json::from_string_with_limits(input, limits); } fn main() -> () {}",
                "from_string_with_limits",
            ),
            (
                "use std::json; use std::io; pub fn inspect(decoder: json::Decoder[io::StringReader]) -> () { let result: Result[Option[bool], json::Error] = decoder.decode(); } fn main() -> () {}",
                "decode",
            ),
            (
                "use std::json; use std::io; pub fn inspect(encoder: json::Encoder[io::Discard]) -> () { let _ = encoder.encode(true); } fn main() -> () {}",
                "encode",
            ),
            (
                "use std::json; pub fn inspect(error: json::Error) -> () { let _ = error.confirmed_read(); } fn main() -> () {}",
                "confirmed_read",
            ),
        ],
    ) {
        let analysis = analyze("/tmp/json-stream.gom", source);
        assert_no_diagnostics(analysis);
        let definitions = goto_definitions(analysis, last_substring(source, name).unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        let target = testing::expect_some(
            source_by_path(analysis.sources, definitions[0].source_path),
            "JSON source",
        );
        testing::assert_eq(target.package_name, "std::json");
        testing::assert_eq(
            target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
            name,
        );
    }
    let prefix = "use std::json::";
    let items = completions(analyze("/tmp/json-stream-import.gom", prefix), prefix.byte_len());
    for name in[
        "Decoder",
        "Encoder",
        "DecodeLimits",
        "EncodeLimits",
        "ErrorKind",
        "LimitKind",
        "PathSegment",
        "Token",
        "from_reader",
        "to_writer",
        "parse_with_limits",
        "encode_with_limits",
    ] {
        testing::assert(has_completion(items, name));
    }
}
