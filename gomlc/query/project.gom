package query;

use std::ascii;
use std::fs;
use std::path;
use std::text;

const MANIFEST_FILENAME: string = "goml.toml";

pub struct SourceOverride {
    pub path: string,
    pub source: string,
}

pub struct SourceFile {
    pub path: string,
    pub source: string,
    pub package_name: string,
}

pub struct Project {
    pub module_root: string,
    pub module_path: string,
    pub package_dir: string,
    pub package_name: string,
    pub files: Vec[SourceFile],
}

struct ModuleInfo {
    root: string,
    path: string,
}

fn trim_ascii(value: string) -> string {
    let mut start = 0;
    let mut end = value.byte_len();
    while start < end && ascii::is_whitespace(value.byte_get(start)) {
        start += 1;
    }
    while end > start && ascii::is_whitespace(value.byte_get(end - 1)) {
        end -= 1;
    }
    value.byte_slice(start, end)
}

fn strip_comment(value: string) -> string {
    let mut quoted = false;
    let mut escaped = false;
    for index in 0..value.byte_len() {
        let byte = value.byte_get(index);
        if escaped {
            escaped = false;
        } else if quoted && byte == b'\\' {
            escaped = true;
        } else if byte == b'"' {
            quoted = !quoted;
        } else if !quoted && byte == b'#' {
            return value.byte_slice(0, index)
        }
    }
    value
}

fn manifest_module_path(source: string) -> Option[string] {
    let mut cursor = 0;
    let mut in_module = false;
    while cursor <= source.byte_len() {
        let mut end = cursor;
        while end < source.byte_len() && source.byte_get(end) != b'\n' {
            end += 1;
        }
        let line = trim_ascii(strip_comment(source.byte_slice(cursor, end)));
        if line.starts_with("[") {
            in_module = line == "[module]";
        } else if in_module {
            let mut equals = 0;
            while equals < line.byte_len() && line.byte_get(equals) != b'=' {
                equals += 1;
            }
            if equals < line.byte_len() && trim_ascii(line.byte_slice(0, equals)) == "path" {
                let value = trim_ascii(line.byte_slice(equals + 1, line.byte_len()));
                if value.byte_len() >= 2 && value.byte_get(0) == b'"'
                    && value.byte_get(value.byte_len() - 1) == b'"' {
                    return Option::Some(value.byte_slice(1, value.byte_len() - 1))
                }
            }
        }
        if end == source.byte_len() {
            cursor = source.byte_len() + 1;
        } else {
            cursor = end + 1;
        }
    }
    Option::None
}

fn source_directory(source_path: string) -> string {
    match path::parent(source_path) {
        Some(value) => path::clean(value),
        None => ".",
    }
}

fn find_module(source_path: string) -> Result[Option[ModuleInfo], string] {
    let mut current = source_directory(source_path);
    let result = loop {
        let manifest = path::join(current, MANIFEST_FILENAME);
        if fs::is_file(manifest) {
            let source = fs::read_file_structured(manifest).map_err(|error| error.to_string())?;
            if let Some(module_path) = manifest_module_path(source) {
                break Option::Some(ModuleInfo { root: current, path: module_path })
            }
        }
        match path::parent(current) {
            Some(parent) => {
                let parent = path::clean(parent);
                if parent == current {
                    break Option::None
                } else {
                    current = parent;
                }
            },
            None => break Option::None,
        }
    };
    Result::Ok(result)
}

fn package_name(module_root: string, module_path: string, package_dir: string) -> Result[
    string,
    string,
] {
    let root = path::clean(module_root);
    let directory = path::clean(package_dir);
    if root == directory {
        Result::Ok(module_path)
    } else {
        let prefix = if root.ends_with("/") {
            root
        } else {
            root + "/"
        };
        if !directory.starts_with(prefix) {
            Result::Err("package directory " + directory + " is outside module root " + root)
        } else {
            let relative = directory.byte_slice(prefix.byte_len(), directory.byte_len());
            let builder = text::StringBuilder::new();
            builder.write_string(module_path);
            builder.write_string("::");
            let mut index = 0;
            while index < relative.byte_len() {
                let byte = relative.byte_get(index);
                if byte == b'/' || byte == b'\\' {
                    builder.write_string("::")
                } else {
                    builder.write_string(relative.byte_slice(index, index + 1))
                }
                index += 1;
            }
            Result::Ok(builder.finish())
        }
    }
}

fn normalized_path(value: string) -> string {
    path::clean(value)
}

fn same_path(left: string, right: string) -> bool {
    normalized_path(left) == normalized_path(right)
}

fn override_source(overrides: Vec[SourceOverride], source_path: string) -> Option[string] {
    let mut index = overrides.len() - 1;
    while index >= 0 {
        let value = overrides[index];
        if same_path(value.path, source_path) {
            return Option::Some(value.source)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn contains_source_file(values: Vec[SourceFile], expected: string) -> bool {
    for value in values {
        if same_path(value.path, expected) {
            return true
        }
    }
    false
}

fn include_source_file(value: string, include_tests: bool) -> bool {
    match path::extension(value) {
        Some(extension) => extension == "gom" && (include_tests || !value.ends_with("_test.gom")),
        None => false,
    }
}

fn read_project_source(
    source_path: string,
    active_path: string,
    active_source: string,
    overrides: Vec[SourceOverride],
) -> Result[string, string] {
    if same_path(source_path, active_path) {
        Result::Ok(active_source)
    } else {
        match override_source(overrides, source_path) {
            Some(source) => Result::Ok(source),
            None => fs::read_file_structured(source_path).map_err(|error| error.to_string()),
        }
    }
}

fn collect_package_files(
    package_dir: string,
    source_path: string,
    source: string,
    overrides: Vec[SourceOverride],
) -> Result[Vec[SourceFile], string] {
    let files: Vec[SourceFile] = Vec::new();
    let include_tests = source_path.ends_with("_test.gom");
    for name in fs::read_dir(package_dir).map_err(|error| error.to_string())? {
        let file_path = path::join(package_dir, name);
        if fs::is_file(file_path) && include_source_file(file_path, include_tests) {
            let file_source = read_project_source(file_path, source_path, source, overrides)?;
            files.push(SourceFile { path: file_path, source: file_source, package_name: "" })
        }
    }
    for value in overrides {
        let value_parent = source_directory(value.path);
        if same_path(value_parent, package_dir) && include_source_file(value.path, include_tests)
            && !contains_source_file(files, value.path) {
            files.push(SourceFile { path: value.path, source: value.source, package_name: "" })
        }
    }
    if !contains_source_file(files, source_path) {
        files.push(SourceFile { path: source_path, source, package_name: "" })
    }
    Result::Ok(files)
}

fn local_package_directory(module_root: string, module_path: string, package_name: string) -> Option[
    string,
] {
    if package_name == module_path {
        Option::Some(module_root)
    } else {
        let prefix = module_path + "::";
        if !package_name.starts_with(prefix) {
            Option::None
        } else {
            let suffix = package_name.byte_slice(prefix.byte_len(), package_name.byte_len());
            let mut directory = module_root;
            let mut start = 0;
            let mut index = 0;
            while index <= suffix.byte_len() {
                let at_end = index == suffix.byte_len();
                let separator = !at_end && index + 1 < suffix.byte_len()
                    && suffix.byte_get(index) == b':'
                    && suffix.byte_get(index + 1) == b':';
                if at_end || separator {
                    let segment = suffix.byte_slice(start, index);
                    if segment == "" || segment == "." || segment == ".." {
                        return Option::None
                    } else {
                        directory = path::join(directory, segment);
                    }
                    if separator {
                        index += 1;
                        start = index + 1;
                    }
                }
                index += 1;
            }
            Option::Some(directory)
        }
    }
}

fn collect_dependency_files(package_dir: string, overrides: Vec[SourceOverride]) -> Result[
    Vec[SourceFile],
    string,
] {
    let files: Vec[SourceFile] = Vec::new();
    for name in fs::read_dir(package_dir).map_err(|error| error.to_string())? {
        let file_path = path::join(package_dir, name);
        if fs::is_file(file_path) && include_source_file(file_path, false) {
            let file_source = read_project_source(file_path, "", "", overrides)?;
            files.push(SourceFile { path: file_path, source: file_source, package_name: "" })
        }
    }
    for value in overrides {
        let value_parent = source_directory(value.path);
        if same_path(value_parent, package_dir) && include_source_file(value.path, false)
            && !contains_source_file(files, value.path) {
            files.push(SourceFile { path: value.path, source: value.source, package_name: "" })
        }
    }
    if files.is_empty() {
        Result::Err("package directory " + package_dir + " has no .gom files")
    } else {
        Result::Ok(files)
    }
}

fn source_files_with_package(files: Vec[SourceFile], package_name: string) -> Vec[SourceFile] {
    let result: Vec[SourceFile] = Vec::new();
    for file in files {
        result.push(SourceFile { path: file.path, source: file.source, package_name })
    }
    result
}

fn dependency_project(
    module_root: string,
    module_path: string,
    package_name: string,
    overrides: Vec[SourceOverride],
) -> Result[Project, string] {
    match local_package_directory(module_root, module_path, package_name) {
        Some(package_dir) => match collect_dependency_files(package_dir, overrides) {
            Ok(files) => {
                let files = source_files_with_package(files, package_name);
                Result::Ok(Project { module_root, module_path, package_dir, package_name, files })
            },
            Err(error) => Result::Err(error),
        },
        None => Result::Err("package " + package_name + " is outside the current module"),
    }
}

pub fn discover_project(source_path: string, source: string, overrides: Vec[SourceOverride]) -> Result[
    Option[Project],
    string,
] {
    match find_module(source_path) {
        Ok(Some(module)) => {
            let package_dir = source_directory(source_path);
            match package_name(module.root, module.path, package_dir) {
                Ok(name) => match collect_package_files(package_dir, source_path, source, overrides) {
                    Ok(files) => {
                        let files = source_files_with_package(files, name);
                        Result::Ok(
                            Option::Some(
                                Project {
                                    module_root: module.root,
                                    module_path: module.path,
                                    package_dir,
                                    package_name: name,
                                    files,
                                },
                            ),
                        )
                    },
                    Err(error) => Result::Err(error),
                },
                Err(error) => Result::Err(error),
            }
        },
        Ok(None) => Result::Ok(Option::None),
        Err(error) => Result::Err(error),
    }
}

pub fn module_root_for_source(source_path: string) -> Result[string, string] {
    let module = find_module(source_path)?.ok_or("expected an existing GoML module")?;
    Result::Ok(module.root)
}
