#[test]
fn returns_cross_package_expanded_derive_source() -> () {
    let root = "../gomlc/testdata/module/project050_comptime_derive";
    let main_path = root + "/main.gom";
    match fs::read_file_structured(main_path) {
        Ok(source) => {
            let analysis = analyze(main_path, source);
            assert_no_diagnostics(analysis);
            let expanded = expanded_derive(analysis);
            testing::assert(
                expanded.contains("impl[T] tests::comptime_derive::macros::Label for Box[T]"),
            );
            testing::assert(expanded.contains("fn label(self: Box[T]) -> string"));
            testing::assert(expanded.contains("impl std::serde::Serialize for Record"));
            testing::assert(expanded.contains("fn serialize[S"));
            testing::assert(expanded.contains("self: Record, serializer: S"))
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn navigates_hovers_and_completes_comptime_derives() -> () {
    let root = "../gomlc/testdata/module/project050_comptime_derive";
    let main_path = root + "/main.gom";
    match fs::read_file_structured(main_path) {
        Ok(source) => {
            let analysis = analyze(main_path, source);
            assert_no_diagnostics(analysis);
            match last_substring(source, "macros::Label") {
                Some(start) => {
                    let offset = start + "macros::".byte_len();
                    let definitions = goto_definitions(analysis, offset);
                    if definitions.len() != 1 {
                        testing::fail(
                            f"expected one qualified comptime derive definition, found {definitions.len()}",
                        )
                    }
                    testing::assert(definitions[0].source_path.ends_with("/macros/macros.gom"));
                    match fs::read_file_structured(definitions[0].source_path) {
                        Ok(definition_source) => testing::assert_eq(
                            definition_source.byte_slice(
                                definitions[0].span.start,
                                definitions[0].span.end,
                            ),
                            "derive_label",
                        ),
                        Err(error) => testing::fail(error.to_string()),
                    }
                    match hover(analysis, offset) {
                        Some(result) => testing::assert_eq(result.contents, "comptime derive Label"),
                        None => testing::fail("expected comptime derive hover"),
                    }
                    testing::assert(
                        has_completion(
                            completions(analysis, start + "macros::Lab".byte_len()),
                            "Label",
                        ),
                    )
                },
                None => testing::fail("expected qualified comptime derive"),
            }
            match last_substring(source, "FacadeLabel") {
                Some(offset) => {
                    let definitions = goto_definitions(analysis, offset);
                    if definitions.len() != 1 {
                        testing::fail(
                            f"expected one reexported comptime derive definition, found {definitions.len()}",
                        )
                    }
                    testing::assert(definitions[0].source_path.ends_with("/macros/macros.gom"))
                },
                None => testing::fail("expected reexported comptime derive"),
            }
            match last_substring(source, "Serialize") {
                Some(offset) => match hover(analysis, offset) {
                    Some(result) => {
                        testing::assert_eq(result.contents, "comptime derive Serialize")
                    },
                    None => testing::fail("expected standard library comptime derive hover"),
                },
                None => testing::fail("expected standard library comptime derive"),
            }
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

