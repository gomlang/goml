#[test]
fn returns_signature_help_for_active_arguments() -> () {
    let source = "fn combine(left: i32, right: string) -> bool { true } fn main() -> bool { combine(1, \"x\") }";
    let analysis = analyze("main.gom", source);
    match last_substring(source, "\"x\"") {
        Some(offset) => match signature_help(analysis, offset + 1) {
            Some(signature) => {
                testing::assert_eq(signature.label, "(left: i32, right: string) -> bool");
                testing::assert_eq(signature.parameters.len(), 2);
                testing::assert_eq(signature.active_parameter, 1)
            },
            None => testing::fail("expected signature help"),
        },
        None => testing::fail("expected second argument"),
    }
}

#[test]
fn keeps_signature_names_for_canonical_cross_package_targets() -> () {
    let root = "/tmp/goml-query-signature-owner-collision";
    let left_dir = root + "/left";
    let right_dir = root + "/right";
    for directory in Vec::from_array([root, left_dir, right_dir]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    let left_path = left_dir + "/item.gom";
    let right_path = right_dir + "/item.gom";
    let main_path = root + "/main.gom";
    let left_source = "package shared; pub struct Item {} pub trait Choose { fn choose(self: Self, trait_value: string) -> string; } impl Choose for Item { fn choose(self: Item, implementation_value: string) -> string { implementation_value } } impl Item { pub fn choose(self: Item, left_method_value: isize) -> isize { left_method_value } } pub fn call(left_function_value: isize) -> isize { left_function_value } #[go_ffi(\"strings\", \"ToUpper\")] pub extern fn external_call(extern_value: string) -> string;";
    let right_source = "package shared; pub struct Item {} impl Item { pub fn choose(self: Item, right_method_value: isize) -> isize { right_method_value } } pub fn call(right_function_value: isize) -> isize { right_function_value }";
    let main_source = "package main; use module::left as left; use module::right as right; fn main() -> () { let left_value = left::Item {}; let right_value = right::Item {}; println(left_value.choose(1)); println(right_value.choose(2)); println(left::call(3)); println(right::call(4)); println(left::external_call(\"value\")); println(left::Choose::choose(left_value, \"trait\")) }";
    write_query_fixture(
        root + "/goml.toml",
        \\[module]
        \\path = "query::signature_owner_collision"
        \\
        ,
    );
    write_query_fixture(left_path, left_source);
    write_query_fixture(right_path, right_source);
    write_query_fixture(main_path, main_source);
    let analysis = analyze(main_path, main_source);
    assert_no_diagnostics(analysis);
    for expected in Vec::from_array(
        [
            ("left_value.choose(", "(left_method_value: isize) -> isize"),
            ("right_value.choose(", "(right_method_value: isize) -> isize"),
            ("left::call(", "(left_function_value: isize) -> isize"),
            ("right::call(", "(right_function_value: isize) -> isize"),
            ("left::external_call(", "(extern_value: string) -> string"),
        ],
    ) {
        match last_substring(main_source, expected.0) {
            Some(offset) => match signature_help(analysis, offset + expected.0.byte_len()) {
                Some(signature) => testing::assert_eq(signature.label, expected.1),
                None => testing::fail("expected signature help for " + expected.0),
            },
            None => testing::fail("expected call " + expected.0),
        }
    }
    match last_substring(main_source, "left::Choose::choose(") {
        Some(offset) => match signature_help(analysis, offset + "left::Choose::choose(".byte_len()) {
            Some(signature) => {
                testing::assert(signature.label.contains("trait_value: string"));
                testing::assert(!signature.label.contains("implementation_value"));
                testing::assert(!signature.label.contains("left_method_value"))
            },
            None => testing::fail("expected trait UFCS signature help"),
        },
        None => testing::fail("expected trait UFCS call"),
    }
}

