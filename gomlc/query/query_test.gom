    testing::assert(has_completion(children, "path"));
    let item_source =
        \\package main;
        \\use std::io::pri
    ;
    testing::assert(
        has_completion(
            completions(analyze("/tmp/import-main.gom", item_source), item_source.byte_len()),
            "println",
        ),
    )
}

#[test]
fn completes_builtin_and_dyn_trait_members() -> () {
    let static_source = "fn main() -> () { let _ = Vec::with_; () }";
    match last_substring(static_source, "with_") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", static_source), offset + "with_".byte_len()),
            "with_capacity",
        ) {} else {
            testing::fail("expected Vec with_capacity completion")
        },
        None => testing::fail("expected Vec static member"),
    }
    let from_array_source = "fn main() -> () { let _ = Vec::from_; () }";
    match last_substring(from_array_source, "from_") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", from_array_source), offset + "from_".byte_len()),
            "from_array",
        ) {} else {
            testing::fail("expected Vec from_array completion")
        },
        None => testing::fail("expected Vec from_array static member"),
    }
    let map_from_array_source = "fn main() -> () { let _ = HashMap::from_; () }";
    match last_substring(map_from_array_source, "from_") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", map_from_array_source), offset + "from_".byte_len()),
            "from_array",
        ) {} else {
            testing::fail("expected HashMap from_array completion")
        },
        None => testing::fail("expected HashMap from_array static member"),
    }
    let int_source = "fn main() -> string { let value = 1; value.to_ }";
    match last_substring(int_source, "to_") {
        Some(offset) => {
            let values = completions(analyze("main.gom", int_source), offset + 3);
            if has_completion(values, "to_string") {} else {
                testing::fail("expected isize to_string completion")
            }
            if has_completion(values, "to_u8") {} else {
                testing::fail("expected isize to_u8 completion")
            }
            if has_completion(values, "to_isize") {
                testing::fail("unexpected isize identity conversion completion")
            }
        },
        None => testing::fail("expected isize member"),
    }
    let string_source = "fn main(value: string) -> () { value.con }";
    match last_substring(string_source, "value.con") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", string_source), offset + "value.con".byte_len()),
            "contains",
        ) {} else {
            testing::fail("expected string contains completion")
        },
        None => testing::fail("expected string member"),
    }
    let vec_source = "fn main() -> () { let values: Vec[i32] = Vec::new(); values.p }";
    match last_substring(vec_source, "values.p") {
        Some(offset) => if has_completion(
            completions(analyze("main.gom", vec_source), offset + "values.p".byte_len()),
            "push",
        ) {} else {
            testing::fail("expected Vec push completion")
        },
        None => testing::fail("expected Vec member"),
    }
    let dyn_source = "trait Showable { fn show(self: Self) -> string; } fn render(value: dyn Showable) -> string { value.sh }";
    match last_substring(dyn_source, "value.sh") {
        Some(offset) => {
            let analysis = analyze("main.gom", dyn_source);
            match explicit_receiver_type(analysis, offset + "value".byte_len()) {
                Some(name) => testing::assert_eq(name, "Showable"),
                None => testing::fail("expected explicit dyn type"),
            }
            let method_found = Ref::new(false);
            for symbol in build_symbol_index(analysis).symbols {
                if symbol.name == "show" {
                    method_found.set(true)
                }
            }
            testing::assert(method_found.get());
            let items = completions(analysis, offset + "value.sh".byte_len());
            if has_completion(items, "show") {} else {
                testing::fail("expected dyn show completion, got " + completion_labels(items))
            }
        },
        None => testing::fail("expected dyn member"),
    }
}

#[test]
fn completes_only_the_public_prelude_surface() -> () {
    let print_source = "fn main() -> () { pri }";
    match last_substring(print_source, "pri") {
        Some(offset) => {
            let items = completions(analyze("main.gom", print_source), offset + 3);
            testing::assert(has_completion(items, "print"));
            testing::assert(has_completion(items, "println"))
        },
        None => testing::fail("expected prelude completion prefix"),
    }
    let string_source = "fn main() -> () { string_ }";
    match last_substring(string_source, "string_") {
        Some(offset) => {
            let items = completions(analyze("main.gom", string_source), offset + 7);
            testing::assert(has_completion(items, "string_get"));
            testing::assert(!has_completion(items, "string_get_raw"))
        },
        None => testing::fail("expected builtin completion prefix"),
    }
    let derive_source = "fn main() -> () { derive_ }";
    match last_substring(derive_source, "derive_") {
        Some(offset) => {
            let items = completions(analyze("main.gom", derive_source), offset + 7);
            testing::assert(!has_completion(items, "derive_output_new"))
        },
        None => testing::fail("expected derive completion prefix"),
    }
}

#[test]
fn completes_imported_package_namespaces() -> () {
    let root = "../gomlc/testdata/module/project001";
    let main_path = root + "/main.gom";
    match fs::read_file_structured(main_path) {
        Ok(source) => match last_substring(source, "sum_point") {
            Some(offset) => {
                let analysis = analyze(main_path, source);
                testing::assert(has_completion(completions(analysis, offset + 2), "sum_point"))
            },
            None => testing::fail("expected sum_point"),
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn filters_completion_scope_and_suggests_keywords() -> () {
    let source =
        \\fn first() -> i32 { let hidden = 1; hidden }
        \\fn second() -> i32 { let visible = 2; vis }
    ;
    match last_substring(source, "vis") {
        Some(offset) => {
            let items = completions(analyze("main.gom", source), offset + 3);
            testing::assert(has_completion(items, "visible"));
            testing::assert(!has_completion(items, "hidden"))
        },
        None => testing::fail("expected completion prefix"),
    }
    let keyword_source = "fn main() -> () { ma }";
    match last_substring(keyword_source, "ma") {
        Some(offset) => testing::assert(
            has_completion(completions(analyze("main.gom", keyword_source), offset + 2), "match"),
        ),
        None => testing::fail("expected keyword prefix"),
    }
    let loop_source = "fn main() -> () { lo }";
    match last_substring(loop_source, "lo") {
        Some(offset) => testing::assert(
            has_completion(completions(analyze("main.gom", loop_source), offset + 2), "loop"),
        ),
        None => testing::fail("expected loop keyword prefix"),
    }
    let call_source = "fn use_value(value: i32) -> () { () } fn main() -> () { use_value( }";
    match last_substring(call_source, "use_value(") {
        Some(offset) => testing::assert_eq(
            completions(analyze("main.gom", call_source), offset + "use_value(".byte_len()).len(),
            0,
        ),
        None => testing::fail("expected call"),
    }
}

#[test]
fn completes_select_syntax_contextually() -> () {
    let expression = "fn main() -> () { sel }";
    let expression_offset = last_substring(expression, "sel").unwrap_or(0) + 3;
    testing::assert(
        has_completion(completions(analyze("main.gom", expression), expression_offset), "select"),
    );
    let priority = "fn main() -> () { select pri }";
    let priority_offset = last_substring(priority, "pri").unwrap_or(0) + 3;
    testing::assert(
        has_completion(completions(analyze("main.gom", priority), priority_offset), "priority"),
    );
    let receive = "fn main() -> () { select { re } }";
    let receive_offset = last_substring(receive, "re").unwrap_or(0) + 2;
    testing::assert(
        has_completion(completions(analyze("main.gom", receive), receive_offset), "recv"),
    );
    let guard = "fn main() -> () { let channel: Channel[isize] = Channel::new(0); select { recv(channel) wh } }";
    let guard_offset = last_substring(guard, "wh").unwrap_or(0) + 2;
    testing::assert(has_completion(completions(analyze("main.gom", guard), guard_offset), "when"));
    let binding = "fn main() -> () { let channel: Channel[isize] = Channel::new(0); select { recv(channel) a } }";
    let binding_offset = last_substring(binding, " a").unwrap_or(0) + 2;
    testing::assert(has_completion(completions(analyze("main.gom", binding), binding_offset), "as"));
    let matching = "fn main() -> () { let channel: Channel[isize] = Channel::new(0); select { recv(channel) m } }";
    let matching_offset = last_substring(matching, " m").unwrap_or(0) + 2;
    testing::assert(
        has_completion(completions(analyze("main.gom", matching), matching_offset), "match"),
    )
}

#[test]
fn indexes_syntax_with_absolute_ranges_and_parents() -> () {
    let analysis = analyze("main.gom", "fn main() -> i32 { let value = 42; value }");
    testing::assert(analysis.syntax.nodes.len() > 1);
    testing::assert(analysis.syntax.tokens.len() > 1);
    match token_at(analysis.syntax, 3) {
        Some(token) => {
            testing::assert(lexer::token_kind_equal(token.kind, lexer::TokenKind::Ident));
            testing::assert_eq(token.text, "main")
        },
        None => testing::fail("expected token"),
    }
    match node_at(analysis.syntax, 3) {
        Some(node) => {
            testing::assert(!cst::node_kind_equal(node.kind, cst::NodeKind::FILE));
            if let None = parent_node(analysis.syntax, node) {
                testing::fail("expected parent node")
            }
        },
        None => testing::fail("expected node"),
    }
}

#[test]
fn indexes_attributed_declarations_by_declared_names() -> () {
    let source = "#[test] fn works() -> () { () } #[derive(Eq)] struct Key { value: isize }";
    let index = build_symbol_index(analyze("main.gom", source));
    let works = Ref::new(false);
    let key = Ref::new(false);
    for symbol in index.symbols {
        if symbol.name == "works" {
            works.set(true)
        } else if symbol.name == "Key" {
            key.set(true)
        } else {
            testing::assert(symbol.name != "test" && symbol.name != "derive")
        }
    }
    testing::assert(works.get());
    testing::assert(key.get())
}

#[test]
fn navigates_bindings_across_pattern_and_closure_syntax() -> () {
    let source = "struct Pair { left: isize, right: isize } enum Maybe { Some(Pair), None } fn main() -> isize { let Pair { left: left_value, right: right_value } = Pair { left: 1, right: 2 }; let if_result = if let Some(Pair { left: if_value, right: _ }) = Some(Pair { left: 3, right: 4 }) { if_value } else { 0 }; let match_result = match Some(Pair { left: 5, right: 6 }) { Some(Pair { left: match_value, right: _ }) => match_value, None => 0 }; let total = Ref::new(0); for (for_left, for_right) in Vec::from_array([(7, 8)]) { total.set(total.get() + for_left + for_right) }; let closure = |closure_value: isize| closure_value + left_value; closure(right_value) + if_result + match_result + total.get() }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(
        [
            "left_value",
            "right_value",
            "if_value",
            "match_value",
            "for_left",
            "for_right",
            "closure_value",
        ],
    ) {
        assert_local_navigation(analysis, source, name)
    }
}

#[test]
fn returns_hover_from_typecheck_facts() -> () {
    let source = "fn main() -> i32 { let value = 42; value }";
    let analysis = analyze("main.gom", source);
    testing::assert_eq(analysis.checked.diagnostics.len(), 0);
    match hover(analysis, source.byte_len() - 3) {
        Some(result) => {
            testing::assert_eq(result.contents, "i32");
            testing::assert_eq(source.byte_slice(result.span.start, result.span.end), "value")
        },
        None => testing::fail("expected hover"),
    }
}

#[test]
fn returns_function_hover_on_declarations_and_calls() -> () {
    let source =
        \\fn add(x: i32, y: i32) -> i32 { x + y }
        \\fn main() -> i32 { add(1, 2) }
    ;
    match hover(analyze("main.gom", source), 3) {
        Some(result) => {
            testing::assert_eq(result.contents, "(i32, i32) -> i32")
        },
        None => testing::fail("expected declaration hover"),
    }
    match last_substring(source, "add") {
        Some(offset) => match hover(analyze("main.gom", source), offset) {
            Some(result) => testing::assert_eq(result.contents, "(i32, i32) -> i32"),
            None => testing::fail("expected call hover"),
        },
        None => testing::fail("expected function call"),
    }
}

#[test]
fn shows_comptime_capability_in_function_hover() -> () {
    let source = "#[comptime] fn value() -> isize { 42 } fn main() -> isize { value() }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "value") {
        Some(offset) => match hover(analysis, offset) {
            Some(result) => testing::assert_eq(result.contents, "comptime () -> isize"),
            None => testing::fail("expected comptime function hover"),
        },
        None => testing::fail("expected comptime function call"),
    }
}

#[test]
fn reports_comptime_evaluation_failures_during_analysis() -> () {
    let source = "#[comptime] fn fail() -> isize { compile_error(\"query failure\") } fn main() -> isize { comptime { fail() } }";
    let analysis = analyze("main.gom", source);
    let found = Ref::new(false);
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic.message.contains("query failure") {
            testing::assert_eq(diagnostic.stage, "comptime");
            found.set(true)
        }
    }
    testing::assert(found.get())
}

#[test]
fn navigates_calls_inside_comptime_blocks() -> () {
    let source = "#[comptime] fn answer() -> isize { 42 } fn main() -> isize { comptime { answer() } }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "answer") {
        Some(offset) => {
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            testing::assert_eq(
                source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "answer",
            );
            match hover(analysis, offset) {
                Some(result) => testing::assert_eq(result.contents, "comptime () -> isize"),
                None => testing::fail("expected comptime call hover"),
            }
        },
        None => testing::fail("expected comptime call"),
    }
}

#[test]
fn shows_generic_method_parameters_in_hover_and_concrete_signature_help() -> () {
    let source = "struct Box[T] { value: T } impl[T] Box[T] { fn map[U](self: Box[T], convert: (T) -> U) -> Box[U] { Box { value: convert(self.value) } } } struct Other {} impl Other { fn map[V](self: Other, value: V) -> V { let _ = self; value } } fn main() -> Box[string] { let value = Box { value: 1 }; value.map(|item: isize| item.to_string()) }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "map[U]") {
        Some(offset) => match hover(analysis, offset) {
            Some(result) => testing::assert_eq(
                result.contents,
                "[U] (gomlc::Box[T], (T) -> U) -> gomlc::Box[U]",
            ),
            None => testing::fail("expected generic method hover"),
        },
        None => testing::fail("expected method declaration"),
    }
    match last_substring(source, "map(") {
        Some(offset) => match signature_help(analysis, offset + "map(".byte_len()) {
            Some(signature) => testing::assert_eq(
                signature.label,
                "(convert: (isize) -> string) -> gomlc::Box[string]",
            ),
            None => testing::fail("expected generic method signature"),
        },
        None => testing::fail("expected method call"),
    }
}

#[test]
fn keeps_hover_types_for_canonical_declarations() -> () {
    let root = "/tmp/goml-query-hover-owner-collision";
    let left_dir = root + "/left";
    let right_dir = root + "/right";
    for directory in Vec::from_array([root, left_dir, right_dir]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    let left_path = left_dir + "/left.gom";
    let right_path = right_dir + "/right.gom";
    let left_source = "package left; use module::right; type Label = isize; const answer: Label = 1; trait Choose { fn choose(self: Self, trait_value: string) -> string; } struct Item {} impl Choose for Item { fn choose(self: Item, implementation_value: string) -> string { implementation_value } } impl Item { fn choose(self: Item, inherent_value: isize) -> isize { inherent_value } } struct TraitOnly {} impl Choose for TraitOnly { fn choose(self: TraitOnly, trait_only_value: string) -> string { trait_only_value } } pub fn select(value: isize) -> isize { value } pub fn use_right(value: string) -> string { right::select(value) } #[allow(unused_function)] fn use_item(value: Item) -> isize { value.choose(1) } #[allow(unused_function)] fn use_trait(value: TraitOnly) -> string { value.choose(\"trait\") }";
    let right_source = "package right; pub type Label = string; pub const answer: Label = \"right\"; pub fn select(value: string) -> string { value }";
    write_query_fixture(
        root + "/goml.toml",
        \\[module]
        \\path = "query::hover_owner_collision"
        \\
        ,
    );
    write_query_fixture(left_path, left_source);
    write_query_fixture(right_path, right_source);
    let analysis = analyze(left_path, left_source);
    assert_no_diagnostics(analysis);
    for expected in Vec::from_array(
        [
            ("type Label", "type ".byte_len(), "isize"),
            ("const answer", "const ".byte_len(), "isize"),
            ("fn select(value: isize)", "fn ".byte_len(), "(isize) -> isize"),
        ],
    ) {
        match last_substring(left_source, expected.0) {
            Some(offset) => match hover(analysis, offset + expected.1) {
                Some(result) => testing::assert_eq(result.contents, expected.2),
                None => testing::fail("expected declaration hover for " + expected.0),
            },
            None => testing::fail("expected declaration " + expected.0),
        }
    }
    for expected in Vec::from_array(
        [
            ("fn choose(self: Self", "string", "isize"),
            ("fn choose(self: Item, implementation", "string", "isize"),
            ("fn choose(self: Item, inherent", "isize", "string"),
        ],
    ) {
        match last_substring(left_source, expected.0) {
            Some(offset) => match hover(analysis, offset + "fn ".byte_len()) {
                Some(result) => {
                    testing::assert(result.contents.contains(expected.1));
                    testing::assert(!result.contents.contains(expected.2))
                },
                None => testing::fail("expected method hover for " + expected.0),
            },
            None => testing::fail("expected method " + expected.0),
        }
    }
    for expected in Vec::from_array(
        [
            ("value.choose(1)", "fn choose(self: Item, inherent"),
            ("value.choose(\"trait\")", "fn choose(self: Self"),
        ],
    ) {
        match (last_substring(left_source, expected.0), last_substring(left_source, expected.1)) {
            (Some(call), Some(declaration)) => {
                let definitions = goto_definitions(analysis, call + "value.".byte_len());
                testing::assert_eq(definitions.len(), 1);
                testing::assert_eq(definitions[0].span.start, declaration + "fn ".byte_len())
            },
            _ => testing::fail("expected method definition fixture"),
        }
    }
}

#[test]
fn indexes_completes_and_hovers_type_aliases_and_constants() -> () {
    let source = "type Count = i32; const answer: Count = 42; fn main() -> i32 { answer }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    let alias_found = Ref::new(false);
    let constant_found = Ref::new(false);
    for symbol in build_symbol_index(analysis).symbols {
        match symbol.kind {
            TypeAlias => if symbol.name == "Count" {
                alias_found.set(true)
            },
            Constant => if symbol.name == "answer" {
                constant_found.set(true)
            },
            _ => (),
        }
    }
    testing::assert(alias_found.get());
    testing::assert(constant_found.get());
    match last_substring(source, "ans") {
        Some(offset) => testing::assert(has_completion(completions(analysis, offset + 3), "answer")),
        None => testing::fail("expected constant prefix"),
    }
    match last_substring(source, "answer") {
        Some(offset) => match hover(analysis, offset) {
            Some(value) => testing::assert_eq(value.contents, "i32"),
            None => testing::fail("expected constant hover"),
        },
        None => testing::fail("expected constant declaration"),
    }
    match hover(analysis, "type ".byte_len()) {
        Some(value) => testing::assert_eq(value.contents, "i32"),
        None => testing::fail("expected type alias hover"),
    }
}

#[test]
fn discovers_internal_and_external_test_items() -> () {
    let source =
        \\package value;
        \\#[test]
        \\fn works() -> () { () }
        \\
    ;
    let internal = test_items("/tmp/value_test.gom", source);
    testing::assert_eq(internal.len(), 1);
    testing::assert_eq(internal.get(0).name, "works");
    match internal.get(0).kind {
        Internal => (),
        External => testing::fail("expected internal test"),
    }
    let external = test_items("/tmp/project/tests/api_test.gom", source);
    testing::assert_eq(external.len(), 1);
    match external.get(0).kind {
        External => (),
        Internal => testing::fail("expected external test"),
    }
    testing::assert_eq(test_items("/tmp/value.gom", source).len(), 0)
}

fn external_package_sources_at(
    registry: string,
    module_root: string,
    package_name: string,
    overrides: Vec[SourceOverride],
) -> Result[Vec[SourceFile], string] {
    let modules = resolve_external_modules_at(module_root, registry)?;
    for module in modules {
        if let Some(directory) = external_package_directory(module, package_name) {
            match collect_dependency_files(directory, overrides) {
                Ok(files) => return Result::Ok(source_files_with_package(files, package_name)),
                Err(error) => return Result::Err(error),
            }
        }
    }
    Result::Err("package " + package_name + " is not provided by a resolved dependency")
}

#[test]
fn resolves_external_registry_packages_with_mvs() -> () {
    let root = "/tmp/goml-bootstrap-query-registry";
    let registry = root + "/registry";
    let project = root + "/project";
    let http = registry + "/alice/http/1.0.0";
    let shared_one = registry + "/alice/shared/1.0.0";
    let shared_two = registry + "/alice/shared/2.0.0";
    for directory in Vec::from_array([project, http, shared_one, shared_two]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    write_query_fixture(
        registry + "/index.toml",
        \\[modules."alice::http"]
        \\latest = "1.0.0"
        \\versions = ["1.0.0"]
        \\
        \\[modules."alice::shared"]
        \\latest = "2.0.0"
        \\versions = ["1.0.0", "2.0.0"]
        \\
        ,
    );
    write_query_fixture(
        project + "/goml.toml",
        \\[module]
        \\path = "test::app"
        \\
        \\[dependencies]
        \\"alice::http" = "1.0.0"
        \\"alice::shared" = "1.0.0"
        \\
        ,
    );
    write_query_fixture(
        http + "/goml.toml",
        \\[module]
        \\path = "alice::http"
        \\
        \\[dependencies]
        \\"alice::shared" = "2.0.0"
        \\
        ,
    );
    write_query_fixture(http + "/http.gom", "package http; pub fn status() -> i32 { 200 }");
    write_query_fixture(
        shared_one + "/goml.toml",
        \\[module]
        \\path = "alice::shared"
        \\
        ,
    );
    write_query_fixture(
        shared_two + "/goml.toml",
        \\[module]
        \\path = "alice::shared"
        \\
        ,
    );
    write_query_fixture(shared_one + "/shared.gom", "package shared; pub fn version() -> i32 { 1 }");
    write_query_fixture(shared_two + "/shared.gom", "package shared; pub fn version() -> i32 { 2 }");
    match external_package_sources_at(registry, project, "alice::http", Vec::new()) {
        Ok(files) => {
            testing::assert_eq(files.len(), 1);
            testing::assert_eq(files.get(0).package_name, "alice::http")
        },
        Err(error) => testing::fail(error.to_string()),
    }
    match resolve_external_modules_at(project, registry) {
        Ok(modules) => {
            let selected = Ref::new("");
            for module in modules {
                if module.name == "alice::shared" {
                    selected.set(module.version)
                }
            }
            testing::assert_eq(selected.get(), "2.0.0")
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn resolves_public_ffi_pointer_operations() -> () {
    let source = "use std::ffi; fn main() -> () { let value: ffi::Ptr[i64] = ffi::null(); let _ = ffi::is_nil(value); }";
    let analysis = analyze("/tmp/qualified-ffi.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(["null", "is_nil"]) {
        match last_substring(source, name) {
            Some(offset) => {
                let definitions = goto_definitions(analysis, offset);
                testing::assert_eq(definitions.len(), 1);
                match source_by_path(analysis.sources, definitions.get(0).source_path) {
                    Some(target) => {
                        testing::assert_eq(target.package_name, "std::ffi");
                        testing::assert_eq(
                            target.source.byte_slice(
                                definitions.get(0).span.start,
                                definitions.get(0).span.end,
                            ),
                            name,
                        )
                    },
                    None => testing::fail("expected ffi source"),
                }
            },
            None => testing::fail("expected ffi operation"),
        }
    }
}

