            completions(analyze("/tmp/import-main.gom", root_source), root_source.byte_len()),
            "std",
        ),
    );
    let child_source =
        \\package main;
        \\use std::
    ;
    let children = completions(
        analyze("/tmp/import-main.gom", child_source),
        child_source.byte_len(),
    );
