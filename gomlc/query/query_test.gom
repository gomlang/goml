#[test]
fn analyzes_and_navigates_module_root_imports() -> () {
    let root = "../gomlc/testdata/module/project067_module_root";
    let main_path = root + "/main.gom";
    let source = match fs::read_file_structured(main_path) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    };
    let analysis = analyze(main_path, source);
    testing::assert_eq(analysis.module_path, "test::module_root");
    assert_no_diagnostics(analysis);
    let use_path = "module::service";
    match last_substring(source, use_path) {
        Some(offset) => match goto_definition(analysis, offset + use_path.byte_len() - 1) {
            Some(definition) => testing::assert(
                definition.source_path.ends_with("/service/service.gom"),
            ),
            None => testing::fail("expected module-relative package definition"),
        },
        None => testing::fail("expected module-relative use path"),
    }
    for completion_source in Vec::from_array(
        [
            \\package main;
            \\use module::
            ,
            "package main;\nuse\tmodule::",
            \\package main;
            \\use  module::
            ,
            \\package main;
            \\use
            \\module::
            ,
            \\package main;
            \\use // package path
            \\module::
            ,
            \\package main;
            \\use module ::
            ,
            \\package main;
            \\pub use module::
            ,
        ],
    ) {
        let completion_analysis = analyze(main_path, completion_source);
        let items = completions(completion_analysis, completion_source.byte_len());
        testing::assert(has_completion(items, "data"));
        testing::assert(has_completion(items, "service"))
    }
    let scope_source =
        \\package main;
        \\use module::service; fn main() -> () { pri }
    ;
    match last_substring(scope_source, "pri") {
        Some(offset) => testing::assert(
            has_completion(completions(analyze(main_path, scope_source), offset + 3), "println"),
        ),
        None => testing::fail("expected scope completion prefix"),
    }
    let package_scope_source =
        \\package main;
        \\use module::service; fn main() -> () { ser }
    ;
    match last_substring(package_scope_source, "ser") {
        Some(offset) => testing::assert(
            has_completion(
                completions(analyze(main_path, package_scope_source), offset + 3),
                "service",
            ),
        ),
        None => testing::fail("expected package scope completion prefix"),
    }
}

