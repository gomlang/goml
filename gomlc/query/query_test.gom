            }
        },
        None => testing::fail("expected Vec from_array call"),
    }
}

#[test]
fn returns_inlay_hints_for_unannotated_let_bindings() -> () {
    let source = "fn main() -> isize { let value = 42; let named: isize = value; named }";
    let analysis = analyze("main.gom", source);
    let hints = inlay_hints(analysis);
    testing::assert_eq(hints.len(), 1);
    testing::assert_eq(hints.get(0).label, ": isize");
    testing::assert_eq(source.byte_slice(hints.get(0).span.start, hints.get(0).span.end), "value")
}

#[test]
fn filters_inlay_hints_to_source_ranges() -> () {
    let source =
        \\fn main() -> () {
        \\    let first = 1;
        \\    let second = 2;
        \\    ()
        \\}
    ;
    match last_substring(source, "second") {
        Some(start) => {
            let hints = inlay_hints_in_range(analyze("main.gom", source), start, source.byte_len());
            testing::assert_eq(hints.len(), 1);
            testing::assert_eq(
                source.byte_slice(hints.get(0).span.start, hints.get(0).span.end),
                "second",
            )
        },
        None => testing::fail("expected second binding"),
    }
}

#[test]
fn returns_inlay_hints_for_closure_parameters() -> () {
    let source = "fn main() -> () { let f = |value| value + 1; () }";
    let hints = inlay_hints(analyze("main.gom", source));
    let found = Ref::new(false);
    for hint in hints {
        if source.byte_slice(hint.span.start, hint.span.end) == "value" && hint.label == ": isize" {
            found.set(true)
        }
    }
    testing::assert(found.get())
}

#[test]
fn completes_scope_and_struct_members() -> () {
    let scope_source = "fn main() -> i32 { let value = 42; value }";
    let scope_analysis = analyze("main.gom", scope_source);
    testing::assert(
        has_completion(completions(scope_analysis, scope_source.byte_len() - 3), "value"),
    );
    let member_source = "struct Point { x: i32, y: i32 } fn main() -> i32 { let point = Point { x: 1, y: 2 }; point.x }";
    let member_analysis = analyze("main.gom", member_source);
    match last_substring(member_source, "point.x") {
        Some(offset) => testing::assert(
            has_completion(completions(member_analysis, offset + "point.x".byte_len()), "x"),
        ),
        None => testing::fail("expected member expression"),
    }
}

#[test]
fn keeps_member_completion_on_the_semantic_receiver() -> () {
    let source = "struct A {} impl A { fn only_a(self: A) -> () { () } } struct B {} impl B { fn only_b(self: B) -> () { () } } #[allow(unused_function)] fn first(value: A) -> () { value.only_a() } #[allow(unused_function)] fn second(value: B) -> () { () }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "value.only_a") {
        Some(offset) => {
            let items = completions(analysis, offset + "value.".byte_len());
            testing::assert(has_completion(items, "only_a"));
            testing::assert(!has_completion(items, "only_b"))
        },
        None => testing::fail("expected member access"),
    }
}

#[test]
fn separates_members_for_same_named_types_across_packages() -> () {
    let root = "/tmp/goml-query-owner-collision";
    let left_dir = root + "/left";
    let right_dir = root + "/right";
    for directory in Vec::from_array([root, left_dir, right_dir]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    let left_path = left_dir + "/item.gom";
    let right_path = right_dir + "/item.gom";
    let main_path = root + "/main.gom";
    let left_source = "package shared; use module::right as right; pub struct Item { pub left_only: isize, } impl Item { pub fn left_method(self: Item) -> isize { self.left_only } pub fn common(self: Item, value: isize) -> isize { value } } pub fn accept_right(value: right::Item) -> () { () }";
    let right_source = "package shared; pub struct Item { pub right_only: isize, } impl Item { pub fn right_method(self: Item) -> isize { self.right_only } pub fn common(self: Item, value: string) -> string { value } }";
    let main_source = "package main; use module::left as left; use module::right as right; fn main() -> () { let left_value = left::Item { left_only: 1 }; let right_value = right::Item { right_only: 2 }; println(left_value.left_only); println(right_value.right_only) }";
    write_query_fixture(
        root + "/goml.toml",
        \\[module]
        \\path = "query::owner_collision"
        \\
        ,
    );
    write_query_fixture(left_path, left_source);
    write_query_fixture(right_path, right_source);
    write_query_fixture(main_path, main_source);
    let analysis = analyze(main_path, main_source);
    assert_no_diagnostics(analysis);
    match last_substring(main_source, "left_value.left_only") {
        Some(offset) => {
            let items = completions(analysis, offset + "left_value.".byte_len());
            testing::assert(has_completion(items, "left_only"));
            testing::assert(has_completion(items, "left_method"));
            testing::assert(!has_completion(items, "right_only"));
            testing::assert(!has_completion(items, "right_method"))
        },
        None => testing::fail("expected left member access"),
    }
    match last_substring(main_source, "right_value.right_only") {
        Some(offset) => {
            let items = completions(analysis, offset + "right_value.".byte_len());
            testing::assert(has_completion(items, "right_only"));
            testing::assert(has_completion(items, "right_method"));
            testing::assert(!has_completion(items, "left_only"));
            testing::assert(!has_completion(items, "left_method"))
        },
        None => testing::fail("expected right member access"),
    }
    let invalid_source = "package main; use module::left as left; use module::right as right; fn main() -> () { let left_value = left::Item { left_only: 1 }; println(left_value.right_only); println(left_value.right_method()) }";
    match last_substring(invalid_source, "left_value.right_only") {
        Some(offset) => testing::assert_eq(
            goto_definitions(
                analyze(main_path, invalid_source),
                offset + "left_value.".byte_len() + 1,
            ).len(),
            0,
        ),
        None => testing::fail("expected invalid member access"),
    }
    match last_substring(invalid_source, "left_value.right_method") {
        Some(offset) => testing::assert_eq(
            goto_definitions(
                analyze(main_path, invalid_source),
                offset + "left_value.".byte_len() + 1,
            ).len(),
            0,
        ),
        None => testing::fail("expected invalid method access"),
    }
    let left_analysis = analyze(left_path, left_source);
    assert_no_diagnostics(left_analysis);
    match last_substring(left_source, "fn common") {
        Some(offset) => match hover(left_analysis, offset + "fn ".byte_len()) {
            Some(result) => testing::assert_eq(
                result.contents,
                "(query::owner_collision::left::Item, isize) -> isize",
            ),
            None => testing::fail("expected left method hover"),
        },
        None => testing::fail("expected left method definition"),
    }
}

#[test]
fn filters_member_completion_visibility_and_receivers() -> () {
    let root = "/tmp/goml-query-member-visibility";
    let lib_dir = root + "/lib";
    for directory in Vec::from_array([root, lib_dir]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    let lib_path = lib_dir + "/lib.gom";
    let main_path = root + "/main.gom";
    let lib_source = "package lib; pub struct Item { pub shown: isize, hidden: isize, } impl Item { pub fn new() -> Item { Item { shown: 1, hidden: 2 } } pub fn shown_method(self: Item) -> isize { self.shown } fn hidden_method(self: Item) -> isize { self.hidden } } pub trait Describe { fn describe(self: Self) -> string; fn kind() -> string; } impl Describe for Item { fn describe(self: Item) -> string { self.shown.to_string() } fn kind() -> string { \"item\" } } #[allow(unused_function)] fn inspect(value: Item) -> () { println(value.shown); println(value.describe()) }";
    let main_source = "package main; use module::lib; use lib::Describe; fn main() -> () { let value = lib::Item::new(); println(value.shown); println(value.shown_method()); println(value.describe()); let _ = lib::Item::new(); () }";
    write_query_fixture(
        root + "/goml.toml",
        \\[module]
        \\path = "query::member_visibility"
        \\
        ,
    );
    write_query_fixture(lib_path, lib_source);
    write_query_fixture(main_path, main_source);
    let external = analyze(main_path, main_source);
    assert_no_diagnostics(external);
    match last_substring(main_source, "value.shown") {
        Some(offset) => {
            let items = completions(external, offset + "value.".byte_len());
            testing::assert(has_completion(items, "shown"));
            testing::assert(has_completion(items, "shown_method"));
            testing::assert(has_completion(items, "describe"));
            testing::assert(!has_completion(items, "hidden"));
            testing::assert(!has_completion(items, "hidden_method"));
            testing::assert(!has_completion(items, "new"));
            testing::assert(!has_completion(items, "kind"))
        },
        None => testing::fail("expected external member access"),
    }
    match last_substring(main_source, "lib::Item::new") {
        Some(offset) => {
            let items = completions(external, offset + "lib::Item::".byte_len());
            testing::assert(has_completion(items, "new"));
            testing::assert(has_completion(items, "shown_method"));
            testing::assert(has_completion(items, "describe"));
            testing::assert(has_completion(items, "kind"));
            testing::assert(!has_completion(items, "hidden_method"))
        },
        None => testing::fail("expected external static access"),
    }
    let local = analyze(lib_path, lib_source);
    assert_no_diagnostics(local);
    match last_substring(lib_source, "value.shown") {
        Some(offset) => {
            let items = completions(local, offset + "value.".byte_len());
            testing::assert(has_completion(items, "shown"));
            testing::assert(has_completion(items, "hidden"));
            testing::assert(has_completion(items, "shown_method"));
            testing::assert(has_completion(items, "hidden_method"));
            testing::assert(has_completion(items, "describe"));
            testing::assert(!has_completion(items, "new"));
            testing::assert(!has_completion(items, "kind"))
        },
        None => testing::fail("expected local member access"),
    }
}

#[test]
fn completes_incomplete_member_and_enum_paths() -> () {
    let member_source = "struct Point { x: i32 } fn main() -> () { let point = Point { x: 1 }; let _ = point.; () }";
    testing::assert(
        has_completion(
            completions(analyze("main.gom", member_source), member_source.byte_len() - 6),
            "x",
        ),
    );
    let enum_source = "enum Color { Red, Green } fn main() -> () { let value = Color::; () }";
    match last_substring(enum_source, "Color::") {
        Some(offset) => {
            let items = completions(analyze("main.gom", enum_source), offset + "Color::".byte_len());
            testing::assert(has_completion(items, "Red"));
            testing::assert(has_completion(items, "Green"))
        },
        None => testing::fail("expected enum path"),
    }
    let argument_source = "struct Point { x: i32 } fn consume(value: i32) -> () { () } fn main() -> () { let point = Point { x: 1 }; consume(point.); () }";
    match last_substring(argument_source, "point.") {
        Some(offset) => testing::assert(
            has_completion(
                completions(analyze("main.gom", argument_source), offset + "point.".byte_len()),
                "x",
            ),
        ),
        None => testing::fail("expected argument member expression"),
    }
}

#[test]
fn completes_standard_library_import_paths() -> () {
    let root_source =
        \\package main;
        \\use st
