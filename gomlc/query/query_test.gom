#[test]
fn rejects_known_uncomparable_raw_map_keys_after_inference() -> () {
    for body in Vec::from_array(
        [
            "pub fn bad(value: ffi::RawMap[Slice[i64], i64]) -> () {}",
            "pub fn bad() -> () { let value: ffi::RawMap[ffi::RawSlice[i64], i64] = ffi::map_new(); }",
            "pub fn bad() -> () { let value: ffi::RawMap[ffi::RawMap[i64, i64], i64] = ffi::map_nil(); }",
            "pub fn bad() -> () { let value: ffi::RawMap[[Slice[i64]; 0], i64] = ffi::map_new(); }",
            "pub fn bad() -> () { let value: ffi::RawMap[(i64, Slice[i64]), i64] = ffi::map_new(); }",
            "struct Key[T] { value: T } pub fn bad() -> () { let value: ffi::RawMap[Key[Slice[i64]], i64] = ffi::map_new(); }",
            "struct Key[T] { value: T } pub fn bad(value: ffi::RawMap[Key[Key[Slice[i64]]], i64]) -> () {}",
            "struct Key[T] { value: T } pub fn bad(value: ffi::RawMap[Key[[Key[ffi::RawSlice[i64]]; 0]], i64]) -> () {}",
            "struct Key[T] { value: T } pub fn bad(value: ffi::RawMap[Key[(i64, Key[Slice[i64]])], i64]) -> () {}",
            "fn make[K]() -> ffi::RawMap[K, i64] { ffi::map_new() } pub fn bad() -> () { let key: ffi::RawSlice[i64] = ffi::slice_nil(); let value = make(); ffi::map_set(value, key, 1); }",
            "type Key = Slice[i64]; pub fn bad() -> () { let value: ffi::RawMap[Key, i64] = ffi::map_new(); }",
        ],
    ) {
        let source = "use std::ffi; " + body + " fn main() -> () {}";
        let analysis = analyze("/tmp/ffi-invalid-map-key.gom", source);
        let mut found = false;
        for diagnostic in analysis.checked.diagnostics {
            if diagnostic.message.contains("Go map key is not comparable") {
                found = true;
            }
        }
        if !found {
            testing::fail("missing map key diagnostic for " + body)
        }
    }
    let source = "use std::ffi; pub fn valid() -> () { let integers: ffi::RawMap[i64, i64] = ffi::map_new(); let pointers: ffi::RawMap[ffi::Ptr[ffi::RawSlice[i64]], i64] = ffi::map_new(); let arrays: ffi::RawMap[[i64; 2], i64] = ffi::map_new(); let _ = ffi::map_len(integers) + ffi::map_len(pointers) + ffi::map_len(arrays); } fn main() -> () {}";
    assert_no_diagnostics(analyze("/tmp/ffi-valid-map-key.gom", source));
}

#[test]
fn accepts_nested_comparable_struct_map_keys() -> () {
    for key in Vec::from_array(
        [
            "Key[Key[i64]]",
            "Key[Key[ffi::Ptr[Slice[i64]]]]",
            "Key[PtrKey[Slice[i64]]]",
            "Key[Phantom[Slice[i64]]]",
        ],
    ) {
        let source = "use std::ffi; struct Key[T] { value: T } struct PtrKey[T] { value: ffi::Ptr[T] } struct Phantom[T] { value: i64 } pub fn valid(value: ffi::RawMap["
            + key
            + ", i64]) -> isize { ffi::map_len(value) } fn main() -> () {}";
        assert_no_diagnostics(analyze("/tmp/ffi-nested-comparable-map-key.gom", source));
    }
}

#[test]
fn rejects_recursive_struct_map_key_layouts_without_expansion() -> () {
    for field in Vec::from_array(["Loop[T]", "Loop[(T, T)]"]) {
        let source = "use std::ffi; struct Loop[T] { value: " + field
            + " } pub fn bad(value: ffi::RawMap[Loop[i64], i64]) -> () {} fn main() -> () {}";
        let analysis = analyze("/tmp/ffi-recursive-map-key.gom", source);
        let mut found = false;
        for diagnostic in analysis.checked.diagnostics {
            if diagnostic.message.contains("Go map key has a recursive struct layout") {
                found = true;
            }
        }
        testing::assert(found);
    }
}

#[test]
fn bounds_nested_struct_map_key_comparability() -> () {
    let mut key = "i64";
    for _ in 0..65 {
        key = "Key[" + key + "]";
    }
    let source = "use std::ffi; struct Key[T] { value: T } pub fn bad(value: ffi::RawMap[" + key
        + ", i64]) -> () {} fn main() -> () {}";
    let analysis = analyze("/tmp/ffi-deep-map-key.gom", source);
    let mut found = false;
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic.message.contains(
            "Go map key comparability exceeds the structural depth limit",
        ) {
            found = true;
        }
    }
    testing::assert(found);
}

#[test]
fn resolves_public_raw_function_nil_apis() -> () {
    let source = "use std::ffi; pub fn inspect() -> bool { let value: ffi::Func[(i64) -> i64] = ffi::func_nil(); let echo: (i64) -> i64 = |x| x; let raw = ffi::func_from_closure(echo); ffi::func_to_closure(raw).is_some() && ffi::func_is_nil(value) } fn main() -> () {}";
    let analysis = analyze("/tmp/ffi-raw-function.gom", source);
    assert_no_diagnostics(analysis);
    for name in Vec::from_array(["func_nil", "func_is_nil", "func_from_closure", "func_to_closure"]) {
        let offset = last_substring(source, name).unwrap_or(0);
        let definitions = goto_definitions(analysis, offset);
        testing::assert_eq(definitions.len(), 1);
        match source_by_path(analysis.sources, definitions[0].source_path) {
            Some(target) => {
                testing::assert_eq(target.package_name, "std::ffi");
                testing::assert_eq(
                    target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                    name,
                );
            },
            None => testing::fail("expected raw function API definition"),
        }
    }
}

#[test]
fn infers_map_key_requirements_from_generic_function_and_method_bodies() -> () {
    for entry in Vec::from_array(
        [
            (
                "fn leaf[T](value: T) -> isize { let map: ffi::RawMap[T, i64] = ffi::map_new(); ffi::map_len(map) } fn relay[T](value: T) -> isize { let call = leaf; call(value) }",
                "relay(key)",
            ),
            (
                "struct Holder[T] { value: T } impl[T] Holder[T] { fn size(self: Holder[T]) -> isize { let map: ffi::RawMap[T, i64] = ffi::map_new(); ffi::map_len(map) } }",
                "Holder { value: key }.size()",
            ),
        ],
    ) {
        for invalid in Vec::from_array([false, true]) {
            let source = "use std::ffi; " + entry.0 + " fn main() -> () { "
                + if invalid {
                    "let key: ffi::RawSlice[i64] = ffi::slice_nil();"
                } else {
                    "let key: i64 = 1;"
                }
                + " let _ = "
                + entry.1
                + "; }";
            let analysis = analyze("/tmp/ffi-inferred-map-key.gom", source);
            if invalid {
                let mut found = false;
                for diagnostic in analysis.checked.diagnostics {
                    if diagnostic.message.contains("Go map key is not comparable") {
                        found = true;
                    }
                }
                if !found {
                    testing::fail("missing inferred map requirement for " + entry.1)
                }
            } else {
                assert_no_diagnostics(analysis)
            }
        }
    }
}

#[test]
fn infers_map_key_requirements_through_source_dependencies_and_overrides() -> () {
    let root = "/tmp/goml-query-inferred-map-dependencies";
    for directory in Vec::from_array([root, root + "/library", root + "/bridge"]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"query::maps\"\n");
    let main_path = root + "/main.gom";
    let leaf_path = root + "/library/z.gom";
    write_query_fixture(main_path, "package main; fn main() -> () {}\n");
    write_query_fixture(
        root + "/library/a.gom",
        "package library; pub fn invoke[T](value: T) -> isize { let call = leaf; let nested = || call(value); nested() }\n",
    );
    write_query_fixture(
        root + "/bridge/bridge.gom",
        "package bridge; use module::library; pub fn relay[T](value: T) -> isize { library::invoke(value) }\n",
    );
    for declaration in Vec::from_array(
        [
            "fn leaf[T](value: T) -> isize { let map: ffi::RawMap[T, i64] = ffi::map_new(); ffi::map_len(map) }",
            "struct Holder[T] { value: T } impl[T] Holder[T] { fn size(self: Holder[T]) -> isize { let map: ffi::RawMap[T, i64] = ffi::map_new(); ffi::map_len(map) } } struct Empty[T] { value: T } impl[T] Empty[T] { fn size(self: Empty[T]) -> isize { 0 } } fn leaf[T](value: T) -> isize { Holder { value }.size() + Empty { value }.size() } pub fn harmless(value: ffi::RawSlice[i64]) -> isize { Empty { value }.size() }",
        ],
    ) {
        write_query_fixture(leaf_path, "package library; use std::ffi; " + declaration);
        for invalid in Vec::from_array([false, true]) {
            let source = "package main; use std::ffi; use module::bridge; fn main() -> () { "
                + if invalid {
                    "let key: ffi::RawSlice[i64] = ffi::slice_nil();"
                } else {
                    "let key: i64 = 1;"
                }
                + " let _ = bridge::relay(key); }";
            let analysis = analyze(main_path, source);
            if invalid {
                let mut found = false;
                for diagnostic in analysis.checked.diagnostics {
                    if diagnostic.message.contains("Go map key is not comparable") {
                        found = true;
                    }
                }
                if !found {
                    testing::fail("missing map requirement from source dependency")
                }
                let overrides = Vec::from_array(
                    [
                        SourceOverride {
                            path: leaf_path,
                            source: "package library; fn leaf[T](value: T) -> isize { 0 }",
                        },
                    ],
                );
                assert_no_diagnostics(analyze_with_overrides(main_path, source, overrides));
            } else {
                assert_no_diagnostics(analysis)
            }
        }
    }
}

#[test]
fn validates_nominal_map_storage_without_expanding_recursive_applications() -> () {
    for declaration in Vec::from_array(
        [
            "struct Table[T] { storage: ffi::RawMap[T, i64] }",
            "enum Table[T] { Entry(ffi::RawMap[T, i64]) }",
            "struct Table[T] { next: ffi::Ptr[Table[(T, T)]], storage: ffi::RawMap[T, i64] }",
        ],
    ) {
        for valid in Vec::from_array([true, false]) {
            let source = "use std::ffi; " + declaration + " pub fn accept(value: Option[Table["
                + if valid {
                    "i64"
                } else {
                    "ffi::RawSlice[i64]"
                }
                + "]]) -> () {}";
            let analysis = analyze("/tmp/goml-nominal-map-recursion.gom", source);
            if valid {
                assert_no_diagnostics(analysis)
            } else {
                let mut found = false;
                for diagnostic in analysis.checked.diagnostics {
                    if diagnostic.message.contains("Go map key is not comparable") {
                        found = true;
                    }
                }
                if !found {
                    testing::fail("missing nominal map requirement diagnostic")
                }
            }
        }
    }
}

#[test]
fn validates_default_method_map_requirements_in_source_dependencies() -> () {
    let root = "/tmp/goml-query-default-map-dependencies";
    if let Err(error) = fs::create_dir_all(root + "/behavior") {
        testing::fail(error.to_string());
    }
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"query::defaults\"\n");
    let main_path = root + "/main.gom";
    let trait_path = root + "/behavior/behavior.gom";
    write_query_fixture(main_path, "package main; fn main() -> () {}\n");
    for associated in Vec::from_array([false, true]) {
        let prefix = "package behavior; use std::ffi; pub trait Size { "
            + if associated {
                "type Item; "
            } else {
                ""
            }
            + "fn size(self: Self) -> isize { ";
        write_query_fixture(
            trait_path,
            prefix + "let map: ffi::RawMap["
                + if associated {
                    "Self::Item"
                } else {
                    "Self"
                }
                + ", i64] = ffi::map_new(); ffi::map_len(map) } }",
        );
        for valid in Vec::from_array([true, false]) {
            for override in Vec::from_array([false, true]) {
                let key = if valid {
                    "ffi::Ptr[ffi::RawSlice[i64]]"
                } else {
                    "ffi::RawSlice[i64]"
                };
                let source = "package main; use std::ffi; use module::behavior; use behavior::Size; struct Key { "
                    + if associated {
                        ""
                    } else {
                        "value: " + key
                    }
                    + " } impl Size for Key { "
                    + if associated {
                        "type Item = " + key + "; "
                    } else {
                        ""
                    }
                    + if override {
                        "fn size(self: Key) -> isize { 42 }"
                    } else {
                        ""
                    }
                    + " } fn main() -> () {}";
                let analysis = analyze(main_path, source);
                if valid || override {
                    assert_no_diagnostics(analysis)
                } else {
                    let mut found = false;
                    for diagnostic in analysis.checked.diagnostics {
                        if diagnostic.message.contains("Go map key is not comparable") {
                            found = true;
                        }
                    }
                    testing::assert(found);
                    assert_no_diagnostics(
                        analyze_with_overrides(
                            main_path,
                            source,
                            Vec::from_array(
                                [SourceOverride { path: trait_path, source: prefix + "0 } }" }],
                            ),
                        ),
                    );
                }
            }
        }
    }
}
