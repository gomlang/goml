#[test]
fn resolves_local_and_function_definitions() -> () {
    let local_source = "fn main() -> i32 { let value = 42; value }";
    let local_analysis = analyze("main.gom", local_source);
    match goto_definition(local_analysis, local_source.byte_len() - 3) {
        Some(definition) => testing::assert_eq(
            local_source.byte_slice(definition.span.start, definition.span.end),
            "value",
        ),
        None => testing::fail("expected local definition"),
    }
    let function_source = "fn helper() -> i32 { 42 } fn main() -> i32 { helper() }";
    let function_analysis = analyze("main.gom", function_source);
    match last_substring(function_source, "helper") {
        Some(offset) => match goto_definition(function_analysis, offset) {
            Some(definition) => testing::assert_eq(
                function_source.byte_slice(definition.span.start, definition.span.end),
                "helper",
            ),
            None => testing::fail("expected function definition"),
        },
        None => testing::fail("expected helper call"),
    }
}

#[test]
fn resolves_definitions_in_local_dependencies() -> () {
    let root = "../gomlc/testdata/module/project001";
    let main_path = root + "/main.gom";
    match fs::read_file_structured(main_path) {
        Ok(source) => match last_substring(source, "sum_point") {
            Some(offset) => {
                let analysis = analyze(main_path, source);
                match goto_definition(analysis, offset) {
                    Some(definition) => {
                        testing::assert(definition.source_path.ends_with("/lib/lib.gom"));
                        match fs::read_file_structured(definition.source_path) {
                            Ok(target_source) => testing::assert_eq(
                                target_source.byte_slice(definition.span.start, definition.span.end),
                                "sum_point",
                            ),
                            Err(error) => testing::fail(error.to_string()),
                        }
                    },
                    None => {
                        testing::fail("expected dependency definition")
                    },
                }
            },
            None => testing::fail("expected sum_point call"),
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn resolves_package_type_variant_and_field_definitions() -> () {
    let root = "../gomlc/testdata/module/project001";
    let main_path = root + "/main.gom";
    let source = match fs::read_file_structured(main_path) {
        Ok(source) => source,
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    };
    let analysis = analyze(main_path, source);
    match last_substring(source, "lib::Point") {
        Some(offset) => match goto_definition(analysis, offset + "lib::".byte_len()) {
            Some(definition) => match source_by_path(analysis.sources, definition.source_path) {
                Some(target) => testing::assert_eq(
                    target.source.byte_slice(definition.span.start, definition.span.end),
                    "Point",
                ),
                None => testing::fail("expected type source"),
            },
            None => testing::fail("expected type definition"),
        },
        None => testing::fail("expected Point path"),
    }
    match last_substring(source, "Green") {
        Some(offset) => match goto_definition(analysis, offset) {
            Some(definition) => match source_by_path(analysis.sources, definition.source_path) {
                Some(target) => testing::assert_eq(
                    target.source.byte_slice(definition.span.start, definition.span.end),
                    "Green",
                ),
                None => testing::fail("expected variant source"),
            },
            None => testing::fail("expected variant definition"),
        },
        None => testing::fail("expected Green path"),
    }
    match last_substring(source, "x: 20") {
        Some(offset) => match goto_definition(analysis, offset) {
            Some(definition) => match source_by_path(analysis.sources, definition.source_path) {
                Some(target) => testing::assert_eq(
                    target.source.byte_slice(definition.span.start, definition.span.end),
                    "x",
                ),
                None => testing::fail("expected field source"),
            },
            None => testing::fail("expected field definition"),
        },
        None => testing::fail("expected struct field"),
    }
    let use_path = "use project001::lib";
    match last_substring(source, use_path) {
        Some(offset) => match goto_definition(analysis, offset + use_path.byte_len() - 1) {
            Some(definition) => {
                testing::assert(definition.source_path.byte_len() >= "lib.gom".byte_len());
                testing::assert_eq(definition.span.start, 0)
            },
            None => testing::fail("expected package definition"),
        },
        None => testing::fail("expected use path"),
    }
}

#[test]
fn resolves_contextual_pattern_variant_definitions() -> () {
    let root = "../gomlc/testdata/module/project041_contextual_enum_patterns";
    let main_path = root + "/main.gom";
    let source = match fs::read_file_structured(main_path) {
        Ok(source) => source,
        Err(error) => {
            testing::fail(error.to_string());
            ""
        },
    };
    let analysis = analyze(main_path, source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "Ready(number)") {
        Some(offset) => {
            match goto_definition(analysis, offset) {
                Some(definition) => {
                    if definition.source_path.ends_with("/events/events.gom") {} else {
                        testing::fail(
                            "unexpected contextual variant source " + definition.source_path,
                        )
                    }
                    match source_by_path(analysis.sources, definition.source_path) {
                        Some(target) => testing::assert_eq(
                            target.source.byte_slice(definition.span.start, definition.span.end),
                            "Ready",
                        ),
                        None => {
                            testing::fail("expected contextual variant source")
                        },
                    }
                },
                None => {
                    testing::fail("expected contextual variant definition")
                },
            }
            match hover(analysis, offset) {
                Some(result) => if result.contents.contains("Event") {} else {
                    testing::fail("unexpected contextual variant hover " + result.contents)
                },
                None => testing::fail("expected contextual variant hover"),
            }
        },
        None => testing::fail("expected contextual Ready pattern"),
    }
}

#[test]
fn resolves_builtin_method_definitions() -> () {
    let source = "fn main() -> string { let value = 1; value.to_string() }";
    match last_substring(source, "to_string") {
        Some(offset) => match goto_definition(analyze("main.gom", source), offset) {
            Some(definition) => match source_by_path(
                analyze("main.gom", source).sources,
                definition.source_path,
            ) {
                Some(target) => testing::assert_eq(
                    target.source.byte_slice(definition.span.start, definition.span.end),
                    "to_string",
                ),
                None => testing::fail("expected builtin source"),
            },
            None => testing::fail("expected builtin method definition"),
        },
        None => testing::fail("expected builtin method"),
    }
    let string_source = "fn main() -> bool { \"abc\".contains(\"b\") }";
    match last_substring(string_source, "contains") {
        Some(offset) => match goto_definition(analyze("main.gom", string_source), offset) {
            Some(definition) => match source_by_path(
                analyze("main.gom", string_source).sources,
                definition.source_path,
            ) {
                Some(target) => testing::assert_eq(
                    target.source.byte_slice(definition.span.start, definition.span.end),
                    "contains",
                ),
                None => testing::fail("expected builtin source"),
            },
            None => testing::fail("expected string method definition"),
        },
        None => testing::fail("expected string method"),
    }
    let numeric_source = "fn main() -> u8 { let value: i16 = 257; value.to_u8() }";
    match last_substring(numeric_source, "to_u8") {
        Some(offset) => {
            let analysis = analyze("main.gom", numeric_source);
            match goto_definition(analysis, offset) {
                Some(definition) => {
                    if definition.source_path.ends_with("/builtin/numeric.gom") {} else {
                        testing::fail("expected numeric builtin source")
                    }
                    match source_by_path(analysis.sources, definition.source_path) {
                        Some(target) => testing::assert_eq(
                            target.source.byte_slice(definition.span.start, definition.span.end),
                            "to_u8",
                        ),
                        None => testing::fail("expected numeric builtin source"),
                    }
                },
                None => testing::fail("expected numeric builtin method definition"),
            }
        },
        None => testing::fail("expected numeric builtin method"),
    }
    let static_source = "fn main() -> Vec[i32] { Vec::new() }";
    match last_substring(static_source, "new") {
        Some(offset) => {
            let analysis = analyze("main.gom", static_source);
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            let expected = Ref::new(Option::None);
            for symbol in build_symbol_index(analysis).symbols {
                if symbol.qualified_name == "builtin::Vec::new" {
                    expected.set(Option::Some(symbol.span))
                }
            }
            match expected.get() {
                Some(span) => {
                    testing::assert_eq(definitions.get(0).span.start, span.start);
                    testing::assert_eq(definitions.get(0).span.end, span.end)
                },
                None => testing::fail("expected Vec new symbol"),
            }
        },
        None => testing::fail("expected builtin static method"),
    }
    let ref_source = "fn main() -> i32 { let value = Ref::new(1.to_i32()); value.get() }";
    match last_substring(ref_source, "get") {
        Some(offset) => {
            let analysis = analyze("main.gom", ref_source);
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            let expected = Ref::new(Option::None);
            for symbol in build_symbol_index(analysis).symbols {
                if symbol.qualified_name == "builtin::Ref::get" {
                    expected.set(Option::Some(symbol.span))
                }
            }
            match expected.get() {
                Some(span) => {
                    testing::assert_eq(definitions.get(0).span.start, span.start);
                    testing::assert_eq(definitions.get(0).span.end, span.end)
                },
                None => testing::fail("expected Ref get symbol"),
            }
        },
        None => testing::fail("expected Ref get method"),
    }
}

#[test]
fn resolves_collection_from_array_definitions() -> () {
    let source = "fn main() -> Vec[isize] { Vec::from_array([1, 2]) }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    match last_substring(source, "from_array") {
        Some(offset) => {
            let definitions = goto_definitions(analysis, offset);
            testing::assert_eq(definitions.len(), 1);
            let expected = Ref::new(Option::None);
            for symbol in build_symbol_index(analysis).symbols {
                if symbol.qualified_name == "builtin::Vec::from_array" {
                    expected.set(Option::Some(symbol.span))
                }
            }
            match expected.get() {
                Some(span) => {
                    testing::assert_eq(definitions[0].span.start, span.start);
                    testing::assert_eq(definitions[0].span.end, span.end)
                },
                None => testing::fail("expected Vec from_array symbol"),
            }
        },
        None => testing::fail("expected Vec from_array call"),
    }
    let map_source = "fn main() -> HashMap[string, isize] { HashMap::from_array([(\"a\", 1)]) }";
    let map_analysis = analyze("main.gom", map_source);
    assert_no_diagnostics(map_analysis);
    match last_substring(map_source, "from_array") {
        Some(offset) => match goto_definition(map_analysis, offset) {
            Some(definition) => {
                let found = Ref::new(false);
                for symbol in build_symbol_index(map_analysis).symbols {
                    if symbol.qualified_name == "builtin::HashMap::from_array"
                        && symbol.span.start == definition.span.start
                        && symbol.span.end == definition.span.end {
                        found.set(true)
                    }
                }
                testing::assert(found.get())
            },
            None => testing::fail("expected HashMap from_array definition"),
        },
        None => testing::fail("expected HashMap from_array call"),
    }
}

#[test]
fn resolves_prelude_function_definitions() -> () {
    let source = "fn main() -> () { println(\"hello\") }";
    match last_substring(source, "println") {
        Some(offset) => {
            let analysis = analyze("main.gom", source);
            match goto_definition(analysis, offset) {
                Some(definition) => {
                    testing::assert(definition.source_path.ends_with("/prelude/prelude.gom"));
                    match source_by_path(analysis.sources, definition.source_path) {
                        Some(target) => {
                            testing::assert_eq(target.package_name, "prelude");
                            testing::assert_eq(
                                target.source.byte_slice(definition.span.start, definition.span.end),
                                "println",
                            )
                        },
                        None => testing::fail("expected prelude source"),
                    }
                },
                None => testing::fail("expected prelude function definition"),
            }
        },
        None => testing::fail("expected println call"),
    }
}

