package query;

use module::checker;
use module::ast;
use std::fs;
use std::testing;
use std::time;

fn cache_query_fixture(root: string) -> string {
    for name in Vec::from_array(["leaf", "left", "right", "client"]) {
        if let Err(error) = fs::create_dir_all(root + "/" + name) {
            testing::fail(error.to_string())
        }
    }
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::cache\"\n");
    write_query_fixture(root + "/leaf/value.goml", "package leaf; pub fn value() -> i64 { 1 }");
    write_query_fixture(
        root + "/left/value.goml",
        "package left; use module::leaf; pub fn value() -> i64 { leaf::value() }",
    );
    write_query_fixture(root + "/right/value.goml", "package right; pub fn value() -> i64 { 2 }");
    let source = "package client; use module::left; use module::right; pub fn value() -> i64 { left::value() + right::value() }";
    write_query_fixture(root + "/client/main.goml", source);
    source
}

fn assert_query_counts(context: AnalysisContext, checked: isize, reused: isize) -> () {
    let stats = analysis_stats(context);
    testing::assert_eq(stats.checked_packages.len(), checked);
    testing::assert_eq(stats.reused_packages.len(), reused)
}

#[test]
fn query_cache_rechecks_only_changed_packages_and_their_dependents() -> () {
    let root = "/tmp/goml-query-cache-dependencies";
    let source = cache_query_fixture(root);
    let file = root + "/client/main.goml";
    let context = analysis_context();
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 4, 0);
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 0, 4);
    let edited = source + " pub fn extra() -> bool { true }";
    assert_no_diagnostics(analyze_with_context(context, file, edited, Vec::new()));
    assert_query_counts(context, 1, 3);
    let overrides = Vec::from_array(
        [
            SourceOverride {
                path: root + "/leaf/value.goml",
                source: "package leaf; pub fn value() -> i64 { 3 }",
            },
        ],
    );
    assert_no_diagnostics(analyze_with_context(context, file, edited, overrides));
    assert_query_counts(context, 3, 1);
    testing::assert(analysis_stats(context).reused_packages.contains("example::cache::right"));
    let changed = Vec::from_array(
        [
            SourceOverride {
                path: root + "/leaf/value.goml",
                source: "package leaf; pub fn value() -> bool { true }",
            },
        ],
    );
    testing::assert(
        checker::diagnostics_have_errors(
            diagnostics(analyze_with_context(context, file, edited, changed)),
        ),
    );
    testing::assert(analysis_stats(context).reused_packages.contains("example::cache::right"));
    assert_no_diagnostics(analyze_with_context(context, file, edited, Vec::new()));
    assert_no_diagnostics(analyze_with_context(context, file, edited, Vec::new()));
    assert_query_counts(context, 0, 4);
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_cache_tracks_source_membership_and_dependency_failures() -> () {
    let root = "/tmp/goml-query-cache-membership";
    let source = cache_query_fixture(root);
    let file = root + "/client/main.goml";
    let context = analysis_context();
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    let extra = root + "/leaf/extra.goml";
    let override_files = Vec::from_array(
        [SourceOverride { path: extra, source: "package leaf; pub fn value() -> i64 { 4 }" }],
    );
    testing::assert(
        checker::diagnostics_have_errors(
            diagnostics(analyze_with_context(context, file, source, override_files)),
        ),
    );
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    let _ = fs::remove_file(root + "/leaf/value.goml");
    testing::assert(
        checker::diagnostics_have_errors(
            diagnostics(analyze_with_context(context, file, source, Vec::new())),
        ),
    );
    write_query_fixture(root + "/leaf/value.goml", "package leaf; pub fn value() -> i64 { 1 }");
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    clear_analysis_cache(context);
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 4, 0);
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_cache_measures_cold_body_and_signature_edits() -> () {
    let root = "/tmp/goml-query-cache-measurements";
    let source = cache_query_fixture(root);
    let file = root + "/client/main.goml";
    let context = analysis_context();
    let cold = time::Instant::now();
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    let cold_time = cold.elapsed().as_milliseconds();
    let body = "package client; use module::left; use module::right; pub fn value() -> i64 { left::value() + right::value() + 3 }";
    let start = time::Instant::now();
    assert_no_diagnostics(analyze_with_context(context, file, body, Vec::new()));
    let body_time = start.elapsed().as_milliseconds();
    assert_query_counts(context, 1, 3);
    let signature = Vec::from_array(
        [
            SourceOverride {
                path: root + "/left/value.goml",
                source: "package left; use module::leaf; pub fn value() -> bool { leaf::value() == 1 }",
            },
        ],
    );
    let start = time::Instant::now();
    let checked = analyze_with_context(context, file, body, signature);
    let signature_time = start.elapsed().as_milliseconds();
    testing::assert(checker::diagnostics_have_errors(diagnostics(checked)));
    assert_query_counts(context, 2, 2);
    println(
        "query cache: cold=" + cold_time.to_string() + "ms (4 checked), body="
            + body_time.to_string()
            + "ms (1 checked), signature="
            + signature_time.to_string()
            + "ms (2 checked)",
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn expanded_source_is_computed_for_the_requested_document() -> () {
    let root = "/tmp/goml-query-expanded-source-cache";
    let _ = fs::create_dir_all(root);
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::expanded\"\n");
    write_query_fixture(root + "/other.goml", "package sample; pub fn other() -> isize { 2 }");
    let source = "package sample; #[derive(ToString)] struct Item { value: isize }";
    let value = analyze_with_context(analysis_context(), root + "/main.goml", source, Vec::new());
    assert_no_diagnostics(value);
    testing::assert(value.expanded_source.get().is_none());
    let expanded = expanded_derive(value);
    testing::assert(expanded.contains("to_string"));
    testing::assert(!expanded.contains("fn other"));
    testing::assert_eq(value.expanded_source.get().unwrap_or(""), expanded);
    testing::assert_eq(expanded_derive(value), expanded);
    let _ = fs::remove_dir_all(root);
}

#[test]
fn prepared_sources_track_contents_module_identity_and_diagnostics() -> () {
    let context = analysis_context();
    let file = SourceFile {
        path: "/tmp/goml-query-prepared.goml",
        source: "use module::dep; pub fn value() -> isize { 1 }",
        package_name: "sample",
    };
    let first = prepared_source(context, file, "example::first");
    testing::assert(ast::pretty(first).contains("example::first::dep"));
    let second = prepared_source(context, file, "example::second");
    testing::assert(ast::pretty(second).contains("example::second::dep"));
    let broken = SourceFile { source: "fn", ..file };
    let invalid = prepared_source(context, broken, "example::second");
    testing::assert(!invalid.diagnostics.is_empty());
    let count = invalid.diagnostics.len();
    invalid.diagnostics.clear();
    testing::assert_eq(prepared_source(context, broken, "example::second").diagnostics.len(), count);
    let repaired = prepared_source(context, file, "example::second");
    testing::assert(repaired.diagnostics.is_empty());
    testing::assert(ast::pretty(repaired).contains("example::second::dep"));
    clear_analysis_cache(context);
    testing::assert(context.prepared_sources.is_empty());
}

#[test]
fn prepared_sources_keep_failed_derive_diagnostics_isolated() -> () {
    let context = analysis_context();
    let source = "#[derive(MissingHandler)] struct Item { value: isize }";
    let first = analyze_with_context(
        context,
        "/tmp/goml-query-derive-cache.goml",
        source,
        Vec::new(),
    );
    let count = diagnostics(first).len();
    testing::assert(count > 0);
    for attempt in 0..3 {
        let next = analyze_with_context(
            context,
            "/tmp/goml-query-derive-cache.goml",
            source,
            Vec::new(),
        );
        testing::assert_eq(diagnostics(next).len(), count);
    }
}

#[test]
fn dependency_discovery_preserves_file_scoped_aliases_and_source_changes() -> () {
    let context = analysis_context();
    let sources = Vec::from_array(
        [
            SourceFile {
                path: "/tmp/goml-query-import-discovery/left.goml",
                source: "package sample; use module::left as dep; use dep::{Value};",
                package_name: "example::discovery",
            },
            SourceFile {
                path: "/tmp/goml-query-import-discovery/right.goml",
                source: "package sample; use module::right as dep; use dep::{Value};",
                package_name: "example::discovery",
            },
        ],
    );
    let project = Project {
        description: None,
        module_root: "/tmp/goml-query-import-discovery",
        module_path: "example::discovery",
        package_dir: "/tmp/goml-query-import-discovery",
        package_name: "example::discovery",
        files: sources,
    };
    let first = discover_cached_package(context, project);
    testing::assert_eq(first.len(), 2);
    for index in 0..first.len() {
        testing::assert_eq(first[index].source_path, sources[index].path);
        testing::assert(!first[index].import_aliases.is_empty());
        let expected = if index == 0 {
            "example::discovery::left"
        } else {
            "example::discovery::right"
        };
        for alias in first[index].import_aliases {
            testing::assert_eq(alias.package_name, expected);
        }
    }
    sources[0] = SourceFile { source: sources[1].source, ..sources[0] };
    let changed = discover_cached_package(context, project);
    for alias in changed[0].import_aliases {
        testing::assert_eq(alias.package_name, "example::discovery::right");
    }
    for alias in first[0].import_aliases {
        testing::assert_eq(alias.package_name, "example::discovery::left");
    }
}
