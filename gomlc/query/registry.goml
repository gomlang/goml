package query;

use gomlang::toolchain_manifest as config;
use gomlang::toolchain_manifest::resolver;
use std::env;
use std::fs;
use std::path;
use gomlang::toolchain_manifest::registry as index;

type DependencyRequirement = config::Dependency;

type ResolvedModule = resolver::ResolvedModule;

fn manifest_dependencies(source: string) -> Vec[DependencyRequirement] {
    parse_document(source).and_then(parse_dependencies).unwrap_or(Vec::new())
}

fn registry_home() -> Result[string, string] {
    match env::var_structured("GOML_HOME") {
        Ok(value) => if value != "" {
            Result::Ok(value)
        } else {
            Result::Err("GOML_HOME is empty")
        },
        Err(_) => match env::var_structured("HOME") {
            Ok(value) => if value != "" {
                Result::Ok(path::join(value, ".goml"))
            } else {
                Result::Err("HOME is empty")
            },
            Err(_) => match env::var_structured("USERPROFILE") {
                Ok(value) => if value != "" {
                    Result::Ok(path::join(value, ".goml"))
                } else {
                    Result::Err("USERPROFILE is empty")
                },
                Err(_) => {
                    Result::Err("failed to determine GoML home directory")
                },
            },
        },
    }
}

fn registry_root() -> Result[string, string] {
    registry_home().map(|home| path::join(path::join(home, "cache"), "registry"))
}

fn module_directory(root: string, name: string) -> Result[string, string] {
    let source = fs::read_file_structured(path::join(root, "index.toml")).map_err(
        |error| error.to_string(),
    )?;
    let entry = index::find(index::parse(source)?, name)?;
    index::cached_directory(root, entry)
}

fn resolve_external_modules_at(module_root: string, root: string) -> Result[
    Vec[ResolvedModule],
    string,
] {
    resolve_external_modules_with_development(module_root, root, false)
}

fn resolve_external_modules_with_development(module_root: string, root: string, development: bool) -> Result[
    Vec[ResolvedModule],
    string,
] {
    let module_root = fs::canonicalize(module_root).map_err(|error| error.to_string())?;
    let root_manifest = load_dependency_manifest(path::join(module_root, MANIFEST_FILENAME))?;
    let overrides = local_overrides(module_root, root_manifest)?;
    let metadata = resolver::Manifest {
        module_path: root_manifest.module_path,
        dependencies: root_manifest.dependencies,
    };
    if development {
        resolver::resolve_development(
            RegistryProvider {},
            module_root,
            metadata,
            root_manifest.dev_dependencies,
            overrides,
            root,
        )
    } else {
        resolver::resolve(RegistryProvider {}, module_root, metadata, overrides, root)
    }
}

fn resolve_external_modules(module_root: string) -> Result[Vec[ResolvedModule], string] {
    resolve_external_modules_at(module_root, registry_root()?)
}

fn module_matches_package(module_name: string, package_name: string) -> bool {
    package_name == module_name || package_name.starts_with(module_name + "::")
}
