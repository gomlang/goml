package query;

use module::ast;
use module::cst;
use module::lexer;
use module::tast;

pub struct InlayHint {
    pub position: isize,
    pub label: string,
    pub span: ast::Span,
}

fn containing_node(syntax: SyntaxIndex, token: SyntaxToken, kind: cst::NodeKind) -> Option[
    SyntaxNode,
] {
    let mut current = Option::Some(token.parent);
    while current.is_some() {
        if let Some(id) = current {
            let node = syntax.nodes[id];
            if cst::node_kind_equal(node.kind, kind) {
                return Option::Some(node)
            } else {
                current = node.parent;
            }
        }
    }
    Option::None
}

fn let_has_annotation(syntax: SyntaxIndex, statement: SyntaxNode) -> bool {
    let mut index = token_index_at_or_after(syntax, statement.start);
    while index < syntax.tokens.len() && syntax.tokens[index].start < statement.end {
        let token = syntax.tokens[index];
        if token.parent == statement.id
            && lexer::token_kind_equal(token.kind, lexer::TokenKind::Colon) {
            return true
        } else {
            index += 1;
        }
    }
    false
}

fn span_overlaps_range(span: ast::Span, start: isize, end: isize) -> bool {
    span.end >= start && span.start <= end
}

pub fn inlay_hints_in_range(value: Analysis, start: isize, end: isize) -> Vec[InlayHint] {
    let hints: Vec[InlayHint] = Vec::new();
    for fact in value.checked.typeck_results.locals {
        let within_range = match fact.span {
            Some(span) => span_overlaps_range(span, start, end),
            None => false,
        };
        if fact.source_path == value.source_path && within_range {
            let Some(definition) = local_definition_span_from_fact(value, fact) else {
                continue
            };
            if definition.span.end < start || definition.span.end > end {
                continue
            }
            let Some(token) = token_at(value.syntax, definition.span.start) else {
                continue
            };
            let owner = match containing_node(value.syntax, token, cst::NodeKind::STMT_LET) {
                Some(statement) => Option::Some(statement),
                None => containing_node(value.syntax, token, cst::NodeKind::CLOSURE_PARAM),
            };
            if let Some(node) = owner {
                if let_has_annotation(value.syntax, node) {} else {
                    match tast::resolve_type(fact.ty) {
                        Error => (),
                        ty => hints.push(
                            InlayHint {
                                position: definition.span.end,
                                label: ": " + tast::diagnostic_type_text(ty),
                                span: definition.span,
                            },
                        ),
                    }
                }
            }
        }
    }
    hints
}

pub fn inlay_hints(value: Analysis) -> Vec[InlayHint] {
    inlay_hints_in_range(value, 0, value.source.byte_len())
}
