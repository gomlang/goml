package query;

use std::fs;
use std::testing;

fn assert_collected_source(files: Vec[SourceFile], path: string, expected: string) -> () {
    let file = testing::expect_some(source_by_path(files, path), "expected source " + path);
    testing::assert_eq(file.source, expected)
}

#[test]
fn package_source_collection_preserves_override_precedence_and_test_scope() -> () {
    let root = "/tmp/gomlc-query-source-overrides";
    let _ = fs::remove_dir_all(root);
    testing::expect_ok(fs::create_dir_all(root), "create source directory");
    let disk = root + "/main.goml";
    let memory = root + "/memory.goml";
    let test_file = root + "/main_test.goml";
    write_query_fixture(disk, "disk");
    write_query_fixture(test_file, "disk test");
    let overrides = Vec::from_array(
        [
            SourceOverride { path: disk, source: "first disk override" },
            SourceOverride { path: root + "/./main.goml", source: "last disk override" },
            SourceOverride { path: memory, source: "first memory override" },
            SourceOverride { path: memory, source: "last memory override" },
        ],
    );
    let dependencies = testing::expect_ok(
        collect_dependency_files(root, overrides),
        "collect dependency sources",
    );
    testing::assert_eq(dependencies.len(), 2);
    assert_collected_source(dependencies, disk, "last disk override");
    assert_collected_source(dependencies, memory, "first memory override");
    let active_disk = testing::expect_ok(
        collect_package_files(root, disk, "active disk", overrides),
        "collect active disk source",
    );
    testing::assert_eq(active_disk.len(), 2);
    assert_collected_source(active_disk, disk, "active disk");
    assert_collected_source(active_disk, memory, "first memory override");
    let active_memory = testing::expect_ok(
        collect_package_files(root, memory, "active memory", overrides),
        "collect active memory source",
    );
    testing::assert_eq(active_memory.len(), 2);
    assert_collected_source(active_memory, disk, "last disk override");
    assert_collected_source(active_memory, memory, "first memory override");
    let fresh = root + "/fresh.goml";
    let active_fresh = testing::expect_ok(
        collect_package_files(root, fresh, "active fresh", overrides),
        "collect unsaved source",
    );
    testing::assert_eq(active_fresh.len(), 3);
    assert_collected_source(active_fresh, fresh, "active fresh");
    let active_test = testing::expect_ok(
        collect_package_files(root, test_file, "active test", overrides),
        "collect test source",
    );
    testing::assert_eq(active_test.len(), 3);
    assert_collected_source(active_test, test_file, "active test");
    let _ = fs::remove_dir_all(root);
}

#[test]
fn dependency_package_paths_reject_invalid_segments_before_loading_sources() -> () {
    let root = "/tmp/gomlc-query-package-paths";
    let _ = fs::remove_dir_all(root);
    for package_name in Vec::from_array(
        [
            "demo::other",
            "demo::library_extra",
            "demo::library::",
            "demo::library::.",
            "demo::library::..::outside",
            "demo::library::child::::nested",
            "demo::library::child::",
        ],
    ) {
        match dependency_project(root, "demo::library", package_name, Vec::new()) {
            Ok(_) => testing::fail("expected invalid package path " + package_name),
            Err(error) => testing::assert_eq(
                error,
                "package " + package_name + " is outside the current module",
            ),
        }
    }
    testing::expect_ok(fs::create_dir_all(root + "/child/nested"), "create dependency package");
    match dependency_project(root, "demo::library", "demo::library::child::nested", Vec::new()) {
        Ok(_) => testing::fail("expected empty dependency package error"),
        Err(error) => testing::assert_eq(
            error,
            "package directory " + root + "/child/nested has no .goml files",
        ),
    }
    write_query_fixture(root + "/child/nested/value.goml", "package nested;");
    let project = testing::expect_ok(
        dependency_project(root, "demo::library", "demo::library::child::nested", Vec::new()),
        "load dependency package",
    );
    testing::assert_eq(project.package_dir, root + "/child/nested");
    testing::assert_eq(project.files.len(), 1);
    testing::assert_eq(project.files[0].package_name, "demo::library::child::nested");
    let _ = fs::remove_dir_all(root);
}
