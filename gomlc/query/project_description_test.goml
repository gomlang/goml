package query;

use module::project_info;
use module::tast;
use std::fs;
use std::testing;

#[test]
fn explicit_project_description_analyzes_unsaved_dependencies_without_manifests() -> () {
    let root = "/tmp/gomlc-explicit-project-description";
    let _ = fs::remove_dir_all(root);
    testing::expect_ok(fs::create_dir_all(root + "/app"), "create application");
    testing::expect_ok(fs::create_dir_all(root + "/leaf"), "create dependency");
    let dependency = root + "/leaf/lib.goml";
    write_query_fixture(dependency, "package leaf; pub fn answer() -> isize { 42 }");
    let description = project_info::Description {
        root: root + "/app",
        module_path: "demo::app",
        target_dir: root + "/app/_artifact",
        development: false,
        error: Option::None,
        modules: Vec::from_array(
            [
                project_info::Module {
                    name: "demo::app",
                    root: root + "/app",
                    dependencies: Vec::from_array(["demo::leaf"]),
                    dev_dependencies: Vec::new(),
                },
                project_info::Module {
                    name: "demo::leaf",
                    root: root + "/leaf",
                    dependencies: Vec::new(),
                    dev_dependencies: Vec::new(),
                },
            ],
        ),
    };
    let source = "package main; use demo::leaf; pub fn value() -> isize { leaf::answer() }";
    let filename = root + "/app/main.goml";
    let context = analysis_context();
    let analysis = analyze_with_project(
        context,
        Result::Ok(Option::Some(description)),
        filename,
        source,
        Vec::new(),
    );
    assert_no_diagnostics(analysis);
    let offset = testing::expect_some(last_substring(source, "answer"), "call");
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    testing::assert_eq(definitions[0].source_path, dependency);
    let overrides = Vec::from_array(
        [
            SourceOverride {
                path: dependency,
                source: "package leaf; pub fn answer() -> bool { true }",
            },
        ],
    );
    let changed = analyze_with_project(
        context,
        Result::Ok(Option::Some(description)),
        filename,
        source,
        overrides,
    );
    testing::assert(tast::diagnostics_have_errors(diagnostics(changed)));
    let unavailable = project_info::Description {
        error: Option::Some("missing dependency demo::leaf"),
        ..description,
    };
    let failed = analyze_with_project(
        context,
        Result::Ok(Option::Some(unavailable)),
        filename,
        "package main; pub fn value() -> isize { 42 }",
        Vec::new(),
    );
    testing::assert(tast::diagnostics_have_errors(diagnostics(failed)));
    testing::assert_eq(project_info::request_count(context.project_client), 0);
    testing::expect_ok(fs::remove_dir_all(root), "remove project");
}
