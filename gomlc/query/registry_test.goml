package query;

use std::testing;
use std::fs;

#[test]
fn ignores_commented_dependencies() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\# "alice::unused" = "9.0.0"
        \\"alice::http" = "1.0.0" # "alice::unused" = "9.0.0"
        \\  # "alice::other" = "2.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert(dependencies[0].path.is_none())
}

#[test]
fn recognizes_dependency_sections_with_inline_comments() -> () {
    let dependencies = manifest_dependencies(
        \\[module]
        \\path = "alice::app"
        \\[dependencies] # "ignored" = "9.0.0"
        \\  "alice::http" = "1.0.0"
        \\[build] # end dependencies
        \\target-dir = "output"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http");
    testing::assert(dependencies[0].path.is_none())
}

#[test]
fn preserves_comment_characters_inside_dependency_strings() -> () {
    let dependencies = manifest_dependencies(
        \\[dependencies]
        \\"alice::http#invalid" = { path = "../http#data" } # "ignored" = "9.0.0"
        ,
    );
    testing::assert_eq(dependencies.len(), 1);
    testing::assert_eq(dependencies[0].name, "alice::http#invalid");
    testing::assert(dependencies[0].path == Option::Some("../http#data"))
}

#[test]
fn ignores_quoted_comments_in_registry_sources() -> () {
    let root = "/tmp/gomlc-query-registry-comments";
    let _ = testing::expect_ok(fs::create_dir_all(root + "/alice/http"), "registry directory");
    write_query_fixture(
        root + "/index.toml",
        "[modules.\"alice::http\"] # ignored\npath = \"alice/http\" # \"not-a-source\"\n",
    );
    write_query_fixture(root + "/alice/http/goml.toml", "[module]\npath = \"alice::http\"\n");
    testing::assert_eq(
        testing::expect_ok(module_directory(root, "alice::http"), "registry source"),
        root + "/alice/http",
    );
}
