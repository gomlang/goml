package query;

use gomlang::toolchain_manifest as config;
use std::toml;
use std::path;
use std::fs;

type LocalModule = config::LocalModule;

fn parse_document(source: string) -> Result[toml::Value, string] {
    config::parse_document(source)
}

fn parse_dependencies(document: toml::Value) -> Result[Vec[DependencyRequirement], string] {
    config::parse_dependencies(document)
}

fn validate_dependency_name(value: string) -> Result[(), string] {
    validate_module_path(value, false)
}

fn parse_replacements(document: toml::Value, root: string) -> Result[Vec[LocalModule], string] {
    config::parse_replacements(document, root, validate_dependency_name)
}

fn workspace_member(filename: string) -> Result[string, string] {
    load_dependency_manifest(filename).map(|manifest| manifest.module_path)
}

fn local_overrides(module_root: string, manifest: DependencyManifest) -> Result[
    Vec[LocalModule],
    string,
] {
    config::local_overrides(
        module_root,
        manifest.replacements,
        workspace_member,
        validate_dependency_name,
    )
}

struct DependencyManifest {
    module_path: string,
    dependencies: Vec[DependencyRequirement],
    replacements: Vec[LocalModule],
}

fn validate_module_path(value: string, allow_toolchain: bool) -> Result[(), string] {
    let segments = value.split("::");
    for segment in segments {
        if segment == "" {
            return Result::Err("invalid module path " + value)
        }
        for index in 0..segment.byte_len() {
            let byte = segment.byte_get(index);
            if !((byte >= b'a' && byte <= b'z') || (byte >= b'A' && byte <= b'Z')
                || (byte >= b'0' && byte <= b'9')
                || byte == b'_'
                || byte == b'-') {
                return Result::Err("invalid module path " + value)
            }
        }
    }
    if !allow_toolchain && (segments[0] == "builtin" || segments[0] == "prelude") {
        return Result::Err("module path " + value + " is reserved for the toolchain")
    }
    Result::Ok(())
}

fn load_dependency_manifest(filename: string) -> Result[DependencyManifest, string] {
    let source = fs::read_file_structured(filename).map_err(|error| error.to_string())?;
    let document = parse_document(source)?;
    let module_path = toml::field(document, "module").and_then(|value| toml::field(value, "path")).and_then(
        toml::as_string,
    ).ok_or("goml.toml is missing [module].path")?;
    validate_module_path(module_path, false)?;
    let dependencies = parse_dependencies(document)?;
    for dependency in dependencies {
        validate_module_path(dependency.name, false)?;
    }
    let replacements = parse_replacements(document, path::parent(filename).unwrap_or("."))?;
    Result::Ok(DependencyManifest { module_path, dependencies, replacements })
}
