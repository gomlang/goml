package query;

use module::diagnostic;
use std::fs;
use std::testing;

fn foreign_query_fixture(root: string) -> () {
    for directory in Vec::from_array([root, root + "/native", root + "/bindings", root + "/client"]) {
        if let Err(error) = fs::create_dir_all(directory) {
            testing::fail(error.to_string())
        }
    }
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::query\"\n");
    write_query_fixture(root + "/go.mod", "module example.com/query\n\ngo 1.26\n");
    write_query_fixture(
        root + "/native/types.go",
        "package native\ntype Named int64\ntype Alias = int64\ntype Box[T ~int64] struct { Value T }\ntype Erased[T ~int64] = int64\n",
    );
    write_query_fixture(
        root + "/bindings/types.goml",
        "package bindings; #[go_type(\"example.com/query/native\", \"Named\")] pub extern type Named; #[go_type(\"example.com/query/native\", \"Alias\")] pub extern type Alias; #[go_type(\"example.com/query/native\", \"Box\")] pub extern type Box[T]; #[go_type(\"example.com/query/native\", \"Erased\")] pub extern type Erased[T]; pub fn echo(value: Named) -> Named { value }",
    );
}

fn assert_foreign_query_error(analysis: Analysis, expected: string) -> () {
    for diagnostic in diagnostics(analysis) {
        if diagnostic.message.contains(expected) {
            testing::assert(diagnostic.source_path != "");
            return
        }
    }
    testing::fail("expected query diagnostic: " + expected)
}

#[test]
fn query_checks_external_types_across_packages_and_unsaved_sources() -> () {
    let root = "/tmp/goml-query-external-types";
    foreign_query_fixture(root);
    let context = analysis_context();
    let file = root + "/client/main.goml";
    let source = "package client; use module::bindings; pub fn echo(value: bindings::Named) -> bindings::Named { bindings::echo(value) } pub fn alias(value: bindings::Alias) -> bindings::Alias { value } pub fn box(value: bindings::Box[i64]) -> bindings::Box[i64] { value }";
    write_query_fixture(file, source);
    let analysis = analyze_with_context(context, file, source, Vec::new());
    assert_no_diagnostics(analysis);
    assert_query_counts(context, 2, 0);
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 0, 2);
    if let Some(offset) = last_substring(source, "Named") {
        let definitions = goto_definitions(analysis, offset);
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(definitions[0].source_path, root + "/bindings/types.goml");
        testing::assert(hover(analysis, offset).is_some());
        testing::assert(has_completion(completions(analysis, offset), "Named"));
    } else {
        testing::fail("missing external type reference")
    }
    let bad = "package client; use module::bindings; pub fn bad(value: bindings::Named) -> bindings::Alias { value }";
    testing::assert(
        diagnostic::diagnostics_have_errors(
            diagnostics(analyze_with_context(context, file, bad, Vec::new())),
        ),
    );
    let changed = "package bindings; #[go_type(\"example.com/query/native\", \"Alias\")] pub extern type Named; #[go_type(\"example.com/query/native\", \"Alias\")] pub extern type Alias;";
    assert_no_diagnostics(
        analyze_with_context(
            context,
            file,
            bad,
            Vec::from_array(
                [SourceOverride { path: root + "/bindings/types.goml", source: changed }],
            ),
        ),
    );
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_checks_declared_generic_arity_without_inspecting_go_constraints() -> () {
    let root = "/tmp/goml-query-external-constraints";
    foreign_query_fixture(root);
    let context = analysis_context();
    let file = root + "/client/main.goml";
    for name in Vec::from_array(["Box", "Erased"]) {
        let valid = "package client; use module::bindings; pub fn accept(value: Option[bindings::"
            + name
            + "[i64]]) -> () {}";
        assert_no_diagnostics(analyze_with_context(context, file, valid, Vec::new()));
        let deferred = "package client; use module::bindings; pub fn accept(value: Option[bindings::"
            + name
            + "[bool]]) -> () {}";
        assert_no_diagnostics(analyze_with_context(context, file, deferred, Vec::new()));
        let invalid = "package client; use module::bindings; pub fn accept(value: bindings::" + name
            + "[i64, bool]) -> () {}";
        testing::assert(
            diagnostic::diagnostics_have_errors(
                diagnostics(analyze_with_context(context, file, invalid, Vec::new())),
            ),
        );
        let symbolic = "package client; use module::bindings; pub fn accept[T](value: bindings::"
            + name
            + "[T]) -> () {}";
        assert_no_diagnostics(analyze_with_context(context, file, symbolic, Vec::new()));
        let alias = "package client; use module::bindings; pub type Wrapped[T] = bindings::" + name
            + "[T]; ";
        assert_no_diagnostics(
            analyze_with_context(
                context,
                file,
                alias + "pub fn accept[T](value: Wrapped[T]) -> Wrapped[T] { value }",
                Vec::new(),
            ),
        );
        let alias_analysis = analyze_with_context(
            context,
            file,
            alias + "pub fn accept(value: Wrapped[bool]) -> Wrapped[bool] { value }",
            Vec::new(),
        );
        assert_no_diagnostics(alias_analysis);
    }
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_uses_explicit_foreign_declarations_without_go_sources() -> () {
    let root = "/tmp/goml-query-external-declarations";
    foreign_query_fixture(root);
    let _ = fs::remove_file(root + "/go.mod");
    let _ = fs::remove_dir_all(root + "/native");
    let file = root + "/client/main.goml";
    let context = analysis_context();
    let source = "package client; #[go_type(\"missing.example/native\", \"Missing\")] pub extern type Missing; #[go_ffi(\"missing.example/native\", \"Identity\")] extern fn identity(value: Missing) -> Missing; pub fn accept(value: Missing) -> Missing { identity(value) }";
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 0, 1);
    let invalid = "package client; pub extern type Missing;";
    assert_foreign_query_error(
        analyze_with_context(context, file, invalid, Vec::new()),
        "external types require exactly one go_type attribute",
    );
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_keeps_go_aliases_opaque_and_reports_metadata_dependent_operations() -> () {
    let root = "/tmp/goml-query-external-opaque";
    foreign_query_fixture(root);
    let file = root + "/client/main.goml";
    let context = analysis_context();
    let declaration = "package client; #[go_type(\"example.com/query/native\", \"Alias\")] pub extern type Alias; ";
    let source = declaration + "pub fn accept(value: Alias) -> Alias { value }";
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    write_query_fixture(root + "/native/types.go", "package native\ntype Alias = bool\n");
    assert_no_diagnostics(analyze_with_context(context, file, source, Vec::new()));
    assert_query_counts(context, 0, 1);
    for body in Vec::from_array(
        [
            "pub fn accept(value: Alias) -> i64 { value }",
            "pub fn accept(value: Alias) -> bool { value }",
        ],
    ) {
        testing::assert(
            diagnostic::diagnostics_have_errors(
                diagnostics(analyze_with_context(context, file, declaration + body, Vec::new())),
            ),
        );
    }
    for body in Vec::from_array(
        [
            "pub fn field(value: Alias) -> i64 { value.Value }",
            "pub fn construct() -> Alias { Alias { Value: 1 } }",
        ],
    ) {
        assert_foreign_query_error(
            analyze_with_context(context, file, declaration + body, Vec::new()),
            "opaque external Go type",
        );
    }
    let _ = fs::remove_dir_all(root);
}

fn assert_foreign_diagnostic_location(
    analysis: Analysis,
    message: string,
    source_path: string,
    source: string,
    expected: string,
) -> () {
    for diagnostic in diagnostics(analysis) {
        if diagnostic.message.contains(message) {
            testing::assert_eq(diagnostic.source_path, source_path);
            let Some(span) = diagnostic.span else {
                testing::fail("foreign diagnostic has no source location");
                return
            };
            testing::assert_eq(source.byte_slice(span.start, span.end), expected);
            return
        }
    }
    testing::fail("expected foreign diagnostic: " + message)
}

#[test]
fn foreign_type_diagnostics_identify_the_failing_declaration_and_file() -> () {
    let root = "/tmp/goml-query-foreign-locations";
    foreign_query_fixture(root);
    let context = analysis_context();
    let file = root + "/client/main.goml";
    let good = "package client; #[go_type(\"time\", \"Duration\")] pub extern type Good; ";
    let source = good + "#[go_type(\"invalid import path\", \"Bad\")] pub extern type Bad;";
    write_query_fixture(file, source);
    assert_foreign_diagnostic_location(
        analyze_with_context(context, file, source, Vec::new()),
        "external Go type is not publicly nameable",
        file,
        source,
        "Bad",
    );
    write_query_fixture(file, good);
    let second = root + "/client/types.goml";
    let invalid = "package client; pub extern type Missing;";
    write_query_fixture(second, invalid);
    assert_foreign_diagnostic_location(
        analyze_with_context(context, file, good, Vec::new()),
        "external types require exactly one go_type attribute",
        second,
        invalid,
        "pub extern type Missing;",
    );
    let _ = fs::remove_dir_all(root);
}

#[test]
fn query_validates_explicit_interface_boundaries_and_cross_file_members() -> () {
    let root = "/tmp/goml-query-interface-boundaries";
    foreign_query_fixture(root);
    let context = analysis_context();
    let file = root + "/client/main.goml";
    let raw = "package client; #[go_type(\"io\", \"Reader\")] pub extern type Raw; ";
    let valid = raw
        + "#[go_interface(Raw, Wrapped, read = \"Read\")] pub trait Reader { fn read(self: Self) -> i64; }";
    write_query_fixture(file, valid);
    assert_no_diagnostics(analyze_with_context(context, file, valid, Vec::new()));
    for source in Vec::from_array(
        [
            raw
                + "#[go_interface(Raw, Wrapped, read = \"Read\")] pub trait Reader { fn read(self: Self, value: string) -> (); }",
            raw
                + "#[go_interface(Raw, Wrapped, read = \"Read\")] pub trait Reader { fn read(self: Self, value: Slice[u8]) -> (); }",
        ],
    ) {
        assert_foreign_query_error(
            analyze_with_context(context, file, source, Vec::new()),
            "go_interface",
        );
    }
    assert_foreign_query_error(
        analyze_with_context(
            context,
            file,
            "package client; type Raw = i64; #[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self) -> i64; }",
            Vec::new(),
        ),
        "Go interface bridge requires a native interface target",
    );
    let second = root + "/client/extension.goml";
    let extension = "package client; type Alias = Wrapped; impl Alias { pub fn into_go(self: Alias) -> Raw { self.raw } }";
    write_query_fixture(second, extension);
    assert_foreign_diagnostic_location(
        analyze_with_context(context, file, valid, Vec::new()),
        "go_interface generated member collides",
        second,
        extension,
        "into_go",
    );
    let _ = fs::remove_dir_all(root);
}
