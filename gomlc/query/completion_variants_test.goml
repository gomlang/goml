package query;

use std::testing;
use std::fs;

fn variant_test_completions(marked: string) -> Vec[CompletionItem] {
    let offset = testing::expect_some(marked.find("$0"), "expected cursor");
    let source = marked.replace("$0", "");
    completions(analyze("/tmp/variant-completion.goml", source), offset)
}

fn variant_test_item(items: Vec[CompletionItem], name: string) -> CompletionItem {
    for item in items {
        if item.label == name {
            return item
        }
    }
    testing::fail("missing " + name + " in " + completion_labels(items));
    CompletionItem { label: "", detail: "", kind: Variant, insert_text: None }
}

#[test]
fn variant_completion_match_variants_and_arm_snippets() -> () {
    let items = variant_test_completions(
        "enum Event { Ready, Data(isize), Named { text: string } } enum Other { Wrong } fn run(value: Event) -> () { match value { $0 } }",
    );
    testing::assert_eq(items.len(), 3);
    testing::assert(
        variant_test_item(items, "Ready").insert_text == Option::Some("Ready => ${1:()},"),
    );
    testing::assert(
        variant_test_item(items, "Data").insert_text == Option::Some("Data(${1:value}) => ${2:()},"),
    );
    testing::assert(
        variant_test_item(items, "Named").insert_text
            == Option::Some("Named { text: ${1:text} } => ${2:()},"),
    );
    testing::assert(variant_test_item(items, "Data").detail.contains("(isize)"));
}

#[test]
fn variant_completion_partial_match_patterns_and_preserves_existing_syntax() -> () {
    for pattern in Vec::from_array(["Da$0", "Event::Da$0"]) {
        let items = variant_test_completions(
            "enum Event { Ready, Data(isize) } fn run(value: Event) -> () { match value { "
                + pattern
                + " => (), _ => () } }",
        );
        testing::assert(
            variant_test_item(items, "Data").insert_text == Option::Some("Data(${1:value})"),
        );
    }
    let items = variant_test_completions(
        "enum Event { Data(isize) } fn run(value: Event) -> () { match value { Da$0ta(value) => () } }",
    );
    testing::assert(variant_test_item(items, "Data").insert_text.is_none());
}

#[test]
fn variant_completion_remaining_unit_arms_and_keeps_guarded_variants() -> () {
    for arm in Vec::from_array(["Ready => (),", "Event::Ready => (),"]) {
        let items = variant_test_completions(
            "enum Event { Ready, Waiting } fn run(value: Event) -> () { match value { " + arm
                + " $0 } }",
        );
        testing::assert(!has_completion(items, "Ready"));
        testing::assert(has_completion(items, "Waiting"));
    }
    let items = variant_test_completions(
        "enum Event { Ready, Waiting } fn run(value: Event) -> () { match value { Ready if false => (), $0 } }",
    );
    testing::assert(has_completion(items, "Ready"));
    let items = variant_test_completions(
        "enum Event { Ready, Waiting } fn run(value: Event) -> () { match value { Ready => (), Event::$0 } }",
    );
    if has_completion(items, "Ready") {
        testing::fail("covered qualified variant in " + completion_labels(items))
    }
    let _ = variant_test_item(items, "Waiting");
}

#[test]
fn variant_completion_contextual_constructors_and_qualified_payloads() -> () {
    for expression in Vec::from_array(
        [
            "fn run() -> Option[isize] { So$0 }",
            "fn run() -> () { let result: Option[isize] = So$0; }",
            "fn run() -> () { let result = Option::So$0; }",
            "fn take(value: Option[isize]) -> () {} fn run() -> () { take(So$0); }",
            "type Maybe = Option[isize]; fn run() -> Maybe { Maybe::So$0 }",
        ],
    ) {
        let item = variant_test_item(variant_test_completions(expression), "Some");
        testing::assert_eq(
            item.insert_text.unwrap_or("no snippet for " + expression),
            "Some(${1:value})",
        );
        if !item.detail.contains("::Some(") {
            testing::fail("missing payload detail for " + expression + ": " + item.detail)
        }
    }
    let items = variant_test_completions(
        "enum Event { Ready, Data(isize) } fn run() -> () { Da$0 }",
    );
    let _ = variant_test_item(items, "Data");
}

#[test]
fn variant_completion_nested_patterns_use_payload_types() -> () {
    let items = variant_test_completions(
        "fn run(value: Option[Result[isize, string]]) -> () { match value { Some(O$0) => (), _ => () } }",
    );
    testing::assert(has_completion(items, "Ok"));
    testing::assert(!has_completion(items, "Option"));
    testing::assert(variant_test_item(items, "Ok").insert_text == Option::Some("Ok(${1:value})"));
}

#[test]
fn variant_completion_preserves_ordinary_name_shadowing() -> () {
    let items = variant_test_completions("struct Some {} fn run() -> Option[isize] { So$0 }");
    let item = variant_test_item(items, "Some");
    testing::assert(item.insert_text.is_none());
    testing::assert(!matches_variant_completion(item));
}

#[test]
fn variant_completion_respects_import_aliases_and_enum_identity() -> () {
    let root = "/tmp/goml-query-variant-completion";
    testing::expect_ok(create_variant_completion_fixture(root), "expected fixture");
    let marked = "package main; use module::events as ev; type Alias = ev::Event; fn run(value: Alias) -> () { match value { Re$0 } }";
    let source = marked.replace("$0", "");
    let offset = testing::expect_some(marked.find("$0"), "expected cursor");
    write_query_fixture(root + "/main.goml", source);
    let analysis = analyze(root + "/main.goml", source);
    let items = completions(analysis, offset);
    if !has_completion(items, "Ready") {
        let mut message = completion_labels(items);
        for diagnostic in analysis.checked.diagnostics {
            message = message + "\n" + diagnostic.message;
        }
        testing::fail(message)
    }
    let _ = variant_test_item(items, "Ready");
    if has_completion(items, "Rejected") {
        testing::fail("unrelated enum in " + completion_labels(items))
    }
    let marked = marked.replace("Re$0", "ev::Event::Re$0");
    let source = marked.replace("$0", "");
    let offset = testing::expect_some(marked.find("$0"), "expected cursor");
    write_query_fixture(root + "/main.goml", source);
    let items = completions(analyze(root + "/main.goml", source), offset);
    let _ = variant_test_item(items, "Ready");
    if has_completion(items, "Rejected") {
        testing::fail("unrelated enum in " + completion_labels(items))
    }
    let _ = fs::remove_dir_all(root);
}

fn create_variant_completion_fixture(root: string) -> Result[(), string] {
    fs::create_dir_all(root + "/events").map_err(|error| error.to_string())?;
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::variants\"\n");
    write_query_fixture(
        root + "/events/main.goml",
        "package events; pub enum Event { Ready, Data(isize) } pub enum Other { Rejected }",
    );
    Ok(())
}

#[test]
fn cached_match_completion_uses_current_syntax_and_checked_scrutinee() -> () {
    let source = "fn run(value: Option[isize]) -> () { match value { None => (), } }";
    let analysis = analyze("/tmp/cached-match-completion.goml", source);
    let marked = source.replace("None => (),", "None => (),\n    So$0");
    let offset = testing::expect_some(marked.find("$0"), "expected cursor");
    let items = cached_completions(analysis, marked.replace("$0", ""), offset);
    testing::assert(
        variant_test_item(items, "Some").insert_text == Option::Some("Some(${1:value}) => ${2:()},"),
    );
}

#[test]
fn match_body_completion_keeps_local_scope() -> () {
    let items = variant_test_completions(
        "fn run(value: Option[isize]) -> isize { match value { Some(number) => num$0, None => 0 } }",
    );
    testing::assert(has_completion(items, "number"));
}
