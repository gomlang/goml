package query;

use module::formatter;
use std::fs;
use std::path;
use std::testing;

fn doc_fixture(name: string) -> string {
    let root = path::absolute_structured("_artifact/documentation-tests/" + name).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    if fs::exists(root) {
        fs::remove_dir_all(root).unwrap_or_else(
            |error| {
                testing::fail(error.to_string());
                loop {}
            },
        );
    }
    fs::create_dir_all(root).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    fs::write_file_structured(
        path::join(root, "goml.toml"),
        "[module]\npath = \"doc_test\"\n[build]\ntarget-dir = \"build/output\"\n",
    ).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    root
}

fn doc_item(items: Vec[DocItem], name: string) -> DocItem {
    for item in items {
        if item.name == name {
            return item
        }
    }
    testing::fail("missing documentation item " + name);
    items[0]
}

fn doc_source() -> string {
    \\//! Example package.
    \\package sample;
    \\
    \\/// A value with [Describe].
    \\pub struct Value {
    \\    /// Visible field.
    \\    pub value: isize,
    \\    secret: isize,
    \\}
    \\
    \\/// Describes values.
    \\pub trait Describe {
    \\    /// Result type.
    \\    type Output;
    \\    /// Render the value.
    \\    fn describe(self: Self) -> Self::Output;
    \\}
    \\
    \\impl Describe for Value {
    \\    type Output = string;
    \\    fn describe(self: Value) -> string { "value" }
    \\}
    \\
    \\impl Value {
    \\    /// Make a value.
    \\    pub fn new() -> Value { Value { value: 1, secret: 2 } }
    \\    fn hidden(self: Value) -> isize { self.secret }
    \\}
    \\
    \\pub static COUNTER: OnceCell[isize] = OnceCell::new();
    \\pub type Count = isize;
    \\pub enum Message { Empty, Pair(isize, string), Named { value: isize } }
    \\struct Private { pub leak: isize }
    \\impl Private { pub fn leak(self: Private) -> isize { self.leak } }
    \\
}

#[test]
fn documentation_public_api_and_formatter_attachment() -> () {
    let root = doc_fixture("public");
    let source_path = path::join(root, "main.goml");
    let source = doc_source();
    fs::write_file_structured(source_path, source).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let project = documentation_project(root).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let result = document_module(project, false, path::join(project.target_dir, "doc")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    testing::assert_eq(result.packages.len(), 1);
    testing::assert_eq(result.warnings.len(), 0);
    let package_value = result.packages[0];
    testing::assert_eq(package_value.documentation, "Example package.");
    let value = doc_item(package_value.items, "Value");
    testing::assert_eq(value.documentation, "A value with [Describe].");
    testing::assert_eq(value.members.len(), 1);
    testing::assert_eq(value.members[0].documentation, "Visible field.");
    testing::assert(!value.signature.contains("secret"));
    testing::assert_eq(value.links[0].target, "doc_test::Describe");
    let describe = doc_item(package_value.items, "Describe");
    testing::assert_eq(doc_item(describe.members, "Output").documentation, "Result type.");
    testing::assert_eq(doc_item(package_value.items, "COUNTER").kind, "static");
    let mut implementations = 0;
    for item in package_value.items {
        testing::assert(item.name != "Private");
        if item.kind == "impl" {
            implementations += 1;
            testing::assert_eq(item.target, "doc_test::Value");
            for member in item.members {
                testing::assert(member.name != "hidden")
            }
        }
    }
    testing::assert_eq(implementations, 2);
    let formatted = formatter::format_source(source).unwrap_or_else(
        |_| {
            testing::fail("format failed");
            ""
        },
    );
    fs::write_file_structured(source_path, formatted).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let after = document_module(project, false, path::join(project.target_dir, "doc")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let value_after = doc_item(after.packages[0].items, "Value");
    testing::assert_eq(value_after.documentation, value.documentation);
    testing::assert_eq(value_after.members[0].documentation, value.members[0].documentation);
    let private_result = document_module(project, true, path::join(project.target_dir, "doc")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    testing::assert_eq(doc_item(private_result.packages[0].items, "Private").public, false);
}

#[test]
fn documentation_discovers_production_packages_and_reexports() -> () {
    let root = doc_fixture("packages");
    fs::create_dir_all(path::join(root, "model")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    fs::write_file_structured(
        path::join(root, "model/value.goml"),
        "package different;\npub struct Value {}\n",
    ).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    fs::write_file_structured(
        path::join(root, "main.goml"),
        "package sample;\nuse module::model;\npub use module::model::{Value as Exported};\n/// See [different::Value].\npub fn answer() -> isize { 42 }\n",
    ).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    for directory in Vec::from_array(["tests", "testdata", ".hidden", "build/output", "nested"]) {
        fs::create_dir_all(path::join(root, directory)).unwrap_or_else(
            |error| {
                testing::fail(error.to_string());
                loop {}
            },
        );
        fs::write_file_structured(
            path::join(path::join(root, directory), "invalid.goml"),
            "invalid {",
        ).unwrap_or_else(
            |error| {
                testing::fail(error.to_string());
                loop {}
            },
        );
    }
    fs::write_file_structured(path::join(root, "nested/goml.toml"), "[module]\npath = \"nested\"\n").unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    fs::write_file_structured(path::join(root, "broken_test.goml"), "invalid {").unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let project = documentation_project(path::join(root, "model")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    let result = document_module(project, false, path::join(project.target_dir, "doc")).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    testing::assert_eq(result.packages.len(), 2);
    testing::assert_eq(result.warnings.len(), 0);
    let exported = doc_item(result.packages[0].items, "Exported");
    testing::assert_eq(exported.target, "doc_test::model::Value");
    testing::assert_eq(
        doc_item(result.packages[0].items, "answer").links[0].target,
        exported.target,
    );
}

#[test]
fn documentation_derived_api_generics_and_ambiguous_methods() -> () {
    let root = doc_fixture("derived");
    let source =
        \\package sample;
        \\/// A generic value.
        \\#[derive(Debug)]
        \\/// Derived display.
        \\pub struct Value[T] { pub value: T }
        \\pub trait Tagged {}
        \\impl[T] Tagged for T {}
        \\pub trait First { fn render(self: Self) -> string; }
        \\pub trait Second { fn render(self: Self) -> string; }
        \\impl First for Value[isize] { fn render(self: Value[isize]) -> string { "first" } }
        \\impl Second for Value[isize] { fn render(self: Value[isize]) -> string { "second" } }
        \\/// See [Value::render] and [Missing].
        \\pub fn identity[T](value: T) -> T where T: Debug { value }
        \\
    ;
    testing::expect_ok(
        fs::write_file_structured(path::join(root, "main.goml"), source),
        "write fixture",
    );
    let project = testing::expect_ok(documentation_project(root), "discover fixture");
    let result = testing::expect_ok(
        document_module(project, false, path::join(project.target_dir, "doc")),
        "document fixture",
    );
    testing::assert_eq(result.warnings.len(), 2);
    let mut generated = false;
    let mut blanket = false;
    for item in result.packages[0].items {
        if item.kind == "impl" && item.target == "T" {
            blanket = true;
        }
        if item.generated && item.kind == "impl" {
            generated = true;
        }
    }
    if !generated {
        testing::fail("expected a generated public implementation")
    }
    if !blanket {
        testing::fail("expected a blanket implementation")
    }
    testing::assert(
        doc_item(result.packages[0].items, "identity").signature.contains("where T: Debug"),
    );
    testing::assert_eq(
        doc_item(result.packages[0].items, "Value").documentation,
        "A generic value.\nDerived display.",
    );
}
