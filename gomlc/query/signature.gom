package query;

use module::ast;
use module::parser;
use module::tast;
use std::text;

pub struct SignatureResult {
    pub label: string,
    pub parameters: Vec[string],
    pub active_parameter: isize,
    pub span: ast::Span,
}

fn call_target_name(value: Analysis, fact: tast::CallFact) -> string {
    match fact.target {
        Local(local) => local.hint,
        Definition(_) => token_text(value, fact.callee_span.start).unwrap_or("<function>"),
        Callable(callable) => callable_name(callable),
        Constructor(constructor) => constructor.name,
        Unresolved(name) => name,
    }
}

fn signature_label(parameters: Vec[string], return_type: string) -> string {
    let builder = text::StringBuilder::new();
    builder.write_char('(');
    let mut index = 0;
    for parameter in parameters {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string(parameter);
        index += 1;
    }
    builder.write_string(") -> ");
    builder.write_string(return_type);
    builder.finish()
}

fn method_call_target(value: tast::ReferenceTarget) -> bool {
    match value {
        Callable(TraitMethod { .. },) | Callable(DynTraitMethod { .. },) | Callable(InherentMethod {
            ..,
        },) => true,
        _ => false,
    }
}

fn function_parameter_names(value: ast::Function) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for parameter in value.params {
        result.push(parameter.0)
    }
    result
}

fn extern_parameter_names(value: ast::ExternFunction) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for parameter in value.params {
        result.push(parameter.0)
    }
    result
}

fn item_parameter_names(
    value: ast::Item,
    expected: string,
    expected_owner: Option[string],
    allow_unresolved: bool,
) -> Option[Vec[string]] {
    match value {
        Function(function) => if expected_owner.is_none() && function.name == expected {
            Option::Some(function_parameter_names(function))
        } else {
            Option::None
        },
        ExternFunction(function) => if expected_owner.is_none() && function.name == expected {
            Option::Some(extern_parameter_names(function))
        } else {
            Option::None
        },
        ImplBlock(block) => {
            match expected_owner {
                Some(owner) => {
                    let actual = explicit_type_name(block.for_type)?;
                    if short_type_name(actual) != short_type_name(owner) {
                        return Option::None
                    }
                },
                None => if !allow_unresolved {
                    return Option::None
                },
            }
            let mut index = block.methods.len() - 1;
            while index >= 0 {
                let method = block.methods[index];
                if method.name == expected {
                    return Option::Some(function_parameter_names(method))
                } else {
                    index -= 1;
                }
            }
            Option::None
        },
        TraitDef(definition) => {
            match expected_owner {
                Some(owner) => if short_type_name(definition.name) != short_type_name(owner) {
                    return Option::None
                },
                None => if !allow_unresolved {
                    return Option::None
                },
            }
            let mut index = definition.method_sigs.len() - 1;
            while index >= 0 {
                let method = definition.method_sigs[index];
                if method.name == expected {
                    let names: Vec[string] = Vec::new();
                    for parameter in method.params {
                        names.push(parameter.0)
                    }
                    return Option::Some(names)
                } else {
                    index -= 1;
                }
            }
            Option::None
        },
        _ => Option::None,
    }
}

fn signature_target_owner(value: tast::ReferenceTarget) -> Option[string] {
    match value {
        Callable(TraitMethod { trait_ref, .. },) => Option::Some(trait_ref.name),
        Callable(DynTraitMethod { trait_name, dispatch_name: _, method_name: _ },) => Option::Some(
            trait_name,
        ),
        Callable(InherentMethod { receiver_ty, method_name: _ },) => Option::Some(
            type_owner_name(receiver_ty),
        ),
        _ => Option::None,
    }
}

fn file_parameter_names(
    file: ast::File,
    expected: string,
    expected_owner: Option[string],
    allow_unresolved: bool,
) -> Option[Vec[string]] {
    let mut item_index = file.items.len() - 1;
    while item_index >= 0 {
        match item_parameter_names(
            file.items[item_index],
            expected,
            expected_owner,
            allow_unresolved,
        ) {
            Some(names) => return Option::Some(names),
            None => {
                item_index -= 1;
            },
        }
    }
    Option::None
}

fn exact_function_symbol(value: Analysis, qualified_name: string) -> Option[Symbol] {
    for symbol in build_symbol_index(value).symbols {
        if symbol.qualified_name == qualified_name
            && match symbol.kind {
                Function => true,
                _ => false,
            } {
            return Option::Some(symbol)
        }
    }
    Option::None
}

fn method_origin_equal(left: MethodOrigin, right: MethodOrigin) -> bool {
    match (left, right) {
        (Inherent, Inherent) | (TraitDeclaration, TraitDeclaration) => true,
        _ => false,
    }
}

fn method_signature_symbol(value: Analysis, owner: string, name: string, origin: MethodOrigin) -> Option[
    Symbol,
] {
    let result: Vec[Symbol] = Vec::new();
    let qualified = short_type_name(owner) != owner;
    for symbol in build_symbol_index(value).symbols {
        let actual_owner = symbol_owner(symbol.qualified_name);
        if match symbol.kind {
            Method => true,
            _ => false,
        }
            && symbol.name == name
            && method_origin_equal(symbol.method_origin, origin)
            && if qualified {
                actual_owner == owner
            } else {
                actual_owner == value.package_name + "::" + owner
                    || actual_owner == "builtin::" + owner
                    || actual_owner == "prelude::" + owner
            } {
            result.push(symbol)
        }
    }
    if result.len() == 1 {
        Option::Some(result[0])
    } else {
        Option::None
    }
}

fn callee_function_symbol(value: Analysis, fact: tast::CallFact) -> Option[Symbol] {
    match path_node_at(value, fact.callee_span.start) {
        Some(node) => {
            let identifiers = node_identifiers(value, node);
            if identifiers.is_empty() {
                Option::None
            } else {
                let canonical = canonical_path_at(value, node, identifiers, identifiers.len() - 1);
                match exact_function_symbol(value, canonical) {
                    Some(symbol) => Option::Some(symbol),
                    None => if short_type_name(canonical) == canonical {
                        exact_function_symbol(value, value.package_name + "::" + canonical)
                    } else {
                        Option::None
                    },
                }
            }
        },
        None => Option::None,
    }
}

fn signature_target_symbol(value: Analysis, fact: tast::CallFact) -> Option[Symbol] {
    match fact.target {
        Callable(Function(name)) => match exact_function_symbol(value, name) {
            Some(symbol) => Option::Some(symbol),
            None => callee_function_symbol(value, fact),
        },
        Callable(LangItem { item: _, function_name }) => match exact_function_symbol(
            value,
            function_name,
        ) {
            Some(symbol) => Option::Some(symbol),
            None => callee_function_symbol(value, fact),
        },
        Callable(TraitMethod { trait_ref, method_name, .. },) => {
            method_signature_symbol(
                value,
                trait_ref.name,
                method_name,
                MethodOrigin::TraitDeclaration,
            )
        },
        Callable(DynTraitMethod { trait_name, dispatch_name: _, method_name },) => {
            method_signature_symbol(value, trait_name, method_name, MethodOrigin::TraitDeclaration)
        },
        Callable(InherentMethod { receiver_ty, method_name },) => {
            method_signature_symbol(
                value,
                type_owner_name(receiver_ty),
                method_name,
                MethodOrigin::Inherent,
            )
        },
        Callable(GoInterfaceBridge { .. }) | Callable(Runtime(_)) | Callable(Intrinsic(_)) | Callable(GoForeign {
            ..,
        },) | Callable(GoMethod { .. },) => {
            callee_function_symbol(value, fact)
        },
        Definition(_) => exact_function_symbol(
            value,
            value.package_name + "::" + short_type_name(call_target_name(value, fact)),
        ),
        _ => Option::None,
    }
}

fn symbol_parameter_names(
    value: Analysis,
    symbol: Symbol,
    expected: string,
    expected_owner: Option[string],
) -> Option[Vec[string]] {
    if symbol.source_path == value.source_path {
        value.lowered.ast.and_then(
            |file| file_parameter_names(file, expected, expected_owner, false),
        )
    } else {
        match source_by_path(value.sources, symbol.source_path) {
            Some(source) => ast::lower(parser::parse(source.source)).ast.and_then(
                |file| file_parameter_names(file, expected, expected_owner, false),
            ),
            None => Option::None,
        }
    }
}

fn unresolved_parameter_names(value: Analysis, expected: string) -> Option[Vec[string]] {
    if let Some(file) = value.lowered.ast {
        if let Some(names) = file_parameter_names(file, expected, Option::None, true) {
            return Option::Some(names)
        }
    }
    let mut source_index = value.sources.len() - 1;
    while source_index >= 0 {
        let source = value.sources[source_index];
        if source.path == value.source_path {} else {
            if let Some(file) = ast::lower(parser::parse(source.source)).ast {
                if let Some(names) = file_parameter_names(file, expected, Option::None, true) {
                    return Option::Some(names)
                }
            }
        }
        source_index -= 1;
    }
    Option::None
}

fn signature_parameter_names(value: Analysis, fact: tast::CallFact) -> Option[Vec[string]] {
    if let Callable(Intrinsic(name)) = fact.target {
        if name == "vec.from_array" || name == "hashmap.from_array" {
            return Option::Some(Vec::from_array(["values"]))
        }
    }
    let expected = short_type_name(call_target_name(value, fact));
    let expected_owner = signature_target_owner(fact.target);
    match fact.target {
        Unresolved(_) => unresolved_parameter_names(value, expected),
        _ => signature_target_symbol(value, fact).and_then(
            |symbol| symbol_parameter_names(value, symbol, symbol.name, expected_owner),
        ),
    }
}

fn signature_parameters(value: Analysis, fact: tast::CallFact, types: Vec[tast::Type]) -> Vec[
    string,
] {
    let is_method = method_call_target(fact.target);
    let type_start = if is_method && types.len() > fact.argument_spans.len() {
        1
    } else {
        0
    };
    let names = signature_parameter_names(value, fact);
    let name_start = match names {
        Some(values) => if is_method && values.len() > fact.argument_spans.len() {
            1
        } else {
            0
        },
        None => 0,
    };
    let result: Vec[string] = Vec::new();
    for index in type_start..types.len() {
        let type_text = tast::diagnostic_type_text(types[index]);
        let name = match names {
            Some(values) => {
                let name_index = index - type_start + name_start;
                if name_index < values.len() {
                    values[name_index]
                } else {
                    ""
                }
            },
            None => "",
        };
        result.push(
            if name == "" {
                type_text
            } else {
                name + ": " + type_text
            },
        )
    }
    result
}

fn active_parameter(fact: tast::CallFact, offset: isize) -> isize {
    let mut active = 0;
    let mut index = 0;
    for span in fact.argument_spans {
        if offset > span.end {
            active = index + 1;
        } else if offset >= span.start {
            active = index;
        }
        index += 1;
    }
    active
}

pub fn signature_help(value: Analysis, offset: isize) -> Option[SignatureResult] {
    let calls = value.checked.typeck_results.calls;
    let mut best = -1;
    for candidate in 0..calls.len() {
        let fact = calls[candidate];
        let fact_width = fact.span.end - fact.span.start;
        if fact.source_path == value.source_path && fact.span.start <= offset
            && offset < fact.span.end
            && (best < 0 || fact_width <= calls[best].span.end - calls[best].span.start) {
            best = candidate;
        }
    }
    match if best >= 0 {
        Option::Some(calls[best])
    } else {
        Option::None
    } {
        Some(fact) => match tast::resolve_type(fact.callee_ty) {
            Func { params, ret_ty } => {
                let parameters = signature_parameters(value, fact, params);
                let return_type = tast::diagnostic_type_text(ret_ty);
                Option::Some(
                    SignatureResult {
                        label: signature_label(parameters, return_type),
                        parameters,
                        active_parameter: active_parameter(fact, offset),
                        span: fact.span,
                    },
                )
            },
            _ => Option::None,
        },
        None => Option::None,
    }
}
