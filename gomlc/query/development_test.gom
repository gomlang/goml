package query;

use module::tast;
use std::fs;
use std::testing;

#[test]
fn development_dependency_navigation_preserves_source_scopes() -> () {
    let root = "/tmp/gomlc-query-development-dependencies";
    let _ = fs::remove_dir_all(root);
    for directory in Vec::from_array(["library/tests", "library/examples/basic", "helper"]) {
        testing::expect_ok(fs::create_dir_all(root + "/" + directory), "create project");
    }
    write_query_fixture(
        root + "/library/goml.toml",
        "[module]\npath = \"demo::library\"\n[dev-dependencies]\n\"demo::helper\" = { path = \"../helper\" }\n",
    );
    write_query_fixture(root + "/helper/goml.toml", "[module]\npath = \"demo::helper\"\n");
    write_query_fixture(
        root + "/helper/helper.gom",
        "package helper; pub fn value() -> isize { 42 }",
    );
    write_query_fixture(
        root + "/library/library.gom",
        "package library; pub fn value() -> isize { 42 }",
    );
    let context = analysis_context();
    for relative in Vec::from_array(["tests/api_test.gom", "examples/basic/main.gom"]) {
        let source = "package main; use demo::helper; fn main() -> () { println(helper::value()) }";
        let file = root + "/library/" + relative;
        write_query_fixture(file, source);
        let analysis = analyze_with_context(context, file, source, Vec::new());
        assert_no_diagnostics(analysis);
        let definitions = goto_definitions(analysis, last_substring(source, "value").unwrap_or(0));
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(definitions[0].source_path, root + "/helper/helper.gom");
    }
    let source = "package library; use demo::helper; pub fn value() -> isize { helper::value() }";
    write_query_fixture(root + "/library/library.gom", source);
    let production = analyze_with_context(
        context,
        root + "/library/library.gom",
        source,
        Vec::new(),
    );
    testing::assert(tast::diagnostics_have_errors(production.checked.diagnostics));
    let test_source = "package library; #[test] fn internal() -> () {}";
    write_query_fixture(root + "/library/library_test.gom", test_source);
    let internal = analyze_with_context(
        context,
        root + "/library/library_test.gom",
        test_source,
        Vec::new(),
    );
    testing::assert(tast::diagnostics_have_errors(internal.checked.diagnostics));
}
