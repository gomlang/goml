package query;

use std::testing;

#[test]
fn moved_filesystem_packages_do_not_resolve_or_complete_as_standard_library() -> () {
    let prefix = "use std::fs::";
    let values = completions(analyze("/tmp/fs-ecosystem-import.gom", prefix), prefix.byte_len());
    testing::assert(!has_completion(values, "notify"));
    testing::assert(!has_completion(values, "walkdir"));
    testing::assert(has_completion(values, "read_dir"));
    for name in Vec::from_array(["notify", "walkdir"]) {
        let source = "use std::fs::" + name + "; fn main() -> () {}";
        let analysis = analyze("/tmp/fs-ecosystem-missing.gom", source);
        testing::assert(!diagnostics(analysis).is_empty());
        for file in analysis.sources {
            testing::assert(file.package_name != "std::fs::" + name);
        }
    }
    assert_no_diagnostics(
        analyze(
            "/tmp/fs-ecosystem-valid.gom",
            "use std::fs; fn main() -> () { let _ = fs::read_dir(\".\"); }",
        ),
    );
}
