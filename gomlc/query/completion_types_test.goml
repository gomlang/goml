package query;

use module::tast;
use std::testing;

#[test]
fn completion_receiver_patterns_preserve_bindings_and_inference_links() -> () {
    let parameter = tast::Type::Param { name: "T" };
    let pattern = tast::Type::Tuple { items: Vec::from_array([parameter, parameter]) };
    testing::assert(
        completion_receiver_matches(
            pattern,
            tast::Type::Tuple { items: Vec::from_array([tast::Type::String, tast::Type::String]) },
            Vec::from_array(["T"]),
        ),
    );
    testing::assert(
        !completion_receiver_matches(
            pattern,
            tast::Type::Tuple { items: Vec::from_array([tast::Type::String, tast::Type::Int]) },
            Vec::from_array(["T"]),
        ),
    );
    let inner = Ref::new(tast::TypeVar::Unbound { id: 91, kind: tast::VarKind::Any });
    let outer = Ref::new(tast::TypeVar::Link(tast::Type::Var(inner)));
    testing::assert(
        completion_receiver_matches(tast::Type::String, tast::Type::Var(outer), Vec::new()),
    );
    match outer.get() {
        Link(Var(_)) => {},
        _ => testing::fail("completion changed an inference link"),
    }
    match inner.get() {
        Unbound { id: 91, kind: Any } => {},
        _ => testing::fail("completion bound an unknown receiver"),
    }
}
