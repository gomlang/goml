package query;

use module::tast;
use module::project_info;
use std::fs;
use std::testing;

#[test]
fn query_resolves_local_dependencies_and_workspace_overrides_without_registry() -> () {
    let root = "/tmp/gomlc-query-local-dependencies";
    let _ = fs::remove_dir_all(root);
    for directory in Vec::from_array(["app", "leaf", "replacement"]) {
        match fs::create_dir_all(root + "/" + directory) {
            Ok(()) => (),
            Err(error) => testing::fail(error.to_string()),
        }
    }
    write_query_fixture(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    write_query_fixture(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    write_query_fixture(root + "/replacement/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    match resolve_external_modules_at(root + "/app", root + "/no-registry") {
        Ok(values) => {
            testing::assert_eq(values.len(), 1);
            testing::assert_eq(values[0].root, root + "/leaf");
        },
        Err(error) => testing::fail(error),
    }
    write_query_fixture(
        root + "/goml.work",
        "[workspace]\nmembers = [\n\"app\",\n\"leaf\",\n]\n[replace]\n\"demo::leaf\" = \"replacement\"\n",
    );
    match resolve_external_modules_at(root + "/app", root + "/no-registry") {
        Ok(values) => testing::assert_eq(values[0].root, root + "/replacement"),
        Err(error) => testing::fail(error),
    }
    write_query_fixture(root + "/replacement/goml.toml", "[module]\npath = \"demo::wrong\"\n");
    testing::assert(resolve_external_modules_at(root + "/app", "").is_err());
}

#[test]
fn local_workspace_navigation_and_cache_follow_replacements_and_source_edits() -> () {
    let root = "/tmp/gomlc-query-workspace-navigation";
    let _ = fs::remove_dir_all(root);
    for directory in Vec::from_array(["app", "leaf", "replacement"]) {
        testing::expect_ok(fs::create_dir_all(root + "/" + directory), "create module");
    }
    write_query_fixture(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = \"0.1.0\"\n",
    );
    for directory in Vec::from_array(["leaf", "replacement"]) {
        write_query_fixture(
            root + "/" + directory + "/goml.toml",
            "[module]\npath = \"demo::leaf\"\n",
        );
        write_query_fixture(
            root + "/" + directory + "/value.goml",
            "package leaf; pub fn value() -> isize { 42 }",
        );
    }
    let workspace = "[workspace]\nmembers = [\"app\", \"leaf\"]\n";
    write_query_fixture(root + "/goml.work", workspace);
    let source = "package main; use demo::leaf; fn main() -> () { let result: isize = leaf::value(); println(result) }";
    let file = root + "/app/main.goml";
    write_query_fixture(file, source);
    let context = analysis_context();
    let offset = last_substring(source, "value").unwrap_or(0);
    let initial = analyze_with_context(context, file, source, Vec::new());
    assert_no_diagnostics(initial);
    let definitions = goto_definitions(initial, offset);
    testing::assert_eq(definitions.len(), 1);
    testing::assert_eq(definitions[0].source_path, root + "/leaf/value.goml");
    write_query_fixture(
        root + "/goml.work",
        workspace + "[replace]\n\"demo::leaf\" = \"replacement\"\n",
    );
    let replaced = analyze_with_context(context, file, source, Vec::new());
    assert_no_diagnostics(replaced);
    let definitions = goto_definitions(replaced, offset);
    testing::assert_eq(definitions.len(), 1);
    testing::assert_eq(definitions[0].source_path, root + "/replacement/value.goml");
    write_query_fixture(
        root + "/replacement/value.goml",
        "package leaf; pub fn value() -> bool { true }",
    );
    testing::assert(
        tast::diagnostics_have_errors(
            diagnostics(analyze_with_context(context, file, source, Vec::new())),
        ),
    );
    let _ = fs::remove_dir_all(root);
}

fn resolve_external_modules_at(root: string, registry: string) -> Result[
    Vec[ResolvedModule],
    string,
] {
    let description = project_info::load_at(
        project_info::new_client(),
        root,
        Option::Some(registry),
    )?.ok_or("missing project")?;
    if let Some(error) = description.error {
        return Result::Err(error)
    }
    let result = Vec::new();
    for module in description.modules {
        if module.name != description.module_path {
            result.push(module);
        }
    }
    Result::Ok(result)
}
