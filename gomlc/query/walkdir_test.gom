package query;

use std::testing;

#[test]
fn resolves_fs_walkdir_source_and_completes_namespaces() -> () {
    let source = "use std::fs::walkdir; fn main() -> () { let _ = walkdir::walk(\".\"); }";
    let analysis = analyze("/tmp/fs-walkdir.gom", source);
    assert_no_diagnostics(analysis);
    let offset = last_substring(source, "walk").unwrap_or(0);
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    match source_by_path(analysis.sources, definitions[0].source_path) {
        Some(target) => {
            testing::assert_eq(target.package_name, "std::fs::walkdir");
            testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "walk",
            )
        },
        None => testing::fail("expected walkdir source"),
    }
    for (prefix, expected) in Vec::from_array(
        [
            ("use std::fs::", "walkdir"),
            ("use std::fs::walkdir::", "walk"),
            ("use std::fs::walkdir::", "WalkDir"),
            ("use std::fs::walkdir::", "WalkIterator"),
            ("use std::fs::walkdir::", "DirEntry"),
            ("use std::fs::walkdir::", "Error"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/fs-walkdir-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}
