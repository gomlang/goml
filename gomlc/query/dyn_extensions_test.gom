package query;

use std::testing;

fn assert_dyn_method_query(
    analysis: Analysis,
    source: string,
    call: string,
    method: string,
    declaration: string,
    parameter: string,
    return_type: string,
) -> () {
    let start = testing::expect_some(last_substring(source, call), "dyn method call");
    let offset = start + testing::expect_some(call.find(method), "method name");
    let expected = testing::expect_some(source.find(declaration), "trait declaration") + 3;
    let definitions = goto_definitions(analysis, offset);
    if definitions.len() != 1 {
        testing::fail(f"{call}: expected one trait method definition, found {definitions.len()}")
    }
    testing::assert_eq(definitions[0].source_path, "main.gom");
    testing::assert_eq(definitions[0].span.start, expected);
    let signature = testing::expect_some(
        signature_help(analysis, start + call.byte_len()),
        "dyn method signature",
    );
    testing::assert(signature.label.contains(parameter));
    let information = testing::expect_some(hover(analysis, offset), "dyn method hover");
    testing::assert(information.contents.ends_with("-> " + return_type))
}

#[test]
fn dyn_extensions_navigate_composite_methods_to_declaring_traits() -> () {
    let source = "trait A { fn alpha(self, from_a: isize) -> isize; fn select(self, selected_a: isize) -> isize; } trait B[T] { fn beta(self, from_b: T) -> T; fn select(self, selected_b: T) -> T; } struct Item {} impl A for Item { fn alpha(self, value: isize) -> isize { value } fn select(self, value: isize) -> isize { value } } impl B[string] for Item { fn beta(self, value: string) -> string { value } fn select(self, value: string) -> string { value } } fn main() -> () { let value = Item {} as dyn B[string] + A; let _ = value.alpha(1); let _ = value.beta(\"hello\"); let _ = A::select(value, 2); let _ = B::[string]::select(value, \"world\"); }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    for expected in Vec::from_array(
        [
            ("value.alpha(", "alpha", "fn alpha(self, from_a:", "from_a: isize", "isize"),
            ("value.beta(", "beta", "fn beta(self, from_b:", "from_b: string", "string"),
            ("A::select(", "select", "fn select(self, selected_a:", "selected_a: isize", "isize"),
            (
                "B::[string]::select(",
                "select",
                "fn select(self, selected_b:",
                "selected_b: string",
                "string",
            ),
        ],
    ) {
        assert_dyn_method_query(
            analysis,
            source,
            expected.0,
            expected.1,
            expected.2,
            expected.3,
            expected.4,
        )
    }
    for expected in Vec::from_array(
        [("A::select(", "trait A"), ("B::[string]::select(", "trait B")],
    ) {
        let offset = testing::expect_some(last_substring(source, expected.0), "trait qualifier");
        let declaration = testing::expect_some(source.find(expected.1), "trait declaration") + 6;
        let definitions = goto_definitions(analysis, offset);
        testing::assert_eq(definitions.len(), 1);
        testing::assert_eq(definitions[0].span.start, declaration)
    }
}

#[test]
fn dyn_extensions_navigate_generic_supertrait_methods() -> () {
    let source = "trait ZParent[T] { fn parent(self, inherited: T) -> T; } trait AChild[T]: ZParent[T] {} struct Item {} impl ZParent[string] for Item { fn parent(self, value: string) -> string { value } } impl AChild[string] for Item {} fn main() -> () { let value = Item {} as dyn AChild[string]; let _ = value.parent(\"hello\"); }";
    let analysis = analyze("main.gom", source);
    assert_no_diagnostics(analysis);
    assert_dyn_method_query(
        analysis,
        source,
        "value.parent(",
        "parent",
        "fn parent(self, inherited:",
        "inherited: string",
        "string",
    )
}
