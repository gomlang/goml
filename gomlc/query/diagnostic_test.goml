package query;

use std::fs;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn exercise_structured_diagnostic_parity(root: string) -> Result[(), string] {
    fs::create_dir_all(root + "/operations").map_err(|error| error.to_string())?;
    fs::create_dir_all(root + "/client").map_err(|error| error.to_string())?;
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::query\"\n");
    let operations = root + "/operations/main.goml";
    write_query_fixture(
        operations,
        "package operations; pub fn run() -> Result[i32, string] { Ok(1) }",
    );
    let api = root + "/operations-api";
    assert_parity_success(
        parity_cli_check(root, "example::query::operations", operations, api, Vec::new())?,
    );
    let file = root + "/client/main.goml";
    let source = "package client; use module::operations; pub fn inspect() -> Result[i32, i32] { Ok(operations::run()?) }";
    write_query_fixture(file, source);
    let context = analysis_context();
    for _ in 0..2 {
        let values = diagnostics(analyze_with_context(context, file, source, Vec::new()));
        testing::assert_eq(values.len(), 1);
        let value = values[0];
        testing::assert(value.code == Option::Some("try_error_mismatch"));
        let span = testing::expect_some(value.span, "expected propagation location");
        testing::assert_eq(source.byte_slice(span.start, span.end), "?");
        let label = value.secondary_labels[0];
        testing::assert_eq(source.byte_slice(label.span.start, label.span.end), "Result");
        testing::assert(value.help[0].contains("map_err"));
    }
    let result = parity_cli_check(
        root,
        "example::query::client",
        file,
        root + "/client-api",
        Vec::from_array([api + ".interface"]),
    )?;
    testing::assert(!result.status().success());
    let stderr = result.stderr().to_string_utf8().unwrap_or("");
    testing::assert(stderr.contains("error[typer/try_error_mismatch]"));
    testing::assert(stderr.contains("secondary: " + file));
    testing::assert(stderr.contains("map_err"));
    let fixed = source.replace("operations::run()?", "operations::run().map_err(|_| 1)?");
    assert_no_diagnostics(analyze_with_context(context, file, fixed, Vec::new()));
    write_query_fixture(file, fixed);
    assert_parity_success(
        parity_cli_check(
            root,
            "example::query::client",
            file,
            root + "/client-api",
            Vec::from_array([api + ".interface"]),
        )?,
    );
    Result::Ok(())
}

#[test]
fn structured_diagnostic_query_and_cli_agree_across_packages() -> () {
    let root = "/tmp/goml-structured-diagnostic-parity";
    let result = exercise_structured_diagnostic_parity(root);
    let _ = fs::remove_dir_all(root);
    if let Err(error) = result {
        testing::fail(error)
    }
}
