package query;

use module::cst;
use module::lexer;

pub struct SyntaxNode {
    pub id: isize,
    pub parent: Option[isize],
    pub kind: cst::NodeKind,
    pub start: isize,
    pub end: isize,
}

pub struct SyntaxToken {
    pub parent: isize,
    pub kind: lexer::TokenKind,
    pub text: string,
    pub start: isize,
    pub end: isize,
}

pub struct SyntaxIndex {
    pub nodes: Vec[SyntaxNode],
    pub tokens: Vec[SyntaxToken],
}

fn index_node(
    value: cst::CstNode,
    parent: Option[isize],
    start: isize,
    nodes: Vec[SyntaxNode],
    tokens: Vec[SyntaxToken],
) -> isize {
    let id = nodes.len();
    let end = start + value.byte_len;
    nodes.push(SyntaxNode { id, parent, kind: value.kind, start, end });
    let mut cursor = start;
    for child in value.children {
        match child {
            Node(node) => {
                cursor = index_node(node, Option::Some(id), cursor, nodes, tokens);
            },
            Token(token) => {
                let token_end = cursor + token.text.byte_len();
                tokens.push(
                    SyntaxToken {
                        parent: id,
                        kind: token.kind,
                        text: token.text,
                        start: cursor,
                        end: token_end,
                    },
                );
                cursor = token_end;
            },
        }
    }
    end
}

pub fn syntax_index(root: cst::CstNode) -> SyntaxIndex {
    let nodes: Vec[SyntaxNode] = Vec::new();
    let tokens: Vec[SyntaxToken] = Vec::new();
    let _ = index_node(root, Option::None, 0, nodes, tokens);
    SyntaxIndex { nodes, tokens }
}

pub fn token_index_at_or_after(index: SyntaxIndex, offset: isize) -> isize {
    let mut low = 0;
    let mut high = index.tokens.len();
    while low < high {
        let middle = low + (high - low) / 2;
        if index.tokens[middle].start < offset {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    low
}

pub fn token_index_before(index: SyntaxIndex, offset: isize) -> isize {
    let mut low = 0;
    let mut high = index.tokens.len();
    while low < high {
        let middle = low + (high - low) / 2;
        if index.tokens[middle].end <= offset {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    low - 1
}

fn contains_offset(start: isize, end: isize, offset: isize) -> bool {
    start <= offset && (offset < end || (start == end && offset == start))
}

pub fn token_at(index: SyntaxIndex, offset: isize) -> Option[SyntaxToken] {
    let mut low = 0;
    let mut high = index.tokens.len();
    while low < high {
        let middle = low + (high - low) / 2;
        if index.tokens[middle].start <= offset {
            low = middle + 1;
        } else {
            high = middle;
        }
    }
    let mut cursor = low - 1;
    while cursor >= 0 {
        let token = index.tokens[cursor];
        if contains_offset(token.start, token.end, offset) && !lexer::token_is_trivia(token.kind) {
            return Option::Some(token)
        } else if token.end < offset || (token.end == offset && token.start < offset) {
            return Option::None
        } else {
            cursor -= 1;
        }
    }
    Option::None
}

pub fn node_at(index: SyntaxIndex, offset: isize) -> Option[SyntaxNode] {
    let mut best = -1;
    for candidate in 0..index.nodes.len() {
        let node = index.nodes[candidate];
        let node_width = node.end - node.start;
        if contains_offset(node.start, node.end, offset)
            && (best < 0 || node_width <= index.nodes[best].end - index.nodes[best].start) {
            best = candidate;
        }
    }
    if best >= 0 {
        Option::Some(index.nodes[best])
    } else {
        Option::None
    }
}

pub fn node_at_kind(index: SyntaxIndex, offset: isize, kind: cst::NodeKind) -> Option[SyntaxNode] {
    let mut current = node_at(index, offset);
    while current.is_some() {
        if let Some(node) = current {
            if cst::node_kind_equal(node.kind, kind) {
                return Option::Some(node)
            } else {
                current = parent_node(index, node);
            }
        }
    }
    Option::None
}

pub fn parent_node(index: SyntaxIndex, node: SyntaxNode) -> Option[SyntaxNode] {
    match node.parent {
        Some(parent) => if parent >= 0 && parent < index.nodes.len() {
            Option::Some(index.nodes[parent])
        } else {
            Option::None
        },
        None => Option::None,
    }
}
