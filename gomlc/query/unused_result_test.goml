package query;

use std::fs;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn exercise_unused_result_query_cli_parity(root: string) -> Result[(), string] {
    fs::create_dir_all(root + "/operations").map_err(|error| error.to_string())?;
    fs::create_dir_all(root + "/client").map_err(|error| error.to_string())?;
    write_query_fixture(root + "/goml.toml", "[module]\npath = \"example::query\"\n");
    let operations = root + "/operations/main.goml";
    write_query_fixture(
        operations,
        "package operations; pub type Outcome[T] = Result[T, string]; pub fn run[T](value: T) -> Outcome[T] { Ok(value) }",
    );
    let api = root + "/operations-api";
    assert_parity_success(
        parity_cli_check(root, "example::query::operations", operations, api, Vec::new())?,
    );
    let file = root + "/client/main.goml";
    let source = "package client; use module::operations; pub fn inspect() -> () { operations::run(1); }";
    write_query_fixture(file, source);
    let context = analysis_context();
    for _ in 0..2 {
        let analysis = analyze_with_context(context, file, source, Vec::new());
        let values = diagnostics(analysis);
        testing::assert_eq(values.len(), 1);
        testing::assert(values[0].code == Option::Some("unused_result"));
        let span = testing::expect_some(values[0].span, "expected discarded Result span");
        testing::assert_eq(source.byte_slice(span.start, span.end), "operations::run(1)");
        testing::assert_eq(values[0].source_path, file);
    }
    let result = parity_cli_check(
        root,
        "example::query::client",
        file,
        root + "/client-api",
        Vec::from_array([api + ".interface"]),
    )?;
    assert_parity_success(result);
    let stderr = result.stderr().to_string_utf8().unwrap_or("");
    testing::assert(stderr.contains("typer/unused_result]"));
    testing::assert(stderr.contains("let _ = ..."));
    testing::assert(fs::is_file(root + "/client-api.interface"));
    let ignored = source.replace("operations::run(1);", "let _ = operations::run(1);");
    assert_no_diagnostics(analyze_with_context(context, file, ignored, Vec::new()));
    write_query_fixture(file, ignored);
    let result = parity_cli_check(
        root,
        "example::query::client",
        file,
        root + "/client-api",
        Vec::from_array([api + ".interface"]),
    )?;
    assert_parity_success(result);
    testing::assert(
        !result.stderr().to_string_utf8().unwrap_or("").contains("typer/unused_result]"),
    );
    Result::Ok(())
}

#[test]
fn unused_result_query_and_cli_agree_across_package_interfaces() -> () {
    let root = "/tmp/goml-unused-result-query-cli";
    let result = exercise_unused_result_query_cli_parity(root);
    let _ = fs::remove_dir_all(root);
    if let Err(error) = result {
        testing::fail(error)
    }
}
