package query;

use module::ast;
use module::ctir;
use module::hir;
use module::parser;
use module::resources;
use module::tast;

fn builtin_navigation_sources() -> Result[Vec[SourceFile], string] {
    let result: Vec[SourceFile] = Vec::new();
    for value in resources::builtin_layer_sources()? {
        result.push(SourceFile { path: value.path, source: value.source, package_name: "builtin" })
    }
    Result::Ok(result)
}

fn builtin_hir_files() -> Result[Vec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in resources::builtin_layer_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "builtin") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower builtin source " + lowered.source_path),
        }
    }
    Result::Ok(files)
}

fn builtin_comptime_module() -> Result[Option[ctir::CtModule], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in resources::builtin_layer_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "builtin") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Result::Err("failed to lower builtin source " + lowered.source_path),
        }
    }
    let checked = tast::check_builtin_package_files(files);
    if checked.tast.is_none() {
        return Result::Err("failed to typecheck builtin package")
    }
    let module = ctir::public_module(checked.comptime, Vec::new(), Vec::new());
    if module.derive_entries.is_empty() {
        Result::Ok(Option::None)
    } else {
        Result::Ok(Option::Some(module))
    }
}
