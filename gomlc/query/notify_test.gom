package query;

use std::testing;

#[test]
fn resolves_fs_notify_source_and_completes_namespaces() -> () {
    let source = "use std::fs::notify; fn main() -> () { let _ = notify::watch_recursive(\".\"); }";
    let analysis = analyze("/tmp/fs-notify.gom", source);
    assert_no_diagnostics(analysis);
    let offset = last_substring(source, "watch_recursive").unwrap_or(0);
    let definitions = goto_definitions(analysis, offset);
    testing::assert_eq(definitions.len(), 1);
    match source_by_path(analysis.sources, definitions[0].source_path) {
        Some(target) => {
            testing::assert_eq(target.package_name, "std::fs::notify");
            testing::assert_eq(
                target.source.byte_slice(definitions[0].span.start, definitions[0].span.end),
                "watch_recursive",
            )
        },
        None => testing::fail("expected notify source"),
    }
    for (prefix, expected) in Vec::from_array(
        [
            ("use std::fs::", "notify"),
            ("use std::fs::notify::", "watch_recursive"),
            ("use std::fs::notify::", "watch_with"),
            ("use std::fs::notify::", "WatchSet"),
            ("use std::fs::notify::", "Options"),
            ("use std::fs::notify::", "Subscription"),
        ],
    ) {
        testing::assert(
            has_completion(
                completions(analyze("/tmp/fs-notify-import.gom", prefix), prefix.byte_len()),
                expected,
            ),
        );
    }
}
