package test_support;

use std::env;
use std::path;
use std::process;

pub fn compiler_path() -> Result[string, string] {
    path::absolute_structured(
        env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc"),
    ).map_err(|error| error.to_string())
}

pub fn compiler_command(arguments: Vec[string]) -> Result[process::Command, string] {
    let command = process::Command::new(compiler_path()?).args(arguments);
    for argument in arguments {
        if argument == "--world" || argument.starts_with("--world=") {
            return Result::Ok(command)
        }
    }
    if let Ok(world) = env::var_structured("GOML_TEST_COMPILER_WORLD") {
        let world = path::absolute_structured(world).map_err(|error| error.to_string())?;
        return Result::Ok(command.arg("--world").arg(world))
    }
    Result::Ok(command)
}
