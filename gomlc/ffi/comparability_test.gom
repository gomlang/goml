package ffi;

use std::testing;

#[test]
fn external_comparability_preserves_unknowns_and_checks_private_fields() -> () {
    let nodes = "[{\"id\":\"int\",\"tag\":\"basic\",\"name\":\"int64\"},{\"id\":\"slice\",\"tag\":\"slice\",\"element\":\"int\"},{\"id\":\"pointer\",\"tag\":\"pointer\",\"element\":\"slice\"},{\"id\":\"parameter\",\"tag\":\"type_parameter\",\"name\":\"T\"},{\"id\":\"unknown\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Value\",\"type\":\"parameter\"}]},{\"id\":\"bad\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Value\",\"type\":\"parameter\"},{\"name\":\"hidden\",\"type\":\"slice\"}]},{\"id\":\"alias\",\"tag\":\"alias\",\"underlying\":\"bad\"},{\"id\":\"cycle\",\"tag\":\"struct\",\"fields\":[{\"name\":\"bad\",\"type\":\"cycle\"}]}]";
    for (root, expected) in Vec::from_array(
        [
            ("int", Option::Some(true)),
            ("pointer", Option::Some(true)),
            ("slice", Option::Some(false)),
            ("unknown", Option::None),
            ("bad", Option::Some(false)),
            ("alias", Option::Some(false)),
        ],
    ) {
        match go_type_comparability(identity_fixture(nodes, root, "defined"), "test") {
            Ok(value) => testing::assert(value == expected),
            Err(error) => testing::fail(error),
        }
    }
    testing::assert(
        go_type_comparability(identity_fixture(nodes, "cycle", "defined"), "test").is_err(),
    );
    testing::assert(
        go_type_comparability(identity_fixture(nodes, "missing", "defined"), "test").is_err(),
    );
}

#[test]
fn comparability_rules_preserve_parameter_indices_and_pointer_independence() -> () {
    let nodes = "[{\"id\":\"root\",\"tag\":\"named\",\"underlying\":\"body\",\"type_parameters\":[\"a\",\"b\"]},{\"id\":\"body\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Value\",\"type\":\"b\"},{\"name\":\"Pointer\",\"type\":\"pointer\"}]},{\"id\":\"a\",\"tag\":\"type_parameter\",\"name\":\"A\"},{\"id\":\"b\",\"tag\":\"type_parameter\",\"name\":\"B\"},{\"id\":\"pointer\",\"tag\":\"pointer\",\"element\":\"a\"}]";
    match go_type_comparability_rule(identity_fixture(nodes, "root", "defined"), "test") {
        Ok(GoComparability::All(outer)) => {
            testing::assert_eq(outer.len(), 1);
            match outer[0] {
                All(fields) => {
                    testing::assert_eq(fields.len(), 2);
                    testing::assert(
                        match fields[0] {
                            Parameter(index) => index == 1,
                            _ => false,
                        },
                    );
                    testing::assert(
                        match fields[1] {
                            Always => true,
                            _ => false,
                        },
                    );
                },
                _ => testing::fail("expected struct comparability rules"),
            }
        },
        _ => testing::fail("expected named comparability rule"),
    }
}
