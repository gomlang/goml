package ffi;

use std::json;
use std::testing;

#[test]
fn function_bridge_preserves_signature_boundaries_and_budgets() -> () {
    let integer = BridgeType::Scalar("int64");
    let empty = BridgeType::Function { parameters: Vec::new(), results: Vec::new() };
    let callback = BridgeType::Function {
        parameters: Vec::from_array([integer]),
        results: Vec::from_array([integer, empty]),
    };
    let reordered = BridgeType::Function {
        parameters: Vec::from_array([integer, integer]),
        results: Vec::from_array([empty]),
    };
    testing::assert(!bridge_types_equal(callback, reordered));
    let identity = instance_argument_identity(callback, 0, Ref::new(65536)).unwrap_or_else(
        |error| {
            testing::fail(error);
            GoTypeIdentity::Basic("invalid")
        },
    );
    let other = instance_argument_identity(reordered, 0, Ref::new(65536)).unwrap_or_else(
        |error| {
            testing::fail(error);
            GoTypeIdentity::Basic("invalid")
        },
    );
    testing::assert_ne(go_type_identity_key(identity), go_type_identity_key(other));
    for value in Vec::from_array([empty, callback, reordered]) {
        match decode_instance_argument(bridge_type_json(value), 0, Ref::new(65536)) {
            Ok(restored) => testing::assert(bridge_types_equal(value, restored)),
            Err(error) => testing::fail(error),
        }
    }
    testing::assert(instance_argument_identity(callback, 0, Ref::new(2)).is_err());
    testing::assert(decode_instance_argument(bridge_type_json(callback), 0, Ref::new(2)).is_err());
    for source in Vec::from_array(
        [
            "{\"tag\":\"function\"}",
            "{\"tag\":\"function\",\"signature\":{\"parameters\":[],\"results\":[],\"variadic\":true}}",
            "{\"tag\":\"function\",\"signature\":{\"parameters\":[]}}",
            "{\"tag\":\"function\",\"signature\":{\"results\":[]}}",
            "{\"tag\":\"function\",\"signature\":{\"parameters\":null,\"results\":[]}}",
            "{\"tag\":\"function\",\"signature\":{\"parameters\":[{\"tag\":\"any\"}],\"results\":[]}}",
        ],
    ) {
        match json::parse(source) {
            Ok(value) => if decode_instance_argument(value, 0, Ref::new(65536)).is_ok() {
                testing::fail("accepted malformed function signature: " + source)
            },
            Err(error) => testing::fail(error),
        }
    }
}

#[test]
fn function_identity_normalizes_metadata_and_substitutes_parameters() -> () {
    let metadata = identity_fixture(
        "[{\"id\":\"a\",\"tag\":\"alias\",\"underlying\":\"f\",\"type_parameters\":[\"p\"]},{\"id\":\"p\",\"tag\":\"type_parameter\",\"constraint\":\"c\"},{\"id\":\"f\",\"tag\":\"signature\",\"parameters\":[\"p\"],\"results\":[\"p\",\"e\"]},{\"id\":\"e\",\"tag\":\"signature\"}]",
        "a",
        "alias",
    );
    let template = identity_template(metadata);
    let integer = GoTypeIdentity::Basic("int64");
    match substitute_go_type_template(template, Vec::from_array([integer])) {
        Ok(value) => testing::assert_eq(
            go_type_identity_key(value),
            go_type_identity_key(
                GoTypeIdentity::Function {
                    parameters: Vec::from_array([integer]),
                    results: Vec::from_array(
                        [
                            integer,
                            GoTypeIdentity::Function { parameters: Vec::new(), results: Vec::new() },
                        ],
                    ),
                },
            ),
        ),
        Err(error) => testing::fail(error),
    }
    testing::assert(substitute_go_type_template(template, Vec::new()).is_err());
    for source in Vec::from_array(
        [
            "[{\"id\":\"f\",\"tag\":\"signature\",\"variadic\":true}]",
            "[{\"id\":\"f\",\"tag\":\"signature\",\"parameters\":[\"missing\"]}]",
            "[{\"id\":\"f\",\"tag\":\"signature\",\"results\":[\"f\"]}]",
        ],
    ) {
        testing::assert(
            resolve_go_type_template(identity_fixture(source, "f", "alias"), "test").is_err(),
        );
    }
}
