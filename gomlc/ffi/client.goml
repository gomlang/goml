package ffi;

use std::bytes;
use std::fs;
use std::json;
use std::path;
use std::process;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

pub fn run_foreign_type_declarations(
    helper: string,
    context: GoBuildContext,
    caller: CallerContext,
    queries: Vec[TypeDeclarationQuery],
) -> Result[TypeDeclarations, string] {
    if queries.is_empty() {
        return Result::Ok(
            TypeDeclarations {
                go_world_identity: "",
                declarations: Vec::new(),
                nodes: HashMap::new(),
            },
        )
    }
    let input = encode_type_declarations(context, caller, queries)?;
    let output = process::Command::new(helper).arg("--timeout=2m").current_dir(context.module_dir).input(
        bytes::Bytes::from_string(input),
    ).output_timeout_structured(time::Duration::from_milliseconds(125000)).map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    if output.stdout().len() > 8388608 || output.stderr().len() > 8388608 {
        return Result::Err("ffi-protocol: helper type output exceeds limit")
    }
    let response = output.stdout().to_string_utf8().map_err(
        |_| "ffi-protocol: invalid UTF-8 type response",
    )?;
    if response == "" {
        return Result::Err("ffi-tool-unavailable: helper returned no type response")
    }
    let result = decode_type_declarations(response, queries)?;
    if !output.status().success() {
        return Result::Err("ffi-protocol: type success with failing helper status")
    }
    Result::Ok(result)
}

pub fn run_foreign_type_instances(
    helper: string,
    context: GoBuildContext,
    caller: CallerContext,
    queries: Vec[TypeInstanceQuery],
    overlay: Option[SourceOverlay],
) -> Result[TypeInstances, string] {
    let input = with_source_overlay(encode_type_instances(context, caller, queries)?, overlay)?;
    let output = process::Command::new(helper).arg("--timeout=2m").current_dir(context.module_dir).input(
        bytes::Bytes::from_string(input),
    ).output_timeout_structured(time::Duration::from_milliseconds(125000)).map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    if output.stdout().len() > 8388608 || output.stderr().len() > 8388608 {
        return Result::Err("ffi-protocol: helper instance output exceeds limit")
    }
    let response = output.stdout().to_string_utf8().map_err(
        |_| "ffi-protocol: invalid UTF-8 instance response",
    )?;
    let result = decode_type_instances(response, queries)?;
    if !output.status().success() {
        return Result::Err("ffi-protocol: instance success with failing helper status")
    }
    Result::Ok(result)
}

pub fn foreign_type_context_directory(directory: string) -> string {
    let mut current = directory;
    while true {
        if fs::is_file(path::join(current, "go.mod")) {
            return current
        }
        match path::parent(current) {
            Some(parent) => {
                if parent == current || parent == "" {
                    return directory
                }
                current = parent;
            },
            None => return directory,
        }
    }
    directory
}

pub fn resolve_foreign_build_context(go_program: string, module_dir: string) -> Result[
    GoBuildContext,
    string,
] {
    let go_executable = process::look_path_structured(go_program).map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    let go_executable = path::absolute_structured(go_executable).map_err(|error| error.to_string())?;
    let module_dir = fs::canonicalize(module_dir).map_err(|error| error.to_string())?;
    let module_mode = if fs::is_file(path::join(module_dir, "go.mod")) {
        "on"
    } else {
        "off"
    };
    let output = process::Command::new(go_executable).args(
        Vec::from_array(["env", "-json", "GOVERSION", "GOOS", "GOARCH", "CGO_ENABLED", "GOFLAGS"]),
    ).current_dir(module_dir).env("GOWORK", "off").env("GO111MODULE", module_mode).env(
        "GOTOOLCHAIN",
        "local",
    ).output_timeout_structured(time::Duration::from_milliseconds(30000)).map_err(
        |error| "ffi-tool-unavailable: " + error.to_string(),
    )?;
    if !output.status().success() {
        return Result::Err("ffi-tool-unavailable: could not resolve Go build context")
    }
    let stdout = output.stdout().to_string_utf8().map_err(
        |_| "ffi-protocol: invalid Go environment encoding",
    )?;
    let value = json::parse(stdout).map_err(|message| "ffi-protocol: " + message)?;
    Result::Ok(
        GoBuildContext {
            go_executable,
            toolchain: foreign_go_env_string(value, "GOVERSION")?,
            module_dir,
            goos: foreign_go_env_string(value, "GOOS")?,
            goarch: foreign_go_env_string(value, "GOARCH")?,
            cgo_enabled: foreign_go_env_string(value, "CGO_ENABLED")?,
            goflags: foreign_go_env_string(value, "GOFLAGS")?,
            build_tags: Vec::new(),
            go111module: module_mode,
            gowork: "off",
            dependencies: "readonly",
            network: "off",
        },
    )
}

pub fn foreign_go_env_string(value: json::Value, name: string) -> Result[string, string] {
    match json::field(value, name) {
        Some(value) => json::as_string(value).ok_or(
            "ffi-protocol: invalid Go environment field " + name,
        ),
        None => Result::Err("ffi-protocol: missing Go environment field " + name),
    }
}
