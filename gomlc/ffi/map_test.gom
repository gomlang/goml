package ffi;

use std::json;
use std::testing;

#[test]
fn map_bridge_preserves_key_and_element_identity() -> () {
    let key = BridgeType::Scalar("string");
    let element = BridgeType::Pointer {
        element: BridgeType::Named { import_path: "os", name: "File", arguments: Vec::new() },
    };
    let map_type = BridgeType::Map { key, element };
    testing::assert(!bridge_types_equal(map_type, BridgeType::Map { key: element, element: key }));
    testing::assert(!bridge_types_equal(map_type, BridgeType::Slice { element }));
    for value in Vec::from_array([map_type, BridgeType::Map { key, element: map_type }]) {
        match decode_instance_argument(bridge_type_json(value), 0, Ref::new(65536)) {
            Ok(decoded) => testing::assert(bridge_types_equal(decoded, value)),
            Err(error) => testing::fail(error),
        }
        testing::assert(instance_argument_identity(value, 0, Ref::new(65536)).is_ok());
    }
    match instance_argument_identity(map_type, 0, Ref::new(65536)) {
        Ok(GoTypeIdentity::Map {
            key: GoTypeIdentity::Basic(name),
            element: GoTypeIdentity::Pointer(_),
        }) => testing::assert_eq(name, "string"),
        _ => testing::fail("expected map identity"),
    }
    testing::assert(instance_argument_identity(map_type, 0, Ref::new(2)).is_err());
    testing::assert(decode_instance_argument(bridge_type_json(map_type), 0, Ref::new(2)).is_err());
    for text in Vec::from_array(
        [
            "{\"tag\":\"map\",\"element\":{\"tag\":\"int64\"}}",
            "{\"tag\":\"map\",\"key\":{\"tag\":\"string\"}}",
            "{\"tag\":\"map\",\"key\":{\"tag\":\"any\"},\"element\":{\"tag\":\"int64\"}}",
        ],
    ) {
        match json::parse(text) {
            Ok(value) => testing::assert(
                decode_instance_argument(value, 0, Ref::new(65536)).is_err(),
            ),
            Err(_) => testing::fail("invalid test JSON"),
        }
    }
}
