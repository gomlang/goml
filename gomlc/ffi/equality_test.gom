package ffi;

use std::testing;

fn equality_binding(id: string, ty: BridgeType) -> ForeignBinding {
    ForeignBinding {
        call_mode: ForeignCallMode::Ordinary,
        binding_id: id,
        import_path: "example.com/shim",
        symbol: "Value",
        parameters: Vec::from_array([ty]),
        results: Vec::new(),
    }
}

#[test]
fn merge_bindings_preserves_declaration_identity_and_rejects_conflicts() -> () {
    let first = equality_binding("first", BridgeType::Scalar("int64"));
    let second = equality_binding("second", BridgeType::Scalar("int64"));
    match merge_bindings(Vec::from_array([first]), Vec::from_array([first, second])) {
        Ok(result) => {
            testing::assert_eq(result.len(), 2);
            testing::assert_eq(result[0].binding_id, "first");
            testing::assert_eq(result[1].binding_id, "second")
        },
        Err(message) => testing::fail(message),
    }
    let conflict = equality_binding("first", BridgeType::Scalar("string"));
    testing::assert(merge_bindings(Vec::from_array([first]), Vec::from_array([conflict])).is_err());
    testing::assert_eq(Vec::from_array([first]).len(), 1)
}

#[test]
fn bridge_type_equality_preserves_array_lengths_and_channel_directions() -> () {
    let scalar = BridgeType::Scalar("uint8");
    let first = BridgeType::Array { element: scalar, length: 2 };
    let second = BridgeType::Array { element: scalar, length: 3 };
    testing::assert(!bridge_types_equal(first, second));
    testing::assert(!bridge_types_equal(first, BridgeType::Slice { element: scalar }));
    let sender = BridgeType::Channel { element: first, direction: "send" };
    let receiver = BridgeType::Channel { element: first, direction: "receive" };
    testing::assert(bridge_types_equal(sender, sender));
    testing::assert(!bridge_types_equal(sender, receiver))
}

#[test]
fn named_bridge_equality_preserves_go_identity_and_arguments() -> () {
    let duration = BridgeType::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    let handle = BridgeType::Named {
        import_path: "unique",
        name: "Handle",
        arguments: Vec::from_array([duration]),
    };
    testing::assert(bridge_types_equal(handle, handle));
    testing::assert(!bridge_types_equal(duration, BridgeType::Scalar("int64")));
    testing::assert(
        !bridge_types_equal(
            handle,
            BridgeType::Named {
                import_path: "unique",
                name: "Handle",
                arguments: Vec::from_array([BridgeType::Scalar("int64")]),
            },
        ),
    );
    testing::assert(
        !bridge_types_equal(
            duration,
            BridgeType::Named { import_path: "other", name: "Duration", arguments: Vec::new() },
        ),
    );
    testing::assert(named_bridge_identity_valid("example.com/host", "Box"));
    for name in Vec::from_array(["", "private", "Bad.Name", "Name[int]", "Name()", "A\nB"]) {
        testing::assert(!named_bridge_identity_valid("host", name))
    }
    for import_path in Vec::from_array(["", "bad path", "host\n", "host\"", "host\\path"]) {
        testing::assert(!named_bridge_identity_valid(import_path, "Box"))
    }
}

#[test]
fn foreign_binding_call_modes_remain_distinct() -> () {
    let ordinary = equality_binding("same", BridgeType::Scalar("int64"));
    let method = ForeignBinding {
        call_mode: ForeignCallMode::Method,
        binding_id: ordinary.binding_id,
        import_path: ordinary.import_path,
        symbol: ordinary.symbol,
        parameters: ordinary.parameters,
        results: ordinary.results,
    };
    testing::assert(!bindings_equal(ordinary, method));
    testing::assert(merge_bindings(Vec::from_array([ordinary]), Vec::from_array([method])).is_err());
    testing::assert(validate_foreign_binding_target(method).is_err());
    testing::assert(parse_foreign_call_mode("spread").is_err())
}
