package ffi;

pub fn bridge_types_equal(left: BridgeType, right: BridgeType) -> bool {
    match (left, right) {
        (Function { parameters: lp, results: lr }, Function { parameters: rp, results: rr }) => bridge_type_lists_equal(
            lp,
            rp,
        )
            && bridge_type_lists_equal(lr, rr),
        (Scalar(left), Scalar(right)) => left == right,
        (
            Named { import_path: left_path, name: left_name, arguments: left_args },
            Named { import_path: right_path, name: right_name, arguments: right_args },
        ) => left_path == right_path && left_name == right_name
            && bridge_type_lists_equal(left_args, right_args),
        (
            Array { element: left, length: left_length },
            Array { element: right, length: right_length },
        ) => left_length == right_length && bridge_types_equal(left, right),
        (Pointer { element: left }, Pointer { element: right }) => bridge_types_equal(left, right),
        (Slice { element: left }, Slice { element: right }) => bridge_types_equal(left, right),
        (Map { key: left_key, element: left }, Map { key: right_key, element: right }) => bridge_types_equal(
            left_key,
            right_key,
        )
            && bridge_types_equal(left, right),
        (
            Channel { element: left, direction: left_direction },
            Channel { element: right, direction: right_direction },
        ) => left_direction == right_direction && bridge_types_equal(left, right),
        _ => false,
    }
}

fn bridge_type_lists_equal(left: Vec[BridgeType], right: Vec[BridgeType]) -> bool {
    if left.len() != right.len() {
        return false
    }
    for index in 0..left.len() {
        if !bridge_types_equal(left[index], right[index]) {
            return false
        }
    }
    true
}
