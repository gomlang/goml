package ffi;

use std::json;
use std::testing;

fn test_binding() -> ForeignBinding {
    ForeignBinding {
        call_mode: ForeignCallMode::Ordinary,
        binding_id: "demo::calc::abs",
        import_path: "math",
        symbol: "Abs",
        parameters: Vec::from_array([BridgeType::Scalar("float64")]),
        results: Vec::from_array([BridgeType::Scalar("float64")]),
    }
}

fn test_response(status: string, diagnostics: json::Value) -> string {
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("protocol_version", json::Value::Number("1")),
                    ("go_world_identity", json::Value::String("world")),
                    ("diagnostics", json::Value::Null),
                    (
                        "referenced_types",
                        json::Value::Array(
                            Vec::from_array(
                                [
                                    json::object(
                                        Vec::from_array(
                                            [
                                                ("id", json::Value::String("t0")),
                                                ("tag", json::Value::String("signature")),
                                            ],
                                        ),
                                    ),
                                ],
                            ),
                        ),
                    ),
                    (
                        "bindings",
                        json::Value::Array(
                            Vec::from_array(
                                [
                                    json::object(
                                        Vec::from_array(
                                            [
                                                (
                                                    "binding_id",
                                                    json::Value::String("demo::calc::abs"),
                                                ),
                                                ("status", json::Value::String(status)),
                                                ("signature_type", json::Value::String("t0")),
                                                (
                                                    "actual_signature",
                                                    json::Value::String("func(float64) float64"),
                                                ),
                                                ("diagnostics", diagnostics),
                                            ],
                                        ),
                                    ),
                                ],
                            ),
                        ),
                    ),
                ],
            ),
        ),
    )
}

#[test]
fn validates_response_status_and_completeness() -> () {
    let expected = Vec::from_array([test_binding()]);
    let response = test_response("verified", json::Value::Null);
    match decode_verification(response, expected) {
        Ok(Verification::Verified { go_world_identity }) => testing::assert_eq(
            go_world_identity,
            "world",
        ),
        _ => testing::fail("valid response rejected"),
    }
    testing::assert(decode_verification(response, Vec::new()).is_err());
    testing::assert(decode_verification(test_response("off", json::Value::Null), expected).is_err());
    testing::assert(
        decode_verification(test_response("failed", json::Value::Null), expected).is_err(),
    );
    testing::assert(decode_verification("{}", expected).is_err());
    testing::assert(decode_verification("{", expected).is_err());
    testing::assert(decode_verification("{\"protocol_version\":99}", expected).is_err());
    testing::assert(
        decode_verification("{\"protocol_version\":1,\"protocol_version\":1}", expected).is_err(),
    )
}

#[test]
fn preserves_binding_identity_in_diagnostics() -> () {
    let diagnostics = json::Value::Array(
        Vec::from_array(
            [
                json::object(
                    Vec::from_array(
                        [
                            ("code", json::Value::String("ffi-signature-mismatch")),
                            ("message", json::Value::String("wrong parameter type")),
                        ],
                    ),
                ),
            ],
        ),
    );
    let expected = Vec::from_array([test_binding()]);
    let locations: HashMap[string, string] = HashMap::new();
    locations["demo::calc::abs"] = "\nprimary: declaration.gom:4:11-4:14";
    match decode_verification_with_locations(
        test_response("failed", diagnostics),
        expected,
        locations,
    ) {
        Err(message) => {
            testing::assert(message.contains("demo::calc::abs"));
            testing::assert(message.contains("ffi-signature-mismatch"));
            testing::assert(message.contains("func(float64) float64"));
            testing::assert(message.contains("primary: declaration.gom:4:11-4:14"))
        },
        _ => testing::fail("failed response accepted"),
    }
    testing::assert(decode_verification(test_response("verified", diagnostics), expected).is_err())
}

#[test]
fn encodes_paths_and_bridge_shapes() -> () {
    let context = GoBuildContext {
        go_executable: "C:\\Program Files\\Go\\bin\\go.exe",
        toolchain: "go1.26.0",
        module_dir: "C:\\host project",
        goos: "windows",
        goarch: "amd64",
        cgo_enabled: "0",
        goflags: "",
        build_tags: Vec::new(),
        go111module: "on",
        gowork: "off",
        dependencies: "readonly",
        network: "off",
    };
    let caller = CallerContext {
        generated_source: Option::None,
        load_mode: "package",
        import_path: "example.com/host/gen",
        directory: "C:\\host project\\gen",
        package_name: "gen",
    };
    let queries = Vec::from_array(
        [TypeDeclarationQuery { type_id: "type", import_path: "time", name: "Duration" }],
    );
    let type_request = encode_type_declarations(context, caller, queries).unwrap_or("");
    testing::assert(type_request.contains("type_queries"));
    testing::assert(type_request.contains("declaration"));
    testing::assert(!type_request.contains("bridge_parameter_types"));
    queries.push(queries[0]);
    testing::assert(encode_type_declarations(context, caller, queries).is_err());
    let encoded = encode_request(context, caller, Vec::from_array([test_binding()]));
    let value = json::parse(encoded).unwrap_or(json::Value::Null);
    let context_value = json::field(value, "build_context").unwrap_or(json::Value::Null);
    testing::assert_eq(
        json::as_string(json::field(context_value, "go_executable").unwrap_or(json::Value::Null)).unwrap_or(
            "",
        ),
        context.go_executable,
    );
    let ty = BridgeType::Channel {
        element: BridgeType::Array { element: BridgeType::Scalar("int32"), length: 2 },
        direction: "receive",
    };
    let shape = bridge_type_json(ty);
    testing::assert_eq(
        json::as_string(json::field(shape, "direction").unwrap_or(json::Value::Null)).unwrap_or(""),
        "receive",
    );
    let array = json::field(shape, "element").unwrap_or(json::Value::Null);
    testing::assert_eq(
        json::as_int(json::field(array, "length").unwrap_or(json::Value::Null)).unwrap_or(-1),
        2,
    )
}
