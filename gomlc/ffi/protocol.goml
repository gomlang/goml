package ffi;

use std::json;

fn strings_json(values: Vec[string]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for value in values {
        result.push(json::Value::String(value))
    }
    json::Value::Array(result)
}

pub fn bridge_type_json(value: BridgeType) -> json::Value {
    match value {
        Function { parameters, results } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("function")),
                    (
                        "signature",
                        json::object(
                            Vec::from_array(
                                [
                                    ("parameters", bridge_types_json(parameters)),
                                    ("results", bridge_types_json(results)),
                                ],
                            ),
                        ),
                    ),
                ],
            ),
        ),
        Named { import_path, name, arguments } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("named")),
                    ("import_path", json::Value::String(import_path)),
                    ("name", json::Value::String(name)),
                    ("type_arguments", bridge_types_json(arguments)),
                ],
            ),
        ),
        Scalar(tag) => json::object(Vec::from_array([("tag", json::Value::String(tag))])),
        Array { element, length } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("array")),
                    ("element", bridge_type_json(element)),
                    ("length", json::Value::Number(length.to_string())),
                ],
            ),
        ),
        Pointer { element } => json::object(
            Vec::from_array(
                [("tag", json::Value::String("pointer")), ("element", bridge_type_json(element))],
            ),
        ),
        Slice { element } => json::object(
            Vec::from_array(
                [("tag", json::Value::String("slice")), ("element", bridge_type_json(element))],
            ),
        ),
        Map { key, element } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("map")),
                    ("key", bridge_type_json(key)),
                    ("element", bridge_type_json(element)),
                ],
            ),
        ),
        Channel { element, direction } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("channel")),
                    ("element", bridge_type_json(element)),
                    ("direction", json::Value::String(direction)),
                ],
            ),
        ),
    }
}

fn bridge_type_values(values: Vec[BridgeType]) -> Vec[json::Value] {
    let result: Vec[json::Value] = Vec::new();
    for value in values {
        result.push(bridge_type_json(value))
    }
    result
}

fn bridge_types_json(values: Vec[BridgeType]) -> json::Value {
    json::Value::Array(bridge_type_values(values))
}

pub fn build_context_json(value: GoBuildContext) -> json::Value {
    json::object(
        Vec::from_array(
            [
                ("go_executable", json::Value::String(value.go_executable)),
                ("toolchain", json::Value::String(value.toolchain)),
                ("module_dir", json::Value::String(value.module_dir)),
                ("goos", json::Value::String(value.goos)),
                ("goarch", json::Value::String(value.goarch)),
                ("cgo_enabled", json::Value::String(value.cgo_enabled)),
                ("goflags", json::Value::String(value.goflags)),
                ("build_tags", strings_json(value.build_tags)),
                ("go111module", json::Value::String(value.go111module)),
                ("gowork", json::Value::String(value.gowork)),
                ("dependencies", json::Value::String(value.dependencies)),
                ("network", json::Value::String(value.network)),
            ],
        ),
    )
}

fn build_context_field(value: json::Value, name: string) -> Result[json::Value, string] {
    match value {
        Object(fields) => {
            let mut result: Option[json::Value] = Option::None;
            for field in fields {
                if field.0 == name {
                    if result.is_some() {
                        return Err("ffi-protocol: duplicate build context field " + name)
                    }
                    result = Option::Some(field.1);
                }
            }
            result.ok_or("ffi-protocol: missing build context field " + name)
        },
        _ => Err("ffi-protocol: expected build context object"),
    }
}

fn build_context_string(value: json::Value, name: string) -> Result[string, string] {
    json::as_string(build_context_field(value, name)?).ok_or(
        "ffi-protocol: expected string " + name,
    )
}

fn build_context_array(value: json::Value, name: string) -> Result[Vec[json::Value], string] {
    match build_context_field(value, name)? {
        Null => Ok(Vec::new()),
        Array(values) => Ok(values),
        _ => Err("ffi-protocol: expected array " + name),
    }
}

fn build_context_json_is_bounded(input: string) -> bool {
    let mut quoted = false;
    let mut escaped = false;
    let mut depth = 0;
    for index in 0..input.byte_len() {
        let byte = input.byte_get(index);
        if quoted {
            if escaped {
                escaped = false;
            } else if byte == b'\\' {
                escaped = true;
            } else if byte == b'"' {
                quoted = false;
            }
        } else if byte == b'"' {
            quoted = true;
        } else if byte == b'{' || byte == b'[' {
            depth += 1;
            if depth > 64 {
                return false
            }
        } else if byte == b'}' || byte == b']' {
            depth -= 1;
            if depth < 0 {
                return false
            }
        }
    }
    depth == 0 && !quoted
}

pub fn decode_build_context(input: string) -> Result[GoBuildContext, string] {
    if input.byte_len() > 8388608 || !build_context_json_is_bounded(input) {
        return Err("ffi-protocol: invalid build context JSON")
    }
    let value = json::parse(input).map_err(|message| "ffi-protocol: " + message)?;
    let tags: Vec[string] = Vec::new();
    for tag in build_context_array(value, "build_tags")? {
        tags.push(json::as_string(tag).ok_or("ffi-protocol: build tag must be a string")?)
    }
    let context = GoBuildContext {
        go_executable: build_context_string(value, "go_executable")?,
        toolchain: build_context_string(value, "toolchain")?,
        module_dir: build_context_string(value, "module_dir")?,
        goos: build_context_string(value, "goos")?,
        goarch: build_context_string(value, "goarch")?,
        cgo_enabled: build_context_string(value, "cgo_enabled")?,
        goflags: build_context_string(value, "goflags")?,
        build_tags: tags,
        go111module: build_context_string(value, "go111module")?,
        gowork: build_context_string(value, "gowork")?,
        dependencies: build_context_string(value, "dependencies")?,
        network: build_context_string(value, "network")?,
    };
    if context.go_executable == "" || context.toolchain == "" || context.module_dir == ""
        || context.goos == ""
        || context.goarch == "" {
        return Err("ffi-protocol: incomplete Go build context")
    }
    if context.gowork != "off" || context.dependencies != "readonly" || context.network != "off"
        || context.cgo_enabled != "0" && context.cgo_enabled != "1"
        || context.go111module != "on" && context.go111module != "off" {
        Err("ffi-protocol: unsupported Go build context policy")
    } else {
        Ok(context)
    }
}
