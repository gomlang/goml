package ffi;

use std::testing;

#[test]
fn type_instances_validate_result_identity_and_require_instance_roots() -> () {
    let queries = Vec::from_array(
        [TypeInstanceQuery { declaration: declaration_queries()[0], arguments: Vec::new() }],
    );
    let nodes = "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"}]";
    let result = "\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\"";
    testing::assert(
        decode_type_instances(
            declaration_response(nodes, "{" + result + ",\"type\":\"n\"}"),
            queries,
        ).is_ok(),
    );
    for suffix in Vec::from_array(
        ["", ",\"type\":\"missing\"", ",\"type\":\"b\"", ",\"type\":\"n\",\"type\":\"b\""],
    ) {
        testing::assert(
            decode_type_instances(declaration_response(nodes, "{" + result + suffix + "}"), queries).is_err(),
        )
    }
    let invalid = Vec::from_array(
        [
            TypeInstanceQuery {
                declaration: declaration_queries()[0],
                arguments: Vec::from_array([BridgeType::Scalar("int64")]),
            },
        ],
    );
    testing::assert(
        decode_type_instances(
            declaration_response(nodes, "{" + result + ",\"type\":\"n\"}"),
            invalid,
        ).is_err(),
    );
}
