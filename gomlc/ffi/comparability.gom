package ffi;

use std::json;

pub enum GoComparability {
    Always,
    Never,
    Parameter(isize),
    All(Vec[GoComparability]),
    Unknown,
}

fn node_comparability(
    metadata: TypeDeclarations,
    id: string,
    parameters: Vec[string],
    active: Vec[string],
    remaining: Ref[isize],
) -> Result[GoComparability, string] {
    if active.len() > 64 || remaining.get() <= 0 {
        return Result::Err("ffi-type: comparability complexity limit exceeded")
    }
    if active.contains(id) {
        return Result::Err("ffi-type: cyclic value type in comparability metadata")
    }
    remaining.set(remaining.get() - 1);
    let node = metadata.nodes[id].ok_or("ffi-type: missing comparability node " + id)?;
    let tag = response_string(node, "tag")?;
    match tag {
        "basic" | "pointer" | "channel" | "interface" => Result::Ok(GoComparability::Always),
        "slice" | "map" | "signature" => Result::Ok(GoComparability::Never),
        "type_parameter" => {
            for index in 0..parameters.len() {
                if parameters[index] == id {
                    return Result::Ok(GoComparability::Parameter(index))
                }
            }
            Result::Ok(GoComparability::Unknown)
        },
        "named" | "alias" | "array" | "struct" => {
            active.push(id);
            let children: Vec[string] = Vec::new();
            if tag == "struct" {
                if let Some(_) = json::field(node, "fields") {
                    for field in response_array(node, "fields")? {
                        children.push(response_string(field, "type")?);
                    }
                }
            } else {
                children.push(
                    response_string(
                        node,
                        if tag == "array" {
                            "element"
                        } else {
                            "underlying"
                        },
                    )?,
                );
            }
            let rules: Vec[GoComparability] = Vec::new();
            for child in children {
                rules.push(node_comparability(metadata, child, parameters, active, remaining)?);
            }
            active.truncate(active.len() - 1);
            Result::Ok(GoComparability::All(rules))
        },
        _ => Result::Err("ffi-type: unsupported comparability node " + tag),
    }
}

pub fn go_type_comparability_rule(metadata: TypeDeclarations, type_id: string) -> Result[
    GoComparability,
    string,
] {
    for declaration in metadata.declarations {
        if declaration.type_id == type_id {
            let node = metadata.nodes[declaration.declared_type].ok_or(
                "ffi-type: missing comparability root",
            )?;
            return node_comparability(
                metadata,
                declaration.declared_type,
                identity_references(node, "type_parameters")?,
                Vec::new(),
                Ref::new(65536),
            )
        }
    }
    Result::Err("ffi-type: missing comparability declaration " + type_id)
}

pub fn known_go_comparability(rule: GoComparability) -> Option[bool] {
    match rule {
        Always => Option::Some(true),
        Never => Option::Some(false),
        Parameter(_) | Unknown => Option::None,
        All(rules) => {
            let mut known = true;
            for rule in rules {
                match known_go_comparability(rule) {
                    Some(false) => return Option::Some(false),
                    Some(true) => (),
                    None => {
                        known = false;
                    },
                }
            }
            if known {
                Option::Some(true)
            } else {
                Option::None
            }
        },
    }
}

pub fn go_type_comparability(metadata: TypeDeclarations, type_id: string) -> Result[
    Option[bool],
    string,
] {
    Result::Ok(known_go_comparability(go_type_comparability_rule(metadata, type_id)?))
}
