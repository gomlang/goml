package ffi;

use std::testing;

fn declaration_queries() -> Vec[TypeDeclarationQuery] {
    Vec::from_array(
        [TypeDeclarationQuery { type_id: "duration", import_path: "time", name: "Duration" }],
    )
}

fn declaration_response(nodes: string, result: string) -> string {
    "{\"protocol_version\":1,\"go_world_identity\":\"world\",\"diagnostics\":[],\"bindings\":[],\"referenced_types\":"
        + nodes
        + ",\"type_results\":["
        + result
        + "]}"
}

#[test]
fn type_declarations_validate_graph_references_and_results() -> () {
    let nodes = "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"}]";
    let result = "{\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\"}";
    let decoded = decode_type_declarations(
        declaration_response(nodes, result),
        declaration_queries(),
    );
    testing::assert(decoded.is_ok());
    for invalid in Vec::from_array(
        [
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"underlying\":\"missing\"}]",
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\"}]",
            "[{\"id\":\"n\",\"tag\":\"unknown\"}]",
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"underlying\":\"n\",\"methods\":[{\"type\":\"missing\"}]}]",
        ],
    ) {
        testing::assert(
            decode_type_declarations(declaration_response(invalid, result), declaration_queries()).is_err(),
        )
    }
    for invalid in Vec::from_array(
        [
            "{\"type_id\":\"other\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\"}",
            "{\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"alias\",\"declared_type\":\"n\"}",
            "{\"type_id\":\"duration\",\"status\":\"failed\"}",
            "{\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\",\"type\":\"n\"}",
        ],
    ) {
        testing::assert(
            decode_type_declarations(declaration_response(nodes, invalid), declaration_queries()).is_err(),
        )
    }
}
