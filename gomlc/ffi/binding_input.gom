package ffi;

use std::json;

pub fn parse_bounded_json(input: string) -> Result[json::Value, string] {
    if input.byte_len() > 8388608 || !response_nesting_is_bounded(input) {
        return Result::Err("ffi-protocol: JSON size or nesting exceeds limit")
    }
    json::parse(input)
}

pub fn decode_bridge_types(values: Vec[json::Value]) -> Result[Vec[BridgeType], string] {
    let remaining = Ref::new(65536);
    let result = Vec::new();
    for value in values {
        result.push(decode_instance_argument(value, 0, remaining)?);
    }
    Result::Ok(result)
}

pub fn bridge_type_identity(value: BridgeType) -> Result[GoTypeIdentity, string] {
    instance_argument_identity(value, 0, Ref::new(65536))
}

pub struct SourceOverlay {
    pub path: string,
    pub source: string,
}

pub fn with_source_overlay(input: string, overlay: Option[SourceOverlay]) -> Result[string, string] {
    let Some(overlay) = overlay else {
        return Result::Ok(input)
    };
    let Object(fields) = parse_bounded_json(input)? else {
        return Result::Err("ffi-protocol: expected request object")
    };
    fields.push(
        (
            "source_overlay",
            json::object(
                Vec::from_array(
                    [
                        ("path", json::Value::String(overlay.path)),
                        ("source", json::Value::String(overlay.source)),
                    ],
                ),
            ),
        ),
    );
    let result = json::encode(json::Value::Object(fields));
    if result.byte_len() > 8388608 {
        return Result::Err("ffi-protocol: source overlay request exceeds limit")
    }
    Result::Ok(result)
}
