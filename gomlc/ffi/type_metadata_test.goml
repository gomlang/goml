package ffi;

use std::json;
use std::testing;

fn exercise_foreign_type_metadata() -> Result[(), string] {
    let nodes = "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"}]";
    let result = "{\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\"}";
    let queries = declaration_queries();
    let declarations = decode_type_declarations(declaration_response(nodes, result), queries)?;
    let encoded = encode_foreign_type_metadata(
        ForeignTypeMetadata { instances: Vec::new(), queries, declarations },
    )?;
    let decoded = decode_foreign_type_metadata(encoded)?;
    testing::assert_eq(decoded.declarations.go_world_identity, "world");
    testing::assert_eq(decoded.queries[0].import_path, "time");
    testing::assert_eq(decoded.queries[0].name, "Duration");
    testing::assert_eq(decoded.declarations.declarations[0].kind, "defined");
    testing::assert_eq(encode_foreign_type_metadata(decoded)?, encoded);
    testing::assert_eq(
        go_type_identity_key(resolve_go_type_template(decoded.declarations, "duration")?.identity),
        go_type_identity_key(resolve_go_type_template(declarations, "duration")?.identity),
    );
    let instance = TypeInstanceQuery { declaration: queries[0], arguments: Vec::new() };
    let with_instance = ForeignTypeMetadata {
        queries,
        declarations,
        instances: Vec::from_array([instance]),
    };
    let restored = decode_foreign_type_metadata(encode_foreign_type_metadata(with_instance)?)?;
    testing::assert_eq(restored.instances.len(), 1);
    testing::assert_eq(restored.instances[0].declaration.type_id, "duration");
    for invalid in Vec::from_array(
        [
            Vec::from_array([instance, instance]),
            Vec::from_array(
                [
                    TypeInstanceQuery {
                        declaration: queries[0],
                        arguments: Vec::from_array([BridgeType::Scalar("int64")]),
                    },
                ],
            ),
            Vec::from_array(
                [
                    TypeInstanceQuery {
                        declaration: TypeDeclarationQuery {
                            type_id: "missing",
                            import_path: "time",
                            name: "Missing",
                        },
                        arguments: Vec::new(),
                    },
                ],
            ),
        ],
    ) {
        testing::assert(
            encode_foreign_type_metadata(
                ForeignTypeMetadata { queries, declarations, instances: invalid },
            ).is_err(),
        )
    }
    let altered = Vec::from_array(
        [
            ("version", json::Value::Number("3")),
            ("queries", json::Value::Array(Vec::new())),
            ("metadata", json::Value::Null),
            ("instances", json::Value::Null),
        ],
    );
    for (field, replacement) in altered {
        let Object(fields) = json::parse(encoded)? else {
            return Result::Err("expected metadata object")
        };
        let updated = Vec::new();
        for (name, value) in fields {
            updated.push(
                (
                    name,
                    if name == field {
                        replacement
                    } else {
                        value
                    },
                ),
            )
        }
        testing::assert(
            decode_foreign_type_metadata(json::encode(json::Value::Object(updated))).is_err(),
        );
    }
    let duplicate_queries = Vec::from_array([queries[0], queries[0]]);
    testing::assert(
        encode_foreign_type_metadata(
            ForeignTypeMetadata { instances: Vec::new(), queries: duplicate_queries, declarations },
        ).is_err(),
    );
    let empty = ForeignTypeMetadata {
        instances: Vec::new(),
        queries: Vec::new(),
        declarations: TypeDeclarations {
            go_world_identity: "",
            declarations: Vec::new(),
            nodes: HashMap::new(),
        },
    };
    testing::assert(decode_foreign_type_metadata(encode_foreign_type_metadata(empty)?).is_ok());
    Result::Ok(())
}

#[test]
fn foreign_type_metadata_roundtrips_provenance_and_validates_envelope() -> () {
    if let Err(error) = exercise_foreign_type_metadata() {
        testing::fail(error)
    }
}
