package ffi;

pub fn named_bridge_identity_valid(import_path: string, name: string) -> bool {
    if import_path == "" && name == "error" {
        return true
    }
    if import_path == "" || name == "" {
        return false
    }
    for index in 0..import_path.byte_len() {
        let value = import_path.byte_get(index);
        if value <= 32 || value == 0x7f || value == 34 || value == 92 {
            return false
        }
    }
    for index in 0..name.byte_len() {
        let value = name.byte_get(index);
        let uppercase = value >= 65 && value <= 90;
        if index == 0 {
            if !uppercase {
                return false
            }
        } else if !uppercase && !(value >= 97 && value <= 122) && !(value >= 48 && value <= 57)
            && value != 95 {
            return false
        }
    }
    true
}
