package ffi;

pub struct ExternalTypeIdentity {
    pub type_id: string,
    pub import_path: string,
    pub name: string,
}

pub enum BridgeType {
    Scalar(string),
    Function {
        parameters: Vec[BridgeType],
        results: Vec[BridgeType],
    },
    Named {
        import_path: string,
        name: string,
        arguments: Vec[BridgeType],
    },
    Array {
        element: BridgeType,
        length: isize,
    },
    Pointer {
        element: BridgeType,
    },
    Slice {
        element: BridgeType,
    },
    Map {
        key: BridgeType,
        element: BridgeType,
    },
    Channel {
        element: BridgeType,
        direction: string,
    },
}

pub struct GoBuildContext {
    pub go_executable: string,
    pub toolchain: string,
    pub module_dir: string,
    pub goos: string,
    pub goarch: string,
    pub cgo_enabled: string,
    pub goflags: string,
    pub build_tags: Vec[string],
    pub go111module: string,
    pub gowork: string,
    pub dependencies: string,
    pub network: string,
}
