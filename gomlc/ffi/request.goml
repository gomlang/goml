package ffi;

use std::json;
use json::Serialize;

#[derive(Serialize)]
struct CallerRequest {
    load_mode: string,
    generated_source: string,
    import_path: string,
    directory: string,
    #[serde(rename = "package")]
    package_name: string,
}

#[derive(Serialize)]
struct BindingRequest {
    binding_id: string,
    import_path: string,
    symbol: string,
    bridge_parameter_types: Vec[json::Value],
    bridge_result_types: Vec[json::Value],
    call_mode: string,
}

#[derive(Serialize)]
struct TypeQueryRequest {
    type_id: string,
    import_path: string,
    name: string,
    query_mode: string,
    #[serde(skip_serializing_if = "Option::is_none")]
    type_arguments: Option[Vec[json::Value]],
}

#[derive(Serialize)]
struct Request {
    protocol_version: isize,
    build_context: GoBuildContext,
    caller_context: CallerRequest,
    bindings: Vec[BindingRequest],
    #[serde(skip_serializing_if = "Option::is_none")]
    type_queries: Option[Vec[TypeQueryRequest]],
}

fn request(
    context: GoBuildContext,
    caller: CallerContext,
    bindings: Vec[BindingRequest],
    queries: Option[Vec[TypeQueryRequest]],
) -> Request {
    Request {
        protocol_version: 1,
        build_context: context,
        caller_context: CallerRequest {
            load_mode: caller.load_mode,
            generated_source: caller.generated_source.unwrap_or(""),
            import_path: caller.import_path,
            directory: caller.directory,
            package_name: caller.package_name,
        },
        bindings,
        type_queries: queries,
    }
}

pub fn encode_request(context: GoBuildContext, caller: CallerContext, bindings: Vec[ForeignBinding]) -> Result[
    string,
    string,
] {
    let values = Vec::new();
    for binding in bindings {
        values.push(
            BindingRequest {
                binding_id: binding.binding_id,
                import_path: binding.import_path,
                symbol: binding.symbol,
                bridge_parameter_types: bridge_type_values(binding.parameters),
                bridge_result_types: bridge_type_values(binding.results),
                call_mode: foreign_call_mode_name(binding.call_mode),
            },
        );
    }
    json::try_to_string(request(context, caller, values, None))
}

fn encode_query_request(
    context: GoBuildContext,
    caller: CallerContext,
    queries: Vec[TypeQueryRequest],
) -> Result[string, string] {
    json::try_to_string(request(context, caller, Vec::new(), Some(queries)))
}
