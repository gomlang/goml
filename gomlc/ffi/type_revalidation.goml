package ffi;

use std::json;

fn revalidation_node(
    metadata: TypeDeclarations,
    id: string,
    indices: HashMap[string, isize],
    nodes: Vec[json::Value],
    depth: isize,
) -> Result[json::Value, string] {
    if let Some(index) = indices[id] {
        return Result::Ok(json::Value::Number(index.to_string()))
    }
    if depth > 128 || nodes.len() >= 65536 {
        return Result::Err("ffi-type: type graph comparison limit exceeded")
    }
    let value = metadata.nodes[id].ok_or("ffi-type: missing type graph node")?;
    let index = nodes.len();
    indices[id] = index;
    nodes.push(json::Value::Null);
    let normalized = revalidation_value(metadata, value, "", indices, nodes, depth + 1)?;
    nodes.set(index, normalized);
    Result::Ok(json::Value::Number(index.to_string()))
}

fn revalidation_value(
    metadata: TypeDeclarations,
    value: json::Value,
    field: string,
    indices: HashMap[string, isize],
    nodes: Vec[json::Value],
    depth: isize,
) -> Result[json::Value, string] {
    if depth > 128 {
        return Result::Err("ffi-type: type graph comparison limit exceeded")
    }
    match value {
        String(id) if field == "element" || field == "key" || field == "underlying"
            || field == "origin"
            || field == "receiver"
            || field == "constraint"
            || field == "type"
            || field == "parameters"
            || field == "results"
            || field == "type_arguments"
            || field == "type_parameters"
            || field == "embedded" => revalidation_node(metadata, id, indices, nodes, depth),
        Array(values) => {
            let result = Vec::new();
            for value in values {
                result.push(revalidation_value(metadata, value, field, indices, nodes, depth + 1)?)
            }
            Result::Ok(json::Value::Array(result))
        },
        Object(fields) => {
            let names = Vec::new();
            for (name, _) in fields {
                if name != "id" {
                    names.push(name)
                }
            }
            let result = Vec::new();
            for name in metadata_sorted_keys(names) {
                result.push(
                    (
                        name,
                        revalidation_value(
                            metadata,
                            response_field(value, name)?,
                            name,
                            indices,
                            nodes,
                            depth + 1,
                        )?,
                    ),
                )
            }
            Result::Ok(json::Value::Object(result))
        },
        _ => Result::Ok(value),
    }
}

fn declaration_graph_key(metadata: TypeDeclarations, type_id: string) -> Result[string, string] {
    for declaration in metadata.declarations {
        if declaration.type_id == type_id {
            let nodes = Vec::new();
            let root = revalidation_node(
                metadata,
                declaration.declared_type,
                HashMap::new(),
                nodes,
                0,
            )?;
            return Result::Ok(
                json::encode(
                    json::Value::Array(
                        Vec::from_array(
                            [json::Value::String(declaration.kind), root, json::Value::Array(nodes)],
                        ),
                    ),
                ),
            )
        }
    }
    Result::Err("ffi-type: missing declaration " + type_id)
}

pub fn validate_foreign_type_metadata(previous: ForeignTypeMetadata, current: TypeDeclarations) -> Result[
    (),
    string,
] {
    for query in previous.queries {
        if declaration_graph_key(previous.declarations, query.type_id)?
            != declaration_graph_key(current, query.type_id)? {
            return Result::Err(
                "ffi-type: Go declaration changed for " + query.type_id + " (" + query.import_path
                    + "."
                    + query.name
                    + "); rebuild the GoML package from source",
            )
        }
    }
    Result::Ok(())
}
