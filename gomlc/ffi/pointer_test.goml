package ffi;

use std::json;
use std::testing;

#[test]
fn pointer_bridge_identity_preserves_nested_pointees() -> () {
    let named = BridgeType::Named { import_path: "os", name: "File", arguments: Vec::new() };
    let pointer = BridgeType::Pointer { element: named };
    let nested = BridgeType::Pointer { element: pointer };
    testing::assert(!bridge_types_equal(pointer, named));
    testing::assert(!bridge_types_equal(pointer, nested));
    testing::assert(!bridge_types_equal(pointer, BridgeType::Slice { element: named }));
    let shape = bridge_type_json(nested);
    let pointee = testing::expect_some(json::field(shape, "element"), "pointer pointee");
    testing::assert_eq(json::encode(pointee), json::encode(bridge_type_json(pointer)));
    testing::assert_eq(
        json::encode(testing::expect_some(json::field(pointee, "element"), "nested pointee")),
        json::encode(bridge_type_json(named)),
    );
}
