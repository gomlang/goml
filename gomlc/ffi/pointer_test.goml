package ffi;

use std::testing;

#[test]
fn pointer_bridge_identity_and_persistence_preserve_nested_pointees() -> () {
    let named = BridgeType::Named { import_path: "os", name: "File", arguments: Vec::new() };
    let pointer = BridgeType::Pointer { element: named };
    let nested = BridgeType::Pointer { element: pointer };
    testing::assert(!bridge_types_equal(pointer, named));
    testing::assert(!bridge_types_equal(pointer, nested));
    testing::assert(!bridge_types_equal(pointer, BridgeType::Slice { element: named }));
    for value in Vec::from_array([pointer, nested]) {
        match decode_instance_argument(bridge_type_json(value), 0, Ref::new(65536)) {
            Ok(decoded) => testing::assert(bridge_types_equal(value, decoded)),
            Err(error) => testing::fail(error),
        }
        testing::assert(instance_argument_identity(value, 0, Ref::new(65536)).is_ok());
    }
}
