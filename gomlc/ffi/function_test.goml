package ffi;

use std::json;
use std::testing;

#[test]
fn function_bridge_preserves_parameter_and_result_boundaries() -> () {
    let integer = BridgeType::Scalar("int64");
    let empty = BridgeType::Function { parameters: Vec::new(), results: Vec::new() };
    let callback = BridgeType::Function {
        parameters: Vec::from_array([integer]),
        results: Vec::from_array([integer, empty]),
    };
    let reordered = BridgeType::Function {
        parameters: Vec::from_array([integer, integer]),
        results: Vec::from_array([empty]),
    };
    testing::assert(!bridge_types_equal(callback, reordered));
    let shape = bridge_type_json(callback);
    let signature = testing::expect_some(json::field(shape, "signature"), "callback signature");
    let parameters = testing::expect_some(
        json::as_array(testing::expect_some(json::field(signature, "parameters"), "parameters")),
        "parameter array",
    );
    let results = testing::expect_some(
        json::as_array(testing::expect_some(json::field(signature, "results"), "results")),
        "result array",
    );
    testing::assert_eq(parameters.len(), 1);
    testing::assert_eq(results.len(), 2);
    testing::assert_eq(json::encode(parameters[0]), json::encode(bridge_type_json(integer)));
    testing::assert_eq(json::encode(results[1]), json::encode(bridge_type_json(empty)));
}
