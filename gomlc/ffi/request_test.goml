package ffi;

use std::json;
use std::testing;

fn request_context() -> GoBuildContext {
    GoBuildContext {
        go_executable: "go",
        toolchain: "go1.26.0",
        module_dir: "/host",
        goos: "linux",
        goarch: "amd64",
        cgo_enabled: "0",
        goflags: "",
        build_tags: Vec::new(),
        go111module: "on",
        gowork: "off",
        dependencies: "readonly",
        network: "off",
    }
}

fn request_caller(source: Option[string]) -> CallerContext {
    CallerContext {
        generated_source: source,
        load_mode: "package",
        import_path: "example.com/host/gen",
        directory: "/host/gen",
        package_name: "gen",
    }
}

#[test]
fn serde_request_preserves_wire_order_names_and_empty_values() -> () {
    let encoded = testing::expect_ok(
        encode_request(request_context(), request_caller(None), Vec::new()),
        "request",
    );
    testing::assert_eq(
        encoded,
        r#"{"protocol_version":1,"build_context":{"go_executable":"go","toolchain":"go1.26.0","module_dir":"/host","goos":"linux","goarch":"amd64","cgo_enabled":"0","goflags":"","build_tags":[],"go111module":"on","gowork":"off","dependencies":"readonly","network":"off"},"caller_context":{"load_mode":"package","generated_source":"","import_path":"example.com/host/gen","directory":"/host/gen","package":"gen"},"bindings":[]}"#,
    );
    let source = "package gen\nvar text = \"你好\\world\"\n";
    let encoded = testing::expect_ok(
        encode_request(
            request_context(),
            request_caller(Some(source)),
            Vec::from_array([test_binding()]),
        ),
        "request with source",
    );
    let value = testing::expect_ok(json::parse(encoded), "JSON");
    let caller = testing::expect_some(json::field(value, "caller_context"), "caller");
    testing::assert(
        json::field(caller, "generated_source").and_then(json::as_string) == Option::Some(source),
    );
    let bindings = testing::expect_some(
        json::field(value, "bindings").and_then(json::as_array),
        "bindings",
    );
    testing::assert_eq(
        json::encode(bindings[0]),
        r#"{"binding_id":"demo::calc::abs","import_path":"math","symbol":"Abs","bridge_parameter_types":[{"tag":"float64"}],"bridge_result_types":[{"tag":"float64"}],"call_mode":"ordinary"}"#,
    );
    testing::assert(json::field(value, "type_queries").is_none());
}

fn encoded_queries(input: string) -> string {
    let value = testing::expect_ok(json::parse(input), "request JSON");
    json::encode(testing::expect_some(json::field(value, "type_queries"), "queries"))
}

#[test]
fn query_requests_keep_declaration_omission_and_instance_arguments() -> () {
    let context = request_context();
    let caller = request_caller(None);
    let declaration = TypeDeclarationQuery {
        type_id: "duration",
        import_path: "time",
        name: "Duration",
    };
    let encoded = testing::expect_ok(
        encode_type_declarations(context, caller, Vec::from_array([declaration])),
        "declaration request",
    );
    testing::assert_eq(
        encoded_queries(encoded),
        r#"[{"type_id":"duration","import_path":"time","name":"Duration","query_mode":"declaration"}]"#,
    );
    let encoded = testing::expect_ok(
        encode_type_instances(
            context,
            caller,
            Vec::from_array([TypeInstanceQuery { declaration, arguments: Vec::new() }]),
        ),
        "instance request",
    );
    testing::assert_eq(
        encoded_queries(encoded),
        r#"[{"type_id":"duration","import_path":"time","name":"Duration","query_mode":"instance","type_arguments":[]}]"#,
    );
    let encoded = testing::expect_ok(
        encode_function_queries(
            context,
            caller,
            Vec::from_array(
                [
                    FunctionQuery {
                        id: "clone",
                        import_path: "slices",
                        name: "Clone",
                        arguments: Vec::from_array(
                            [BridgeType::Slice { element: BridgeType::Scalar("int32") }],
                        ),
                    },
                ],
            ),
        ),
        "function request",
    );
    testing::assert_eq(
        encoded_queries(encoded),
        r#"[{"type_id":"clone","import_path":"slices","name":"Clone","query_mode":"function","type_arguments":[{"tag":"slice","element":{"tag":"int32"}}]}]"#,
    );
    testing::assert_eq(
        encoded_queries(
            testing::expect_ok(
                encode_type_declarations(context, caller, Vec::new()),
                "empty declarations",
            ),
        ),
        "[]",
    );
}
