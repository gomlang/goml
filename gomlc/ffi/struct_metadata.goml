package ffi;

use std::json;

pub struct GoStructField {
    pub name: string,
    pub identity: Result[GoTypeIdentity, string],
}

pub struct GoStructShape {
    pub fields: Vec[GoStructField],
    pub pointer: bool,
}

pub fn resolve_go_struct_shape(metadata: TypeDeclarations, type_id: string) -> Result[
    Option[GoStructShape],
    string,
] {
    for declaration in metadata.declarations {
        if declaration.type_id != type_id {
            continue
        }
        let root = metadata.nodes[declaration.declared_type].ok_or(
            "ffi-protocol: missing struct declaration",
        )?;
        let parameters: HashMap[string, isize] = HashMap::new();
        for parameter in identity_references(root, "type_parameters")? {
            parameters[parameter] = parameters.len();
        }
        let mut id = declaration.declared_type;
        let mut pointer = false;
        for _ in 0..129 {
            let node = metadata.nodes[id].ok_or("ffi-protocol: missing struct type node")?;
            match response_string(node, "tag")? {
                "named" | "alias" => {
                    id = response_string(node, "underlying")?;
                },
                "pointer" if !pointer => {
                    pointer = true;
                    id = response_string(node, "element")?;
                },
                "struct" => {
                    let fields = Vec::new();
                    if json::field(node, "fields").is_some() {
                        for field in response_array(node, "fields")? {
                            let name = response_string(field, "name")?;
                            if !named_bridge_identity_valid("field", name) {
                                continue
                            }
                            fields.push(
                                GoStructField {
                                    name,
                                    identity: normalize_go_type_node(
                                        metadata,
                                        response_string(field, "type")?,
                                        declaration.declared_type,
                                        parameters,
                                        HashMap::new(),
                                        Ref::new(16384),
                                        0,
                                    ),
                                },
                            )
                        }
                    }
                    return Result::Ok(Option::Some(GoStructShape { fields, pointer }))
                },
                _ => return Result::Ok(Option::None),
            }
        }
        return Result::Err("ffi-type: cyclic or excessive struct type chain")
    }
    Result::Err("ffi-type: missing struct declaration " + type_id)
}
