package ffi;

use std::testing;

#[test]
fn external_struct_metadata_retains_public_fields_and_unsupported_shapes() -> () {
    let metadata = identity_fixture(
        "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Record\",\"import_path\":\"host\",\"underlying\":\"s\"},{\"id\":\"s\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Value\",\"type\":\"i\"},{\"name\":\"hidden\",\"type\":\"i\"},{\"name\":\"Anonymous\",\"type\":\"s\"}]},{\"id\":\"i\",\"tag\":\"basic\",\"name\":\"int64\"}]",
        "n",
        "defined",
    );
    match resolve_go_struct_shape(metadata, "test") {
        Ok(Some(shape)) => {
            testing::assert(!shape.pointer);
            testing::assert_eq(shape.fields.len(), 2);
            testing::assert_eq(shape.fields[0].name, "Value");
            testing::assert_eq(shape.fields[1].name, "Anonymous");
            testing::assert(shape.fields[0].identity.is_ok());
            testing::assert(shape.fields[1].identity.is_err());
        },
        _ => testing::fail("expected external Go struct shape"),
    }
}

#[test]
fn external_struct_metadata_preserves_generic_fields_and_pointer_aliases() -> () {
    let metadata = identity_fixture(
        "[{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Handle\",\"import_path\":\"host\",\"underlying\":\"p\",\"type_parameters\":[\"t\"]},{\"id\":\"p\",\"tag\":\"pointer\",\"element\":\"n\"},{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Box\",\"import_path\":\"host\",\"underlying\":\"s\",\"type_parameters\":[\"t\"],\"type_arguments\":[\"t\"]},{\"id\":\"s\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Value\",\"type\":\"t\"}]},{\"id\":\"t\",\"tag\":\"type_parameter\",\"constraint\":\"c\"},{\"id\":\"c\",\"tag\":\"interface\"}]",
        "a",
        "alias",
    );
    match resolve_go_struct_shape(metadata, "test") {
        Ok(Some(shape)) => {
            testing::assert(shape.pointer);
            testing::assert_eq(shape.fields.len(), 1);
            match shape.fields[0].identity {
                Ok(Parameter(index)) => testing::assert_eq(index, 0),
                _ => testing::fail("missing generic field parameter"),
            }
        },
        _ => testing::fail("expected pointer alias struct shape"),
    }
}
