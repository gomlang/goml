package ffi;

use std::testing;

fn interface_shape_queries() -> Vec[TypeDeclarationQuery] {
    Vec::from_array([TypeDeclarationQuery { type_id: "reader", import_path: "io", name: "Reader" }])
}

fn interface_shape_metadata(fields: string) -> Result[TypeDeclarations, string] {
    let nodes = "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Reader\",\"import_path\":\"io\",\"underlying\":\"i\"},{\"id\":\"i\",\"tag\":\"interface\""
        + fields
        + "},{\"id\":\"f\",\"tag\":\"signature\",\"parameters\":[\"s\"],\"results\":[\"v\",\"e\"]},{\"id\":\"s\",\"tag\":\"slice\",\"element\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"uint8\"},{\"id\":\"v\",\"tag\":\"basic\",\"name\":\"int\"},{\"id\":\"e\",\"tag\":\"named\",\"name\":\"error\",\"underlying\":\"j\"},{\"id\":\"j\",\"tag\":\"interface\"}]";
    decode_type_declarations(
        declaration_response(
            nodes,
            "{\"type_id\":\"reader\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\"n\"}",
        ),
        interface_shape_queries(),
    )
}

fn check_interface_shape_roundtrip() -> Result[(), string] {
    let declarations = interface_shape_metadata(
        ",\"runtime_interface\":true,\"interface_methods\":[{\"name\":\"Read\",\"import_path\":\"io\",\"type\":\"f\"}]",
    )?;
    let metadata = ForeignTypeMetadata {
        instances: Vec::new(),
        queries: interface_shape_queries(),
        declarations,
    };
    let encoded = encode_foreign_type_metadata(metadata)?;
    let restored = decode_foreign_type_metadata(encoded)?;
    let shape = resolve_go_interface_shape(restored.declarations, "reader")?;
    testing::assert_eq(encode_foreign_type_metadata(restored)?, encoded);
    testing::assert_eq(shape.methods.len(), 1);
    testing::assert_eq(shape.methods[0].name, "Read");
    testing::assert_eq(shape.methods[0].import_path, "io");
    testing::assert_eq(
        go_type_identity_key(shape.template.identity),
        go_type_identity_key(
            GoTypeIdentity::Named { import_path: "io", name: "Reader", arguments: Vec::new() },
        ),
    );
    testing::assert_eq(
        go_type_identity_key(shape.methods[0].signature),
        go_type_identity_key(
            GoTypeIdentity::Function {
                parameters: Vec::from_array([GoTypeIdentity::Slice(GoTypeIdentity::Basic("uint8"))]),
                results: Vec::from_array(
                    [
                        GoTypeIdentity::Basic("int"),
                        GoTypeIdentity::Named {
                            import_path: "",
                            name: "error",
                            arguments: Vec::new(),
                        },
                    ],
                ),
            },
        ),
    );
    let empty = resolve_go_interface_shape(
        interface_shape_metadata(",\"runtime_interface\":true,\"interface_methods\":[]")?,
        "reader",
    )?;
    testing::assert(empty.methods.is_empty());
    Result::Ok(())
}

#[test]
fn interface_metadata_preserves_identity_signatures_and_artifact_transport() -> () {
    if let Err(error) = check_interface_shape_roundtrip() {
        testing::fail(error)
    }
}

#[test]
fn interface_metadata_rejects_constraints_missing_evidence_and_invalid_methods() -> () {
    for fields in Vec::from_array(
        [
            "",
            ",\"runtime_interface\":true",
            ",\"runtime_interface\":false,\"interface_methods\":[]",
            ",\"runtime_interface\":true,\"interface_methods\":[{\"name\":\"Read\",\"type\":\"v\"}]",
            ",\"runtime_interface\":true,\"interface_methods\":[{\"name\":\"\",\"type\":\"f\"}]",
            ",\"runtime_interface\":true,\"interface_methods\":[{\"name\":\"Read\",\"type\":\"f\"},{\"name\":\"Read\",\"type\":\"f\"}]",
        ],
    ) {
        let Ok(metadata) = interface_shape_metadata(fields) else {
            testing::fail("expected structurally valid metadata");
            return
        };
        testing::assert(resolve_go_interface_shape(metadata, "reader").is_err());
    }
    for fields in Vec::from_array(
        [
            ",\"runtime_interface\":\"true\"",
            ",\"runtime_interface\":true,\"interface_methods\":[{\"name\":\"Read\",\"type\":\"missing\"}]",
            ",\"runtime_interface\":true,\"interface_methods\":true",
        ],
    ) {
        testing::assert(interface_shape_metadata(fields).is_err());
    }
}
