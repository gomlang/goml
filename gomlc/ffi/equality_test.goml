package ffi;

use std::testing;

#[test]
fn bridge_type_equality_preserves_array_lengths_and_channel_directions() -> () {
    let scalar = BridgeType::Scalar("uint8");
    let first = BridgeType::Array { element: scalar, length: 2 };
    let second = BridgeType::Array { element: scalar, length: 3 };
    testing::assert(!bridge_types_equal(first, second));
    testing::assert(!bridge_types_equal(first, BridgeType::Slice { element: scalar }));
    let sender = BridgeType::Channel { element: first, direction: "send" };
    let receiver = BridgeType::Channel { element: first, direction: "receive" };
    testing::assert(bridge_types_equal(sender, sender));
    testing::assert(!bridge_types_equal(sender, receiver))
}

#[test]
fn named_bridge_equality_preserves_go_identity_and_arguments() -> () {
    let duration = BridgeType::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    let handle = BridgeType::Named {
        import_path: "unique",
        name: "Handle",
        arguments: Vec::from_array([duration]),
    };
    testing::assert(bridge_types_equal(handle, handle));
    testing::assert(!bridge_types_equal(duration, BridgeType::Scalar("int64")));
    testing::assert(
        !bridge_types_equal(
            handle,
            BridgeType::Named {
                import_path: "unique",
                name: "Handle",
                arguments: Vec::from_array([BridgeType::Scalar("int64")]),
            },
        ),
    );
    testing::assert(
        !bridge_types_equal(
            duration,
            BridgeType::Named { import_path: "other", name: "Duration", arguments: Vec::new() },
        ),
    );
    testing::assert(named_bridge_identity_valid("example.com/host", "Box"));
    for name in Vec::from_array(["", "private", "Bad.Name", "Name[int]", "Name()", "A\nB"]) {
        testing::assert(!named_bridge_identity_valid("host", name))
    }
    for import_path in Vec::from_array(["", "bad path", "host\n", "host\"", "host\\path"]) {
        testing::assert(!named_bridge_identity_valid(import_path, "Box"))
    }
}
