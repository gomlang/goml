package ffi;

use std::json;

fn strings_json(values: Vec[string]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for value in values {
        result.push(json::Value::String(value))
    }
    json::Value::Array(result)
}

pub fn bridge_type_json(value: BridgeType) -> json::Value {
    match value {
        Function { parameters, results } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("function")),
                    (
                        "signature",
                        json::object(
                            Vec::from_array(
                                [
                                    ("parameters", bridge_types_json(parameters)),
                                    ("results", bridge_types_json(results)),
                                ],
                            ),
                        ),
                    ),
                ],
            ),
        ),
        Named { import_path, name, arguments } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("named")),
                    ("import_path", json::Value::String(import_path)),
                    ("name", json::Value::String(name)),
                    ("type_arguments", bridge_types_json(arguments)),
                ],
            ),
        ),
        Scalar(tag) => json::object(Vec::from_array([("tag", json::Value::String(tag))])),
        Array { element, length } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("array")),
                    ("element", bridge_type_json(element)),
                    ("length", json::Value::Number(length.to_string())),
                ],
            ),
        ),
        Pointer { element } => json::object(
            Vec::from_array(
                [("tag", json::Value::String("pointer")), ("element", bridge_type_json(element))],
            ),
        ),
        Slice { element } => json::object(
            Vec::from_array(
                [("tag", json::Value::String("slice")), ("element", bridge_type_json(element))],
            ),
        ),
        Map { key, element } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("map")),
                    ("key", bridge_type_json(key)),
                    ("element", bridge_type_json(element)),
                ],
            ),
        ),
        Channel { element, direction } => json::object(
            Vec::from_array(
                [
                    ("tag", json::Value::String("channel")),
                    ("element", bridge_type_json(element)),
                    ("direction", json::Value::String(direction)),
                ],
            ),
        ),
    }
}

fn bridge_types_json(values: Vec[BridgeType]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for value in values {
        result.push(bridge_type_json(value))
    }
    json::Value::Array(result)
}

pub fn build_context_json(value: GoBuildContext) -> json::Value {
    json::object(
        Vec::from_array(
            [
                ("go_executable", json::Value::String(value.go_executable)),
                ("toolchain", json::Value::String(value.toolchain)),
                ("module_dir", json::Value::String(value.module_dir)),
                ("goos", json::Value::String(value.goos)),
                ("goarch", json::Value::String(value.goarch)),
                ("cgo_enabled", json::Value::String(value.cgo_enabled)),
                ("goflags", json::Value::String(value.goflags)),
                ("build_tags", strings_json(value.build_tags)),
                ("go111module", json::Value::String(value.go111module)),
                ("gowork", json::Value::String(value.gowork)),
                ("dependencies", json::Value::String(value.dependencies)),
                ("network", json::Value::String(value.network)),
            ],
        ),
    )
}

pub fn encode_request(context: GoBuildContext, caller: CallerContext, bindings: Vec[ForeignBinding]) -> string {
    let values: Vec[json::Value] = Vec::new();
    for binding in bindings {
        values.push(
            json::object(
                Vec::from_array(
                    [
                        ("binding_id", json::Value::String(binding.binding_id)),
                        ("import_path", json::Value::String(binding.import_path)),
                        ("symbol", json::Value::String(binding.symbol)),
                        ("bridge_parameter_types", bridge_types_json(binding.parameters)),
                        ("bridge_result_types", bridge_types_json(binding.results)),
                        (
                            "call_mode",
                            json::Value::String(foreign_call_mode_name(binding.call_mode)),
                        ),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("protocol_version", json::Value::Number("1")),
                    ("build_context", build_context_json(context)),
                    (
                        "caller_context",
                        json::object(
                            Vec::from_array(
                                [
                                    ("load_mode", json::Value::String(caller.load_mode)),
                                    (
                                        "generated_source",
                                        json::Value::String(caller.generated_source.unwrap_or("")),
                                    ),
                                    ("import_path", json::Value::String(caller.import_path)),
                                    ("directory", json::Value::String(caller.directory)),
                                    ("package", json::Value::String(caller.package_name)),
                                ],
                            ),
                        ),
                    ),
                    ("bindings", json::Value::Array(values)),
                ],
            ),
        ),
    )
}

fn response_field(value: json::Value, name: string) -> Result[json::Value, string] {
    match value {
        Object(fields) => {
            let mut result: Option[json::Value] = Option::None;
            for field in fields {
                if field.0 == name {
                    if result.is_some() {
                        return Result::Err("ffi-protocol: duplicate response field " + name)
                    }
                    result = Option::Some(field.1);
                }
            }
            result.ok_or("ffi-protocol: missing response field " + name)
        },
        _ => Result::Err("ffi-protocol: expected response object"),
    }
}

fn response_string(value: json::Value, name: string) -> Result[string, string] {
    json::as_string(response_field(value, name)?).ok_or("ffi-protocol: expected string " + name)
}

fn response_array(value: json::Value, name: string) -> Result[Vec[json::Value], string] {
    match response_field(value, name)? {
        Null => Result::Ok(Vec::new()),
        Array(values) => Result::Ok(values),
        _ => Result::Err("ffi-protocol: expected array " + name),
    }
}

fn diagnostic_text(value: json::Value) -> Result[string, string] {
    let code = response_string(value, "code")?;
    let message = response_string(value, "message")?;
    if code == "" || message == "" {
        Result::Err("ffi-protocol: empty diagnostic code or message")
    } else {
        Result::Ok(code + ": " + message)
    }
}

fn response_nesting_is_bounded(input: string) -> bool {
    let mut quoted = false;
    let mut escaped = false;
    let mut depth = 0;
    for index in 0..input.byte_len() {
        let byte = input.byte_get(index);
        if quoted {
            if escaped {
                escaped = false;
            } else if byte == b'\\' {
                escaped = true;
            } else if byte == b'"' {
                quoted = false;
            }
        } else if byte == b'"' {
            quoted = true;
        } else if byte == b'{' || byte == b'[' {
            depth += 1;
            if depth > 64 {
                return false
            }
        } else if byte == b'}' || byte == b']' {
            depth -= 1;
            if depth < 0 {
                return false
            }
        }
    }
    depth == 0 && !quoted
}

fn response_type_ids(value: json::Value) -> Result[HashMap[string, string], string] {
    let values = response_array(value, "referenced_types")?;
    if values.len() > 65536 {
        return Result::Err("ffi-protocol: referenced type limit exceeded")
    }
    let result: HashMap[string, string] = HashMap::new();
    for value in values {
        let id = response_string(value, "id")?;
        let tag = response_string(value, "tag")?;
        if id == "" || result[id].is_some() {
            return Result::Err("ffi-protocol: empty or duplicate type id")
        }
        match tag {
            "basic" | "pointer" | "array" | "slice" | "channel" | "map" | "alias" | "named" | "struct" | "interface" | "signature" | "tuple" | "type_parameter" | "union" => (),
            _ => return Result::Err("ffi-protocol: unknown referenced type tag " + tag),
        }
        result[id] = tag;
    }
    Result::Ok(result)
}

pub fn decode_verification(input: string, expected: Vec[ForeignBinding]) -> Result[
    Verification,
    string,
] {
    decode_verification_with_locations(input, expected, HashMap::new())
}

pub fn decode_verification_with_locations(
    input: string,
    expected: Vec[ForeignBinding],
    locations: HashMap[string, string],
) -> Result[Verification, string] {
    if input.byte_len() > 8388608 {
        return Result::Err("ffi-protocol: response exceeds 8388608 bytes")
    }
    if !response_nesting_is_bounded(input) {
        return Result::Err("ffi-protocol: malformed or excessively nested JSON response")
    }
    let value = json::parse(input).map_err(|message| "ffi-protocol: " + message)?;
    if json::as_int(response_field(value, "protocol_version")?) != Option::Some(1) {
        return Result::Err("ffi-protocol: unsupported response version")
    }
    let request_diagnostics = response_array(value, "diagnostics")?;
    if !request_diagnostics.is_empty() {
        return Result::Err(diagnostic_text(request_diagnostics[0])?)
    }
    let results = response_array(value, "bindings")?;
    if results.len() != expected.len() || results.len() > 4096 {
        return Result::Err("ffi-protocol: unexpected binding result count")
    }
    let type_ids = response_type_ids(value)?;
    let seen: Vec[string] = Vec::new();
    let errors: Vec[string] = Vec::new();
    for result in results {
        let id = response_string(result, "binding_id")?;
        let mut found = false;
        for binding in expected {
            if binding.binding_id == id {
                found = true;
            }
        }
        if !found {
            return Result::Err("ffi-protocol: unexpected binding id " + id)
        }
        for previous in seen {
            if previous == id {
                return Result::Err("ffi-protocol: duplicate binding result " + id)
            }
        }
        seen.push(id);
        let status = response_string(result, "status")?;
        let diagnostics = response_array(result, "diagnostics")?;
        let signature = response_string(result, "actual_signature")?;
        if status == "verified" {
            let signature_type = response_string(result, "signature_type")?;
            if type_ids[signature_type] != Option::Some("signature") {
                return Result::Err("ffi-protocol: missing signature type for " + id)
            }
            if !diagnostics.is_empty() || signature == "" {
                return Result::Err("ffi-protocol: inconsistent verified binding " + id)
            }
        } else if status == "failed" {
            if diagnostics.is_empty() {
                return Result::Err("ffi-protocol: failed binding has no diagnostic " + id)
            }
            for diagnostic in diagnostics {
                errors.push(
                    id + ": " + diagnostic_text(diagnostic)? + " (Go: " + signature + ")"
                        + locations[id].unwrap_or(""),
                )
            }
        } else {
            return Result::Err("ffi-protocol: unknown binding status " + status)
        }
    }
    if !errors.is_empty() {
        let mut message = "";
        for error in errors {
            if message != "" {
                message = message + "\n";
            }
            message = message + error;
        }
        return Result::Err(message)
    }
    let world = response_string(value, "go_world_identity")?;
    if world == "" && !expected.is_empty() {
        Result::Err("ffi-protocol: missing Go world identity")
    } else {
        Result::Ok(Verification::Verified { go_world_identity: world })
    }
}

pub fn decode_build_context(input: string) -> Result[GoBuildContext, string] {
    if input.byte_len() > 8388608 || !response_nesting_is_bounded(input) {
        return Result::Err("ffi-protocol: invalid build context JSON")
    }
    let value = json::parse(input).map_err(|message| "ffi-protocol: " + message)?;
    let tags: Vec[string] = Vec::new();
    for tag in response_array(value, "build_tags")? {
        tags.push(json::as_string(tag).ok_or("ffi-protocol: build tag must be a string")?)
    }
    let context = GoBuildContext {
        go_executable: response_string(value, "go_executable")?,
        toolchain: response_string(value, "toolchain")?,
        module_dir: response_string(value, "module_dir")?,
        goos: response_string(value, "goos")?,
        goarch: response_string(value, "goarch")?,
        cgo_enabled: response_string(value, "cgo_enabled")?,
        goflags: response_string(value, "goflags")?,
        build_tags: tags,
        go111module: response_string(value, "go111module")?,
        gowork: response_string(value, "gowork")?,
        dependencies: response_string(value, "dependencies")?,
        network: response_string(value, "network")?,
    };
    if context.go_executable == "" || context.toolchain == "" || context.module_dir == ""
        || context.goos == ""
        || context.goarch == "" {
        return Result::Err("ffi-protocol: incomplete Go build context")
    }
    if context.gowork != "off" || context.dependencies != "readonly" || context.network != "off"
        || context.cgo_enabled != "0" && context.cgo_enabled != "1"
        || context.go111module != "on" && context.go111module != "off" {
        Result::Err("ffi-protocol: unsupported Go build context policy")
    } else {
        Result::Ok(context)
    }
}
