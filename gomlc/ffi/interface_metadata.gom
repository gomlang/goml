package ffi;

use std::json;

pub struct GoInterfaceMethod {
    pub name: string,
    pub import_path: string,
    pub signature: GoTypeIdentity,
}

pub struct GoInterfaceShape {
    pub template: GoTypeTemplate,
    pub methods: Vec[GoInterfaceMethod],
}

fn interface_underlying_node(metadata: TypeDeclarations, root: string) -> Result[
    json::Value,
    string,
] {
    let mut id = root;
    for depth in 0..129 {
        let node = metadata.nodes[id].ok_or("ffi-protocol: missing interface type node")?;
        let tag = response_string(node, "tag")?;
        if tag == "interface" {
            return Result::Ok(node)
        }
        if tag != "named" && tag != "alias" {
            return Result::Err("ffi-interface: target is not a Go interface")
        }
        id = response_string(node, "underlying")?;
    }
    Result::Err("ffi-interface: cyclic or excessive interface type chain")
}

pub fn resolve_go_interface_shape(metadata: TypeDeclarations, type_id: string) -> Result[
    GoInterfaceShape,
    string,
] {
    let template = resolve_go_type_template(metadata, type_id)?;
    for declaration in metadata.declarations {
        if declaration.type_id != type_id {
            continue
        }
        let node = interface_underlying_node(metadata, declaration.declared_type)?;
        let runtime = json::field(node, "runtime_interface").and_then(|value| json::as_bool(value));
        match runtime {
            Some(true) => (),
            Some(false) => return Result::Err(
                "ffi-interface: constraint-only Go interface cannot be a runtime value",
            ),
            None => return Result::Err("ffi-interface: missing runtime interface classification"),
        }
        let root = metadata.nodes[declaration.declared_type].ok_or(
            "ffi-protocol: missing interface declaration",
        )?;
        let parameters: HashMap[string, isize] = HashMap::new();
        for parameter in identity_references(root, "type_parameters")? {
            parameters[parameter] = parameters.len();
        }
        let values = response_array(node, "interface_methods")?;
        let methods: Vec[GoInterfaceMethod] = Vec::new();
        for method in values {
            let name = response_string(method, "name")?;
            if name == "" {
                return Result::Err("ffi-protocol: empty interface method name")
            }
            let import_path = match json::field(method, "import_path") {
                Some(_) => response_string(method, "import_path")?,
                None => "",
            };
            for previous in methods {
                if previous.name == name && previous.import_path == import_path {
                    return Result::Err("ffi-protocol: duplicate complete interface method")
                }
            }
            let id = response_string(method, "type")?;
            let signature = metadata.nodes[id].ok_or(
                "ffi-protocol: missing interface method signature",
            )?;
            if response_string(signature, "tag")? != "signature" {
                return Result::Err("ffi-protocol: interface method is not a function signature")
            }
            methods.push(
                GoInterfaceMethod {
                    name,
                    import_path,
                    signature: normalize_go_type_node(
                        metadata,
                        id,
                        declaration.declared_type,
                        parameters,
                        HashMap::new(),
                        Ref::new(16384),
                        0,
                    )?,
                },
            );
        }
        return Result::Ok(GoInterfaceShape { template, methods })
    }
    Result::Err("ffi-interface: missing interface declaration")
}
