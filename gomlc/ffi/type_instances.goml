package ffi;

pub struct TypeInstanceQuery {
    pub declaration: TypeDeclarationQuery,
    pub arguments: Vec[BridgeType],
}

fn instance_argument_identity(value: BridgeType, depth: isize, remaining: Ref[isize]) -> Result[
    GoTypeIdentity,
    string,
] {
    if depth > 64 || remaining.get() <= 0 {
        return Result::Err("ffi-type: instance argument complexity limit exceeded")
    }
    remaining.set(remaining.get() - 1);
    match value {
        Function { parameters, results } => {
            let params = Vec::new();
            let returns = Vec::new();
            for value in parameters {
                params.push(instance_argument_identity(value, depth + 1, remaining)?)
            }
            for value in results {
                returns.push(instance_argument_identity(value, depth + 1, remaining)?)
            }
            Result::Ok(GoTypeIdentity::Function { parameters: params, results: returns })
        },
        Scalar(name) => normalized_go_basic(name),
        Named { import_path, name, arguments } => {
            if !named_bridge_identity_valid(import_path, name)
                || (import_path == "" && !arguments.is_empty()) {
                return Result::Err("ffi-type: invalid instance argument identity")
            }
            let args = Vec::new();
            for argument in arguments {
                args.push(instance_argument_identity(argument, depth + 1, remaining)?)
            }
            Result::Ok(GoTypeIdentity::Named { import_path, name, arguments: args })
        },
        Array { element, length } => if length < 0 {
            Result::Err("ffi-type: negative instance array length")
        } else {
            Result::Ok(
                GoTypeIdentity::Array {
                    element: instance_argument_identity(element, depth + 1, remaining)?,
                    length,
                },
            )
        },
        Pointer { element } => Result::Ok(
            GoTypeIdentity::Pointer(instance_argument_identity(element, depth + 1, remaining)?),
        ),
        Slice { element } => Result::Ok(
            GoTypeIdentity::Slice(instance_argument_identity(element, depth + 1, remaining)?),
        ),
        Map { key, element } => Result::Ok(
            GoTypeIdentity::Map {
                key: instance_argument_identity(key, depth + 1, remaining)?,
                element: instance_argument_identity(element, depth + 1, remaining)?,
            },
        ),
        Channel { element, direction } => if direction == "both" || direction == "send"
            || direction == "receive" {
            Result::Ok(
                GoTypeIdentity::Channel {
                    element: instance_argument_identity(element, depth + 1, remaining)?,
                    direction,
                },
            )
        } else {
            Result::Err("ffi-type: invalid instance channel direction")
        },
    }
}
