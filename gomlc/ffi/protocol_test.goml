package ffi;

use std::json;
use std::testing;

fn build_context_fixture() -> GoBuildContext {
    GoBuildContext {
        go_executable: "C:\\Program Files\\Go\\bin\\go.exe",
        toolchain: "go1.26.0",
        module_dir: "C:\\host project",
        goos: "windows",
        goarch: "amd64",
        cgo_enabled: "0",
        goflags: "-trimpath",
        build_tags: Vec::from_array(["integration"]),
        go111module: "on",
        gowork: "off",
        dependencies: "readonly",
        network: "off",
    }
}

#[test]
fn go_build_context_roundtrips_paths_flags_and_build_tags() -> () {
    let context = build_context_fixture();
    let encoded = json::encode(build_context_json(context));
    let restored = testing::expect_ok(decode_build_context(encoded), "Go build context");
    testing::assert_eq(restored.go_executable, context.go_executable);
    testing::assert_eq(restored.module_dir, context.module_dir);
    testing::assert_eq(restored.goflags, context.goflags);
    testing::assert_eq(restored.build_tags.len(), 1);
    testing::assert_eq(restored.build_tags[0], "integration");
    testing::assert_eq(json::encode(build_context_json(restored)), encoded);
}

#[test]
fn go_build_context_rejects_incomplete_or_unsupported_policy() -> () {
    let context = build_context_fixture();
    for invalid in Vec::from_array(
        [
            GoBuildContext { go_executable: "", ..context },
            GoBuildContext { toolchain: "", ..context },
            GoBuildContext { module_dir: "", ..context },
            GoBuildContext { goos: "", ..context },
            GoBuildContext { goarch: "", ..context },
            GoBuildContext { cgo_enabled: "true", ..context },
            GoBuildContext { go111module: "auto", ..context },
            GoBuildContext { gowork: "auto", ..context },
            GoBuildContext { dependencies: "update", ..context },
            GoBuildContext { network: "on", ..context },
        ],
    ) {
        testing::assert(decode_build_context(json::encode(build_context_json(invalid))).is_err());
    }
    for input in Vec::from_array(["{", "{}", "[]", "{\"build_tags\":[],\"build_tags\":[]}"]) {
        testing::assert(decode_build_context(input).is_err());
    }
    let Object(fields) = build_context_json(context) else {
        testing::fail("expected build context object");
        return
    };
    let invalid = Vec::new();
    for (name, value) in fields {
        invalid.push(
            (
                name,
                if name == "build_tags" {
                    json::Value::Array(Vec::from_array([json::Value::Number("1")]))
                } else {
                    value
                },
            ),
        );
    }
    testing::assert(decode_build_context(json::encode(json::Value::Object(invalid))).is_err());
}

#[test]
fn bridge_json_preserves_array_lengths_and_channel_directions() -> () {
    let ty = BridgeType::Channel {
        element: BridgeType::Array { element: BridgeType::Scalar("int32"), length: 2 },
        direction: "receive",
    };
    let shape = bridge_type_json(ty);
    testing::assert_eq(
        json::as_string(json::field(shape, "direction").unwrap_or(json::Value::Null)).unwrap_or(""),
        "receive",
    );
    let array = json::field(shape, "element").unwrap_or(json::Value::Null);
    testing::assert_eq(
        json::as_int(json::field(array, "length").unwrap_or(json::Value::Null)).unwrap_or(-1),
        2,
    );
}
