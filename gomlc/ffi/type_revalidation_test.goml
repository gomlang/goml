package ffi;

use std::testing;

fn revalidation_fixture(node_id: string, basic_id: string, basic: string) -> Result[
    TypeDeclarations,
    string,
] {
    let nodes = "[{\"id\":\"" + node_id
        + "\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\""
        + basic_id
        + "\"},{\"id\":\""
        + basic_id
        + "\",\"tag\":\"basic\",\"name\":\""
        + basic
        + "\"}]";
    let result = "{\"type_id\":\"duration\",\"status\":\"verified\",\"declaration_kind\":\"defined\",\"declared_type\":\""
        + node_id
        + "\"}";
    decode_type_declarations(declaration_response(nodes, result), declaration_queries())
}

fn exercise_type_revalidation() -> Result[(), string] {
    let original = revalidation_fixture("n", "b", "int64")?;
    let metadata = ForeignTypeMetadata {
        instances: Vec::new(),
        queries: declaration_queries(),
        declarations: original,
    };
    let renumbered = revalidation_fixture("other", "basic", "int64")?;
    let changed_world = TypeDeclarations {
        go_world_identity: "different-build-world",
        declarations: renumbered.declarations,
        nodes: renumbered.nodes,
    };
    validate_foreign_type_metadata(metadata, changed_world)?;
    let changed = revalidation_fixture("n", "b", "int32")?;
    match validate_foreign_type_metadata(metadata, changed) {
        Err(error) => {
            testing::assert(error.contains("duration"));
            testing::assert(error.contains("time.Duration"));
            testing::assert(error.contains("rebuild"));
        },
        Ok(_) => testing::fail("expected changed external declaration diagnostic"),
    }
    Result::Ok(())
}

#[test]
fn foreign_type_revalidation_ignores_graph_ids_and_checks_underlying_types() -> () {
    if let Err(error) = exercise_type_revalidation() {
        testing::fail(error)
    }
}
