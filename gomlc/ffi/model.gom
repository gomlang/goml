package ffi;

pub enum CheckMode {
    Required,
    Off,
}

pub enum BridgeType {
    Scalar(string),
    Function {
        parameters: Vec[BridgeType],
        results: Vec[BridgeType],
    },
    Named {
        import_path: string,
        name: string,
        arguments: Vec[BridgeType],
    },
    Array {
        element: BridgeType,
        length: isize,
    },
    Pointer {
        element: BridgeType,
    },
    Slice {
        element: BridgeType,
    },
    Map {
        key: BridgeType,
        element: BridgeType,
    },
    Channel {
        element: BridgeType,
        direction: string,
    },
}

pub struct GoBuildContext {
    pub go_executable: string,
    pub toolchain: string,
    pub module_dir: string,
    pub goos: string,
    pub goarch: string,
    pub cgo_enabled: string,
    pub goflags: string,
    pub build_tags: Vec[string],
    pub go111module: string,
    pub gowork: string,
    pub dependencies: string,
    pub network: string,
}

pub struct CallerContext {
    pub generated_source: Option[string],
    pub load_mode: string,
    pub import_path: string,
    pub directory: string,
    pub package_name: string,
}

#[derive(PartialEq, Eq)]
pub enum ForeignCallMode {
    Ordinary,
    Method,
}

pub struct ForeignBinding {
    pub call_mode: ForeignCallMode,
    pub binding_id: string,
    pub import_path: string,
    pub symbol: string,
    pub parameters: Vec[BridgeType],
    pub results: Vec[BridgeType],
}

pub enum Verification {
    Verified { go_world_identity: string },
    Unverified,
}

pub fn parse_check_mode(value: string) -> Result[CheckMode, string] {
    match value {
        "required" => Result::Ok(CheckMode::Required),
        "off" => Result::Ok(CheckMode::Off),
        _ => Result::Err("--ffi-check expects required or off"),
    }
}

pub fn foreign_call_mode_name(value: ForeignCallMode) -> string {
    match value {
        Ordinary => "ordinary",
        Method => "method",
    }
}

pub fn parse_foreign_call_mode(value: string) -> Result[ForeignCallMode, string] {
    match value {
        "ordinary" => Result::Ok(ForeignCallMode::Ordinary),
        "method" => Result::Ok(ForeignCallMode::Method),
        _ => Result::Err("unknown foreign call mode"),
    }
}

pub fn validate_foreign_binding_target(value: ForeignBinding) -> Result[(), string] {
    if value.symbol == "" {
        return Result::Err("empty foreign binding symbol")
    }
    match value.call_mode {
        Ordinary => if value.import_path == "" {
            return Result::Err("ordinary foreign binding requires a package target")
        },
        Method => if value.import_path != "" || value.parameters.is_empty() {
            return Result::Err("foreign method requires a receiver and no package target")
        },
    }
    Result::Ok(())
}
