package ffi;

pub fn go_identity_bridge_type(value: GoTypeIdentity) -> Result[BridgeType, string] {
    match value {
        Basic(name) => match name {
            "bool" | "int" | "int8" | "int16" | "int32" | "int64" | "uint" | "uint8" | "uint16" | "uint32" | "uint64" | "float32" | "float64" | "string" => Result::Ok(
                BridgeType::Scalar(name),
            ),
            _ => Result::Err("ffi-interface: unsupported Go scalar " + name),
        },
        Named { import_path, name, arguments } => {
            if !named_bridge_identity_valid(import_path, name) {
                return Result::Err("ffi-interface: Go type is not publicly nameable")
            }
            let values: Vec[BridgeType] = Vec::new();
            for argument in arguments {
                values.push(go_identity_bridge_type(argument)?);
            }
            Result::Ok(BridgeType::Named { import_path, name, arguments: values })
        },
        Function { parameters, results } => {
            let params: Vec[BridgeType] = Vec::new();
            let returns: Vec[BridgeType] = Vec::new();
            for parameter in parameters {
                params.push(go_identity_bridge_type(parameter)?);
            }
            for result in results {
                returns.push(go_identity_bridge_type(result)?);
            }
            Result::Ok(BridgeType::Function { parameters: params, results: returns })
        },
        Pointer(element) => Result::Ok(
            BridgeType::Pointer { element: go_identity_bridge_type(element)? },
        ),
        Slice(element) => Result::Ok(
            BridgeType::Slice { element: go_identity_bridge_type(element)? },
        ),
        Array { element, length } => Result::Ok(
            BridgeType::Array { element: go_identity_bridge_type(element)?, length },
        ),
        Map { key, element } => Result::Ok(
            BridgeType::Map {
                key: go_identity_bridge_type(key)?,
                element: go_identity_bridge_type(element)?,
            },
        ),
        Channel { element, direction } => Result::Ok(
            BridgeType::Channel { element: go_identity_bridge_type(element)?, direction },
        ),
        Parameter(_) => Result::Err("ffi-interface: method requires a concrete Go type instance"),
    }
}
