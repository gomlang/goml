package ffi;

use std::json;
use std::collections;

pub struct ForeignTypeMetadata {
    pub instances: Vec[TypeInstanceQuery],
    pub queries: Vec[TypeDeclarationQuery],
    pub declarations: TypeDeclarations,
}

fn metadata_sorted_keys(values: Vec[string]) -> Vec[string] {
    collections::sort(values);
    values
}

fn metadata_response(metadata: TypeDeclarations) -> json::Value {
    let node_ids = Vec::new();
    for (id, _) in metadata.nodes.entries() {
        node_ids.push(id)
    }
    let nodes = Vec::new();
    for id in metadata_sorted_keys(node_ids) {
        if let Some(node) = metadata.nodes[id] {
            nodes.push(node)
        }
    }
    let result_ids = Vec::new();
    for declaration in metadata.declarations {
        result_ids.push(declaration.type_id)
    }
    let results = Vec::new();
    for id in metadata_sorted_keys(result_ids) {
        for declaration in metadata.declarations {
            if declaration.type_id == id {
                results.push(
                    json::object(
                        Vec::from_array(
                            [
                                ("type_id", json::Value::String(id)),
                                ("status", json::Value::String("verified")),
                                ("declaration_kind", json::Value::String(declaration.kind)),
                                ("declared_type", json::Value::String(declaration.declared_type)),
                            ],
                        ),
                    ),
                )
            }
        }
    }
    json::object(
        Vec::from_array(
            [
                ("protocol_version", json::Value::Number("1")),
                ("go_world_identity", json::Value::String(metadata.go_world_identity)),
                ("diagnostics", json::Value::Array(Vec::new())),
                ("bindings", json::Value::Array(Vec::new())),
                ("referenced_types", json::Value::Array(nodes)),
                ("type_results", json::Value::Array(results)),
            ],
        ),
    )
}

pub fn encode_foreign_type_metadata(value: ForeignTypeMetadata) -> Result[string, string] {
    if value.instances.len() > 4096 || value.queries.len() > 4096
        || value.declarations.declarations.len() > 4096
        || value.declarations.nodes.len() > 65536 {
        return Result::Err("ffi-protocol: persisted type metadata exceeds limits")
    }
    let result = foreign_type_metadata_text(value);
    let _ = decode_foreign_type_metadata(result)?;
    Result::Ok(result)
}

pub fn foreign_type_metadata_text(value: ForeignTypeMetadata) -> string {
    let ids = Vec::new();
    for query in value.queries {
        ids.push(query.type_id)
    }
    let queries = Vec::new();
    for id in metadata_sorted_keys(ids) {
        for query in value.queries {
            if query.type_id == id {
                queries.push(
                    json::object(
                        Vec::from_array(
                            [
                                ("type_id", json::Value::String(query.type_id)),
                                ("import_path", json::Value::String(query.import_path)),
                                ("name", json::Value::String(query.name)),
                            ],
                        ),
                    ),
                )
            }
        }
    }
    let result = json::encode(
        json::object(
            Vec::from_array(
                [
                    ("version", json::Value::Number("2")),
                    ("instances", instance_queries_json(value.instances)),
                    ("queries", json::Value::Array(queries)),
                    ("metadata", metadata_response(value.declarations)),
                ],
            ),
        ),
    );
    result
}

pub fn decode_foreign_type_metadata(input: string) -> Result[ForeignTypeMetadata, string] {
    if input.byte_len() > 8388608 || !response_nesting_is_bounded(input) {
        return Result::Err("ffi-protocol: invalid persisted type metadata JSON")
    }
    let value = json::parse(input)?;
    if json::as_int(response_field(value, "version")?) != Option::Some(2) {
        return Result::Err("ffi-protocol: unsupported type metadata version")
    }
    let query_values = response_array(value, "queries")?;
    if query_values.len() > 4096 {
        return Result::Err("ffi-protocol: too many persisted type queries")
    }
    let queries = Vec::new();
    for value in query_values {
        let import_path = response_string(value, "import_path")?;
        let name = response_string(value, "name")?;
        if !named_bridge_identity_valid(import_path, name) {
            return Result::Err("ffi-protocol: invalid persisted type query")
        }
        queries.push(
            TypeDeclarationQuery { type_id: response_string(value, "type_id")?, import_path, name },
        )
    }
    let declarations = decode_type_declarations(
        json::encode(response_field(value, "metadata")?),
        queries,
    )?;
    for query in queries {
        let _ = resolve_go_type_template(declarations, query.type_id)?;
    }
    let instances = decode_instance_queries(
        response_field(value, "instances")?,
        queries,
        declarations,
    )?;
    Result::Ok(ForeignTypeMetadata { instances, queries, declarations })
}
