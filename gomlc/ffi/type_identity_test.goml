package ffi;

use std::json;
use std::testing;

fn identity_fixture(source: string, root: string, kind: string) -> TypeDeclarations {
    let nodes: HashMap[string, json::Value] = HashMap::new();
    for value in json::as_array(
        json::parse(source).unwrap_or_else(
            |error| {
                testing::fail(error);
                json::Value::Null
            },
        ),
    ).unwrap_or_else(
        || {
            testing::fail("expected node array");
            Vec::new()
        },
    ) {
        nodes[response_string(value, "id").unwrap_or_else(
            |error| {
                testing::fail(error);
                ""
            },
        )] = value;
    }
    TypeDeclarations {
        go_world_identity: "test-world",
        declarations: Vec::from_array(
            [TypeDeclaration { type_id: "test", kind, declared_type: root }],
        ),
        nodes,
    }
}

fn identity_template(metadata: TypeDeclarations) -> GoTypeTemplate {
    resolve_go_type_template(metadata, "test").unwrap_or_else(
        |error| {
            testing::fail(error);
            GoTypeTemplate {
                identity: GoTypeIdentity::Basic("invalid"),
                parameter_constraints: Vec::new(),
                declaration_kind: "",
                underlying_kind: "",
            }
        },
    )
}

#[test]
fn go_identity_normalizes_aliases_without_erasing_named_types() -> () {
    let duration = identity_template(
        identity_fixture(
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"}]",
            "n",
            "defined",
        ),
    );
    let renamed = identity_template(
        identity_fixture(
            "[{\"id\":\"z\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"q\"},{\"id\":\"q\",\"tag\":\"basic\",\"name\":\"int64\"}]",
            "z",
            "defined",
        ),
    );
    let alias = identity_template(
        identity_fixture(
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Duration\",\"import_path\":\"time\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"},{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Delay\",\"import_path\":\"host\",\"underlying\":\"n\"}]",
            "a",
            "alias",
        ),
    );
    testing::assert_eq(
        go_type_identity_key(duration.identity),
        go_type_identity_key(renamed.identity),
    );
    testing::assert_eq(
        go_type_identity_key(duration.identity),
        go_type_identity_key(alias.identity),
    );
    testing::assert(
        go_type_identity_key(duration.identity)
            != go_type_identity_key(GoTypeIdentity::Basic("int64")),
    );
    testing::assert_eq(alias.declaration_kind, "alias");
    testing::assert_eq(alias.underlying_kind, "basic");
    testing::assert_eq(
        go_type_identity_key(
            identity_template(
                identity_fixture(
                    "[{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Alias\",\"import_path\":\"host\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"byte\"}]",
                    "a",
                    "alias",
                ),
            ).identity,
        ),
        go_type_identity_key(GoTypeIdentity::Basic("uint8")),
    );
    testing::assert_eq(
        go_type_identity_key(
            identity_template(
                identity_fixture(
                    "[{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Alias\",\"import_path\":\"host\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"rune\"}]",
                    "a",
                    "alias",
                ),
            ).identity,
        ),
        go_type_identity_key(GoTypeIdentity::Basic("int32")),
    );
    testing::assert_eq(
        go_type_identity_key(
            identity_template(
                identity_fixture(
                    "[{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Alias\",\"import_path\":\"host\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"}]",
                    "a",
                    "alias",
                ),
            ).identity,
        ),
        go_type_identity_key(GoTypeIdentity::Basic("int64")),
    );
}

#[test]
fn go_identity_substitutes_generic_alias_arguments_by_position() -> () {
    let template = identity_template(
        identity_fixture(
            "[{\"id\":\"a\",\"tag\":\"alias\",\"name\":\"Reverse\",\"import_path\":\"host\",\"underlying\":\"n\",\"type_parameters\":[\"x\",\"y\"]},{\"id\":\"x\",\"tag\":\"type_parameter\",\"name\":\"X\",\"constraint\":\"c\"},{\"id\":\"y\",\"tag\":\"type_parameter\",\"name\":\"Y\",\"constraint\":\"c\"},{\"id\":\"c\",\"tag\":\"interface\"},{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Pair\",\"import_path\":\"host\",\"underlying\":\"s\",\"type_parameters\":[\"p\",\"q\"],\"type_arguments\":[\"y\",\"ptr\"]},{\"id\":\"p\",\"tag\":\"type_parameter\",\"name\":\"A\",\"constraint\":\"c\"},{\"id\":\"q\",\"tag\":\"type_parameter\",\"name\":\"B\",\"constraint\":\"c\"},{\"id\":\"ptr\",\"tag\":\"pointer\",\"element\":\"x\"},{\"id\":\"s\",\"tag\":\"struct\"}]",
            "a",
            "alias",
        ),
    );
    testing::assert_eq(template.parameter_constraints.len(), 2);
    let applied = substitute_go_type_template(
        template,
        Vec::from_array([GoTypeIdentity::Basic("int64"), GoTypeIdentity::Basic("bool")]),
    ).unwrap_or_else(
        |error| {
            testing::fail(error);
            GoTypeIdentity::Basic("invalid")
        },
    );
    let expected = GoTypeIdentity::Named {
        import_path: "host",
        name: "Pair",
        arguments: Vec::from_array(
            [GoTypeIdentity::Basic("bool"), GoTypeIdentity::Pointer(GoTypeIdentity::Basic("int64"))],
        ),
    };
    testing::assert_eq(go_type_identity_key(applied), go_type_identity_key(expected));
    testing::assert(substitute_go_type_template(template, Vec::new()).is_err());
    let recursive = identity_template(
        identity_fixture(
            "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Box\",\"import_path\":\"host\",\"underlying\":\"s\",\"type_parameters\":[\"p\"]},{\"id\":\"p\",\"tag\":\"type_parameter\",\"name\":\"T\",\"constraint\":\"c\"},{\"id\":\"c\",\"tag\":\"interface\"},{\"id\":\"s\",\"tag\":\"struct\",\"fields\":[{\"name\":\"Next\",\"type\":\"ptr\"}]},{\"id\":\"ptr\",\"tag\":\"pointer\",\"element\":\"n\"}]",
            "n",
            "defined",
        ),
    );
    let applied = substitute_go_type_template(
        recursive,
        Vec::from_array([GoTypeIdentity::Basic("int64")]),
    ).unwrap_or_else(
        |error| {
            testing::fail(error);
            GoTypeIdentity::Basic("invalid")
        },
    );
    testing::assert_eq(
        go_type_identity_key(applied),
        go_type_identity_key(
            GoTypeIdentity::Named {
                import_path: "host",
                name: "Box",
                arguments: Vec::from_array([GoTypeIdentity::Basic("int64")]),
            },
        ),
    );
}

#[test]
fn go_identity_rejects_cycles_unbound_parameters_and_invalid_shapes() -> () {
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"n\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"p\"},{\"id\":\"p\",\"tag\":\"pointer\",\"element\":\"n\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"p\"},{\"id\":\"p\",\"tag\":\"type_parameter\",\"name\":\"T\",\"constraint\":\"c\"},{\"id\":\"c\",\"tag\":\"interface\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"s\"},{\"id\":\"s\",\"tag\":\"struct\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"a\"},{\"id\":\"a\",\"tag\":\"array\",\"element\":\"b\",\"length\":-1},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"alias\",\"underlying\":\"a\"},{\"id\":\"a\",\"tag\":\"channel\",\"element\":\"b\",\"direction\":\"invalid\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int\"}]",
                "n",
                "alias",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Box\",\"import_path\":\"host\",\"underlying\":\"s\",\"type_parameters\":[\"p\",\"p\"]},{\"id\":\"p\",\"tag\":\"type_parameter\",\"name\":\"T\",\"constraint\":\"c\"},{\"id\":\"c\",\"tag\":\"interface\"},{\"id\":\"s\",\"tag\":\"struct\"}]",
                "n",
                "defined",
            ),
            "test",
        ).is_err(),
    );
    testing::assert(
        resolve_go_type_template(
            identity_fixture(
                "[{\"id\":\"n\",\"tag\":\"named\",\"name\":\"Broken\",\"underlying\":\"b\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int\"}]",
                "n",
                "defined",
            ),
            "test",
        ).is_err(),
    );
}
