package ffi;

use std::testing;

fn function_query_fixture() -> Vec[FunctionQuery] {
    Vec::from_array(
        [
            FunctionQuery {
                id: "identity",
                import_path: "example.com/shim",
                name: "Identity",
                arguments: Vec::from_array([BridgeType::Scalar("int64")]),
            },
        ],
    )
}

fn function_query_response() -> string {
    declaration_response(
        "[{\"id\":\"i\",\"tag\":\"interface\"},{\"id\":\"p\",\"tag\":\"type_parameter\",\"name\":\"T\",\"constraint\":\"i\"},{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"},{\"id\":\"g\",\"tag\":\"signature\",\"type_parameters\":[\"p\"],\"parameters\":[\"p\"],\"results\":[\"p\"]},{\"id\":\"f\",\"tag\":\"signature\",\"parameters\":[\"b\"],\"results\":[\"b\"]}]",
        "{\"type_id\":\"identity\",\"status\":\"verified\",\"declaration_kind\":\"function\",\"declared_type\":\"g\",\"type\":\"f\"}",
    )
}

#[test]
fn function_queries_validate_finite_instantiation_identity() -> () {
    let Ok(value) = decode_function_queries(function_query_response(), function_query_fixture()) else {
        testing::fail("expected verified function instance");
        return
    };
    testing::assert_eq(value.functions.len(), 1);
    testing::assert_eq(value.metadata.go_world_identity, "world");
    testing::assert(!value.functions[0].variadic);
    testing::assert_eq(value.functions[0].query.name, "Identity");
    testing::assert_eq(
        go_type_identity_key(value.functions[0].signature),
        go_type_identity_key(
            GoTypeIdentity::Function {
                parameters: Vec::from_array([GoTypeIdentity::Basic("int64")]),
                results: Vec::from_array([GoTypeIdentity::Basic("int64")]),
            },
        ),
    );
    for change in Vec::from_array(
        [
            ("\"type\":\"f\"", "\"type\":\"missing\""),
            ("\"name\":\"int64\"", "\"name\":\"bool\""),
            ("\"type\":\"f\"", "\"type\":\"g\""),
            ("\"status\":\"verified\"", "\"status\":\"failed\""),
            ("\"type_id\":\"identity\"", "\"type_id\":\"unknown\""),
            ("\"tag\":\"signature\"", "\"tag\":\"signature\",\"variadic\":true"),
            ("\"tag\":\"signature\"", "\"tag\":\"signature\",\"receiver\":\"b\""),
            ("\"go_world_identity\":\"world\"", "\"go_world_identity\":\"\""),
        ],
    ) {
        testing::assert(
            decode_function_queries(
                function_query_response().replace(change.0, change.1),
                function_query_fixture(),
            ).is_err(),
        );
    }
    let queries = function_query_fixture();
    queries[0].arguments.clear();
    testing::assert(decode_function_queries(function_query_response(), queries).is_err());
}

#[test]
fn function_queries_preserve_variadic_slice_identity() -> () {
    let response = declaration_response(
        "[{\"id\":\"b\",\"tag\":\"basic\",\"name\":\"int64\"},{\"id\":\"s\",\"tag\":\"slice\",\"element\":\"b\"},{\"id\":\"f\",\"tag\":\"signature\",\"parameters\":[\"s\"],\"results\":[\"b\"],\"variadic\":true}]",
        "{\"type_id\":\"sum\",\"status\":\"verified\",\"declaration_kind\":\"function\",\"declared_type\":\"f\",\"type\":\"f\"}",
    );
    let query = FunctionQuery {
        id: "sum",
        import_path: "example.com/shim",
        name: "Sum",
        arguments: Vec::new(),
    };
    let Ok(value) = decode_function_queries(response, Vec::from_array([query])) else {
        testing::fail("expected variadic signature");
        return
    };
    testing::assert(value.functions[0].variadic);
    testing::assert_eq(
        go_type_identity_key(value.functions[0].signature),
        go_type_identity_key(
            GoTypeIdentity::Function {
                parameters: Vec::from_array([GoTypeIdentity::Slice(GoTypeIdentity::Basic("int64"))]),
                results: Vec::from_array([GoTypeIdentity::Basic("int64")]),
            },
        ),
    );
}
