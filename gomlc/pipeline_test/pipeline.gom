package pipeline;

use module::anf;
use module::ast;
use module::cmd::gomlc as compiler_driver;
use module::core;
use module::cst;
use module::go_backend;
use module::hir;
use module::lift;
use module::mono;
use module::parser;
use module::tast;
use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

pub fn repo_root() -> string {
    env::var_structured("GOML_REPO").unwrap_or("..")
}

pub fn fixture_dir(name: string) -> string {
    path::join(path::join(repo_root(), "gomlc/testdata/pipeline"), name)
}

pub fn read_snapshot(base: string, extension: string) -> string {
    let file = path::join(base, "main.gom." + extension);
    match fs::read_file_structured(file) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(f"failed to read {file}: {message}");
            ""
        },
    }
}

fn update_expected() -> bool {
    env::var_structured("UPDATE_EXPECT").is_ok()
}

fn assert_snapshot(base: string, extension: string, actual: string) -> () {
    let file = path::join(base, "main.gom." + extension);
    if update_expected() {
        if let Err(message) = fs::write_file_structured(file, actual) {
            testing::fail(f"failed to write {file}: {message}")
        }
    } else {
        testing::assert_eq(actual, read_snapshot(base, extension))
    }
}

fn has_out_snapshot(base: string) -> bool {
    fs::is_file(path::join(base, "main.gom.out"))
}

fn pipeline_case_insert_index(values: Vec[string], name: string) -> isize {
    for index in 0..values.len() {
        if name < values[index] {
            return index
        }
    }
    values.len()
}

fn tmp_dir() -> string {
    match env::var_structured("TMPDIR") {
        Ok(value) => if value == "" {
            "/tmp"
        } else {
            value
        },
        Err(_) => "/tmp",
    }
}

fn execute_go_and_read_stdout(go_source: string, expected: string, name: string) -> string {
    let work_dir = path::join(path::join(tmp_dir(), "gomlc-pipeline-test"), name);
    if let Err(message) = fs::create_dir_all(work_dir) {
        testing::fail(f"failed to create Go work dir: {message}");
        return ""
    }
    let main_file = path::join(work_dir, "main.go");
    let executable = path::join(work_dir, "main");
    let source_current = if fs::is_file(main_file) {
        match fs::read_file_structured(main_file) {
            Ok(value) => value == go_source,
            Err(_) => false,
        }
    } else {
        false
    };
    if source_current {} else {
        if let Err(message) = fs::write_file_structured(main_file, go_source) {
            testing::fail(f"failed to write Go source: {message}");
            return ""
        }
        if fs::is_file(executable) {
            if let Err(message) = fs::remove_file(executable) {
                testing::fail(f"failed to remove stale executable: {message}");
                return ""
            }
        }
    }
    let interpreted = if source_current && fs::is_file(executable)
        || !go_backend::yaegi_compatible(go_source) {
        Option::None
    } else {
        match process::Command::new("yaegi").arg("main.go").current_dir(work_dir).output_structured() {
            Ok(output) => {
                if process::ExitStatus::success(process::Output::status(output)) {
                    match process::Output::stdout(output).to_string_utf8() {
                        Ok(value) => if value == expected {
                            Option::Some(value)
                        } else {
                            Option::None
                        },
                        Err(_) => Option::None,
                    }
                } else {
                    Option::None
                }
            },
            Err(_) => Option::None,
        }
    };
    if let Some(value) = interpreted {
        return value
    }
    if source_current && fs::is_file(executable) {} else {
        match process::Command::new("go").arg("build").arg("-o").arg("main").arg("main.go").current_dir(
            work_dir,
        ).env("GOWORK", "off").env("GO111MODULE", "off").output_structured() {
            Ok(output) => {
                if process::ExitStatus::success(process::Output::status(output)) {} else {
                    match process::Output::stderr(output).to_string_utf8() {
                        Ok(value) => {
                            testing::fail("go build failed: " + value);
                            return ""
                        },
                        Err(_) => {
                            testing::fail("go build failed (non-UTF-8 stderr)");
                            return ""
                        },
                    }
                }
            },
            Err(message) => {
                testing::fail(f"failed to build Go source: {message}");
                return ""
            },
        }
    }
    match process::Command::new(executable).current_dir(work_dir).output_structured() {
        Ok(output) => {
            if process::ExitStatus::success(process::Output::status(output)) {
                match process::Output::stdout(output).to_string_utf8() {
                    Ok(value) => value,
                    Err(message) => {
                        testing::fail(f"failed to decode Go stdout: {message}");
                        ""
                    },
                }
            } else {
                match process::Output::stderr(output).to_string_utf8() {
                    Ok(value) => {
                        testing::fail("generated program failed: " + value);
                        ""
                    },
                    Err(_) => {
                        testing::fail("generated program failed (non-UTF-8 stderr)");
                        ""
                    },
                }
            }
        },
        Err(message) => {
            testing::fail(f"failed to execute generated program: {message}");
            ""
        },
    }
}

pub fn all_pipeline_cases() -> Vec[string] {
    let result = Vec::new();
    let root = path::join(repo_root(), "gomlc/testdata/pipeline");
    match fs::read_dir(root) {
        Ok(names) => for name in names {
            let directory = path::join(root, name);
            if fs::is_dir(directory) && fs::is_file(path::join(directory, "main.gom")) {
                let index = pipeline_case_insert_index(result, name);
                if index == result.len() {
                    result.push(name)
                } else {
                    result.insert(index, name)
                }
            }
        },
        Err(message) => {
            testing::fail(f"failed to read pipeline fixtures: {message}")
        },
    }
    result
}

fn test_one_case(compiler: compiler_driver::SourceCompiler, name: string) -> () {
    let base = fixture_dir(name);
    let source_path = path::join(base, "main.gom");
    let new_fixture = !fs::is_file(path::join(base, "main.gom.cst"));
    let source = match fs::read_file_structured(source_path) {
        Ok(value) => value,
        Err(message) => {
            testing::fail(f"failed to read {source_path}: {message}");
            ""
        },
    };
    let parsed = parser::parse(source);
    assert_snapshot(base, "cst", cst::debug_tree(parsed));
    let compilation = compiler_driver::compile_source_with(compiler, source_path, source);
    assert_snapshot(base, "ast", ast::pretty(compilation.ast_value));
    assert_snapshot(base, "hir", hir::encode(compilation.hir_value));
    assert_snapshot(base, "tast", tast::encode(compilation.tast_value));
    assert_snapshot(base, "core", core::encode_snapshot(compilation.core_value));
    assert_snapshot(base, "mono", mono::encode_snapshot(compilation.mono_value));
    assert_snapshot(base, "lift", lift::encode_snapshot(compilation.lift_value));
    assert_snapshot(base, "anf", anf::encode_snapshot(compilation.anf_value));
    let go_source = go_backend::encode(compilation.go_value);
    assert_snapshot(base, "go", go_source);
    if has_out_snapshot(base) || (update_expected() && new_fixture) {
        assert_snapshot(
            base,
            "out",
            execute_go_and_read_stdout(
                go_source,
                if has_out_snapshot(base) {
                    read_snapshot(base, "out")
                } else {
                    ""
                },
                name,
            ),
        )
    }
}

pub fn test_pipeline_shard(shard: isize, shard_count: isize) -> () {
    let names: Vec[string] = Vec::new();
    let compiler_sources = Vec::new();
    let index = Ref::new(0);
    for name in all_pipeline_cases() {
        let current = index.get();
        if current % shard_count == shard {
            names.push(name);
            let source = match fs::read_file_structured(path::join(fixture_dir(name), "main.gom")) {
                Ok(value) => value,
                Err(message) => {
                    testing::fail(message.to_string());
                    ""
                },
            };
            compiler_sources.push(source)
        }
        index.set(current + 1)
    }
    let compiler = compiler_driver::source_compiler_for_sources(compiler_sources);
    for name in names {
        test_one_case(compiler, name)
    }
}
