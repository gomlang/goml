package pipeline;

use std::testing;

#[test]
fn changed_go_source_invalidates_cached_executable() -> () {
    let old_source =
        \\package main
        \\
        \\import "fmt"
        \\
        \\func main() {
        \\Loop:
        \\    select {
        \\    default:
        \\        fmt.Println("old")
        \\        break Loop
        \\    }
        \\}
        \\
    ;
    let new_source =
        \\package main
        \\
        \\import "fmt"
        \\
        \\func main() {
        \\    fmt.Println("new")
        \\}
        \\
    ;
    testing::assert(
        execute_go_and_read_stdout(old_source, "old\n", "cache_invalidation") == "old\n",
    );
    testing::assert(
        execute_go_and_read_stdout(new_source, "new\n", "cache_invalidation") == "new\n",
    );
    testing::assert(
        execute_go_and_read_stdout(new_source, "new\n", "cache_invalidation") == "new\n",
    )
}

