package expand;

use module::ast;
use module::ctir;
use module::parser;
use std::testing;

fn derive_export_module(package_name: string, export_name: string) -> ctir::CtModule {
    let module = ctir::empty_module(package_name);
    module.derive_entries.push(
        ctir::CtDeriveEntry {
            name: package_name + "::handler",
            function_id: 0,
            public: true,
            export_name: Option::Some(export_name),
        },
    );
    module
}

#[test]
fn rejects_ambiguous_imported_derive_names() -> () {
    let expanded = expand_derives_with_environment(
        ast::lower(
            parser::parse(
                "use alice::first as first; use first::Label; use bob::second as second; use second::Label; #[derive(Label)] struct Value {}",
            ),
        ),
        DeriveEnvironment {
            local: Option::None,
            builtin: Option::None,
            dependencies: Vec::from_array(
                [
                    derive_export_module("alice::first", "Label"),
                    derive_export_module("bob::second", "Label"),
                ],
            ),
            reexports: Vec::new(),
        },
    );
    testing::assert_eq(expanded.diagnostics.len(), 1);
    testing::assert_eq(
        expanded.diagnostics[0].message,
        "derive name `Label` is ambiguous; use a package-qualified name or an import alias",
    )
}
