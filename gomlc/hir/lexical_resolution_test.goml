package hir;

use std::testing;

#[test]
fn lexical_resolution_does_not_export_task_scope_bindings() -> () {
    let file = lowered_file(
        "use std::task; fn run() -> isize { let _ = scope { let hidden = 1; hidden }; hidden }",
    );
    match file.items[0] {
        Function(value) => match value.body.tail {
            Some(Expr { kind: NameRef { name_ref: Unresolved(name) }, .. }) => {
                testing::assert_eq(name, "hidden");
            },
            _ => testing::fail("task scope binding must not be visible outside its block"),
        },
        _ => testing::fail("expected function"),
    }
}
