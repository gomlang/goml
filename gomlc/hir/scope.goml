package hir;

use module::ast;
use module::imports;

struct LocalScope {
    bindings: Vec[(string, LocalId)],
}

struct ConstantSource {
    name: string,
    value: ast::Expr,
    aliases: Vec[imports::AliasEntry],
}

fn empty_scope() -> LocalScope {
    LocalScope { bindings: Vec::new() }
}

fn child_scope(parent: LocalScope) -> LocalScope {
    LocalScope { bindings: copy_bindings(parent.bindings) }
}

fn lookup_local(scope: LocalScope, name: string) -> Option[LocalId] {
    find_binding(scope.bindings, name)
}

fn bind_local(scope: LocalScope, name: string, local: LocalId) -> () {
    scope.bindings.push((name, local))
}

fn type_path_segments(ctx: LowerCtx, path: ast::Path, params: Vec[string]) -> Vec[string] {
    if !path.segments.is_empty()
        && (path.segments[0].ident == "Self" || params.contains(path.segments[0].ident)) {
        imports::path_segments(path)
    } else {
        qualified_segments(ctx, path)
    }
}

fn constant_context(ctx: LowerCtx, source: ConstantSource) -> LowerCtx {
    LowerCtx { file: FileContext { aliases: source.aliases, ..ctx.file }, ..ctx }
}
