package hir;

use module::ast;
use module::cst;
use module::consts;
use module::expand;
use module::imports;
use std::collections;
use std::text;

struct EnumInfo {
    name: string,
    def_id: DefId,
    variants: Vec[string],
}

struct PatternState {
    seen: Vec[(string, LocalId)],
    preferred: Vec[(string, LocalId)],
    constants: bool,
    type_params: Vec[string],
}

struct LexicalScope {
    local: LocalId,
    closure_depth: isize,
}

fn single_path(name: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::new();
    segments.push(ast::PathSegment { ident: name, span: ast::span(0, 0) });
    ast::Path { segments }
}

fn copy_bindings(values: Vec[(string, LocalId)]) -> Vec[(string, LocalId)] {
    let result: Vec[(string, LocalId)] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn is_special_package(package_name: string) -> bool {
    package_name == "main" || package_name == "builtin" || package_name == "prelude"
}

fn full_name(package_name: string, name: string) -> string {
    if is_special_package(package_name) {
        name
    } else {
        package_name + "::" + name
    }
}

fn basename(path: string) -> string {
    let builder = text::StringBuilder::new();
    for character in path.chars() {
        if character == '/' || character == '\\' {
            builder.clear()
        } else {
            builder.write_char(character)
        }
    }
    if builder.is_empty() {
        "<unknown>"
    } else {
        builder.finish()
    }
}

fn import_aliases_from_file(file: ast::File, aliases: Vec[imports::AliasEntry]) -> Vec[ImportAlias] {
    let result: Vec[ImportAlias] = Vec::new();
    for use_decl in file.uses {
        if !use_decl.items.is_empty() {
            let target = imports::path_segments(use_decl.path);
            let target = imports::expand_use_alias(aliases, target).unwrap_or(target);
            result.push(ImportAlias { alias: "", package_name: imports::join_segments(target) })
        }
    }
    for entry in aliases {
        if entry.item {} else {
            result.push(
                ImportAlias {
                    alias: entry.alias,
                    package_name: imports::join_segments(entry.target),
                },
            )
        }
    }
    result
}

pub fn source_import_aliases(file: ast::File) -> Vec[ImportAlias] {
    import_aliases_from_file(file, imports::resolved_uses_from_file(file).aliases)
}

fn imports_from_aliases(aliases: Vec[imports::AliasEntry]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for entry in aliases {
        if entry.item {
            result.push(imports::join_segments(entry.target))
        }
    }
    result
}

fn expand_segments(ctx: LowerCtx, path: ast::Path) -> Vec[string] {
    let values = imports::path_segments(path);
    if values.is_empty() || !ctx.file.qualify_imports {
        values
    } else {
        for alias in ctx.file.aliases {
            if alias.alias == values[0] && (alias.item || values.len() > 1) {
                let result: Vec[string] = Vec::new();
                for segment in alias.target {
                    result.push(segment)
                }
                for index in 1..values.len() {
                    result.push(values[index])
                }
                return result
            }
        }
        values
    }
}

fn qualified_segments(ctx: LowerCtx, path: ast::Path) -> Vec[string] {
    let values = expand_segments(ctx, path);
    if ctx.file.qualify_imports && !values.is_empty()
        && ctx.package_env.nominal_types.contains(values[0]) {
        let result: Vec[string] = Vec::new();
        result.push(full_name(ctx.package_env.name, values[0]));
        for index in 1..values.len() {
            result.push(values[index])
        }
        result
    } else {
        values
    }
}

fn path_text(ctx: LowerCtx, path: ast::Path) -> string {
    imports::join_segments(qualified_segments(ctx, path))
}

fn static_member(
    parts: Vec[string],
    owner_type_args: Vec[GenericArg],
    member_type_args: Vec[GenericArg],
) -> ExprKind {
    let owner_parts: Vec[string] = Vec::new();
    if parts.len() > 1 {
        for index in 0..parts.len() - 1 {
            owner_parts.push(parts[index])
        }
    }
    StaticMember {
        owner: imports::join_segments(owner_parts),
        member: imports::last_string(parts).unwrap_or("<error>"),
        owner_type_args,
        member_type_args,
    }
}

fn ast_type_head_span(value: ast::TypeExpr) -> Option[ast::Span] {
    match value {
        Con { path } => if !path.segments.is_empty() {
            Some(path.segments[0].span)
        } else {
            None
        },
        Dyn { bounds } => if !bounds.is_empty() && !bounds[0].trait_path.segments.is_empty() {
            Some(bounds[0].trait_path.segments[0].span)
        } else {
            None
        },
        App { ty, args: _ } => ast_type_head_span(ty),
        _ => None,
    }
}

fn find_binding(values: Vec[(string, LocalId)], name: string) -> Option[LocalId] {
    let mut index = values.len();
    while index > 0 {
        index -= 1;
        let entry = values[index];
        if entry.0 == name {
            return Some(entry.1)
        }
    }
    None
}

fn find_definition(ctx: LowerCtx, name: string) -> Option[DefId] {
    let mut index = ctx.package_env.definitions.len() - 1;
    while index >= 0 {
        let entry = ctx.package_env.definitions[index];
        if entry.0 == name {
            return Some(entry.1)
        } else {
            index -= 1;
        }
    }
    None
}

fn find_constant_definition(ctx: LowerCtx, name: string) -> Option[DefId] {
    let mut index = ctx.package_env.constants.len() - 1;
    while index >= 0 {
        let entry = ctx.package_env.constants[index];
        if entry.0 == name {
            return Some(entry.1)
        } else {
            index -= 1;
        }
    }
    None
}

fn constant_ref(ctx: LowerCtx, path: ast::Path) -> Option[NameRef] {
    let original = imports::path_segments(path);
    let expanded = expand_segments(ctx, path);
    if original.len() != 1 {
        None
    } else if expanded.len() == 1 {
        find_constant_definition(ctx, full_name(ctx.package_env.name, expanded[0])).map(
            |def_id| NameRef::Def(def_id),
        )
    } else {
        None
    }
}

fn fresh_local(ctx: LowerCtx, hint: string) -> LocalId {
    let index = ctx.ids.local.get();
    ctx.ids.local.set(index + 1);
    LocalId { pkg: ctx.package_env.name, index, hint }
}

fn fresh_method(ctx: LowerCtx) -> DefId {
    let index = ctx.ids.method.get();
    ctx.ids.method.set(index + 1);
    source_definition(ctx.package_env.name, index)
}

fn enum_variant(info: EnumInfo, name: string) -> Option[isize] {
    let mut index = info.variants.len() - 1;
    while index >= 0 {
        if info.variants[index] == name {
            return Some(index)
        } else {
            index -= 1;
        }
    }
    None
}

fn path_has_type_parameter_owner(path: ast::Path, type_params: Vec[string]) -> bool {
    !path.segments.is_empty()
        && (path.segments[0].ident == "Self" || type_params.contains(path.segments[0].ident))
}

fn scoped_value_ref(env: LocalScope, path: ast::Path, type_params: Vec[string]) -> Option[NameRef] {
    if path.segments.len() != 1 {
        return None
    }
    let name = path.segments[0].ident;
    if let Some(local) = lookup_local(env, name) {
        Some(NameRef::Local(local))
    } else if type_params.contains(consts::parameter(name)) {
        Some(NameRef::ConstParam(name))
    } else {
        None
    }
}

fn constructor_ref(ctx: LowerCtx, path: ast::Path, type_params: Vec[string]) -> Option[
    ConstructorRef,
] {
    if path.segments.is_empty() || path_has_type_parameter_owner(path, type_params) {
        return None
    }
    let parts = expand_segments(ctx, path);
    if parts.len() == 1 {
        let matches: Vec[(DefId, isize)] = Vec::new();
        for info in ctx.package_env.enums {
            if let Some(index) = enum_variant(info, parts[0]) {
                matches.push((info.def_id, index))
            }
        }
        if matches.len() == 1 {
            let value = matches[0];
            Some(ConstructorRef::Resolved { enum_def: value.0, variant_index: value.1 })
        } else {
            None
        }
    } else {
        let variant = parts[parts.len() - 1];
        let enum_name = if parts.len() == 2 {
            parts[0]
        } else {
            let names: Vec[string] = Vec::new();
            for index in 1..parts.len() - 1 {
                names.push(parts[index])
            }
            imports::join_segments(names)
        };
        let package_matches = parts.len() == 2 || parts[0] == ctx.package_env.name;
        if package_matches {
            let mut index = ctx.package_env.enums.len() - 1;
            while index >= 0 {
                let info = ctx.package_env.enums[index];
                if info.name == enum_name {
                    match enum_variant(info, variant) {
                        Some(variant_index) => return Some(
                            ConstructorRef::Resolved { enum_def: info.def_id, variant_index },
                        ),
                        None => {
                            index -= 1;
                        },
                    }
                } else {
                    index -= 1;
                }
            }
            None
        } else {
            None
        }
    }
}

fn unresolved_constructor(ctx: LowerCtx, path: ast::Path, type_params: Vec[string]) -> ConstructorRef {
    constructor_ref(ctx, path, type_params).unwrap_or_else(
        || ConstructorRef::Unresolved(
            imports::join_segments(type_path_segments(ctx, path, type_params)),
        ),
    )
}

fn pattern_head_span(path: ast::Path) -> ast::Span {
    if path.segments.is_empty() {
        ast::span(0, 0)
    } else {
        path.segments[path.segments.len() - 1].span
    }
}

fn pattern_head(ctx: LowerCtx, path: ast::Path, type_params: Vec[string]) -> PatternHead {
    let span = pattern_head_span(path);
    if path.segments.len() == 1 {
        Contextual { name: path.segments[0].ident, span }
    } else {
        match constructor_ref(ctx, path, type_params) {
            Some(Resolved { enum_def, variant_index }) => PatternHead::Resolved {
                enum_def,
                variant_index,
                span,
            },
            Some(Unresolved(name)) => {
                Qualified { name, span }
            },
            None => Qualified {
                name: imports::join_segments(type_path_segments(ctx, path, type_params)),
                span,
            },
        }
    }
}

fn lower_predicate(ctx: LowerCtx, value: ast::Predicate, type_params: Vec[string]) -> Predicate {
    match value {
        Trait { ty, trait_ref } => Trait {
            ty: lower_type(ctx, ty, type_params),
            trait_ref: lower_trait_ref(ctx, trait_ref, type_params),
        },
        Equality { lhs, rhs } => Equality {
            lhs: lower_type(ctx, lhs, type_params),
            rhs: lower_type(ctx, rhs, type_params),
        },
    }
}

fn lower_bounds(ctx: LowerCtx, values: Vec[(string, Vec[ast::TraitRef])], type_params: Vec[string]) -> Vec[
    (string, Vec[TraitRef]),
] {
    let result: Vec[(string, Vec[TraitRef])] = Vec::new();
    for value in values {
        let bounds: Vec[TraitRef] = Vec::new();
        for bound in value.1 {
            bounds.push(lower_trait_ref(ctx, bound, type_params))
        }
        result.push((value.0, bounds))
    }
    result
}

fn sort_pattern_names(values: Vec[string]) -> Vec[string] {
    collections::BTreeSet::from_vec(values).to_vec()
}

fn join_pattern_names(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for value in values {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string(value);
        index += 1;
    }
    builder.finish()
}

fn pattern_binding_mismatch(expected: Vec[(string, LocalId)], actual: Vec[(string, LocalId)]) -> Option[
    string,
] {
    let missing: Vec[string] = Vec::new();
    let extra: Vec[string] = Vec::new();
    for value in expected {
        if let None = find_binding(actual, value.0) {
            missing.push(value.0)
        }
    }
    for value in actual {
        if let None = find_binding(expected, value.0) {
            extra.push(value.0)
        }
    }
    if missing.is_empty() && extra.is_empty() {
        None
    } else {
        let details = text::StringBuilder::new();
        if !missing.is_empty() {
            details.write_string("missing ");
            details.write_string(join_pattern_names(sort_pattern_names(missing)))
        }
        if !extra.is_empty() {
            if details.is_empty() {} else {
                details.write_string("; ")
            }
            details.write_string("extra ");
            details.write_string(join_pattern_names(sort_pattern_names(extra)))
        }
        Some("Or-pattern alternatives must bind the same variables: " + details.finish())
    }
}

fn bind_pattern_name(ctx: LowerCtx, env: LocalScope, state: PatternState, name: string) -> LocalId {
    match find_binding(state.seen, name) {
        Some(existing) => {
            ctx.diagnostics.push(
                Diagnostic {
                    message: "Variable " + name + " is bound more than once in the same pattern",
                    span: ctx.body.pattern_span.get(),
                },
            );
            existing
        },
        None => {
            let local = find_binding(state.preferred, name).unwrap_or_else(
                || fresh_local(ctx, name),
            );
            state.seen.push((name, local));
            bind_local(env, name, local);
            local
        },
    }
}

fn lower_pattern_inner(ctx: LowerCtx, value: ast::Pat, env: LocalScope, state: PatternState) -> Pat {
    let span = ast::pat_span(value);
    let previous_span = ctx.body.pattern_span.get();
    ctx.body.pattern_span.set(Option::Some(span));
    let kind = match value {
        Var { name, is_mut, span } => match if state.constants && !is_mut {
            constant_ref(ctx, single_path(name))
        } else {
            None
        } {
            Some(reference) => PatKind::Constant { reference },
            None => match if state.constants && !is_mut {
                constructor_ref(ctx, single_path(name), state.type_params)
            } else {
                None
            } {
                Some(Resolved { enum_def, variant_index }) => PatKind::Constr {
                    head: PatternHead::Resolved { enum_def, variant_index, span },
                    args: Vec::new(),
                },
                None => Var { name: bind_pattern_name(ctx, env, state, name), is_mut },
                Some(Unresolved(_)) => {
                    Var { name: bind_pattern_name(ctx, env, state, name), is_mut }
                },
            },
        },
        Unit { span: _ } => PatKind::Unit,
        Bool { value, span: _ } => PatKind::Bool { value },
        Int { value, span: _ } => PatKind::Int { value },
        Float { value, span: _ } => PatKind::Float { value },
        String { value, span: _ } => PatKind::String { value },
        Char { value, span: _ } => PatKind::Char { value },
        Byte { value, span: _ } => PatKind::Byte { value },
        Constr { constructor: path, args, span: _ } => match if state.constants && args.is_empty() {
            constant_ref(ctx, path)
        } else {
            None
        } {
            Some(reference) => PatKind::Constant { reference },
            None => {
                let result: Vec[Pat] = Vec::new();
                for arg in args {
                    result.push(lower_pattern_inner(ctx, arg, env, state))
                }
                PatKind::Constr { head: pattern_head(ctx, path, state.type_params), args: result }
            },
        },
        Struct { name: path, fields, has_rest, span: _ } => {
            let result: Vec[(string, Pat)] = Vec::new();
            for field in fields {
                result.push((field.0, lower_pattern_inner(ctx, field.1, env, state)))
            }
            PatKind::Struct {
                head: pattern_head(ctx, path, state.type_params),
                fields: result,
                has_rest,
            }
        },
        Tuple { items: values, span: _ } => {
            let result: Vec[Pat] = Vec::new();
            for item in values {
                result.push(lower_pattern_inner(ctx, item, env, state))
            }
            PatKind::Tuple { items: result }
        },
        Array { prefix, rest, suffix, span: _ } => {
            let lowered_prefix: Vec[Pat] = Vec::new();
            for item in prefix {
                lowered_prefix.push(lower_pattern_inner(ctx, item, env, state))
            }
            let lowered_rest = rest.map(
                |value| ArrayPatRest {
                    binding: value.binding.map(|name| bind_pattern_name(ctx, env, state, name)),
                },
            );
            let lowered_suffix: Vec[Pat] = Vec::new();
            for item in suffix {
                lowered_suffix.push(lower_pattern_inner(ctx, item, env, state))
            }
            PatKind::Array { prefix: lowered_prefix, rest: lowered_rest, suffix: lowered_suffix }
        },
        Alias { name, pat, span: _ } => Alias {
            name: bind_pattern_name(ctx, env, state, name),
            pat: lower_pattern_inner(ctx, pat, env, state),
        },
        Or { pats: values, span: _ } => {
            let result: Vec[Pat] = Vec::new();
            if values.is_empty() {
                Or { pats: result }
            } else {
                let base_env = child_scope(env);
                let base_seen = copy_bindings(state.seen);
                result.push(lower_pattern_inner(ctx, values[0], env, state));
                let expected: Vec[(string, LocalId)] = Vec::new();
                for index in base_seen.len()..state.seen.len() {
                    expected.push(state.seen[index])
                }
                for index in 1..values.len() {
                    let branch_env = child_scope(base_env);
                    let branch_state = PatternState {
                        seen: copy_bindings(base_seen),
                        preferred: expected,
                        constants: state.constants,
                        type_params: state.type_params,
                    };
                    result.push(lower_pattern_inner(ctx, values[index], branch_env, branch_state));
                    let actual: Vec[(string, LocalId)] = Vec::new();
                    for binding_index in base_seen.len()..branch_state.seen.len() {
                        actual.push(branch_state.seen[binding_index])
                    }
                    if let Some(message) = pattern_binding_mismatch(expected, actual) {
                        ctx.diagnostics.push(Diagnostic { message, span: Option::Some(span) })
                    }
                }
                Or { pats: result }
            }
        },
        Range { start, end, inclusive, span: _ } => PatKind::Range {
            start: lower_pattern_inner(ctx, start, env, state),
            end: lower_pattern_inner(ctx, end, env, state),
            inclusive,
        },
        Wild { span: _ } => Wild,
    };
    ctx.body.pattern_span.set(previous_span);
    Pat { kind, span }
}

fn lower_pattern(
    ctx: LowerCtx,
    value: ast::Pat,
    env: LocalScope,
    constants: bool,
    type_params: Vec[string],
) -> Pat {
    lower_pattern_inner(
        ctx,
        value,
        env,
        PatternState { seen: Vec::new(), preferred: Vec::new(), constants, type_params },
    )
}

fn lower_block(ctx: LowerCtx, value: ast::Block, env: LocalScope, type_params: Vec[string]) -> Block {
    let env = child_scope(env);
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in value.stmts {
        match stmt {
            Defer { expr, span: _ } => stmts.push(
                Defer { expr: lower_expr(ctx, expr, env, type_params) },
            ),
            Let { is_mut, pat, annotation, value: expr, else_branch, span } => {
                let lowered_expr = lower_expr(ctx, expr, env, type_params);
                let refutable = else_branch.is_some();
                let lowered_else = match else_branch {
                    Some(value) => {
                        Option::Some(lower_expr(ctx, value, child_scope(env), type_params))
                    },
                    None => Option::None,
                };
                let lowered_pat = lower_pattern(ctx, pat, env, refutable, type_params);
                stmts.push(
                    Let {
                        is_mut,
                        pat: lowered_pat,
                        annotation: annotation.map(
                            |ty| lower_type_at(ctx, ty, type_params, Option::Some(span)),
                        ),
                        value: lowered_expr,
                        else_branch: lowered_else,
                    },
                )
            },
            Assign { target, op, value: expr, span: _ } => stmts.push(
                Assign {
                    target: lower_expr(ctx, target, env, type_params),
                    op,
                    value: lower_expr(ctx, expr, env, type_params),
                },
            ),
            Expr { expr, span } => {
                stmts.push(Stmt::Expr { expr: lower_expr(ctx, expr, env, type_params), span })
            },
        }
    }
    Block { stmts, tail: value.tail.map(|expr| lower_expr(ctx, expr, env, type_params)) }
}

fn synthetic_expr(kind: ExprKind, span: ast::Span) -> Expr {
    Expr { kind, span, origin: Origin::Desugared }
}

fn lexical_scope_ref(value: LexicalScope, span: ast::Span) -> Expr {
    synthetic_expr(ExprKind::NameRef { name_ref: NameRef::Local(value.local) }, span)
}

fn lexical_scope_method(value: LexicalScope, method: string, span: ast::Span) -> Expr {
    synthetic_expr(
        Field {
            expr: lexical_scope_ref(value, span),
            field_name: method,
            method_type_args: Vec::new(),
        },
        span,
    )
}

fn lexical_scope_call(value: LexicalScope, method: string, args: Vec[Expr], span: ast::Span) -> Expr {
    synthetic_expr(ExprKind::Call { func: lexical_scope_method(value, method, span), args }, span)
}

fn task_function(name: string, span: ast::Span) -> Expr {
    synthetic_expr(
        StaticMember {
            owner: "std::task",
            member: name,
            owner_type_args: Vec::new(),
            member_type_args: Vec::new(),
        },
        span,
    )
}

fn current_lexical_scope(ctx: LowerCtx) -> Option[LexicalScope] {
    ctx.body.lexical_scopes.peek()
}

fn while_condition_term(value: Expr) -> Expr {
    synthetic_expr(ExprKind::WhileCondition { expr: value }, value.span)
}

fn lower_condition_chain(
    ctx: LowerCtx,
    conditions: Vec[(Option[ast::Pat], ast::Expr)],
    index: isize,
    then_branch: ast::Expr,
    else_branch: Expr,
    env: LocalScope,
    type_params: Vec[string],
    span: ast::Span,
    is_while: bool,
) -> Expr {
    if index == conditions.len() {
        return lower_expr(ctx, then_branch, env, type_params)
    }
    let term = conditions[index];
    let lowered_condition = lower_expr(ctx, term.1, env, type_params);
    let condition = if is_while {
        while_condition_term(lowered_condition)
    } else {
        lowered_condition
    };
    let next_env = child_scope(env);
    let kind = match term.0 {
        Some(pattern) => {
            let pat = lower_pattern(ctx, pattern, next_env, true, type_params);
            let body = lower_condition_chain(
                ctx,
                conditions,
                index + 1,
                then_branch,
                else_branch,
                next_env,
                type_params,
                span,
                is_while,
            );
            ExprKind::Match {
                expr: condition,
                arms: Vec::from_array(
                    [
                        Arm { pat, guard: Option::None, body },
                        Arm {
                            pat: lower_pattern(
                                ctx,
                                ast::Pat::Wild { span },
                                child_scope(env),
                                true,
                                type_params,
                            ),
                            guard: Option::None,
                            body: else_branch,
                        },
                    ],
                ),
            }
        },
        None => ExprKind::If {
            cond: condition,
            then_branch: lower_condition_chain(
                ctx,
                conditions,
                index + 1,
                then_branch,
                else_branch,
                next_env,
                type_params,
                span,
                is_while,
            ),
            else_branch,
        },
    };
    synthetic_expr(kind, span)
}

fn lower_expr_value(ctx: LowerCtx, value: ast::Expr, env: LocalScope, type_params: Vec[string]) -> ExprKind {
    match value {
        Path { path, owner_type_args, member_type_args, span: _ } => {
            if !owner_type_args.is_empty() || !member_type_args.is_empty() {
                let owner_args = lower_generic_args(
                    ctx,
                    owner_type_args,
                    type_params,
                    Some(ast::expr_span(value)),
                );
                let member_args = lower_generic_args(
                    ctx,
                    member_type_args,
                    type_params,
                    Some(ast::expr_span(value)),
                );
                let parts = type_path_segments(ctx, path, type_params);
                let parts = if parts.len() == 1
                    && find_definition(ctx, full_name(ctx.package_env.name, parts[0])).is_some() {
                    Vec::from_array([full_name(ctx.package_env.name, parts[0])])
                } else {
                    parts
                };
                static_member(parts, owner_args, member_args)
            } else {
                if let Some(name_ref) = scoped_value_ref(env, path, type_params) {
                    return ExprKind::NameRef { name_ref }
                }
                match constructor_ref(ctx, path, type_params) {
                    Some(constructor) => ConstructorValue { constructor },
                    None => {
                        let parts = type_path_segments(ctx, path, type_params);
                        if parts.len() == 1 {
                            let name = parts[0];
                            ExprKind::NameRef {
                                name_ref: match find_definition(
                                    ctx,
                                    full_name(ctx.package_env.name, name),
                                ) {
                                    Some(def_id) => Def(def_id),
                                    None => NameRef::Unresolved(name),
                                },
                            }
                        } else {
                            let name = imports::join_segments(parts);
                            match find_definition(ctx, name) {
                                Some(def_id) => ExprKind::NameRef { name_ref: NameRef::Def(def_id) },
                                None => static_member(parts, Vec::new(), Vec::new()),
                            }
                        }
                    },
                }
            }
        },
        Unit { span: _ } => ExprKind::Unit,
        Bool { value, span: _ } => ExprKind::Bool { value },
        Int { value, span: _ } => ExprKind::Int { value },
        Float { value, span: _ } => ExprKind::Float { value },
        String { value, span: _ } => ExprKind::String { value },
        InterpolatedString { parts, span: _ } => {
            let result: Vec[InterpolatedStringPart] = Vec::new();
            for part in parts {
                match part {
                    Text(value) => {
                        result.push(InterpolatedStringPart::Text(value))
                    },
                    Expr(value) => {
                        result.push(
                            InterpolatedStringPart::Expr(lower_expr(ctx, value, env, type_params)),
                        )
                    },
                }
            }
            InterpolatedString { parts: result }
        },
        Char { value, span: _ } => ExprKind::Char { value },
        Byte { value, span: _ } => ExprKind::Byte { value },
        ByteString { values, span: _ } => ByteString { values },
        ConstructorValue { constructor: path, span: _ } => {
            if let Some(name_ref) = scoped_value_ref(env, path, type_params) {
                return ExprKind::NameRef { name_ref }
            }
            match constant_ref(ctx, path) {
                Some(reference) => ExprKind::NameRef { name_ref: reference },
                None => ConstructorValue {
                    constructor: unresolved_constructor(ctx, path, type_params),
                },
            }
        },
        Constr { constructor: path, args, span } => {
            let result: Vec[Expr] = Vec::new();
            for arg in args {
                result.push(lower_expr(ctx, arg, env, type_params))
            }
            match scoped_value_ref(env, path, type_params) {
                Some(name_ref) => Call {
                    func: synthetic_expr(ExprKind::NameRef { name_ref }, span),
                    args: result,
                },
                None => ExprKind::Constr {
                    constructor: unresolved_constructor(ctx, path, type_params),
                    args: result,
                },
            }
        },
        StructLiteral { name: path, fields, base, span: _ } => {
            let result: Vec[(string, Expr)] = Vec::new();
            for field in fields {
                result.push((field.0, lower_expr(ctx, field.1, env, type_params)))
            }
            StructLiteral {
                name: imports::join_segments(type_path_segments(ctx, path, type_params)),
                fields: result,
                base: base.map(|value| lower_expr(ctx, value, env, type_params)),
            }
        },
        Tuple { items: values, span: _ } => {
            let result: Vec[Expr] = Vec::new();
            for item in values {
                result.push(lower_expr(ctx, item, env, type_params))
            }
            ExprKind::Tuple { items: result }
        },
        ArrayRepeat { value, len, span } => ArrayRepeat {
            value: lower_expr(ctx, value, env, type_params),
            len: lower_const_source(ctx, len, type_params, Vec::new(), Option::Some(span)),
        },
        Array { items: values, span: _ } => {
            let result: Vec[Expr] = Vec::new();
            for item in values {
                result.push(lower_expr(ctx, item, env, type_params))
            }
            ExprKind::Array { items: result }
        },
        Closure { params, body, span: _ } => {
            let closure_env = child_scope(env);
            let lowered_params: Vec[ClosureParam] = Vec::new();
            for param in params {
                let local = fresh_local(ctx, param.name);
                bind_local(closure_env, param.name, local);
                lowered_params.push(
                    ClosureParam {
                        name: local,
                        ty: param.ty.map(
                            |ty| lower_type_at(ctx, ty, type_params, Option::Some(param.span)),
                        ),
                        span: param.span,
                    },
                )
            }
            let previous_depth = ctx.body.closure_depth.get();
            ctx.body.closure_depth.set(previous_depth + 1);
            let lowered_body = lower_expr(ctx, body, closure_env, type_params);
            ctx.body.closure_depth.set(previous_depth);
            Closure { params: lowered_params, body: lowered_body }
        },
        Match { expr, arms, span: _ } => {
            let lowered_expr = lower_expr(ctx, expr, env, type_params);
            let lowered_arms: Vec[Arm] = Vec::new();
            for arm in arms {
                let arm_env = child_scope(env);
                let pat = lower_pattern(ctx, arm.pat, arm_env, true, type_params);
                lowered_arms.push(
                    Arm {
                        pat,
                        guard: match arm.guard {
                            Some(guard) => {
                                Some(lower_expr(ctx, guard, arm_env, type_params))
                            },
                            None => None,
                        },
                        body: lower_expr(ctx, arm.body, arm_env, type_params),
                    },
                )
            }
            Match { expr: lowered_expr, arms: lowered_arms }
        },
        Select { mode, arms, span: _ } => {
            let lowered_arms: Vec[SelectArm] = Vec::with_capacity(arms.len());
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, body, span: _ } => {
                        let arm_env = child_scope(env);
                        let local = fresh_local(ctx, binding);
                        if binding != "_" {
                            bind_local(arm_env, binding, local)
                        }
                        lowered_arms.push(
                            Receive {
                                channel: lower_expr(ctx, channel, env, type_params),
                                guard: guard.map(|value| lower_expr(ctx, value, env, type_params)),
                                binding: local,
                                body: lower_expr(ctx, body, arm_env, type_params),
                            },
                        )
                    },
                    Send { channel, value, guard, body, span: _ } => lowered_arms.push(
                        Send {
                            channel: lower_expr(ctx, channel, env, type_params),
                            value: lower_expr(ctx, value, env, type_params),
                            guard: guard.map(|value| lower_expr(ctx, value, env, type_params)),
                            body: lower_expr(ctx, body, child_scope(env), type_params),
                        },
                    ),
                    Default { body, span: _ } => lowered_arms.push(
                        Default { body: lower_expr(ctx, body, child_scope(env), type_params) },
                    ),
                }
            }
            Select { mode, arms: lowered_arms }
        },
        IfChain { conditions, then_branch, else_branch, span } => {
            let otherwise = lower_expr(ctx, else_branch, child_scope(env), type_params);
            lower_condition_chain(
                ctx,
                conditions,
                0,
                then_branch,
                otherwise,
                child_scope(env),
                type_params,
                span,
                false,
            ).kind
        },
        If { cond, then_branch, else_branch, span: _ } => If {
            cond: lower_expr(ctx, cond, env, type_params),
            then_branch: lower_expr(ctx, then_branch, child_scope(env), type_params),
            else_branch: lower_expr(ctx, else_branch, child_scope(env), type_params),
        },
        While { label, cond, body, span: _ } => {
            let lowered_cond = lower_expr(ctx, cond, env, type_params);
            let lowered_body = match body {
                IfChain { conditions, then_branch, else_branch, span } => {
                    let otherwise = lower_expr(ctx, else_branch, child_scope(env), type_params);
                    lower_condition_chain(
                        ctx,
                        conditions,
                        0,
                        then_branch,
                        otherwise,
                        child_scope(env),
                        type_params,
                        span,
                        true,
                    )
                },
                Match { .. } => {
                    let lowered = lower_expr(ctx, body, child_scope(env), type_params);
                    match lowered.kind {
                        Match { expr, arms } => synthetic_expr(
                            Match { expr: while_condition_term(expr), arms },
                            lowered.span,
                        ),
                        _ => lowered,
                    }
                },
                _ => lower_expr(ctx, body, child_scope(env), type_params),
            };
            While { label, cond: lowered_cond, body: lowered_body }
        },
        Loop { label, body, span: _ } => Loop {
            label,
            body: lower_expr(ctx, body, child_scope(env), type_params),
        },
        For { label, pat, iterator, body, span: _ } => {
            let body_env = child_scope(env);
            let lowered_iterator = lower_expr(ctx, iterator, env, type_params);
            let lowered_pat = lower_pattern(ctx, pat, body_env, false, type_params);
            For {
                label,
                pat: lowered_pat,
                iterator: lowered_iterator,
                body: lower_expr(ctx, body, body_env, type_params),
            }
        },
        Break { label, value, span: _ } => Break {
            label,
            value: value.map(|expr| lower_expr(ctx, expr, env, type_params)),
        },
        Continue { label, span: _ } => Continue { label },
        Return { expr, span: _ } => Return {
            expr: expr.map(|value| lower_expr(ctx, value, env, type_params)),
        },
        Go { expr, span: _ } => Go { expr: lower_expr(ctx, expr, env, type_params) },
        Comptime { block, span: _ } => Comptime { block: lower_block(ctx, block, env, type_params) },
        Scope { body, span } => {
            let parent = match current_lexical_scope(ctx) {
                Some(value) => if value.closure_depth == ctx.body.closure_depth.get() {
                    Option::Some(value)
                } else {
                    Option::None
                },
                None => Option::None,
            };
            let local = fresh_local(ctx, "scope");
            let lexical_scope = LexicalScope { local, closure_depth: ctx.body.closure_depth.get() };
            ctx.body.lexical_scopes.push(lexical_scope);
            let lowered_body = lower_expr(ctx, body, env, type_params);
            let _ = ctx.body.lexical_scopes.pop();
            let closure = synthetic_expr(
                Closure {
                    params: Vec::from_array([ClosureParam { name: local, ty: Option::None, span }]),
                    body: lowered_body,
                },
                span,
            );
            let args: Vec[Expr] = Vec::new();
            let function_name = match parent {
                Some(parent_scope) => {
                    args.push(lexical_scope_call(parent_scope, "token", Vec::new(), span));
                    "scope_with"
                },
                None => "scope",
            };
            args.push(closure);
            Call { func: task_function(function_name, span), args }
        },
        Spawn { body, span } => {
            let lowered_body = lower_expr(ctx, body, env, type_params);
            match current_lexical_scope(ctx) {
                Some(lexical_scope) => if lexical_scope.closure_depth
                    == ctx.body.closure_depth.get() {
                    Call {
                        func: lexical_scope_method(lexical_scope, "spawn", span),
                        args: Vec::from_array([lowered_body]),
                    }
                } else {
                    ctx.diagnostics.push(
                        Diagnostic {
                            message: "spawn cannot capture an enclosing lexical scope across a closure boundary; create a nested scope inside the closure",
                            span: Option::Some(span),
                        },
                    );
                    ExprKind::Error
                },
                None => {
                    ctx.diagnostics.push(
                        Diagnostic {
                            message: "spawn requires an enclosing lexical scope",
                            span: Option::Some(span),
                        },
                    );
                    ExprKind::Error
                },
            }
        },
        Call { func, args, span: _ } => {
            let lowered_func = lower_expr(ctx, func, env, type_params);
            let result: Vec[Expr] = Vec::new();
            for arg in args {
                result.push(lower_expr(ctx, arg, env, type_params))
            }
            match lowered_func.kind {
                ConstructorValue { constructor } => ExprKind::Constr { constructor, args: result },
                _ => Call { func: lowered_func, args: result },
            }
        },
        Unary { op, expr, span: _ } => {
            ExprKind::Unary { op, expr: lower_expr(ctx, expr, env, type_params) }
        },
        Cast { expr, ty, span } => Cast {
            expr: lower_expr(ctx, expr, env, type_params),
            ty: lower_type_at(ctx, ty, type_params, Option::Some(span)),
        },
        Try { expr, span: _ } => Try { depth: 0, expr: lower_expr(ctx, expr, env, type_params) },
        Range { start, end, inclusive, span: _ } => ExprKind::Range {
            start: lower_expr(ctx, start, env, type_params),
            end: lower_expr(ctx, end, env, type_params),
            inclusive,
        },
        Binary { op, lhs, rhs, span: _ } => ExprKind::Binary {
            op,
            lhs: lower_expr(ctx, lhs, env, type_params),
            rhs: lower_expr(ctx, rhs, env, type_params),
        },
        Proj { tuple: expr, index, span: _ } => {
            Proj { tuple: lower_expr(ctx, expr, env, type_params), index }
        },
        Field { expr, field_name: field, method_type_args, span } => Field {
            expr: lower_expr(ctx, expr, env, type_params),
            field_name: field,
            method_type_args: lower_generic_args(ctx, method_type_args, type_params, Some(span)),
        },
        Index { base, index, span: _ } => ExprKind::Index {
            base: lower_expr(ctx, base, env, type_params),
            index: lower_expr(ctx, index, env, type_params),
        },
        Block { block, span: _ } => ExprKind::Block {
            block: lower_block(ctx, block, env, type_params),
        },
    }
}

fn lower_expr(ctx: LowerCtx, value: ast::Expr, env: LocalScope, type_params: Vec[string]) -> Expr {
    let span = ast::expr_span(value);
    let result = lower_expr_value(ctx, value, env, type_params);
    let index = ctx.ids.expr.get();
    ctx.ids.expr.set(index + 1);
    Expr {
        kind: match result {
            Try { depth: _, expr } => Try { depth: index, expr },
            _ => result,
        },
        span,
        origin: Origin::Source,
    }
}

fn lower_function(
    ctx: LowerCtx,
    value: ast::Function,
    def_id: DefId,
    name: string,
    inherited_type_params: Vec[string],
) -> Function {
    let ctx = LowerCtx { body: body_context(), ..ctx };
    let has_receiver = !value.params.is_empty() && value.params[0].0 == "self";
    let env = empty_scope();
    let params: Vec[(LocalId, TypeExpr)] = Vec::new();
    let type_params = imports::copy_strings(value.generics);
    for inherited in inherited_type_params {
        type_params.push(inherited)
    }
    for index in 0..value.params.len() {
        let param = value.params[index];
        let local = fresh_local(ctx, param.0);
        bind_local(env, param.0, local);
        params.push(
            (
                local,
                lower_type_at(ctx, param.1, type_params, span_at(value.param_type_spans, index)),
            ),
        )
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params))
    }
    Function {
        def_id,
        attrs: value.attrs,
        visibility: value.visibility,
        name,
        name_span: value.name_span,
        has_receiver,
        generics: lower_generics(value.generics),
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params),
        predicates,
        params,
        ret_ty: value.ret_ty.map(|ty| lower_type_at(ctx, ty, type_params, value.ret_ty_span)),
        body: lower_block(ctx, value.body, env, type_params),
    }
}

fn lower_extern(ctx: LowerCtx, value: ast::ExternFunction, def_id: DefId) -> ExternFunction {
    let type_params = value.generics;
    let params: Vec[(string, TypeExpr)] = Vec::new();
    for param in value.params {
        params.push((param.0, lower_type(ctx, param.1, type_params)))
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params))
    }
    ExternFunction {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_env.name, value.name),
        generics: lower_generics(value.generics),
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params),
        predicates,
        params,
        ret_ty: value.ret_ty.map(|ty| lower_type(ctx, ty, type_params)),
    }
}

fn lower_enum(ctx: LowerCtx, value: ast::EnumDef, def_id: DefId) -> EnumDef {
    let type_params = value.generics;
    let variants: Vec[EnumVariant] = Vec::new();
    for variant in value.variants {
        let fields = match variant.fields {
            Unit => EnumVariantFields::Unit,
            Tuple(types) => {
                let lowered: Vec[TypeExpr] = Vec::new();
                for index in 0..types.len() {
                    lowered.push(
                        lower_type_at(
                            ctx,
                            types[index],
                            type_params,
                            span_at(variant.field_type_spans, index),
                        ),
                    )
                }
                EnumVariantFields::Tuple(lowered)
            },
            Struct(fields) => {
                let lowered: Vec[(string, TypeExpr)] = Vec::new();
                for index in 0..fields.len() {
                    let field = fields[index];
                    lowered.push(
                        (
                            field.0,
                            lower_type_at(
                                ctx,
                                field.1,
                                type_params,
                                span_at(variant.field_type_spans, index),
                            ),
                        ),
                    )
                }
                EnumVariantFields::Struct(lowered)
            },
        };
        variants.push(EnumVariant { name: variant.name, fields })
    }
    EnumDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_env.name, value.name),
        generics: lower_generics(value.generics),
        variants,
    }
}

fn lower_struct(ctx: LowerCtx, value: ast::StructDef, def_id: DefId) -> StructDef {
    let type_params = value.generics;
    let fields: Vec[(string, TypeExpr)] = Vec::new();
    for index in 0..value.fields.len() {
        let field = value.fields[index];
        fields.push(
            (
                field.0,
                lower_type_at(ctx, field.1, type_params, span_at(value.field_type_spans, index)),
            ),
        )
    }
    StructDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_env.name, value.name),
        generics: lower_generics(value.generics),
        newtype: value.newtype,
        fields,
        public_fields: value.public_fields,
        module_fields: value.module_fields,
    }
}

fn lower_type_alias(ctx: LowerCtx, value: ast::TypeAlias, def_id: DefId) -> TypeAlias {
    TypeAlias {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_env.name, value.name),
        generics: lower_generics(value.generics),
        ty: lower_type_at(ctx, value.ty, value.generics, Option::Some(value.ty_span)),
    }
}

fn lower_constant(ctx: LowerCtx, value: ast::Constant, def_id: DefId) -> Constant {
    Constant {
        def_id,
        attrs: value.attrs,
        visibility: value.visibility,
        name: full_name(ctx.package_env.name, value.name),
        ty: lower_type_at(ctx, value.ty, Vec::new(), Option::Some(value.ty_span)),
        value: lower_expr(ctx, value.value, empty_scope(), Vec::new()),
    }
}

fn lower_trait(ctx: LowerCtx, value: ast::TraitDef, def_id: DefId) -> TraitDef {
    let type_params = value.generics;
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params))
    }
    let supertraits: Vec[TraitRef] = Vec::new();
    for trait_ref in value.supertraits {
        supertraits.push(lower_trait_ref(ctx, trait_ref, type_params))
    }
    let associated_types: Vec[AssociatedType] = Vec::new();
    for associated in value.associated_types {
        let bounds: Vec[TraitRef] = Vec::new();
        for bound in associated.bounds {
            bounds.push(lower_trait_ref(ctx, bound, type_params))
        }
        associated_types.push(AssociatedType { name: associated.name, bounds })
    }
    let method_sigs: Vec[TraitMethodSignature] = Vec::new();
    for method in value.method_sigs {
        let method_type_params = imports::append_strings(type_params, method.generics);
        let params: Vec[TypeExpr] = Vec::new();
        for param in method.params {
            params.push(lower_type(ctx, param.1, method_type_params))
        }
        let method_predicates: Vec[Predicate] = Vec::new();
        for predicate in method.predicates {
            method_predicates.push(lower_predicate(ctx, predicate, method_type_params))
        }
        method_sigs.push(
            TraitMethodSignature {
                name: method.name,
                has_receiver: method.has_receiver,
                generics: lower_generics(method.generics),
                generic_bounds: lower_bounds(ctx, method.generic_bounds, method_type_params),
                predicates: method_predicates,
                params,
                ret_ty: lower_type(ctx, method.ret_ty, method_type_params),
                default_name: method.body.map(
                    |_| full_name(
                        ctx.package_env.name,
                        "trait_default#" + value.name + "#" + method.name,
                    ),
                ),
            },
        )
    }
    TraitDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_env.name, value.name),
        generics: lower_generics(value.generics),
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params),
        predicates,
        supertraits,
        associated_types,
        method_sigs,
    }
}

fn lower_impl(ctx: LowerCtx, value: ast::ImplBlock, def_id: DefId) -> ImplBlock {
    let type_params = value.generics;
    let methods: Vec[Function] = Vec::new();
    for method in value.methods {
        methods.push(lower_function(ctx, method, fresh_method(ctx), method.name, type_params))
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params))
    }
    let associated_types: Vec[(string, TypeExpr)] = Vec::new();
    for associated in value.associated_types {
        associated_types.push((associated.0, lower_type(ctx, associated.1, type_params)))
    }
    ImplBlock {
        def_id,
        attrs: value.attrs,
        generics: lower_generics(value.generics),
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params),
        predicates,
        associated_types,
        trait_ref: match value.trait_ref {
            Some(trait_ref) => {
                Some(lower_trait_ref(ctx, trait_ref, type_params))
            },
            None => None,
        },
        for_type: lower_type_at(ctx, value.for_type, type_params, Option::Some(value.for_type_span)),
        methods,
    }
}

fn item_name(package_name: string, value: ast::Item) -> Option[string] {
    match value {
        EnumDef(value) => Some(full_name(package_name, value.name)),
        StructDef(value) => Some(full_name(package_name, value.name)),
        TraitDef(value) => Some(full_name(package_name, value.name)),
        Function(value) => Some(full_name(package_name, value.name)),
        ExternFunction(value) => Some(full_name(package_name, value.name)),
        ExternType(value) => Some(full_name(package_name, value.name)),
        TypeAlias(value) => Some(full_name(package_name, value.name)),
        Constant(value) => Some(full_name(package_name, value.name)),
        Static(value) => Some(full_name(package_name, value.name)),
        ImplBlock(_) => None,
    }
}

fn make_context(files: Vec[ast::File], canonical_package_name: string, qualify_imports: bool) -> LowerCtx {
    let id = canonical_package_name;
    let definitions: Vec[(string, DefId)] = Vec::new();
    let constants: Vec[(string, DefId)] = Vec::new();
    let constant_expressions: Vec[ConstantSource] = Vec::new();
    let enums: Vec[EnumInfo] = Vec::new();
    let nominal_types: Vec[string] = Vec::new();
    let traits: Vec[string] = Vec::new();
    let mut index = 0;
    for file in files {
        let aliases = imports::resolved_uses_from_file(file).aliases;
        for item in file.items {
            let def_id = source_definition(id, index);
            if let Some(name) = item_name(canonical_package_name, item) {
                definitions.push((name, def_id))
            }
            match item {
                Constant(value) => {
                    constant_expressions.push(
                        ConstantSource {
                            name: full_name(canonical_package_name, value.name),
                            value: value.value,
                            aliases,
                        },
                    );
                    constants.push((full_name(canonical_package_name, value.name), def_id))
                },
                Static(value) => {
                    constants.push((full_name(canonical_package_name, value.name), def_id))
                },
                EnumDef(value) => {
                    nominal_types.push(value.name);
                    let variants: Vec[string] = Vec::new();
                    for variant in value.variants {
                        variants.push(variant.name)
                    }
                    enums.push(EnumInfo { name: value.name, def_id, variants })
                },
                ImplBlock(value) if value.trait_ref.is_none() && value.generics.is_empty() => {
                    if let Con { path } = value.for_type {
                        let owner = imports::join_segments(imports::path_segments(path));
                        for method in value.methods {
                            if method.name.starts_with("$associated_const:") {
                                if let Some(expression) = method.body.tail {
                                    let name = owner + "::"
                                        + method.name.byte_slice(18, method.name.byte_len());
                                    constant_expressions.push(
                                        ConstantSource {
                                            name: full_name(canonical_package_name, name),
                                            value: expression,
                                            aliases,
                                        },
                                    )
                                }
                            }
                        }
                    }
                },
                StructDef(value) => nominal_types.push(value.name),
                TypeAlias(value) => nominal_types.push(value.name),
                ExternType(value) => nominal_types.push(value.name),
                TraitDef(value) => traits.push(value.name),
                _ => (),
            }
            index += 1;
        }
    }
    LowerCtx {
        package_env: PackageContext {
            name: canonical_package_name,
            definitions,
            constants,
            constant_expressions,
            enums,
            nominal_types,
            traits,
        },
        file: FileContext { aliases: Vec::new(), qualify_imports },
        ids: LowerIds { local: Ref::new(0), method: Ref::new(index), expr: Ref::new(1) },
        body: body_context(),
        diagnostics: Vec::new(),
    }
}

fn file_context(base: LowerCtx, resolved: imports::ResolvedUses, diagnostics: Vec[Diagnostic]) -> LowerCtx {
    for message in resolved.diagnostics {
        diagnostics.push(Diagnostic { message, span: Option::None })
    }
    for entry in resolved.aliases {
        if entry.item
            && find_definition(base, full_name(base.package_env.name, entry.alias)).is_some() {
            diagnostics.push(
                Diagnostic {
                    message: "Imported item alias " + entry.alias + " conflicts with a local item",
                    span: Option::None,
                },
            )
        }
    }
    LowerCtx {
        package_env: base.package_env,
        file: FileContext { aliases: resolved.aliases, qualify_imports: base.file.qualify_imports },
        ids: base.ids,
        body: body_context(),
        diagnostics,
    }
}

fn lower_file_with_context(
    file: ast::File,
    source_path: string,
    canonical_package_name: string,
    qualify_imports: bool,
    base: LowerCtx,
    item_offset: isize,
    diagnostics: Vec[Diagnostic],
) -> File {
    let resolved = imports::resolved_uses_from_file(file);
    let ctx = file_context(base, resolved, diagnostics);
    let items: Vec[Item] = Vec::new();
    let mut index = item_offset;
    for item in file.items {
        let def_id = source_definition(ctx.package_env.name, index);
        match item {
            EnumDef(value) => items.push(Item::EnumDef(lower_enum(ctx, value, def_id))),
            StructDef(value) => {
                items.push(Item::StructDef(lower_struct(ctx, value, def_id)))
            },
            TraitDef(value) => {
                items.push(Item::TraitDef(lower_trait(ctx, value, def_id)))
            },
            ImplBlock(value) => {
                items.push(Item::ImplBlock(lower_impl(ctx, value, def_id)))
            },
            Function(value) => items.push(
                Function(
                    lower_function(
                        ctx,
                        value,
                        def_id,
                        full_name(ctx.package_env.name, value.name),
                        Vec::new(),
                    ),
                ),
            ),
            ExternFunction(value) => {
                items.push(Item::ExternFunction(lower_extern(ctx, value, def_id)))
            },
            ExternType(value) => {
                items.push(
                    ExternType(
                        ExternType {
                            def_id,
                            attrs: value.attrs,
                            visibility: value.visibility,
                            name: full_name(ctx.package_env.name, value.name),
                            name_span: value.name_span,
                            generics: lower_generics(value.generics),
                        },
                    ),
                )
            },
            TypeAlias(value) => {
                items.push(Item::TypeAlias(lower_type_alias(ctx, value, def_id)))
            },
            Constant(value) => {
                items.push(Item::Constant(lower_constant(ctx, value, def_id)))
            },
            Static(value) => {
                items.push(
                    Static(
                        Static {
                            def_id,
                            attrs: value.attrs,
                            visibility: value.visibility,
                            name: full_name(ctx.package_env.name, value.name),
                            ty: lower_type_at(ctx, value.ty, Vec::new(), Some(value.ty_span)),
                            value: lower_expr(ctx, value.value, empty_scope(), Vec::new()),
                        },
                    ),
                )
            },
        }
        index += 1;
    }
    File {
        package_name: canonical_package_name,
        path: if is_special_package(canonical_package_name) {
            basename(source_path)
        } else {
            canonical_package_name + "/" + basename(source_path)
        },
        source_path,
        imports: imports_from_aliases(resolved.aliases),
        import_aliases: import_aliases_from_file(file, resolved.aliases),
        use_traits: if qualify_imports {
            resolved.traits
        } else {
            Vec::new()
        },
        module_reexports: if qualify_imports {
            resolved.module_reexports
        } else {
            Vec::new()
        },
        public_reexports: if qualify_imports {
            resolved.public_reexports
        } else {
            Vec::new()
        },
        items,
        invalid_self_type_spans: file.invalid_self_type_spans,
    }
}

fn lower_file(
    file: ast::File,
    source_path: string,
    canonical_package_name: string,
    qualify_imports: bool,
    diagnostics: Vec[Diagnostic],
) -> File {
    let files: Vec[ast::File] = Vec::new();
    files.push(file);
    let lowered = lower_file_with_context(
        file,
        source_path,
        canonical_package_name,
        qualify_imports,
        make_context(files, canonical_package_name, qualify_imports),
        0,
        diagnostics,
    );
    if diagnostics.is_empty() {
        for diagnostic in verify_file(lowered, Vec::new()) {
            diagnostics.push(diagnostic)
        }
    }
    lowered
}

fn ast_diagnostics(values: Vec[cst::Diagnostic]) -> Vec[Diagnostic] {
    let result: Vec[Diagnostic] = Vec::new();
    for value in values {
        result.push(
            Diagnostic {
                message: value.message,
                span: Option::Some(ast::span(value.start, value.end)),
            },
        )
    }
    result
}

pub fn lower_expanded(value: ast::LowerResult, source_path: string) -> LowerResult {
    let diagnostics = ast_diagnostics(value.diagnostics);
    match value.ast {
        Some(file) => LowerResult {
            hir: Option::Some(lower_file(file, source_path, file.package_name, false, diagnostics)),
            source_path,
            diagnostics,
        },
        None => {
            if diagnostics.is_empty() {
                diagnostics.push(Diagnostic { message: "AST lowering failed", span: Option::None })
            }
            LowerResult { hir: Option::None, source_path, diagnostics }
        },
    }
}

pub fn lower_expanded_package(
    value: ast::LowerResult,
    source_path: string,
    canonical_package_name: string,
) -> LowerResult {
    let diagnostics = ast_diagnostics(value.diagnostics);
    match value.ast {
        Some(file) => LowerResult {
            hir: Option::Some(
                lower_file(file, source_path, canonical_package_name, true, diagnostics),
            ),
            source_path,
            diagnostics,
        },
        None => {
            if diagnostics.is_empty() {
                diagnostics.push(Diagnostic { message: "AST lowering failed", span: Option::None })
            }
            LowerResult { hir: Option::None, source_path, diagnostics }
        },
    }
}

pub fn lower(value: ast::LowerResult, source_path: string) -> LowerResult {
    lower_expanded(expand::expand_derives(value), source_path)
}

pub fn lower_package(value: ast::LowerResult, source_path: string, canonical_package_name: string) -> LowerResult {
    lower_expanded_package(expand::expand_derives(value), source_path, canonical_package_name)
}

pub fn lower_expanded_package_files(
    values: Vec[(ast::LowerResult, string)],
    canonical_package_name: string,
) -> Vec[LowerResult] {
    let files: Vec[ast::File] = Vec::new();
    for value in values {
        if let Some(file) = value.0.ast {
            files.push(file)
        }
    }
    let base = make_context(files, canonical_package_name, true);
    let mut item_offset = 0;
    let lowered: Vec[LowerResult] = Vec::new();
    for value in values {
        match value.0.ast {
            Some(file) => {
                let diagnostics = ast_diagnostics(value.0.diagnostics);
                lowered.push(
                    LowerResult {
                        hir: Option::Some(
                            lower_file_with_context(
                                file,
                                value.1,
                                canonical_package_name,
                                true,
                                base,
                                item_offset,
                                diagnostics,
                            ),
                        ),
                        source_path: value.1,
                        diagnostics,
                    },
                );
                item_offset = item_offset + file.items.len();
            },
            None => {
                let diagnostics = ast_diagnostics(value.0.diagnostics);
                if diagnostics.is_empty() {
                    diagnostics.push(
                        Diagnostic { message: "AST lowering failed", span: Option::None },
                    )
                }
                lowered.push(LowerResult { hir: Option::None, source_path: value.1, diagnostics })
            },
        }
    }
    let package_files: Vec[File] = Vec::new();
    for value in lowered {
        if let Some(file) = value.hir {
            package_files.push(file)
        }
    }
    for value in lowered {
        if value.diagnostics.is_empty() {
            if let Some(file) = value.hir {
                for diagnostic in verify_file(file, package_files) {
                    value.diagnostics.push(diagnostic)
                }
            }
        }
    }
    lowered
}

pub fn lower_package_files(values: Vec[(ast::LowerResult, string)], canonical_package_name: string) -> Vec[
    LowerResult,
] {
    let expanded: Vec[(ast::LowerResult, string)] = Vec::new();
    for value in values {
        expanded.push((expand::expand_derives(value.0), value.1))
    }
    lower_expanded_package_files(expanded, canonical_package_name)
}
