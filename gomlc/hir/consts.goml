package hir;

use module::ast;
use module::consts;

fn hir_const_value(value: TypeExpr) -> Option[isize] {
    match value {
        Con { name } => consts::value_number(name),
        _ => Option::None,
    }
}

fn const_name_path(name: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::new();
    for part in name.split("::") {
        segments.push(ast::PathSegment { ident: part, span: ast::span(0, 0) })
    }
    ast::Path { segments }
}

fn lower_const_source(ctx: LowerCtx, source: string, params: Vec[string], active: Vec[string]) -> TypeExpr {
    match consts::parse(source) {
        Ok(value) => lower_const_expr(ctx, value, params, active),
        Err(message) => {
            ctx.diagnostics.push(Diagnostic { message, span: Option::None });
            TypeExpr::Con { name: consts::value_name(0) }
        },
    }
}

fn lower_const_expr(ctx: LowerCtx, value: consts::Expr, params: Vec[string], active: Vec[string]) -> TypeExpr {
    match value {
        Value(value) => TypeExpr::Con { name: consts::value_name(value) },
        Name(name) => {
            if params.contains(consts::parameter(name)) {
                return TypeExpr::Con { name: consts::parameter(name) }
            }
            let qualified = path_text(ctx, const_name_path(name));
            let local = full_name(ctx.package_name, name);
            for entry in ctx.constant_expressions {
                if entry.0 == qualified || entry.0 == local {
                    if active.contains(entry.0) {
                        ctx.diagnostics.push(
                            Diagnostic {
                                message: "cyclic array length constant " + name,
                                span: Option::None,
                            },
                        );
                        return TypeExpr::Con { name: consts::value_name(0) }
                    }
                    active.push(entry.0);
                    let result = lower_const_source(
                        ctx,
                        ast::expression_text(entry.1),
                        params,
                        active,
                    );
                    let _ = active.pop();
                    return result
                }
            }
            TypeExpr::Con { name: "$const_name:" + qualified }
        },
        Unary { op, value } => {
            let left = TypeExpr::Con {
                name: consts::value_name(
                    if op == "~" {
                        -1
                    } else {
                        0
                    },
                ),
            };
            let right = lower_const_expr(ctx, value, params, active);
            if op == "+" {
                right
            } else {
                lower_const_operation(
                    ctx,
                    if op == "~" {
                        "^"
                    } else {
                        "-"
                    },
                    left,
                    right,
                )
            }
        },
        Binary { op, left, right } => {
            let left = lower_const_expr(ctx, left, params, active);
            let right = lower_const_expr(ctx, right, params, active);
            lower_const_operation(ctx, op, left, right)
        },
    }
}

fn lower_const_operation(ctx: LowerCtx, op: string, left: TypeExpr, right: TypeExpr) -> TypeExpr {
    if let (Some(left_value), Some(right_value)) = (hir_const_value(left), hir_const_value(right)) {
        match consts::binary(op, left_value, right_value) {
            Ok(value) => return TypeExpr::Con { name: consts::value_name(value) },
            Err(message) => {
                ctx.diagnostics.push(Diagnostic { message, span: Option::None });
                return TypeExpr::Con { name: consts::value_name(0) }
            },
        }
    }
    TypeExpr::App {
        ty: TypeExpr::Con { name: "$const_op:" + op },
        args: Vec::from_array([left, right]),
    }
}
