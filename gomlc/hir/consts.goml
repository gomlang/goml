package hir;

use module::ast;
use module::consts;

fn const_name_path(name: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::new();
    for part in name.split("::") {
        segments.push(ast::PathSegment { ident: part, span: ast::span(0, 0) })
    }
    ast::Path { segments }
}

fn lower_const_source(
    ctx: LowerCtx,
    source: string,
    params: Vec[string],
    active: Vec[string],
    span: Option[ast::Span],
) -> ConstExpr {
    match consts::parse(source) {
        Ok(value) => lower_const_expr(ctx, value, params, active, span),
        Err(message) => {
            ctx.diagnostics.push(Diagnostic { message, span });
            ConstExpr { kind: ConstKind::Error, span }
        },
    }
}

fn lower_const_expr(
    ctx: LowerCtx,
    value: consts::Expr,
    params: Vec[string],
    active: Vec[string],
    span: Option[ast::Span],
) -> ConstExpr {
    let kind = match value {
        Value(value) => Value(value),
        Name(name) => {
            if params.contains(consts::parameter(name)) {
                return ConstExpr { kind: ConstKind::Param(name), span }
            }
            let qualified = path_text(ctx, const_name_path(name));
            let local = full_name(ctx.package_env.name, name);
            for entry in ctx.package_env.constant_expressions {
                if entry.name == qualified || entry.name == local {
                    if active.contains(entry.name) {
                        ctx.diagnostics.push(
                            Diagnostic { message: "cyclic array length constant " + name, span },
                        );
                        return ConstExpr { kind: ConstKind::Error, span }
                    }
                    active.push(entry.name);
                    let result = lower_const_source(
                        constant_context(ctx, entry),
                        ast::expression_text(entry.value),
                        Vec::new(),
                        active,
                        span,
                    );
                    let _ = active.pop();
                    return result
                }
            }
            Reference(qualified)
        },
        Unary { op, value } => {
            let inner = lower_const_expr(ctx, value, params, active, span);
            match inner.kind {
                Value(number) => if op == "+" {
                    Value(number)
                } else {
                    let operation = if op == "~" {
                        "^"
                    } else {
                        "-"
                    };
                    let left = if op == "~" {
                        -1
                    } else {
                        0
                    };
                    const_operation_kind(
                        ctx,
                        operation,
                        ConstExpr { kind: ConstKind::Value(left), span },
                        inner,
                        span,
                    )
                },
                Error => ConstKind::Error,
                _ => ConstKind::Unary { op, value: inner },
            }
        },
        Binary { op, left, right } => const_operation_kind(
            ctx,
            op,
            lower_const_expr(ctx, left, params, active, span),
            lower_const_expr(ctx, right, params, active, span),
            span,
        ),
    };
    ConstExpr { kind, span }
}

fn const_operation_kind(
    ctx: LowerCtx,
    op: string,
    left: ConstExpr,
    right: ConstExpr,
    span: Option[ast::Span],
) -> ConstKind {
    match (left.kind, right.kind) {
        (Value(left), Value(right)) => match consts::binary(op, left, right) {
            Ok(value) => Value(value),
            Err(message) => {
                ctx.diagnostics.push(Diagnostic { message, span });
                ConstKind::Error
            },
        },
        (Error, _) | (_, Error) => ConstKind::Error,
        _ => ConstKind::Binary { op, left, right },
    }
}
