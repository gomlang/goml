package hir;

use module::ast;
use module::imports;
use std::collections;

struct PackageContext {
    name: string,
    definitions: Vec[(string, DefId)],
    constants: Vec[(string, DefId)],
    constant_expressions: Vec[ConstantSource],
    enums: Vec[EnumInfo],
    nominal_types: Vec[string],
    traits: Vec[string],
}

struct FileContext {
    aliases: Vec[imports::AliasEntry],
    qualify_imports: bool,
}

struct LowerIds {
    local: Ref[isize],
    method: Ref[isize],
    expr: Ref[isize],
}

struct BodyContext {
    pattern_span: Ref[Option[ast::Span]],
    lexical_scopes: collections::Stack[LexicalScope],
    closure_depth: Ref[isize],
}

struct LowerCtx {
    package_env: PackageContext,
    file: FileContext,
    ids: LowerIds,
    body: BodyContext,
    diagnostics: Vec[Diagnostic],
}

fn body_context() -> BodyContext {
    BodyContext {
        pattern_span: Ref::new(Option::None),
        lexical_scopes: collections::Stack::new(),
        closure_depth: Ref::new(0),
    }
}
