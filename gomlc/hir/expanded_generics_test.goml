package hir;

use module::ast;
use module::parser;
use std::testing;

#[test]
fn expanded_trait_defaults_preserve_const_generic_arguments() -> () {
    let result = lower(
        ast::lower(parser::parse("trait Limit[T, const N: usize] { fn size(self) -> usize { N } }")),
        "main.goml",
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    let file = testing::expect_some(result.hir, "expected HIR");
    let Function(function) = file.items[1] else {
        testing::fail("expected expanded trait default function");
        return
    };
    match function.generics[1] {
        Const { name } => testing::assert_eq(name, "N"),
        _ => testing::fail("expected const generic declaration"),
    }
    let bound = function.generic_bounds[0];
    testing::assert_eq(bound.0, "Self");
    let reference = bound.1[0];
    match reference.args[0] {
        Type(TypeExpr { kind: Param { name }, .. }) => testing::assert_eq(name, "T"),
        _ => testing::fail("expected type parameter argument"),
    }
    match reference.args[1] {
        Const(ConstExpr { kind: Param(name), .. }) => testing::assert_eq(name, "N"),
        _ => testing::fail("expected structured const parameter argument"),
    }
    testing::assert(!encode(result).contains("$const_param:"));
}
