package hir;

use module::ast;
use module::parser;
use std::testing;

fn assert_type_source(source: string, value: TypeExpr, expected: string) -> () {
    let span = testing::expect_some(value.span, "expected type source location");
    testing::assert_eq(source.byte_slice(span.start, span.end), expected);
}

#[test]
fn type_model_distinguishes_generic_bindings_from_package_definitions() -> () {
    let source = "struct T { value: isize } fn identity[T](value: T) -> T { value } fn concrete(value: T) -> T { value }";
    let file = lowered_package_file(source, "example::types");
    match file.items[1] {
        Function(value) => {
            match value.generics[0] {
                Type { name } => testing::assert_eq(name, "T"),
                _ => testing::fail("expected a type parameter"),
            }
            let parameter = value.params[0].1;
            assert_type_source(source, parameter, "T");
            match parameter.kind {
                Param { name } => testing::assert_eq(name, "T"),
                _ => testing::fail("generic binding must shadow the package type"),
            }
            let result = testing::expect_some(value.ret_ty, "expected return annotation");
            assert_type_source(source, result, "T");
            match result.kind {
                Param { name } => testing::assert_eq(name, "T"),
                _ => testing::fail("expected generic return type"),
            }
        },
        _ => testing::fail("expected generic function"),
    }
    match file.items[2] {
        Function(value) => match value.params[0].1.kind {
            Named { reference: Definition { definition, name } } => {
                testing::assert_eq(name, "example::types::T");
                testing::assert(same_definition(definition, source_definition("example::types", 0)));
            },
            _ => testing::fail("expected a resolved package type"),
        },
        _ => testing::fail("expected concrete function"),
    }
}

#[test]
fn type_model_preserves_const_expression_structure_and_locations() -> () {
    let source = "fn repeat[T, const N: usize](value: T) -> [T; N + 1] { [value; N + 1] }";
    let result = lower(ast::lower(parser::parse(source)), "main.goml");
    testing::assert_eq(result.diagnostics.len(), 0);
    let file = testing::expect_some(result.hir, "expected HIR");
    match file.items[0] {
        Function(value) => {
            match value.generics[1] {
                Const { name } => testing::assert_eq(name, "N"),
                _ => testing::fail("expected a const parameter"),
            }
            let return_type = testing::expect_some(value.ret_ty, "expected return annotation");
            assert_type_source(source, return_type, "[");
            match return_type.kind {
                Array { elem, len } => {
                    assert_type_source(source, elem, "T");
                    match len.kind {
                        Binary { op, left, right } => {
                            testing::assert_eq(op, "+");
                            match left.kind {
                                Param(name) => testing::assert_eq(name, "N"),
                                _ => testing::fail("expected const parameter reference"),
                            }
                            match right.kind {
                                Value(value) => testing::assert_eq(value, 1),
                                _ => testing::fail("expected const integer value"),
                            }
                        },
                        _ => testing::fail("expected structured array length"),
                    }
                },
                _ => testing::fail("expected an array type"),
            }
            match value.body.tail {
                Some(Expr { kind: ArrayRepeat { len, .. }, origin: Source, .. }) => {
                    let span = testing::expect_some(len.span, "expected repeat length location");
                    testing::assert(source.byte_slice(span.start, span.end).contains("N + 1"));
                },
                _ => testing::fail("expected source array repetition"),
            }
        },
        _ => testing::fail("expected repetition function"),
    }
    let rendered = encode(result);
    testing::assert(rendered.contains("const N: usize"));
    testing::assert(!rendered.contains("$const"));
    testing::assert(!rendered.contains("$array_repeat"));
}

fn assert_projection_type_argument(value: TypeExpr, self_type: bool) -> () {
    let App { args, .. } = value.kind else {
        testing::fail("expected type application");
        return
    };
    let GenericArg::Type(argument) = args[0] else {
        testing::fail("associated type arguments must be resolved as types");
        return
    };
    let Projection { base, associated } = argument.kind else {
        testing::fail("expected associated type projection");
        return
    };
    testing::assert_eq(associated, "Item");
    match base.kind {
        SelfType => testing::assert(self_type),
        Param { name } => {
            testing::assert(!self_type);
            testing::assert_eq(name, "T");
        },
        _ => testing::fail("projection base must retain its lexical binding"),
    }
}

#[test]
fn type_model_preserves_associated_projections_in_generic_arguments() -> () {
    let file = lowered_file(
        "trait Source { type Item; fn get(self) -> Option[Self::Item]; } fn wrap[T: Source](value: Option[T::Item]) -> Option[T::Item] { value }",
    );
    match file.items[0] {
        TraitDef(value) => assert_projection_type_argument(value.method_sigs[0].ret_ty, true),
        _ => testing::fail("expected source trait"),
    }
    match file.items[1] {
        Function(value) => {
            assert_projection_type_argument(value.params[0].1, false);
            assert_projection_type_argument(
                testing::expect_some(value.ret_ty, "expected function return type"),
                false,
            );
        },
        _ => testing::fail("expected generic function"),
    }
}
