package hir;

pub struct LocalId {
    pub pkg: string,
    pub index: isize,
    pub hint: string,
}

pub enum DefId {
    Source {
        package_name: string,
        index: isize,
    },
    External {
        name: string,
    },
}

pub fn source_definition(package_name: string, index: isize) -> DefId {
    DefId::Source { package_name, index }
}

pub fn external_definition(name: string) -> DefId {
    External { name }
}

pub fn same_definition(left: DefId, right: DefId) -> bool {
    match (left, right) {
        (
            DefId::Source { package_name: left_package, index: left_index },
            DefId::Source { package_name: right_package, index: right_index },
        ) => left_package == right_package && left_index == right_index,
        (External { name: left_name }, External { name: right_name }) => {
            left_name == right_name
        },
        _ => false,
    }
}

pub fn same_local(left: LocalId, right: LocalId) -> bool {
    left.pkg == right.pkg && left.index == right.index
}

pub fn definition_key(value: DefId) -> string {
    match value {
        DefId::Source { package_name, index } => {
            "source:" + package_name.len().to_string() + ":" + package_name + ":"
                + index.to_string()
        },
        External { name } => "external:" + name,
    }
}
