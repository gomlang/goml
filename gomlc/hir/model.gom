package hir;

use module::ast;

pub struct LocalId {
    pub pkg: isize,
    pub index: isize,
    pub hint: string,
}

pub struct DefId {
    pub pkg: isize,
    pub index: isize,
}

pub struct ImportAlias {
    pub alias: string,
    pub package_name: string,
}

pub enum NameRef {
    Local(LocalId),
    Def(DefId),
    Other(string),
}

pub enum ConstructorRef {
    Resolved {
        enum_def: DefId,
        variant_index: isize,
    },
    Unresolved(string),
}

pub enum PatternHead {
    Resolved {
        enum_def: DefId,
        variant_index: isize,
        span: ast::Span,
    },
    Qualified {
        name: string,
        span: ast::Span,
    },
    Contextual {
        name: string,
        span: ast::Span,
    },
}

pub enum TypeExpr {
    Unit,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Tuple {
        items: Vec[TypeExpr],
    },
    Con {
        name: string,
    },
    Projection {
        base: TypeExpr,
        associated: string,
    },
    Dyn {
        bounds: Vec[DynTraitBound],
    },
    App {
        ty: TypeExpr,
        args: Vec[TypeExpr],
    },
    Array {
        len: string,
        elem: TypeExpr,
    },
    Func {
        params: Vec[TypeExpr],
        ret_ty: TypeExpr,
    },
}

pub struct DynTraitBound {
    pub trait_name: string,
    pub args: Vec[TypeExpr],
    pub associated_types: Vec[(string, TypeExpr)],
}

pub struct TraitRef {
    pub name: string,
    pub args: Vec[TypeExpr],
    pub arg_spans: Vec[Option[ast::Span]],
}

pub enum Predicate {
    Trait {
        ty: TypeExpr,
        trait_ref: TraitRef,
    },
    Equality {
        lhs: TypeExpr,
        rhs: TypeExpr,
    },
}

pub struct AssociatedType {
    pub name: string,
    pub bounds: Vec[TraitRef],
}

pub struct TraitMethodSignature {
    pub name: string,
    pub has_receiver: bool,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[TypeExpr],
    pub ret_ty: TypeExpr,
    pub ret_ty_span: Option[ast::Span],
    pub default_name: Option[string],
}

pub struct ClosureParam {
    pub name: LocalId,
    pub ty: Option[TypeExpr],
    pub span: ast::Span,
}

pub struct Function {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub visibility: ast::Visibility,
    pub name: string,
    pub name_span: ast::Span,
    pub has_receiver: bool,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(LocalId, TypeExpr)],
    pub param_type_spans: Vec[ast::Span],
    pub ret_ty: Option[TypeExpr],
    pub ret_ty_span: Option[ast::Span],
    pub body: Block,
}

pub struct ExternFunction {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub params: Vec[(string, TypeExpr)],
    pub ret_ty: Option[TypeExpr],
}

pub struct EnumDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariant],
}

pub struct EnumVariant {
    pub name: string,
    pub fields: EnumVariantFields,
    pub field_type_spans: Vec[ast::Span],
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[TypeExpr]),
    Struct(Vec[(string, TypeExpr)]),
}

pub struct StructDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub newtype: bool,
    pub fields: Vec[(string, TypeExpr)],
    pub field_type_spans: Vec[ast::Span],
    pub public_fields: Vec[string],
}

pub struct TypeAlias {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub ty: TypeExpr,
    pub ty_span: ast::Span,
}

pub struct Constant {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub visibility: ast::Visibility,
    pub name: string,
    pub ty: TypeExpr,
    pub ty_span: ast::Span,
    pub value: Expr,
}

pub struct Static {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub visibility: ast::Visibility,
    pub name: string,
    pub ty: TypeExpr,
    pub ty_span: ast::Span,
    pub value: Expr,
}

pub struct TraitDef {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub name: string,
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub supertraits: Vec[TraitRef],
    pub associated_types: Vec[AssociatedType],
    pub method_sigs: Vec[TraitMethodSignature],
}

pub struct ImplBlock {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub generics: Vec[string],
    pub generic_bounds: Vec[(string, Vec[TraitRef])],
    pub predicates: Vec[Predicate],
    pub associated_types: Vec[(string, TypeExpr)],
    pub trait_ref: Option[TraitRef],
    pub for_type: TypeExpr,
    pub for_type_span: ast::Span,
    pub methods: Vec[Function],
}

pub struct ExternType {
    pub def_id: DefId,
    pub attrs: Vec[ast::Attribute],
    pub visibility: ast::Visibility,
    pub name: string,
    pub name_span: ast::Span,
    pub generics: Vec[string],
}

pub enum Item {
    EnumDef(EnumDef),
    StructDef(StructDef),
    TraitDef(TraitDef),
    ImplBlock(ImplBlock),
    Function(Function),
    ExternFunction(ExternFunction),
    ExternType(ExternType),
    TypeAlias(TypeAlias),
    Constant(Constant),
    Static(Static),
}

pub struct File {
    pub package_name: string,
    pub path: string,
    pub source_path: string,
    pub imports: Vec[string],
    pub import_aliases: Vec[ImportAlias],
    pub use_traits: Vec[string],
    pub public_reexports: Vec[(string, string)],
    pub items: Vec[Item],
    pub invalid_self_type_spans: Vec[ast::Span],
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
}

pub enum Stmt {
    Defer {
        expr: Expr,
    },
    Let {
        is_mut: bool,
        pat: Pat,
        annotation: Option[TypeExpr],
        value: Expr,
        else_branch: Option[Expr],
    },
    Assign {
        target: Expr,
        op: ast::AssignmentOp,
        value: Expr,
    },
    Expr {
        expr: Expr,
    },
}

pub struct Expr {
    pub kind: ExprKind,
    pub span: ast::Span,
}

pub enum InterpolatedStringPart {
    Text(string),
    Expr(Expr),
}

pub enum SelectArm {
    Receive {
        channel: Expr,
        guard: Option[Expr],
        binding: LocalId,
        body: Expr,
    },
    Send {
        channel: Expr,
        value: Expr,
        guard: Option[Expr],
        body: Expr,
    },
    Default {
        body: Expr,
    },
}

pub enum ExprKind {
    NameRef {
        name_ref: NameRef,
    },
    StaticMember {
        owner: string,
        member: string,
        owner_type_args: Vec[TypeExpr],
        owner_type_arg_spans: Vec[Option[ast::Span]],
        member_type_args: Vec[TypeExpr],
        member_type_arg_spans: Vec[Option[ast::Span]],
    },
    Unit,
    Bool {
        value: bool,
    },
    Int {
        value: string,
    },
    Float {
        value: string,
    },
    String {
        value: string,
    },
    InterpolatedString {
        parts: Vec[InterpolatedStringPart],
    },
    Char {
        value: string,
    },
    Byte {
        value: string,
    },
    ByteString {
        values: Vec[string],
    },
    ConstructorValue {
        constructor: ConstructorRef,
    },
    Constr {
        constructor: ConstructorRef,
        args: Vec[Expr],
    },
    StructLiteral {
        name: string,
        fields: Vec[(string, Expr)],
        base: Option[Expr],
    },
    Tuple {
        items: Vec[Expr],
    },
    Array {
        items: Vec[Expr],
    },
    Closure {
        params: Vec[ClosureParam],
        body: Expr,
    },
    Match {
        expr: Expr,
        arms: Vec[Arm],
    },
    Select {
        mode: ast::SelectMode,
        arms: Vec[SelectArm],
    },
    If {
        cond: Expr,
        then_branch: Expr,
        else_branch: Expr,
    },
    While {
        label: Option[string],
        cond: Expr,
        body: Expr,
    },
    Loop {
        label: Option[string],
        body: Expr,
    },
    For {
        label: Option[string],
        pat: Pat,
        iterator: Expr,
        body: Expr,
    },
    Break {
        label: Option[string],
        value: Option[Expr],
    },
    Continue {
        label: Option[string],
    },
    Return {
        expr: Option[Expr],
    },
    Go {
        expr: Expr,
    },
    Comptime {
        block: Block,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
    },
    Unary {
        op: ast::UnaryOp,
        expr: Expr,
    },
    Cast {
        expr: Expr,
        ty: TypeExpr,
    },
    Try {
        depth: isize,
        expr: Expr,
    },
    Range {
        start: Expr,
        end: Expr,
        inclusive: bool,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: Expr,
        rhs: Expr,
    },
    Proj {
        tuple: Expr,
        index: isize,
    },
    Field {
        expr: Expr,
        field_name: string,
        method_type_args: Vec[TypeExpr],
    },
    Index {
        base: Expr,
        index: Expr,
    },
    Block {
        block: Block,
    },
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct ArrayPatRest {
    pub binding: Option[LocalId],
}

pub struct Pat {
    pub kind: PatKind,
    pub span: ast::Span,
}

pub enum PatKind {
    Var {
        name: LocalId,
        is_mut: bool,
    },
    Constant {
        reference: NameRef,
    },
    Unit,
    Bool {
        value: bool,
    },
    Int {
        value: string,
    },
    Float {
        value: string,
    },
    String {
        value: string,
    },
    Char {
        value: string,
    },
    Byte {
        value: string,
    },
    Constr {
        head: PatternHead,
        args: Vec[Pat],
    },
    Struct {
        head: PatternHead,
        fields: Vec[(string, Pat)],
        has_rest: bool,
    },
    Tuple {
        items: Vec[Pat],
    },
    Array {
        prefix: Vec[Pat],
        rest: Option[ArrayPatRest],
        suffix: Vec[Pat],
    },
    Alias {
        name: LocalId,
        pat: Pat,
    },
    Or {
        pats: Vec[Pat],
    },
    Range {
        start: Pat,
        end: Pat,
        inclusive: bool,
    },
    Wild,
}

pub struct Diagnostic {
    pub message: string,
    pub span: Option[ast::Span],
}

pub struct LowerResult {
    pub hir: Option[File],
    pub source_path: string,
    pub diagnostics: Vec[Diagnostic],
}
