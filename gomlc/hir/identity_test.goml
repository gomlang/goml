package hir;

use std::testing;

#[test]
fn source_definition_identity_includes_canonical_package() -> () {
    let first = source_definition("first::models", 3);
    let second = source_definition("second::models", 3);
    testing::assert(same_definition(first, source_definition("first::models", 3)));
    testing::assert(!same_definition(first, second));
    testing::assert(!same_definition(first, source_definition("first::models", 4)));
    testing::assert(definition_key(first) != definition_key(second));
}

#[test]
fn external_definition_identity_includes_canonical_name() -> () {
    let first = external_definition("first::models::Value");
    let second = external_definition("second::models::Value");
    testing::assert(same_definition(first, external_definition("first::models::Value")));
    testing::assert(!same_definition(first, second));
    testing::assert(definition_key(first) != definition_key(second));
}

#[test]
fn source_and_external_definition_keys_are_distinct() -> () {
    let source = source_definition("models", 3);
    let external = external_definition(definition_key(source));
    testing::assert(!same_definition(source, external));
    testing::assert(definition_key(source) != definition_key(external));
}

#[test]
fn local_identity_includes_package_and_ignores_display_hint() -> () {
    let first = LocalId { pkg: "first::models", index: 2, hint: "value" };
    let renamed = LocalId { pkg: "first::models", index: 2, hint: "other" };
    let second = LocalId { pkg: "second::models", index: 2, hint: "value" };
    let next = LocalId { pkg: "first::models", index: 3, hint: "value" };
    testing::assert(same_local(first, renamed));
    testing::assert(!same_local(first, second));
    testing::assert(!same_local(first, next));
}
