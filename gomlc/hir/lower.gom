package hir;

use module::ast;
use module::cst;
use std::collections;
use std::text;

struct EnumInfo {
    name: string,
    def_id: DefId,
    variants: Vec[string],
}

struct AliasEntry {
    alias: string,
    target: Vec[string],
    item: bool,
}

struct ResolvedUses {
    aliases: Vec[AliasEntry],
    traits: Vec[string],
    public_reexports: Vec[(string, string)],
    diagnostics: Vec[string],
}

struct LowerCtx {
    package_name: string,
    package_id: isize,
    definitions: Vec[(string, DefId)],
    constants: Vec[(string, DefId)],
    enums: Vec[EnumInfo],
    nominal_types: Vec[string],
    traits: Vec[string],
    aliases: Vec[AliasEntry],
    qualify_imports: bool,
    local_counter: Ref[isize],
    method_counter: Ref[isize],
    expr_counter: Ref[isize],
    diagnostics: Vec[Diagnostic],
    current_pattern_span: Ref[Option[ast::Span]],
    lexical_scopes: collections::Stack[LexicalScope],
    closure_depth: Ref[isize],
}

struct PatternState {
    seen: Vec[(string, LocalId)],
    preferred: Vec[(string, LocalId)],
    constants: bool,
}

struct LexicalScope {
    local: LocalId,
    closure_depth: isize,
}

fn path_segments(path: ast::Path) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for segment in path.segments {
        result.push(segment.ident)
    }
    result
}

fn single_path(name: string) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::new();
    segments.push(ast::PathSegment { ident: name, span: ast::span(0, 0) });
    ast::Path { segments }
}

fn copy_strings(values: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn append_strings(first: Vec[string], second: Vec[string]) -> Vec[string] {
    let result = copy_strings(first);
    for value in second {
        result.push(value)
    }
    result
}

fn copy_bindings(values: Vec[(string, LocalId)]) -> Vec[(string, LocalId)] {
    let result: Vec[(string, LocalId)] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn join_segments(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for value in values {
        if index > 0 {
            builder.write_string("::")
        }
        builder.write_string(value);
        index += 1;
    }
    builder.finish()
}

fn is_special_package(package_name: string) -> bool {
    package_name == "main" || package_name == "builtin" || package_name == "prelude"
}

fn package_id(package_name: string) -> isize {
    if package_name == "builtin" {
        0
    } else if package_name == "main" {
        1
    } else if package_name == "prelude" {
        2
    } else {
        2
    }
}

fn full_name(package_name: string, name: string) -> string {
    if is_special_package(package_name) {
        name
    } else {
        package_name + "::" + name
    }
}

fn basename(path: string) -> string {
    let builder = text::StringBuilder::new();
    for character in path.chars() {
        if character == '/' || character == '\\' {
            builder.clear()
        } else {
            builder.write_char(character)
        }
    }
    if builder.is_empty() {
        "<unknown>"
    } else {
        builder.finish()
    }
}

fn last_string(values: Vec[string]) -> Option[string] {
    if values.is_empty() {
        Option::None
    } else {
        Option::Some(values[values.len() - 1])
    }
}

fn expand_use_alias(aliases: Vec[AliasEntry], target: Vec[string]) -> Option[Vec[string]] {
    if !target.is_empty() {
        for alias in aliases {
            if !alias.item && alias.alias == target[0] {
                let expanded = copy_strings(alias.target);
                for index in 1..target.len() {
                    expanded.push(target[index])
                }
                return Option::Some(expanded)
            }
        }
    }
    Option::None
}

fn prospective_use_aliases(file: ast::File) -> Vec[AliasEntry] {
    let result: Vec[AliasEntry] = Vec::new();
    for use_decl in file.uses {
        if use_decl.items.is_empty() {
            let target = path_segments(use_decl.path);
            let alias = match use_decl.alias {
                Some(value) => Option::Some(value),
                None => last_string(target),
            };
            if let Some(value) = alias {
                result.push(AliasEntry { alias: value, target, item: false })
            }
        }
    }
    result
}

fn expand_any_use_alias(aliases: Vec[AliasEntry], prospective: Vec[AliasEntry], target: Vec[string]) -> Option[
    Vec[string],
] {
    match expand_use_alias(aliases, target) {
        Some(value) => Option::Some(value),
        None => expand_use_alias(prospective, target),
    }
}

fn resolved_uses_from_file(file: ast::File) -> ResolvedUses {
    let aliases: Vec[AliasEntry] = Vec::new();
    let prospective = prospective_use_aliases(file);
    let traits: Vec[string] = Vec::new();
    let public_reexports: Vec[(string, string)] = Vec::new();
    let diagnostics: Vec[string] = Vec::new();
    for use_decl in file.uses {
        let target = path_segments(use_decl.path);
        if !use_decl.items.is_empty() {
            let base = expand_any_use_alias(aliases, prospective, target).unwrap_or(target);
            for item in use_decl.items {
                let item_target = copy_strings(base);
                item_target.push(item.name);
                aliases.push(
                    AliasEntry {
                        alias: item.alias.unwrap_or(item.name),
                        target: item_target,
                        item: true,
                    },
                );
                match use_decl.visibility {
                    ast::Visibility::Public => public_reexports.push(
                        (item.alias.unwrap_or(item.name), join_segments(item_target)),
                    ),
                    ast::Visibility::Private => (),
                }
                traits.push(join_segments(item_target))
            }
        } else {
            match expand_any_use_alias(aliases, prospective, target) {
                Some(expanded) => {
                    let exported_name = use_decl.alias.unwrap_or_else(
                        || last_string(expanded).unwrap_or(""),
                    );
                    if let Some(alias) = use_decl.alias {
                        aliases.push(AliasEntry { alias, target: expanded, item: true })
                    }
                    traits.push(join_segments(expanded));
                    match use_decl.visibility {
                        ast::Visibility::Public => if exported_name != "" {
                            public_reexports.push((exported_name, join_segments(expanded)))
                        },
                        ast::Visibility::Private => (),
                    }
                },
                None => match use_decl.alias {
                    Some(alias) => {
                        aliases.push(AliasEntry { alias, target, item: false });
                        match use_decl.visibility {
                            ast::Visibility::Public => {
                                public_reexports.push((alias, join_segments(target)))
                            },
                            ast::Visibility::Private => (),
                        }
                    },
                    None => match last_string(target) {
                        Some(default_alias) => {
                            aliases.push(AliasEntry { alias: default_alias, target, item: false });
                            match use_decl.visibility {
                                ast::Visibility::Public => public_reexports.push(
                                    (default_alias, join_segments(target)),
                                ),
                                ast::Visibility::Private => (),
                            }
                        },
                        None => (),
                    },
                },
            }
        }
    }
    for index in 0..aliases.len() {
        let current = aliases[index];
        for previous_index in 0..index {
            let previous = aliases[previous_index];
            if join_segments(previous.target) == join_segments(current.target)
                && (!previous.item || !current.item || previous.alias == current.alias) {
                diagnostics.push(
                    if current.item {
                        "Duplicate imported item " + join_segments(current.target)
                    } else {
                        "Duplicate package use " + join_segments(current.target)
                    },
                )
            } else if previous.alias == current.alias {
                diagnostics.push("Ambiguous use alias " + current.alias)
            }
        }
    }
    for index in 0..public_reexports.len() {
        for previous_index in 0..index {
            if public_reexports[previous_index].0 == public_reexports[index].0 {
                diagnostics.push("Duplicate public re-export " + public_reexports[index].0)
            }
        }
    }
    ResolvedUses { aliases, traits, public_reexports, diagnostics }
}

fn import_aliases_from_file(file: ast::File, aliases: Vec[AliasEntry]) -> Vec[ImportAlias] {
    let result: Vec[ImportAlias] = Vec::new();
    for use_decl in file.uses {
        if !use_decl.items.is_empty() {
            let target = path_segments(use_decl.path);
            let target = expand_use_alias(aliases, target).unwrap_or(target);
            result.push(ImportAlias { alias: "", package_name: join_segments(target) })
        }
    }
    for entry in aliases {
        if entry.item {} else {
            result.push(
                ImportAlias { alias: entry.alias, package_name: join_segments(entry.target) },
            )
        }
    }
    result
}

fn imports_from_aliases(aliases: Vec[AliasEntry]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for entry in aliases {
        if entry.item {
            result.push(join_segments(entry.target))
        }
    }
    result
}

fn expand_segments(ctx: LowerCtx, path: ast::Path) -> Vec[string] {
    let values = path_segments(path);
    if values.is_empty() || !ctx.qualify_imports {
        values
    } else {
        for alias in ctx.aliases {
            if alias.alias == values[0] && (alias.item || values.len() > 1) {
                let result: Vec[string] = Vec::new();
                for segment in alias.target {
                    result.push(segment)
                }
                for index in 1..values.len() {
                    result.push(values[index])
                }
                return result
            }
        }
        values
    }
}

fn qualified_segments(ctx: LowerCtx, path: ast::Path) -> Vec[string] {
    let values = expand_segments(ctx, path);
    if ctx.qualify_imports && !values.is_empty() && ctx.nominal_types.contains(values[0]) {
        let result: Vec[string] = Vec::new();
        result.push(full_name(ctx.package_name, values[0]));
        for index in 1..values.len() {
            result.push(values[index])
        }
        result
    } else {
        values
    }
}

fn path_text(ctx: LowerCtx, path: ast::Path) -> string {
    join_segments(qualified_segments(ctx, path))
}

fn static_member(
    parts: Vec[string],
    owner_type_args: Vec[TypeExpr],
    owner_type_arg_spans: Vec[Option[ast::Span]],
    member_type_args: Vec[TypeExpr],
    member_type_arg_spans: Vec[Option[ast::Span]],
) -> ExprKind {
    let owner_parts: Vec[string] = Vec::new();
    if parts.len() > 1 {
        for index in 0..parts.len() - 1 {
            owner_parts.push(parts[index])
        }
    }
    ExprKind::StaticMember {
        owner: join_segments(owner_parts),
        member: last_string(parts).unwrap_or("<error>"),
        owner_type_args,
        owner_type_arg_spans,
        member_type_args,
        member_type_arg_spans,
    }
}

fn ast_type_head_span(value: ast::TypeExpr) -> Option[ast::Span] {
    match value {
        Con { path } => if !path.segments.is_empty() {
            Option::Some(path.segments[0].span)
        } else {
            Option::None
        },
        Dyn { bounds } => if !bounds.is_empty() && !bounds[0].trait_path.segments.is_empty() {
            Option::Some(bounds[0].trait_path.segments[0].span)
        } else {
            Option::None
        },
        App { ty, args: _ } => ast_type_head_span(ty),
        _ => Option::None,
    }
}

fn find_binding(values: Vec[(string, LocalId)], name: string) -> Option[LocalId] {
    let mut index = values.len();
    while index > 0 {
        index -= 1;
        let entry = values[index];
        if entry.0 == name {
            return Option::Some(entry.1)
        }
    }
    Option::None
}

fn find_definition(ctx: LowerCtx, name: string) -> Option[DefId] {
    let mut index = ctx.definitions.len() - 1;
    while index >= 0 {
        let entry = ctx.definitions[index];
        if entry.0 == name {
            return Option::Some(entry.1)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_constant_definition(ctx: LowerCtx, name: string) -> Option[DefId] {
    let mut index = ctx.constants.len() - 1;
    while index >= 0 {
        let entry = ctx.constants[index];
        if entry.0 == name {
            return Option::Some(entry.1)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn constant_ref(ctx: LowerCtx, path: ast::Path) -> Option[NameRef] {
    let original = path_segments(path);
    let expanded = expand_segments(ctx, path);
    if original.len() != 1 {
        Option::None
    } else if expanded.len() == 1 {
        find_constant_definition(ctx, full_name(ctx.package_name, expanded[0])).map(
            |def_id| NameRef::Def(def_id),
        )
    } else {
        Option::None
    }
}

fn fresh_local(ctx: LowerCtx, hint: string) -> LocalId {
    let index = ctx.local_counter.get();
    ctx.local_counter.set(index + 1);
    LocalId { pkg: ctx.package_id, index, hint }
}

fn fresh_method(ctx: LowerCtx) -> DefId {
    let index = ctx.method_counter.get();
    ctx.method_counter.set(index + 1);
    DefId { pkg: ctx.package_id, index }
}

fn enum_variant(info: EnumInfo, name: string) -> Option[isize] {
    let mut index = info.variants.len() - 1;
    while index >= 0 {
        if info.variants[index] == name {
            return Option::Some(index)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn constructor_ref(ctx: LowerCtx, path: ast::Path) -> Option[ConstructorRef] {
    let parts = expand_segments(ctx, path);
    if parts.len() == 1 {
        let matches: Vec[(DefId, isize)] = Vec::new();
        for info in ctx.enums {
            if let Some(index) = enum_variant(info, parts[0]) {
                matches.push((info.def_id, index))
            }
        }
        if matches.len() == 1 {
            let value = matches[0];
            Option::Some(ConstructorRef::Resolved { enum_def: value.0, variant_index: value.1 })
        } else {
            Option::None
        }
    } else {
        let variant = parts[parts.len() - 1];
        let enum_name = if parts.len() == 2 {
            parts[0]
        } else {
            let names: Vec[string] = Vec::new();
            for index in 1..parts.len() - 1 {
                names.push(parts[index])
            }
            join_segments(names)
        };
        let package_matches = parts.len() == 2 || parts[0] == ctx.package_name;
        if package_matches {
            let mut index = ctx.enums.len() - 1;
            while index >= 0 {
                let info = ctx.enums[index];
                if info.name == enum_name {
                    match enum_variant(info, variant) {
                        Some(variant_index) => return Option::Some(
                            ConstructorRef::Resolved { enum_def: info.def_id, variant_index },
                        ),
                        None => {
                            index -= 1;
                        },
                    }
                } else {
                    index -= 1;
                }
            }
            Option::None
        } else {
            Option::None
        }
    }
}

fn unresolved_constructor(ctx: LowerCtx, path: ast::Path) -> ConstructorRef {
    constructor_ref(ctx, path).unwrap_or_else(|| ConstructorRef::Unresolved(path_text(ctx, path)))
}

fn pattern_head_span(path: ast::Path) -> ast::Span {
    if path.segments.is_empty() {
        ast::span(0, 0)
    } else {
        path.segments[path.segments.len() - 1].span
    }
}

fn pattern_head(ctx: LowerCtx, path: ast::Path) -> PatternHead {
    let span = pattern_head_span(path);
    if path.segments.len() == 1 {
        PatternHead::Contextual { name: path.segments[0].ident, span }
    } else {
        match constructor_ref(ctx, path) {
            Some(Resolved { enum_def, variant_index }) => PatternHead::Resolved {
                enum_def,
                variant_index,
                span,
            },
            Some(Unresolved(name)) => {
                PatternHead::Qualified { name, span }
            },
            None => PatternHead::Qualified { name: path_text(ctx, path), span },
        }
    }
}

fn lower_type(ctx: LowerCtx, value: ast::TypeExpr, type_params: Vec[string]) -> TypeExpr {
    match value {
        Unit => TypeExpr::Unit,
        Bool => TypeExpr::Bool,
        Int => TypeExpr::Int,
        Int8 => TypeExpr::Int8,
        Int16 => TypeExpr::Int16,
        Int32 => TypeExpr::Int32,
        Int64 => TypeExpr::Int64,
        Uint => TypeExpr::Uint,
        Uint8 => TypeExpr::Uint8,
        Uint16 => TypeExpr::Uint16,
        Uint32 => TypeExpr::Uint32,
        Uint64 => TypeExpr::Uint64,
        Float32 => TypeExpr::Float32,
        Float64 => TypeExpr::Float64,
        String => TypeExpr::String,
        Char => TypeExpr::Char,
        Tuple { items: values } => {
            let result: Vec[TypeExpr] = Vec::new();
            for item in values {
                result.push(lower_type(ctx, item, type_params))
            }
            TypeExpr::Tuple { items: result }
        },
        Con { path } => {
            let parts = qualified_segments(ctx, path);
            if parts.len() >= 2 && (parts[0] == "Self" || type_params.contains(parts[0])) {
                let result: Ref[TypeExpr] = Ref::new(TypeExpr::Con { name: parts[0] });
                for index in 1..parts.len() {
                    result.set(
                        TypeExpr::Projection { base: result.get(), associated: parts[index] },
                    )
                }
                result.get()
            } else {
                TypeExpr::Con { name: join_segments(parts) }
            }
        },
        Dyn { bounds } => {
            let result: Vec[DynTraitBound] = Vec::new();
            for bound in bounds {
                let args: Vec[TypeExpr] = Vec::new();
                for arg in bound.args {
                    args.push(lower_type(ctx, arg, type_params))
                }
                let associated_types: Vec[(string, TypeExpr)] = Vec::new();
                for binding in bound.associated_types {
                    associated_types.push((binding.0, lower_type(ctx, binding.1, type_params)))
                }
                result.push(
                    DynTraitBound {
                        trait_name: path_text(ctx, bound.trait_path),
                        args,
                        associated_types,
                    },
                )
            }
            TypeExpr::Dyn { bounds: result }
        },
        App { ty: base, args } => {
            let result: Vec[TypeExpr] = Vec::new();
            for arg in args {
                result.push(lower_type(ctx, arg, type_params))
            }
            TypeExpr::App { ty: lower_type(ctx, base, type_params), args: result }
        },
        Array { len: length, elem: element } => {
            TypeExpr::Array { len: length, elem: lower_type(ctx, element, type_params) }
        },
        Func { params, ret_ty } => {
            let result: Vec[TypeExpr] = Vec::new();
            for param in params {
                result.push(lower_type(ctx, param, type_params))
            }
            TypeExpr::Func { params: result, ret_ty: lower_type(ctx, ret_ty, type_params) }
        },
    }
}

fn lower_plain_trait_ref(ctx: LowerCtx, value: ast::TraitRef, type_params: Vec[string]) -> TraitRef {
    let args: Vec[TypeExpr] = Vec::new();
    let arg_spans: Vec[Option[ast::Span]] = Vec::new();
    for arg in value.args {
        arg_spans.push(ast_type_head_span(arg));
        args.push(lower_type(ctx, arg, type_params))
    }
    TraitRef { name: path_text(ctx, value.path), args, arg_spans }
}

fn lower_impl_trait_ref(ctx: LowerCtx, value: ast::TraitRef, type_params: Vec[string]) -> TraitRef {
    let parts = expand_segments(ctx, value.path);
    let name = if parts.len() == 1 && ctx.traits.contains(parts[0]) {
        full_name(ctx.package_name, parts[0])
    } else {
        join_segments(parts)
    };
    let args: Vec[TypeExpr] = Vec::new();
    let arg_spans: Vec[Option[ast::Span]] = Vec::new();
    for arg in value.args {
        arg_spans.push(ast_type_head_span(arg));
        args.push(lower_type(ctx, arg, type_params))
    }
    TraitRef { name, args, arg_spans }
}

fn lower_predicate(
    ctx: LowerCtx,
    value: ast::Predicate,
    type_params: Vec[string],
    resolve_trait: bool,
) -> Predicate {
    match value {
        Trait { ty, trait_ref } => Predicate::Trait {
            ty: lower_type(ctx, ty, type_params),
            trait_ref: if resolve_trait {
                lower_impl_trait_ref(ctx, trait_ref, type_params)
            } else {
                lower_plain_trait_ref(ctx, trait_ref, type_params)
            },
        },
        Equality { lhs, rhs } => Predicate::Equality {
            lhs: lower_type(ctx, lhs, type_params),
            rhs: lower_type(ctx, rhs, type_params),
        },
    }
}

fn lower_bounds(
    ctx: LowerCtx,
    values: Vec[(string, Vec[ast::TraitRef])],
    type_params: Vec[string],
    resolve_trait: bool,
) -> Vec[(string, Vec[TraitRef])] {
    let result: Vec[(string, Vec[TraitRef])] = Vec::new();
    for value in values {
        let bounds: Vec[TraitRef] = Vec::new();
        for bound in value.1 {
            bounds.push(
                if resolve_trait {
                    lower_impl_trait_ref(ctx, bound, type_params)
                } else {
                    lower_plain_trait_ref(ctx, bound, type_params)
                },
            )
        }
        result.push((value.0, bounds))
    }
    result
}

fn sort_pattern_names(values: Vec[string]) -> Vec[string] {
    collections::BTreeSet::from_vec(values).to_vec()
}

fn join_pattern_names(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for value in values {
        if index > 0 {
            builder.write_string(", ")
        }
        builder.write_string(value);
        index += 1;
    }
    builder.finish()
}

fn pattern_binding_mismatch(expected: Vec[(string, LocalId)], actual: Vec[(string, LocalId)]) -> Option[
    string,
] {
    let missing: Vec[string] = Vec::new();
    let extra: Vec[string] = Vec::new();
    for value in expected {
        if let None = find_binding(actual, value.0) {
            missing.push(value.0)
        }
    }
    for value in actual {
        if let None = find_binding(expected, value.0) {
            extra.push(value.0)
        }
    }
    if missing.is_empty() && extra.is_empty() {
        Option::None
    } else {
        let details = text::StringBuilder::new();
        if !missing.is_empty() {
            details.write_string("missing ");
            details.write_string(join_pattern_names(sort_pattern_names(missing)))
        }
        if !extra.is_empty() {
            if details.is_empty() {} else {
                details.write_string("; ")
            }
            details.write_string("extra ");
            details.write_string(join_pattern_names(sort_pattern_names(extra)))
        }
        Option::Some("Or-pattern alternatives must bind the same variables: " + details.finish())
    }
}

fn bind_pattern_name(ctx: LowerCtx, env: Vec[(string, LocalId)], state: PatternState, name: string) -> LocalId {
    match find_binding(state.seen, name) {
        Some(existing) => {
            ctx.diagnostics.push(
                Diagnostic {
                    message: "Variable " + name + " is bound more than once in the same pattern",
                    span: ctx.current_pattern_span.get(),
                },
            );
            existing
        },
        None => {
            let local = find_binding(state.preferred, name).unwrap_or_else(
                || fresh_local(ctx, name),
            );
            state.seen.push((name, local));
            env.push((name, local));
            local
        },
    }
}

fn lower_pattern_inner(
    ctx: LowerCtx,
    value: ast::Pat,
    env: Vec[(string, LocalId)],
    state: PatternState,
) -> Pat {
    let span = ast::pat_span(value);
    let previous_span = ctx.current_pattern_span.get();
    ctx.current_pattern_span.set(Option::Some(span));
    let kind = match value {
        Var { name, is_mut, span } => match if state.constants && !is_mut {
            constant_ref(ctx, single_path(name))
        } else {
            Option::None
        } {
            Some(reference) => PatKind::Constant { reference },
            None => match constructor_ref(ctx, single_path(name)) {
                Some(Resolved { enum_def, variant_index }) => PatKind::Constr {
                    head: PatternHead::Resolved { enum_def, variant_index, span },
                    args: Vec::new(),
                },
                None => PatKind::Var { name: bind_pattern_name(ctx, env, state, name), is_mut },
                Some(Unresolved(_)) => {
                    PatKind::Var { name: bind_pattern_name(ctx, env, state, name), is_mut }
                },
            },
        },
        Unit { span: _ } => PatKind::Unit,
        Bool { value, span: _ } => PatKind::Bool { value },
        Int { value, span: _ } => PatKind::Int { value },
        Float { value, span: _ } => PatKind::Float { value },
        String { value, span: _ } => PatKind::String { value },
        Char { value, span: _ } => PatKind::Char { value },
        Byte { value, span: _ } => PatKind::Byte { value },
        Constr { constructor: path, args, span: _ } => match if state.constants && args.is_empty() {
            constant_ref(ctx, path)
        } else {
            Option::None
        } {
            Some(reference) => PatKind::Constant { reference },
            None => {
                let result: Vec[Pat] = Vec::new();
                for arg in args {
                    result.push(lower_pattern_inner(ctx, arg, env, state))
                }
                PatKind::Constr { head: pattern_head(ctx, path), args: result }
            },
        },
        Struct { name: path, fields, has_rest, span: _ } => {
            let result: Vec[(string, Pat)] = Vec::new();
            for field in fields {
                result.push((field.0, lower_pattern_inner(ctx, field.1, env, state)))
            }
            PatKind::Struct { head: pattern_head(ctx, path), fields: result, has_rest }
        },
        Tuple { items: values, span: _ } => {
            let result: Vec[Pat] = Vec::new();
            for item in values {
                result.push(lower_pattern_inner(ctx, item, env, state))
            }
            PatKind::Tuple { items: result }
        },
        Array { prefix, rest, suffix, span: _ } => {
            let lowered_prefix: Vec[Pat] = Vec::new();
            for item in prefix {
                lowered_prefix.push(lower_pattern_inner(ctx, item, env, state))
            }
            let lowered_rest = rest.map(
                |value| ArrayPatRest {
                    binding: value.binding.map(|name| bind_pattern_name(ctx, env, state, name)),
                },
            );
            let lowered_suffix: Vec[Pat] = Vec::new();
            for item in suffix {
                lowered_suffix.push(lower_pattern_inner(ctx, item, env, state))
            }
            PatKind::Array { prefix: lowered_prefix, rest: lowered_rest, suffix: lowered_suffix }
        },
        Alias { name, pat, span: _ } => PatKind::Alias {
            name: bind_pattern_name(ctx, env, state, name),
            pat: lower_pattern_inner(ctx, pat, env, state),
        },
        Or { pats: values, span: _ } => {
            let result: Vec[Pat] = Vec::new();
            if values.is_empty() {
                PatKind::Or { pats: result }
            } else {
                let base_env = copy_bindings(env);
                let base_seen = copy_bindings(state.seen);
                result.push(lower_pattern_inner(ctx, values[0], env, state));
                let expected: Vec[(string, LocalId)] = Vec::new();
                for index in base_seen.len()..state.seen.len() {
                    expected.push(state.seen[index])
                }
                for index in 1..values.len() {
                    let branch_env = copy_bindings(base_env);
                    let branch_state = PatternState {
                        seen: copy_bindings(base_seen),
                        preferred: expected,
                        constants: state.constants,
                    };
                    result.push(lower_pattern_inner(ctx, values[index], branch_env, branch_state));
                    let actual: Vec[(string, LocalId)] = Vec::new();
                    for binding_index in base_seen.len()..branch_state.seen.len() {
                        actual.push(branch_state.seen[binding_index])
                    }
                    if let Some(message) = pattern_binding_mismatch(expected, actual) {
                        ctx.diagnostics.push(Diagnostic { message, span: Option::Some(span) })
                    }
                }
                PatKind::Or { pats: result }
            }
        },
        Range { start, end, inclusive, span: _ } => PatKind::Range {
            start: lower_pattern_inner(ctx, start, env, state),
            end: lower_pattern_inner(ctx, end, env, state),
            inclusive,
        },
        Wild { span: _ } => PatKind::Wild,
    };
    ctx.current_pattern_span.set(previous_span);
    Pat { kind, span }
}

fn lower_pattern(ctx: LowerCtx, value: ast::Pat, env: Vec[(string, LocalId)], constants: bool) -> Pat {
    lower_pattern_inner(
        ctx,
        value,
        env,
        PatternState { seen: Vec::new(), preferred: Vec::new(), constants },
    )
}

fn lower_block(
    ctx: LowerCtx,
    value: ast::Block,
    env: Vec[(string, LocalId)],
    type_params: Vec[string],
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in value.stmts {
        match stmt {
            Defer { expr, span: _ } => stmts.push(
                Stmt::Defer { expr: lower_expr(ctx, expr, env, type_params) },
            ),
            Let { is_mut, pat, annotation, value: expr, else_branch, span: _ } => {
                let lowered_expr = lower_expr(ctx, expr, env, type_params);
                let refutable = else_branch.is_some();
                let lowered_else = match else_branch {
                    Some(value) => {
                        Option::Some(lower_expr(ctx, value, copy_bindings(env), type_params))
                    },
                    None => Option::None,
                };
                let lowered_pat = lower_pattern(ctx, pat, env, refutable);
                stmts.push(
                    Stmt::Let {
                        is_mut,
                        pat: lowered_pat,
                        annotation: annotation.map(|ty| lower_type(ctx, ty, type_params)),
                        value: lowered_expr,
                        else_branch: lowered_else,
                    },
                )
            },
            Assign { target, op, value: expr, span: _ } => stmts.push(
                Stmt::Assign {
                    target: lower_expr(ctx, target, env, type_params),
                    op,
                    value: lower_expr(ctx, expr, env, type_params),
                },
            ),
            Expr { expr, span: _ } => {
                stmts.push(Stmt::Expr { expr: lower_expr(ctx, expr, env, type_params) })
            },
        }
    }
    Block { stmts, tail: value.tail.map(|expr| lower_expr(ctx, expr, env, type_params)) }
}

fn synthetic_expr(kind: ExprKind, span: ast::Span) -> Expr {
    Expr { kind, span }
}

fn lexical_scope_ref(value: LexicalScope, span: ast::Span) -> Expr {
    synthetic_expr(ExprKind::NameRef { name_ref: NameRef::Local(value.local) }, span)
}

fn lexical_scope_method(value: LexicalScope, method: string, span: ast::Span) -> Expr {
    synthetic_expr(
        ExprKind::Field {
            expr: lexical_scope_ref(value, span),
            field_name: method,
            method_type_args: Vec::new(),
        },
        span,
    )
}

fn lexical_scope_call(value: LexicalScope, method: string, args: Vec[Expr], span: ast::Span) -> Expr {
    synthetic_expr(ExprKind::Call { func: lexical_scope_method(value, method, span), args }, span)
}

fn task_function(name: string, span: ast::Span) -> Expr {
    synthetic_expr(
        ExprKind::StaticMember {
            owner: "std::task",
            member: name,
            owner_type_args: Vec::new(),
            owner_type_arg_spans: Vec::new(),
            member_type_args: Vec::new(),
            member_type_arg_spans: Vec::new(),
        },
        span,
    )
}

fn current_lexical_scope(ctx: LowerCtx) -> Option[LexicalScope] {
    ctx.lexical_scopes.peek()
}

fn lower_expr_value(
    ctx: LowerCtx,
    value: ast::Expr,
    env: Vec[(string, LocalId)],
    type_params: Vec[string],
) -> ExprKind {
    match value {
        Path { path, owner_type_args, member_type_args, span: _ } => {
            if !owner_type_args.is_empty() || !member_type_args.is_empty() {
                let owner_args: Vec[TypeExpr] = Vec::new();
                let owner_arg_spans: Vec[Option[ast::Span]] = Vec::new();
                for arg in owner_type_args {
                    owner_arg_spans.push(ast_type_head_span(arg));
                    owner_args.push(lower_type(ctx, arg, type_params))
                }
                let member_args: Vec[TypeExpr] = Vec::new();
                let member_arg_spans: Vec[Option[ast::Span]] = Vec::new();
                for arg in member_type_args {
                    member_arg_spans.push(ast_type_head_span(arg));
                    member_args.push(lower_type(ctx, arg, type_params))
                }
                static_member(
                    qualified_segments(ctx, path),
                    owner_args,
                    owner_arg_spans,
                    member_args,
                    member_arg_spans,
                )
            } else {
                match constructor_ref(ctx, path) {
                    Some(constructor) => ExprKind::ConstructorValue { constructor },
                    None => {
                        if path.segments.len() == 1 {
                            if let Some(local) = find_binding(env, path.segments[0].ident) {
                                return ExprKind::NameRef { name_ref: NameRef::Local(local) }
                            }
                        }
                        let parts = qualified_segments(ctx, path);
                        if parts.len() == 1 {
                            let name = parts[0];
                            ExprKind::NameRef {
                                name_ref: match find_definition(
                                    ctx,
                                    full_name(ctx.package_name, name),
                                ) {
                                    Some(def_id) => NameRef::Def(def_id),
                                    None => NameRef::Other(name),
                                },
                            }
                        } else {
                            let name = join_segments(copy_strings(parts));
                            match find_definition(ctx, name) {
                                Some(def_id) => ExprKind::NameRef { name_ref: NameRef::Def(def_id) },
                                None => static_member(
                                    parts,
                                    Vec::new(),
                                    Vec::new(),
                                    Vec::new(),
                                    Vec::new(),
                                ),
                            }
                        }
                    },
                }
            }
        },
        Unit { span: _ } => ExprKind::Unit,
        Bool { value, span: _ } => ExprKind::Bool { value },
        Int { value, span: _ } => ExprKind::Int { value },
        Float { value, span: _ } => ExprKind::Float { value },
        String { value, span: _ } => ExprKind::String { value },
        InterpolatedString { parts, span: _ } => {
            let result: Vec[InterpolatedStringPart] = Vec::new();
            for part in parts {
                match part {
                    Text(value) => {
                        result.push(InterpolatedStringPart::Text(value))
                    },
                    Expr(value) => {
                        result.push(
                            InterpolatedStringPart::Expr(lower_expr(ctx, value, env, type_params)),
                        )
                    },
                }
            }
            ExprKind::InterpolatedString { parts: result }
        },
        Char { value, span: _ } => ExprKind::Char { value },
        Byte { value, span: _ } => ExprKind::Byte { value },
        ByteString { values, span: _ } => ExprKind::ByteString { values },
        ConstructorValue { constructor: path, span: _ } => match constant_ref(ctx, path) {
            Some(reference) => ExprKind::NameRef { name_ref: reference },
            None => ExprKind::ConstructorValue { constructor: unresolved_constructor(ctx, path) },
        },
        Constr { constructor: path, args, span: _ } => {
            let result: Vec[Expr] = Vec::new();
            for arg in args {
                result.push(lower_expr(ctx, arg, env, type_params))
            }
            ExprKind::Constr { constructor: unresolved_constructor(ctx, path), args: result }
        },
        StructLiteral { name: path, fields, base, span: _ } => {
            let result: Vec[(string, Expr)] = Vec::new();
            for field in fields {
                result.push((field.0, lower_expr(ctx, field.1, env, type_params)))
            }
            ExprKind::StructLiteral {
                name: path_text(ctx, path),
                fields: result,
                base: base.map(|value| lower_expr(ctx, value, env, type_params)),
            }
        },
        Tuple { items: values, span: _ } => {
            let result: Vec[Expr] = Vec::new();
            for item in values {
                result.push(lower_expr(ctx, item, env, type_params))
            }
            ExprKind::Tuple { items: result }
        },
        Array { items: values, span: _ } => {
            let result: Vec[Expr] = Vec::new();
            for item in values {
                result.push(lower_expr(ctx, item, env, type_params))
            }
            ExprKind::Array { items: result }
        },
        Closure { params, body, span: _ } => {
            let closure_env = copy_bindings(env);
            let lowered_params: Vec[ClosureParam] = Vec::new();
            for param in params {
                let local = fresh_local(ctx, param.name);
                closure_env.push((param.name, local));
                lowered_params.push(
                    ClosureParam {
                        name: local,
                        ty: param.ty.map(|ty| lower_type(ctx, ty, type_params)),
                        span: param.span,
                    },
                )
            }
            let previous_depth = ctx.closure_depth.get();
            ctx.closure_depth.set(previous_depth + 1);
            let lowered_body = lower_expr(ctx, body, closure_env, type_params);
            ctx.closure_depth.set(previous_depth);
            ExprKind::Closure { params: lowered_params, body: lowered_body }
        },
        Match { expr, arms, span: _ } => {
            let lowered_expr = lower_expr(ctx, expr, env, type_params);
            let lowered_arms: Vec[Arm] = Vec::new();
            for arm in arms {
                let arm_env = copy_bindings(env);
                let pat = lower_pattern(ctx, arm.pat, arm_env, true);
                lowered_arms.push(
                    Arm {
                        pat,
                        guard: match arm.guard {
                            Some(guard) => {
                                Option::Some(lower_expr(ctx, guard, arm_env, type_params))
                            },
                            None => Option::None,
                        },
                        body: lower_expr(ctx, arm.body, arm_env, type_params),
                    },
                )
            }
            ExprKind::Match { expr: lowered_expr, arms: lowered_arms }
        },
        Select { mode, arms, span: _ } => {
            let lowered_arms: Vec[SelectArm] = Vec::with_capacity(arms.len());
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding, body, span: _ } => {
                        let arm_env = copy_bindings(env);
                        let local = fresh_local(ctx, binding);
                        if binding != "_" {
                            arm_env.push((binding, local))
                        }
                        lowered_arms.push(
                            SelectArm::Receive {
                                channel: lower_expr(ctx, channel, env, type_params),
                                guard: guard.map(|value| lower_expr(ctx, value, env, type_params)),
                                binding: local,
                                body: lower_expr(ctx, body, arm_env, type_params),
                            },
                        )
                    },
                    Send { channel, value, guard, body, span: _ } => lowered_arms.push(
                        SelectArm::Send {
                            channel: lower_expr(ctx, channel, env, type_params),
                            value: lower_expr(ctx, value, env, type_params),
                            guard: guard.map(|value| lower_expr(ctx, value, env, type_params)),
                            body: lower_expr(ctx, body, copy_bindings(env), type_params),
                        },
                    ),
                    Default { body, span: _ } => lowered_arms.push(
                        SelectArm::Default {
                            body: lower_expr(ctx, body, copy_bindings(env), type_params),
                        },
                    ),
                }
            }
            ExprKind::Select { mode, arms: lowered_arms }
        },
        If { cond, then_branch, else_branch, span: _ } => ExprKind::If {
            cond: lower_expr(ctx, cond, env, type_params),
            then_branch: lower_expr(ctx, then_branch, copy_bindings(env), type_params),
            else_branch: lower_expr(ctx, else_branch, copy_bindings(env), type_params),
        },
        While { label, cond, body, span: _ } => ExprKind::While {
            label,
            cond: lower_expr(ctx, cond, env, type_params),
            body: lower_expr(ctx, body, copy_bindings(env), type_params),
        },
        Loop { label, body, span: _ } => ExprKind::Loop {
            label,
            body: lower_expr(ctx, body, copy_bindings(env), type_params),
        },
        For { label, pat, iterator, body, span: _ } => {
            let body_env = copy_bindings(env);
            let lowered_iterator = lower_expr(ctx, iterator, env, type_params);
            let lowered_pat = lower_pattern(ctx, pat, body_env, false);
            ExprKind::For {
                label,
                pat: lowered_pat,
                iterator: lowered_iterator,
                body: lower_expr(ctx, body, body_env, type_params),
            }
        },
        Break { label, value, span: _ } => ExprKind::Break {
            label,
            value: value.map(|expr| lower_expr(ctx, expr, env, type_params)),
        },
        Continue { label, span: _ } => ExprKind::Continue { label },
        Return { expr, span: _ } => ExprKind::Return {
            expr: expr.map(|value| lower_expr(ctx, value, env, type_params)),
        },
        Go { expr, span: _ } => ExprKind::Go { expr: lower_expr(ctx, expr, env, type_params) },
        Comptime { block, span: _ } => ExprKind::Comptime {
            block: lower_block(ctx, block, env, type_params),
        },
        Scope { body, span } => {
            let parent = match current_lexical_scope(ctx) {
                Some(value) => if value.closure_depth == ctx.closure_depth.get() {
                    Option::Some(value)
                } else {
                    Option::None
                },
                None => Option::None,
            };
            let local = fresh_local(ctx, "scope");
            let lexical_scope = LexicalScope { local, closure_depth: ctx.closure_depth.get() };
            ctx.lexical_scopes.push(lexical_scope);
            let lowered_body = lower_expr(ctx, body, env, type_params);
            let _ = ctx.lexical_scopes.pop();
            let closure = synthetic_expr(
                ExprKind::Closure {
                    params: Vec::from_array([ClosureParam { name: local, ty: Option::None, span }]),
                    body: lowered_body,
                },
                span,
            );
            let args: Vec[Expr] = Vec::new();
            let function_name = match parent {
                Some(parent_scope) => {
                    args.push(lexical_scope_call(parent_scope, "token", Vec::new(), span));
                    "scope_with"
                },
                None => "scope",
            };
            args.push(closure);
            ExprKind::Call { func: task_function(function_name, span), args }
        },
        Spawn { body, span } => {
            let lowered_body = lower_expr(ctx, body, env, type_params);
            match current_lexical_scope(ctx) {
                Some(lexical_scope) => if lexical_scope.closure_depth == ctx.closure_depth.get() {
                    ExprKind::Call {
                        func: lexical_scope_method(lexical_scope, "spawn", span),
                        args: Vec::from_array([lowered_body]),
                    }
                } else {
                    ctx.diagnostics.push(
                        Diagnostic {
                            message: "spawn cannot capture an enclosing lexical scope across a closure boundary; create a nested scope inside the closure",
                            span: Option::Some(span),
                        },
                    );
                    ExprKind::Unit
                },
                None => {
                    ctx.diagnostics.push(
                        Diagnostic {
                            message: "spawn requires an enclosing lexical scope",
                            span: Option::Some(span),
                        },
                    );
                    ExprKind::Unit
                },
            }
        },
        Call { func, args, span: _ } => {
            match func {
                Path { path, .. } => match constructor_ref(ctx, path) {
                    Some(constructor) => {
                        let result: Vec[Expr] = Vec::new();
                        for arg in args {
                            result.push(lower_expr(ctx, arg, env, type_params))
                        }
                        ExprKind::Constr { constructor, args: result }
                    },
                    None => {
                        let lowered_func = lower_expr(ctx, func, env, type_params);
                        let result: Vec[Expr] = Vec::new();
                        for arg in args {
                            result.push(lower_expr(ctx, arg, env, type_params))
                        }
                        ExprKind::Call { func: lowered_func, args: result }
                    },
                },
                _ => {
                    let lowered_func = lower_expr(ctx, func, env, type_params);
                    let result: Vec[Expr] = Vec::new();
                    for arg in args {
                        result.push(lower_expr(ctx, arg, env, type_params))
                    }
                    ExprKind::Call { func: lowered_func, args: result }
                },
            }
        },
        Unary { op, expr, span: _ } => {
            ExprKind::Unary { op, expr: lower_expr(ctx, expr, env, type_params) }
        },
        Cast { expr, ty, span: _ } => ExprKind::Cast {
            expr: lower_expr(ctx, expr, env, type_params),
            ty: lower_type(ctx, ty, type_params),
        },
        Try { expr, span: _ } => ExprKind::Try {
            depth: 0,
            expr: lower_expr(ctx, expr, env, type_params),
        },
        Range { start, end, inclusive, span: _ } => ExprKind::Range {
            start: lower_expr(ctx, start, env, type_params),
            end: lower_expr(ctx, end, env, type_params),
            inclusive,
        },
        Binary { op, lhs, rhs, span: _ } => ExprKind::Binary {
            op,
            lhs: lower_expr(ctx, lhs, env, type_params),
            rhs: lower_expr(ctx, rhs, env, type_params),
        },
        Proj { tuple: expr, index, span: _ } => {
            ExprKind::Proj { tuple: lower_expr(ctx, expr, env, type_params), index }
        },
        Field { expr, field_name: field, method_type_args, span: _ } => {
            let args: Vec[TypeExpr] = Vec::new();
            for arg in method_type_args {
                args.push(lower_type(ctx, arg, type_params))
            }
            ExprKind::Field {
                expr: lower_expr(ctx, expr, env, type_params),
                field_name: field,
                method_type_args: args,
            }
        },
        Index { base, index, span: _ } => ExprKind::Index {
            base: lower_expr(ctx, base, env, type_params),
            index: lower_expr(ctx, index, env, type_params),
        },
        Block { block, span: _ } => ExprKind::Block {
            block: lower_block(ctx, block, env, type_params),
        },
    }
}

fn lower_expr(
    ctx: LowerCtx,
    value: ast::Expr,
    env: Vec[(string, LocalId)],
    type_params: Vec[string],
) -> Expr {
    let span = ast::expr_span(value);
    let result = lower_expr_value(ctx, value, env, type_params);
    let index = ctx.expr_counter.get();
    ctx.expr_counter.set(index + 1);
    Expr {
        kind: match result {
            Try { depth: _, expr } => ExprKind::Try { depth: index, expr },
            _ => result,
        },
        span,
    }
}

fn lower_function(
    ctx: LowerCtx,
    value: ast::Function,
    def_id: DefId,
    name: string,
    inherited_type_params: Vec[string],
) -> Function {
    let has_receiver = !value.params.is_empty() && value.params[0].0 == "self";
    let env: Vec[(string, LocalId)] = Vec::new();
    let params: Vec[(LocalId, TypeExpr)] = Vec::new();
    let type_params = copy_strings(value.generics);
    for inherited in inherited_type_params {
        type_params.push(inherited)
    }
    for param in value.params {
        let local = fresh_local(ctx, param.0);
        env.push((param.0, local))
    }
    for param in value.params {
        let local = find_binding(env, param.0).unwrap_or_else(|| fresh_local(ctx, param.0));
        params.push((local, lower_type(ctx, param.1, type_params)))
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params, true))
    }
    Function {
        def_id,
        attrs: value.attrs,
        visibility: value.visibility,
        name,
        name_span: value.name_span,
        has_receiver,
        generics: value.generics,
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params, true),
        predicates,
        params,
        param_type_spans: value.param_type_spans,
        ret_ty: value.ret_ty.map(|ty| lower_type(ctx, ty, type_params)),
        ret_ty_span: value.ret_ty_span,
        body: lower_block(ctx, value.body, env, type_params),
    }
}

fn lower_extern(ctx: LowerCtx, value: ast::ExternFunction, def_id: DefId) -> ExternFunction {
    let type_params = copy_strings(value.generics);
    let params: Vec[(string, TypeExpr)] = Vec::new();
    for param in value.params {
        params.push((param.0, lower_type(ctx, param.1, type_params)))
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params, false))
    }
    ExternFunction {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_name, value.name),
        generics: value.generics,
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params, false),
        predicates,
        params,
        ret_ty: value.ret_ty.map(|ty| lower_type(ctx, ty, type_params)),
    }
}

fn lower_enum(ctx: LowerCtx, value: ast::EnumDef, def_id: DefId) -> EnumDef {
    let type_params = copy_strings(value.generics);
    let variants: Vec[EnumVariant] = Vec::new();
    for variant in value.variants {
        let fields = match variant.fields {
            Unit => EnumVariantFields::Unit,
            Tuple(types) => {
                let lowered: Vec[TypeExpr] = Vec::new();
                for ty in types {
                    lowered.push(lower_type(ctx, ty, type_params))
                }
                EnumVariantFields::Tuple(lowered)
            },
            Struct(fields) => {
                let lowered: Vec[(string, TypeExpr)] = Vec::new();
                for field in fields {
                    lowered.push((field.0, lower_type(ctx, field.1, type_params)))
                }
                EnumVariantFields::Struct(lowered)
            },
        };
        variants.push(
            EnumVariant { name: variant.name, fields, field_type_spans: variant.field_type_spans },
        )
    }
    EnumDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_name, value.name),
        generics: value.generics,
        variants,
    }
}

fn lower_struct(ctx: LowerCtx, value: ast::StructDef, def_id: DefId) -> StructDef {
    let type_params = copy_strings(value.generics);
    let fields: Vec[(string, TypeExpr)] = Vec::new();
    for field in value.fields {
        fields.push((field.0, lower_type(ctx, field.1, type_params)))
    }
    StructDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_name, value.name),
        generics: value.generics,
        newtype: value.newtype,
        fields,
        field_type_spans: value.field_type_spans,
        public_fields: value.public_fields,
    }
}

fn lower_type_alias(ctx: LowerCtx, value: ast::TypeAlias, def_id: DefId) -> TypeAlias {
    TypeAlias {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_name, value.name),
        generics: value.generics,
        ty: lower_type(ctx, value.ty, value.generics),
        ty_span: value.ty_span,
    }
}

fn lower_constant(ctx: LowerCtx, value: ast::Constant, def_id: DefId) -> Constant {
    Constant {
        def_id,
        attrs: value.attrs,
        visibility: value.visibility,
        name: full_name(ctx.package_name, value.name),
        ty: lower_type(ctx, value.ty, Vec::new()),
        ty_span: value.ty_span,
        value: lower_expr(ctx, value.value, Vec::new(), Vec::new()),
    }
}

fn lower_trait(ctx: LowerCtx, value: ast::TraitDef, def_id: DefId) -> TraitDef {
    let type_params = copy_strings(value.generics);
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params, false))
    }
    let supertraits: Vec[TraitRef] = Vec::new();
    for trait_ref in value.supertraits {
        supertraits.push(lower_plain_trait_ref(ctx, trait_ref, type_params))
    }
    let associated_types: Vec[AssociatedType] = Vec::new();
    for associated in value.associated_types {
        let bounds: Vec[TraitRef] = Vec::new();
        for bound in associated.bounds {
            bounds.push(lower_plain_trait_ref(ctx, bound, type_params))
        }
        associated_types.push(AssociatedType { name: associated.name, bounds })
    }
    let method_sigs: Vec[TraitMethodSignature] = Vec::new();
    for method in value.method_sigs {
        let method_type_params = append_strings(type_params, method.generics);
        let params: Vec[TypeExpr] = Vec::new();
        for param in method.params {
            params.push(lower_type(ctx, param.1, method_type_params))
        }
        let method_predicates: Vec[Predicate] = Vec::new();
        for predicate in method.predicates {
            method_predicates.push(lower_predicate(ctx, predicate, method_type_params, false))
        }
        method_sigs.push(
            TraitMethodSignature {
                name: method.name,
                has_receiver: method.has_receiver,
                generics: method.generics,
                generic_bounds: lower_bounds(ctx, method.generic_bounds, method_type_params, false),
                predicates: method_predicates,
                params,
                ret_ty_span: ast_type_head_span(method.ret_ty),
                ret_ty: lower_type(ctx, method.ret_ty, method_type_params),
                default_name: method.body.map(
                    |_| full_name(
                        ctx.package_name,
                        "trait_default#" + value.name + "#" + method.name,
                    ),
                ),
            },
        )
    }
    TraitDef {
        def_id,
        attrs: value.attrs,
        name: full_name(ctx.package_name, value.name),
        generics: value.generics,
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params, false),
        predicates,
        supertraits,
        associated_types,
        method_sigs,
    }
}

fn lower_impl(ctx: LowerCtx, value: ast::ImplBlock, def_id: DefId) -> ImplBlock {
    let type_params = copy_strings(value.generics);
    let methods: Vec[Function] = Vec::new();
    for method in value.methods {
        methods.push(lower_function(ctx, method, fresh_method(ctx), method.name, type_params))
    }
    let predicates: Vec[Predicate] = Vec::new();
    for predicate in value.predicates {
        predicates.push(lower_predicate(ctx, predicate, type_params, true))
    }
    let associated_types: Vec[(string, TypeExpr)] = Vec::new();
    for associated in value.associated_types {
        associated_types.push((associated.0, lower_type(ctx, associated.1, type_params)))
    }
    ImplBlock {
        def_id,
        attrs: value.attrs,
        generics: value.generics,
        generic_bounds: lower_bounds(ctx, value.generic_bounds, type_params, true),
        predicates,
        associated_types,
        trait_ref: match value.trait_ref {
            Some(trait_ref) => {
                Option::Some(lower_impl_trait_ref(ctx, trait_ref, type_params))
            },
            None => Option::None,
        },
        for_type: lower_type(ctx, value.for_type, type_params),
        for_type_span: value.for_type_span,
        methods,
    }
}

fn item_name(package_name: string, value: ast::Item) -> Option[string] {
    match value {
        EnumDef(value) => Option::Some(full_name(package_name, value.name)),
        StructDef(value) => Option::Some(full_name(package_name, value.name)),
        TraitDef(value) => Option::Some(full_name(package_name, value.name)),
        Function(value) => Option::Some(full_name(package_name, value.name)),
        ExternFunction(value) => Option::Some(full_name(package_name, value.name)),
        ExternType(value) => Option::Some(full_name(package_name, value.name)),
        TypeAlias(value) => Option::Some(full_name(package_name, value.name)),
        Constant(value) => Option::Some(full_name(package_name, value.name)),
        Static(value) => Option::Some(full_name(package_name, value.name)),
        ImplBlock(_) => Option::None,
    }
}

fn make_context(files: Vec[ast::File], canonical_package_name: string, qualify_imports: bool) -> LowerCtx {
    let id = package_id(canonical_package_name);
    let definitions: Vec[(string, DefId)] = Vec::new();
    let constants: Vec[(string, DefId)] = Vec::new();
    let enums: Vec[EnumInfo] = Vec::new();
    let nominal_types: Vec[string] = Vec::new();
    let traits: Vec[string] = Vec::new();
    let mut index = 0;
    for file in files {
        for item in file.items {
            let def_id = DefId { pkg: id, index };
            if let Some(name) = item_name(canonical_package_name, item) {
                definitions.push((name, def_id))
            }
            match item {
                Constant(value) => {
                    constants.push((full_name(canonical_package_name, value.name), def_id))
                },
                Static(value) => {
                    constants.push((full_name(canonical_package_name, value.name), def_id))
                },
                EnumDef(value) => {
                    nominal_types.push(value.name);
                    let variants: Vec[string] = Vec::new();
                    for variant in value.variants {
                        variants.push(variant.name)
                    }
                    enums.push(EnumInfo { name: value.name, def_id, variants })
                },
                StructDef(value) => nominal_types.push(value.name),
                TypeAlias(value) => nominal_types.push(value.name),
                ExternType(value) => nominal_types.push(value.name),
                TraitDef(value) => traits.push(value.name),
                _ => (),
            }
            index += 1;
        }
    }
    LowerCtx {
        package_name: canonical_package_name,
        package_id: id,
        definitions,
        constants,
        enums,
        nominal_types,
        traits,
        aliases: Vec::new(),
        qualify_imports,
        local_counter: Ref::new(0),
        method_counter: Ref::new(index),
        expr_counter: Ref::new(1),
        diagnostics: Vec::new(),
        current_pattern_span: Ref::new(Option::None),
        lexical_scopes: collections::Stack::new(),
        closure_depth: Ref::new(0),
    }
}

fn file_context(base: LowerCtx, resolved: ResolvedUses, diagnostics: Vec[Diagnostic]) -> LowerCtx {
    for message in resolved.diagnostics {
        diagnostics.push(Diagnostic { message, span: Option::None })
    }
    for entry in resolved.aliases {
        if entry.item && find_definition(base, full_name(base.package_name, entry.alias)).is_some() {
            diagnostics.push(
                Diagnostic {
                    message: "Imported item alias " + entry.alias + " conflicts with a local item",
                    span: Option::None,
                },
            )
        }
    }
    LowerCtx {
        package_name: base.package_name,
        package_id: base.package_id,
        definitions: base.definitions,
        constants: base.constants,
        enums: base.enums,
        nominal_types: base.nominal_types,
        traits: base.traits,
        aliases: resolved.aliases,
        qualify_imports: base.qualify_imports,
        local_counter: base.local_counter,
        method_counter: base.method_counter,
        expr_counter: base.expr_counter,
        diagnostics,
        current_pattern_span: base.current_pattern_span,
        lexical_scopes: collections::Stack::new(),
        closure_depth: Ref::new(0),
    }
}

fn lower_file_with_context(
    file: ast::File,
    source_path: string,
    canonical_package_name: string,
    qualify_imports: bool,
    base: LowerCtx,
    item_offset: isize,
    diagnostics: Vec[Diagnostic],
) -> File {
    let resolved = resolved_uses_from_file(file);
    let ctx = file_context(base, resolved, diagnostics);
    let items: Vec[Item] = Vec::new();
    let mut index = item_offset;
    for item in file.items {
        let def_id = DefId { pkg: ctx.package_id, index };
        match item {
            EnumDef(value) => items.push(Item::EnumDef(lower_enum(ctx, value, def_id))),
            StructDef(value) => {
                items.push(Item::StructDef(lower_struct(ctx, value, def_id)))
            },
            TraitDef(value) => {
                items.push(Item::TraitDef(lower_trait(ctx, value, def_id)))
            },
            ImplBlock(value) => {
                items.push(Item::ImplBlock(lower_impl(ctx, value, def_id)))
            },
            Function(value) => items.push(
                Item::Function(
                    lower_function(
                        ctx,
                        value,
                        def_id,
                        full_name(ctx.package_name, value.name),
                        Vec::new(),
                    ),
                ),
            ),
            ExternFunction(value) => {
                items.push(Item::ExternFunction(lower_extern(ctx, value, def_id)))
            },
            ExternType(value) => {
                items.push(
                    Item::ExternType(
                        ExternType {
                            def_id,
                            attrs: value.attrs,
                            visibility: value.visibility,
                            name: full_name(ctx.package_name, value.name),
                            name_span: value.name_span,
                            generics: value.generics,
                        },
                    ),
                )
            },
            TypeAlias(value) => {
                items.push(Item::TypeAlias(lower_type_alias(ctx, value, def_id)))
            },
            Constant(value) => {
                items.push(Item::Constant(lower_constant(ctx, value, def_id)))
            },
            Static(value) => {
                items.push(
                    Item::Static(
                        Static {
                            def_id,
                            attrs: value.attrs,
                            visibility: value.visibility,
                            name: full_name(ctx.package_name, value.name),
                            ty: lower_type(ctx, value.ty, Vec::new()),
                            ty_span: value.ty_span,
                            value: lower_expr(ctx, value.value, Vec::new(), Vec::new()),
                        },
                    ),
                )
            },
        }
        index += 1;
    }
    File {
        package_name: canonical_package_name,
        path: if is_special_package(canonical_package_name) {
            basename(source_path)
        } else {
            canonical_package_name + "/" + basename(source_path)
        },
        source_path,
        imports: imports_from_aliases(resolved.aliases),
        import_aliases: import_aliases_from_file(file, resolved.aliases),
        use_traits: if qualify_imports {
            resolved.traits
        } else {
            Vec::new()
        },
        public_reexports: if qualify_imports {
            resolved.public_reexports
        } else {
            Vec::new()
        },
        items,
        invalid_self_type_spans: file.invalid_self_type_spans,
    }
}

fn lower_file(
    file: ast::File,
    source_path: string,
    canonical_package_name: string,
    qualify_imports: bool,
    diagnostics: Vec[Diagnostic],
) -> File {
    let files: Vec[ast::File] = Vec::new();
    files.push(file);
    lower_file_with_context(
        file,
        source_path,
        canonical_package_name,
        qualify_imports,
        make_context(files, canonical_package_name, qualify_imports),
        0,
        diagnostics,
    )
}

fn ast_diagnostics(values: Vec[cst::Diagnostic]) -> Vec[Diagnostic] {
    let result: Vec[Diagnostic] = Vec::new();
    for value in values {
        result.push(
            Diagnostic {
                message: value.message,
                span: Option::Some(ast::span(value.start, value.end)),
            },
        )
    }
    result
}

pub fn lower_expanded(value: ast::LowerResult, source_path: string) -> LowerResult {
    let diagnostics = ast_diagnostics(value.diagnostics);
    match value.ast {
        Some(file) => LowerResult {
            hir: Option::Some(lower_file(file, source_path, file.package_name, false, diagnostics)),
            source_path,
            diagnostics,
        },
        None => {
            if diagnostics.is_empty() {
                diagnostics.push(Diagnostic { message: "AST lowering failed", span: Option::None })
            }
            LowerResult { hir: Option::None, source_path, diagnostics }
        },
    }
}

pub fn lower_expanded_package(
    value: ast::LowerResult,
    source_path: string,
    canonical_package_name: string,
) -> LowerResult {
    let diagnostics = ast_diagnostics(value.diagnostics);
    match value.ast {
        Some(file) => LowerResult {
            hir: Option::Some(
                lower_file(file, source_path, canonical_package_name, true, diagnostics),
            ),
            source_path,
            diagnostics,
        },
        None => {
            if diagnostics.is_empty() {
                diagnostics.push(Diagnostic { message: "AST lowering failed", span: Option::None })
            }
            LowerResult { hir: Option::None, source_path, diagnostics }
        },
    }
}

pub fn lower(value: ast::LowerResult, source_path: string) -> LowerResult {
    lower_expanded(expand_derives(value), source_path)
}

pub fn lower_package(value: ast::LowerResult, source_path: string, canonical_package_name: string) -> LowerResult {
    lower_expanded_package(expand_derives(value), source_path, canonical_package_name)
}

pub fn lower_expanded_package_files(
    values: Vec[(ast::LowerResult, string)],
    canonical_package_name: string,
) -> Vec[LowerResult] {
    let files: Vec[ast::File] = Vec::new();
    for value in values {
        if let Some(file) = value.0.ast {
            files.push(file)
        }
    }
    let base = make_context(files, canonical_package_name, true);
    let mut item_offset = 0;
    let lowered: Vec[LowerResult] = Vec::new();
    for value in values {
        match value.0.ast {
            Some(file) => {
                let diagnostics = ast_diagnostics(value.0.diagnostics);
                lowered.push(
                    LowerResult {
                        hir: Option::Some(
                            lower_file_with_context(
                                file,
                                value.1,
                                canonical_package_name,
                                true,
                                base,
                                item_offset,
                                diagnostics,
                            ),
                        ),
                        source_path: value.1,
                        diagnostics,
                    },
                );
                item_offset = item_offset + file.items.len();
            },
            None => {
                let diagnostics = ast_diagnostics(value.0.diagnostics);
                if diagnostics.is_empty() {
                    diagnostics.push(
                        Diagnostic { message: "AST lowering failed", span: Option::None },
                    )
                }
                lowered.push(LowerResult { hir: Option::None, source_path: value.1, diagnostics })
            },
        }
    }
    lowered
}

pub fn lower_package_files(values: Vec[(ast::LowerResult, string)], canonical_package_name: string) -> Vec[
    LowerResult,
] {
    let expanded: Vec[(ast::LowerResult, string)] = Vec::new();
    for value in values {
        expanded.push((expand_derives(value.0), value.1))
    }
    lower_expanded_package_files(expanded, canonical_package_name)
}
