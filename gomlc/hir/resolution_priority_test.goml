package hir;

use module::ast;
use module::parser;
use std::testing;

fn generated_variant_lowering(source: string) -> LowerResult {
    let parsed = ast::lower(parser::parse(source));
    let generated = parsed.ast.map(
        |file| {
            let items: Vec[ast::Item] = Vec::new();
            for item in file.items {
                match item {
                    EnumDef(value) => items.push(
                        ast::Item::EnumDef(
                            ast::EnumDef {
                                variants: Vec::from_array(
                                    [ast::EnumVariant { name: "value", ..value.variants[0] }],
                                ),
                                ..value,
                            },
                        ),
                    ),
                    _ => items.push(item),
                }
            }
            ast::File { items, ..file }
        },
    );
    lower(ast::LowerResult { ast: generated, ..parsed }, "generated.goml")
}

#[test]
fn local_values_take_priority_over_generated_variant_names() -> () {
    for source in Vec::from_array(
        [
            "enum Choice { Value(isize) } fn sample(value: isize) -> isize { value }",
            "enum Choice { Value(isize) } fn sample() -> isize { let value = 1; value }",
            "enum Choice { Value(isize) } fn sample(value: (isize) -> isize) -> isize { value(1) }",
            "enum Choice { Value(isize) } fn sample() -> isize { let value = |input: isize| input; value(1) }",
        ],
    ) {
        let result = generated_variant_lowering(source);
        testing::assert_eq(result.diagnostics.len(), 0);
        if let Some(file) = result.hir {
            if let Function(function) = file.items[1] {
                if let Some(tail) = function.body.tail {
                    let reference = match tail.kind {
                        Call { func, .. } => func,
                        _ => tail,
                    };
                    match reference.kind {
                        NameRef { name_ref: Local(_) } => (),
                        _ => testing::fail("expected a local reference before constructor lookup"),
                    }
                } else {
                    testing::fail("expected function tail")
                }
            } else {
                testing::fail("expected function")
            }
        } else {
            testing::fail("expected HIR")
        }
    }
}

#[test]
fn generic_owners_remain_unresolved_in_constructors_and_patterns() -> () {
    let file = lowered_package_file(
        "package sample; enum T { Item(isize) } fn sample[T](input: T) -> isize { let _ = T::Item(1); let _ = T::Item; match input { T::Item(value) => value } }",
        "review::sample",
    );
    if let Function(function) = file.items[1] {
        if let Let { value, .. } = function.body.stmts[0] {
            match value.kind {
                Constr { constructor: Unresolved(name), .. } => testing::assert_eq(name, "T::Item"),
                _ => testing::fail("generic owner resolved to a package enum"),
            }
        } else {
            testing::fail("expected constructor binding")
        }
        if let Let { value, .. } = function.body.stmts[1] {
            match value.kind {
                ConstructorValue { constructor: Unresolved(name) } => testing::assert_eq(
                    name,
                    "T::Item",
                ),
                _ => testing::fail("generic constructor value resolved to a package enum"),
            }
        } else {
            testing::fail("expected constructor value binding")
        }
        if let Some(tail) = function.body.tail {
            if let Match { arms, .. } = tail.kind {
                match arms[0].pat.kind {
                    Constr { head: Qualified { name, .. }, .. } => testing::assert_eq(
                        name,
                        "T::Item",
                    ),
                    _ => testing::fail("generic pattern owner resolved to a package enum"),
                }
            } else {
                testing::fail("expected match")
            }
        } else {
            testing::fail("expected function tail")
        }
    } else {
        testing::fail("expected function")
    }
}
