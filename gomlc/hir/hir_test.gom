package hir;

use module::ast;
use module::ctir;
use module::parser;
use std::testing;

fn lowered_file(source: string) -> File {
    let result = lower(ast::lower(parser::parse(source)), "main.gom");
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Some(file) => file,
        None => {
            testing::fail("expected HIR");
            File {
                package_name: "",
                path: "",
                source_path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn lowered_package_file(source: string, package_name: string) -> File {
    let result = lower_package(ast::lower(parser::parse(source)), "package.gom", package_name);
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Some(file) => file,
        None => {
            testing::fail("expected package HIR");
            File {
                package_name: "",
                path: "",
                source_path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

fn derive_export_module(package_name: string, export_name: string) -> ctir::CtModule {
    let module = ctir::empty_module(package_name);
    module.derive_entries.push(
        ctir::CtDeriveEntry {
            name: package_name + "::handler",
            function_id: 0,
            public: true,
            export_name: Option::Some(export_name),
        },
    );
    module
}

#[test]
fn rejects_ambiguous_imported_derive_names() -> () {
    let expanded = expand_derives_with_environment(
        ast::lower(
            parser::parse(
                "use alice::first as first; use first::Label; use bob::second as second; use second::Label; #[derive(Label)] struct Value {}",
            ),
        ),
        DeriveEnvironment {
            builtin: Option::None,
            dependencies: Vec::from_array(
                [
                    derive_export_module("alice::first", "Label"),
                    derive_export_module("bob::second", "Label"),
                ],
            ),
            reexports: Vec::new(),
        },
    );
    testing::assert_eq(expanded.diagnostics.len(), 1);
    testing::assert_eq(
        expanded.diagnostics[0].message,
        "derive name `Label` is ambiguous; use a package-qualified name or an import alias",
    )
}

#[test]
fn reports_pattern_binding_errors_during_resolution() -> () {
    let duplicate = lower(
        ast::lower(parser::parse("fn main() -> () { let (value, value) = (1, 2); }")),
        "main.gom",
    );
    testing::assert_eq(duplicate.diagnostics.len(), 1);
    testing::assert_eq(
        duplicate.diagnostics.get(0).message,
        "Variable value is bound more than once in the same pattern",
    );
    if let None = duplicate.hir {
        testing::fail("expected duplicate pattern HIR")
    }
    let inconsistent = lower(
        ast::lower(
            parser::parse(
                "enum Maybe { None, Some(i32) } fn main() -> () { let value = Maybe::Some(1); let _ = match value { Maybe::Some(inner) | Maybe::None => inner, _ => 0 }; }",
            ),
        ),
        "main.gom",
    );
    testing::assert_eq(inconsistent.diagnostics.len(), 1);
    testing::assert_eq(
        inconsistent.diagnostics.get(0).message,
        "Or-pattern alternatives must bind the same variables: missing inner",
    );
    if let None = inconsistent.hir {
        testing::fail("expected inconsistent pattern HIR")
    }
}

#[test]
fn rejects_spawn_without_a_non_escaping_lexical_scope() -> () {
    let outside = lower(
        ast::lower(parser::parse("fn main() -> () { let _ = spawn || (); }")),
        "main.gom",
    );
    testing::assert_eq(outside.diagnostics.len(), 1);
    testing::assert_eq(
        outside.diagnostics.get(0).message,
        "spawn requires an enclosing lexical scope",
    );
    let escaping = lower(
        ast::lower(parser::parse("fn make() -> () -> () { scope { || { let _ = spawn || (); } } }")),
        "main.gom",
    );
    testing::assert_eq(escaping.diagnostics.len(), 1);
    testing::assert_eq(
        escaping.diagnostics.get(0).message,
        "spawn cannot capture an enclosing lexical scope across a closure boundary; create a nested scope inside the closure",
    )
}

#[test]
fn lowers_nested_lexical_task_scopes_before_typed_hir() -> () {
    let result = lower(
        ast::lower(
            parser::parse(
                "use std::task; fn main() -> () { scope { scope { let _ = spawn |_cancel| (); } } }",
            ),
        ),
        "main.gom",
    );
    testing::assert_eq(result.diagnostics.len(), 0)
}

#[test]
fn indents_multiline_calls_canonically() -> () {
    let source = "struct Box { value: i32 } fn make(value: Box) -> Box { value } fn main() -> () { let values = Vec::new().pushed(make(Box { value: 1 })).pushed(make(Box { value: 2 })); }";
    testing::assert_eq(
        encode(lower(ast::lower(parser::parse(source)), "main.gom")),
        \\package main
        \\file main.gom
        \\  struct Box {
        \\      value: i32,
        \\  }
        \\
        \\  fn make(local/1/0: Box) -> Box {
        \\      value/0
        \\  }
        \\
        \\  fn main() -> () {
        \\      let local/1/1 =
        \\        Vec::new().pushed(def/1/1(Box { value: 1 })).pushed(def/1/1(Box { value: 2 }));
        \\  }
        ,
    )
}

#[test]
fn qualifies_package_items_types_and_import_aliases() -> () {
    let source = "package sample; use std::io as output; struct Value { field: i32 } fn emit(value: Value) -> Value { output::println(\"ok\"); Value { field: value.field } }";
    let file = lowered_package_file(source, "std::sample");
    testing::assert_eq(file.package_name, "std::sample");
    testing::assert_eq(file.import_aliases.len(), 1);
    testing::assert_eq(file.import_aliases.get(0).alias, "output");
    testing::assert_eq(file.import_aliases.get(0).package_name, "std::io");
    match file.items.get(1) {
        Function(value) => {
            testing::assert_eq(value.name, "std::sample::emit");
            match value.params.get(0).1 {
                Con { name } => testing::assert_eq(name, "std::sample::Value"),
                _ => testing::fail("expected qualified parameter type"),
            }
            match value.body.stmts.get(0) {
                Expr {
                    expr: Expr {
                        kind: Call {
                            func: Expr { kind: StaticMember { owner, member, .. }, span: _ },
                            args: _,
                        },
                        span: _,
                    },
                } => {
                    testing::assert_eq(owner, "std::io");
                    testing::assert_eq(member, "println")
                },
                _ => testing::fail("expected qualified package call"),
            }
            match value.body.tail {
                Some(Expr { kind: StructLiteral { name, fields: _, base: _ }, span: _ }) => {
                    testing::assert_eq(name, "std::sample::Value")
                },
                _ => testing::fail("expected qualified struct literal"),
            }
        },
        _ => testing::fail("expected package function"),
    }
}

#[test]
fn resolves_traits_imported_through_package_aliases() -> () {
    let file = lowered_package_file(
        "package usepkg; use vendor::traits as traitpkg; use traitpkg::Render; fn render() -> () {}",
        "vendor::usepkg",
    );
    testing::assert_eq(file.import_aliases.len(), 1);
    testing::assert_eq(file.import_aliases.get(0).alias, "traitpkg");
    testing::assert_eq(file.import_aliases.get(0).package_name, "vendor::traits");
    testing::assert_eq(file.use_traits.len(), 1);
    testing::assert_eq(file.use_traits.get(0), "vendor::traits::Render")
}

#[test]
fn resolves_braced_import_items_and_aliases() -> () {
    let file = lowered_package_file(
        "package app; use vendor::api::{Widget as Box, Render, make}; fn run(value: Box) -> Box { let make = |item| item; make(value) }",
        "vendor::app",
    );
    testing::assert_eq(file.import_aliases.len(), 1);
    testing::assert_eq(file.import_aliases.get(0).alias, "");
    testing::assert_eq(file.import_aliases.get(0).package_name, "vendor::api");
    testing::assert_eq(file.imports.len(), 3);
    testing::assert_eq(file.imports.get(0), "vendor::api::Widget");
    testing::assert_eq(file.imports.get(1), "vendor::api::Render");
    testing::assert_eq(file.imports.get(2), "vendor::api::make");
    testing::assert_eq(file.use_traits.len(), 3);
    testing::assert_eq(file.use_traits.get(0), "vendor::api::Widget");
    testing::assert_eq(file.use_traits.get(1), "vendor::api::Render");
    testing::assert_eq(file.use_traits.get(2), "vendor::api::make");
    match file.items.get(0) {
        Function(value) => {
            match value.params.get(0).1 {
                Con { name } => testing::assert_eq(name, "vendor::api::Widget"),
                _ => testing::fail("expected imported parameter type"),
            }
            match value.body.tail {
                Some(Expr { kind: Call { func, args: _ }, span: _ }) => match func.kind {
                    NameRef { name_ref: Local(_) } => (),
                    _ => testing::fail("expected local binding to shadow imported item"),
                },
                _ => testing::fail("expected local call"),
            }
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_definitions_and_shadowed_locals() -> () {
    let source = "fn id(value: i32) -> i32 { value } fn main() -> i32 { let value = 1; id(value) }";
    let file = lowered_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Pat { kind: Var { name: local, is_mut: _ }, span: _ },
                    annotation: _,
                    value: Expr { kind: Int { value: number }, span: _ },
                    else_branch: _,
                } => {
                    testing::assert_eq(local.pkg, 1);
                    testing::assert_eq(local.index, 1);
                    testing::assert_eq(number, "1")
                },
                _ => testing::fail("expected local binding"),
            }
            match value.body.tail {
                Some(Expr { kind: Call { func: function, args }, span: _ }) => {
                    match function.kind {
                        NameRef { name_ref: Def(definition) } => {
                            testing::assert_eq(definition.pkg, 1);
                            testing::assert_eq(definition.index, 0)
                        },
                        _ => testing::fail("expected definition reference"),
                    }
                    testing::assert_eq(args.len(), 1);
                    match args.get(0).kind {
                        NameRef { name_ref: Local(local) } => {
                            testing::assert_eq(local.pkg, 1);
                            testing::assert_eq(local.index, 1)
                        },
                        _ => testing::fail("expected local reference"),
                    }
                },
                _ => testing::fail("expected function call"),
            }
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_enum_constructors_and_pattern_bindings() -> () {
    let source = "enum Choice { None, Some(i32) } fn unwrap(value: Choice) -> i32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = lowered_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Expr { kind: Match { expr: _, arms }, span: _ }) => {
                testing::assert_eq(arms.len(), 2);
                match arms.get(0).pat.kind {
                    Constr {
                        head: Resolved { enum_def: definition, variant_index: variant, span: _ },
                        args,
                    } => {
                        testing::assert_eq(definition.pkg, 1);
                        testing::assert_eq(definition.index, 0);
                        testing::assert_eq(variant, 1);
                        testing::assert_eq(args.len(), 1)
                    },
                    _ => testing::fail("expected resolved constructor pattern"),
                }
                match arms.get(0).body.kind {
                    NameRef { name_ref: Local(local) } => {
                        testing::assert_eq(local.pkg, 1);
                        testing::assert_eq(local.index, 1)
                    },
                    _ => testing::fail("expected pattern local reference"),
                }
            },
            _ => testing::fail("expected match expression"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_cross_file_constructor_patterns() -> () {
    let parsed = Vec::new();
    parsed.push(parser::parse("package main; enum Status { Idle, Busy(i32) }"));
    parsed.push(
        parser::parse(
            "package main; fn label(status: Status) -> string { match status { Idle => \"idle\", Busy(value) => value.to_string() } }",
        ),
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "types.gom"));
    inputs.push((ast_files.get(1), "main.gom"));
    let lowered = lower_package_files(inputs, "main");
    testing::assert_eq(lowered.len(), 2);
    match lowered.get(1).hir {
        Some(file) => match file.items.get(0) {
            Function(function) => match function.body.tail {
                Some(Expr { kind: Match { expr: _, arms }, span: _ }) => {
                    match arms.get(0).pat.kind {
                        Constr { head: Contextual { name, span: _ }, args } => {
                            testing::assert_eq(name, "Idle");
                            testing::assert_eq(args.len(), 0)
                        },
                        _ => testing::fail("expected resolved Idle pattern"),
                    }
                    match arms.get(1).pat.kind {
                        Constr { head: Contextual { name, span: _ }, args } => {
                            testing::assert_eq(name, "Busy");
                            testing::assert_eq(args.len(), 1)
                        },
                        _ => testing::fail("expected resolved Busy pattern"),
                    }
                },
                _ => testing::fail("expected cross-file match"),
            },
            _ => testing::fail("expected label function"),
        },
        None => testing::fail("expected cross-file HIR"),
    }
}

#[test]
fn rejects_invalid_derives() -> () {
    let unsupported = lower(
        ast::lower(parser::parse("#[derive(ToJson)] struct User { name: string }")),
        "main.gom",
    );
    testing::assert_eq(unsupported.diagnostics.len(), 1);
    testing::assert_eq(
        unsupported.diagnostics.get(0).message,
        "derive name `ToJson` is not in scope; library derives must be qualified or explicitly imported",
    );
}

#[test]
fn extracts_basename_from_unicode_paths() -> () {
    testing::assert_eq(basename("/tmp/目录/main.gom"), "main.gom");
    testing::assert_eq(basename("目录.gom"), "目录.gom")
}

#[test]
fn external_types_keep_canonical_declaration_identity() -> () {
    let file = lowered_package_file(
        "#[go_type(\"host\", \"Box\")] pub extern type Box[T];",
        "demo::calc",
    );
    match file.items[0] {
        ExternType(value) => {
            testing::assert_eq(value.name, "demo::calc::Box");
            testing::assert_eq(value.generics[0], "T");
            testing::assert_eq(value.attrs[0].name, "go_type");
            testing::assert(value.name_span.end > value.name_span.start);
        },
        _ => testing::fail("missing external type in HIR"),
    }
}
