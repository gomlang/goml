package hir;

use module::ast;

fn interface_bridge_items(definition: ast::TraitDef, spec: ast::GoInterfaceSpec) -> Vec[ast::Item] {
    let span = spec.span;
    let helper = "__goml_interface_" + spec.wrapper_name + "_from_trait";
    let methods: Vec[ast::AttributeArg] = Vec::new();
    let parameters: Vec[(string, ast::TypeExpr)] = Vec::new();
    let closures: Vec[ast::Expr] = Vec::new();
    for index in 0..definition.method_sigs.len() {
        let method = definition.method_sigs[index];
        for mapping in spec.methods {
            if mapping.0 == method.name {
                methods.push(ast::AttributeArg::String(mapping.1));
            }
        }
        let types: Vec[ast::TypeExpr] = Vec::new();
        let params: Vec[ast::ClosureParam] = Vec::new();
        let args: Vec[ast::Expr] = Vec::new();
        for position in 1..method.params.len() {
            let name = "arg" + position.to_string();
            let ty = method.params[position].1;
            types.push(ty);
            params.push(ast::ClosureParam { name, ty: Option::Some(ty), span });
            args.push(interface_variable(name, span));
        }
        parameters.push(
            (
                "method" + index.to_string(),
                ast::TypeExpr::Func { params: types, ret_ty: method.ret_ty },
            ),
        );
        closures.push(
            ast::Expr::Closure {
                params,
                body: ast::Expr::Call {
                    func: ast::Expr::Field {
                        expr: interface_variable("value", span),
                        field_name: method.name,
                        method_type_args: Vec::new(),
                        span,
                    },
                    args,
                    span,
                },
                span,
            },
        );
    }
    let raw_type = interface_type(spec.raw_type, span);
    let wrapper_type = interface_type(spec.wrapper_name, span);
    Vec::from_array(
        [
            ast::Item::ExternFunction(
                ast::ExternFunction {
                    name_span: span,
                    attrs: Vec::from_array(
                        [
                            ast::Attribute {
                                span,
                                text: "#[go_interface_bridge]",
                                name: "go_interface_bridge",
                                has_argument_list: true,
                                args: methods,
                            },
                        ],
                    ),
                    visibility: ast::Visibility::Private,
                    name: helper,
                    generics: Vec::new(),
                    generic_bounds: Vec::new(),
                    predicates: Vec::new(),
                    params: parameters,
                    ret_ty: Option::Some(raw_type),
                },
            ),
            interface_impl(
                wrapper_type,
                Option::None,
                Vec::from_array(
                    [
                        interface_function(
                            "from_trait",
                            definition.visibility,
                            Vec::from_array(
                                [
                                    (
                                        "value",
                                        ast::TypeExpr::Dyn {
                                            bounds: Vec::from_array(
                                                [
                                                    ast::DynTraitBound {
                                                        trait_path: interface_path(
                                                            definition.name,
                                                            span,
                                                        ),
                                                        args: Vec::new(),
                                                        associated_types: Vec::new(),
                                                    },
                                                ],
                                            ),
                                        },
                                    ),
                                ],
                            ),
                            wrapper_type,
                            ast::Expr::StructLiteral {
                                name: interface_path(spec.wrapper_name, span),
                                fields: Vec::from_array(
                                    [
                                        (
                                            "raw",
                                            ast::Expr::Call {
                                                func: interface_variable(helper, span),
                                                args: closures,
                                                span,
                                            },
                                        ),
                                    ],
                                ),
                                base: Option::None,
                                span,
                            },
                            span,
                        ),
                    ],
                ),
                span,
            ),
        ],
    )
}
