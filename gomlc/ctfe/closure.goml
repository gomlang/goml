package ctfe;

use module::ctir;

fn eval_closure(
    state: EvalState,
    module: ctir::CtModule,
    origin: isize,
    function: ctir::CtValue,
    args: Vec[ctir::CtValue],
) -> Result[ctir::CtValue, CtError] {
    let ctir::CtValue::Callable { id, ty } = function else {
        return Result::Err(
            ct_error(state, module, origin, "comptime invocation requires a function"),
        )
    };
    if id < 0 || id >= state.closures.len() {
        return Result::Err(ct_error(state, module, origin, "invalid comptime function handle"))
    }
    let closure = state.closures[id];
    let ctir::CtType::Function { params, result: _ } = ty else {
        return Result::Err(ct_error(state, module, origin, "invalid comptime function type"))
    };
    if args.len() != closure.parameters.len() || args.len() != params.len() {
        return Result::Err(
            ct_error(state, module, origin, "comptime closure argument count mismatch"),
        )
    }
    for index in 0..args.len() {
        if !value_matches_type(args[index], params[index]) {
            return Result::Err(
                ct_error(state, module, origin, "comptime closure argument type mismatch"),
            )
        }
    }
    if state.call_depth.get() >= state.limits.call_depth {
        return Result::Err(ct_error(state, module, origin, "comptime call depth limit exceeded"))
    }
    charge_allocation(
        state,
        module,
        origin,
        closure.frame.locals.len(),
        closure.frame.locals.len() * 16,
    )?;
    let locals: Vec[Ref[Option[ctir::CtValue]]] = Vec::new();
    for index in 0..closure.frame.locals.len() {
        locals.push(
            if index < closure.local_start {
                closure.frame.locals[index]
            } else {
                Ref::new(Option::None)
            },
        );
    }
    let frame = EvalFrame { locals };
    for index in 0..args.len() {
        let _ = set_local(frame, closure.parameters[index], args[index]);
    }
    state.call_depth.set(state.call_depth.get() + 1);
    state.stack.push(
        CtStackFrame {
            package_name: closure.module.package_name,
            function_name: "<closure>",
            origin: closure.body.origin,
        },
    );
    let result = eval_expr(state, closure.module, frame, closure.body);
    state.stack.truncate(state.stack.len() - 1);
    state.call_depth.set(state.call_depth.get() - 1);
    match result {
        Ok(EvalFlow::Value(value)) | Ok(EvalFlow::Return(value)) => Result::Ok(value),
        Ok(_) => Result::Err(
            ct_error(state, module, origin, "invalid control flow from comptime closure"),
        ),
        Err(error) => Result::Err(error),
    }
}
