package ctfe;

use module::ctir;
use std::testing;

fn int_type() -> ctir::CtType {
    ctir::CtType::Integer { signed: true, width: 64 }
}

fn int_value(value: isize) -> ctir::CtValue {
    ctir::CtValue::Integer { signed: true, width: 64, bits: value.to_u64() }
}

fn int_expr(value: isize) -> ctir::CtExpr {
    ctir::CtExpr { kind: ctir::CtExprKind::Value(int_value(value)), ty: int_type(), origin: 0 }
}

fn narrow_int_type(signed: bool, width: isize) -> ctir::CtType {
    ctir::CtType::Integer { signed, width }
}

fn narrow_int_value(signed: bool, width: isize, bits: u64) -> ctir::CtValue {
    ctir::CtValue::Integer { signed, width, bits }
}

fn narrow_int_expr(signed: bool, width: isize, bits: u64) -> ctir::CtExpr {
    ctir::CtExpr {
        kind: ctir::CtExprKind::Value(narrow_int_value(signed, width, bits)),
        ty: narrow_int_type(signed, width),
        origin: 0,
    }
}

fn local_expr(slot: isize, ty: ctir::CtType) -> ctir::CtExpr {
    ctir::CtExpr { kind: ctir::CtExprKind::Local(slot), ty, origin: 0 }
}

fn bool_expr(value: bool) -> ctir::CtExpr {
    ctir::CtExpr {
        kind: ctir::CtExprKind::Value(ctir::CtValue::Bool(value)),
        ty: ctir::CtType::Bool,
        origin: 0,
    }
}

fn unit_expr() -> ctir::CtExpr {
    ctir::CtExpr {
        kind: ctir::CtExprKind::Value(ctir::CtValue::Unit),
        ty: ctir::CtType::Unit,
        origin: 0,
    }
}

fn loop_then(control: ctir::CtExpr) -> ctir::CtExpr {
    let loop_expr = ctir::CtExpr {
        kind: ctir::CtExprKind::While { target: 7, condition: bool_expr(false), body: unit_expr() },
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock {
                statements: Vec::from_array(
                    [ctir::CtStmt::Expr(loop_expr), ctir::CtStmt::Expr(control)],
                ),
                tail: Option::None,
                origin: 0,
            },
        ),
        ty: ctir::CtType::Unit,
        origin: 0,
    }
}

fn compile_error_expr(message: string) -> ctir::CtExpr {
    ctir::CtExpr {
        kind: ctir::CtExprKind::CompileError(
            ctir::CtExpr {
                kind: ctir::CtExprKind::Value(ctir::CtValue::String(message)),
                ty: ctir::CtType::String,
                origin: 0,
            },
        ),
        ty: ctir::CtType::Never,
        origin: 0,
    }
}

fn expression_module(expression: ctir::CtExpr, local_types: Vec[ctir::CtType]) -> ctir::CtModule {
    let module = ctir::empty_module("test::expression");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: local_types.len(),
            local_types,
            expression,
            origin: 0,
        },
    );
    module
}

fn evaluate_expression(expression: ctir::CtExpr, local_types: Vec[ctir::CtType], limits: EvalLimits) -> Result[
    ctir::CtValue,
    CtError,
] {
    let module = expression_module(expression, local_types);
    match verify_module(module, Vec::new()) {
        Ok(()) => evaluate_site(module, Vec::new(), 0, limits),
        Err(error) => {
            testing::fail(error.to_string());
            Result::Err(
                CtError {
                    kind: CtErrorKind::Failure,
                    message: error,
                    package_name: "test::expression",
                    origin: 0,
                    stack: Vec::new(),
                },
            )
        },
    }
}

fn binary_expr(op: ctir::CtBinaryOp, left: ctir::CtExpr, right: ctir::CtExpr, ty: ctir::CtType) -> ctir::CtExpr {
    ctir::CtExpr { kind: ctir::CtExprKind::Binary { op, left, right }, ty, origin: 0 }
}

fn factorial_module() -> ctir::CtModule {
    let n = local_expr(0, int_type());
    let condition = binary_expr(ctir::CtBinaryOp::LessEq, n, int_expr(1), ctir::CtType::Bool);
    let decrement = binary_expr(ctir::CtBinaryOp::Sub, n, int_expr(1), int_type());
    let recursive = ctir::CtExpr {
        kind: ctir::CtExprKind::Call {
            target: ctir::CtCallTarget::Local(0),
            args: Vec::from_array([decrement]),
        },
        ty: int_type(),
        origin: 0,
    };
    let result = binary_expr(ctir::CtBinaryOp::Mul, n, recursive, int_type());
    let body_expr = ctir::CtExpr {
        kind: ctir::CtExprKind::If { condition, then_branch: int_expr(1), else_branch: result },
        ty: int_type(),
        origin: 0,
    };
    let module = ctir::empty_module("test::factorial");
    module.functions.push(
        ctir::CtFunction {
            id: 0,
            name: "factorial",
            parameter_slots: Vec::from_array([0]),
            parameter_types: Vec::from_array([int_type()]),
            local_count: 1,
            local_types: Vec::from_array([int_type()]),
            return_type: int_type(),
            body: ctir::CtBlock { statements: Vec::new(), tail: Option::Some(body_expr), origin: 0 },
            origin: 0,
        },
    );
    module.entries.push(ctir::CtEntry { name: "factorial", function_id: 0, public: true });
    module
}

fn expect_int(result: Result[ctir::CtValue, CtError]) -> isize {
    match result {
        Ok(ctir::CtValue::Integer { signed: true, width: 64, bits }) => bits.to_isize(),
        Ok(_) => {
            testing::fail("expected comptime integer");
            0
        },
        Err(error) => {
            testing::fail(error.message);
            0
        },
    }
}

fn expect_string_intrinsic(name: string, args: Vec[ctir::CtValue]) -> ctir::CtValue {
    match call_value_intrinsic(ctir::CtTarget { int_width: 64 }, name, args) {
        Some(Ok(value)) => value,
        Some(Err(error)) => {
            testing::fail(error.to_string());
            ctir::CtValue::Unit
        },
        None => {
            testing::fail("expected compile-time string intrinsic");
            ctir::CtValue::Unit
        },
    }
}

#[test]
fn evaluates_compile_time_string_intrinsics() -> () {
    match expect_string_intrinsic(
        "comptime.string.len",
        Vec::from_array([ctir::CtValue::String("éa")]),
    ) {
        ctir::CtValue::Integer { bits, .. } => testing::assert_eq(bits, 3),
        _ => testing::fail("expected string length"),
    }
    match expect_string_intrinsic(
        "comptime.string.get",
        Vec::from_array([ctir::CtValue::String("éa"), int_value(2)]),
    ) {
        ctir::CtValue::Char(value) => testing::assert_eq(value, 'a'),
        _ => testing::fail("expected string character"),
    }
    match expect_string_intrinsic(
        "comptime.string.byte_get",
        Vec::from_array([ctir::CtValue::String("éa"), int_value(0)]),
    ) {
        ctir::CtValue::Integer { bits, .. } => testing::assert_eq(bits, 195),
        _ => testing::fail("expected string byte"),
    }
    match expect_string_intrinsic(
        "comptime.string.byte_slice",
        Vec::from_array([ctir::CtValue::String("éa"), int_value(0), int_value(2)]),
    ) {
        ctir::CtValue::String(value) => testing::assert_eq(value, "é"),
        _ => testing::fail("expected string slice"),
    }
    match expect_string_intrinsic(
        "comptime.string.is_char_boundary",
        Vec::from_array([ctir::CtValue::String("éa"), int_value(1)]),
    ) {
        ctir::CtValue::Bool(value) => testing::assert(!value),
        _ => testing::fail("expected character boundary result"),
    }
    match expect_string_intrinsic(
        "comptime.string.contains",
        Vec::from_array([ctir::CtValue::String("derive"), ctir::CtValue::String("riv")]),
    ) {
        ctir::CtValue::Bool(value) => testing::assert(value),
        _ => testing::fail("expected string search result"),
    }
}

#[test]
fn rejects_invalid_compile_time_string_boundaries() -> () {
    match call_value_intrinsic(
        ctir::CtTarget { int_width: 64 },
        "comptime.string.get",
        Vec::from_array([ctir::CtValue::String("é"), int_value(1)]),
    ) {
        Some(Err(error)) => testing::assert(
            error.contains("out of bounds or not a character boundary"),
        ),
        _ => testing::fail("expected invalid character boundary"),
    }
    match call_value_intrinsic(
        ctir::CtTarget { int_width: 32 },
        "comptime.string.byte_get",
        Vec::from_array(
            [
                ctir::CtValue::String("a"),
                ctir::CtValue::Integer { signed: true, width: 32, bits: 4294967295 },
            ],
        ),
    ) {
        Some(Err(error)) => testing::assert_eq(error, "comptime string byte index is out of bounds"),
        _ => testing::fail("expected negative target-width string index rejection"),
    }
}

#[test]
fn evaluates_recursive_direct_calls() -> () {
    let module = factorial_module();
    if let Err(error) = verify_module(module, Vec::new()) {
        testing::fail(error.to_string())
    }
    testing::assert_eq(
        expect_int(
            evaluate_entry(
                module,
                Vec::new(),
                "factorial",
                Vec::from_array([int_value(10)]),
                default_limits(),
            ),
        ),
        3628800,
    )
}

fn loop_site_module() -> ctir::CtModule {
    let increment = binary_expr(
        ctir::CtBinaryOp::Add,
        local_expr(0, int_type()),
        int_expr(1),
        int_type(),
    );
    let add = binary_expr(
        ctir::CtBinaryOp::Add,
        local_expr(1, int_type()),
        local_expr(0, int_type()),
        int_type(),
    );
    let condition = binary_expr(
        ctir::CtBinaryOp::Less,
        local_expr(0, int_type()),
        int_expr(5),
        ctir::CtType::Bool,
    );
    let loop_body = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock {
                statements: Vec::from_array(
                    [
                        ctir::CtStmt::Assign { slot: 1, value: add },
                        ctir::CtStmt::Assign { slot: 0, value: increment },
                    ],
                ),
                tail: Option::None,
                origin: 0,
            },
        ),
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    let while_expr = ctir::CtExpr {
        kind: ctir::CtExprKind::While { target: 0, condition, body: loop_body },
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    let body = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock {
                statements: Vec::from_array(
                    [
                        ctir::CtStmt::Let {
                            pattern: ctir::CtPattern::Bind { slot: 0 },
                            value: int_expr(0),
                        },
                        ctir::CtStmt::Let {
                            pattern: ctir::CtPattern::Bind { slot: 1 },
                            value: int_expr(0),
                        },
                        ctir::CtStmt::Expr(while_expr),
                    ],
                ),
                tail: Option::Some(local_expr(1, int_type())),
                origin: 0,
            },
        ),
        ty: int_type(),
        origin: 0,
    };
    let module = ctir::empty_module("test::loop");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 2,
            local_types: Vec::from_array([int_type(), int_type()]),
            expression: body,
            origin: 0,
        },
    );
    module
}

#[test]
fn evaluates_local_state_and_loops() -> () {
    let module = loop_site_module();
    if let Err(error) = verify_module(module, Vec::new()) {
        testing::fail(error.to_string())
    }
    testing::assert_eq(expect_int(evaluate_site(module, Vec::new(), 0, default_limits())), 10)
}

#[test]
fn rejects_loop_control_after_loop_scope() -> () {
    let sibling_break = ctir::CtExpr {
        kind: ctir::CtExprKind::Break { target: 7, value: Option::None },
        ty: ctir::CtType::Never,
        origin: 0,
    };
    match verify_module(expression_module(loop_then(sibling_break), Vec::new()), Vec::new()) {
        Err(error) => testing::assert_eq(error, "CTIR break target is not in scope"),
        Ok(()) => testing::fail("expected sibling break target rejection"),
    }
    let sibling_continue = ctir::CtExpr {
        kind: ctir::CtExprKind::Continue { target: 7 },
        ty: ctir::CtType::Never,
        origin: 0,
    };
    match verify_module(expression_module(loop_then(sibling_continue), Vec::new()), Vec::new()) {
        Err(error) => testing::assert_eq(error, "CTIR continue target is not in scope"),
        Ok(()) => testing::fail("expected sibling continue target rejection"),
    }
}

#[test]
fn inclusive_range_stops_at_maximum_integer() -> () {
    let maximum = narrow_int_expr(true, 64, 9223372036854775807);
    let expression = ctir::CtExpr {
        kind: ctir::CtExprKind::ForRange {
            target: 0,
            pattern: ctir::CtPattern::Wild,
            start: maximum,
            end: maximum,
            inclusive: true,
            body: ctir::CtExpr {
                kind: ctir::CtExprKind::Value(ctir::CtValue::Unit),
                ty: ctir::CtType::Unit,
                origin: 0,
            },
        },
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    match evaluate_expression(expression, Vec::new(), default_limits()) {
        Ok(ctir::CtValue::Unit) => (),
        Ok(_) => testing::fail("expected () range result"),
        Err(error) => testing::fail(error.message),
    }
}

#[test]
fn evaluates_structured_match_values() -> () {
    let option_type = ctir::CtType::Enum {
        name: "test::OptionInt",
        variants: Vec::from_array([Vec::from_array([int_type()]), Vec::new()]),
    };
    let source = ctir::CtExpr {
        kind: ctir::CtExprKind::Enum {
            name: "test::OptionInt",
            variant: 0,
            fields: Vec::from_array([int_expr(42)]),
        },
        ty: option_type,
        origin: 0,
    };
    let expression = ctir::CtExpr {
        kind: ctir::CtExprKind::Match {
            value: source,
            arms: Vec::from_array(
                [
                    ctir::CtArm {
                        pattern: ctir::CtPattern::Enum {
                            name: "test::OptionInt",
                            variant: 0,
                            fields: Vec::from_array([ctir::CtPattern::Bind { slot: 0 }]),
                        },
                        guard: Option::None,
                        body: local_expr(0, int_type()),
                        origin: 0,
                    },
                    ctir::CtArm {
                        pattern: ctir::CtPattern::Wild,
                        guard: Option::None,
                        body: int_expr(0),
                        origin: 0,
                    },
                ],
            ),
        },
        ty: int_type(),
        origin: 0,
    };
    let module = ctir::empty_module("test::match");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 1,
            local_types: Vec::from_array([int_type()]),
            expression,
            origin: 0,
        },
    );
    if let Err(error) = verify_module(module, Vec::new()) {
        testing::fail(error.to_string())
    }
    testing::assert_eq(expect_int(evaluate_site(module, Vec::new(), 0, default_limits())), 42)
}

#[test]
fn reports_compile_errors_and_resource_limits() -> () {
    let message = ctir::CtExpr {
        kind: ctir::CtExprKind::Value(ctir::CtValue::String("stop")),
        ty: ctir::CtType::String,
        origin: 0,
    };
    let expression = ctir::CtExpr {
        kind: ctir::CtExprKind::CompileError(message),
        ty: ctir::CtType::Never,
        origin: 0,
    };
    let module = ctir::empty_module("test::failure");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression,
            origin: 0,
        },
    );
    match evaluate_site(module, Vec::new(), 0, default_limits()) {
        Err(error) => testing::assert_eq(error.message, "stop"),
        Ok(_) => testing::fail("expected compile_error"),
    }
    let limits = EvalLimits {
        fuel: 4,
        call_depth: 256,
        value_nodes: 100,
        temporary_bytes: 1000,
        final_bytes: 100,
    };
    match evaluate_entry(
        factorial_module(),
        Vec::new(),
        "factorial",
        Vec::from_array([int_value(10)]),
        limits,
    ) {
        Err(error) => testing::assert_eq(error.message, "comptime instruction limit exceeded"),
        Ok(_) => testing::fail("expected fuel exhaustion"),
    }
}

#[test]
fn enforces_depth_value_and_result_limits() -> () {
    let depth_limits = EvalLimits {
        fuel: 1000,
        call_depth: 2,
        value_nodes: 100,
        temporary_bytes: 1000,
        final_bytes: 100,
    };
    match evaluate_entry(
        factorial_module(),
        Vec::new(),
        "factorial",
        Vec::from_array([int_value(10)]),
        depth_limits,
    ) {
        Err(error) => testing::assert_eq(error.message, "comptime call depth limit exceeded"),
        Ok(_) => testing::fail("expected call depth exhaustion"),
    }
    let value_limits = EvalLimits {
        fuel: 100,
        call_depth: 10,
        value_nodes: 0,
        temporary_bytes: 1000,
        final_bytes: 100,
    };
    let module = ctir::empty_module("test::values");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression: int_expr(1),
            origin: 0,
        },
    );
    match evaluate_site(module, Vec::new(), 0, value_limits) {
        Err(error) => testing::assert_eq(error.message, "comptime temporary value limit exceeded"),
        Ok(_) => testing::fail("expected temporary value exhaustion"),
    }
    let size_limits = EvalLimits {
        fuel: 100,
        call_depth: 10,
        value_nodes: 100,
        temporary_bytes: 1000,
        final_bytes: 4,
    };
    match evaluate_site(module, Vec::new(), 0, size_limits) {
        Err(error) => testing::assert_eq(error.message, "comptime result size limit exceeded"),
        Ok(_) => testing::fail("expected result size exhaustion"),
    }
}

#[test]
fn applies_fixed_width_integer_semantics() -> () {
    let int8_type = narrow_int_type(true, 8);
    let wrapping_add = binary_expr(
        ctir::CtBinaryOp::Add,
        narrow_int_expr(true, 8, 127),
        narrow_int_expr(true, 8, 1),
        int8_type,
    );
    let module = ctir::empty_module("test::integers");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression: wrapping_add,
            origin: 0,
        },
    );
    match evaluate_site(module, Vec::new(), 0, default_limits()) {
        Ok(ctir::CtValue::Integer { signed, width, bits }) => {
            testing::assert(signed);
            testing::assert_eq(width, 8);
            testing::assert_eq(bits, 128)
        },
        Ok(_) => testing::fail("expected fixed-width integer"),
        Err(error) => testing::fail(error.message),
    }
    let shifted = binary_expr(
        ctir::CtBinaryOp::Shl,
        narrow_int_expr(false, 8, 1),
        narrow_int_expr(false, 64, 3),
        narrow_int_type(false, 8),
    );
    module.sites.set(
        0,
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression: shifted,
            origin: 0,
        },
    );
    if let Err(error) = verify_module(module, Vec::new()) {
        testing::fail(error.to_string())
    }
    match evaluate_site(module, Vec::new(), 0, default_limits()) {
        Ok(ctir::CtValue::Integer { signed, width, bits }) => {
            testing::assert(!signed);
            testing::assert_eq(width, 8);
            testing::assert_eq(bits, 8)
        },
        Ok(_) => testing::fail("expected shifted fixed-width integer"),
        Err(error) => testing::fail(error.message),
    }
}

#[test]
fn rejects_invalid_ctir_before_execution() -> () {
    let module = ctir::empty_module("test::invalid");
    module.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression: local_expr(1, int_type()),
            origin: 0,
        },
    );
    match verify_module(module, Vec::new()) {
        Err(error) => testing::assert_eq(error, "invalid CTIR local slot or type"),
        Ok(()) => testing::fail("expected invalid local slot"),
    }
    match evaluate_site(module, Vec::new(), 0, default_limits()) {
        Err(error) => testing::assert_eq(
            error.message,
            "invalid CTIR: invalid CTIR local slot or type",
        ),
        Ok(_) => testing::fail("expected evaluator CTIR rejection"),
    }
    let caller = factorial_module();
    caller.sites.push(
        ctir::CtSite {
            id: 0,
            kind: ctir::CtSiteKind::Expression,
            local_count: 0,
            local_types: Vec::new(),
            expression: ctir::CtExpr {
                kind: ctir::CtExprKind::Call {
                    target: ctir::CtCallTarget::Local(0),
                    args: Vec::from_array(
                        [
                            ctir::CtExpr {
                                kind: ctir::CtExprKind::Value(ctir::CtValue::Bool(true)),
                                ty: ctir::CtType::Bool,
                                origin: 0,
                            },
                        ],
                    ),
                },
                ty: int_type(),
                origin: 0,
            },
            origin: 0,
        },
    );
    match verify_module(caller, Vec::new()) {
        Err(error) => testing::assert_eq(error, "CTIR call argument type mismatch"),
        Ok(()) => testing::fail("expected invalid call argument type"),
    }
}

#[test]
fn evaluates_short_circuit_and_left_to_right_order() -> () {
    let short_circuit = binary_expr(
        ctir::CtBinaryOp::And,
        bool_expr(false),
        compile_error_expr("right"),
        ctir::CtType::Bool,
    );
    match evaluate_expression(short_circuit, Vec::new(), default_limits()) {
        Ok(ctir::CtValue::Bool(value)) => testing::assert(!value),
        Ok(_) => testing::fail("expected bool result"),
        Err(error) => testing::fail(error.message),
    }
    let ordered = ctir::CtExpr {
        kind: ctir::CtExprKind::Array(
            Vec::from_array([compile_error_expr("left"), compile_error_expr("right")]),
        ),
        ty: ctir::CtType::Array { len: 2, elem: int_type() },
        origin: 0,
    };
    match evaluate_expression(ordered, Vec::new(), default_limits()) {
        Err(error) => testing::assert_eq(error.message, "left"),
        Ok(_) => testing::fail("expected left-to-right failure"),
    }
}

#[test]
fn evaluates_return_break_and_continue() -> () {
    let increment = binary_expr(
        ctir::CtBinaryOp::Add,
        local_expr(0, int_type()),
        int_expr(1),
        int_type(),
    );
    let continue_or_break = ctir::CtExpr {
        kind: ctir::CtExprKind::If {
            condition: binary_expr(
                ctir::CtBinaryOp::Less,
                local_expr(0, int_type()),
                int_expr(3),
                ctir::CtType::Bool,
            ),
            then_branch: ctir::CtExpr {
                kind: ctir::CtExprKind::Continue { target: 0 },
                ty: ctir::CtType::Never,
                origin: 0,
            },
            else_branch: ctir::CtExpr {
                kind: ctir::CtExprKind::Break {
                    target: 0,
                    value: Option::Some(local_expr(0, int_type())),
                },
                ty: ctir::CtType::Never,
                origin: 0,
            },
        },
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    let loop_body = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock {
                statements: Vec::from_array([ctir::CtStmt::Assign { slot: 0, value: increment }]),
                tail: Option::Some(continue_or_break),
                origin: 0,
            },
        ),
        ty: ctir::CtType::Unit,
        origin: 0,
    };
    let loop_expr = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock {
                statements: Vec::from_array(
                    [
                        ctir::CtStmt::Let {
                            pattern: ctir::CtPattern::Bind { slot: 0 },
                            value: int_expr(0),
                        },
                    ],
                ),
                tail: Option::Some(
                    ctir::CtExpr {
                        kind: ctir::CtExprKind::Loop { target: 0, body: loop_body },
                        ty: int_type(),
                        origin: 0,
                    },
                ),
                origin: 0,
            },
        ),
        ty: int_type(),
        origin: 0,
    };
    testing::assert_eq(
        expect_int(evaluate_expression(loop_expr, Vec::from_array([int_type()]), default_limits())),
        3,
    );
    let module = ctir::empty_module("test::return");
    module.functions.push(
        ctir::CtFunction {
            id: 0,
            name: "return_value",
            parameter_slots: Vec::new(),
            parameter_types: Vec::new(),
            local_count: 0,
            local_types: Vec::new(),
            return_type: int_type(),
            body: ctir::CtBlock {
                statements: Vec::from_array(
                    [
                        ctir::CtStmt::Expr(
                            ctir::CtExpr {
                                kind: ctir::CtExprKind::Return(Option::Some(int_expr(7))),
                                ty: ctir::CtType::Never,
                                origin: 0,
                            },
                        ),
                    ],
                ),
                tail: Option::Some(int_expr(0)),
                origin: 0,
            },
            origin: 0,
        },
    );
    module.entries.push(ctir::CtEntry { name: "return_value", function_id: 0, public: true });
    if let Err(error) = verify_module(module, Vec::new()) {
        testing::fail(error.to_string())
    }
    testing::assert_eq(
        expect_int(evaluate_entry(module, Vec::new(), "return_value", Vec::new(), default_limits())),
        7,
    )
}

#[test]
fn applies_integer_casts_and_reports_numeric_failures() -> () {
    let widened = ctir::CtExpr {
        kind: ctir::CtExprKind::Cast {
            value: narrow_int_expr(true, 8, 255),
            target: narrow_int_type(false, 64),
        },
        ty: narrow_int_type(false, 64),
        origin: 0,
    };
    match evaluate_expression(widened, Vec::new(), default_limits()) {
        Ok(ctir::CtValue::Integer { signed, width, bits }) => {
            testing::assert(!signed);
            testing::assert_eq(width, 64);
            testing::assert_eq(bits, ~(0.to_u64()))
        },
        Ok(_) => testing::fail("expected widened integer"),
        Err(error) => testing::fail(error.message),
    }
    let truncated = ctir::CtExpr {
        kind: ctir::CtExprKind::Cast {
            value: narrow_int_expr(false, 64, 511),
            target: narrow_int_type(false, 8),
        },
        ty: narrow_int_type(false, 8),
        origin: 0,
    };
    match evaluate_expression(truncated, Vec::new(), default_limits()) {
        Ok(ctir::CtValue::Integer { bits, .. }) => testing::assert_eq(bits, 255),
        Ok(_) => testing::fail("expected truncated integer"),
        Err(error) => testing::fail(error.message),
    }
    let division = binary_expr(ctir::CtBinaryOp::Div, int_expr(1), int_expr(0), int_type());
    match evaluate_expression(division, Vec::new(), default_limits()) {
        Err(error) => {
            testing::assert_eq(error.message, "division by zero during comptime evaluation")
        },
        Ok(_) => testing::fail("expected division failure"),
    }
    let shift = binary_expr(
        ctir::CtBinaryOp::Shl,
        narrow_int_expr(false, 8, 1),
        narrow_int_expr(true, 64, ~(0.to_u64())),
        narrow_int_type(false, 8),
    );
    match evaluate_expression(shift, Vec::new(), default_limits()) {
        Err(error) => {
            testing::assert_eq(error.message, "negative shift count during comptime evaluation")
        },
        Ok(_) => testing::fail("expected shift failure"),
    }
    let indexed = ctir::CtExpr {
        kind: ctir::CtExprKind::Index {
            value: ctir::CtExpr {
                kind: ctir::CtExprKind::Array(Vec::from_array([int_expr(1)])),
                ty: ctir::CtType::Array { len: 1, elem: int_type() },
                origin: 0,
            },
            index: int_expr(1),
        },
        ty: int_type(),
        origin: 0,
    };
    match evaluate_expression(indexed, Vec::new(), default_limits()) {
        Err(error) => {
            testing::assert_eq(error.message, "index out of bounds during comptime evaluation")
        },
        Ok(_) => testing::fail("expected index failure"),
    }
}

#[test]
fn enforces_temporary_memory_and_target_limits() -> () {
    let value = ctir::CtExpr {
        kind: ctir::CtExprKind::Value(ctir::CtValue::String("12345")),
        ty: ctir::CtType::String,
        origin: 0,
    };
    let limits = EvalLimits {
        fuel: 100,
        call_depth: 10,
        value_nodes: 100,
        temporary_bytes: 4,
        final_bytes: 100,
    };
    match evaluate_expression(value, Vec::new(), limits) {
        Err(error) => {
            testing::assert_eq(error.message, "comptime temporary memory limit exceeded")
        },
        Ok(_) => testing::fail("expected temporary memory failure"),
    }
    let module = factorial_module();
    module.target = ctir::CtTarget { int_width: 16 };
    match verify_module(module, Vec::new()) {
        Err(error) => testing::assert_eq(error, "invalid CTIR target integer width"),
        Ok(()) => testing::fail("expected invalid target rejection"),
    }
    let invalid_local = factorial_module();
    invalid_local.functions[0].local_types.set(0, ctir::CtType::Bool);
    match verify_module(invalid_local, Vec::new()) {
        Err(error) => testing::assert_eq(error, "CTIR parameter local type mismatch"),
        Ok(()) => testing::fail("expected local type rejection"),
    }
}

#[test]
fn rejects_invalid_derive_ctir_artifacts() -> () {
    let invalid_signature = ctir::empty_module("test::derive_signature");
    invalid_signature.functions.push(
        ctir::CtFunction {
            id: 0,
            name: "handler",
            parameter_slots: Vec::new(),
            parameter_types: Vec::new(),
            local_count: 0,
            local_types: Vec::new(),
            return_type: int_type(),
            body: ctir::CtBlock {
                statements: Vec::new(),
                tail: Option::Some(int_expr(1)),
                origin: 0,
            },
            origin: 0,
        },
    );
    invalid_signature.derive_entries.push(
        ctir::CtDeriveEntry {
            name: "handler",
            function_id: 0,
            public: true,
            export_name: Option::None,
        },
    );
    match verify_module(invalid_signature, Vec::new()) {
        Err(error) => testing::assert_eq(error, "invalid CTIR derive entry signature"),
        Ok(()) => testing::fail("expected invalid derive signature"),
    }
    let invalid_intrinsic = ctir::empty_module("test::derive_intrinsic");
    let input_ty = ctir::CtType::Meta("DeriveInput");
    let output_ty = ctir::CtType::Meta("DeriveOutput");
    invalid_intrinsic.functions.push(
        ctir::CtFunction {
            id: 0,
            name: "handler",
            parameter_slots: Vec::from_array([0]),
            parameter_types: Vec::from_array([input_ty]),
            local_count: 1,
            local_types: Vec::from_array([input_ty]),
            return_type: output_ty,
            body: ctir::CtBlock {
                statements: Vec::new(),
                tail: Option::Some(
                    ctir::CtExpr {
                        kind: ctir::CtExprKind::Call {
                            target: ctir::CtCallTarget::Intrinsic("host_escape"),
                            args: Vec::from_array([local_expr(0, input_ty)]),
                        },
                        ty: output_ty,
                        origin: 0,
                    },
                ),
                origin: 0,
            },
            origin: 0,
        },
    );
    invalid_intrinsic.derive_entries.push(
        ctir::CtDeriveEntry {
            name: "handler",
            function_id: 0,
            public: true,
            export_name: Option::None,
        },
    );
    match verify_module(invalid_intrinsic, Vec::new()) {
        Err(error) => testing::assert_eq(error, "unknown CTIR intrinsic"),
        Ok(()) => testing::fail("expected invalid derive intrinsic"),
    }
}

#[test]
fn integer_formatting_intrinsics_preserve_width_and_reject_invalid_calls() -> () {
    let high: u64 = 9223372036854775808;
    let maximum: u64 = 18446744073709551615;
    let target = ctir::CtTarget { int_width: 32 };
    for (name, signed, width, bits, expected) in Vec::from_array(
        [
            ("comptime.to_string.i8", true, 8, 128.to_u64(), "-128"),
            ("comptime.to_string.u8", false, 8, 255.to_u64(), "255"),
            ("comptime.to_string.i64", true, 64, high, "-9223372036854775808"),
            ("comptime.to_string.u64", false, 64, maximum, "18446744073709551615"),
        ],
    ) {
        match call_value_intrinsic(
            target,
            name,
            Vec::from_array([ctir::CtValue::Integer { signed, width, bits }]),
        ) {
            Some(Ok(ctir::CtValue::String(value))) => testing::assert_eq(value, expected),
            _ => testing::fail("integer formatting failed"),
        }
    }
    for args in Vec::from_array(
        [
            Vec::new(),
            Vec::from_array([ctir::CtValue::String("1")]),
            Vec::from_array([ctir::CtValue::Integer { signed: true, width: 64, bits: 1 }]),
            Vec::from_array([ctir::CtValue::Integer { signed: false, width: 32, bits: 1 }]),
            Vec::from_array(
                [ctir::CtValue::Integer { signed: false, width: 64, bits: 1 }, ctir::CtValue::Unit],
            ),
        ],
    ) {
        testing::assert(
            testing::expect_some(
                call_value_intrinsic(target, "comptime.to_string.u64", args),
                "known intrinsic",
            ).is_err(),
        );
    }
    testing::assert(value_intrinsic_signature(target, "comptime.to_string.u128").is_none());
}
