package ctfe;

use module::ctir;

const COMPTIME_STRING_LEN_INTRINSIC: string = "comptime.string.len";

const COMPTIME_STRING_BYTE_LEN_INTRINSIC: string = "comptime.string.byte_len";

const COMPTIME_STRING_GET_INTRINSIC: string = "comptime.string.get";

const COMPTIME_STRING_BYTE_GET_INTRINSIC: string = "comptime.string.byte_get";

const COMPTIME_STRING_BYTE_SLICE_INTRINSIC: string = "comptime.string.byte_slice";

const COMPTIME_STRING_IS_CHAR_BOUNDARY_INTRINSIC: string = "comptime.string.is_char_boundary";

const COMPTIME_STRING_STARTS_WITH_INTRINSIC: string = "comptime.string.starts_with";

const COMPTIME_STRING_ENDS_WITH_INTRINSIC: string = "comptime.string.ends_with";

const COMPTIME_STRING_CONTAINS_INTRINSIC: string = "comptime.string.contains";

pub fn integer_format_intrinsic(signed: bool, width: isize) -> Option[string] {
    if width != 8 && width != 16 && width != 32 && width != 64 {
        return Option::None
    }
    Option::Some(
        "comptime.to_string."
            + if signed {
                "i"
            } else {
                "u"
            }
            + width.to_string(),
    )
}

fn integer_format_type(name: string) -> Option[ctir::CtType] {
    for width in[8, 16, 32, 64] {
        for signed in[false, true] {
            if integer_format_intrinsic(signed, width) == Option::Some(name) {
                return Option::Some(ctir::CtType::Integer { signed, width })
            }
        }
    }
    Option::None
}

fn intrinsic_int_type(target: ctir::CtTarget) -> ctir::CtType {
    ctir::CtType::Integer { signed: true, width: target.int_width }
}

fn intrinsic_int_value(target: ctir::CtTarget, value: isize) -> ctir::CtValue {
    ctir::CtValue::Integer { signed: true, width: target.int_width, bits: value.to_u64() }
}

fn one_intrinsic_type(value: ctir::CtType) -> Vec[ctir::CtType] {
    Vec::from_array([value])
}

fn two_intrinsic_types(first: ctir::CtType, second: ctir::CtType) -> Vec[ctir::CtType] {
    Vec::from_array([first, second])
}

fn three_intrinsic_types(first: ctir::CtType, second: ctir::CtType, third: ctir::CtType) -> Vec[
    ctir::CtType,
] {
    Vec::from_array([first, second, third])
}

pub fn value_intrinsic_signature(target: ctir::CtTarget, name: string) -> Option[
    (Vec[ctir::CtType], ctir::CtType),
] {
    if let Some(ty) = integer_format_type(name) {
        return Option::Some((one_intrinsic_type(ty), ctir::CtType::String))
    }
    let int_ty = intrinsic_int_type(target);
    match name {
        COMPTIME_STRING_LEN_INTRINSIC | COMPTIME_STRING_BYTE_LEN_INTRINSIC => {
            Option::Some((one_intrinsic_type(ctir::CtType::String), int_ty))
        },
        COMPTIME_STRING_GET_INTRINSIC => Option::Some(
            (two_intrinsic_types(ctir::CtType::String, int_ty), ctir::CtType::Char),
        ),
        COMPTIME_STRING_BYTE_GET_INTRINSIC => Option::Some(
            (
                two_intrinsic_types(ctir::CtType::String, int_ty),
                ctir::CtType::Integer { signed: false, width: 8 },
            ),
        ),
        COMPTIME_STRING_BYTE_SLICE_INTRINSIC => Option::Some(
            (three_intrinsic_types(ctir::CtType::String, int_ty, int_ty), ctir::CtType::String),
        ),
        COMPTIME_STRING_IS_CHAR_BOUNDARY_INTRINSIC => Option::Some(
            (two_intrinsic_types(ctir::CtType::String, int_ty), ctir::CtType::Bool),
        ),
        COMPTIME_STRING_STARTS_WITH_INTRINSIC | COMPTIME_STRING_ENDS_WITH_INTRINSIC | COMPTIME_STRING_CONTAINS_INTRINSIC => Option::Some(
            (two_intrinsic_types(ctir::CtType::String, ctir::CtType::String), ctir::CtType::Bool),
        ),
        _ => Option::None,
    }
}

fn intrinsic_argument(values: Vec[ctir::CtValue], index: isize) -> Result[ctir::CtValue, string] {
    if index < 0 || index >= values.len() {
        Result::Err("comptime intrinsic argument is missing")
    } else {
        Result::Ok(values[index])
    }
}

fn intrinsic_string_argument(values: Vec[ctir::CtValue], index: isize) -> Result[string, string] {
    match intrinsic_argument(values, index)? {
        ctir::CtValue::String(value) => Result::Ok(value),
        _ => Result::Err("comptime string intrinsic expects a string"),
    }
}

fn intrinsic_int_argument(values: Vec[ctir::CtValue], index: isize) -> Result[isize, string] {
    match intrinsic_argument(values, index)? {
        ctir::CtValue::Integer { signed: true, width, bits } => if width == 32 {
            Result::Ok((bits.to_u32()).to_i32().to_isize())
        } else {
            Result::Ok(bits.to_i64().to_isize())
        },
        _ => Result::Err("comptime string intrinsic expects an isize index"),
    }
}

fn valid_string_index(value: string, index: isize) -> bool {
    index >= 0 && index < value.byte_len() && value.is_char_boundary(index)
}

fn valid_string_slice(value: string, start: isize, end: isize) -> bool {
    start >= 0 && start <= end && end <= value.byte_len() && value.is_char_boundary(start)
        && value.is_char_boundary(end)
}

pub fn call_value_intrinsic(target: ctir::CtTarget, name: string, args: Vec[ctir::CtValue]) -> Option[
    Result[ctir::CtValue, string],
] {
    if let Some(ctir::CtType::Integer { signed: expected_signed, width: expected_width }) = integer_format_type(
        name,
    ) {
        return Option::Some(
            match intrinsic_argument(args, 0) {
                Ok(ctir::CtValue::Integer { signed, width, bits }) if signed == expected_signed
                    && width == expected_width
                    && args.len() == 1 => Result::Ok(
                    ctir::CtValue::String(
                        if signed {
                            signed_integer(width, bits).to_string()
                        } else {
                            (bits & integer_mask(width)).to_string()
                        },
                    ),
                ),
                Err(error) => Result::Err(error),
                _ => Result::Err("comptime integer formatting argument has the wrong type"),
            },
        )
    }
    match name {
        COMPTIME_STRING_LEN_INTRINSIC | COMPTIME_STRING_BYTE_LEN_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            Option::Some(value.map(|value| intrinsic_int_value(target, value.byte_len())))
        },
        COMPTIME_STRING_GET_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            let index = intrinsic_int_argument(args, 1);
            Option::Some(
                match (value, index) {
                    (Ok(value), Ok(index)) => if valid_string_index(value, index) {
                        Result::Ok(ctir::CtValue::Char(value.get(index)))
                    } else {
                        Result::Err(
                            "comptime string index is out of bounds or not a character boundary",
                        )
                    },
                    (Err(error), _) | (_, Err(error)) => Result::Err(error),
                },
            )
        },
        COMPTIME_STRING_BYTE_GET_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            let index = intrinsic_int_argument(args, 1);
            Option::Some(
                match (value, index) {
                    (Ok(value), Ok(index)) => if index >= 0 && index < value.byte_len() {
                        Result::Ok(
                            ctir::CtValue::Integer {
                                signed: false,
                                width: 8,
                                bits: value.byte_get(index).to_u64(),
                            },
                        )
                    } else {
                        Result::Err("comptime string byte index is out of bounds")
                    },
                    (Err(error), _) | (_, Err(error)) => Result::Err(error),
                },
            )
        },
        COMPTIME_STRING_BYTE_SLICE_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            let start = intrinsic_int_argument(args, 1);
            let end = intrinsic_int_argument(args, 2);
            Option::Some(
                match (value, start, end) {
                    (Ok(value), Ok(start), Ok(end)) => if valid_string_slice(value, start, end) {
                        Result::Ok(ctir::CtValue::String(value.byte_slice(start, end)))
                    } else {
                        Result::Err(
                            "comptime string slice is out of bounds or not on character boundaries",
                        )
                    },
                    (Err(error), _, _) | (_, Err(error), _) | (_, _, Err(error)) => {
                        Result::Err(error)
                    },
                },
            )
        },
        COMPTIME_STRING_IS_CHAR_BOUNDARY_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            let index = intrinsic_int_argument(args, 1);
            Option::Some(
                match (value, index) {
                    (Ok(value), Ok(index)) => {
                        Result::Ok(ctir::CtValue::Bool(value.is_char_boundary(index)))
                    },
                    (Err(error), _) | (_, Err(error)) => Result::Err(error),
                },
            )
        },
        COMPTIME_STRING_STARTS_WITH_INTRINSIC | COMPTIME_STRING_ENDS_WITH_INTRINSIC | COMPTIME_STRING_CONTAINS_INTRINSIC => {
            let value = intrinsic_string_argument(args, 0);
            let expected = intrinsic_string_argument(args, 1);
            Option::Some(
                match (value, expected) {
                    (Ok(value), Ok(expected)) => Result::Ok(
                        ctir::CtValue::Bool(
                            match name {
                                COMPTIME_STRING_STARTS_WITH_INTRINSIC => value.starts_with(expected),
                                COMPTIME_STRING_ENDS_WITH_INTRINSIC => value.ends_with(expected),
                                _ => value.contains(expected),
                            },
                        ),
                    ),
                    (Err(error), _) | (_, Err(error)) => Result::Err(error),
                },
            )
        },
        _ => Option::None,
    }
}
