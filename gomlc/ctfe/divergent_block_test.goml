package ctfe;

use module::ctir;
use std::testing;

#[test]
fn verify_blocks_preserves_divergence_without_skipping_children() -> () {
    let body = ctir::CtBlock {
        statements: Vec::from_array([ctir::CtStmt::Expr(compile_error_expr("stop"))]),
        tail: None,
        origin: 0,
    };
    let value = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(body),
        ty: ctir::CtType::Never,
        origin: 0,
    };
    testing::assert(verify_module(expression_module(value, Vec::new()), Vec::new()).is_ok());
    let unreachable_invalid = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(
            ctir::CtBlock { tail: Some(local_expr(999, int_type())), ..body },
        ),
        ..value,
    };
    testing::assert(
        verify_module(expression_module(unreachable_invalid, Vec::new()), Vec::new()).is_err(),
    );
    let falsely_diverging = ctir::CtExpr {
        kind: ctir::CtExprKind::Block(ctir::CtBlock { statements: Vec::new(), ..body }),
        ..value,
    };
    testing::assert(
        verify_module(expression_module(falsely_diverging, Vec::new()), Vec::new()).is_err(),
    );
}
