package ctfe;

use module::ctir;

fn eval_dispatch(
    state: EvalState,
    module: ctir::CtModule,
    origin: isize,
    receiver: ctir::CtValue,
    method: string,
    args: Vec[ctir::CtValue],
    expected: ctir::CtType,
) -> Result[ctir::CtValue, CtError] {
    let ctir::CtValue::Dynamic { id, .. } = receiver else {
        return Result::Err(
            ct_error(state, module, origin, "comptime dispatch requires a dynamic value"),
        )
    };
    if id < 0 || id >= state.dynamics.len() {
        return Result::Err(ct_error(state, module, origin, "invalid comptime dynamic handle"))
    }
    let value = state.dynamics[id];
    for entry in value.methods {
        if entry.0 == method {
            let ctir::CtValue::Callable { ty, .. } = entry.1 else {
                return Result::Err(
                    ct_error(state, module, origin, "invalid comptime dynamic method"),
                )
            };
            let ctir::CtType::Function { result, .. } = ty else {
                return Result::Err(
                    ct_error(state, module, origin, "invalid comptime dynamic method type"),
                )
            };
            if !types_equal(result, expected) {
                return Result::Err(
                    ct_error(state, module, origin, "comptime dynamic method result type mismatch"),
                )
            }
            let arguments = Vec::from_array([value.value]);
            for argument in args {
                arguments.push(argument)
            }
            return eval_closure(state, module, origin, entry.1, arguments)
        }
    }
    Result::Err(ct_error(state, module, origin, "missing comptime dynamic method `" + method + "`"))
}
