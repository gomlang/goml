package ctfe;

use module::ctir;
use module::derive;
use std::collections;

struct VerifyContext {
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    local_types: Vec[ctir::CtType],
    return_type: ctir::CtType,
    loop_targets: Vec[(isize, ctir::CtType, bool)],
    value_nodes: Ref[isize],
    value_bytes: Ref[isize],
}

fn ctir_value_node_limit() -> isize {
    1000000
}

fn ctir_value_byte_limit() -> isize {
    8388608
}

fn types_equal(left: ctir::CtType, right: ctir::CtType) -> bool {
    match left {
        Dynamic(name) => match right {
            Dynamic(other) => name == other,
            _ => false,
        },
        Buffer { kind, elem } => match right {
            Buffer { kind: other_kind, elem: other_elem } => kind == other_kind
                && types_equal(elem, other_elem),
            _ => false,
        },
        Function { params, result } => match right {
            Function { params: other_params, result: other_result } => type_lists_equal(
                params,
                other_params,
            )
                && types_equal(result, other_result),
            _ => false,
        },
        Unit => match right {
            Unit => true,
            _ => false,
        },
        Never => match right {
            Never => true,
            _ => false,
        },
        Bool => match right {
            Bool => true,
            _ => false,
        },
        Integer { signed, width } => match right {
            Integer { signed: right_signed, width: right_width } => {
                signed == right_signed && width == right_width
            },
            _ => false,
        },
        String => match right {
            String => true,
            _ => false,
        },
        Char => match right {
            Char => true,
            _ => false,
        },
        Tuple(left) => match right {
            Tuple(right) => type_lists_equal(left, right),
            _ => false,
        },
        Array { len, elem } => match right {
            Array { len: right_len, elem: right_elem } => {
                len == right_len && types_equal(elem, right_elem)
            },
            _ => false,
        },
        Struct { name, fields } => match right {
            Struct { name: right_name, fields: right_fields } => {
                name == right_name && type_lists_equal(fields, right_fields)
            },
            _ => false,
        },
        Enum { name, variants } => match right {
            Enum { name: right_name, variants: right_variants } => {
                name == right_name && type_list_lists_equal(variants, right_variants)
            },
            _ => false,
        },
        Meta(name) => match right {
            Meta(right_name) => name == right_name,
            _ => false,
        },
    }
}

fn expression_type_matches(expected: ctir::CtType, actual: ctir::CtType) -> bool {
    types_equal(expected, actual) || types_equal(actual, ctir::CtType::Never)
}

fn is_integer_type(value: ctir::CtType) -> bool {
    match value {
        Integer { .. } => true,
        _ => false,
    }
}

fn is_signed_integer_type(value: ctir::CtType) -> bool {
    match value {
        Integer { signed, width: _ } => signed,
        _ => false,
    }
}

fn is_char_integer_type(value: ctir::CtType) -> bool {
    match value {
        Integer { signed, width } => !signed && width == 32,
        _ => false,
    }
}

fn is_ordered_type(value: ctir::CtType) -> bool {
    is_integer_type(value) || types_equal(value, ctir::CtType::String)
        || types_equal(value, ctir::CtType::Char)
}

fn type_lists_equal(left: Vec[ctir::CtType], right: Vec[ctir::CtType]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if !types_equal(left[index], right[index]) {
                return false
            }
        }
        true
    }
}

fn type_list_lists_equal(left: Vec[Vec[ctir::CtType]], right: Vec[Vec[ctir::CtType]]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if !type_lists_equal(left[index], right[index]) {
                return false
            }
        }
        true
    }
}

fn verify_type(value: ctir::CtType) -> Result[(), string] {
    match value {
        Dynamic(name) => if name == "" {
            Err("empty CTIR dynamic type")
        } else {
            Ok(())
        },
        Buffer { kind, elem } => {
            if kind != "ref" && kind != "vec" {
                return Err("unknown CTIR buffer kind")
            }
            verify_type(elem)
        },
        Function { params, result } => {
            for param in params {
                verify_type(param)?
            }
            verify_type(result)
        },
        Integer { signed: _, width } => if width == 8 || width == 16 || width == 32 || width == 64 {
            Ok(())
        } else {
            Err("invalid CTIR integer width")
        },
        Tuple(values) => {
            for value in values {
                verify_type(value)?
            }
            Ok(())
        },
        Array { len, elem } => if len < 0 {
            Err("negative CTIR array length")
        } else {
            verify_type(elem)
        },
        Struct { name, fields } => if name == "" {
            Err("empty CTIR struct name")
        } else {
            for field in fields {
                verify_type(field)?
            }
            Ok(())
        },
        Enum { name, variants } => if name == "" {
            Err("empty CTIR enum name")
        } else {
            for variant in variants {
                for field in variant {
                    verify_type(field)?
                }
            }
            Ok(())
        },
        Meta(name) => if derive::is_meta_type(name) {
            Ok(())
        } else {
            Err("unknown CTIR meta type")
        },
        _ => Ok(()),
    }
}

fn value_type(value: ctir::CtValue) -> ctir::CtType {
    match value {
        Dynamic { name, .. } => Dynamic(name),
        Buffer { ty, .. } | Callable { ty, .. } => ty,
        Unit => Unit,
        Bool(_) => Bool,
        Integer { signed, width, bits: _ } => {
            Integer { signed, width }
        },
        String(_) => String,
        Char(_) => Char,
        Tuple(values) => {
            let types: Vec[ctir::CtType] = Vec::with_capacity(values.len());
            for value in values {
                types.push(value_type(value))
            }
            Tuple(types)
        },
        Array(values) => {
            let elem = if values.is_empty() {
                ctir::CtType::Unit
            } else {
                value_type(values[0])
            };
            Array { len: values.len(), elem }
        },
        Struct { name, fields } => {
            let types: Vec[ctir::CtType] = Vec::with_capacity(fields.len());
            for field in fields {
                types.push(value_type(field))
            }
            Struct { name, fields: types }
        },
        Enum { name, variant, fields } => {
            let types: Vec[ctir::CtType] = Vec::with_capacity(fields.len());
            for field in fields {
                types.push(value_type(field))
            }
            let variants: Vec[Vec[ctir::CtType]] = Vec::with_capacity(variant + 1);
            for _ in 0..variant {
                let empty: Vec[ctir::CtType] = Vec::new();
                variants.push(empty)
            }
            variants.push(types);
            Enum { name, variants }
        },
        Meta { kind, id: _ } => Meta(kind),
    }
}

fn value_matches_type(value: ctir::CtValue, ty: ctir::CtType) -> bool {
    match (value, ty) {
        (Unit, Unit) => true,
        (Bool(_), Bool) => true,
        (
            Integer { signed, width, bits: _ },
            Integer { signed: expected_signed, width: expected_width },
        ) => signed == expected_signed && width == expected_width,
        (String(_), String) => true,
        (Char(_), Char) => true,
        (Tuple(values), Tuple(types)) => {
            value_list_matches_types(values, types)
        },
        (Array(values), Array { len, elem }) => {
            if values.len() != len {
                false
            } else {
                for value in values {
                    if !value_matches_type(value, elem) {
                        return false
                    }
                }
                true
            }
        },
        (Struct { name, fields }, Struct { name: expected_name, fields: types }) => name
            == expected_name
            && value_list_matches_types(fields, types),
        (Enum { name, variant, fields }, Enum { name: expected_name, variants }) => name
            == expected_name
            && variant >= 0
            && variant < variants.len()
            && value_list_matches_types(fields, variants[variant]),
        (Dynamic { name, .. }, Dynamic(expected)) => name == expected,
        (Buffer { ty, .. }, expected) | (Callable { ty, .. }, expected) => types_equal(ty, expected),
        (Meta { kind, id: _ }, Meta(expected)) => {
            kind == expected
        },
        _ => false,
    }
}

fn value_list_matches_types(values: Vec[ctir::CtValue], types: Vec[ctir::CtType]) -> bool {
    if values.len() != types.len() {
        false
    } else {
        for index in 0..values.len() {
            if !value_matches_type(values[index], types[index]) {
                return false
            }
        }
        true
    }
}

fn origin_valid(ctx: VerifyContext, origin: isize) -> bool {
    origin >= 0 && origin < ctx.module.origins.len()
}

fn verify_origin(ctx: VerifyContext, origin: isize) -> Result[(), string] {
    if origin_valid(ctx, origin) {
        Ok(())
    } else {
        Err("invalid CTIR origin")
    }
}

fn slot_valid(ctx: VerifyContext, slot: isize) -> bool {
    slot >= 0 && slot < ctx.local_types.len()
}

fn slot_type(ctx: VerifyContext, slot: isize) -> Option[ctir::CtType] {
    if slot_valid(ctx, slot) {
        Some(ctx.local_types[slot])
    } else {
        None
    }
}

fn loop_target(ctx: VerifyContext, target: isize) -> Option[(ctir::CtType, bool)] {
    let mut index = ctx.loop_targets.len();
    while index > 0 {
        index -= 1;
        if ctx.loop_targets[index].0 == target {
            return Some((ctx.loop_targets[index].1, ctx.loop_targets[index].2))
        }
    }
    None
}

fn loop_context(ctx: VerifyContext, target: isize, result_type: ctir::CtType, accepts_value: bool) -> VerifyContext {
    let loop_targets: Vec[(isize, ctir::CtType, bool)] = Vec::with_capacity(
        ctx.loop_targets.len() + 1,
    );
    for value in ctx.loop_targets {
        loop_targets.push(value)
    }
    loop_targets.push((target, result_type, accepts_value));
    VerifyContext {
        module: ctx.module,
        dependencies: ctx.dependencies,
        local_types: ctx.local_types,
        return_type: ctx.return_type,
        loop_targets,
        value_nodes: ctx.value_nodes,
        value_bytes: ctx.value_bytes,
    }
}

fn verify_value_limits(value: ctir::CtValue, nodes: Ref[isize], bytes: Ref[isize]) -> Result[
    (),
    string,
] {
    let mut own_bytes = 1;
    match value {
        Unit | Bool(_) => (),
        Integer { .. } => {
            own_bytes = 8;
        },
        String(value) => {
            own_bytes = value.byte_len();
        },
        Char(_) => {
            own_bytes = 4;
        },
        Tuple(values) | Array(values) => for value in values {
            verify_value_limits(value, nodes, bytes)?
        },
        Struct { name, fields } | Enum { name, variant: _, fields } => {
            own_bytes = name.byte_len() + 8;
            for value in fields {
                verify_value_limits(value, nodes, bytes)?
            }
        },
        Dynamic { .. } | Buffer { .. } | Callable { .. } => return Err(
            "CTIR cannot contain an evaluator function handle",
        ),
        Meta { kind, id: _ } => {
            own_bytes = kind.byte_len() + 8;
        },
    }
    if nodes.get() >= ctir_value_node_limit() {
        Err("CTIR value node limit exceeded")
    } else if own_bytes > ctir_value_byte_limit() - bytes.get() {
        Err("CTIR value size limit exceeded")
    } else {
        nodes.set(nodes.get() + 1);
        bytes.set(bytes.get() + own_bytes);
        Ok(())
    }
}

fn verify_typed_value(ctx: VerifyContext, value: ctir::CtValue, ty: ctir::CtType) -> Result[
    (),
    string,
] {
    verify_value_limits(value, ctx.value_nodes, ctx.value_bytes)?;
    if value_matches_type(value, ty) {
        Ok(())
    } else {
        Err("CTIR value type mismatch")
    }
}

fn verify_pattern(ctx: VerifyContext, value: ctir::CtPattern, ty: ctir::CtType) -> Result[
    (),
    string,
] {
    match value {
        Wild => Ok(()),
        Bind { slot } => if match slot_type(ctx, slot) {
            Some(local_ty) => types_equal(local_ty, ty),
            None => false,
        } {
            Ok(())
        } else {
            Err("invalid CTIR pattern local slot or type")
        },
        ctir::CtPattern::Value(value) => verify_typed_value(ctx, value, ty),
        Constant { package_name: _, name: _ } => Ok(()),
        Tuple(patterns) => match ty {
            Tuple(types) => verify_pattern_list(ctx, patterns, types),
            _ => Err("CTIR tuple pattern has non-tuple type"),
        },
        Array { prefix, rest, suffix } => match ty {
            Array { len, elem } => if prefix.len() + suffix.len() > len {
                Err("CTIR array pattern is longer than its type")
            } else {
                for pattern in prefix {
                    verify_pattern(ctx, pattern, elem)?
                }
                for pattern in suffix {
                    verify_pattern(ctx, pattern, elem)?
                }
                match rest {
                    Some(slot) => if match slot_type(ctx, slot) {
                        Some(local_ty) => types_equal(
                            local_ty,
                            Array { len: len - prefix.len() - suffix.len(), elem },
                        ),
                        None => false,
                    } {
                        Ok(())
                    } else {
                        Err("invalid CTIR array rest slot or type")
                    },
                    None => Ok(()),
                }
            },
            _ => Err("CTIR array pattern has non-array type"),
        },
        Struct { name, fields } => match ty {
            Struct { name: expected, fields: types } => if name != expected {
                Err("CTIR struct pattern name mismatch")
            } else {
                for field in fields {
                    if field.0 < 0 || field.0 >= types.len() {
                        return Err("invalid CTIR struct pattern field")
                    } else {
                        verify_pattern(ctx, field.1, types[field.0])?
                    }
                }
                Ok(())
            },
            _ => Err("CTIR struct pattern has non-struct type"),
        },
        Enum { name, variant, fields } => match ty {
            Enum { name: expected, variants } => if name != expected || variant < 0
                || variant >= variants.len() {
                Err("invalid CTIR enum pattern")
            } else {
                verify_pattern_list(ctx, fields, variants[variant])
            },
            _ => Err("CTIR enum pattern has non-enum type"),
        },
        Alias { slot, pattern } => if match slot_type(ctx, slot) {
            Some(local_ty) => !types_equal(local_ty, ty),
            None => true,
        } {
            Err("invalid CTIR alias pattern slot or type")
        } else {
            verify_pattern(ctx, pattern, ty)
        },
        Or(patterns) => {
            if patterns.is_empty() {
                return Err("empty CTIR or-pattern")
            }
            for pattern in patterns {
                verify_pattern(ctx, pattern, ty)?
            }
            Ok(())
        },
        Range { start, end, inclusive: _ } => {
            verify_typed_value(ctx, start, ty)?;
            verify_typed_value(ctx, end, ty)
        },
    }
}

fn verify_pattern_list(ctx: VerifyContext, patterns: Vec[ctir::CtPattern], types: Vec[ctir::CtType]) -> Result[
    (),
    string,
] {
    if patterns.len() != types.len() {
        Err("CTIR pattern arity mismatch")
    } else {
        for index in 0..patterns.len() {
            verify_pattern(ctx, patterns[index], types[index])?
        }
        Ok(())
    }
}

fn verify_find_function(module: ctir::CtModule, id: isize) -> Option[ctir::CtFunction] {
    for function in module.functions {
        if function.id == id {
            return Some(function)
        }
    }
    None
}

fn verify_find_module(ctx: VerifyContext, name: string) -> Option[ctir::CtModule] {
    if ctx.module.package_name == name {
        Some(ctx.module)
    } else {
        for value in ctx.dependencies {
            if value.package_name == name {
                return Some(value)
            }
        }
        None
    }
}

fn verify_find_entry(module: ctir::CtModule, name: string) -> Option[ctir::CtFunction] {
    for entry in module.entries {
        if entry.name == name {
            return verify_find_function(module, entry.function_id)
        }
    }
    for entry in module.derive_entries {
        if entry.name == name {
            return verify_find_function(module, entry.function_id)
        }
    }
    None
}

fn short_derive_name(value: string) -> string {
    let mut result = value;
    let mut index = 0;
    while index + 1 < value.byte_len() {
        if value.byte_get(index) == b':' && value.byte_get(index + 1) == b':' {
            result = value.byte_slice(index + 2, value.byte_len());
            index += 2;
        } else {
            index += 1;
        };
    }
    result
}

fn derive_export_name(value: ctir::CtDeriveEntry) -> string {
    value.export_name.unwrap_or_else(|| short_derive_name(value.name))
}

fn call_function(ctx: VerifyContext, target: ctir::CtCallTarget) -> Option[ctir::CtFunction] {
    match target {
        Local(id) => verify_find_function(ctx.module, id),
        External { package_name, entry_name } => match verify_find_module(ctx, package_name) {
            Some(module) => verify_find_entry(module, entry_name),
            None => None,
        },
        Intrinsic(_) => None,
    }
}

fn derive_abi_type(module: ctir::CtModule, name: string) -> ctir::CtType {
    if name == "()" {
        Unit
    } else if name == "bool" {
        Bool
    } else if name == "isize" {
        Integer { signed: true, width: module.target.int_width }
    } else if name == "string" {
        String
    } else {
        Meta(name)
    }
}

fn derive_intrinsic_signature(module: ctir::CtModule, name: string) -> Option[
    (Vec[ctir::CtType], ctir::CtType),
] {
    let specs = derive::intrinsic_specs();
    for index in 0..specs.len() {
        let spec = specs.get(index);
        if spec.name == name {
            let params: Vec[ctir::CtType] = Vec::new();
            for index in 0..spec.params.len() {
                params.push(derive_abi_type(module, spec.params.get(index)))
            }
            return Some((params, derive_abi_type(module, spec.ret)))
        }
    }
    None
}

fn verify_expr_list(ctx: VerifyContext, values: Vec[ctir::CtExpr], types: Vec[ctir::CtType]) -> Result[
    (),
    string,
] {
    if values.len() != types.len() {
        Err("CTIR expression arity mismatch")
    } else {
        for index in 0..values.len() {
            verify_expr(ctx, values[index])?;
            if !expression_type_matches(types[index], values[index].ty) {
                return Err("CTIR expression type mismatch")
            }
        }
        Ok(())
    }
}

fn verify_expr(ctx: VerifyContext, value: ctir::CtExpr) -> Result[(), string] {
    verify_origin(ctx, value.origin)?;
    verify_type(value.ty)?;
    match value.kind {
        ctir::CtExprKind::Value(literal) => verify_typed_value(ctx, literal, value.ty),
        Local(slot) => if match slot_type(ctx, slot) {
            Some(local_ty) => types_equal(local_ty, value.ty),
            None => false,
        } {
            Ok(())
        } else {
            Err("invalid CTIR local slot or type")
        },
        Constant { package_name, name } => {
            let Some(module) = verify_find_module(ctx, package_name) else {
                return Err("missing CTIR constant package")
            };
            for constant in module.constants {
                if constant.name == name {
                    return if value_matches_type(constant.value, value.ty) {
                        Ok(())
                    } else {
                        Err("CTIR constant type mismatch")
                    }
                }
            }
            for site in module.sites {
                match site.kind {
                    Constant { name: candidate } => if candidate == name {
                        return if types_equal(site.expression.ty, value.ty) {
                            Ok(())
                        } else {
                            Err("CTIR pending constant type mismatch")
                        }
                    },
                    Expression => (),
                }
            }
            Err("missing CTIR constant")
        },
        Tuple(values) => match value.ty {
            Tuple(types) => verify_expr_list(ctx, values, types),
            _ => Err("CTIR tuple expression has non-tuple type"),
        },
        Array(values) => match value.ty {
            Array { len, elem } => {
                let types: Vec[ctir::CtType] = Vec::with_capacity(len);
                for _ in 0..len {
                    types.push(elem)
                }
                verify_expr_list(ctx, values, types)
            },
            _ => Err("CTIR array expression has non-array type"),
        },
        Struct { name, fields } => match value.ty {
            Struct { name: expected, fields: types } => if name == expected {
                verify_expr_list(ctx, fields, types)
            } else {
                Err("CTIR struct expression name mismatch")
            },
            _ => Err("CTIR struct expression has non-struct type"),
        },
        Enum { name, variant, fields } => match value.ty {
            Enum { name: expected, variants } => if name != expected || variant < 0
                || variant >= variants.len() {
                Err("invalid CTIR enum expression")
            } else {
                verify_expr_list(ctx, fields, variants[variant])
            },
            _ => Err("CTIR enum expression has non-enum type"),
        },
        Field { value: source, index } => {
            verify_expr(ctx, source)?;
            let fields = match source.ty {
                Tuple(fields) | Struct { name: _, fields } => fields,
                Enum { name: _, variants } => {
                    if variants.len() == 1 {
                        variants[0]
                    } else {
                        return Err("CTIR enum field access requires a known variant")
                    }
                },
                _ => return Err("CTIR field access has non-structured type"),
            };
            if index < 0 || index >= fields.len() || !types_equal(value.ty, fields[index]) {
                Err("invalid CTIR field access")
            } else {
                Ok(())
            }
        },
        Index { value: source, index } => {
            verify_expr(ctx, source)?;
            verify_expr(ctx, index)?;
            if !is_integer_type(index.ty) && !types_equal(index.ty, ctir::CtType::Never) {
                return Err("CTIR array index is not an integer")
            }
            match source.ty {
                Array { len: _, elem } => if types_equal(value.ty, elem) {
                    Ok(())
                } else {
                    Err("CTIR index result type mismatch")
                },
                _ => Err("CTIR index source is not an array"),
            }
        },
        Block(block) => {
            verify_block(ctx, block)?;
            let block_ty = match block.tail {
                Some(tail) => tail.ty,
                None => Unit,
            };
            if expression_type_matches(value.ty, block_ty) {
                Ok(())
            } else {
                Err("CTIR block result type mismatch")
            }
        },
        If { condition, then_branch, else_branch } => {
            verify_expr(ctx, condition)?;
            verify_expr(ctx, then_branch)?;
            verify_expr(ctx, else_branch)?;
            if !expression_type_matches(ctir::CtType::Bool, condition.ty)
                || !expression_type_matches(value.ty, then_branch.ty)
                || !expression_type_matches(value.ty, else_branch.ty) {
                Err("invalid CTIR if expression types")
            } else {
                Ok(())
            }
        },
        Match { value: source, arms } => {
            verify_expr(ctx, source)?;
            for arm in arms {
                verify_origin(ctx, arm.origin)?;
                verify_pattern(ctx, arm.pattern, source.ty)?;
                if let Some(guard) = arm.guard {
                    verify_expr(ctx, guard)?;
                    if !expression_type_matches(ctir::CtType::Bool, guard.ty) {
                        return Err("CTIR match guard is not bool")
                    }
                }
                verify_expr(ctx, arm.body)?;
                if !expression_type_matches(value.ty, arm.body.ty) {
                    return Err("CTIR match arm type mismatch")
                }
            }
            Ok(())
        },
        While { target, condition, body } => {
            verify_expr(ctx, condition)?;
            verify_expr(loop_context(ctx, target, ctir::CtType::Unit, false), body)?;
            if expression_type_matches(ctir::CtType::Bool, condition.ty)
                && types_equal(value.ty, ctir::CtType::Unit)
                && expression_type_matches(ctir::CtType::Unit, body.ty) {
                Ok(())
            } else {
                Err("CTIR while condition is not bool")
            }
        },
        ForRange { target, pattern, start, end, inclusive: _, body } => {
            verify_expr(ctx, start)?;
            verify_expr(ctx, end)?;
            let item_ty = ctir::CtType::Integer { signed: true, width: ctx.module.target.int_width };
            verify_pattern(ctx, pattern, item_ty)?;
            verify_expr(loop_context(ctx, target, ctir::CtType::Unit, false), body)?;
            if types_equal(value.ty, ctir::CtType::Unit)
                && expression_type_matches(item_ty, start.ty)
                && expression_type_matches(item_ty, end.ty)
                && expression_type_matches(ctir::CtType::Unit, body.ty) {
                Ok(())
            } else {
                Err("invalid CTIR range for expression types")
            }
        },
        ForArray { target, pattern, value: source, body } => {
            verify_expr(ctx, source)?;
            let item_ty = match source.ty {
                Array { len: _, elem } => elem,
                _ => return Err("CTIR array for source is not an array"),
            };
            verify_pattern(ctx, pattern, item_ty)?;
            verify_expr(loop_context(ctx, target, ctir::CtType::Unit, false), body)?;
            if types_equal(value.ty, ctir::CtType::Unit)
                && expression_type_matches(ctir::CtType::Unit, body.ty) {
                Ok(())
            } else {
                Err("invalid CTIR array for expression types")
            }
        },
        Loop { target, body } => {
            verify_expr(loop_context(ctx, target, value.ty, true), body)?;
            if expression_type_matches(ctir::CtType::Unit, body.ty) {
                Ok(())
            } else {
                Err("CTIR loop body type mismatch")
            }
        },
        ctir::CtExprKind::Break { target, value: result } => {
            if !types_equal(value.ty, ctir::CtType::Never) {
                return Err("CTIR break expression must have type Never")
            }
            let Some((expected, accepts_value)) = loop_target(ctx, target) else {
                return Err("CTIR break target is not in scope")
            };
            match result {
                Some(result) => {
                    verify_expr(ctx, result)?;
                    if accepts_value && expression_type_matches(expected, result.ty) {
                        Ok(())
                    } else {
                        Err("CTIR break value type mismatch")
                    }
                },
                None => if types_equal(expected, ctir::CtType::Unit) {
                    Ok(())
                } else {
                    Err("CTIR break is missing a value")
                },
            }
        },
        ctir::CtExprKind::Continue { target } => if !types_equal(value.ty, ctir::CtType::Never) {
            Err("CTIR continue expression must have type Never")
        } else if loop_target(ctx, target).is_some() {
            Ok(())
        } else {
            Err("CTIR continue target is not in scope")
        },
        ctir::CtExprKind::Return(result) => if !types_equal(value.ty, ctir::CtType::Never) {
            Err("CTIR return expression must have type Never")
        } else {
            match result {
                Some(result) => {
                    verify_expr(ctx, result)?;
                    if expression_type_matches(ctx.return_type, result.ty) {
                        Ok(())
                    } else {
                        Err("CTIR return type mismatch")
                    }
                },
                None => if types_equal(ctx.return_type, ctir::CtType::Unit) {
                    Ok(())
                } else {
                    Err("CTIR empty return from function with non-() return type")
                },
            }
        },
        Dynamic { value: receiver, methods } => {
            if let Dynamic(_) = value.ty {} else {
                return Err("CTIR dynamic construction requires a dynamic type")
            }
            verify_expr(ctx, receiver)?;
            let seen = collections::HashSet::new();
            for method in methods {
                if method.0 == "" || !seen.insert(method.0) {
                    return Err("invalid CTIR dynamic method name")
                }
                verify_expr(ctx, method.1)?;
                let Function { params, .. } = method.1.ty else {
                    return Err("CTIR dynamic method requires a function")
                };
                if params.is_empty() || !types_equal(params[0], receiver.ty) {
                    return Err("CTIR dynamic method receiver mismatch")
                }
            }
            Ok(())
        },
        Dispatch { receiver, method, args } => {
            verify_expr(ctx, receiver)?;
            if let Dynamic(_) = receiver.ty {} else {
                return Err("CTIR dispatch requires a dynamic receiver")
            }
            if method == "" {
                return Err("CTIR dispatch method is empty")
            }
            for argument in args {
                verify_expr(ctx, argument)?
            }
            Ok(())
        },
        Buffer { operation, args } => verify_buffer(ctx, operation, args, value.ty),
        Closure { parameters, local_start, body } => {
            let Function { params, result } = value.ty else {
                return Err("CTIR closure requires function type")
            };
            if local_start < 0 || local_start > ctx.local_types.len()
                || parameters.len() != params.len() {
                return Err("invalid CTIR closure locals")
            }
            let seen = collections::HashSet::new();
            for index in 0..parameters.len() {
                let slot = parameters[index];
                if slot < local_start || slot >= ctx.local_types.len() || !seen.insert(slot)
                    || !types_equal(ctx.local_types[slot], params[index]) {
                    return Err("invalid CTIR closure parameter")
                }
            }
            let inner = VerifyContext { return_type: result, loop_targets: Vec::new(), ..ctx };
            verify_expr(inner, body)?;
            if !expression_type_matches(result, body.ty) {
                return Err("CTIR closure result type mismatch")
            }
            Ok(())
        },
        Invoke { function, args } => {
            verify_expr(ctx, function)?;
            let Function { params, result } = function.ty else {
                return Err("CTIR invocation requires function type")
            };
            if !types_equal(value.ty, result) {
                return Err("CTIR invocation result type mismatch")
            }
            verify_expr_list(ctx, args, params)
        },
        Call { target, args } => {
            if let Intrinsic(name) = target {
                let signature = match value_intrinsic_signature(ctx.module.target, name) {
                    Some(value) => Option::Some(value),
                    None => derive_intrinsic_signature(ctx.module, name),
                };
                let Some(signature) = signature else {
                    return Err("unknown CTIR intrinsic")
                };
                if !types_equal(value.ty, signature.1) {
                    return Err("CTIR intrinsic return type mismatch")
                }
                return verify_expr_list(ctx, args, signature.0)
            }
            let Some(function) = call_function(ctx, target) else {
                return Err("unresolved CTIR call target")
            };
            if args.len() != function.parameter_slots.len()
                || args.len() != function.parameter_types.len()
                || !types_equal(value.ty, function.return_type) {
                return Err("CTIR call signature mismatch")
            }
            for index in 0..args.len() {
                verify_expr(ctx, args[index])?;
                if !expression_type_matches(function.parameter_types[index], args[index].ty) {
                    return Err("CTIR call argument type mismatch")
                }
            }
            Ok(())
        },
        Unary { op, value: operand } => {
            verify_expr(ctx, operand)?;
            match op {
                Not => if types_equal(value.ty, ctir::CtType::Bool)
                    && expression_type_matches(ctir::CtType::Bool, operand.ty) {
                    Ok(())
                } else {
                    Err("invalid CTIR logical negation types")
                },
                Neg => if is_signed_integer_type(value.ty)
                    && expression_type_matches(value.ty, operand.ty) {
                    Ok(())
                } else {
                    Err("invalid CTIR integer negation types")
                },
                BitNot => if is_integer_type(value.ty)
                    && expression_type_matches(value.ty, operand.ty) {
                    Ok(())
                } else {
                    Err("invalid CTIR integer complement types")
                },
            }
        },
        Binary { op, left, right } => {
            verify_expr(ctx, left)?;
            verify_expr(ctx, right)?;
            match op {
                And | Or => if expression_type_matches(Bool, left.ty)
                    && expression_type_matches(ctir::CtType::Bool, right.ty)
                    && types_equal(value.ty, ctir::CtType::Bool) {
                    Ok(())
                } else {
                    Err("invalid CTIR logical binary types")
                },
                Shl | Shr => if is_integer_type(value.ty)
                    && expression_type_matches(value.ty, left.ty)
                    && (is_integer_type(right.ty) || types_equal(right.ty, ctir::CtType::Never)) {
                    Ok(())
                } else {
                    Err("invalid CTIR shift types")
                },
                Add => if (is_integer_type(value.ty) || types_equal(value.ty, ctir::CtType::String))
                    && expression_type_matches(value.ty, left.ty)
                    && expression_type_matches(value.ty, right.ty) {
                    Ok(())
                } else {
                    Err("invalid CTIR addition types")
                },
                Sub | Mul | Div | Rem | BitAnd | BitOr | BitXor => if is_integer_type(value.ty)
                    && expression_type_matches(value.ty, left.ty)
                    && expression_type_matches(value.ty, right.ty) {
                    Ok(())
                } else {
                    Err("invalid CTIR integer binary types")
                },
                Less | Greater | LessEq | GreaterEq => if (is_ordered_type(left.ty)
                    && expression_type_matches(left.ty, right.ty)
                    || is_ordered_type(right.ty) && expression_type_matches(right.ty, left.ty))
                    && types_equal(value.ty, ctir::CtType::Bool) {
                    Ok(())
                } else {
                    Err("invalid CTIR comparison types")
                },
                Eq | NotEq => if (types_equal(left.ty, right.ty)
                    || types_equal(left.ty, ctir::CtType::Never)
                    || types_equal(right.ty, ctir::CtType::Never))
                    && types_equal(value.ty, ctir::CtType::Bool) {
                    Ok(())
                } else {
                    Err("invalid CTIR equality types")
                },
            }
        },
        Cast { value: operand, target } => {
            verify_expr(ctx, operand)?;
            if types_equal(value.ty, target) && is_integer_type(target)
                && (is_integer_type(operand.ty)
                    || types_equal(operand.ty, ctir::CtType::Char) && is_char_integer_type(target)
                    || types_equal(operand.ty, ctir::CtType::Never)) {
                Ok(())
            } else {
                Err("CTIR cast result type mismatch")
            }
        },
        CompileError(message) => {
            verify_expr(ctx, message)?;
            if expression_type_matches(ctir::CtType::String, message.ty)
                && types_equal(value.ty, ctir::CtType::Never) {
                Ok(())
            } else {
                Err("invalid CTIR compile_error expression")
            }
        },
    }
}

fn verify_block(ctx: VerifyContext, value: ctir::CtBlock) -> Result[(), string] {
    verify_origin(ctx, value.origin)?;
    for statement in value.statements {
        match statement {
            Let { pattern, value } => {
                verify_expr(ctx, value)?;
                verify_pattern(ctx, pattern, value.ty)?
            },
            Assign { slot, value } => {
                let Some(local_ty) = slot_type(ctx, slot) else {
                    return Err("invalid CTIR assignment slot")
                };
                verify_expr(ctx, value)?;
                if expression_type_matches(local_ty, value.ty) {} else {
                    return Err("CTIR assignment type mismatch")
                }
            },
            Expr(value) => verify_expr(ctx, value)?,
        }
    }
    match value.tail {
        Some(value) => verify_expr(ctx, value),
        None => Ok(()),
    }
}

fn verify_function(
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    value: ctir::CtFunction,
    value_nodes: Ref[isize],
    value_bytes: Ref[isize],
) -> Result[(), string] {
    if value.parameter_slots.len() != value.parameter_types.len() {
        return Err("CTIR function parameter signature mismatch")
    } else if value.local_count < value.parameter_slots.len() {
        return Err("CTIR function has fewer locals than parameters")
    } else if value.local_count != value.local_types.len() {
        return Err("CTIR function local type count does not match local count")
    }
    let seen = collections::BitSet::new();
    for index in 0..value.parameter_slots.len() {
        let slot = value.parameter_slots[index];
        if slot < 0 || slot >= value.local_count || !seen.insert(slot) {
            return Err("invalid CTIR parameter slot")
        } else if !types_equal(value.local_types[slot], value.parameter_types[index]) {
            return Err("CTIR parameter local type mismatch")
        }
    }
    for ty in value.parameter_types {
        verify_type(ty)?
    }
    for ty in value.local_types {
        verify_type(ty)?
    }
    verify_type(value.return_type)?;
    let ctx = VerifyContext {
        module,
        dependencies,
        local_types: value.local_types,
        return_type: value.return_type,
        loop_targets: Vec::new(),
        value_nodes,
        value_bytes,
    };
    verify_origin(ctx, value.origin)?;
    verify_block(ctx, value.body)
}

fn verify_unique_module_names(module: ctir::CtModule, dependencies: Vec[ctir::CtModule]) -> Result[
    (),
    string,
] {
    let names: collections::HashSet[string] = collections::HashSet::new();
    let _ = names.insert(module.package_name);
    for dependency in dependencies {
        if !names.insert(dependency.package_name) {
            return Err("duplicate CTIR module package `" + dependency.package_name + "`")
        } else if dependency.target.int_width != module.target.int_width {
            return Err("CTIR target mismatch")
        }
    }
    Ok(())
}

pub fn verify_module(module: ctir::CtModule, dependencies: Vec[ctir::CtModule]) -> Result[
    (),
    string,
] {
    if module.package_name == "" {
        return Err("empty CTIR package name")
    } else if module.target.int_width != 32 && module.target.int_width != 64 {
        return Err("invalid CTIR target integer width")
    } else if module.origins.is_empty() {
        return Err("CTIR module has no source origins")
    }
    verify_unique_module_names(module, dependencies)?;
    let value_nodes = Ref::new(0);
    let value_bytes = Ref::new(0);
    let ids: collections::HashSet[isize] = collections::HashSet::new();
    for function in module.functions {
        if function.id < 0 || !ids.insert(function.id) {
            return Err("duplicate or negative CTIR function id")
        }
        verify_function(module, dependencies, function, value_nodes, value_bytes)?
    }
    let entry_names: collections::HashSet[string] = collections::HashSet::new();
    for entry in module.entries {
        if entry.name == "" || !entry_names.insert(entry.name)
            || verify_find_function(module, entry.function_id).is_none() {
            return Err("invalid CTIR entry")
        }
    }
    let derive_export_names: collections::HashSet[string] = collections::HashSet::new();
    for entry in module.derive_entries {
        if entry.name == "" || !entry_names.insert(entry.name) {
            return Err("invalid CTIR derive entry")
        }
        let Some(function) = verify_find_function(module, entry.function_id) else {
            return Err("invalid CTIR derive entry")
        };
        if entry.export_name.is_some() || entry.public {
            let export_name = derive_export_name(entry);
            if export_name == "" || export_name.contains("::")
                || !derive_export_names.insert(export_name) {
                return Err("invalid or duplicate CTIR derive export name")
            }
            if function.parameter_types.len() != 1
                || !types_equal(function.parameter_types[0], ctir::CtType::Meta("DeriveInput"))
                || !types_equal(function.return_type, ctir::CtType::Meta("DeriveOutput")) {
                return Err("invalid CTIR derive entry signature")
            }
        }
    }
    let site_ids: collections::HashSet[isize] = collections::HashSet::new();
    for site in module.sites {
        if site.id < 0 || !site_ids.insert(site.id) || site.local_count < 0
            || site.local_count != site.local_types.len() {
            return Err("invalid CTIR site")
        }
        for ty in site.local_types {
            verify_type(ty)?
        }
        let ctx = VerifyContext {
            module,
            dependencies,
            local_types: site.local_types,
            return_type: site.expression.ty,
            loop_targets: Vec::new(),
            value_nodes,
            value_bytes,
        };
        verify_origin(ctx, site.origin)?;
        verify_expr(ctx, site.expression)?
    }
    let constant_names: collections::HashSet[string] = collections::HashSet::new();
    for constant in module.constants {
        if constant.name == "" || !constant_names.insert(constant.name) {
            return Err("duplicate or empty CTIR constant")
        }
        verify_type(value_type(constant.value))?;
        verify_value_limits(constant.value, value_nodes, value_bytes)?
    }
    Ok(())
}
