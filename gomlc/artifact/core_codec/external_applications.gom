package core_codec;

use module::artifact::wire;
use module::artifact::tast_codec;
use module::core;
use module::ffi;

fn write_external_applications(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    applications: Vec[core::ExternalTypeApplication],
) -> () {
    wire::artifact_json_begin_array(writer);
    for application in applications {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "function");
        wire::artifact_json_string(writer, application.function_name);
        wire::artifact_json_name(writer, "type_id");
        wire::artifact_json_string(writer, application.declaration.type_id);
        wire::artifact_json_name(writer, "import_path");
        wire::artifact_json_string(writer, application.declaration.import_path);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, application.declaration.name);
        wire::artifact_json_name(writer, "arguments");
        wire::artifact_json_begin_array(writer);
        for argument in application.arguments {
            artifact_json_core_type(writer, context, argument)
        }
        wire::artifact_json_end_array(writer);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn decode_external_applications(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[core::ExternalTypeApplication],
    string,
] {
    let values = wire::artifact_json_array(value, "external applications")?;
    if values.len() > 4096 {
        return Result::Err("too many external applications in Core artifact")
    }
    let result = Vec::new();
    for value in values {
        let object = wire::artifact_json_object(value, "external application")?;
        let values = wire::artifact_json_array(
            wire::artifact_json_required_field(object, "arguments")?,
            "external application arguments",
        )?;
        if values.len() > 256 {
            return Result::Err("too many external application arguments in Core artifact")
        }
        let arguments = Vec::new();
        for value in values {
            arguments.push(
                core::lower_type(tast_codec::artifact_decode_type(context.types, value)?),
            )
        }
        result.push(
            core::ExternalTypeApplication {
                function_name: wire::artifact_json_field_string(object, "function")?,
                declaration: ffi::TypeDeclarationQuery {
                    type_id: wire::artifact_json_field_string(object, "type_id")?,
                    import_path: wire::artifact_json_field_string(object, "import_path")?,
                    name: wire::artifact_json_field_string(object, "name")?,
                },
                arguments,
            },
        )
    }
    Result::Ok(result)
}

fn validate_external_application_metadata(
    applications: Vec[core::ExternalTypeApplication],
    metadata: Option[ffi::ForeignTypeMetadata],
) -> Result[(), string] {
    if applications.len() == 0 {
        return Result::Ok(())
    }
    let metadata = metadata.ok_or("external applications require Go declaration metadata")?;
    for application in applications {
        let mut found = false;
        for query in metadata.queries {
            if query.type_id == application.declaration.type_id {
                if query.import_path != application.declaration.import_path
                    || query.name != application.declaration.name {
                    return Result::Err(
                        "external application conflicts with Go declaration metadata",
                    )
                }
                found = true;
            }
        }
        if !found {
            return Result::Err("external application is missing Go declaration metadata")
        }
        let template = ffi::resolve_go_type_template(
            metadata.declarations,
            application.declaration.type_id,
        )?;
        if template.parameter_constraints.len() != application.arguments.len() {
            return Result::Err("external application argument count does not match Go declaration")
        }
    }
    Result::Ok(())
}
