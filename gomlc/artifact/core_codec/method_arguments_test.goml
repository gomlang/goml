package core_codec;

use module::artifact::wire;
use module::artifact::tast_codec;
use module::core;
use std::testing;

#[test]
fn method_arguments_survive_core_artifacts() -> () {
    let context = tast_codec::artifact_type_context(Vec::new(), Vec::new());
    let decode_context = ArtifactCoreDecodeContext {
        types: tast_codec::ArtifactDecodeContext {
            enum_names: Vec::new(),
            struct_names: Vec::new(),
        },
        struct_fields: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
    };
    for callable in[
        core::Callable::InherentMethod { receiver_ty: core::Type::Int, method_name: "count" },
        core::Callable::TraitMethod {
            trait_ref: core::TraitRef { name: "Count", args: Vec::new() },
            method_name: "count",
            for_ty: core::Type::Int,
            has_receiver: true,
        },
    ] {
        let value = core::Expr::Callable {
            callable: core::Callable::MethodInstance {
                callable,
                args: Vec::from_array([core::Type::Bool]),
            },
            ty: core::Type::Func {
                params: Vec::from_array([core::Type::Int]),
                ret_ty: core::Type::Uint,
            },
        };
        let writer = wire::new_artifact_value_writer();
        artifact_json_core_expr(writer, context, value);
        let Ok(encoded) = wire::artifact_value_finish(writer) else {
            testing::fail("encode failed");
            return
        };
        let Ok(decoded) = artifact_decode_core_expr(decode_context, encoded) else {
            testing::fail("decode failed");
            return
        };
        let before = wire::new_artifact_json_writer(false);
        let after = wire::new_artifact_json_writer(false);
        artifact_json_core_expr(before, context, value);
        artifact_json_core_expr(after, context, decoded);
        testing::assert_eq(wire::artifact_json_finish(before), wire::artifact_json_finish(after));
    }
}
