package core_codec;

use module::artifact::wire as wire;
use module::artifact;
use module::artifact::tast_codec as tast_codec;
use module::ast;
use module::tast;

struct ArtifactCoreDecodeContext {
    pub types: tast_codec::ArtifactDecodeContext,
    pub struct_fields: Vec[(string, Vec[string])],
    pub enums: Vec[tast::EnumDef],
    pub structs: Vec[tast::StructDef],
}

fn artifact_core_decode_context(value: artifact::ArtifactPackageExports) -> ArtifactCoreDecodeContext {
    let types = tast_codec::ArtifactDecodeContext {
        enum_names: value.enum_type_names,
        struct_names: value.struct_type_names,
    };
    let struct_fields: Vec[(string, Vec[string])] = Vec::new();
    for definition in value.structs {
        let fields: Vec[string] = Vec::new();
        for field in definition.fields {
            fields.push(field.0)
        }
        struct_fields.push((definition.name, fields))
    }
    ArtifactCoreDecodeContext { types, struct_fields, enums: value.enums, structs: value.structs }
}

fn artifact_decode_struct_fields(context: ArtifactCoreDecodeContext, name: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in context.struct_fields {
        if value.0 == name {
            for field in value.1 {
                result.push(field)
            }
        }
    }
    result
}

fn artifact_decode_primitive_payload(value: wire::ArtifactValue) -> Result[
    wire::ArtifactValue,
    string,
] {
    let object = wire::artifact_json_object(value, "primitive payload")?;
    wire::artifact_json_required_field(object, "value")
}

fn artifact_decode_numeric_primitive(kind: string, value: wire::ArtifactValue) -> Result[
    tast::Primitive,
    string,
] {
    let value = wire::artifact_json_number_value(
        artifact_decode_primitive_payload(value)?,
        "numeric primitive",
    )?;
    match kind {
        "Int" => Ok(tast::Primitive::Int { value }),
        "Int8" => Ok(tast::Primitive::Int8 { value }),
        "Int16" => Ok(tast::Primitive::Int16 { value }),
        "Int32" => Ok(tast::Primitive::Int32 { value }),
        "Int64" => Ok(tast::Primitive::Int64 { value }),
        "UInt" => Ok(tast::Primitive::Uint { value }),
        "UInt8" => Ok(tast::Primitive::Uint8 { value }),
        "UInt16" => Ok(tast::Primitive::Uint16 { value }),
        "UInt32" => Ok(tast::Primitive::Uint32 { value }),
        "UInt64" => Ok(tast::Primitive::Uint64 { value }),
        "Float32" => Ok(tast::Primitive::Float32 { value }),
        "Float64" => Ok(tast::Primitive::Float64 { value }),
        _ => Err(wire::artifact_decode_error("numeric primitive kind")),
    }
}

fn artifact_decode_primitive(value: wire::ArtifactValue) -> Result[tast::Primitive, string] {
    let object = wire::artifact_json_object(value, "primitive")?;
    if object.len() != 1 {
        return Err(wire::artifact_decode_error("primitive variant"))
    }
    let kind = object[0].0;
    let payload = object[0].1;
    if kind == "Unit" {
        match artifact_decode_primitive_payload(payload) {
            Ok(Null) => Ok(tast::Primitive::Unit),
            Ok(_) => Err(wire::artifact_decode_error("unit primitive")),
            Err(error) => Err(error),
        }
    } else if kind == "Bool" {
        match artifact_decode_primitive_payload(payload) {
            Ok(value) => wire::artifact_json_bool_value(value, "boolean primitive").map(
                |value| tast::Primitive::Bool { value },
            ),
            Err(error) => Err(error),
        }
    } else if kind == "String" {
        match artifact_decode_primitive_payload(payload) {
            Ok(value) => wire::artifact_json_string_value(value, "string primitive").map(
                |value| tast::Primitive::String { value },
            ),
            Err(error) => Err(error),
        }
    } else if kind == "Char" {
        let value = wire::artifact_json_string_value(
            artifact_decode_primitive_payload(payload)?,
            "character primitive",
        )?;
        match value.decode_at(0) {
            Some((character, width)) => if width == value.byte_len() {
                Ok(tast::Primitive::Char { value: character })
            } else {
                Err(wire::artifact_decode_error("single character primitive"))
            },
            None => Err(wire::artifact_decode_error("single character primitive")),
        }
    } else if kind == "Bytes" {
        let values = wire::artifact_json_array(
            artifact_decode_primitive_payload(payload)?,
            "byte string primitive",
        )?;
        let result: Vec[string] = Vec::with_capacity(values.len());
        for value in values {
            result.push(wire::artifact_json_string_value(value, "byte string value")?)
        }
        Ok(tast::Primitive::Bytes { values: result })
    } else {
        artifact_decode_numeric_primitive(kind, payload)
    }
}

fn artifact_decode_constructor(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::Constructor,
    string,
] {
    let object = wire::artifact_json_object(value, "constructor")?;
    if object.len() != 1 {
        Err(wire::artifact_decode_error("constructor variant"))
    } else if object[0].0 == "Struct" {
        let payload = wire::artifact_json_object(object[0].1, "struct constructor")?;
        let name = wire::artifact_json_field_string(payload, "type_name")?;
        let fields = match wire::artifact_json_optional_field(payload, "fields")? {
            Some(value) => wire::artifact_decode_string_array(value, "struct constructor fields")?,
            None => artifact_decode_struct_fields(context, name),
        };
        Ok(tast::Constructor { name, fields, is_struct: true, tag: Option::None })
    } else if object[0].0 == "Enum" {
        let payload = wire::artifact_json_object(object[0].1, "enum constructor")?;
        let type_name = wire::artifact_json_field_string(payload, "type_name")?;
        let variant = wire::artifact_json_field_string(payload, "variant")?;
        let index = wire::artifact_parse_nonnegative_int(
            wire::artifact_json_number_value(
                wire::artifact_json_required_field(payload, "index")?,
                "enum constructor index",
            )?,
        )?;
        Ok(
            tast::Constructor {
                name: type_name + "::" + variant,
                fields: Vec::new(),
                is_struct: false,
                tag: Option::Some(index),
            },
        )
    } else {
        Err(wire::artifact_decode_error("constructor kind"))
    }
}

fn artifact_decode_unary(value: string) -> Result[ast::UnaryOp, string] {
    match value {
        "Neg" => Ok(ast::UnaryOp::Neg),
        "Not" => Ok(ast::UnaryOp::Not),
        "BitNot" => Ok(ast::UnaryOp::BitNot),
        _ => Err(wire::artifact_decode_error("unary operator")),
    }
}

fn artifact_decode_binary(value: string) -> Result[ast::BinaryOp, string] {
    match value {
        "Add" => Ok(ast::BinaryOp::Add),
        "Sub" => Ok(ast::BinaryOp::Sub),
        "Mul" => Ok(ast::BinaryOp::Mul),
        "Div" => Ok(ast::BinaryOp::Div),
        "Rem" => Ok(ast::BinaryOp::Rem),
        "BitAnd" => Ok(ast::BinaryOp::BitAnd),
        "BitOr" => Ok(ast::BinaryOp::BitOr),
        "BitXor" => Ok(ast::BinaryOp::BitXor),
        "Shl" => Ok(ast::BinaryOp::Shl),
        "Shr" => Ok(ast::BinaryOp::Shr),
        "And" => Ok(ast::BinaryOp::And),
        "Or" => Ok(ast::BinaryOp::Or),
        "Less" => Ok(ast::BinaryOp::Less),
        "Greater" => Ok(ast::BinaryOp::Greater),
        "LessEq" => Ok(ast::BinaryOp::LessEq),
        "GreaterEq" => Ok(ast::BinaryOp::GreaterEq),
        "Eq" => Ok(ast::BinaryOp::Eq),
        "NotEq" => Ok(ast::BinaryOp::NotEq),
        _ => Err(wire::artifact_decode_error("binary operator")),
    }
}
