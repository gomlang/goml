package core_codec;

use module::artifact;
use module::core;
use module::artifact::wire;
use std::collections;

pub fn write_source_origins(
    writer: wire::ArtifactJsonWriter,
    values: Vec[artifact::ArtifactSourceOrigin],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "symbol");
        wire::artifact_json_string(writer, value.symbol);
        wire::artifact_json_name(writer, "source_file");
        wire::artifact_json_string(writer, value.source_file);
        wire::artifact_json_name(writer, "start");
        wire::artifact_json_number(writer, value.start.to_string());
        wire::artifact_json_name(writer, "end");
        wire::artifact_json_number(writer, value.end.to_string());
        wire::artifact_json_name(writer, "line");
        wire::artifact_json_number(writer, value.line.to_string());
        wire::artifact_json_name(writer, "column");
        wire::artifact_json_number(writer, value.column.to_string());
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn decode_source_origins(package_name: string, core_ir: core::File, value: wire::ArtifactValue) -> Result[
    Vec[artifact::ArtifactSourceOrigin],
    string,
] {
    let result: Vec[artifact::ArtifactSourceOrigin] = Vec::new();
    let methods: collections::HashSet[string] = collections::HashSet::new();
    for function in core_ir.functions {
        match function.origin {
            Inherent { .. } | TraitImplementation { .. } => {
                let _ = methods.insert(function.name);
            },
            Source => (),
        }
    }
    let symbols: collections::HashSet[string] = collections::HashSet::new();
    for entry in wire::artifact_json_array(value, "source origins")? {
        let object = wire::artifact_json_object(entry, "source origin")?;
        let symbol = wire::artifact_json_field_string(object, "symbol")?;
        let source_file = wire::artifact_json_field_string(object, "source_file")?;
        let start = artifact_decode_core_index_field(object, "start")?;
        let end = artifact_decode_core_index_field(object, "end")?;
        let line = artifact_decode_core_index_field(object, "line")?;
        let column = artifact_decode_core_index_field(object, "column")?;
        if (!symbol.starts_with(package_name + "::") && !methods.contains(symbol))
            || symbol == package_name + "::"
            || !symbols.insert(symbol) {
            return Result::Err("invalid or duplicate Core source origin symbol")
        }
        if source_file == "" || source_file == "." || source_file == ".."
            || source_file.contains("/")
            || source_file.contains("\\")
            || source_file.contains("\u0000") {
            return Result::Err("Core source origin requires a package-relative file name")
        }
        if start < 0 || end <= start || line < 1 || column < 1 {
            return Result::Err("invalid Core source origin position")
        }
        result.push(
            artifact::ArtifactSourceOrigin { symbol, source_file, start, end, line, column },
        )
    }
    Result::Ok(result)
}
