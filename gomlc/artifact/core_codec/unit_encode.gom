package core_codec;

use module::artifact::wire as wire;
use module::artifact;
use module::artifact::tast_codec as tast_codec;
use module::artifact::interface_codec as interface_codec;
use module::core;

fn artifact_json_test_descriptor(
    writer: wire::ArtifactJsonWriter,
    value: artifact::ArtifactTestDescriptor,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "id");
    wire::artifact_json_string(writer, value.id);
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "symbol");
    wire::artifact_json_string(writer, value.symbol);
    wire::artifact_json_name(writer, "display_name");
    wire::artifact_json_string(writer, value.display_name);
    wire::artifact_json_name(writer, "source_path");
    wire::artifact_json_string(writer, value.source_path);
    wire::artifact_json_name(writer, "start");
    wire::artifact_json_number(writer, value.start.to_string());
    wire::artifact_json_name(writer, "end");
    wire::artifact_json_number(writer, value.end.to_string());
    wire::artifact_json_name(writer, "ignored");
    wire::artifact_json_bool(writer, value.ignored);
    wire::artifact_json_name(writer, "ignore_reason");
    match value.ignore_reason {
        Some(value) => wire::artifact_json_string(writer, value),
        None => wire::artifact_json_null(writer),
    }
    wire::artifact_json_name(writer, "arguments");
    wire::artifact_json_begin_array(writer);
    for argument in value.arguments {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "kind");
        wire::artifact_json_string(writer, argument.0);
        wire::artifact_json_name(writer, "value");
        wire::artifact_json_string(writer, argument.1);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_tests(
    writer: wire::ArtifactJsonWriter,
    values: Vec[artifact::ArtifactTestDescriptor],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_test_descriptor(writer, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_unit(writer: wire::ArtifactJsonWriter, value: artifact::ArtifactCoreUnit) -> () {
    let context = interface_codec::artifact_exports_type_context(value.exports);
    wire::artifact_json_begin_object(writer);
    if wire::artifact_json_binary_mode(writer) < 2 {
        wire::artifact_json_name(writer, "format_version");
        wire::artifact_json_number(writer, "28");
        wire::artifact_json_name(writer, "compiler_abi");
        wire::artifact_json_number(writer, "5")
    }
    wire::artifact_json_name(writer, "external_applications");
    write_external_applications(writer, context, value.external_applications);
    wire::artifact_json_name(writer, "foreign_types");
    interface_codec::write_foreign_type_metadata(writer, value.foreign_types);
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "declared_name");
    wire::artifact_json_string(writer, value.declared_name);
    wire::artifact_json_name(writer, "interface_hash");
    wire::artifact_json_string(writer, value.interface_hash);
    wire::artifact_json_name(writer, "exports");
    interface_codec::write_exports(writer, context, value.exports);
    wire::artifact_json_name(writer, "core_ir");
    write_core_file(writer, context, value.core_ir);
    wire::artifact_json_name(writer, "deps");
    interface_codec::artifact_json_string_map(writer, value.deps);
    wire::artifact_json_name(writer, "source_origins");
    write_source_origins(writer, value.source_origins);
    wire::artifact_json_name(writer, "sources");
    tast_codec::artifact_json_string_array(writer, value.sources);
    wire::artifact_json_name(writer, "tests");
    artifact_json_tests(writer, value.tests);
    wire::artifact_json_end_object(writer)
}

pub fn encode_json(value: artifact::ArtifactCoreUnit, pretty: bool) -> string {
    let writer = wire::new_artifact_json_writer(pretty);
    artifact_json_core_unit(writer, value);
    wire::artifact_json_finish(writer)
}
