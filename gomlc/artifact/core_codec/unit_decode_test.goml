package core_codec;

use module::artifact::wire as wire;
use std::testing;

#[test]
fn test_descriptor_requires_explicit_arguments() -> () {
    let fields = Vec::from_array(
        [
            ("id", wire::ArtifactValue::String("test")),
            ("package", wire::ArtifactValue::String("example")),
            ("symbol", wire::ArtifactValue::String("example::test")),
            ("display_name", wire::ArtifactValue::String("test")),
            ("source_path", wire::ArtifactValue::String("test.goml")),
            ("start", wire::ArtifactValue::Number("0")),
            ("end", wire::ArtifactValue::Number("1")),
            ("ignored", wire::ArtifactValue::Bool(false)),
            ("ignore_reason", wire::ArtifactValue::Null),
        ],
    );
    testing::assert(artifact_decode_test_descriptor(wire::ArtifactValue::Object(fields)).is_err());
    fields.push(("arguments", wire::ArtifactValue::Array(Vec::new())));
    testing::assert(artifact_decode_test_descriptor(wire::ArtifactValue::Object(fields)).is_ok());
}
