package core_codec;

use module::artifact::wire as wire;
use module::artifact::tast_codec as tast_codec;
use module::ast;
use module::core;
use module::tast;

fn artifact_decode_core_type_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    name: string,
) -> Result[core::Type, string] {
    let value = wire::artifact_json_required_field(object, name)?;
    Result::Ok(core::lower_type(tast_codec::artifact_decode_type(context.types, value)?))
}

fn artifact_decode_core_trait_ref(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::TraitRef,
    string,
] {
    Result::Ok(core::lower_trait_ref(tast_codec::artifact_decode_trait_ref(context.types, value)?))
}

fn artifact_decode_core_expr_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    name: string,
) -> Result[core::Expr, string] {
    let value = wire::artifact_json_required_field(object, name)?;
    artifact_decode_core_expr(context, value)
}

fn artifact_decode_core_exprs(
    context: ArtifactCoreDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[Vec[core::Expr], string] {
    let values = wire::artifact_json_array(value, expected)?;
    let result: Vec[core::Expr] = Vec::new();
    for value in values {
        result.push(artifact_decode_core_expr(context, value)?)
    }
    Result::Ok(result)
}

fn artifact_decode_core_expr_array_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    name: string,
) -> Result[Vec[core::Expr], string] {
    let value = wire::artifact_json_required_field(object, name)?;
    artifact_decode_core_exprs(context, value, name)
}

fn artifact_decode_optional_core_expr(
    context: ArtifactCoreDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Option[core::Expr], string] {
    match value {
        Null => Result::Ok(Option::None),
        other => Result::Ok(Option::Some(artifact_decode_core_expr(context, other)?)),
    }
}

fn artifact_decode_closure_params(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[core::ClosureParam],
    string,
] {
    let values = wire::artifact_json_array(value, "closure parameters")?;
    let result: Vec[core::ClosureParam] = Vec::new();
    for value in values {
        let object = wire::artifact_json_object(value, "closure parameter")?;
        let name = wire::artifact_json_field_string(object, "name")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        result.push(core::ClosureParam { name, ty })
    }
    Result::Ok(result)
}

fn artifact_decode_core_arms(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[core::Arm],
    string,
] {
    let values = wire::artifact_json_array(value, "match arms")?;
    let result: Vec[core::Arm] = Vec::new();
    for value in values {
        let object = wire::artifact_json_object(value, "match arm")?;
        let lhs = artifact_decode_core_expr_field(context, object, "lhs")?;
        let body = artifact_decode_core_expr_field(context, object, "body")?;
        result.push(core::Arm { lhs, body })
    }
    Result::Ok(result)
}

fn artifact_decode_core_select_arms(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[core::SelectArm],
    string,
] {
    let values = wire::artifact_json_array(value, "select arms")?;
    let result: Vec[core::SelectArm] = Vec::new();
    for value in values {
        let object = wire::artifact_json_object(value, "select arm")?;
        let kind = wire::artifact_json_field_string(object, "kind")?;
        let channel = artifact_decode_core_expr_field(context, object, "channel")?;
        let body = artifact_decode_core_expr_field(context, object, "body")?;
        let guard = match wire::artifact_json_optional_field(object, "guard")? {
            Some(value) => artifact_decode_optional_core_expr(context, value)?,
            None => Option::None,
        };
        if kind == "receive" {
            let binding = wire::artifact_json_field_string(object, "binding")?;
            let binding_ty = artifact_decode_core_type_field(context, object, "binding_ty")?;
            result.push(core::SelectArm::Receive { channel, guard, binding, binding_ty, body })
        } else if kind == "send" {
            let value = artifact_decode_core_expr_field(context, object, "value")?;
            result.push(core::SelectArm::Send { channel, value, guard, body })
        } else {
            return Result::Err(wire::artifact_decode_error("select arm kind"))
        }
    }
    Result::Ok(result)
}

fn artifact_decode_core_expr(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::Expr,
    string,
] {
    let variant = wire::artifact_json_object(value, "Core expression")?;
    if variant.len() != 1 {
        return Result::Err(wire::artifact_decode_error("Core expression variant"))
    }
    let kind = variant[0].0;
    let object = wire::artifact_json_object(variant[0].1, "Core expression payload")?;
    if kind == "EVar" {
        let name = wire::artifact_json_field_string(object, "name")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Var { name, ty })
    } else if kind == "ECallable" {
        let name = wire::artifact_json_field_string(object, "name")?;
        let body = wire::artifact_json_required_field(object, "body")?;
        let callable = core::lower_callable(tast_codec::artifact_decode_callable_body(name, body)?);
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        if let core::Callable::GoInterfaceBridge { methods, .. } = callable {
            tast::validate_go_interface_bridge_callable(methods, core::type_to_tast(ty))?;
        }
        Result::Ok(core::Expr::Callable { callable, ty })
    } else if kind == "EFunctionInstance" {
        let name = wire::artifact_json_field_string(object, "name")?;
        let values = wire::artifact_json_array(
            wire::artifact_json_required_field(object, "bindings")?,
            "generic function bindings",
        )?;
        let bindings: Vec[(string, core::Type)] = Vec::new();
        for value in values {
            let binding = wire::artifact_json_object(value, "generic function binding")?;
            let parameter = wire::artifact_json_field_string(binding, "name")?;
            for previous in bindings {
                if previous.0 == parameter {
                    return Result::Err(
                        wire::artifact_decode_error("duplicate generic function binding"),
                    )
                }
            }
            bindings.push((parameter, artifact_decode_core_type_field(context, binding, "ty")?))
        }
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::Callable {
                callable: core::Callable::FunctionInstance { name, bindings },
                ty,
            },
        )
    } else if kind == "ELangItemCallable" {
        let item = wire::artifact_json_field_string(object, "item")?;
        let function_name = wire::artifact_json_field_string(object, "function_name")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::Callable { callable: core::Callable::LangItem { item, function_name }, ty },
        )
    } else if kind == "ETraitCallable" {
        let trait_ref = artifact_decode_core_trait_ref(
            context,
            wire::artifact_json_required_field(object, "trait_ref")?,
        )?;
        let method_name = wire::artifact_json_field_string(object, "method_name")?;
        let for_ty = artifact_decode_core_type_field(context, object, "for_ty")?;
        let has_receiver = wire::artifact_json_bool_value(
            wire::artifact_json_required_field(object, "has_receiver")?,
            "trait callable receiver flag",
        )?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::Callable {
                callable: core::Callable::TraitMethod {
                    trait_ref,
                    method_name,
                    for_ty,
                    has_receiver,
                },
                ty,
            },
        )
    } else if kind == "EDynTraitCallable" {
        let trait_name = wire::artifact_json_field_string(object, "trait_name")?;
        let dispatch_name = wire::artifact_json_field_string(object, "dispatch_name")?;
        let method_name = wire::artifact_json_field_string(object, "method_name")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::Callable {
                callable: core::Callable::DynTraitMethod { trait_name, dispatch_name, method_name },
                ty,
            },
        )
    } else if kind == "EInherentCallable" {
        let receiver_ty = artifact_decode_core_type_field(context, object, "receiver_ty")?;
        let method_name = wire::artifact_json_field_string(object, "method_name")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::Callable {
                callable: core::Callable::InherentMethod { receiver_ty, method_name },
                ty,
            },
        )
    } else if kind == "EPrim" {
        let value = wire::artifact_json_required_field(object, "value")?;
        let primitive = core::lower_primitive(artifact_decode_primitive(value)?);
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Prim { value: primitive, ty })
    } else if kind == "EConstr" {
        let value = wire::artifact_json_required_field(object, "constructor")?;
        let constructor = core::lower_constructor(artifact_decode_constructor(context, value)?);
        let args = artifact_decode_core_expr_array_field(context, object, "args")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Constr { constructor, args, ty })
    } else if kind == "ETuple" || kind == "EArray" {
        let items = artifact_decode_core_expr_array_field(context, object, "items")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        if kind == "ETuple" {
            Result::Ok(core::Expr::Tuple { items, ty })
        } else {
            Result::Ok(core::Expr::Array { items, ty })
        }
    } else if kind == "EClosure" {
        let value = wire::artifact_json_required_field(object, "params")?;
        let params = artifact_decode_closure_params(context, value)?;
        let body = artifact_decode_core_expr_field(context, object, "body")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Closure { params, body, ty })
    } else if kind == "EBlock" {
        let value = wire::artifact_json_required_field(object, "block")?;
        let block = artifact_decode_core_block(context, value)?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Block { block, ty })
    } else if kind == "EMatch" {
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let value = wire::artifact_json_required_field(object, "arms")?;
        let arms = artifact_decode_core_arms(context, value)?;
        let value = wire::artifact_json_required_field(object, "default")?;
        let default = artifact_decode_optional_core_expr(context, value)?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Match { expr, arms, default, ty })
    } else if kind == "ESelect" {
        let mode = match wire::artifact_json_optional_field(object, "mode")? {
            Some(value) => if wire::artifact_json_string_value(value, "select mode")? == "priority" {
                ast::SelectMode::Priority
            } else {
                ast::SelectMode::Normal
            },
            None => ast::SelectMode::Normal,
        };
        let value = wire::artifact_json_required_field(object, "arms")?;
        let arms = artifact_decode_core_select_arms(context, value)?;
        let value = wire::artifact_json_required_field(object, "default")?;
        let default = artifact_decode_optional_core_expr(context, value)?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Select { mode, arms, default, ty })
    } else if kind == "EIf" {
        let cond = artifact_decode_core_expr_field(context, object, "cond")?;
        let then_branch = artifact_decode_core_expr_field(context, object, "then_branch")?;
        let else_branch = artifact_decode_core_expr_field(context, object, "else_branch")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::If { cond, then_branch, else_branch, ty })
    } else if kind == "EWhile" {
        let cond = artifact_decode_core_expr_field(context, object, "cond")?;
        let body = artifact_decode_core_expr_field(context, object, "body")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::While { cond, body, ty })
    } else if kind == "ELoop" {
        let body = artifact_decode_core_expr_field(context, object, "body")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Loop { body, ty })
    } else if kind == "EBreak" || kind == "EContinue" {
        let target = artifact_decode_core_index_field(object, "target")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        if kind == "EBreak" {
            let value = match wire::artifact_json_optional_field(object, "value")? {
                Some(value) => artifact_decode_optional_core_expr(context, value)?,
                None => Option::None,
            };
            Result::Ok(core::Expr::Break { target, value, ty })
        } else {
            Result::Ok(core::Expr::Continue { target, ty })
        }
    } else if kind == "EReturn" {
        let value = wire::artifact_json_required_field(object, "expr")?;
        let expr = artifact_decode_optional_core_expr(context, value)?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Return { expr, ty })
    } else if kind == "EGo" {
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Go { expr, ty })
    } else {
        artifact_decode_core_expr_tail(context, kind, object)
    }
}

fn artifact_decode_core_index_field(object: Vec[(string, wire::ArtifactValue)], name: string) -> Result[
    isize,
    string,
] {
    let value = wire::artifact_json_required_field(object, name)?;
    let value = wire::artifact_json_number_value(value, name)?;
    wire::artifact_parse_nonnegative_int(value)
}

fn artifact_decode_core_expr_tail(
    context: ArtifactCoreDecodeContext,
    kind: string,
    object: Vec[(string, wire::ArtifactValue)],
) -> Result[core::Expr, string] {
    if kind == "EConstrGet" {
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let value = wire::artifact_json_required_field(object, "constructor")?;
        let constructor = core::lower_constructor(artifact_decode_constructor(context, value)?);
        let field_index = artifact_decode_core_index_field(object, "field_index")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::ConstrGet { expr, constructor, field_index, ty })
    } else if kind == "EUnary" {
        let value = wire::artifact_json_field_string(object, "op")?;
        let op = artifact_decode_unary(value)?;
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Unary { op, expr, ty })
    } else if kind == "ECast" {
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Cast { expr, ty })
    } else if kind == "EBinary" {
        let value = wire::artifact_json_field_string(object, "op")?;
        let op = artifact_decode_binary(value)?;
        let lhs = artifact_decode_core_expr_field(context, object, "lhs")?;
        let rhs = artifact_decode_core_expr_field(context, object, "rhs")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Binary { op, lhs, rhs, ty })
    } else if kind == "EAssign" {
        let name = wire::artifact_json_field_string(object, "name")?;
        let value = artifact_decode_core_expr_field(context, object, "value")?;
        let target_ty = artifact_decode_core_type_field(context, object, "target_ty")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Assign { name, value, target_ty, ty })
    } else if kind == "ECall" {
        let func = artifact_decode_core_expr_field(context, object, "func")?;
        let args = artifact_decode_core_expr_array_field(context, object, "args")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Call { func, args, ty })
    } else if kind == "EToDyn" {
        let trait_name = wire::artifact_json_field_string(object, "trait_name")?;
        let for_ty = artifact_decode_core_type_field(context, object, "for_ty")?;
        let expr = artifact_decode_core_expr_field(context, object, "expr")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::ToDyn { trait_name, for_ty, expr, ty })
    } else if kind == "EDynCall" {
        let trait_name = wire::artifact_json_field_string(object, "trait_name")?;
        let method_name = wire::artifact_json_field_string(object, "method_name")?;
        let receiver = artifact_decode_core_expr_field(context, object, "receiver")?;
        let args = artifact_decode_core_expr_array_field(context, object, "args")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::DynCall { trait_name, method_name, receiver, args, ty })
    } else if kind == "ETraitCall" {
        let value = wire::artifact_json_required_field(object, "trait_ref")?;
        let trait_ref = artifact_decode_core_trait_ref(context, value)?;
        let method_name = wire::artifact_json_field_string(object, "method_name")?;
        let for_ty = artifact_decode_core_type_field(context, object, "for_ty")?;
        let receiver = artifact_decode_optional_core_expr(
            context,
            wire::artifact_json_required_field(object, "receiver")?,
        )?;
        let args = artifact_decode_core_expr_array_field(context, object, "args")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(
            core::Expr::TraitCall {
                trait_ref,
                method_name,
                instance_name: Option::None,
                for_ty,
                receiver,
                args,
                ty,
            },
        )
    } else if kind == "EProj" {
        let tuple = artifact_decode_core_expr_field(context, object, "tuple")?;
        let index = artifact_decode_core_index_field(object, "index")?;
        let ty = artifact_decode_core_type_field(context, object, "ty")?;
        Result::Ok(core::Expr::Proj { tuple, index, ty })
    } else {
        Result::Err(wire::artifact_decode_error("Core expression kind"))
    }
}

fn artifact_decode_core_block(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::Block,
    string,
] {
    let object = wire::artifact_json_object(value, "Core block")?;
    let values = wire::artifact_json_field_array(object, "stmts")?;
    let stmts: Vec[core::LetStmt] = Vec::new();
    for value in values {
        let statement = wire::artifact_json_object(value, "Core let statement")?;
        let name = wire::artifact_json_field_string(statement, "name")?;
        let value = artifact_decode_core_expr_field(context, statement, "value")?;
        let ty = artifact_decode_core_type_field(context, statement, "ty")?;
        stmts.push(core::LetStmt { name, value, ty })
    }
    let value = wire::artifact_json_required_field(object, "tail")?;
    let tail = artifact_decode_optional_core_expr(context, value)?;
    Result::Ok(core::Block { stmts, tail })
}

fn artifact_decode_core_trait_impl(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Option[core::TraitImpl],
    string,
] {
    match value {
        Null => Result::Ok(Option::None),
        other => {
            let object = wire::artifact_json_object(other, "Core trait implementation")?;
            let value = wire::artifact_json_required_field(object, "trait_ref")?;
            let trait_ref = artifact_decode_core_trait_ref(context, value)?;
            let for_ty = artifact_decode_core_type_field(context, object, "for_ty")?;
            let generic_count = artifact_decode_core_index_field(object, "generic_count")?;
            let predicate_count = artifact_decode_core_index_field(object, "predicate_count")?;
            Result::Ok(
                Option::Some(
                    core::TraitImpl {
                        trait_ref,
                        for_ty,
                        associated_types: Vec::new(),
                        generic_count,
                        predicate_count,
                    },
                ),
            )
        },
    }
}

fn artifact_decode_core_params(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[(string, core::Type)],
    string,
] {
    let values = wire::artifact_json_array(value, "Core function parameters")?;
    let result: Vec[(string, core::Type)] = Vec::new();
    for value in values {
        let pair = wire::artifact_json_array(value, "Core function parameter")?;
        if pair.len() != 2 {
            return Result::Err(wire::artifact_decode_error("Core function parameter"))
        }
        let name = wire::artifact_json_string_value(pair[0], "Core parameter name")?;
        let ty = core::lower_type(tast_codec::artifact_decode_type(context.types, pair[1])?);
        result.push((name, ty))
    }
    Result::Ok(result)
}

fn artifact_decode_core_predicates(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[core::TypePredicate],
    string,
] {
    let values = wire::artifact_json_array(value, "Core function predicates")?;
    let result: Vec[core::TypePredicate] = Vec::new();
    for value in values {
        result.push(
            core::lower_predicate(tast_codec::artifact_decode_predicate(context.types, value)?),
        )
    }
    Result::Ok(result)
}

fn artifact_decode_core_function_origin(
    context: ArtifactCoreDecodeContext,
    value: wire::ArtifactValue,
) -> Result[core::FunctionOrigin, string] {
    let object = wire::artifact_json_object(value, "Core function origin")?;
    match wire::artifact_json_optional_field(object, "Source")? {
        Some(_) => Result::Ok(core::FunctionOrigin::Source),
        None => match wire::artifact_json_optional_field(object, "Inherent")? {
            Some(value) => {
                let inherent = wire::artifact_json_object(value, "Core inherent function origin")?;
                let owner = artifact_decode_core_type_field(context, inherent, "owner")?;
                let method_name = wire::artifact_json_field_string(inherent, "method_name")?;
                Result::Ok(core::FunctionOrigin::Inherent { owner, method_name })
            },
            None => match wire::artifact_json_optional_field(object, "TraitImplementation")? {
                Some(value) => Result::Ok(
                    core::FunctionOrigin::TraitImplementation {
                        method_name: wire::artifact_json_string_value(
                            value,
                            "Core trait implementation method name",
                        )?,
                    },
                ),
                None => Result::Err(wire::artifact_decode_error("Core function origin")),
            },
        },
    }
}

fn artifact_decode_core_function(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::Function,
    string,
] {
    let object = wire::artifact_json_object(value, "Core function")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    let value = wire::artifact_json_required_field(object, "origin")?;
    let origin = artifact_decode_core_function_origin(context, value)?;
    let value = wire::artifact_json_required_field(object, "root")?;
    let root = wire::artifact_json_bool_value(value, "Core function root")?;
    let value = wire::artifact_json_required_field(object, "generics")?;
    let generics = wire::artifact_decode_string_array(value, "Core function generics")?;
    let value = wire::artifact_json_required_field(object, "predicates")?;
    let predicates = artifact_decode_core_predicates(context, value)?;
    let value = wire::artifact_json_required_field(object, "trait_impl")?;
    let trait_impl = artifact_decode_core_trait_impl(context, value)?;
    let value = wire::artifact_json_required_field(object, "params")?;
    let params = artifact_decode_core_params(context, value)?;
    let ret_ty = artifact_decode_core_type_field(context, object, "ret_ty")?;
    let value = wire::artifact_json_required_field(object, "body")?;
    let body = artifact_decode_core_block(context, value)?;
    Result::Ok(
        core::Function {
            name,
            origin,
            root,
            generics,
            predicates,
            trait_impl,
            params,
            ret_ty,
            body,
        },
    )
}

fn artifact_decode_const_expr_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    name: string,
) -> Result[core::ConstExpr, string] {
    let value = wire::artifact_json_required_field(object, name)?;
    artifact_decode_const_expr(context, value)
}

fn artifact_decode_const_exprs(
    context: ArtifactCoreDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[Vec[core::ConstExpr], string] {
    let values = wire::artifact_json_array(value, expected)?;
    let result: Vec[core::ConstExpr] = Vec::with_capacity(values.len());
    for value in values {
        result.push(artifact_decode_const_expr(context, value)?)
    }
    Result::Ok(result)
}

fn artifact_decode_const_expr_array_field(
    context: ArtifactCoreDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    name: string,
) -> Result[Vec[core::ConstExpr], string] {
    artifact_decode_const_exprs(context, wire::artifact_json_required_field(object, name)?, name)
}

fn artifact_decode_const_expr(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::ConstExpr,
    string,
] {
    let variant = wire::artifact_json_object(value, "constant expression")?;
    if variant.len() != 1 {
        return Result::Err(wire::artifact_decode_error("constant expression variant"))
    }
    let kind = variant[0].0;
    let object = wire::artifact_json_object(variant[0].1, "constant expression payload")?;
    let ty = artifact_decode_core_type_field(context, object, "ty")?;
    if kind == "CPrim" {
        let value = wire::artifact_json_required_field(object, "value")?;
        let primitive = core::lower_primitive(artifact_decode_primitive(value)?);
        Result::Ok(core::ConstExpr::Prim { value: primitive, ty })
    } else if kind == "CRef" {
        let name = wire::artifact_json_field_string(object, "name")?;
        Result::Ok(core::ConstExpr::Ref { name, ty })
    } else if kind == "CUnary" {
        let value = wire::artifact_json_field_string(object, "op")?;
        let op = artifact_decode_unary(value)?;
        let expr = artifact_decode_const_expr_field(context, object, "expr")?;
        Result::Ok(core::ConstExpr::Unary { op, expr, ty })
    } else if kind == "CCast" {
        let expr = artifact_decode_const_expr_field(context, object, "expr")?;
        Result::Ok(core::ConstExpr::Cast { expr, ty })
    } else if kind == "CBinary" {
        let value = wire::artifact_json_field_string(object, "op")?;
        let op = artifact_decode_binary(value)?;
        let lhs = artifact_decode_const_expr_field(context, object, "lhs")?;
        let rhs = artifact_decode_const_expr_field(context, object, "rhs")?;
        Result::Ok(core::ConstExpr::Binary { op, lhs, rhs, ty })
    } else if kind == "CTuple" {
        Result::Ok(
            core::ConstExpr::Tuple {
                items: artifact_decode_const_expr_array_field(context, object, "items")?,
                ty,
            },
        )
    } else if kind == "CArray" {
        Result::Ok(
            core::ConstExpr::Array {
                items: artifact_decode_const_expr_array_field(context, object, "items")?,
                ty,
            },
        )
    } else if kind == "CConstr" {
        let constructor = core::lower_constructor(
            artifact_decode_constructor(
                context,
                wire::artifact_json_required_field(object, "constructor")?,
            )?,
        );
        let args = artifact_decode_const_expr_array_field(context, object, "args")?;
        Result::Ok(core::ConstExpr::Constr { constructor, args, ty })
    } else if kind == "CError" {
        Result::Ok(core::ConstExpr::Error { ty })
    } else {
        Result::Err(wire::artifact_decode_error("constant expression"))
    }
}

fn artifact_decode_constant(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::Constant,
    string,
] {
    let object = wire::artifact_json_object(value, "constant")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    let ty = artifact_decode_core_type_field(context, object, "ty")?;
    let value = artifact_decode_const_expr_field(context, object, "value")?;
    Result::Ok(core::Constant { name, ty, value })
}

fn artifact_decode_static(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::Static,
    string,
] {
    let object = wire::artifact_json_object(value, "static")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    let ty = artifact_decode_core_type_field(context, object, "ty")?;
    Result::Ok(core::Static { name, ty })
}

fn artifact_decode_core_file(context: ArtifactCoreDecodeContext, value: wire::ArtifactValue) -> Result[
    core::File,
    string,
] {
    let object = wire::artifact_json_object(value, "Core file")?;
    let values = wire::artifact_json_field_array(object, "toplevels")?;
    let functions: Vec[core::Function] = Vec::new();
    for value in values {
        functions.push(artifact_decode_core_function(context, value)?)
    }
    let constant_values = wire::artifact_json_field_array(object, "constants")?;
    let constants: Vec[core::Constant] = Vec::new();
    for value in constant_values {
        constants.push(artifact_decode_constant(context, value)?)
    }
    let statics: Vec[core::Static] = Vec::new();
    if let Some(value) = wire::artifact_json_optional_field(object, "statics")? {
        for value in wire::artifact_json_array(value, "statics")? {
            statics.push(artifact_decode_static(context, value)?)
        }
    }
    Result::Ok(
        core::File {
            functions,
            enums: core::lower_enum_defs(context.enums),
            structs: core::lower_struct_defs(context.structs),
            type_instances: Vec::new(),
            constants,
            statics,
        },
    )
}
