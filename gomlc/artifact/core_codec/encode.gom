package core_codec;

use module::artifact::wire as wire;
use module::artifact::tast_codec as tast_codec;
use module::artifact::interface_codec as interface_codec;
use module::ast;
use module::core;
use module::tast;
use std::text;

fn artifact_json_core_type(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Type,
) -> () {
    tast_codec::artifact_json_type(writer, context, core::type_to_tast(value))
}

fn artifact_json_core_trait_ref(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::TraitRef,
) -> () {
    tast_codec::artifact_json_trait_ref(writer, context, core::trait_ref_to_tast(value))
}

fn artifact_json_core_predicate(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::TypePredicate,
) -> () {
    tast_codec::artifact_json_type_predicate(writer, context, core::predicate_to_tast(value))
}

fn artifact_float_number(value: string) -> string {
    if value.contains(".") || value.contains("e") || value.contains("E") {
        value
    } else {
        value + ".0"
    }
}

fn artifact_json_primitive_value(
    writer: wire::ArtifactJsonWriter,
    kind: string,
    value: string,
    quoted: bool,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, kind);
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "value");
    if quoted {
        wire::artifact_json_string(writer, value)
    } else {
        wire::artifact_json_number(writer, value)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

fn artifact_integer_kind(value: core::Type) -> string {
    match core::resolve_type(value) {
        Int => "Int",
        Int8 => "Int8",
        Int16 => "Int16",
        Int32 => "Int32",
        Int64 => "Int64",
        Uint => "UInt",
        Uint8 => "UInt8",
        Uint16 => "UInt16",
        Uint32 => "UInt32",
        Uint64 => "UInt64",
        _ => {
            fail("error[compile]: invalid integer type in compiler artifact");
            "Int32"
        },
    }
}

fn artifact_float_kind(value: core::Type) -> string {
    match core::resolve_type(value) {
        Float32 => "Float32",
        Float64 => "Float64",
        _ => {
            fail("error[compile]: invalid float type in compiler artifact");
            "Float64"
        },
    }
}

fn artifact_json_primitive(writer: wire::ArtifactJsonWriter, value: core::Primitive, ty: core::Type) -> () {
    match value {
        Unit => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "Unit");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            wire::artifact_json_null(writer);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Bool { value } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "Bool");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            wire::artifact_json_bool(writer, value);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Int { value } => artifact_json_primitive_value(
            writer,
            artifact_integer_kind(ty),
            value,
            false,
        ),
        Int8 { value } => artifact_json_primitive_value(writer, "Int8", value, false),
        Int16 { value } => artifact_json_primitive_value(writer, "Int16", value, false),
        Int32 { value } => artifact_json_primitive_value(writer, "Int32", value, false),
        Int64 { value } => artifact_json_primitive_value(writer, "Int64", value, false),
        Uint { value } => artifact_json_primitive_value(writer, "UInt", value, false),
        Uint8 { value } => artifact_json_primitive_value(writer, "UInt8", value, false),
        Uint16 { value } => artifact_json_primitive_value(writer, "UInt16", value, false),
        Uint32 { value } => artifact_json_primitive_value(writer, "UInt32", value, false),
        Uint64 { value } => artifact_json_primitive_value(writer, "UInt64", value, false),
        Float { value } => artifact_json_primitive_value(
            writer,
            artifact_float_kind(ty),
            artifact_float_number(value),
            false,
        ),
        Float32 { value } => artifact_json_primitive_value(
            writer,
            "Float32",
            artifact_float_number(value),
            false,
        ),
        Float64 { value } => artifact_json_primitive_value(
            writer,
            "Float64",
            artifact_float_number(value),
            false,
        ),
        String { value } => artifact_json_primitive_value(writer, "String", value, true),
        Char { value } => artifact_json_primitive_value(writer, "Char", value.to_string(), true),
        Bytes { values } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "Bytes");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            tast_codec::artifact_json_string_array(writer, values);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
    }
}

pub fn artifact_constructor_separator(value: string) -> isize {
    let mut result = -1;
    if value.byte_len() > 1 {
        for index in 0..value.byte_len() - 1 {
            if text::starts_with_at(value, index, "::") {
                result = index;
            }
        }
    }
    result
}

fn artifact_json_constructor(writer: wire::ArtifactJsonWriter, value: core::Constructor) -> () {
    wire::artifact_json_begin_object(writer);
    if value.is_struct {
        wire::artifact_json_name(writer, "Struct");
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "type_name");
        wire::artifact_json_string(writer, value.name);
        wire::artifact_json_end_object(writer)
    } else {
        let separator = artifact_constructor_separator(value.name);
        if separator < 0 {
            fail("error[compile]: invalid enum constructor in compiler artifact")
        }
        wire::artifact_json_name(writer, "Enum");
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "type_name");
        wire::artifact_json_string(writer, value.name.byte_slice(0, separator));
        wire::artifact_json_name(writer, "variant");
        wire::artifact_json_string(
            writer,
            value.name.byte_slice(separator + 2, value.name.byte_len()),
        );
        wire::artifact_json_name(writer, "index");
        wire::artifact_json_number(
            writer,
            match value.tag {
                Some(value) => value.to_string(),
                None => {
                    fail("error[compile]: missing enum tag in compiler artifact");
                    "0"
                },
            },
        );
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_unary_name(value: ast::UnaryOp) -> string {
    match value {
        Neg => "Neg",
        Not => "Not",
        BitNot => "BitNot",
    }
}

fn artifact_binary_name(value: ast::BinaryOp) -> string {
    match value {
        Add => "Add",
        Sub => "Sub",
        Mul => "Mul",
        Div => "Div",
        Rem => "Rem",
        BitAnd => "BitAnd",
        BitOr => "BitOr",
        BitXor => "BitXor",
        Shl => "Shl",
        Shr => "Shr",
        And => "And",
        Or => "Or",
        Less => "Less",
        Greater => "Greater",
        LessEq => "LessEq",
        GreaterEq => "GreaterEq",
        Eq => "Eq",
        NotEq => "NotEq",
    }
}

fn artifact_json_core_expr_array(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::Expr],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_core_expr(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_optional_core_expr(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: Option[core::Expr],
) -> () {
    match value {
        Some(value) => artifact_json_core_expr(writer, context, value),
        None => wire::artifact_json_null(writer),
    }
}

fn artifact_json_closure_params(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::ClosureParam],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, value.name);
        wire::artifact_json_name(writer, "ty");
        artifact_json_core_type(writer, context, value.ty);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_arms(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::Arm],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "lhs");
        artifact_json_core_expr(writer, context, value.lhs);
        wire::artifact_json_name(writer, "body");
        artifact_json_core_expr(writer, context, value.body);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_select_arms(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::SelectArm],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        match value {
            Receive { channel, guard, binding, binding_ty, body } => {
                wire::artifact_json_name(writer, "kind");
                wire::artifact_json_string(writer, "receive");
                wire::artifact_json_name(writer, "channel");
                artifact_json_core_expr(writer, context, channel);
                wire::artifact_json_name(writer, "guard");
                artifact_json_optional_core_expr(writer, context, guard);
                wire::artifact_json_name(writer, "binding");
                wire::artifact_json_string(writer, binding);
                wire::artifact_json_name(writer, "binding_ty");
                artifact_json_core_type(writer, context, binding_ty);
                wire::artifact_json_name(writer, "body");
                artifact_json_core_expr(writer, context, body)
            },
            Send { channel, value, guard, body } => {
                wire::artifact_json_name(writer, "kind");
                wire::artifact_json_string(writer, "send");
                wire::artifact_json_name(writer, "channel");
                artifact_json_core_expr(writer, context, channel);
                wire::artifact_json_name(writer, "value");
                artifact_json_core_expr(writer, context, value);
                wire::artifact_json_name(writer, "guard");
                artifact_json_optional_core_expr(writer, context, guard);
                wire::artifact_json_name(writer, "body");
                artifact_json_core_expr(writer, context, body)
            },
        }
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_expr(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Expr,
) -> () {
    wire::artifact_json_begin_object(writer);
    match value {
        Var { name, ty } => {
            wire::artifact_json_name(writer, "EVar");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Callable { callable, ty } => {
            match callable {
                core::Callable::FunctionInstance { name, bindings } => {
                    wire::artifact_json_name(writer, "EFunctionInstance");
                    wire::artifact_json_begin_object(writer);
                    wire::artifact_json_name(writer, "name");
                    wire::artifact_json_string(writer, name);
                    wire::artifact_json_name(writer, "bindings");
                    wire::artifact_json_begin_array(writer);
                    for binding in bindings {
                        wire::artifact_json_begin_object(writer);
                        wire::artifact_json_name(writer, "name");
                        wire::artifact_json_string(writer, binding.0);
                        wire::artifact_json_name(writer, "ty");
                        artifact_json_core_type(writer, context, binding.1);
                        wire::artifact_json_end_object(writer)
                    }
                    wire::artifact_json_end_array(writer)
                },
                core::Callable::LangItem { item, function_name } => {
                    wire::artifact_json_name(writer, "ELangItemCallable");
                    wire::artifact_json_begin_object(writer);
                    wire::artifact_json_name(writer, "item");
                    wire::artifact_json_string(writer, item);
                    wire::artifact_json_name(writer, "function_name");
                    wire::artifact_json_string(writer, function_name)
                },
                core::Callable::TraitMethod { trait_ref, method_name, for_ty, has_receiver } => {
                    wire::artifact_json_name(writer, "ETraitCallable");
                    wire::artifact_json_begin_object(writer);
                    wire::artifact_json_name(writer, "trait_ref");
                    artifact_json_core_trait_ref(writer, context, trait_ref);
                    wire::artifact_json_name(writer, "method_name");
                    wire::artifact_json_string(writer, method_name);
                    wire::artifact_json_name(writer, "for_ty");
                    artifact_json_core_type(writer, context, for_ty);
                    wire::artifact_json_name(writer, "has_receiver");
                    wire::artifact_json_bool(writer, has_receiver)
                },
                core::Callable::DynTraitMethod { trait_name, dispatch_name, method_name } => {
                    wire::artifact_json_name(writer, "EDynTraitCallable");
                    wire::artifact_json_begin_object(writer);
                    wire::artifact_json_name(writer, "trait_name");
                    wire::artifact_json_string(writer, trait_name);
                    wire::artifact_json_name(writer, "dispatch_name");
                    wire::artifact_json_string(writer, dispatch_name);
                    wire::artifact_json_name(writer, "method_name");
                    wire::artifact_json_string(writer, method_name)
                },
                core::Callable::InherentMethod { receiver_ty, method_name } => {
                    wire::artifact_json_name(writer, "EInherentCallable");
                    wire::artifact_json_begin_object(writer);
                    wire::artifact_json_name(writer, "receiver_ty");
                    artifact_json_core_type(writer, context, receiver_ty);
                    wire::artifact_json_name(writer, "method_name");
                    wire::artifact_json_string(writer, method_name)
                },
                other => {
                    wire::artifact_json_name(writer, "ECallable");
                    wire::artifact_json_begin_object(writer);
                    let callable = tast_codec::artifact_callable(core::callable_to_tast(other));
                    wire::artifact_json_name(writer, "name");
                    wire::artifact_json_string(writer, callable.name);
                    wire::artifact_json_name(writer, "body");
                    tast_codec::artifact_json_callable_body(writer, callable)
                },
            }
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Prim { value, ty } => {
            wire::artifact_json_name(writer, "EPrim");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            artifact_json_primitive(writer, value, ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Constr { constructor, args, ty } => {
            wire::artifact_json_name(writer, "EConstr");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "constructor");
            artifact_json_constructor(writer, constructor);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Tuple { items, ty } => {
            wire::artifact_json_name(writer, "ETuple");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_core_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Array { items, ty } => {
            wire::artifact_json_name(writer, "EArray");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_core_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Closure { params, body, ty } => {
            wire::artifact_json_name(writer, "EClosure");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "params");
            artifact_json_closure_params(writer, context, params);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Block { block, ty } => {
            wire::artifact_json_name(writer, "EBlock");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "block");
            artifact_json_core_block(writer, context, block);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Match { expr, arms, default, ty } => {
            wire::artifact_json_name(writer, "EMatch");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "arms");
            artifact_json_core_arms(writer, context, arms);
            wire::artifact_json_name(writer, "default");
            artifact_json_optional_core_expr(writer, context, default);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Select { mode, arms, default, ty } => {
            wire::artifact_json_name(writer, "ESelect");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "mode");
            wire::artifact_json_string(
                writer,
                match mode {
                    ast::SelectMode::Normal => "normal",
                    ast::SelectMode::Priority => "priority",
                },
            );
            wire::artifact_json_name(writer, "arms");
            artifact_json_core_select_arms(writer, context, arms);
            wire::artifact_json_name(writer, "default");
            artifact_json_optional_core_expr(writer, context, default);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        If { cond, then_branch, else_branch, ty } => {
            wire::artifact_json_name(writer, "EIf");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "cond");
            artifact_json_core_expr(writer, context, cond);
            wire::artifact_json_name(writer, "then_branch");
            artifact_json_core_expr(writer, context, then_branch);
            wire::artifact_json_name(writer, "else_branch");
            artifact_json_core_expr(writer, context, else_branch);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        While { cond, body, ty } => {
            wire::artifact_json_name(writer, "EWhile");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "cond");
            artifact_json_core_expr(writer, context, cond);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Loop { body, ty } => {
            wire::artifact_json_name(writer, "ELoop");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "body");
            artifact_json_core_expr(writer, context, body);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Break { target, value, ty } => {
            wire::artifact_json_name(writer, "EBreak");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "target");
            wire::artifact_json_number(writer, target.to_string());
            wire::artifact_json_name(writer, "value");
            artifact_json_optional_core_expr(writer, context, value);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Continue { target, ty } => {
            wire::artifact_json_name(writer, "EContinue");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "target");
            wire::artifact_json_number(writer, target.to_string());
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Return { expr, ty } => {
            wire::artifact_json_name(writer, "EReturn");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_optional_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Go { expr, ty } => {
            wire::artifact_json_name(writer, "EGo");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        ConstrGet { expr, constructor, field_index, ty } => {
            wire::artifact_json_name(writer, "EConstrGet");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "constructor");
            artifact_json_constructor(writer, constructor);
            wire::artifact_json_name(writer, "field_index");
            wire::artifact_json_number(writer, field_index.to_string());
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Unary { op, expr, ty } => {
            wire::artifact_json_name(writer, "EUnary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_unary_name(op));
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Cast { expr, ty } => {
            wire::artifact_json_name(writer, "ECast");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Binary { op, lhs, rhs, ty } => {
            wire::artifact_json_name(writer, "EBinary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_binary_name(op));
            wire::artifact_json_name(writer, "lhs");
            artifact_json_core_expr(writer, context, lhs);
            wire::artifact_json_name(writer, "rhs");
            artifact_json_core_expr(writer, context, rhs);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Assign { name, value, target_ty, ty } => {
            wire::artifact_json_name(writer, "EAssign");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "value");
            artifact_json_core_expr(writer, context, value);
            wire::artifact_json_name(writer, "target_ty");
            artifact_json_core_type(writer, context, target_ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Call { func, args, ty } => {
            wire::artifact_json_name(writer, "ECall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "func");
            artifact_json_core_expr(writer, context, func);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        ToDyn { trait_name, for_ty, expr, ty } => {
            wire::artifact_json_name(writer, "EToDyn");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_name");
            wire::artifact_json_string(writer, trait_name);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_core_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "expr");
            artifact_json_core_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            wire::artifact_json_name(writer, "EDynCall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_name");
            wire::artifact_json_string(writer, trait_name);
            wire::artifact_json_name(writer, "method_name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "receiver");
            artifact_json_core_expr(writer, context, receiver);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        TraitCall { trait_ref, method_name, for_ty, receiver, args, ty, .. } => {
            wire::artifact_json_name(writer, "ETraitCall");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_core_trait_ref(writer, context, trait_ref);
            wire::artifact_json_name(writer, "method_name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_core_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "receiver");
            artifact_json_optional_core_expr(writer, context, receiver);
            wire::artifact_json_name(writer, "args");
            artifact_json_core_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Proj { tuple, index, ty } => {
            wire::artifact_json_name(writer, "EProj");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "tuple");
            artifact_json_core_expr(writer, context, tuple);
            wire::artifact_json_name(writer, "index");
            wire::artifact_json_number(writer, index.to_string());
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_core_block(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Block,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "stmts");
    wire::artifact_json_begin_array(writer);
    for statement in value.stmts {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, statement.name);
        wire::artifact_json_name(writer, "value");
        artifact_json_core_expr(writer, context, statement.value);
        wire::artifact_json_name(writer, "ty");
        artifact_json_core_type(writer, context, statement.ty);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "tail");
    artifact_json_optional_core_expr(writer, context, value.tail);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_core_trait_impl(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: Option[core::TraitImpl],
) -> () {
    match value {
        Some(value) => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_core_trait_ref(writer, context, value.trait_ref);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_core_type(writer, context, value.for_ty);
            wire::artifact_json_name(writer, "generic_count");
            wire::artifact_json_number(writer, value.generic_count.to_string());
            wire::artifact_json_name(writer, "predicate_count");
            wire::artifact_json_number(writer, value.predicate_count.to_string());
            wire::artifact_json_end_object(writer)
        },
        None => wire::artifact_json_null(writer),
    }
}

fn artifact_json_core_params(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[(string, core::Type)],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_array(writer);
        wire::artifact_json_string(writer, value.0);
        artifact_json_core_type(writer, context, value.1);
        wire::artifact_json_end_array(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_predicates(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::TypePredicate],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_core_predicate(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_core_function_origin(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::FunctionOrigin,
) -> () {
    wire::artifact_json_begin_object(writer);
    match value {
        Source => {
            wire::artifact_json_name(writer, "Source");
            wire::artifact_json_null(writer)
        },
        Inherent { owner, method_name } => {
            wire::artifact_json_name(writer, "Inherent");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "owner");
            artifact_json_core_type(writer, context, owner);
            wire::artifact_json_name(writer, "method_name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_end_object(writer)
        },
        TraitImplementation { method_name } => {
            wire::artifact_json_name(writer, "TraitImplementation");
            wire::artifact_json_string(writer, method_name)
        },
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_core_function(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Function,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "origin");
    artifact_json_core_function_origin(writer, context, value.origin);
    wire::artifact_json_name(writer, "root");
    wire::artifact_json_bool(writer, value.root);
    wire::artifact_json_name(writer, "generics");
    tast_codec::artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "predicates");
    artifact_json_core_predicates(writer, context, value.predicates);
    wire::artifact_json_name(writer, "trait_impl");
    artifact_json_core_trait_impl(writer, context, value.trait_impl);
    wire::artifact_json_name(writer, "params");
    artifact_json_core_params(writer, context, value.params);
    wire::artifact_json_name(writer, "ret_ty");
    artifact_json_core_type(writer, context, value.ret_ty);
    wire::artifact_json_name(writer, "body");
    artifact_json_core_block(writer, context, value.body);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_const_expr(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::ConstExpr,
) -> () {
    wire::artifact_json_begin_object(writer);
    match value {
        Prim { value, ty } => {
            wire::artifact_json_name(writer, "CPrim");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "value");
            artifact_json_primitive(writer, value, ty);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Ref { name, ty } => {
            wire::artifact_json_name(writer, "CRef");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Unary { op, expr, ty } => {
            wire::artifact_json_name(writer, "CUnary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_unary_name(op));
            wire::artifact_json_name(writer, "expr");
            artifact_json_const_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Cast { expr, ty } => {
            wire::artifact_json_name(writer, "CCast");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "expr");
            artifact_json_const_expr(writer, context, expr);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Binary { op, lhs, rhs, ty } => {
            wire::artifact_json_name(writer, "CBinary");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "op");
            wire::artifact_json_string(writer, artifact_binary_name(op));
            wire::artifact_json_name(writer, "lhs");
            artifact_json_const_expr(writer, context, lhs);
            wire::artifact_json_name(writer, "rhs");
            artifact_json_const_expr(writer, context, rhs);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Tuple { items, ty } => {
            wire::artifact_json_name(writer, "CTuple");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_const_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Array { items, ty } => {
            wire::artifact_json_name(writer, "CArray");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "items");
            artifact_json_const_expr_array(writer, context, items);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Constr { constructor, args, ty } => {
            wire::artifact_json_name(writer, "CConstr");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "constructor");
            artifact_json_constructor(writer, constructor);
            wire::artifact_json_name(writer, "args");
            artifact_json_const_expr_array(writer, context, args);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
        Error { ty } => {
            wire::artifact_json_name(writer, "CError");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "ty");
            artifact_json_core_type(writer, context, ty);
            wire::artifact_json_end_object(writer)
        },
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_const_expr_array(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[core::ConstExpr],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_const_expr(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_constant(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Constant,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "ty");
    artifact_json_core_type(writer, context, value.ty);
    wire::artifact_json_name(writer, "value");
    artifact_json_const_expr(writer, context, value.value);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_static(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::Static,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "ty");
    artifact_json_core_type(writer, context, value.ty);
    wire::artifact_json_end_object(writer)
}

pub fn write_core_file(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: core::File,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "toplevels");
    wire::artifact_json_begin_array(writer);
    for function in value.functions {
        artifact_json_core_function(writer, context, function)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "constants");
    wire::artifact_json_begin_array(writer);
    for value in value.constants {
        artifact_json_constant(writer, context, value)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "statics");
    wire::artifact_json_begin_array(writer);
    for value in value.statics {
        artifact_json_static(writer, context, value)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}
