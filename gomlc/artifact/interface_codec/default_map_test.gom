package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;
use std::testing;

#[test]
fn default_map_requirements_reject_invalid_method_metadata() -> () {
    let context = tast_codec::new_artifact_decode_context();
    let key = wire::ArtifactValue::Array(Vec::from_array([wire::ArtifactValue::String("TInt64")]));
    let methods = Vec::from_array(
        [
            artifact::ArtifactFnScheme {
                name: "size",
                comptime: tast::ComptimeCapability::RuntimeOnly,
                type_params: Vec::new(),
                constraints: Vec::new(),
                ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Int },
                body: tast::Callable::Function("trait_default#Size#size"),
            },
        ],
    );
    for entries in Vec::from_array(
        [
            Vec::from_array([("missing", key)]),
            Vec::from_array([("size", key), ("size", key)]),
            Vec::from_array([("size", wire::ArtifactValue::Bool(true))]),
            Vec::from_array(
                [
                    (
                        "size",
                        wire::ArtifactValue::Array(
                            Vec::from_array([wire::ArtifactValue::Bool(false)]),
                        ),
                    ),
                ],
            ),
        ],
    ) {
        testing::assert(
            artifact_decode_default_map_requirements(
                context,
                Vec::from_array(
                    [("default_map_requirements", wire::ArtifactValue::Object(entries))],
                ),
                methods,
            ).is_err(),
        );
    }
    let object = Vec::from_array(
        [
            (
                "default_map_requirements",
                wire::ArtifactValue::Object(Vec::from_array([("size", key)])),
            ),
        ],
    );
    let Ok(decoded) = artifact_decode_default_map_requirements(context, object, methods) else {
        testing::fail("valid default map requirements were rejected");
        return
    };
    testing::assert_eq(decoded.len(), 1);
    testing::assert_eq(decoded[0].0, "size");
    testing::assert(tast::types_equal(decoded[0].1[0], tast::Type::Int64));
    let method = methods[0];
    testing::assert(
        artifact_decode_default_map_requirements(
            context,
            object,
            Vec::from_array(
                [
                    artifact::ArtifactFnScheme {
                        name: method.name,
                        comptime: method.comptime,
                        type_params: method.type_params,
                        constraints: method.constraints,
                        ty: method.ty,
                        body: tast::Callable::Function(method.name),
                    },
                ],
            ),
        ).is_err(),
    );
}
