package interface_codec;

use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn associated_constant_dependencies_preserve_private_generic_edges() -> () {
    let parameter = tast::Type::Param { name: "T" };
    let trait_ref = tast::TraitRef { name: "audit::Value", args: Vec::from_array([parameter]) };
    let value = tast::AssociatedConstantDependencies {
        name: "audit::$associated_const:PRIVATE",
        owner: Some(parameter),
        trait_ref: Some(trait_ref),
        generics: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::Trait { for_ty: parameter, trait_ref }]),
        calls: Vec::from_array(
            [
                tast::Callable::Function("audit::$associated_const:helper"),
                tast::Callable::FunctionInstance {
                    name: "audit::$associated_const:generic",
                    bindings: Vec::from_array([("U", parameter)]),
                },
                tast::Callable::InherentMethod {
                    receiver_ty: parameter,
                    method_name: "$associated_const:A",
                },
                tast::Callable::TraitMethod {
                    for_ty: parameter,
                    trait_ref,
                    method_name: "$associated_const:B",
                    has_receiver: false,
                },
            ],
        ),
    };
    let exports = empty_exports();
    exports.associated_constants.push(value);
    exports.associated_constants.push(
        tast::AssociatedConstantDependencies {
            name: "audit::$associated_const:default",
            owner: None,
            trait_ref: None,
            generics: Vec::new(),
            predicates: Vec::new(),
            calls: Vec::new(),
        },
    );
    let writer = wire::new_artifact_value_writer();
    write_exports(writer, artifact_exports_type_context(exports), exports);
    let encoded = testing::expect_ok(
        wire::artifact_value_finish(writer),
        "encode constant dependencies",
    );
    let decoded = testing::expect_ok(decode_exports(encoded), "decode constant dependencies");
    testing::assert_eq(decoded.associated_constants.len(), 2);
    let actual = decoded.associated_constants[0];
    testing::assert_eq(actual.name, value.name);
    testing::assert_eq(actual.generics[0], "T");
    match actual.owner {
        Some(owner) => testing::assert(tast::types_equal(owner, parameter)),
        None => testing::fail("constant owner lost"),
    }
    match actual.trait_ref {
        Some(reference) => testing::assert(tast::types_equal(reference.args[0], parameter)),
        None => testing::fail("constant trait lost"),
    }
    testing::assert_eq(actual.predicates.len(), 1);
    match actual.predicates[0] {
        Trait { for_ty: ty, trait_ref: actual_trait } => {
            testing::assert(tast::types_equal(ty, parameter));
            testing::assert_eq(actual_trait.name, trait_ref.name);
        },
        _ => testing::fail("constant predicate lost"),
    }
    testing::assert_eq(actual.calls.len(), 4);
    match actual.calls[0] {
        Function(name) => testing::assert_eq(name, "audit::$associated_const:helper"),
        _ => testing::fail("helper call lost"),
    }
    match actual.calls[1] {
        FunctionInstance { name, bindings } => {
            testing::assert_eq(name, "audit::$associated_const:generic");
            testing::assert_eq(bindings[0].0, "U");
            testing::assert(tast::types_equal(bindings[0].1, parameter));
        },
        _ => testing::fail("instance bindings lost"),
    }
    match actual.calls[2] {
        InherentMethod { receiver_ty, method_name } => {
            testing::assert(tast::types_equal(receiver_ty, parameter));
            testing::assert_eq(method_name, "$associated_const:A");
        },
        _ => testing::fail("inherent edge lost"),
    }
    match actual.calls[3] {
        TraitMethod { for_ty, trait_ref: actual_trait, method_name, has_receiver } => {
            testing::assert(tast::types_equal(for_ty, parameter));
            testing::assert(tast::types_equal(actual_trait.args[0], parameter));
            testing::assert_eq(method_name, "$associated_const:B");
            testing::assert(!has_receiver);
        },
        _ => testing::fail("trait edge lost"),
    }
    testing::assert(decoded.associated_constants[1].owner.is_none());
    testing::assert(decoded.associated_constants[1].trait_ref.is_none());
    testing::assert(decoded.functions.is_empty());
}
