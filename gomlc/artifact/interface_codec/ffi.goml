package interface_codec;

use module::artifact::wire as wire;
use module::ffi;

fn write_foreign_type(writer: wire::ArtifactJsonWriter, value: ffi::BridgeType) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "tag");
    match value {
        Function { parameters, results } => {
            wire::artifact_json_string(writer, "function");
            wire::artifact_json_name(writer, "signature");
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "parameters");
            write_foreign_types(writer, parameters);
            wire::artifact_json_name(writer, "results");
            write_foreign_types(writer, results);
            wire::artifact_json_end_object(writer)
        },
        Named { import_path, name, arguments } => {
            wire::artifact_json_string(writer, "named");
            wire::artifact_json_name(writer, "import_path");
            wire::artifact_json_string(writer, import_path);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "type_arguments");
            write_foreign_types(writer, arguments)
        },
        Scalar(tag) => wire::artifact_json_string(writer, tag),
        Array { element, length } => {
            wire::artifact_json_string(writer, "array");
            wire::artifact_json_name(writer, "element");
            write_foreign_type(writer, element);
            wire::artifact_json_name(writer, "length");
            wire::artifact_json_number(writer, length.to_string())
        },
        Pointer { element } => {
            wire::artifact_json_string(writer, "pointer");
            wire::artifact_json_name(writer, "element");
            write_foreign_type(writer, element)
        },
        Slice { element } => {
            wire::artifact_json_string(writer, "slice");
            wire::artifact_json_name(writer, "element");
            write_foreign_type(writer, element)
        },
        Map { key, element } => {
            wire::artifact_json_string(writer, "map");
            wire::artifact_json_name(writer, "key");
            write_foreign_type(writer, key);
            wire::artifact_json_name(writer, "element");
            write_foreign_type(writer, element)
        },
        Channel { element, direction } => {
            wire::artifact_json_string(writer, "channel");
            wire::artifact_json_name(writer, "element");
            write_foreign_type(writer, element);
            wire::artifact_json_name(writer, "direction");
            wire::artifact_json_string(writer, direction)
        },
    }
    wire::artifact_json_end_object(writer)
}

fn write_foreign_types(writer: wire::ArtifactJsonWriter, values: Vec[ffi::BridgeType]) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        write_foreign_type(writer, value)
    }
    wire::artifact_json_end_array(writer)
}

fn write_foreign_bindings(writer: wire::ArtifactJsonWriter, values: Vec[ffi::ForeignBinding]) -> () {
    let names: Vec[string] = Vec::new();
    for value in values {
        names.push(value.binding_id)
    }
    wire::artifact_json_begin_array(writer);
    for name in wire::sort_artifact_names(names) {
        for value in values {
            if value.binding_id == name {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "binding_id");
                wire::artifact_json_string(writer, value.binding_id);
                wire::artifact_json_name(writer, "import_path");
                wire::artifact_json_string(writer, value.import_path);
                wire::artifact_json_name(writer, "symbol");
                wire::artifact_json_string(writer, value.symbol);
                if value.call_mode != ffi::ForeignCallMode::Ordinary {
                    wire::artifact_json_name(writer, "call_mode");
                    wire::artifact_json_string(writer, ffi::foreign_call_mode_name(value.call_mode))
                }
                wire::artifact_json_name(writer, "parameters");
                write_foreign_types(writer, value.parameters);
                wire::artifact_json_name(writer, "results");
                write_foreign_types(writer, value.results);
                wire::artifact_json_end_object(writer)
            }
        }
    }
    wire::artifact_json_end_array(writer)
}

fn decode_foreign_type(value: wire::ArtifactValue, direct: bool, depth: isize, nodes: Ref[isize]) -> Result[
    ffi::BridgeType,
    string,
] {
    nodes.set(nodes.get() + 1);
    if depth > 64 || nodes.get() > 65536 {
        return Result::Err("foreign binding type complexity limit exceeded")
    }
    let object = wire::artifact_json_object(value, "foreign type")?;
    let tag = wire::artifact_json_field_string(object, "tag")?;
    match tag {
        "bool" | "int" | "int8" | "int16" | "int32" | "int64" | "uint" | "uint8" | "uint16" | "uint32" | "uint64" | "float32" | "float64" | "string" => Result::Ok(
            ffi::BridgeType::Scalar(tag),
        ),
        "any" if direct => Result::Ok(ffi::BridgeType::Scalar(tag)),
        "function" => {
            for field in object {
                if field.0 != "tag" && field.0 != "signature" {
                    return Result::Err("unexpected foreign function type field")
                }
            }
            let signature = wire::artifact_json_object(
                wire::artifact_json_required_field(object, "signature")?,
                "foreign function signature",
            )?;
            for field in signature {
                if field.0 != "parameters" && field.0 != "results" {
                    return Result::Err("unexpected foreign function signature field")
                }
            }
            let parameters = Vec::new();
            let results = Vec::new();
            for value in wire::artifact_json_array(
                wire::artifact_json_required_field(signature, "parameters")?,
                "foreign function parameters",
            )? {
                parameters.push(decode_foreign_type(value, false, depth + 1, nodes)?)
            }
            for value in wire::artifact_json_array(
                wire::artifact_json_required_field(signature, "results")?,
                "foreign function results",
            )? {
                results.push(decode_foreign_type(value, false, depth + 1, nodes)?)
            }
            Result::Ok(ffi::BridgeType::Function { parameters, results })
        },
        "named" => {
            let import_path = wire::artifact_json_field_string(object, "import_path")?;
            let name = wire::artifact_json_field_string(object, "name")?;
            if !ffi::named_bridge_identity_valid(import_path, name) {
                return Result::Err("invalid named foreign binding type identity")
            }
            let values = wire::artifact_json_array(
                wire::artifact_json_required_field(object, "type_arguments")?,
                "foreign type arguments",
            )?;
            if import_path == "" && !values.is_empty() {
                return Result::Err("builtin Go error cannot have type arguments")
            }
            let arguments: Vec[ffi::BridgeType] = Vec::new();
            for value in values {
                arguments.push(decode_foreign_type(value, false, depth + 1, nodes)?)
            }
            Result::Ok(ffi::BridgeType::Named { import_path, name, arguments })
        },
        "map" => Result::Ok(
            ffi::BridgeType::Map {
                key: decode_foreign_type(
                    wire::artifact_json_required_field(object, "key")?,
                    false,
                    depth + 1,
                    nodes,
                )?,
                element: decode_foreign_type(
                    wire::artifact_json_required_field(object, "element")?,
                    false,
                    depth + 1,
                    nodes,
                )?,
            },
        ),
        "pointer" | "array" | "slice" | "channel" => {
            let element = decode_foreign_type(
                wire::artifact_json_required_field(object, "element")?,
                false,
                depth + 1,
                nodes,
            )?;
            if tag == "array" {
                let length = wire::artifact_parse_nonnegative_int(
                    wire::artifact_json_number_value(
                        wire::artifact_json_required_field(object, "length")?,
                        "foreign array length",
                    )?,
                )?;
                Result::Ok(ffi::BridgeType::Array { element, length })
            } else if tag == "pointer" {
                Result::Ok(ffi::BridgeType::Pointer { element })
            } else if tag == "slice" {
                Result::Ok(ffi::BridgeType::Slice { element })
            } else {
                let direction = wire::artifact_json_field_string(object, "direction")?;
                if direction != "both" && direction != "send" && direction != "receive" {
                    Result::Err("invalid foreign channel direction")
                } else {
                    Result::Ok(ffi::BridgeType::Channel { element, direction })
                }
            }
        },
        _ => Result::Err("unsupported foreign binding type tag " + tag),
    }
}

fn decode_foreign_types(values: Vec[wire::ArtifactValue], direct: bool, nodes: Ref[isize]) -> Result[
    Vec[ffi::BridgeType],
    string,
] {
    let result: Vec[ffi::BridgeType] = Vec::new();
    for value in values {
        result.push(decode_foreign_type(value, direct, 0, nodes)?)
    }
    Result::Ok(result)
}

fn decode_foreign_bindings(value: wire::ArtifactValue) -> Result[Vec[ffi::ForeignBinding], string] {
    let values = wire::artifact_json_array(value, "foreign bindings")?;
    if values.len() > 4096 {
        return Result::Err("foreign binding count limit exceeded")
    }
    let seen: HashMap[string, bool] = HashMap::new();
    let result: Vec[ffi::ForeignBinding] = Vec::new();
    let nodes = Ref::new(0);
    for value in values {
        let object = wire::artifact_json_object(value, "foreign binding")?;
        let binding_id = wire::artifact_json_field_string(object, "binding_id")?;
        if binding_id == "" || seen[binding_id].is_some() {
            return Result::Err("empty or duplicate foreign binding id")
        }
        seen[binding_id] = true;
        let parameters = wire::artifact_json_field_array(object, "parameters")?;
        let results = wire::artifact_json_field_array(object, "results")?;
        let call_mode = match wire::artifact_json_optional_field(object, "call_mode")? {
            Some(value) => ffi::parse_foreign_call_mode(
                wire::artifact_json_string_value(value, "foreign call mode")?,
            )?,
            None => ffi::ForeignCallMode::Ordinary,
        };
        let binding = ffi::ForeignBinding {
            call_mode,
            binding_id,
            import_path: wire::artifact_json_field_string(object, "import_path")?,
            symbol: wire::artifact_json_field_string(object, "symbol")?,
            parameters: decode_foreign_types(parameters, true, nodes)?,
            results: decode_foreign_types(results, results.len() == 1, nodes)?,
        };
        ffi::validate_foreign_binding_target(binding)?;
        result.push(binding)
    }
    Result::Ok(result)
}

pub fn write_foreign_type_metadata(
    writer: wire::ArtifactJsonWriter,
    value: Option[ffi::ForeignTypeMetadata],
) -> () {
    match value {
        None => wire::artifact_json_null(writer),
        Some(metadata) => wire::artifact_json_string(
            writer,
            ffi::foreign_type_metadata_text(metadata),
        ),
    }
}

pub fn decode_foreign_type_metadata(value: wire::ArtifactValue) -> Result[
    Option[ffi::ForeignTypeMetadata],
    string,
] {
    match value {
        wire::ArtifactValue::Null => Result::Ok(Option::None),
        wire::ArtifactValue::String(text) => Result::Ok(
            Option::Some(ffi::decode_foreign_type_metadata(text)?),
        ),
        _ => Result::Err("invalid external type metadata"),
    }
}
