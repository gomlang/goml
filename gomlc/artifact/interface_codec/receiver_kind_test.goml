package interface_codec;

use module::artifact;
use module::artifact::tast_codec;
use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn method_receiver_kinds_are_explicit_in_function_artifacts() -> () {
    let context = tast_codec::artifact_type_context(Vec::new(), Vec::new());
    for has_receiver in[false, true] {
        let scheme = artifact::ArtifactFnScheme {
            has_receiver,
            name: "read",
            comptime: tast::ComptimeCapability::RuntimeOnly,
            type_params: Vec::new(),
            constraints: Vec::new(),
            ty: tast::Type::Func {
                params: Vec::from_array([tast::Type::Int32]),
                ret_ty: tast::Type::Int32,
            },
            body: tast::Callable::Function("read"),
        };
        let writer = wire::new_artifact_value_writer();
        artifact_json_fn_scheme(writer, context, scheme);
        let value = testing::expect_ok(wire::artifact_value_finish(writer), "parse method scheme");
        let decoded = testing::expect_ok(
            artifact_decode_fn_scheme(tast_codec::new_artifact_decode_context(), "read", value),
            "decode method scheme",
        );
        testing::assert_eq(decoded.has_receiver, has_receiver);
    }
}

#[test]
fn receiver_metadata_requires_a_receiver_parameter() -> () {
    let scheme = artifact::ArtifactFnScheme {
        has_receiver: true,
        name: "read",
        comptime: tast::ComptimeCapability::RuntimeOnly,
        type_params: Vec::new(),
        constraints: Vec::new(),
        ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Int32 },
        body: tast::Callable::Function("read"),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_fn_scheme(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        scheme,
    );
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode invalid receiver");
    testing::assert(
        artifact_decode_fn_scheme(tast_codec::new_artifact_decode_context(), "read", encoded).is_err(),
    );
}

#[test]
fn receiver_metadata_is_required_and_boolean() -> () {
    let scheme = artifact::ArtifactFnScheme {
        has_receiver: false,
        name: "read",
        comptime: tast::ComptimeCapability::RuntimeOnly,
        type_params: Vec::new(),
        constraints: Vec::new(),
        ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Int32 },
        body: tast::Callable::Function("read"),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_fn_scheme(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        scheme,
    );
    let encoded = testing::expect_ok(
        wire::artifact_value_finish(writer),
        "encode receiver metadata",
    );
    let object = testing::expect_ok(wire::artifact_json_object(encoded, "scheme"), "read scheme");
    for malformed in[false, true] {
        let fields = Vec::new();
        for field in object {
            if field.0 != "has_receiver" {
                fields.push(field);
            } else if malformed {
                fields.push((field.0, wire::ArtifactValue::String("false")));
            }
        }
        testing::assert(
            artifact_decode_fn_scheme(
                tast_codec::new_artifact_decode_context(),
                "read",
                wire::ArtifactValue::Object(fields),
            ).is_err(),
        );
    }
}
