package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;
use std::testing;

#[test]
fn public_function_schemes_preserve_body_constant_validity() -> () {
    let length = tast::Type::App {
        ty: tast::Type::Con { name: "$const_op:-" },
        args: Vec::from_array([tast::Type::Param { name: "$const_param:N" }, tast::const_type(1)]),
    };
    let value = artifact::ArtifactFnScheme {
        name: "audit::construct",
        comptime: tast::ComptimeCapability::RuntimeOnly,
        type_params: Vec::from_array(["$const_param:N"]),
        constraints: Vec::from_array(
            [
                tast::TypePredicate::ConstValid {
                    ty: length,
                    origins: Vec::from_array(["audit::construct", "audit::forward"]),
                },
            ],
        ),
        ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Unit },
        body: tast::Callable::Function("audit::construct"),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_fn_scheme(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    );
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode public function");
    let decoded = testing::expect_ok(
        artifact_decode_fn_scheme(tast_codec::new_artifact_decode_context(), value.name, encoded),
        "decode public function",
    );
    testing::assert_eq(decoded.constraints.len(), 1);
    match decoded.constraints[0] {
        ConstValid { ty: actual, origins } => {
            testing::assert_eq(origins.len(), 2);
            testing::assert_eq(origins[0], "audit::construct");
            testing::assert_eq(origins[1], "audit::forward");
            testing::assert(tast::types_equal(actual, length));
            let specialized = tast::substitute_params(
                actual,
                decoded.type_params,
                Vec::from_array([tast::const_type(2)]),
            );
            testing::assert(tast::const_type_value(specialized) == Option::Some(1));
        },
        _ => testing::fail("body constant validity obligation was not retained"),
    }
    let type_writer = wire::new_artifact_value_writer();
    tast_codec::artifact_json_type(
        type_writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        length,
    );
    let encoded_type = testing::expect_ok(
        wire::artifact_value_finish(type_writer),
        "encode requirement type",
    );
    for payload in[
        wire::ArtifactValue::Array(Vec::new()),
        wire::ArtifactValue::Array(Vec::from_array([encoded_type])),
        wire::ArtifactValue::Array(Vec::from_array([encoded_type, wire::ArtifactValue::Bool(true)])),
    ] {
        let malformed = wire::ArtifactValue::Object(Vec::from_array([("ConstValid", payload)]));
        testing::assert(
            tast_codec::artifact_decode_predicate(
                tast_codec::new_artifact_decode_context(),
                malformed,
            ).is_err(),
        );
    }
    let invalid = wire::ArtifactValue::Object(
        Vec::from_array([("ConstValid", wire::ArtifactValue::Bool(true))]),
    );
    testing::assert(
        tast_codec::artifact_decode_predicate(tast_codec::new_artifact_decode_context(), invalid).is_err(),
    );
}
