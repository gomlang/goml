package interface_codec;

use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;

fn artifact_json_nominal_layouts(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[tast::NominalLayout],
) -> () {
    wire::artifact_json_begin_object(writer);
    for value in values {
        wire::artifact_json_name(writer, value.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "generics");
        tast_codec::artifact_json_string_array(writer, value.generics);
        wire::artifact_json_name(writer, "kind");
        wire::artifact_json_string(
            writer,
            match value.shape {
                Struct(_) => "struct",
                Enum(_) => "enum",
            },
        );
        wire::artifact_json_name(writer, "fields");
        match value.shape {
            Struct(fields) => tast_codec::artifact_json_type_array(writer, context, fields),
            Enum(variants) => {
                wire::artifact_json_begin_array(writer);
                for fields in variants {
                    tast_codec::artifact_json_type_array(writer, context, fields);
                }
                wire::artifact_json_end_array(writer);
            },
        }
        wire::artifact_json_end_object(writer);
    }
    wire::artifact_json_end_object(writer);
}

fn artifact_decode_nominal_layouts(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[tast::NominalLayout], string] {
    let entries = wire::artifact_json_object(value, "nominal layouts")?;
    let names = Vec::new();
    for entry in entries {
        if names.contains(entry.0) {
            return Err(wire::artifact_decode_error("unique nominal layout name"))
        }
        names.push(entry.0);
        let object = wire::artifact_json_object(entry.1, "nominal layout")?;
        match wire::artifact_json_field_string(object, "kind")? {
            "struct" => tast_codec::artifact_add_type_name(context.struct_names, entry.0),
            "enum" => tast_codec::artifact_add_type_name(context.enum_names, entry.0),
            _ => return Err(wire::artifact_decode_error("nominal layout kind")),
        }
    }
    let result = Vec::new();
    for entry in entries {
        let object = wire::artifact_json_object(entry.1, "nominal layout")?;
        let generics = wire::artifact_decode_string_array(
            wire::artifact_json_required_field(object, "generics")?,
            "nominal layout generics",
        )?;
        let fields = wire::artifact_json_required_field(object, "fields")?;
        let shape = match wire::artifact_json_field_string(object, "kind")? {
            "struct" => tast::NominalLayoutShape::Struct(
                tast_codec::artifact_decode_type_array(context, fields, "nominal struct fields")?,
            ),
            "enum" => {
                let variants = Vec::new();
                for variant in wire::artifact_json_array(fields, "nominal enum variants")? {
                    variants.push(
                        tast_codec::artifact_decode_type_array(
                            context,
                            variant,
                            "nominal enum fields",
                        )?,
                    );
                }
                tast::NominalLayoutShape::Enum(variants)
            },
            _ => return Err(wire::artifact_decode_error("nominal layout kind")),
        };
        result.push(tast::NominalLayout { name: entry.0, generics, shape });
    }
    Ok(result)
}
