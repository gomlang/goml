package interface_codec;

use module::artifact::wire as wire;
use module::artifact;
use module::artifact::tast_codec as tast_codec;
use module::hash;
use module::ffi;
use module::tast;
use std::cmp;
use std::collections;

pub fn empty_exports() -> artifact::ArtifactPackageExports {
    artifact::ArtifactPackageExports {
        go_exports: Vec::new(),
        reexports: Vec::new(),
        enum_type_names: Vec::new(),
        struct_type_names: Vec::new(),
        type_aliases: Vec::new(),
        enums: Vec::new(),
        structs: Vec::new(),
        traits: Vec::new(),
        trait_impls: Vec::new(),
        inherent_impls: Vec::new(),
        functions: Vec::new(),
        constants: Vec::new(),
    }
}

pub fn artifact_exports_type_context(value: artifact::ArtifactPackageExports) -> tast_codec::ArtifactTypeContext {
    let enum_names = value.enum_type_names;
    let struct_names = value.struct_type_names;
    for definition in value.enums {
        enum_names.push(definition.name)
    }
    for definition in value.structs {
        struct_names.push(definition.name)
    }
    tast_codec::artifact_type_context(enum_names, struct_names)
}

fn artifact_json_type_pairs(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[(string, tast::Type)],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_array(writer);
        wire::artifact_json_string(writer, value.0);
        tast_codec::artifact_json_type(writer, context, value.1);
        wire::artifact_json_end_array(writer)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_enum_def(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: tast::EnumDef,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "map_requirements");
    tast_codec::artifact_json_type_array(writer, context, value.map_requirements);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "generics");
    tast_codec::artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "option_variants");
    match value.option_variants {
        Some(variants) => tast_codec::artifact_json_string_array(
            writer,
            Vec::from_array([variants.0, variants.1]),
        ),
        None => wire::artifact_json_null(writer),
    }
    wire::artifact_json_name(writer, "variants");
    wire::artifact_json_begin_array(writer);
    for variant in value.variants {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, variant.name);
        wire::artifact_json_name(writer, "fields");
        match variant.fields {
            Unit => wire::artifact_json_string(writer, "Unit"),
            Tuple(fields) => {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "Tuple");
                tast_codec::artifact_json_type_array(writer, context, fields);
                wire::artifact_json_end_object(writer)
            },
            Struct(fields) => {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "Struct");
                artifact_json_type_pairs(writer, context, fields);
                wire::artifact_json_end_object(writer)
            },
        }
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_struct_def(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: tast::StructDef,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "map_requirements");
    tast_codec::artifact_json_type_array(writer, context, value.map_requirements);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "generics");
    tast_codec::artifact_json_string_array(writer, value.generics);
    wire::artifact_json_name(writer, "fields");
    artifact_json_type_pairs(writer, context, value.fields);
    wire::artifact_json_name(writer, "has_hidden_fields");
    wire::artifact_json_bool(writer, value.has_hidden_fields);
    wire::artifact_json_name(writer, "go_comparable");
    artifact_json_struct_comparability(writer, value.go_comparable);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_predicates(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[tast::TypePredicate],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        tast_codec::artifact_json_type_predicate(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_trait_refs(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[tast::TraitRef],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        tast_codec::artifact_json_trait_ref(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_fn_scheme(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactFnScheme,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "comptime");
    wire::artifact_json_bool(
        writer,
        match value.comptime {
            tast::ComptimeCapability::Capable => true,
            tast::ComptimeCapability::RuntimeOnly | tast::ComptimeCapability::Derive => false,
        },
    );
    wire::artifact_json_name(writer, "type_params");
    tast_codec::artifact_json_string_array(writer, value.type_params);
    wire::artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    wire::artifact_json_name(writer, "ty");
    tast_codec::artifact_json_type(writer, context, value.ty);
    wire::artifact_json_name(writer, "body");
    tast_codec::artifact_json_callable_body(writer, tast_codec::artifact_callable(value.body));
    wire::artifact_json_end_object(writer)
}

fn artifact_json_methods(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[artifact::ArtifactFnScheme],
) -> () {
    wire::artifact_json_begin_object(writer);
    for value in values {
        wire::artifact_json_name(writer, value.name);
        artifact_json_fn_scheme(writer, context, value)
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_trait_def(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactTraitDef,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "default_map_requirements");
    wire::artifact_json_begin_object(writer);
    for entry in value.default_map_requirements {
        wire::artifact_json_name(writer, entry.0);
        tast_codec::artifact_json_type_array(writer, context, entry.1);
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "params");
    tast_codec::artifact_json_string_array(writer, value.params);
    wire::artifact_json_name(writer, "predicates");
    artifact_json_predicates(writer, context, value.predicates);
    wire::artifact_json_name(writer, "supertraits");
    artifact_json_trait_refs(writer, context, value.supertraits);
    wire::artifact_json_name(writer, "associated_types");
    wire::artifact_json_begin_object(writer);
    for associated in value.associated_types {
        wire::artifact_json_name(writer, associated.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "bounds");
        artifact_json_trait_refs(writer, context, associated.bounds);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_impl_def(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactImplDef,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "params");
    tast_codec::artifact_json_string_array(writer, value.params);
    wire::artifact_json_name(writer, "constraints");
    artifact_json_predicates(writer, context, value.constraints);
    wire::artifact_json_name(writer, "associated_types");
    wire::artifact_json_begin_object(writer);
    for associated in value.associated_types {
        wire::artifact_json_name(writer, associated.0);
        tast_codec::artifact_json_type(writer, context, associated.1)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "methods");
    artifact_json_methods(writer, context, value.methods);
    wire::artifact_json_name(writer, "valid");
    wire::artifact_json_bool(writer, value.valid);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_trait_impl_key(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactTraitImpl,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "trait_ref");
    tast_codec::artifact_json_trait_ref(writer, context, value.trait_ref);
    wire::artifact_json_name(writer, "for_ty");
    tast_codec::artifact_json_type(writer, context, value.for_ty);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_inherent_impl_key(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactInherentImplKey,
) -> () {
    wire::artifact_json_begin_object(writer);
    match value {
        Exact(value) => {
            wire::artifact_json_name(writer, "Exact");
            tast_codec::artifact_json_type(writer, context, value)
        },
        Constr(value) => {
            wire::artifact_json_name(writer, "Constr");
            wire::artifact_json_string(writer, value)
        },
    }
    wire::artifact_json_end_object(writer)
}

pub fn write_exports(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactPackageExports,
) -> () {
    write_exports_with_origin(writer, context, value, true)
}

fn write_exports_with_origin(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactPackageExports,
    origin: bool,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "go_exports");
    write_go_exports(writer, context, value.go_exports, origin);
    wire::artifact_json_name(writer, "reexports");
    artifact_json_string_map(writer, value.reexports);
    wire::artifact_json_name(writer, "type_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "enums");
    wire::artifact_json_begin_object(writer);
    for definition in value.enums {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_enum_def(writer, context, definition)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "structs");
    wire::artifact_json_begin_object(writer);
    for definition in value.structs {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_struct_def(writer, context, definition)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "aliases");
    wire::artifact_json_begin_object(writer);
    for alias in value.type_aliases {
        wire::artifact_json_name(writer, alias.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "generics");
        tast_codec::artifact_json_string_array(writer, alias.generics);
        wire::artifact_json_name(writer, "ty");
        tast_codec::artifact_json_type(writer, context, alias.ty);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "trait_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "trait_defs");
    wire::artifact_json_begin_object(writer);
    for definition in value.traits {
        wire::artifact_json_name(writer, definition.name);
        artifact_json_trait_def(writer, context, definition)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "trait_impls");
    wire::artifact_json_begin_array(writer);
    for implementation in value.trait_impls {
        wire::artifact_json_begin_array(writer);
        artifact_json_trait_impl_key(writer, context, implementation);
        artifact_json_impl_def(writer, context, implementation.definition);
        wire::artifact_json_end_array(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "inherent_impls");
    wire::artifact_json_begin_array(writer);
    for implementation in value.inherent_impls {
        wire::artifact_json_begin_array(writer);
        artifact_json_inherent_impl_key(writer, context, implementation.key);
        artifact_json_impl_def(writer, context, implementation.definition);
        wire::artifact_json_end_array(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "value_env");
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "funcs");
    wire::artifact_json_begin_object(writer);
    for function in value.functions {
        wire::artifact_json_name(writer, function.name);
        artifact_json_fn_scheme(writer, context, function)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "consts");
    wire::artifact_json_begin_object(writer);
    for value in value.constants {
        wire::artifact_json_name(writer, value.name);
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "ty");
        tast_codec::artifact_json_type(writer, context, value.ty);
        wire::artifact_json_end_object(writer)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_string_map(writer: wire::ArtifactJsonWriter, values: Vec[(string, string)]) -> () {
    collections::sort_by_ordering(
        values,
        |left: (string, string), right: (string, string)| cmp::compare(left.0, right.0),
    );
    wire::artifact_json_begin_object(writer);
    for value in values {
        wire::artifact_json_name(writer, value.0);
        wire::artifact_json_string(writer, value.1)
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_package_interface(
    writer: wire::ArtifactJsonWriter,
    value: artifact::ArtifactPackageInterface,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "value_exports");
    wire::artifact_json_begin_object(writer);
    for export in value.value_exports {
        wire::artifact_json_name(writer, export.0);
        wire::artifact_json_number(writer, export.1.to_string())
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_name(writer, "enum_variants");
    wire::artifact_json_begin_object(writer);
    for definition in value.enum_variants {
        wire::artifact_json_name(writer, definition.0);
        tast_codec::artifact_json_string_array(writer, definition.1)
    }
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_interface_hash_view(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: artifact::ArtifactInterfaceUnit,
) -> () {
    wire::artifact_json_begin_object(writer);
    if wire::artifact_json_binary_mode(writer) < 2 {
        wire::artifact_json_name(writer, "format_version");
        wire::artifact_json_number(writer, "30");
        wire::artifact_json_name(writer, "compiler_abi");
        wire::artifact_json_number(writer, "5")
    }
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "exports");
    write_exports_with_origin(writer, context, value.exports, false);
    wire::artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    wire::artifact_json_name(writer, "comptime");
    match value.comptime {
        Some(value) => artifact_json_comptime_unit(writer, value, true),
        None => wire::artifact_json_null(writer),
    }
    wire::artifact_json_name(writer, "foreign_types");
    write_foreign_type_metadata(writer, value.foreign_types);
    wire::artifact_json_name(writer, "foreign_bindings");
    write_foreign_bindings(writer, value.foreign_bindings);
    wire::artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    wire::artifact_json_end_object(writer)
}

fn artifact_interface_hash(value: artifact::ArtifactInterfaceUnit) -> string {
    let writer = wire::new_artifact_json_writer(false);
    artifact_json_interface_hash_view(writer, artifact_exports_type_context(value.exports), value);
    hash::sha256_hex(wire::artifact_json_finish(writer))
}

pub fn new_unit(
    package_name: string,
    exports: artifact::ArtifactPackageExports,
    package_interface: artifact::ArtifactPackageInterface,
    deps: Vec[(string, string)],
) -> artifact::ArtifactInterfaceUnit {
    new_unit_with_comptime(package_name, exports, package_interface, Option::None, deps)
}

pub fn new_unit_with_comptime(
    package_name: string,
    exports: artifact::ArtifactPackageExports,
    package_interface: artifact::ArtifactPackageInterface,
    comptime: Option[artifact::ArtifactComptimeUnit],
    deps: Vec[(string, string)],
) -> artifact::ArtifactInterfaceUnit {
    new_unit_with_foreign_bindings(
        package_name,
        exports,
        package_interface,
        comptime,
        deps,
        Vec::new(),
    )
}

pub fn new_unit_with_foreign_bindings(
    package_name: string,
    exports: artifact::ArtifactPackageExports,
    package_interface: artifact::ArtifactPackageInterface,
    comptime: Option[artifact::ArtifactComptimeUnit],
    deps: Vec[(string, string)],
    foreign_bindings: Vec[ffi::ForeignBinding],
) -> artifact::ArtifactInterfaceUnit {
    let value = artifact::ArtifactInterfaceUnit {
        foreign_types: Option::None,
        foreign_bindings,
        package_name,
        exports,
        package_interface,
        comptime,
        deps,
        interface_hash: "",
    };
    let interface_hash = artifact_interface_hash(value);
    artifact::ArtifactInterfaceUnit {
        foreign_types: value.foreign_types,
        foreign_bindings: value.foreign_bindings,
        package_name: value.package_name,
        exports: value.exports,
        package_interface: value.package_interface,
        comptime: value.comptime,
        deps: value.deps,
        interface_hash,
    }
}

pub fn artifact_json_interface_unit(
    writer: wire::ArtifactJsonWriter,
    value: artifact::ArtifactInterfaceUnit,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "format_version");
    wire::artifact_json_number(writer, "30");
    wire::artifact_json_name(writer, "compiler_abi");
    wire::artifact_json_number(writer, "5");
    wire::artifact_json_name(writer, "package");
    wire::artifact_json_string(writer, value.package_name);
    wire::artifact_json_name(writer, "exports");
    write_exports(writer, artifact_exports_type_context(value.exports), value.exports);
    wire::artifact_json_name(writer, "interface");
    artifact_json_package_interface(writer, value.package_interface);
    wire::artifact_json_name(writer, "comptime");
    match value.comptime {
        Some(value) => artifact_json_comptime_unit(writer, value, false),
        None => wire::artifact_json_null(writer),
    }
    wire::artifact_json_name(writer, "foreign_types");
    write_foreign_type_metadata(writer, value.foreign_types);
    wire::artifact_json_name(writer, "foreign_bindings");
    write_foreign_bindings(writer, value.foreign_bindings);
    wire::artifact_json_name(writer, "deps");
    artifact_json_string_map(writer, value.deps);
    wire::artifact_json_name(writer, "interface_hash");
    wire::artifact_json_string(writer, value.interface_hash);
    wire::artifact_json_end_object(writer)
}

pub fn encode_json(value: artifact::ArtifactInterfaceUnit, pretty: bool) -> string {
    let writer = wire::new_artifact_json_writer(pretty);
    artifact_json_interface_unit(writer, value);
    wire::artifact_json_finish(writer)
}

pub fn with_foreign_types(
    value: artifact::ArtifactInterfaceUnit,
    metadata: ffi::ForeignTypeMetadata,
) -> Result[artifact::ArtifactInterfaceUnit, string] {
    let _ = ffi::encode_foreign_type_metadata(metadata)?;
    let updated = artifact::ArtifactInterfaceUnit {
        foreign_types: Option::Some(metadata),
        foreign_bindings: value.foreign_bindings,
        package_name: value.package_name,
        exports: value.exports,
        package_interface: value.package_interface,
        comptime: value.comptime,
        deps: value.deps,
        interface_hash: "",
    };
    Result::Ok(
        artifact::ArtifactInterfaceUnit {
            foreign_types: updated.foreign_types,
            foreign_bindings: updated.foreign_bindings,
            package_name: updated.package_name,
            exports: updated.exports,
            package_interface: updated.package_interface,
            comptime: updated.comptime,
            deps: updated.deps,
            interface_hash: artifact_interface_hash(updated),
        },
    )
}
