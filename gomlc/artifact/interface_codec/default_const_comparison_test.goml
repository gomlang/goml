package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;
use std::testing;

#[test]
fn constant_comparison_interface_metadata_is_required_and_round_trips() -> () {
    let ty = tast::Type::Param { name: "T" };
    let value = artifact::ArtifactTraitDef {
        name: "audit::Comparison",
        params: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::ConstComparison { ty, ordering: false }]),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        default_map_requirements: Vec::new(),
        default_raw_function_requirements: Vec::new(),
        default_const_requirements: Vec::new(),
        default_callback_requirements: Vec::new(),
        default_const_comparison_requirements: Vec::from_array(
            [("compare", Vec::from_array([(ty, false), (ty, true)]))],
        ),
        methods: Vec::from_array(
            [
                artifact::ArtifactFnScheme {
                    has_receiver: false,
                    name: "compare",
                    comptime: tast::ComptimeCapability::RuntimeOnly,
                    type_params: Vec::new(),
                    constraints: Vec::new(),
                    ty: tast::Type::Func { params: Vec::new(), ret_ty: tast::Type::Bool },
                    body: tast::Callable::Function("trait_default#audit::Comparison#compare"),
                },
            ],
        ),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_trait_def(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    );
    let encoded = testing::expect_ok(
        wire::artifact_value_finish(writer),
        "encode trait comparisons",
    );
    let decoded = testing::expect_ok(
        artifact_decode_trait_def(tast_codec::new_artifact_decode_context(), value.name, encoded),
        "decode trait comparisons",
    );
    testing::assert_eq(decoded.default_const_comparison_requirements.len(), 1);
    let requirements = decoded.default_const_comparison_requirements[0].1;
    testing::assert_eq(requirements.len(), 2);
    testing::assert(!requirements[0].1);
    testing::assert(requirements[1].1);
    testing::assert(tast::types_equal(requirements[0].0, ty));
    match decoded.predicates[0] {
        ConstComparison { ty: actual, ordering } => {
            testing::assert(!ordering);
            testing::assert(tast::types_equal(actual, ty));
        },
        _ => testing::fail("comparison predicate was not retained"),
    }
    let fields = Vec::new();
    if let Object(entries) = encoded {
        for entry in entries {
            if entry.0 != "default_const_comparison_requirements" {
                fields.push(entry);
            }
        }
    }
    testing::assert(
        artifact_decode_trait_def(
            tast_codec::new_artifact_decode_context(),
            value.name,
            wire::ArtifactValue::Object(fields),
        ).is_err(),
    );
    for payload in[
        wire::ArtifactValue::Array(Vec::new()),
        wire::ArtifactValue::Array(
            Vec::from_array(
                [wire::ArtifactValue::String("TInt32"), wire::ArtifactValue::String("true")],
            ),
        ),
    ] {
        testing::assert(
            tast_codec::artifact_decode_predicate(
                tast_codec::new_artifact_decode_context(),
                wire::ArtifactValue::Object(Vec::from_array([("ConstComparison", payload)])),
            ).is_err(),
        );
    }
}
