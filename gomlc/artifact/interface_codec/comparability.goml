package interface_codec;

use module::artifact::wire;
use module::ffi;

fn artifact_json_comparability_rule(writer: wire::ArtifactJsonWriter, rule: ffi::GoComparability) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "tag");
    match rule {
        Always => wire::artifact_json_string(writer, "always"),
        Never => wire::artifact_json_string(writer, "never"),
        Unknown => wire::artifact_json_string(writer, "unknown"),
        Parameter(index) => {
            wire::artifact_json_string(writer, "parameter");
            wire::artifact_json_name(writer, "index");
            wire::artifact_json_number(writer, index.to_string());
        },
        All(rules) => {
            wire::artifact_json_string(writer, "all");
            wire::artifact_json_name(writer, "rules");
            wire::artifact_json_begin_array(writer);
            for child in rules {
                artifact_json_comparability_rule(writer, child)
            }
            wire::artifact_json_end_array(writer);
        },
    }
    wire::artifact_json_end_object(writer)
}

fn artifact_json_struct_comparability(
    writer: wire::ArtifactJsonWriter,
    rule: Option[ffi::GoComparability],
) -> () {
    match rule {
        Some(value) => artifact_json_comparability_rule(writer, value),
        None => wire::artifact_json_null(writer),
    }
}

fn artifact_decode_comparability_rule(
    value: wire::ArtifactValue,
    arity: isize,
    depth: isize,
    remaining: Ref[isize],
) -> Result[ffi::GoComparability, string] {
    if depth >= 64 || remaining.get() <= 0 {
        return Result::Err("struct comparability complexity limit exceeded")
    }
    remaining.set(remaining.get() - 1);
    let object = wire::artifact_json_object(value, "struct comparability")?;
    match wire::artifact_json_field_string(object, "tag")? {
        "always" => Result::Ok(ffi::GoComparability::Always),
        "never" => Result::Ok(ffi::GoComparability::Never),
        "unknown" => Result::Ok(ffi::GoComparability::Unknown),
        "parameter" => {
            let text = wire::artifact_json_number_value(
                wire::artifact_json_required_field(object, "index")?,
                "comparability parameter",
            )?;
            let index = wire::artifact_parse_nonnegative_int(text)?;
            if index >= arity {
                Result::Err("struct comparability parameter is out of range")
            } else {
                Result::Ok(ffi::GoComparability::Parameter(index))
            }
        },
        "all" => {
            let rules = Vec::new();
            for child in wire::artifact_json_field_array(object, "rules")? {
                rules.push(artifact_decode_comparability_rule(child, arity, depth + 1, remaining)?)
            }
            Result::Ok(ffi::GoComparability::All(rules))
        },
        _ => Result::Err("unknown struct comparability rule"),
    }
}

fn artifact_decode_struct_comparability(value: wire::ArtifactValue, arity: isize) -> Result[
    Option[ffi::GoComparability],
    string,
] {
    match value {
        wire::ArtifactValue::Null => Result::Ok(Option::None),
        _ => Result::Ok(
            Option::Some(artifact_decode_comparability_rule(value, arity, 0, Ref::new(65536))?),
        ),
    }
}
