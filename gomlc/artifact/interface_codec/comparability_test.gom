package interface_codec;

use module::artifact::wire;
use module::ffi;
use std::testing;

fn comparability_rule_value(rule: ffi::GoComparability) -> wire::ArtifactValue {
    let writer = wire::new_artifact_value_writer();
    artifact_json_comparability_rule(writer, rule);
    match wire::artifact_value_finish(writer) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error);
            wire::ArtifactValue::Null
        },
    }
}

fn comparability_rule_text(rule: Option[ffi::GoComparability]) -> string {
    let writer = wire::new_artifact_json_writer(false);
    artifact_json_struct_comparability(writer, rule);
    wire::artifact_json_finish(writer)
}

#[test]
fn struct_comparability_rules_round_trip() -> () {
    for rule in Vec::from_array(
        [
            ffi::GoComparability::Always,
            ffi::GoComparability::Never,
            ffi::GoComparability::Unknown,
            ffi::GoComparability::Parameter(1),
            ffi::GoComparability::All(
                Vec::from_array(
                    [
                        ffi::GoComparability::Parameter(0),
                        ffi::GoComparability::All(
                            Vec::from_array([ffi::GoComparability::Parameter(1)]),
                        ),
                    ],
                ),
            ),
        ],
    ) {
        match artifact_decode_struct_comparability(comparability_rule_value(rule), 2) {
            Ok(decoded) => testing::assert_eq(
                comparability_rule_text(decoded),
                comparability_rule_text(Option::Some(rule)),
            ),
            Err(error) => testing::fail(error),
        }
    }
    match artifact_decode_struct_comparability(wire::ArtifactValue::Null, 0) {
        Ok(value) => testing::assert(value.is_none()),
        Err(error) => testing::fail(error),
    }
}

#[test]
fn struct_comparability_rules_reject_invalid_parameters_and_depth() -> () {
    for index in Vec::from_array([-1, 2]) {
        testing::assert(
            artifact_decode_struct_comparability(
                comparability_rule_value(ffi::GoComparability::Parameter(index)),
                2,
            ).is_err(),
        );
    }
    testing::assert(
        artifact_decode_struct_comparability(
            wire::ArtifactValue::Object(
                Vec::from_array([("tag", wire::ArtifactValue::String("unsupported"))]),
            ),
            0,
        ).is_err(),
    );
    let mut rule = ffi::GoComparability::Always;
    for depth in 0..64 {
        rule = ffi::GoComparability::All(Vec::from_array([rule]));
    }
    testing::assert(
        artifact_decode_struct_comparability(comparability_rule_value(rule), 0).is_err(),
    );
    testing::assert(
        artifact_decode_struct_comparability(wire::ArtifactValue::Bool(true), 0).is_err(),
    );
}
