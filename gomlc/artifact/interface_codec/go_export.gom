package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;

fn write_go_exports(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[artifact::ArtifactGoExport],
    origin: bool,
) -> () {
    let names: Vec[string] = Vec::new();
    for value in values {
        names.push(value.go_name)
    }
    wire::artifact_json_begin_array(writer);
    for name in wire::sort_artifact_names(names) {
        for value in values {
            if value.go_name == name {
                wire::artifact_json_begin_object(writer);
                wire::artifact_json_name(writer, "package");
                wire::artifact_json_string(writer, value.package_name);
                wire::artifact_json_name(writer, "symbol");
                wire::artifact_json_string(writer, value.symbol);
                wire::artifact_json_name(writer, "go_name");
                wire::artifact_json_string(writer, value.go_name);
                wire::artifact_json_name(writer, "ty");
                tast_codec::artifact_json_type(writer, context, value.ty);
                if origin {
                    wire::artifact_json_name(writer, "source_file");
                    wire::artifact_json_string(writer, value.source_file);
                    wire::artifact_json_name(writer, "start");
                    wire::artifact_json_number(writer, value.start.to_string());
                    wire::artifact_json_name(writer, "end");
                    wire::artifact_json_number(writer, value.end.to_string());
                }
                wire::artifact_json_end_object(writer)
            }
        }
    }
    wire::artifact_json_end_array(writer)
}

fn decode_go_exports(
    context: tast_codec::ArtifactDecodeContext,
    encoded: wire::ArtifactValue,
    functions: Vec[artifact::ArtifactFnScheme],
) -> Result[Vec[artifact::ArtifactGoExport], string] {
    let result: Vec[artifact::ArtifactGoExport] = Vec::new();
    let names: HashMap[string, bool] = HashMap::new();
    let symbols: HashMap[string, bool] = HashMap::new();
    for entry in wire::artifact_json_array(encoded, "Go exports")? {
        let object = wire::artifact_json_object(entry, "Go export")?;
        let package_name = wire::artifact_json_field_string(object, "package")?;
        let symbol = wire::artifact_json_field_string(object, "symbol")?;
        let go_name = wire::artifact_json_field_string(object, "go_name")?;
        let ty = tast_codec::artifact_decode_type(
            context,
            wire::artifact_json_required_field(object, "ty")?,
        )?;
        let source_file = wire::artifact_json_field_string(object, "source_file")?;
        let start = wire::artifact_parse_nonnegative_int(
            wire::artifact_json_number_value(
                wire::artifact_json_required_field(object, "start")?,
                "export start",
            )?,
        )?;
        let end = wire::artifact_parse_nonnegative_int(
            wire::artifact_json_number_value(
                wire::artifact_json_required_field(object, "end")?,
                "export end",
            )?,
        )?;
        if package_name == "" || !symbol.starts_with(package_name + "::")
            || !tast::go_export_symbol_is_valid(go_name)
            || names[go_name].is_some()
            || symbols[symbol].is_some()
            || start > end
            || source_file.contains("/")
            || source_file.contains("\\")
            || source_file == ".." {
            return Result::Err("invalid or duplicate Go export identity or origin")
        }
        let mut found = false;
        for function in functions {
            if function.name == symbol {
                let eligible = match (function.comptime, function.body) {
                    (tast::ComptimeCapability::RuntimeOnly, tast::Callable::Function(target)) => target
                        == symbol,
                    _ => false,
                };
                if !eligible || !function.type_params.is_empty() || !function.constraints.is_empty()
                    || !tast::types_equal(function.ty, ty) {
                    return Result::Err("Go export metadata conflicts with function " + symbol)
                }
                found = true;
            }
        }
        if !found {
            return Result::Err("Go export refers to missing function " + symbol)
        }
        match tast::resolve_type(ty) {
            Func { params, ret_ty } => {
                for param in params {
                    if !tast::go_export_value_type(param) {
                        return Result::Err("invalid Go export parameter type")
                    }
                }
                if !tast::go_export_return_type(ret_ty) {
                    return Result::Err("invalid Go export return type")
                }
            },
            _ => return Result::Err("Go export signature must be a function"),
        }
        names[go_name] = true;
        symbols[symbol] = true;
        result.push(
            artifact::ArtifactGoExport {
                package_name,
                symbol,
                go_name,
                ty,
                source_file,
                start,
                end,
            },
        )
    }
    Result::Ok(result)
}

pub fn validate_go_export_package(package_name: string, exports: artifact::ArtifactPackageExports) -> Result[
    (),
    string,
] {
    for value in exports.go_exports {
        if value.package_name != package_name {
            return Result::Err("Go export belongs to a different package")
        }
    }
    Result::Ok(())
}
