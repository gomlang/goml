package interface_codec;

use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;

fn artifact_json_constant_call(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    value: tast::Callable,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "kind");
    match value {
        Function(name) => {
            wire::artifact_json_string(writer, "function");
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
        },
        FunctionInstance { name, bindings } => {
            wire::artifact_json_string(writer, "instance");
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "bindings");
            wire::artifact_json_begin_array(writer);
            for binding in bindings {
                wire::artifact_json_begin_array(writer);
                wire::artifact_json_string(writer, binding.0);
                tast_codec::artifact_json_type(writer, context, binding.1);
                wire::artifact_json_end_array(writer);
            }
            wire::artifact_json_end_array(writer);
        },
        InherentMethod { receiver_ty, method_name } => {
            wire::artifact_json_string(writer, "inherent");
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "owner");
            tast_codec::artifact_json_type(writer, context, receiver_ty);
        },
        TraitMethod { trait_ref, method_name, for_ty, has_receiver } => {
            wire::artifact_json_string(writer, "trait");
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, method_name);
            wire::artifact_json_name(writer, "owner");
            tast_codec::artifact_json_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "trait");
            tast_codec::artifact_json_trait_ref(writer, context, trait_ref);
            wire::artifact_json_name(writer, "has_receiver");
            wire::artifact_json_bool(writer, has_receiver);
        },
        _ => wire::artifact_json_string(writer, "invalid"),
    }
    wire::artifact_json_end_object(writer);
}

fn artifact_decode_constant_call(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[tast::Callable, string] {
    let object = wire::artifact_json_object(value, "associated constant call")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    match wire::artifact_json_field_string(object, "kind")? {
        "function" => Ok(tast::Callable::Function(name)),
        "instance" => {
            let bindings = Vec::new();
            for value in wire::artifact_json_array(
                wire::artifact_json_required_field(object, "bindings")?,
                "constant call bindings",
            )? {
                let pair = wire::artifact_json_array(value, "constant call binding")?;
                if pair.len() != 2 {
                    return Err(wire::artifact_decode_error("constant call binding pair"))
                }
                bindings.push(
                    (
                        wire::artifact_json_string_value(pair.get(0), "constant call parameter")?,
                        tast_codec::artifact_decode_type(context, pair.get(1))?,
                    ),
                );
            }
            Ok(tast::Callable::FunctionInstance { name, bindings })
        },
        "inherent" => Ok(
            tast::Callable::InherentMethod {
                receiver_ty: tast_codec::artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "owner")?,
                )?,
                method_name: name,
            },
        ),
        "trait" => Ok(
            tast::Callable::TraitMethod {
                for_ty: tast_codec::artifact_decode_type(
                    context,
                    wire::artifact_json_required_field(object, "owner")?,
                )?,
                trait_ref: tast_codec::artifact_decode_trait_ref(
                    context,
                    wire::artifact_json_required_field(object, "trait")?,
                )?,
                method_name: name,
                has_receiver: wire::artifact_json_bool_value(
                    wire::artifact_json_required_field(object, "has_receiver")?,
                    "constant call receiver",
                )?,
            },
        ),
        _ => Err(wire::artifact_decode_error("associated constant call kind")),
    }
}

fn artifact_json_associated_constants(
    writer: wire::ArtifactJsonWriter,
    context: tast_codec::ArtifactTypeContext,
    values: Vec[tast::AssociatedConstantDependencies],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_begin_object(writer);
        wire::artifact_json_name(writer, "name");
        wire::artifact_json_string(writer, value.name);
        wire::artifact_json_name(writer, "owner");
        match value.owner {
            Some(owner) => tast_codec::artifact_json_type(writer, context, owner),
            None => wire::artifact_json_null(writer),
        }
        wire::artifact_json_name(writer, "trait");
        match value.trait_ref {
            Some(trait_ref) => tast_codec::artifact_json_trait_ref(writer, context, trait_ref),
            None => wire::artifact_json_null(writer),
        }
        wire::artifact_json_name(writer, "generics");
        tast_codec::artifact_json_string_array(writer, value.generics);
        wire::artifact_json_name(writer, "predicates");
        wire::artifact_json_begin_array(writer);
        for predicate in value.predicates {
            tast_codec::artifact_json_type_predicate(writer, context, predicate);
        }
        wire::artifact_json_end_array(writer);
        wire::artifact_json_name(writer, "calls");
        wire::artifact_json_begin_array(writer);
        for call in value.calls {
            artifact_json_constant_call(writer, context, call);
        }
        wire::artifact_json_end_array(writer);
        wire::artifact_json_end_object(writer);
    }
    wire::artifact_json_end_array(writer);
}

fn artifact_decode_associated_constants(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[tast::AssociatedConstantDependencies], string] {
    let result = Vec::new();
    for value in wire::artifact_json_array(value, "associated constant dependencies")? {
        let object = wire::artifact_json_object(value, "associated constant dependency")?;
        let owner: Option[tast::Type] = match wire::artifact_json_required_field(object, "owner")? {
            Null => None,
            value => Some(tast_codec::artifact_decode_type(context, value)?),
        };
        let trait_ref: Option[tast::TraitRef] = match wire::artifact_json_required_field(
            object,
            "trait",
        )? {
            Null => None,
            value => Some(tast_codec::artifact_decode_trait_ref(context, value)?),
        };
        let predicates = Vec::new();
        for value in wire::artifact_json_array(
            wire::artifact_json_required_field(object, "predicates")?,
            "constant predicates",
        )? {
            predicates.push(tast_codec::artifact_decode_predicate(context, value)?);
        }
        let calls = Vec::new();
        for value in wire::artifact_json_array(
            wire::artifact_json_required_field(object, "calls")?,
            "constant calls",
        )? {
            calls.push(artifact_decode_constant_call(context, value)?);
        }
        result.push(
            tast::AssociatedConstantDependencies {
                name: wire::artifact_json_field_string(object, "name")?,
                owner,
                trait_ref,
                generics: wire::artifact_decode_string_array(
                    wire::artifact_json_required_field(object, "generics")?,
                    "constant generics",
                )?,
                predicates,
                calls,
            },
        );
    }
    Ok(result)
}
