package interface_codec;

use module::artifact::wire;
use std::testing;

#[test]
fn binary_resource_failure_precedes_missing_field_diagnostics() -> () {
    let original = wire::ArtifactValue::Object(
        Vec::from_array([("package", wire::ArtifactValue::String("example"))]),
    );
    let table = wire::artifact_binary_string_table(original);
    let binary = testing::expect_ok(
        wire::encode_artifact_binary_value(table, original),
        "encode fixture",
    );
    let encoded = testing::expect_ok(
        wire::encode_artifact_binary_value_index(table, binary.as_slice()),
        "index fixture",
    );
    let value = testing::expect_ok(
        wire::decode_artifact_binary_value_index_with_limit(table, encoded.as_slice(), 1),
        "read root",
    );
    let object = testing::expect_ok(wire::artifact_json_object(value, "fixture"), "read object");
    let _ = wire::artifact_json_required_field(object, "package");
    let error = testing::expect_err(decode_checked_value(value), "resource error");
    testing::assert(error.contains("Interface decoding"));
    testing::assert(error.contains("node visits; limit=1; processed=1"));
}
