package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;

fn artifact_decode_default_map_requirements(
    context: tast_codec::ArtifactDecodeContext,
    object: Vec[(string, wire::ArtifactValue)],
    methods: Vec[artifact::ArtifactFnScheme],
) -> Result[Vec[(string, Vec[tast::Type])], string] {
    let result: Vec[(string, Vec[tast::Type])] = Vec::new();
    for entry in wire::artifact_json_field_object(object, "default_map_requirements")? {
        for previous in result {
            if previous.0 == entry.0 {
                return Result::Err("duplicate default method map requirements")
            }
        }
        let mut found = false;
        for method in methods {
            if method.name == entry.0 {
                if let tast::Callable::Function(name) = method.body {
                    found = name != method.name;
                }
            }
        }
        if !found {
            return Result::Err("map requirements refer to a method without a default body")
        }
        result.push(
            (
                entry.0,
                tast_codec::artifact_decode_type_array(context, entry.1, "default map requirements")?,
            ),
        );
    }
    Result::Ok(result)
}
