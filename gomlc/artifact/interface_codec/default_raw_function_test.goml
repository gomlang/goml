package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;
use std::testing;

#[test]
fn default_raw_function_requirements_round_trip_and_require_metadata() -> () {
    let signature = tast::Type::Func {
        params: Vec::from_array([tast::Type::Param { name: "T" }]),
        ret_ty: tast::Type::Param { name: "T" },
    };
    let value = artifact::ArtifactTraitDef {
        default_const_requirements: Vec::from_array(
            [("invoke", Vec::from_array([tast::Type::Param { name: "$const_param:N" }]))],
        ),
        name: "audit::Callback",
        params: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::GoFunction(signature)]),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        default_map_requirements: Vec::new(),
        default_raw_function_requirements: Vec::from_array(
            [("invoke", Vec::from_array([signature]))],
        ),
        methods: Vec::from_array(
            [
                artifact::ArtifactFnScheme {
                    name: "invoke",
                    comptime: tast::ComptimeCapability::RuntimeOnly,
                    type_params: Vec::new(),
                    constraints: Vec::new(),
                    ty: signature,
                    body: tast::Callable::Function("trait_default#audit::Callback#invoke"),
                },
            ],
        ),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_trait_def(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    );
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode trait");
    let decoded = testing::expect_ok(
        artifact_decode_trait_def(tast_codec::new_artifact_decode_context(), value.name, encoded),
        "decode trait",
    );
    testing::assert_eq(decoded.default_const_requirements.len(), 1);
    testing::assert_eq(decoded.default_const_requirements[0].0, "invoke");
    testing::assert(
        tast::types_equal(
            decoded.default_const_requirements[0].1[0],
            value.default_const_requirements[0].1[0],
        ),
    );
    testing::assert_eq(decoded.default_raw_function_requirements.len(), 1);
    testing::assert_eq(decoded.default_raw_function_requirements[0].0, "invoke");
    testing::assert(tast::types_equal(decoded.default_raw_function_requirements[0].1[0], signature));
    match decoded.predicates[0] {
        GoFunction(actual) => testing::assert(tast::types_equal(actual, signature)),
        _ => testing::fail("raw function predicate was not retained"),
    }
    for missing in["default_raw_function_requirements", "default_const_requirements"] {
        let fields = Vec::new();
        if let Object(entries) = encoded {
            for entry in entries {
                if entry.0 != missing {
                    fields.push(entry)
                }
            }
        }
        testing::assert(
            artifact_decode_trait_def(
                tast_codec::new_artifact_decode_context(),
                value.name,
                wire::ArtifactValue::Object(fields),
            ).is_err(),
        );
    }
}
