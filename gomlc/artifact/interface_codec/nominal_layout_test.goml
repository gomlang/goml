package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn private_nominal_layouts_round_trip_without_publishing_types_and_change_hashes() -> () {
    let exports = empty_exports();
    let package_interface = artifact::ArtifactPackageInterface {
        package_name: "audit",
        name: "audit",
        value_exports: Vec::new(),
        enum_variants: Vec::new(),
    };
    let empty = new_unit("audit", exports, package_interface, Vec::new());
    exports.layouts.push(
        tast::NominalLayout {
            name: "audit::Choice",
            generics: Vec::from_array(["T"]),
            shape: tast::NominalLayoutShape::Enum(
                Vec::from_array(
                    [
                        Vec::new(),
                        Vec::from_array(
                            [
                                tast::Type::App {
                                    ty: tast::Type::Con { name: "audit::Hidden" },
                                    args: Vec::from_array([tast::Type::Param { name: "T" }]),
                                },
                            ],
                        ),
                    ],
                ),
            ),
        },
    );
    exports.layouts.push(
        tast::NominalLayout {
            name: "audit::Hidden",
            generics: Vec::from_array(["T"]),
            shape: tast::NominalLayoutShape::Struct(
                Vec::from_array([tast::Type::Slice { elem: tast::Type::Param { name: "T" } }]),
            ),
        },
    );
    let unit = new_unit("audit", exports, package_interface, Vec::new());
    testing::assert(unit.interface_hash != empty.interface_hash);
    let binary = testing::expect_ok(encode_binary(unit), "encode private nominal layouts");
    let decoded = testing::expect_ok(decode_binary(binary), "decode private nominal layouts");
    testing::assert_eq(encode_json(decoded, false), encode_json(unit, false));
    testing::assert_eq(decoded.exports.layouts.len(), 2);
    testing::assert(decoded.exports.enums.is_empty());
    testing::assert(decoded.exports.structs.is_empty());
    testing::assert(decoded.package_interface.enum_variants.is_empty());
    testing::assert(decoded.package_interface.value_exports.is_empty());
    let changed = empty_exports();
    changed.layouts.push(exports.layouts[0]);
    changed.layouts.push(
        tast::NominalLayout {
            name: "audit::Hidden",
            generics: Vec::from_array(["T"]),
            shape: tast::NominalLayoutShape::Struct(
                Vec::from_array([tast::Type::GoPointer { elem: tast::Type::Param { name: "T" } }]),
            ),
        },
    );
    testing::assert(
        unit.interface_hash
            != new_unit("audit", changed, package_interface, Vec::new()).interface_hash,
    );
}

#[test]
fn missing_nominal_layout_metadata_is_rejected() -> () {
    let exports = empty_exports();
    let writer = wire::new_artifact_value_writer();
    write_exports(writer, artifact_exports_type_context(exports), exports);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode exports");
    let fields = Vec::new();
    if let Object(entries) = encoded {
        for entry in entries {
            if entry.0 == "type_env" {
                let type_fields = Vec::new();
                if let Object(types) = entry.1 {
                    for item in types {
                        if item.0 != "layouts" {
                            type_fields.push(item);
                        }
                    }
                }
                fields.push((entry.0, wire::ArtifactValue::Object(type_fields)));
            } else {
                fields.push(entry);
            }
        }
    }
    testing::assert(decode_exports(wire::ArtifactValue::Object(fields)).is_err());
}
