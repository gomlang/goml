package interface_codec;

use module::artifact;
use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn private_proof_metadata_round_trips_without_public_exports_and_changes_hash() -> () {
    let exports = empty_exports();
    let package_interface = artifact::ArtifactPackageInterface {
        package_name: "audit",
        name: "audit",
        value_exports: Vec::new(),
        enum_variants: Vec::new(),
    };
    let empty = new_unit("audit", exports, package_interface, Vec::new());
    exports.proof_traits.push(
        artifact::ArtifactTraitDef {
            default_const_comparison_requirements: Vec::new(),
            default_callback_requirements: Vec::new(),
            default_const_requirements: Vec::new(),
            name: "audit::PrivateProof",
            params: Vec::new(),
            predicates: Vec::new(),
            supertraits: Vec::new(),
            associated_types: Vec::new(),
            methods: Vec::new(),
            default_map_requirements: Vec::new(),
            default_raw_function_requirements: Vec::new(),
        },
    );
    let trait_only = new_unit("audit", exports, package_interface, Vec::new());
    testing::assert(empty.interface_hash != trait_only.interface_hash);
    exports.proof_trait_impls.push(
        artifact::ArtifactTraitImpl {
            trait_ref: tast::TraitRef { name: "audit::PrivateProof", args: Vec::new() },
            for_ty: tast::Type::Int,
            definition: artifact::ArtifactImplDef {
                params: Vec::new(),
                constraints: Vec::new(),
                associated_types: Vec::new(),
                methods: Vec::new(),
                valid: true,
            },
        },
    );
    let value = new_unit("audit", exports, package_interface, Vec::new());
    testing::assert(trait_only.interface_hash != value.interface_hash);
    let binary = testing::expect_ok(encode_binary(value), "encode proof metadata");
    let decoded = testing::expect_ok(decode_binary(binary), "decode proof metadata");
    testing::assert_eq(encode_json(decoded, false), encode_json(value, false));
    testing::assert(decoded.exports.traits.is_empty());
    testing::assert(decoded.exports.trait_impls.is_empty());
    testing::assert(decoded.package_interface.value_exports.is_empty());
    testing::assert_eq(decoded.exports.proof_traits.len(), 1);
    testing::assert_eq(decoded.exports.proof_traits[0].name, "audit::PrivateProof");
    testing::assert_eq(decoded.exports.proof_trait_impls.len(), 1);
    testing::assert(tast::types_equal(decoded.exports.proof_trait_impls[0].for_ty, tast::Type::Int));
    let writer = wire::new_artifact_value_writer();
    write_exports(writer, artifact_exports_type_context(exports), exports);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode exports");
    for missing in["proof_trait_defs", "proof_trait_impls"] {
        let fields = Vec::new();
        if let Object(entries) = encoded {
            for entry in entries {
                if entry.0 == "trait_env" {
                    let trait_fields = Vec::new();
                    if let Object(trait_entries) = entry.1 {
                        for trait_entry in trait_entries {
                            if trait_entry.0 != missing {
                                trait_fields.push(trait_entry)
                            }
                        }
                    }
                    fields.push((entry.0, wire::ArtifactValue::Object(trait_fields)))
                } else {
                    fields.push(entry)
                }
            }
        }
        testing::assert(decode_exports(wire::ArtifactValue::Object(fields)).is_err());
    }
}
