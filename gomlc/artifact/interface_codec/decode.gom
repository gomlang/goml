package interface_codec;

use module::artifact::wire as wire;
use module::artifact;
use module::artifact::tast_codec as tast_codec;
use module::tast;

fn artifact_decode_predicates(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[tast::TypePredicate], string] {
    let values = wire::artifact_json_array(value, "type predicates")?;
    let result: Vec[tast::TypePredicate] = Vec::new();
    for value in values {
        result.push(tast_codec::artifact_decode_predicate(context, value)?)
    }
    Result::Ok(result)
}

fn artifact_decode_trait_refs(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[tast::TraitRef], string] {
    let values = wire::artifact_json_array(value, "trait references")?;
    let result: Vec[tast::TraitRef] = Vec::new();
    for value in values {
        result.push(tast_codec::artifact_decode_trait_ref(context, value)?)
    }
    Result::Ok(result)
}

fn artifact_decode_fn_scheme(
    context: tast_codec::ArtifactDecodeContext,
    name: string,
    value: wire::ArtifactValue,
) -> Result[artifact::ArtifactFnScheme, string] {
    let object = wire::artifact_json_object(value, "function scheme")?;
    let comptime = if wire::artifact_json_bool_value(
        wire::artifact_json_required_field(object, "comptime")?,
        "comptime capability",
    )? {
        tast::ComptimeCapability::Capable
    } else {
        tast::ComptimeCapability::RuntimeOnly
    };
    let type_params = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "type_params")?,
        "type parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        wire::artifact_json_required_field(object, "constraints")?,
    )?;
    let ty = tast_codec::artifact_decode_type(
        context,
        wire::artifact_json_required_field(object, "ty")?,
    )?;
    let body = match wire::artifact_json_optional_field(object, "body")? {
        Some(value) => tast_codec::artifact_decode_callable_body(name, value)?,
        None => tast::Callable::Function(name),
    };
    match body {
        GoForeign { .. } | GoMethod { .. } | GoInterfaceBridge { .. } => match comptime {
            RuntimeOnly => (),
            _ => return Result::Err("foreign function artifacts must be runtime-only"),
        },
        _ => (),
    }
    if let GoInterfaceBridge { methods, .. } = body {
        tast::validate_go_interface_bridge_callable(methods, ty)?;
    }
    if let GoMethod { .. } = body {
        match tast::resolve_type(ty) {
            Func { params, ret_ty: _ } if !params.is_empty() => (),
            _ => return Result::Err("foreign method artifacts require a receiver parameter"),
        }
    }
    Result::Ok(artifact::ArtifactFnScheme { name, comptime, type_params, constraints, ty, body })
}

fn artifact_decode_fn_map(context: tast_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    Vec[artifact::ArtifactFnScheme],
    string,
] {
    let object = wire::artifact_json_object(value, "function map")?;
    let result: Vec[artifact::ArtifactFnScheme] = Vec::new();
    for item in object {
        result.push(artifact_decode_fn_scheme(context, item.0, item.1)?)
    }
    Result::Ok(result)
}

fn artifact_decode_type_pairs(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
    expected: string,
) -> Result[Vec[(string, tast::Type)], string] {
    let values = wire::artifact_json_array(value, expected)?;
    let result: Vec[(string, tast::Type)] = Vec::new();
    for value in values {
        let pair = wire::artifact_json_array(value, expected)?;
        if pair.len() != 2 {
            return Result::Err(wire::artifact_decode_error(expected))
        }
        let name = wire::artifact_json_string_value(pair[0], expected)?;
        result.push((name, tast_codec::artifact_decode_type(context, pair[1])?))
    }
    Result::Ok(result)
}

fn artifact_decode_enum_variant_fields(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[tast::EnumVariantFields, string] {
    match value {
        String(name) => if name == "Unit" {
            Result::Ok(tast::EnumVariantFields::Unit)
        } else {
            Result::Err(wire::artifact_decode_error("enum variant fields"))
        },
        Object(object) => if object.len() == 1 {
            let item = object[0];
            if item.0 == "Tuple" {
                match tast_codec::artifact_decode_type_array(context, item.1, "enum tuple fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Tuple(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else if item.0 == "Struct" {
                match artifact_decode_type_pairs(context, item.1, "enum struct fields") {
                    Ok(fields) => {
                        Result::Ok(tast::EnumVariantFields::Struct(fields))
                    },
                    Err(error) => Result::Err(error),
                }
            } else {
                Result::Err(wire::artifact_decode_error("enum variant fields"))
            }
        } else {
            Result::Err(wire::artifact_decode_error("enum variant fields"))
        },
        _ => Result::Err(wire::artifact_decode_error("enum variant fields")),
    }
}

fn artifact_decode_enum_def(context: tast_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    tast::EnumDef,
    string,
] {
    let object = wire::artifact_json_object(value, "enum definition")?;
    let map_requirements = tast_codec::artifact_decode_type_array(
        context,
        wire::artifact_json_required_field(object, "map_requirements")?,
        "map requirements",
    )?;
    let name = wire::artifact_json_field_string(object, "name")?;
    tast_codec::artifact_add_type_name(context.enum_names, name);
    let generics = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "generics")?,
        "enum generics",
    )?;
    let option_variants = match wire::artifact_json_optional_field(object, "option_variants")? {
        Some(value) => match value {
            Null => Option::None,
            other => {
                let names = wire::artifact_decode_string_array(other, "Option variant names")?;
                if names.len() == 2 {
                    Option::Some((names[0], names[1]))
                } else {
                    return Result::Err(wire::artifact_decode_error("Option variant names"))
                }
            },
        },
        None => Option::None,
    };
    let values = wire::artifact_json_field_array(object, "variants")?;
    let variants: Vec[tast::EnumVariantDef] = Vec::new();
    for value in values {
        let variant = wire::artifact_json_object(value, "enum variant")?;
        let variant_name = wire::artifact_json_field_string(variant, "name")?;
        let fields_value = wire::artifact_json_required_field(variant, "fields")?;
        let fields = artifact_decode_enum_variant_fields(context, fields_value)?;
        variants.push(tast::EnumVariantDef { name: variant_name, fields })
    }
    Result::Ok(tast::EnumDef { name, generics, variants, option_variants, map_requirements })
}

fn artifact_decode_struct_def(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[tast::StructDef, string] {
    let object = wire::artifact_json_object(value, "struct definition")?;
    let map_requirements = tast_codec::artifact_decode_type_array(
        context,
        wire::artifact_json_required_field(object, "map_requirements")?,
        "map requirements",
    )?;
    let name = wire::artifact_json_field_string(object, "name")?;
    tast_codec::artifact_add_type_name(context.struct_names, name);
    let generics = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "generics")?,
        "struct generics",
    )?;
    let fields = artifact_decode_type_pairs(
        context,
        wire::artifact_json_required_field(object, "fields")?,
        "struct fields",
    )?;
    let public_fields: Vec[string] = Vec::new();
    for field in fields {
        public_fields.push(field.0)
    }
    let has_hidden_fields = wire::artifact_json_bool_value(
        wire::artifact_json_required_field(object, "has_hidden_fields")?,
        "struct hidden fields flag",
    )?;
    let go_comparable = artifact_decode_struct_comparability(
        wire::artifact_json_required_field(object, "go_comparable")?,
        generics.len(),
    )?;
    Result::Ok(
        tast::StructDef {
            map_requirements,
            name,
            generics,
            fields,
            public_fields,
            has_hidden_fields,
            go_comparable,
        },
    )
}

fn artifact_decode_type_alias(
    context: tast_codec::ArtifactDecodeContext,
    name: string,
    value: wire::ArtifactValue,
) -> Result[tast::TypeAliasInfo, string] {
    let object = wire::artifact_json_object(value, "type alias")?;
    let generics = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "generics")?,
        "type alias generics",
    )?;
    let ty = tast_codec::artifact_decode_type(
        context,
        wire::artifact_json_required_field(object, "ty")?,
    )?;
    Result::Ok(
        tast::TypeAliasInfo {
            go_comparable: Option::None,
            applications: Option::None,
            name,
            generics,
            ty,
        },
    )
}

fn artifact_decode_associated_type_defs(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[artifact::ArtifactAssociatedTypeDef], string] {
    let object = wire::artifact_json_object(value, "associated type definitions")?;
    let result: Vec[artifact::ArtifactAssociatedTypeDef] = Vec::new();
    for item in object {
        let definition = wire::artifact_json_object(item.1, "associated type definition")?;
        let bounds = artifact_decode_trait_refs(
            context,
            wire::artifact_json_required_field(definition, "bounds")?,
        )?;
        result.push(artifact::ArtifactAssociatedTypeDef { name: item.0, bounds })
    }
    Result::Ok(result)
}

fn artifact_decode_trait_def(
    context: tast_codec::ArtifactDecodeContext,
    name: string,
    value: wire::ArtifactValue,
) -> Result[artifact::ArtifactTraitDef, string] {
    let object = wire::artifact_json_object(value, "trait definition")?;
    let params = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "params")?,
        "trait parameters",
    )?;
    let predicates = artifact_decode_predicates(
        context,
        wire::artifact_json_required_field(object, "predicates")?,
    )?;
    let supertraits = artifact_decode_trait_refs(
        context,
        wire::artifact_json_required_field(object, "supertraits")?,
    )?;
    let associated_types = artifact_decode_associated_type_defs(
        context,
        wire::artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(
        context,
        wire::artifact_json_required_field(object, "methods")?,
    )?;
    let default_map_requirements = artifact_decode_default_map_requirements(
        context,
        object,
        methods,
    )?;
    Result::Ok(
        artifact::ArtifactTraitDef {
            default_map_requirements,
            name,
            params,
            predicates,
            supertraits,
            associated_types,
            methods,
        },
    )
}

fn artifact_decode_associated_types(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[(string, tast::Type)], string] {
    let object = wire::artifact_json_object(value, "associated types")?;
    let result: Vec[(string, tast::Type)] = Vec::new();
    for item in object {
        result.push((item.0, tast_codec::artifact_decode_type(context, item.1)?))
    }
    Result::Ok(result)
}

fn artifact_decode_impl_def(context: tast_codec::ArtifactDecodeContext, value: wire::ArtifactValue) -> Result[
    artifact::ArtifactImplDef,
    string,
] {
    let object = wire::artifact_json_object(value, "implementation definition")?;
    let params = wire::artifact_decode_string_array(
        wire::artifact_json_required_field(object, "params")?,
        "implementation parameters",
    )?;
    let constraints = artifact_decode_predicates(
        context,
        wire::artifact_json_required_field(object, "constraints")?,
    )?;
    let associated_types = artifact_decode_associated_types(
        context,
        wire::artifact_json_required_field(object, "associated_types")?,
    )?;
    let methods = artifact_decode_fn_map(
        context,
        wire::artifact_json_required_field(object, "methods")?,
    )?;
    let valid = match wire::artifact_json_optional_field(object, "valid")? {
        Some(value) => wire::artifact_json_bool_value(value, "implementation validity")?,
        None => true,
    };
    Result::Ok(artifact::ArtifactImplDef { params, constraints, associated_types, methods, valid })
}

fn artifact_decode_trait_impls(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[artifact::ArtifactTraitImpl], string] {
    let values = wire::artifact_json_array(value, "trait implementations")?;
    let result: Vec[artifact::ArtifactTraitImpl] = Vec::new();
    for value in values {
        let pair = wire::artifact_json_array(value, "trait implementation")?;
        if pair.len() != 2 {
            return Result::Err(wire::artifact_decode_error("trait implementation pair"))
        }
        let key = wire::artifact_json_object(pair[0], "trait implementation key")?;
        let trait_ref = tast_codec::artifact_decode_trait_ref(
            context,
            wire::artifact_json_required_field(key, "trait_ref")?,
        )?;
        let for_ty = tast_codec::artifact_decode_type(
            context,
            wire::artifact_json_required_field(key, "for_ty")?,
        )?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact::ArtifactTraitImpl { trait_ref, for_ty, definition })
    }
    Result::Ok(result)
}

fn artifact_decode_inherent_impl_key(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[artifact::ArtifactInherentImplKey, string] {
    let object = wire::artifact_json_object(value, "inherent implementation key")?;
    if object.len() != 1 {
        Result::Err(wire::artifact_decode_error("inherent implementation key variant"))
    } else if object[0].0 == "Exact" {
        tast_codec::artifact_decode_type(context, object[0].1).map(
            |value| artifact::ArtifactInherentImplKey::Exact(value),
        )
    } else if object[0].0 == "Constr" {
        wire::artifact_json_string_value(object[0].1, "inherent constructor").map(
            |value| artifact::ArtifactInherentImplKey::Constr(value),
        )
    } else {
        Result::Err(wire::artifact_decode_error("inherent implementation key"))
    }
}

fn artifact_decode_inherent_impls(
    context: tast_codec::ArtifactDecodeContext,
    value: wire::ArtifactValue,
) -> Result[Vec[artifact::ArtifactInherentImpl], string] {
    let values = wire::artifact_json_array(value, "inherent implementations")?;
    let result: Vec[artifact::ArtifactInherentImpl] = Vec::new();
    for value in values {
        let pair = wire::artifact_json_array(value, "inherent implementation")?;
        if pair.len() != 2 {
            return Result::Err(wire::artifact_decode_error("inherent implementation pair"))
        }
        let key = artifact_decode_inherent_impl_key(context, pair[0])?;
        let definition = artifact_decode_impl_def(context, pair[1])?;
        result.push(artifact::ArtifactInherentImpl { key, definition })
    }
    Result::Ok(result)
}

pub fn decode_exports(value: wire::ArtifactValue) -> Result[
    artifact::ArtifactPackageExports,
    string,
] {
    let context = tast_codec::new_artifact_decode_context();
    let object = wire::artifact_json_object(value, "package exports")?;
    let reexport_map = wire::artifact_json_field_object(object, "reexports")?;
    let reexports: Vec[(string, string)] = Vec::new();
    for item in reexport_map {
        reexports.push((item.0, wire::artifact_json_string_value(item.1, "re-export target")?))
    }
    let type_env = wire::artifact_json_field_object(object, "type_env")?;
    let enum_map = wire::artifact_json_field_object(type_env, "enums")?;
    let struct_map = wire::artifact_json_field_object(type_env, "structs")?;
    for item in enum_map {
        tast_codec::artifact_add_type_name(context.enum_names, item.0)
    }
    for item in struct_map {
        tast_codec::artifact_add_type_name(context.struct_names, item.0)
    }
    let enums: Vec[tast::EnumDef] = Vec::new();
    for item in enum_map {
        let value = artifact_decode_enum_def(context, item.1)?;
        if value.name == item.0 {
            enums.push(value)
        } else {
            return Result::Err(wire::artifact_decode_error("matching enum name"))
        }
    }
    let structs: Vec[tast::StructDef] = Vec::new();
    for item in struct_map {
        let value = artifact_decode_struct_def(context, item.1)?;
        if value.name == item.0 {
            structs.push(value)
        } else {
            return Result::Err(wire::artifact_decode_error("matching struct name"))
        }
    }
    let alias_map = wire::artifact_json_field_object(type_env, "aliases")?;
    let type_aliases: Vec[tast::TypeAliasInfo] = Vec::new();
    for item in alias_map {
        type_aliases.push(artifact_decode_type_alias(context, item.0, item.1)?)
    }
    let trait_env = wire::artifact_json_field_object(object, "trait_env")?;
    let trait_map = wire::artifact_json_field_object(trait_env, "trait_defs")?;
    let traits: Vec[artifact::ArtifactTraitDef] = Vec::new();
    for item in trait_map {
        traits.push(artifact_decode_trait_def(context, item.0, item.1)?)
    }
    let trait_impls = artifact_decode_trait_impls(
        context,
        wire::artifact_json_required_field(trait_env, "trait_impls")?,
    )?;
    let inherent_impls = artifact_decode_inherent_impls(
        context,
        wire::artifact_json_required_field(trait_env, "inherent_impls")?,
    )?;
    let value_env = wire::artifact_json_field_object(object, "value_env")?;
    let functions = artifact_decode_fn_map(
        context,
        wire::artifact_json_required_field(value_env, "funcs")?,
    )?;
    let constant_map = wire::artifact_json_field_object(value_env, "consts")?;
    let constants: Vec[tast::ConstantScheme] = Vec::new();
    for item in constant_map {
        let definition = wire::artifact_json_object(item.1, "constant scheme")?;
        let ty = tast_codec::artifact_decode_type(
            context,
            wire::artifact_json_required_field(definition, "ty")?,
        )?;
        constants.push(
            tast::ConstantScheme { def_id: Option::None, name: item.0, ty, value: Option::None },
        )
    }
    Result::Ok(
        artifact::ArtifactPackageExports {
            go_exports: decode_go_exports(
                context,
                wire::artifact_json_required_field(object, "go_exports")?,
                functions,
            )?,
            reexports,
            enum_type_names: context.enum_names,
            struct_type_names: context.struct_names,
            type_aliases,
            enums,
            structs,
            traits,
            trait_impls,
            inherent_impls,
            functions,
            constants,
        },
    )
}

fn artifact_decode_package_interface(value: wire::ArtifactValue) -> Result[
    artifact::ArtifactPackageInterface,
    string,
] {
    let object = wire::artifact_json_object(value, "package interface")?;
    let package_name = wire::artifact_json_field_string(object, "package")?;
    let name = wire::artifact_json_field_string(object, "name")?;
    let value_map = wire::artifact_json_field_object(object, "value_exports")?;
    let value_exports: Vec[(string, isize)] = Vec::new();
    for item in value_map {
        let number = wire::artifact_json_number_value(item.1, "value export index")?;
        value_exports.push((item.0, wire::artifact_parse_nonnegative_int(number)?))
    }
    let enum_map = wire::artifact_json_field_object(object, "enum_variants")?;
    let enum_variants: Vec[(string, Vec[string])] = Vec::new();
    for item in enum_map {
        enum_variants.push(
            (item.0, wire::artifact_decode_string_array(item.1, "enum variant names")?),
        )
    }
    Result::Ok(
        artifact::ArtifactPackageInterface { package_name, name, value_exports, enum_variants },
    )
}

pub fn artifact_decode_string_map(value: wire::ArtifactValue, expected: string) -> Result[
    Vec[(string, string)],
    string,
] {
    let object = wire::artifact_json_object(value, expected)?;
    let result: Vec[(string, string)] = Vec::new();
    for item in object {
        result.push((item.0, wire::artifact_json_string_value(item.1, expected)?))
    }
    Result::Ok(result)
}

pub fn artifact_decode_interface_value(value: wire::ArtifactValue) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    let object = wire::artifact_json_object(value, "interface unit")?;
    let format_version = wire::artifact_parse_nonnegative_int(
        wire::artifact_json_number_value(
            wire::artifact_json_required_field(object, "format_version")?,
            "interface format version",
        )?,
    )?;
    let compiler_abi = wire::artifact_parse_nonnegative_int(
        wire::artifact_json_number_value(
            wire::artifact_json_required_field(object, "compiler_abi")?,
            "compiler ABI",
        )?,
    )?;
    if format_version != 30 {
        return Result::Err("unsupported interface artifact format version")
    } else if compiler_abi != 5 {
        return Result::Err("unsupported interface compiler ABI")
    }
    let package_name = wire::artifact_json_field_string(object, "package")?;
    let exports = decode_exports(wire::artifact_json_required_field(object, "exports")?)?;
    let package_interface = artifact_decode_package_interface(
        wire::artifact_json_required_field(object, "interface")?,
    )?;
    validate_go_export_package(package_name, exports)?;
    for value in exports.go_exports {
        let mut public = false;
        for (name, _) in package_interface.value_exports {
            if name == value.symbol {
                public = true;
            }
        }
        if !public {
            return Result::Err("Go export is absent from public package interface")
        }
    }
    let comptime = match wire::artifact_json_required_field(object, "comptime")? {
        wire::ArtifactValue::Null => Option::None,
        value => Option::Some(artifact_decode_comptime_unit(value)?),
    };
    let deps = artifact_decode_string_map(
        wire::artifact_json_required_field(object, "deps")?,
        "dependency hashes",
    )?;
    let interface_hash = wire::artifact_json_field_string(object, "interface_hash")?;
    let foreign_bindings = decode_foreign_bindings(
        wire::artifact_json_required_field(object, "foreign_bindings")?,
    )?;
    let result = artifact::ArtifactInterfaceUnit {
        foreign_types: decode_foreign_type_metadata(
            wire::artifact_json_required_field(object, "foreign_types")?,
        )?,
        foreign_bindings,
        package_name,
        exports,
        package_interface,
        comptime,
        deps,
        interface_hash,
    };
    if result.package_name != result.package_interface.package_name {
        Result::Err(wire::artifact_decode_error("matching interface package"))
    } else if artifact_interface_hash(result) != result.interface_hash {
        Result::Err(wire::artifact_decode_error("valid interface hash"))
    } else {
        Result::Ok(result)
    }
}
