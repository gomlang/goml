package interface_codec;

use module::artifact::wire as wire;
use module::artifact;
use std::bytes;

pub fn artifact_binary_interface_sections(value: artifact::ArtifactInterfaceUnit) -> Result[
    Vec[wire::ArtifactBinarySection],
    string,
] {
    let collector = wire::new_artifact_binary_string_collector();
    artifact_json_interface_unit(collector, value);
    let table = wire::artifact_binary_collected_string_table(collector);
    let writer = wire::new_artifact_binary_value_stream(table);
    artifact_json_interface_unit(writer, value);
    let payload = wire::encode_artifact_binary_value_index(
        table,
        wire::artifact_binary_stream_finish(writer)?.as_slice(),
    )?;
    Ok(
        Vec::from_array(
            [
                wire::ArtifactBinarySection {
                    id: wire::string_table_section_id(),
                    version: 1,
                    flags: wire::required_section_flag(),
                    data: wire::encode_artifact_binary_string_table(table),
                },
                wire::ArtifactBinarySection {
                    id: wire::value_section_id(),
                    version: 15,
                    flags: wire::required_section_flag(),
                    data: payload,
                },
            ],
        ),
    )
}

pub fn encode_binary(value: artifact::ArtifactInterfaceUnit) -> Result[bytes::Bytes, string] {
    let sections = artifact_binary_interface_sections(value)?;
    wire::encode_artifact_binary_container(1, sections)
}

fn artifact_binary_validate_interface_sections(value: wire::ArtifactBinaryContainerView) -> Result[
    (),
    string,
] {
    for section in value.sections {
        if section.id == wire::string_table_section_id() {
            if section.version != 1 {
                return Err("unsupported binary interface artifact section version")
            } else if section.flags != wire::required_section_flag() {
                return Err("invalid binary interface artifact section flags")
            }
        } else if section.id == wire::value_section_id() {
            if section.version != 15 {
                return Err("unsupported binary interface artifact section version")
            } else if section.flags != wire::required_section_flag() {
                return Err("invalid binary interface artifact section flags")
            }
        } else if section.flags & wire::required_section_flag() != 0 {
            return Err("unsupported required binary interface artifact section")
        }
    }
    Ok(())
}

pub fn decode_binary(data: bytes::Bytes) -> Result[artifact::ArtifactInterfaceUnit, string] {
    decode_binary_container(wire::decode_artifact_binary_container_view(data.as_slice())?)
}

pub fn decode_verified_binary(data: bytes::Bytes) -> Result[artifact::ArtifactInterfaceUnit, string] {
    decode_binary_container(wire::decode_verified_artifact_binary_container_view(data.as_slice())?)
}

fn decode_binary_container(container: wire::ArtifactBinaryContainerView) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    if container.kind != 1 {
        return Err("binary artifact is not an interface")
    }
    artifact_binary_validate_interface_sections(container)?;
    let string_section = match wire::artifact_binary_find_section_view(
        container,
        wire::string_table_section_id(),
    ) {
        Some(value) => value,
        None => {
            return Err("binary interface artifact is missing string table")
        },
    };
    let value_section = match wire::artifact_binary_find_section_view(
        container,
        wire::value_section_id(),
    ) {
        Some(value) => value,
        None => {
            return Err("binary interface artifact is missing value")
        },
    };
    let table = wire::decode_artifact_binary_string_table_view(string_section.data)?;
    let value = wire::decode_artifact_binary_value_index(table, value_section.data)?;
    decode_checked_value(value)
}

fn decode_checked_value(value: wire::ArtifactValue) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    let result = artifact_decode_interface_value(value);
    wire::artifact_binary_value_valid(value).map_err(|error| "Interface decoding: " + error)?;
    result
}

pub fn decode_verified_binary_view(data: Slice[byte]) -> Result[
    artifact::ArtifactInterfaceUnit,
    string,
] {
    decode_binary_container(wire::decode_verified_artifact_binary_container_view(data)?)
}
