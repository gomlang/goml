package interface_codec;

use module::artifact::wire;
use module::artifact::tast_codec;
use module::tast;
use std::testing;

fn raw_function_metadata_without_requirement(value: wire::ArtifactValue) -> wire::ArtifactValue {
    let fields = Vec::new();
    if let Object(entries) = value {
        for entry in entries {
            if entry.0 != "raw_function_requirements" {
                fields.push(entry)
            }
        }
    }
    wire::ArtifactValue::Object(fields)
}

#[test]
fn raw_function_requirements_round_trip_without_exposing_private_fields() -> () {
    let requirement = tast::Type::GoFunction {
        signature: tast::Type::Func {
            params: Vec::from_array([tast::Type::Param { name: "T" }]),
            ret_ty: tast::Type::Unit,
        },
    };
    let value = tast::StructDef {
        name: "audit::Callbacks",
        generics: Vec::from_array(["T"]),
        fields: Vec::new(),
        public_fields: Vec::new(),
        module_fields: Vec::new(),
        has_hidden_fields: true,
        go_comparable: None,
        map_requirements: Vec::new(),
        raw_function_requirements: Vec::from_array([requirement]),
        const_requirements: Vec::new(),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_struct_def(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    );
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode struct");
    let decoded = testing::expect_ok(
        artifact_decode_struct_def(tast_codec::new_artifact_decode_context(), encoded),
        "decode struct",
    );
    testing::assert(decoded.has_hidden_fields);
    testing::assert(decoded.fields.is_empty());
    testing::assert_eq(decoded.raw_function_requirements.len(), 1);
    testing::assert(tast::types_equal(decoded.raw_function_requirements[0], requirement));
    testing::assert(
        artifact_decode_struct_def(
            tast_codec::new_artifact_decode_context(),
            raw_function_metadata_without_requirement(encoded),
        ).is_err(),
    );
    let value = tast::EnumDef {
        name: "audit::Choice",
        generics: Vec::from_array(["T"]),
        variants: Vec::new(),
        option_variants: None,
        map_requirements: Vec::new(),
        raw_function_requirements: Vec::from_array([requirement]),
        const_requirements: Vec::new(),
    };
    let writer = wire::new_artifact_value_writer();
    artifact_json_enum_def(writer, tast_codec::artifact_type_context(Vec::new(), Vec::new()), value);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode enum");
    let decoded = testing::expect_ok(
        artifact_decode_enum_def(tast_codec::new_artifact_decode_context(), encoded),
        "decode enum",
    );
    testing::assert_eq(decoded.raw_function_requirements.len(), 1);
    testing::assert(tast::types_equal(decoded.raw_function_requirements[0], requirement));
    testing::assert(
        artifact_decode_enum_def(
            tast_codec::new_artifact_decode_context(),
            raw_function_metadata_without_requirement(encoded),
        ).is_err(),
    );
}
