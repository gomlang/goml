package wire;

pub fn artifact_decode_error(expected: string) -> string {
    "invalid compiler artifact: expected " + expected
}

pub fn artifact_json_object(value: ArtifactValue, expected: string) -> Result[
    ArtifactObject,
    string,
] {
    match value {
        Object(_) => Ok(ArtifactObject { value }),
        Indexed(view) if artifact_binary_node(view, view.index).tag == 6 => {
            artifact_binary_validate_children(view, true)?;
            Result::Ok(ArtifactObject { value })
        },
        _ => Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_array(value: ArtifactValue, expected: string) -> Result[ArtifactArray, string] {
    match value {
        Array(_) => Ok(ArtifactArray { value }),
        Indexed(view) if artifact_binary_node(view, view.index).tag == 5 => {
            artifact_binary_validate_children(view, false)?;
            Result::Ok(ArtifactArray { value })
        },
        _ => Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_string_value(value: ArtifactValue, expected: string) -> Result[string, string] {
    match value {
        String(value) => Ok(value),
        _ => Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_number_value(value: ArtifactValue, expected: string) -> Result[string, string] {
    match value {
        Number(value) => Ok(value),
        _ => Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_bool_value(value: ArtifactValue, expected: string) -> Result[bool, string] {
    match value {
        Bool(value) => Ok(value),
        _ => Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_required_field(values: ArtifactObject, name: string) -> Result[
    ArtifactValue,
    string,
] {
    artifact_json_optional_field(values, name)?.ok_or(artifact_decode_error("field " + name))
}

pub fn artifact_json_optional_field(values: ArtifactObject, name: string) -> Result[
    Option[ArtifactValue],
    string,
] {
    let mut found: Option[ArtifactValue] = Option::None;
    for field in values {
        if field.0 == name {
            if found.is_some() {
                return Err(artifact_decode_error("field " + name))
            }
            found = Option::Some(field.1);
        }
    }
    Ok(found)
}

pub fn artifact_json_field_string(values: ArtifactObject, name: string) -> Result[string, string] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_string_value(value, "string field " + name),
    )
}

pub fn artifact_json_field_array(values: ArtifactObject, name: string) -> Result[
    ArtifactArray,
    string,
] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_array(value, "array field " + name),
    )
}

pub fn artifact_json_field_object(values: ArtifactObject, name: string) -> Result[
    ArtifactObject,
    string,
] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_object(value, "object field " + name),
    )
}

pub fn artifact_parse_nonnegative_int(value: string) -> Result[isize, string] {
    if value.byte_len() == 0 {
        Err(artifact_decode_error("nonnegative integer"))
    } else {
        let mut result = 0;
        for index in 0..value.byte_len() {
            let byte = value.byte_get(index);
            if byte < b'0' || byte > b'9' {
                return Err(artifact_decode_error("nonnegative integer"))
            } else {
                result = result * 10 + (byte - 48).to_i64();
            }
            if result > 2147483647 {
                return Err(artifact_decode_error("32-bit integer"))
            }
        }
        Ok(result.to_isize())
    }
}

pub fn artifact_decode_string_array(value: ArtifactValue, expected: string) -> Result[
    Vec[string],
    string,
] {
    let values = artifact_json_array(value, expected)?;
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(artifact_json_string_value(value, expected)?)
    }
    Ok(result)
}
