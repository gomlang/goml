package wire;

pub fn artifact_decode_error(expected: string) -> string {
    "invalid compiler artifact: expected " + expected
}

pub fn artifact_json_object(value: ArtifactValue, expected: string) -> Result[
    Vec[(string, ArtifactValue)],
    string,
] {
    match value {
        Object(value) => Result::Ok(value),
        _ => Result::Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_array(value: ArtifactValue, expected: string) -> Result[
    Vec[ArtifactValue],
    string,
] {
    match value {
        Array(value) => Result::Ok(value),
        _ => Result::Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_string_value(value: ArtifactValue, expected: string) -> Result[string, string] {
    match value {
        String(value) => Result::Ok(value),
        _ => Result::Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_number_value(value: ArtifactValue, expected: string) -> Result[string, string] {
    match value {
        Number(value) => Result::Ok(value),
        _ => Result::Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_bool_value(value: ArtifactValue, expected: string) -> Result[bool, string] {
    match value {
        Bool(value) => Result::Ok(value),
        _ => Result::Err(artifact_decode_error(expected)),
    }
}

pub fn artifact_json_required_field(values: Vec[(string, ArtifactValue)], name: string) -> Result[
    ArtifactValue,
    string,
] {
    let matches: Vec[ArtifactValue] = Vec::new();
    for value in values {
        if value.0 == name {
            matches.push(value.1)
        }
    }
    if matches.len() != 1 {
        Result::Err(artifact_decode_error("field " + name))
    } else {
        Result::Ok(matches[0])
    }
}

pub fn artifact_json_optional_field(values: Vec[(string, ArtifactValue)], name: string) -> Result[
    Option[ArtifactValue],
    string,
] {
    let matches: Vec[ArtifactValue] = Vec::new();
    for value in values {
        if value.0 == name {
            matches.push(value.1)
        }
    }
    if matches.len() > 1 {
        Result::Err(artifact_decode_error("field " + name))
    } else if matches.len() == 1 {
        Result::Ok(Option::Some(matches[0]))
    } else {
        Result::Ok(Option::None)
    }
}

pub fn artifact_json_field_string(values: Vec[(string, ArtifactValue)], name: string) -> Result[
    string,
    string,
] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_string_value(value, "string field " + name),
    )
}

pub fn artifact_json_field_array(values: Vec[(string, ArtifactValue)], name: string) -> Result[
    Vec[ArtifactValue],
    string,
] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_array(value, "array field " + name),
    )
}

pub fn artifact_json_field_object(values: Vec[(string, ArtifactValue)], name: string) -> Result[
    Vec[(string, ArtifactValue)],
    string,
] {
    artifact_json_required_field(values, name).and_then(
        |value| artifact_json_object(value, "object field " + name),
    )
}

pub fn artifact_parse_nonnegative_int(value: string) -> Result[isize, string] {
    if value.byte_len() == 0 {
        Result::Err(artifact_decode_error("nonnegative integer"))
    } else {
        let mut result = 0;
        for index in 0..value.byte_len() {
            let byte = value.byte_get(index);
            if byte < b'0' || byte > b'9' {
                return Result::Err(artifact_decode_error("nonnegative integer"))
            } else {
                result = result * 10 + (byte - 48).to_i64();
            }
            if result > 2147483647 {
                return Result::Err(artifact_decode_error("32-bit integer"))
            }
        }
        Result::Ok(result.to_isize())
    }
}

pub fn artifact_decode_string_array(value: ArtifactValue, expected: string) -> Result[
    Vec[string],
    string,
] {
    let values = artifact_json_array(value, expected)?;
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(artifact_json_string_value(value, expected)?)
    }
    Result::Ok(result)
}
