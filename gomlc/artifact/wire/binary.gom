package wire;

use std::bytes;
use std::panic;
use std::bytes::endian;
use std::utf8;
use utf8::BytesUtf8;

pub struct ArtifactBinaryWriter {
    data: endian::Builder,
}

pub struct ArtifactBinaryReader {
    data: Slice[byte],
    offset: Ref[isize],
}

pub fn new_artifact_binary_writer() -> ArtifactBinaryWriter {
    ArtifactBinaryWriter { data: endian::Builder::new() }
}

pub fn new_artifact_binary_reader(data: bytes::Bytes) -> ArtifactBinaryReader {
    ArtifactBinaryReader { data: data.as_slice(), offset: Ref::new(0) }
}

fn artifact_binary_writer_len(writer: ArtifactBinaryWriter) -> isize {
    writer.data.len()
}

pub fn artifact_binary_writer_finish(writer: ArtifactBinaryWriter) -> bytes::Bytes {
    writer.data.finish()
}

fn artifact_binary_write_u8(writer: ArtifactBinaryWriter, value: u8) -> () {
    writer.data.write_u8(value)
}

fn artifact_binary_write_u16(writer: ArtifactBinaryWriter, value: u16) -> () {
    writer.data.write_u16(value, endian::Endian::Little)
}

fn artifact_binary_write_u32(writer: ArtifactBinaryWriter, value: u32) -> () {
    writer.data.write_u32(value, endian::Endian::Little)
}

pub fn artifact_binary_write_u64(writer: ArtifactBinaryWriter, value: u64) -> () {
    writer.data.write_u64(value, endian::Endian::Little)
}

fn artifact_binary_write_uleb128(writer: ArtifactBinaryWriter, value: u64) -> () {
    let data = writer.data.to_vec();
    let offset = data.len();
    let length = endian::uvarint_len(value);
    data.reserve(length);
    for _ in 0..length {
        data.push(0)
    }
    let _ = endian::write_uvarint(data.as_mut_slice(), offset, value).unwrap_or_else(
        |error| panic::raise(error.to_string()),
    );
}

fn artifact_binary_write_bytes(writer: ArtifactBinaryWriter, value: bytes::Bytes) -> () {
    artifact_binary_write_uleb128(writer, value.len().to_u64());
    writer.data.extend(value.as_slice())
}

fn artifact_binary_write_raw_bytes(writer: ArtifactBinaryWriter, value: bytes::Bytes) -> () {
    writer.data.extend(value.as_slice())
}

pub fn artifact_binary_write_string(writer: ArtifactBinaryWriter, value: string) -> () {
    artifact_binary_write_bytes(writer, bytes::Bytes::from_string(value))
}

fn artifact_binary_patch_u32(writer: ArtifactBinaryWriter, offset: isize, value: u32) -> Result[
    (),
    string,
] {
    let output = writer.data.to_vec().as_mut_slice();
    match endian::write_u32(output, offset, value, endian::Endian::Little) {
        Ok(()) => Result::Ok(()),
        Err(_) => Result::Err("binary patch offset out of bounds"),
    }
}

pub fn artifact_binary_reader_offset(reader: ArtifactBinaryReader) -> isize {
    reader.offset.get()
}

pub fn artifact_binary_reader_set_offset(reader: ArtifactBinaryReader, value: isize) -> () {
    reader.offset.set(value)
}

pub fn artifact_binary_reader_remaining(reader: ArtifactBinaryReader) -> isize {
    reader.data.len() - reader.offset.get()
}

fn artifact_binary_reader_error(reader: ArtifactBinaryReader, message: string) -> string {
    f"binary artifact at byte {reader.offset.get()}: {message}"
}

pub fn artifact_binary_read_u8(reader: ArtifactBinaryReader) -> Result[u8, string] {
    let offset = reader.offset.get();
    match endian::read_u8(reader.data, offset) {
        Ok(value) => {
            reader.offset.set(offset + 1);
            Result::Ok(value)
        },
        Err(_) => Result::Err(artifact_binary_reader_error(reader, "unexpected end of input")),
    }
}

fn artifact_binary_read_u16(reader: ArtifactBinaryReader) -> Result[u16, string] {
    let offset = reader.offset.get();
    match endian::read_u16(reader.data, offset, endian::Endian::Little) {
        Ok(value) => {
            reader.offset.set(offset + 2);
            Result::Ok(value)
        },
        Err(_) => Result::Err(artifact_binary_reader_error(reader, "unexpected end of input")),
    }
}

pub fn artifact_binary_read_u32(reader: ArtifactBinaryReader) -> Result[u32, string] {
    let offset = reader.offset.get();
    match endian::read_u32(reader.data, offset, endian::Endian::Little) {
        Ok(value) => {
            reader.offset.set(offset + 4);
            Result::Ok(value)
        },
        Err(_) => Result::Err(artifact_binary_reader_error(reader, "unexpected end of input")),
    }
}

pub fn artifact_binary_read_u64(reader: ArtifactBinaryReader) -> Result[u64, string] {
    let offset = reader.offset.get();
    match endian::read_u64(reader.data, offset, endian::Endian::Little) {
        Ok(value) => {
            reader.offset.set(offset + 8);
            Result::Ok(value)
        },
        Err(_) => Result::Err(artifact_binary_reader_error(reader, "unexpected end of input")),
    }
}

fn artifact_binary_read_uleb128(reader: ArtifactBinaryReader) -> Result[u64, string] {
    match endian::read_uvarint(reader.data, reader.offset.get()) {
        Ok((value, count)) => {
            reader.offset.set(reader.offset.get() + count);
            Ok(value)
        },
        Err(Truncated(offset)) => {
            reader.offset.set(offset);
            Err(artifact_binary_reader_error(reader, "unexpected end of input"))
        },
        Err(Overflow(offset)) => {
            reader.offset.set(offset + 1);
            Err(artifact_binary_reader_error(reader, "unsigned varint overflow"))
        },
        Err(InvalidOffset(_)) => Err(
            artifact_binary_reader_error(reader, "unexpected end of input"),
        ),
    }
}

fn artifact_binary_read_length(reader: ArtifactBinaryReader) -> Result[isize, string] {
    match artifact_binary_read_uleb128(reader) {
        Ok(value) => if value > 2147483647 {
            Result::Err(artifact_binary_reader_error(reader, "collection length exceeds limit"))
        } else {
            Result::Ok(value.to_isize())
        },
        Err(error) => Result::Err(error),
    }
}

fn artifact_binary_read_bytes(reader: ArtifactBinaryReader) -> Result[bytes::Bytes, string] {
    let length = artifact_binary_read_length(reader)?;
    if length > artifact_binary_reader_remaining(reader) {
        Result::Err(artifact_binary_reader_error(reader, "byte sequence exceeds remaining input"))
    } else {
        let offset = reader.offset.get();
        let result = bytes::Bytes::with_capacity(length);
        for index in 0..length {
            result.push(reader.data.get(offset + index))
        }
        reader.offset.set(offset + length);
        Result::Ok(result)
    }
}

fn artifact_binary_read_raw_bytes(reader: ArtifactBinaryReader, length: isize) -> Result[
    bytes::Bytes,
    string,
] {
    if length < 0 || length > artifact_binary_reader_remaining(reader) {
        Result::Err(artifact_binary_reader_error(reader, "byte sequence exceeds remaining input"))
    } else {
        let offset = reader.offset.get();
        let result = bytes::Bytes::with_capacity(length);
        for index in 0..length {
            result.push(reader.data.get(offset + index))
        }
        reader.offset.set(offset + length);
        Result::Ok(result)
    }
}

pub fn artifact_binary_read_string(reader: ArtifactBinaryReader) -> Result[string, string] {
    match artifact_binary_read_bytes(reader) {
        Ok(value) => value.to_string_utf8().map_err(
            |_| artifact_binary_reader_error(reader, "invalid UTF-8 string"),
        ),
        Err(error) => Result::Err(error),
    }
}
