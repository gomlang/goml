package wire;

use std::bytes;
use std::testing;

fn artifact_binary_test_bytes(values: Vec[u8]) -> bytes::Bytes {
    bytes::Bytes::from_vec(values)
}

fn artifact_binary_expect_ok[T: PartialEq + Debug](value: Result[T, string], expected: T) -> () {
    match value {
        Ok(actual) => testing::assert_eq(actual, expected),
        Err(error) => testing::fail(error.to_string()),
    }
}

fn artifact_binary_expect_unit(value: Result[(), string]) -> () {
    if let Err(error) = value {
        testing::fail(error.to_string())
    }
}

fn artifact_binary_expect_err[T](value: Result[T, string]) -> () {
    if let Ok(_) = value {
        testing::fail("expected binary artifact error")
    }
}

#[test]
fn binary_artifact_round_trips_fixed_width_values() -> () {
    let writer = new_artifact_binary_writer();
    artifact_binary_write_u8(writer, 255);
    artifact_binary_write_u16(writer, 65535);
    artifact_binary_write_u32(writer, 4294967295);
    artifact_binary_write_u64(writer, 18446744073709551615);
    artifact_binary_write_string(writer, "GoML λ");
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    artifact_binary_expect_ok(artifact_binary_read_u8(reader), 255);
    artifact_binary_expect_ok(artifact_binary_read_u16(reader), 65535);
    artifact_binary_expect_ok(artifact_binary_read_u32(reader), 4294967295);
    artifact_binary_expect_ok(artifact_binary_read_u64(reader), 18446744073709551615);
    artifact_binary_expect_ok(artifact_binary_read_string(reader), "GoML λ");
    testing::assert_eq(artifact_binary_reader_remaining(reader), 0)
}

#[test]
fn binary_artifact_round_trips_varints() -> () {
    let unsigned: Vec[u64] = Vec::new();
    unsigned.push(0);
    unsigned.push(1);
    unsigned.push(127);
    unsigned.push(128);
    unsigned.push(255);
    unsigned.push(256);
    unsigned.push(4294967295);
    unsigned.push(~(0.to_u64()));
    let writer = new_artifact_binary_writer();
    for value in unsigned {
        artifact_binary_write_uleb128(writer, value)
    }
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    for value in unsigned {
        artifact_binary_expect_ok(artifact_binary_read_uleb128(reader), value)
    }
    testing::assert_eq(artifact_binary_reader_remaining(reader), 0)
}

#[test]
fn binary_artifact_patches_offsets() -> () {
    let writer = new_artifact_binary_writer();
    artifact_binary_write_u32(writer, 0);
    artifact_binary_expect_unit(artifact_binary_patch_u32(writer, 0, 305419896));
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    artifact_binary_expect_ok(artifact_binary_read_u32(reader), 305419896)
}

#[test]
fn binary_artifact_string_ids_preserve_bounds_diagnostics() -> () {
    let table = artifact_binary_string_table_from_values(Vec::from_array(["alpha", "omega"]));
    let writer = new_artifact_binary_writer();
    artifact_binary_write_uleb128(writer, 0);
    artifact_binary_write_uleb128(writer, 1);
    artifact_binary_write_uleb128(writer, 2);
    artifact_binary_write_uleb128(writer, 128);
    let reader = new_artifact_binary_reader(artifact_binary_writer_finish(writer));
    artifact_binary_expect_ok(artifact_binary_decode_string_id(reader, table), "alpha");
    artifact_binary_expect_ok(artifact_binary_decode_string_id(reader, table), "omega");
    for offset in Vec::from_array([3, 5]) {
        match artifact_binary_decode_string_id(reader, table) {
            Ok(_) => testing::fail("expected invalid string ID"),
            Err(error) => testing::assert_eq(
                error,
                f"binary artifact at byte {offset}: string table index out of bounds",
            ),
        }
    }
    let truncated = new_artifact_binary_reader(artifact_binary_test_bytes(Vec::from_array([128])));
    match artifact_binary_decode_string_id(truncated, table) {
        Ok(_) => testing::fail("expected truncated string ID"),
        Err(error) => testing::assert_eq(
            error,
            "binary artifact at byte 1: unexpected end of input",
        ),
    }
}

#[test]
fn binary_artifact_rejects_invalid_input() -> () {
    let truncated = new_artifact_binary_reader(
        artifact_binary_test_bytes(Vec::from_array([1, 2, 3])),
    );
    artifact_binary_expect_err(artifact_binary_read_u32(truncated));
    let overflow_values = Vec::new();
    for _ in 0..10 {
        overflow_values.push(255)
    }
    let overflow = new_artifact_binary_reader(artifact_binary_test_bytes(overflow_values));
    artifact_binary_expect_err(artifact_binary_read_uleb128(overflow));
    let invalid_utf8 = new_artifact_binary_reader(
        artifact_binary_test_bytes(Vec::from_array([1, 255])),
    );
    artifact_binary_expect_err(artifact_binary_read_string(invalid_utf8));
    let invalid_length = new_artifact_binary_reader(
        artifact_binary_test_bytes(Vec::from_array([4, 1])),
    );
    artifact_binary_expect_err(artifact_binary_read_bytes(invalid_length))
}
