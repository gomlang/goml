package wire;

use module::hash;
use std::bytes;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

fn artifact_container_test_section(id: u16, text: string) -> ArtifactBinarySection {
    ArtifactBinarySection { id, version: 1, flags: 0, data: bytes::Bytes::from_string(text) }
}

fn artifact_container_expect_ok(value: Result[bytes::Bytes, string]) -> bytes::Bytes {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            bytes::Bytes::new()
        },
    }
}

fn artifact_container_expect_decode_ok(value: Result[ArtifactBinaryContainer, string]) -> ArtifactBinaryContainer {
    match value {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            ArtifactBinaryContainer { kind: 1, sections: Vec::new() }
        },
    }
}

#[test]
fn binary_artifact_container_is_deterministic() -> () {
    let first = Vec::new();
    first.push(artifact_container_test_section(3, "three"));
    first.push(artifact_container_test_section(1, "one"));
    let second = Vec::new();
    second.push(artifact_container_test_section(1, "one"));
    second.push(artifact_container_test_section(3, "three"));
    let first = artifact_container_expect_ok(encode_artifact_binary_container(1, first));
    let second = artifact_container_expect_ok(encode_artifact_binary_container(1, second));
    testing::assert(artifact_binary_bytes_equal(first, second));
    let decoded = artifact_container_expect_decode_ok(decode_artifact_binary_container(first));
    testing::assert_eq(decoded.kind, 1);
    testing::assert_eq(decoded.sections.len(), 2);
    let section = match artifact_binary_find_section(decoded, 3) {
        Some(value) => value,
        None => {
            testing::fail("missing section 3");
            artifact_container_test_section(3, "")
        },
    };
    artifact_binary_expect_ok(
        section.data.to_string_utf8().map_err(|error| error.to_string()),
        "three",
    )
}

#[test]
fn binary_artifact_container_rejects_corruption() -> () {
    let sections = Vec::new();
    sections.push(artifact_container_test_section(1, "payload"));
    let encoded = artifact_container_expect_ok(encode_artifact_binary_container(1, sections));
    encoded.set(encoded.len() - 1, encoded.get(encoded.len() - 1) ^ 1);
    artifact_binary_expect_err(decode_artifact_binary_container(encoded));
    let duplicates = Vec::new();
    duplicates.push(artifact_container_test_section(1, "first"));
    duplicates.push(artifact_container_test_section(1, "second"));
    artifact_binary_expect_err(encode_artifact_binary_container(1, duplicates))
}

#[test]
fn binary_artifact_hashes_arbitrary_bytes() -> () {
    let value = bytes::Bytes::from_vec(Vec::from_array([0, 255, 128]));
    testing::assert_eq(
        hash::sha256_bytes_hex(value),
        "f742b965f156c10374bc23aea96e3a8aff8facd6fc079defeaa30219ad86f211",
    )
}
