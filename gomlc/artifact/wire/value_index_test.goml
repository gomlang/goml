package wire;

use std::bytes;
use std::testing;

fn indexed_test_value() -> (ArtifactBinaryStringTable, bytes::Bytes) {
    let original = ArtifactValue::Object(
        Vec::from_array(
            [
                (
                    "values",
                    ArtifactValue::Array(
                        Vec::from_array(
                            [
                                ArtifactValue::Number("-42"),
                                ArtifactValue::Bool(true),
                                ArtifactValue::String("hello"),
                                ArtifactValue::Object(
                                    Vec::from_array([("child", ArtifactValue::Null)]),
                                ),
                            ],
                        ),
                    ),
                ),
            ],
        ),
    );
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return (table, bytes::Bytes::new())
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return (table, bytes::Bytes::new())
    };
    (table, index)
}

#[test]
fn persisted_index_reads_nested_values_without_building_nodes() -> () {
    let (table, encoded) = indexed_test_value();
    let Ok(view) = decode_artifact_binary_value_index(table, encoded.as_slice()) else {
        testing::fail("index decode failed");
        return
    };
    if let ArtifactValue::Indexed(value) = view {
        testing::assert(value.nodes.is_empty());
    }
    let Ok(object) = artifact_json_object(view, "root") else {
        testing::fail("object missing");
        return
    };
    let Ok(array) = artifact_json_field_array(object, "values") else {
        testing::fail("array missing");
        return
    };
    testing::assert_eq(array.len(), 4);
    testing::assert(artifact_json_number_value(array.get(0), "number") == Result::Ok("-42"));
    testing::assert(artifact_json_string_value(array.get(2), "string") == Result::Ok("hello"));
    testing::assert(artifact_json_object(array.get(3), "nested object").is_ok());
    testing::assert(artifact_binary_value_valid(view).is_ok());
    for length in 0..encoded.len() {
        testing::assert(
            decode_artifact_binary_value_index(table, encoded.as_slice().sub(0, length)).is_err(),
        );
    }
}

#[test]
fn persisted_index_rejects_bad_child_offsets_and_duplicate_names() -> () {
    let (table, encoded) = indexed_test_value();
    let reader = new_artifact_binary_reader(encoded);
    let Ok(number_length) = artifact_binary_read_u32(reader) else {
        testing::fail("index header missing");
        return
    };
    let offset = 4 + number_length.to_isize();
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, encoded);
    let _ = artifact_binary_patch_u32(writer, offset + 16 + 4, 0);
    let Ok(view) = decode_artifact_binary_value_index(
        table,
        artifact_binary_writer_finish(writer).as_slice(),
    ) else {
        testing::fail("root should remain readable");
        return
    };
    testing::assert(artifact_json_object(view, "root").is_err());
    testing::assert(artifact_binary_value_valid(view).is_err());
    let original = ArtifactValue::Object(
        Vec::from_array([("x", ArtifactValue::Null), ("y", ArtifactValue::Null)]),
    );
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return
    };
    let reader = new_artifact_binary_reader(index);
    let Ok(number_length) = artifact_binary_read_u32(reader) else {
        testing::fail("index header missing");
        return
    };
    let offset = 4 + number_length.to_isize();
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, index);
    let _ = artifact_binary_patch_u32(writer, offset + 32 + 12, 0);
    let Ok(view) = decode_artifact_binary_value_index(
        table,
        artifact_binary_writer_finish(writer).as_slice(),
    ) else {
        testing::fail("root should remain readable");
        return
    };
    testing::assert(artifact_json_object(view, "root").is_err());
}
