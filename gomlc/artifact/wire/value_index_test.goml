package wire;

use std::bytes;
use std::testing;

fn indexed_test_value() -> (ArtifactBinaryStringTable, bytes::Bytes) {
    let original = ArtifactValue::Object(
        Vec::from_array(
            [
                (
                    "values",
                    ArtifactValue::Array(
                        Vec::from_array(
                            [
                                ArtifactValue::Number("-42"),
                                ArtifactValue::Bool(true),
                                ArtifactValue::String("hello"),
                                ArtifactValue::Object(
                                    Vec::from_array([("child", ArtifactValue::Null)]),
                                ),
                            ],
                        ),
                    ),
                ),
            ],
        ),
    );
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return (table, bytes::Bytes::new())
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return (table, bytes::Bytes::new())
    };
    (table, index)
}

#[test]
fn persisted_index_reads_nested_values_without_building_nodes() -> () {
    let (table, encoded) = indexed_test_value();
    let Ok(view) = decode_artifact_binary_value_index(table, encoded.as_slice()) else {
        testing::fail("index decode failed");
        return
    };
    if let ArtifactValue::Indexed(value) = view {
        testing::assert(value.nodes.is_empty());
    }
    let Ok(object) = artifact_json_object(view, "root") else {
        testing::fail("object missing");
        return
    };
    let Ok(array) = artifact_json_field_array(object, "values") else {
        testing::fail("array missing");
        return
    };
    testing::assert_eq(array.len(), 4);
    testing::assert(artifact_json_number_value(array.get(0), "number") == Result::Ok("-42"));
    testing::assert(artifact_json_string_value(array.get(2), "string") == Result::Ok("hello"));
    testing::assert(artifact_json_object(array.get(3), "nested object").is_ok());
    testing::assert(artifact_binary_value_valid(view).is_ok());
    for length in 0..encoded.len() {
        testing::assert(
            decode_artifact_binary_value_index(table, encoded.as_slice().sub(0, length)).is_err(),
        );
    }
}

#[test]
fn persisted_index_rejects_bad_child_offsets_and_duplicate_names() -> () {
    let (table, encoded) = indexed_test_value();
    let reader = new_artifact_binary_reader(encoded);
    let Ok(number_length) = artifact_binary_read_u32(reader) else {
        testing::fail("index header missing");
        return
    };
    let offset = 4 + number_length.to_isize();
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, encoded);
    let _ = artifact_binary_patch_u32(writer, offset + 12, 0);
    let Ok(view) = decode_artifact_binary_value_index(
        table,
        artifact_binary_writer_finish(writer).as_slice(),
    ) else {
        testing::fail("root should remain readable");
        return
    };
    testing::assert(artifact_json_object(view, "root").is_err());
    testing::assert(artifact_binary_value_valid(view).is_err());
    let original = ArtifactValue::Object(
        Vec::from_array([("x", ArtifactValue::Null), ("y", ArtifactValue::Null)]),
    );
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return
    };
    let reader = new_artifact_binary_reader(index);
    let Ok(number_length) = artifact_binary_read_u32(reader) else {
        testing::fail("index header missing");
        return
    };
    let offset = 4 + number_length.to_isize();
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, index);
    let _ = artifact_binary_patch_u32(writer, offset + 24 + 8, 8);
    let Ok(view) = decode_artifact_binary_value_index(
        table,
        artifact_binary_writer_finish(writer).as_slice(),
    ) else {
        testing::fail("root should remain readable");
        return
    };
    testing::assert(artifact_json_object(view, "root").is_err());
}

fn indexed_shared_test_value() -> ArtifactValue {
    let repeated = ArtifactValue::Object(
        Vec::from_array(
            [("ty", ArtifactValue::String("TInt")), ("number", ArtifactValue::Number("42"))],
        ),
    );
    let items: Vec[ArtifactValue] = Vec::new();
    for _ in 0..64 {
        items.push(repeated)
    }
    ArtifactValue::Object(
        Vec::from_array(
            [
                ("left", ArtifactValue::Array(items)),
                ("right", ArtifactValue::Array(items)),
                (
                    "other",
                    ArtifactValue::Object(
                        Vec::from_array(
                            [
                                ("ty", ArtifactValue::String("TInt")),
                                ("number", ArtifactValue::Number("43")),
                            ],
                        ),
                    ),
                ),
            ],
        ),
    )
}

#[test]
fn persisted_index_shares_subtrees_and_preserves_field_names_and_numbers() -> () {
    let original = indexed_shared_test_value();
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return
    };
    if index.len() >= binary.len() * 3 / 4 {
        testing::fail(f"shared index {index.len()} is too large for source {binary.len()}")
    }
    let Ok(view) = decode_artifact_binary_value_index(table, index.as_slice()) else {
        testing::fail("index decode failed");
        return
    };
    let Ok(restored) = encode_artifact_binary_value(table, view) else {
        testing::fail("view encode failed");
        return
    };
    testing::assert(artifact_binary_bytes_equal(binary, restored));
    testing::assert(artifact_binary_value_valid(view).is_ok());
    let Ok(reencoded) = encode_artifact_binary_value_index(table, restored.as_slice()) else {
        testing::fail("index reencode failed");
        return
    };
    testing::assert(artifact_binary_bytes_equal(index, reencoded));
}

#[test]
fn persisted_index_rejects_invalid_subtree_references() -> () {
    let original = indexed_shared_test_value();
    let table = artifact_binary_string_table(original);
    let Ok(binary) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    let Ok(index) = encode_artifact_binary_value_index(table, binary.as_slice()) else {
        testing::fail("index encode failed");
        return
    };
    let Ok(ArtifactValue::Indexed(value)) = decode_artifact_binary_value_index(
        table,
        index.as_slice(),
    ) else {
        testing::fail("index decode failed");
        return
    };
    let mut reference = -1;
    for position in 0..value.encoded_nodes.len() / 12 {
        if artifact_binary_node(value, position).tag == 7 {
            reference = position;
            break
        }
    }
    testing::assert(reference >= 0);
    let offset = index.len() - value.encoded_nodes.len() + reference * 12 + 4;
    for target in[0, 1, 3, reference, reference + 1, 4294967295] {
        let writer = new_artifact_binary_writer();
        artifact_binary_write_raw_bytes(writer, index);
        let _ = artifact_binary_patch_u32(writer, offset, target.to_u32());
        let Ok(view) = decode_artifact_binary_value_index(
            table,
            artifact_binary_writer_finish(writer).as_slice(),
        ) else {
            testing::fail("root should remain readable");
            return
        };
        let _ = encode_artifact_binary_value(table, view);
        testing::assert(artifact_binary_value_valid(view).is_err());
    }
}

#[test]
fn persisted_index_limits_shared_value_expansion() -> () {
    let (table, encoded) = indexed_test_value();
    let Ok(ArtifactValue::Indexed(value)) = decode_artifact_binary_value_index(
        table,
        encoded.as_slice(),
    ) else {
        testing::fail("index decode failed");
        return
    };
    value.remaining.set(1);
    let _ = encode_artifact_binary_value(table, ArtifactValue::Indexed(value));
    testing::assert(artifact_binary_value_valid(ArtifactValue::Indexed(value)).is_err());
}

#[test]
fn indexed_field_lookup_only_expands_the_selected_value() -> () {
    let fields: Vec[(string, ArtifactValue)] = Vec::new();
    for index in 0..100 {
        fields.push(("field" + index.to_string(), ArtifactValue::Number(index.to_string())));
    }
    let original = ArtifactValue::Object(fields);
    let table = artifact_binary_string_table(original);
    let binary = testing::expect_ok(encode_artifact_binary_value(table, original), "encode fields");
    let encoded = testing::expect_ok(
        encode_artifact_binary_value_index(table, binary.as_slice()),
        "index fields",
    );
    let value = testing::expect_ok(
        decode_artifact_binary_value_index_with_limit(table, encoded.as_slice(), 2),
        "read root",
    );
    let object = testing::expect_ok(artifact_json_object(value, "fields"), "read object");
    testing::assert(
        testing::expect_ok(artifact_json_optional_field(object, "missing"), "missing field").is_none(),
    );
    let result = testing::expect_ok(
        artifact_json_required_field(object, "field99"),
        "read selected field",
    );
    testing::assert_eq(
        testing::expect_ok(artifact_json_number_value(result, "number"), "read number"),
        "99",
    );
    testing::assert(artifact_binary_value_valid(value).is_ok());
    let error = testing::expect_err(
        artifact_json_required_field(object, "field0"),
        "budget exhausted",
    );
    testing::assert(error.contains("node visits; limit=2; processed=2"));
}
