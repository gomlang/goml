package wire;

use std::bytes;
use std::cmp;
use std::collections;

pub struct ArtifactBinaryStringTable {
    interner: collections::Interner,
}

fn empty_artifact_binary_string_table() -> ArtifactBinaryStringTable {
    ArtifactBinaryStringTable { interner: collections::Interner::new() }
}

fn artifact_binary_collect_string(values: collections::IndexSet[string], value: string) -> () {
    let _ = values.insert(value);
}

fn artifact_binary_collect_value_strings(
    values: collections::IndexSet[string],
    value: ArtifactValue,
) -> () {
    match value {
        Object(fields) => for field in fields {
            artifact_binary_collect_string(values, field.0);
            artifact_binary_collect_value_strings(values, field.1)
        },
        Array(items) => for item in items {
            artifact_binary_collect_value_strings(values, item)
        },
        String(value) => {
            artifact_binary_collect_string(values, value)
        },
        Number(_) | Bool(_) | Null => (),
    }
}

pub fn artifact_binary_string_table(value: ArtifactValue) -> ArtifactBinaryStringTable {
    let values: collections::IndexSet[string] = collections::IndexSet::new();
    artifact_binary_collect_value_strings(values, value);
    artifact_binary_string_table_from_values(values.to_vec())
}

fn artifact_binary_string_table_from_values(values: Vec[string]) -> ArtifactBinaryStringTable {
    let values = sort_artifact_names(values);
    let interner = collections::Interner::new();
    for value in values {
        let _ = interner.intern(value);
    }
    ArtifactBinaryStringTable { interner }
}

pub fn artifact_binary_string_id(table: ArtifactBinaryStringTable, value: string) -> isize {
    match table.interner.symbols[value] {
        Some(symbol) => symbol.index(),
        None => -1,
    }
}

pub fn encode_artifact_binary_string_table(table: ArtifactBinaryStringTable) -> bytes::Bytes {
    let writer = new_artifact_binary_writer();
    artifact_binary_write_uleb128(writer, table.interner.len().to_u64());
    for value in table.interner.values {
        artifact_binary_write_string(writer, value)
    }
    artifact_binary_writer_finish(writer)
}

pub fn decode_artifact_binary_string_table(data: bytes::Bytes) -> Result[
    ArtifactBinaryStringTable,
    string,
] {
    let reader = new_artifact_binary_reader(data);
    let count = artifact_binary_read_length(reader)?;
    if count > 10000000 {
        return Result::Err("binary artifact string table exceeds limit")
    }
    let interner = collections::Interner::new();
    for index in 0..count {
        let value = artifact_binary_read_string(reader)?;
        if interner.contains(value) {
            return Result::Err("duplicate binary artifact string")
        } else if index > 0 && cmp::compare(interner.values[index - 1], value).is_ge() {
            return Result::Err("binary artifact string table is not sorted")
        } else {
            let _ = interner.intern(value);
        }
    }
    if artifact_binary_reader_remaining(reader) != 0 {
        Result::Err("trailing bytes in binary artifact string table")
    } else {
        Result::Ok(ArtifactBinaryStringTable { interner })
    }
}

fn artifact_binary_encode_string_id(
    writer: ArtifactBinaryWriter,
    table: ArtifactBinaryStringTable,
    value: string,
) -> Result[(), string] {
    let id = artifact_binary_string_id(table, value);
    if id < 0 {
        Result::Err("binary artifact string is missing from table")
    } else {
        artifact_binary_write_uleb128(writer, id.to_u64());
        Result::Ok(())
    }
}

pub fn artifact_binary_decode_string_id(
    reader: ArtifactBinaryReader,
    table: ArtifactBinaryStringTable,
) -> Result[string, string] {
    let id = artifact_binary_read_length(reader)?;
    match table.interner.resolve(collections::Symbol { index: id }) {
        Some(value) => Result::Ok(value),
        None => Result::Err(
            artifact_binary_reader_error(reader, "string table index out of bounds"),
        ),
    }
}

fn artifact_binary_object_has_field(fields: Vec[(string, ArtifactValue)], name: string) -> bool {
    for field in fields {
        if field.0 == name {
            return true
        }
    }
    false
}

fn artifact_binary_encode_value_at(
    writer: ArtifactBinaryWriter,
    table: ArtifactBinaryStringTable,
    value: ArtifactValue,
    depth: isize,
) -> Result[(), string] {
    if depth > 4096 {
        return Result::Err("binary artifact value nesting exceeds limit")
    }
    match value {
        Null => {
            artifact_binary_write_u8(writer, 0);
            Result::Ok(())
        },
        Bool(false) => {
            artifact_binary_write_u8(writer, 1);
            Result::Ok(())
        },
        Bool(true) => {
            artifact_binary_write_u8(writer, 2);
            Result::Ok(())
        },
        Number(value) => {
            artifact_binary_write_u8(writer, 3);
            artifact_binary_write_string(writer, value);
            Result::Ok(())
        },
        String(value) => {
            artifact_binary_write_u8(writer, 4);
            artifact_binary_encode_string_id(writer, table, value)
        },
        Array(items) => {
            artifact_binary_write_u8(writer, 5);
            artifact_binary_write_u32(writer, items.len().to_u32());
            for item in items {
                artifact_binary_encode_value_at(writer, table, item, depth + 1)?
            }
            Result::Ok(())
        },
        Object(fields) => {
            artifact_binary_write_u8(writer, 6);
            artifact_binary_write_u32(writer, fields.len().to_u32());
            for field in fields {
                artifact_binary_encode_string_id(writer, table, field.0)?;
                artifact_binary_encode_value_at(writer, table, field.1, depth + 1)?
            }
            Result::Ok(())
        },
    }
}

pub fn encode_artifact_binary_value(table: ArtifactBinaryStringTable, value: ArtifactValue) -> Result[
    bytes::Bytes,
    string,
] {
    let writer = new_artifact_binary_writer();
    match artifact_binary_encode_value_at(writer, table, value, 0) {
        Ok(()) => Result::Ok(artifact_binary_writer_finish(writer)),
        Err(error) => Result::Err(error),
    }
}

fn artifact_binary_decode_value_at(
    reader: ArtifactBinaryReader,
    table: ArtifactBinaryStringTable,
    depth: isize,
) -> Result[ArtifactValue, string] {
    if depth > 4096 {
        return Result::Err("binary artifact value nesting exceeds limit")
    }
    let tag = artifact_binary_read_u8(reader)?;
    match tag {
        0 => Result::Ok(ArtifactValue::Null),
        1 => Result::Ok(ArtifactValue::Bool(false)),
        2 => Result::Ok(ArtifactValue::Bool(true)),
        3 => artifact_binary_read_string(reader).map(|value| ArtifactValue::Number(value)),
        4 => artifact_binary_decode_string_id(reader, table).map(
            |value| ArtifactValue::String(value),
        ),
        5 => {
            let count = artifact_binary_read_u32(reader)?.to_isize();
            if count > 10000000 {
                return Result::Err("binary artifact array exceeds limit")
            }
            let values = Vec::with_capacity(count);
            for _ in 0..count {
                values.push(artifact_binary_decode_value_at(reader, table, depth + 1)?)
            }
            Result::Ok(ArtifactValue::Array(values))
        },
        6 => {
            let count = artifact_binary_read_u32(reader)?.to_isize();
            if count > 10000000 {
                return Result::Err("binary artifact object exceeds limit")
            }
            let fields = Vec::with_capacity(count);
            let names: Option[collections::HashSet[string]] = if count > 32 {
                Option::Some(collections::HashSet::new())
            } else {
                Option::None
            };
            for _ in 0..count {
                let name = artifact_binary_decode_string_id(reader, table)?;
                let duplicate = match names {
                    Some(value) => !value.insert(name),
                    None => artifact_binary_object_has_field(fields, name),
                };
                if duplicate {
                    return Result::Err("duplicate binary artifact object field")
                }
                let value = artifact_binary_decode_value_at(reader, table, depth + 1)?;
                fields.push((name, value))
            }
            Result::Ok(ArtifactValue::Object(fields))
        },
        _ => Result::Err(artifact_binary_reader_error(reader, "invalid value tag")),
    }
}

pub fn decode_artifact_binary_value(table: ArtifactBinaryStringTable, data: bytes::Bytes) -> Result[
    ArtifactValue,
    string,
] {
    let reader = new_artifact_binary_reader(data);
    let value = artifact_binary_decode_value_at(reader, table, 0)?;
    if artifact_binary_reader_remaining(reader) != 0 {
        Result::Err("trailing bytes in binary artifact value")
    } else {
        Result::Ok(value)
    }
}
