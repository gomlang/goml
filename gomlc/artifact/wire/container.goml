package wire;

use std::crypto::hash as crypto_hash;
use std::hash as standard_hash;
use standard_hash::Hasher;
use std::bytes;
use std::cmp;
use std::collections;

pub fn required_section_flag() -> u16 {
    1
}

pub fn string_table_section_id() -> u16 {
    1
}

pub fn value_section_id() -> u16 {
    2
}

pub struct ArtifactBinarySection {
    pub id: u16,
    pub version: u16,
    pub flags: u16,
    pub data: bytes::Bytes,
}

pub struct ArtifactBinaryContainer {
    pub kind: u8,
    pub sections: Vec[ArtifactBinarySection],
}

struct ArtifactBinaryDirectoryEntry {
    id: u16,
    version: u16,
    flags: u16,
    offset: isize,
    length: isize,
    hash: bytes::Bytes,
}

fn artifact_binary_header_size() -> isize {
    70
}

fn artifact_binary_directory_entry_size() -> isize {
    56
}

pub fn artifact_binary_magic() -> bytes::Bytes {
    bytes::Bytes::from_vec(b"GOMLART\0")
}

pub fn artifact_binary_bytes_equal(left: bytes::Bytes, right: bytes::Bytes) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for index in 0..left.len() {
            if left.get(index) != right.get(index) {
                return false
            }
        }
        true
    }
}

fn artifact_binary_sha256_slice(value: Slice[byte]) -> bytes::Bytes {
    let digest = crypto_hash::Sha256Digest::new256();
    digest.update(value);
    digest.sum()
}

fn artifact_binary_sha256(value: bytes::Bytes) -> bytes::Bytes {
    artifact_binary_sha256_slice(value.as_slice())
}

fn artifact_binary_section_compare(left: ArtifactBinarySection, right: ArtifactBinarySection) -> cmp::Ordering {
    cmp::compare(left.id, right.id)
}

fn artifact_binary_sort_sections(values: Vec[ArtifactBinarySection]) -> Vec[ArtifactBinarySection] {
    collections::sort_by_ordering(values, artifact_binary_section_compare);
    values
}

fn artifact_binary_sections_valid(values: Vec[ArtifactBinarySection]) -> bool {
    let mut previous: Option[u16] = Option::None;
    for value in values {
        if let Some(id) = previous {
            if id == value.id {
                return false
            }
        }
        previous = Option::Some(value.id);
    }
    true
}

pub fn encode_artifact_binary_container(kind: u8, sections: Vec[ArtifactBinarySection]) -> Result[
    bytes::Bytes,
    string,
] {
    if kind != 1 && kind != 2 && kind != 3 {
        return Err("invalid binary artifact kind")
    }
    let sections = artifact_binary_sort_sections(sections);
    if !artifact_binary_sections_valid(sections) {
        return Err("duplicate binary artifact section")
    } else if sections.len() > 1024 {
        return Err("too many binary artifact sections")
    }
    let payload = bytes::Bytes::new();
    for section in sections {
        for index in 0..section.data.len() {
            payload.push(section.data.get(index))
        }
    }
    let writer = new_artifact_binary_writer();
    artifact_binary_write_raw_bytes(writer, artifact_binary_magic());
    artifact_binary_write_u16(writer, 1);
    artifact_binary_write_u16(writer, 0);
    artifact_binary_write_u8(writer, kind);
    artifact_binary_write_u8(writer, 0);
    artifact_binary_write_u32(writer, artifact_compiler_abi().to_u32());
    artifact_binary_write_u16(writer, sections.len().to_u16());
    artifact_binary_write_u16(writer, 0);
    artifact_binary_write_u64(writer, artifact_binary_header_size().to_u64());
    artifact_binary_write_u64(writer, payload.len().to_u64());
    artifact_binary_write_raw_bytes(writer, artifact_binary_sha256(payload));
    let mut offset = artifact_binary_header_size()
        + artifact_binary_directory_entry_size() * sections.len();
    for section in sections {
        artifact_binary_write_u16(writer, section.id);
        artifact_binary_write_u16(writer, section.version);
        artifact_binary_write_u16(writer, section.flags);
        artifact_binary_write_u16(writer, 0);
        artifact_binary_write_u64(writer, offset.to_u64());
        artifact_binary_write_u64(writer, section.data.len().to_u64());
        artifact_binary_write_raw_bytes(writer, artifact_binary_sha256(section.data));
        offset = offset + section.data.len();
    }
    artifact_binary_write_raw_bytes(writer, payload);
    Ok(artifact_binary_writer_finish(writer))
}

fn artifact_binary_checked_int(reader: ArtifactBinaryReader, value: u64, name: string) -> Result[
    isize,
    string,
] {
    if value > 2147483647 {
        Err(artifact_binary_reader_error(reader, name + " exceeds supported size"))
    } else {
        Ok(value.to_isize())
    }
}

pub struct ArtifactBinarySectionView {
    pub id: u16,
    pub version: u16,
    pub flags: u16,
    pub data: Slice[byte],
}

pub struct ArtifactBinaryContainerView {
    pub kind: u8,
    pub sections: Vec[ArtifactBinarySectionView],
}

fn copy_artifact_binary_container(value: ArtifactBinaryContainerView) -> ArtifactBinaryContainer {
    let sections: Vec[ArtifactBinarySection] = Vec::with_capacity(value.sections.len());
    for section in value.sections {
        sections.push(
            ArtifactBinarySection {
                id: section.id,
                version: section.version,
                flags: section.flags,
                data: bytes::Bytes::from_slice_copy(section.data),
            },
        )
    }
    ArtifactBinaryContainer { kind: value.kind, sections }
}

pub fn decode_artifact_binary_container(data: bytes::Bytes) -> Result[
    ArtifactBinaryContainer,
    string,
] {
    decode_artifact_binary_container_view(data.as_slice()).map(copy_artifact_binary_container)
}

pub fn decode_verified_artifact_binary_container(data: bytes::Bytes) -> Result[
    ArtifactBinaryContainer,
    string,
] {
    decode_verified_artifact_binary_container_view(data.as_slice()).map(
        copy_artifact_binary_container,
    )
}

pub fn decode_artifact_binary_container_view(data: Slice[byte]) -> Result[
    ArtifactBinaryContainerView,
    string,
] {
    decode_artifact_binary_container_checked(data, true)
}

pub fn decode_verified_artifact_binary_container_view(data: Slice[byte]) -> Result[
    ArtifactBinaryContainerView,
    string,
] {
    decode_artifact_binary_container_checked(data, false)
}

pub fn artifact_binary_find_section_view(value: ArtifactBinaryContainerView, id: u16) -> Option[
    ArtifactBinarySectionView,
] {
    for section in value.sections {
        if section.id == id {
            return Option::Some(section)
        }
    }
    Option::None
}

fn decode_artifact_binary_container_checked(data: Slice[byte], verify_checksums: bool) -> Result[
    ArtifactBinaryContainerView,
    string,
] {
    let reader = new_artifact_binary_slice_reader(data);
    let magic = artifact_binary_read_raw_bytes(reader, 8)?;
    if !artifact_binary_bytes_equal(magic, artifact_binary_magic()) {
        return Err("invalid binary artifact magic")
    }
    let major = artifact_binary_read_u16(reader)?;
    let minor = artifact_binary_read_u16(reader)?;
    if major != 1 {
        return Err("unsupported binary artifact major version")
    } else if minor > 0 {
        return Err("unsupported binary artifact minor version")
    }
    let kind = artifact_binary_read_u8(reader)?;
    if kind != 1 && kind != 2 && kind != 3 {
        return Err("invalid binary artifact kind")
    }
    let flags = artifact_binary_read_u8(reader)?;
    if flags != 0 {
        return Err("unsupported binary artifact flags")
    }
    let compiler_abi = artifact_binary_read_u32(reader)?;
    if compiler_abi != artifact_compiler_abi().to_u32() {
        return Err("unsupported binary artifact compiler ABI")
    }
    let section_count = artifact_binary_read_u16(reader)?.to_isize();
    let reserved = artifact_binary_read_u16(reader)?;
    if section_count > 1024 {
        return Err("too many binary artifact sections")
    } else if reserved != 0 {
        return Err("invalid binary artifact reserved field")
    }
    let directory_offset = artifact_binary_checked_int(
        reader,
        artifact_binary_read_u64(reader)?,
        "directory offset",
    )?;
    let payload_length = artifact_binary_checked_int(
        reader,
        artifact_binary_read_u64(reader)?,
        "payload length",
    )?;
    let payload_hash = artifact_binary_read_raw_bytes(reader, 32)?;
    if directory_offset != artifact_binary_header_size() {
        return Err("invalid binary artifact directory offset")
    }
    let payload_offset = artifact_binary_header_size()
        + section_count * artifact_binary_directory_entry_size();
    if payload_offset > data.len() || payload_length != data.len() - payload_offset {
        return Err("invalid binary artifact payload length")
    }
    let directory: Vec[ArtifactBinaryDirectoryEntry] = Vec::with_capacity(section_count);
    for _ in 0..section_count {
        let id = artifact_binary_read_u16(reader)?;
        if !directory.is_empty() && id <= directory[directory.len() - 1].id {
            return Err("binary artifact section directory is not sorted")
        }
        let version = artifact_binary_read_u16(reader)?;
        let flags = artifact_binary_read_u16(reader)?;
        let reserved = artifact_binary_read_u16(reader)?;
        if reserved != 0 {
            return Err("invalid binary artifact section reserved field")
        }
        let offset = artifact_binary_checked_int(
            reader,
            artifact_binary_read_u64(reader)?,
            "section offset",
        )?;
        let length = artifact_binary_checked_int(
            reader,
            artifact_binary_read_u64(reader)?,
            "section length",
        )?;
        let hash = artifact_binary_read_raw_bytes(reader, 32)?;
        directory.push(ArtifactBinaryDirectoryEntry { id, version, flags, offset, length, hash })
    }
    if verify_checksums
        && !artifact_binary_bytes_equal(
            payload_hash,
            artifact_binary_sha256_slice(data.sub(payload_offset, data.len())),
        ) {
        return Err("binary artifact payload checksum mismatch")
    }
    let result: Vec[ArtifactBinarySectionView] = Vec::new();
    let mut previous_end = payload_offset;
    for entry in directory {
        let offset = entry.offset;
        let length = entry.length;
        if offset != previous_end || length > data.len() - offset {
            return Err("invalid binary artifact section range")
        }
        let section_data = data.sub(offset, offset + length);
        if verify_checksums
            && !artifact_binary_bytes_equal(entry.hash, artifact_binary_sha256_slice(section_data)) {
            return Err("binary artifact section checksum mismatch")
        }
        result.push(
            ArtifactBinarySectionView {
                id: entry.id,
                version: entry.version,
                flags: entry.flags,
                data: section_data,
            },
        );
        previous_end = offset + length;
    }
    if previous_end != data.len() {
        Err("invalid binary artifact section coverage")
    } else {
        Ok(ArtifactBinaryContainerView { kind, sections: result })
    }
}

pub fn artifact_binary_find_section(value: ArtifactBinaryContainer, id: u16) -> Option[
    ArtifactBinarySection,
] {
    for offset in 0..value.sections.len() {
        let section = value.sections[value.sections.len() - 1 - offset];
        if section.id == id {
            return Some(section)
        }
    }
    None
}

pub fn artifact_compiler_abi() -> isize {
    7
}
