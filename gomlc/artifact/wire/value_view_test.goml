package wire;

use std::testing;

#[test]
fn binary_value_view_preserves_nested_values_and_field_lookup() -> () {
    let original = ArtifactValue::Object(
        Vec::from_array(
            [
                (
                    "array",
                    ArtifactValue::Array(
                        Vec::from_array(
                            [
                                ArtifactValue::Null,
                                ArtifactValue::Bool(true),
                                ArtifactValue::Number("-42"),
                                ArtifactValue::String("hello"),
                            ],
                        ),
                    ),
                ),
                (
                    "nested",
                    ArtifactValue::Object(
                        Vec::from_array([("value", ArtifactValue::String("world"))]),
                    ),
                ),
            ],
        ),
    );
    let table = artifact_binary_string_table(original);
    let Ok(encoded) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    let Ok(view) = decode_artifact_binary_value_view(table, encoded.as_slice()) else {
        testing::fail("view decode failed");
        return
    };
    let Ok(object) = artifact_json_object(view, "root") else {
        testing::fail("root object missing");
        return
    };
    let Ok(array) = artifact_json_field_array(object, "array") else {
        testing::fail("array missing");
        return
    };
    testing::assert_eq(array.len(), 4);
    testing::assert(artifact_json_string_value(array.get(3), "string") == Result::Ok("hello"));
    testing::assert(artifact_json_number_value(array.get(2), "number") == Result::Ok("-42"));
    let Ok(reencoded) = encode_artifact_binary_value(table, view) else {
        testing::fail("view encode failed");
        return
    };
    testing::assert(artifact_binary_bytes_equal(encoded, reencoded));
    for length in 0..encoded.len() {
        testing::assert(
            decode_artifact_binary_value_view(table, encoded.as_slice().sub(0, length)).is_err(),
        );
    }
}

#[test]
fn binary_value_view_rejects_duplicate_fields() -> () {
    let original = ArtifactValue::Object(
        Vec::from_array([("x", ArtifactValue::Null), ("x", ArtifactValue::Bool(false))]),
    );
    let table = artifact_binary_string_table(original);
    let Ok(encoded) = encode_artifact_binary_value(table, original) else {
        testing::fail("encode failed");
        return
    };
    testing::assert(decode_artifact_binary_value_view(table, encoded.as_slice()).is_err());
}
