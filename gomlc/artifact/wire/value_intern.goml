package wire;

struct ArtifactBinaryIndexEncoder {
    source: Vec[ArtifactBinaryNode],
    identities: Vec[isize],
    targets: HashMap[isize, isize],
    nodes: Vec[ArtifactBinaryNode],
}

fn artifact_binary_subtree_identities(
    value: ArtifactBinaryValue,
    numbers: ArtifactBinaryStringTable,
) -> Vec[isize] {
    let identities: Vec[isize] = Vec::with_capacity(value.nodes.len());
    for _ in value.nodes {
        identities.push(-1)
    }
    let interned: HashMap[Vec[isize], isize] = HashMap::new();
    let mut index = value.nodes.len();
    while index > 0 {
        index = index - 1;
        let node = value.nodes[index];
        let payload = if node.tag == 3 {
            artifact_binary_string_id(numbers, value.numbers[node.value])
        } else {
            node.value
        };
        value.nodes[index] = ArtifactBinaryNode { value: payload, ..node };
        let key = Vec::from_array([node.tag.to_isize(), payload]);
        let mut child = index + 1;
        while child < node.next {
            key.push(value.nodes[child].name);
            key.push(identities[child]);
            child = value.nodes[child].next;
        }
        identities[index] = match interned[key] {
            Some(identity) => identity,
            None => {
                let identity = interned.len();
                let _ = interned.insert(key, identity);
                identity
            },
        };
    }
    identities
}

impl ArtifactBinaryIndexEncoder {
    fn append(self: ArtifactBinaryIndexEncoder, source_index: isize) -> () {
        let node = self.source[source_index];
        let identity = self.identities[source_index];
        let index = self.nodes.len();
        if node.tag >= 5 && node.value > 0 {
            if let Some(target) = self.targets[identity] {
                self.nodes.push(
                    ArtifactBinaryNode { tag: 7, next: index + 1, value: target, name: node.name },
                );
                return
            }
        }
        self.nodes.push(node);
        let mut child = source_index + 1;
        while child < node.next {
            self.append(child);
            child = self.source[child].next;
        }
        self.nodes[index] = ArtifactBinaryNode { next: self.nodes.len(), ..node };
        if node.tag >= 5 && node.value > 0 {
            let _ = self.targets.insert(identity, index);
        }
    }
}

fn artifact_binary_shared_nodes(value: ArtifactBinaryValue, numbers: ArtifactBinaryStringTable) -> Vec[
    ArtifactBinaryNode,
] {
    let identities = artifact_binary_subtree_identities(value, numbers);
    let encoder = ArtifactBinaryIndexEncoder {
        source: value.nodes,
        identities,
        targets: HashMap::new(),
        nodes: Vec::new(),
    };
    encoder.append(0);
    encoder.nodes
}
