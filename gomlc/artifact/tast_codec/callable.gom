package tast_codec;

use module::artifact::wire as wire;
use module::resources;
use module::tast;

pub struct ArtifactCallable {
    pub name: string,
    pub kind: string,
    pub id: Option[string],
    pub import_path: Option[string],
    pub symbol: Option[string],
    pub methods: Option[Vec[string]],
}

fn invalid_artifact_callable(value: string) -> ArtifactCallable {
    ArtifactCallable {
        name: value,
        kind: CALLABLE_INVALID_KIND,
        id: Option::None,
        import_path: Option::None,
        methods: Option::None,
        symbol: Option::None,
    }
}

pub fn artifact_callable(value: tast::Callable) -> ArtifactCallable {
    match value {
        Function(value) => ArtifactCallable {
            name: value,
            kind: CALLABLE_GOML_KIND,
            id: Option::Some(value),
            import_path: Option::None,
            methods: Option::None,
            symbol: Option::None,
        },
        LangItem { item: _, function_name } => {
            ArtifactCallable {
                name: function_name,
                kind: CALLABLE_GOML_KIND,
                id: Option::Some(function_name),
                import_path: Option::None,
                methods: Option::None,
                symbol: Option::None,
            }
        },
        Runtime(value) => match resources::runtime_abi_by_key(value) {
            Some(spec) => ArtifactCallable {
                name: if value.byte_len() >= 4 && value.byte_slice(0, 4) == "std." {
                    "std::internal::host::" + spec.source_name
                } else {
                    spec.source_name
                },
                kind: CALLABLE_RUNTIME_KIND,
                id: Option::Some(spec.artifact_id),
                import_path: Option::None,
                methods: Option::None,
                symbol: Option::None,
            },
            None => invalid_artifact_callable(value),
        },
        Intrinsic(value) => match resources::intrinsic_abi_by_key(value) {
            Some(spec) => ArtifactCallable {
                name: spec.source_name,
                kind: CALLABLE_INTRINSIC_KIND,
                id: Option::Some(spec.artifact_id),
                import_path: Option::None,
                methods: Option::None,
                symbol: Option::None,
            },
            None => invalid_artifact_callable(value),
        },
        GoInterfaceBridge { binding, methods } => ArtifactCallable {
            name: binding,
            kind: CALLABLE_GO_INTERFACE_BRIDGE_KIND,
            id: Option::Some(binding),
            import_path: Option::None,
            symbol: Option::None,
            methods: Option::Some(methods),
        },
        GoMethod { symbol, binding } => ArtifactCallable {
            name: symbol,
            kind: CALLABLE_GO_METHOD_KIND,
            id: if binding == "" {
                Option::None
            } else {
                Option::Some(binding)
            },
            import_path: Option::None,
            methods: Option::None,
            symbol: Option::Some(symbol),
        },
        GoForeign { import_path, symbol, binding } => ArtifactCallable {
            name: symbol,
            kind: CALLABLE_GO_KIND,
            id: if binding == "" {
                Option::None
            } else {
                Option::Some(binding)
            },
            import_path: Option::Some(import_path),
            methods: Option::None,
            symbol: Option::Some(symbol),
        },
        FunctionInstance { .. } | TraitMethod { .. } | DynTraitMethod {
            trait_name: _,
            dispatch_name: _,
            method_name: _,
        } | InherentMethod { receiver_ty: _, method_name: _ } => {
            invalid_artifact_callable("unresolved callable")
        },
    }
}

pub fn artifact_json_callable_body(writer: wire::ArtifactJsonWriter, value: ArtifactCallable) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "kind");
    wire::artifact_json_string(writer, value.kind);
    if let Some(value) = value.id {
        wire::artifact_json_name(writer, "id");
        wire::artifact_json_string(writer, value)
    }
    if let Some(value) = value.import_path {
        wire::artifact_json_name(writer, "import_path");
        wire::artifact_json_string(writer, value)
    }
    if let Some(value) = value.symbol {
        wire::artifact_json_name(writer, "symbol");
        wire::artifact_json_string(writer, value)
    }
    if let Some(methods) = value.methods {
        wire::artifact_json_name(writer, "methods");
        wire::artifact_json_begin_array(writer);
        for method in methods {
            wire::artifact_json_string(writer, method);
        }
        wire::artifact_json_end_array(writer);
    }
    wire::artifact_json_end_object(writer)
}

pub fn artifact_intrinsic_key_from_id(value: string) -> Option[string] {
    resources::intrinsic_abi_by_id(value).map(|spec| spec.key)
}

pub fn artifact_runtime_key_from_id(value: string) -> Option[string] {
    resources::runtime_abi_by_id(value).map(|spec| spec.key)
}

pub fn artifact_decode_callable_body(name: string, value: wire::ArtifactValue) -> Result[
    tast::Callable,
    string,
] {
    let object = wire::artifact_json_object(value, "callable body")?;
    let kind = wire::artifact_json_field_string(object, "kind")?;
    match kind {
        CALLABLE_GOML_KIND => match wire::artifact_json_optional_field(object, "id")? {
            Some(value) => Result::Ok(
                tast::Callable::Function(wire::artifact_json_string_value(value, "callable id")?),
            ),
            None => Result::Ok(tast::Callable::Function(name)),
        },
        CALLABLE_GO_INTERFACE_BRIDGE_KIND => {
            let binding = artifact_foreign_binding_id(object)?;
            if binding == "" {
                return Result::Err(wire::artifact_decode_error("Go interface bridge binding"))
            }
            let values = wire::artifact_json_array(
                wire::artifact_json_required_field(object, "methods")?,
                "Go interface bridge methods",
            )?;
            let methods: Vec[string] = Vec::new();
            for value in values {
                let name = wire::artifact_json_string_value(value, "Go interface bridge method")?;
                if !tast::go_ffi_symbol_is_valid(name) || methods.contains(name) {
                    return Result::Err(
                        wire::artifact_decode_error("Go interface bridge method names"),
                    )
                }
                methods.push(name);
            }
            if wire::artifact_json_optional_field(object, "import_path")?.is_some()
                || wire::artifact_json_optional_field(object, "symbol")?.is_some() {
                return Result::Err(
                    wire::artifact_decode_error("Go interface bridge target payload"),
                )
            }
            Result::Ok(tast::Callable::GoInterfaceBridge { binding, methods })
        },
        CALLABLE_GO_METHOD_KIND => {
            let binding = artifact_foreign_binding_id(object)?;
            let symbol = wire::artifact_json_field_string(object, "symbol")?;
            if !tast::go_ffi_symbol_is_valid(symbol) {
                return Result::Err(wire::artifact_decode_error("Go method symbol"))
            }
            if wire::artifact_json_optional_field(object, "import_path")?.is_some() {
                return Result::Err(wire::artifact_decode_error("Go method package target"))
            }
            Result::Ok(tast::Callable::GoMethod { symbol, binding })
        },
        CALLABLE_GO_KIND => Result::Ok(
            tast::Callable::GoForeign {
                binding: artifact_foreign_binding_id(object)?,
                import_path: wire::artifact_json_field_string(object, "import_path")?,
                symbol: wire::artifact_json_field_string(object, "symbol")?,
            },
        ),
        CALLABLE_INTRINSIC_KIND => {
            let id = wire::artifact_json_field_string(object, "id")?;
            artifact_intrinsic_key_from_id(id).map(|value| tast::Callable::Intrinsic(value)).ok_or(
                wire::artifact_decode_error("intrinsic id"),
            )
        },
        CALLABLE_RUNTIME_KIND => {
            let id = wire::artifact_json_field_string(object, "id")?;
            artifact_runtime_key_from_id(id).map(|value| tast::Callable::Runtime(value)).ok_or(
                wire::artifact_decode_error("runtime hook id"),
            )
        },
        _ => Result::Err(wire::artifact_decode_error("callable kind")),
    }
}

fn artifact_foreign_binding_id(object: Vec[(string, wire::ArtifactValue)]) -> Result[string, string] {
    match wire::artifact_json_optional_field(object, "id")? {
        Some(value) => wire::artifact_json_string_value(value, "foreign binding identity"),
        None => Result::Ok(""),
    }
}
