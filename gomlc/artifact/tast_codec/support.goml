package tast_codec;

use std::io;
use std::process;

fn fail(message: string) -> () {
    io::eprintln(message);
    process::exit(1)
}

pub fn artifact_add_type_name(values: Vec[string], name: string) -> () {
    for value in values {
        if value == name {
            return ()
        }
    }
    values.push(name)
}

pub fn option_string_present(value: Option[string]) -> bool {
    value.is_some()
}
