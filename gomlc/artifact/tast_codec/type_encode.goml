package tast_codec;

use module::artifact::wire as wire;
use module::ast;
use module::tast;

pub struct ArtifactTypeContext {
    pub enum_names: Vec[string],
    pub struct_names: Vec[string],
}

pub fn artifact_type_context(enum_names: Vec[string], struct_names: Vec[string]) -> ArtifactTypeContext {
    ArtifactTypeContext { enum_names, struct_names }
}

pub fn artifact_json_string_array(writer: wire::ArtifactJsonWriter, values: Vec[string]) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        wire::artifact_json_string(writer, value)
    }
    wire::artifact_json_end_array(writer)
}

pub fn artifact_json_type_array(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    values: Vec[tast::Type],
) -> () {
    wire::artifact_json_begin_array(writer);
    for value in values {
        artifact_json_type(writer, context, value)
    }
    wire::artifact_json_end_array(writer)
}

fn artifact_json_dyn_bound(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::DynTraitBound,
    additional_bounds: Vec[tast::DynTraitBound],
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "trait_name");
    wire::artifact_json_string(writer, value.trait_name);
    wire::artifact_json_name(writer, "args");
    artifact_json_type_array(writer, context, value.args);
    wire::artifact_json_name(writer, "associated_types");
    wire::artifact_json_begin_array(writer);
    for binding in value.associated_types {
        wire::artifact_json_begin_array(writer);
        wire::artifact_json_string(writer, binding.0);
        artifact_json_type(writer, context, binding.1);
        wire::artifact_json_end_array(writer)
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_name(writer, "additional_bounds");
    wire::artifact_json_begin_array(writer);
    for bound in additional_bounds {
        artifact_json_dyn_bound(writer, context, bound, Vec::new())
    }
    wire::artifact_json_end_array(writer);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_named_type(
    writer: wire::ArtifactJsonWriter,
    kind: string,
    field: string,
    value: string,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, kind);
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, field);
    wire::artifact_json_string(writer, value);
    wire::artifact_json_end_object(writer);
    wire::artifact_json_end_object(writer)
}

pub fn artifact_json_trait_ref(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::TraitRef,
) -> () {
    wire::artifact_json_begin_object(writer);
    wire::artifact_json_name(writer, "name");
    wire::artifact_json_string(writer, value.name);
    wire::artifact_json_name(writer, "args");
    artifact_json_type_array(writer, context, value.args);
    wire::artifact_json_end_object(writer)
}

fn artifact_json_optional_trait_ref(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: Option[tast::TraitRef],
) -> () {
    match value {
        Some(value) => artifact_json_trait_ref(writer, context, value),
        None => wire::artifact_json_null(writer),
    }
}

pub fn artifact_json_type(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    input: tast::Type,
) -> () {
    match tast::resolve_type(input) {
        Unit => wire::artifact_json_string(writer, TYPE_UNIT_TAG),
        Never => wire::artifact_json_string(writer, TYPE_NEVER_TAG),
        Bool => wire::artifact_json_string(writer, TYPE_BOOL_TAG),
        Int => wire::artifact_json_string(writer, TYPE_INT_TAG),
        Int8 => wire::artifact_json_string(writer, TYPE_INT8_TAG),
        Int16 => wire::artifact_json_string(writer, TYPE_INT16_TAG),
        Int32 => wire::artifact_json_string(writer, TYPE_INT32_TAG),
        Int64 => wire::artifact_json_string(writer, TYPE_INT64_TAG),
        Uint => wire::artifact_json_string(writer, TYPE_UINT_TAG),
        Uint8 => wire::artifact_json_string(writer, TYPE_UINT8_TAG),
        Uint16 => wire::artifact_json_string(writer, TYPE_UINT16_TAG),
        Uint32 => wire::artifact_json_string(writer, TYPE_UINT32_TAG),
        Uint64 => wire::artifact_json_string(writer, TYPE_UINT64_TAG),
        Float32 => wire::artifact_json_string(writer, TYPE_FLOAT32_TAG),
        Float64 => wire::artifact_json_string(writer, TYPE_FLOAT64_TAG),
        String => wire::artifact_json_string(writer, TYPE_STRING_TAG),
        Char => wire::artifact_json_string(writer, TYPE_CHAR_TAG),
        Tuple { items: values } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_TUPLE_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "typs");
            artifact_json_type_array(writer, context, values);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        External { import_path, name, args } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_EXTERNAL_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "import_path");
            wire::artifact_json_string(writer, import_path);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_name(writer, "args");
            artifact_json_type_array(writer, context, args);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Con { name } => if context.enum_names.contains(name) {
            artifact_json_named_type(writer, TYPE_ENUM_TAG, "name", name)
        } else {
            artifact_json_named_type(writer, TYPE_STRUCT_TAG, "name", name)
        },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_DYN_TAG);
            artifact_json_dyn_bound(
                writer,
                context,
                tast::DynTraitBound { trait_name, args, associated_types },
                additional_bounds,
            );
            wire::artifact_json_end_object(writer)
        },
        Projection { for_ty, name, trait_ref } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_PROJECTION_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_optional_trait_ref(writer, context, trait_ref);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "name");
            wire::artifact_json_string(writer, name);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        App { ty: base, args } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_APP_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "ty");
            artifact_json_type(writer, context, base);
            wire::artifact_json_name(writer, "args");
            artifact_json_type_array(writer, context, args);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Array { len: length, elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_ARRAY_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "len");
            wire::artifact_json_number(
                writer,
                if length < 0 {
                    UNKNOWN_ARRAY_LENGTH
                } else {
                    length.to_string()
                },
            );
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Slice { elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_SLICE_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        MutSlice { elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_MUT_SLICE_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        VecType { elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_VEC_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        GoPointer { elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_GO_POINTER_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        GoFunction { signature: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_GO_FUNCTION_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "signature");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        RefType { elem: element } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_REF_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Channel { elem: element, direction } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_CHANNEL_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "elem");
            artifact_json_type(writer, context, element);
            wire::artifact_json_name(writer, "direction");
            wire::artifact_json_string(
                writer,
                match direction {
                    ast::ChannelDirection::Both => "both",
                    ast::ChannelDirection::Send => "send",
                    ast::ChannelDirection::Receive => "receive",
                },
            );
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        HashMap { key, value } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_HASH_MAP_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "key");
            artifact_json_type(writer, context, key);
            wire::artifact_json_name(writer, "value");
            artifact_json_type(writer, context, value);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        GoMap { key, value } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_GO_MAP_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "key");
            artifact_json_type(writer, context, key);
            wire::artifact_json_name(writer, "value");
            artifact_json_type(writer, context, value);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Param { name } => artifact_json_named_type(writer, TYPE_PARAM_TAG, "name", name),
        Func { params, ret_ty } => {
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, TYPE_FUNCTION_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "params");
            artifact_json_type_array(writer, context, params);
            wire::artifact_json_name(writer, "ret_ty");
            artifact_json_type(writer, context, ret_ty);
            wire::artifact_json_end_object(writer);
            wire::artifact_json_end_object(writer)
        },
        Var(_) | Error => fail("error[compile]: unresolved type in compiler artifact"),
    }
}

pub fn artifact_json_type_predicate(
    writer: wire::ArtifactJsonWriter,
    context: ArtifactTypeContext,
    value: tast::TypePredicate,
) -> () {
    wire::artifact_json_begin_object(writer);
    match value {
        GoComparable(ty) => {
            wire::artifact_json_name(writer, GO_COMPARABLE_PREDICATE_TAG);
            artifact_json_type(writer, context, ty)
        },
        Trait { for_ty, trait_ref } => {
            wire::artifact_json_name(writer, TRAIT_PREDICATE_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "for_ty");
            artifact_json_type(writer, context, for_ty);
            wire::artifact_json_name(writer, "trait_ref");
            artifact_json_trait_ref(writer, context, trait_ref);
            wire::artifact_json_end_object(writer)
        },
        Equality { lhs: left, rhs: right } => {
            wire::artifact_json_name(writer, EQUALITY_PREDICATE_TAG);
            wire::artifact_json_begin_object(writer);
            wire::artifact_json_name(writer, "lhs");
            artifact_json_type(writer, context, left);
            wire::artifact_json_name(writer, "rhs");
            artifact_json_type(writer, context, right);
            wire::artifact_json_end_object(writer)
        },
    }
    wire::artifact_json_end_object(writer)
}
