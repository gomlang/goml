package artifact;

use module::core;
use module::ffi;
use module::ctir;
use module::tast;

pub struct ArtifactFnScheme {
    pub name: string,
    pub comptime: tast::ComptimeCapability,
    pub type_params: Vec[string],
    pub constraints: Vec[tast::TypePredicate],
    pub ty: tast::Type,
    pub body: tast::Callable,
}

pub struct ArtifactComptimeUnit {
    pub version: isize,
    pub module: ctir::CtModule,
    pub semantic_hash: string,
}

pub struct ArtifactAssociatedTypeDef {
    pub name: string,
    pub bounds: Vec[tast::TraitRef],
}

pub struct ArtifactTraitDef {
    pub default_map_requirements: Vec[(string, Vec[tast::Type])],
    pub name: string,
    pub params: Vec[string],
    pub predicates: Vec[tast::TypePredicate],
    pub supertraits: Vec[tast::TraitRef],
    pub associated_types: Vec[ArtifactAssociatedTypeDef],
    pub methods: Vec[ArtifactFnScheme],
}

pub struct ArtifactImplDef {
    pub params: Vec[string],
    pub constraints: Vec[tast::TypePredicate],
    pub associated_types: Vec[(string, tast::Type)],
    pub methods: Vec[ArtifactFnScheme],
    pub valid: bool,
}

pub struct ArtifactTraitImpl {
    pub trait_ref: tast::TraitRef,
    pub for_ty: tast::Type,
    pub definition: ArtifactImplDef,
}

pub enum ArtifactInherentImplKey {
    Exact(tast::Type),
    Constr(string),
}

pub struct ArtifactInherentImpl {
    pub key: ArtifactInherentImplKey,
    pub definition: ArtifactImplDef,
}

pub struct ArtifactGoExport {
    pub package_name: string,
    pub symbol: string,
    pub go_name: string,
    pub ty: tast::Type,
    pub source_file: string,
    pub start: isize,
    pub end: isize,
}

pub struct ArtifactPackageExports {
    pub go_exports: Vec[ArtifactGoExport],
    pub reexports: Vec[(string, string)],
    pub enum_type_names: Vec[string],
    pub struct_type_names: Vec[string],
    pub type_aliases: Vec[tast::TypeAliasInfo],
    pub enums: Vec[tast::EnumDef],
    pub structs: Vec[tast::StructDef],
    pub traits: Vec[ArtifactTraitDef],
    pub trait_impls: Vec[ArtifactTraitImpl],
    pub inherent_impls: Vec[ArtifactInherentImpl],
    pub functions: Vec[ArtifactFnScheme],
    pub constants: Vec[tast::ConstantScheme],
}

pub struct ArtifactPackageInterface {
    pub package_name: string,
    pub name: string,
    pub value_exports: Vec[(string, isize)],
    pub enum_variants: Vec[(string, Vec[string])],
}

pub struct ArtifactInterfaceUnit {
    pub foreign_types: Option[ffi::ForeignTypeMetadata],
    pub foreign_bindings: Vec[ffi::ForeignBinding],
    pub package_name: string,
    pub exports: ArtifactPackageExports,
    pub package_interface: ArtifactPackageInterface,
    pub comptime: Option[ArtifactComptimeUnit],
    pub deps: Vec[(string, string)],
    pub interface_hash: string,
}

pub struct ArtifactTestDescriptor {
    pub id: string,
    pub package_name: string,
    pub symbol: string,
    pub display_name: string,
    pub source_path: string,
    pub start: isize,
    pub end: isize,
    pub ignored: bool,
    pub ignore_reason: Option[string],
    pub arguments: Vec[(string, string)],
}

pub struct ArtifactSourceOrigin {
    pub symbol: string,
    pub source_file: string,
    pub start: isize,
    pub end: isize,
    pub line: isize,
    pub column: isize,
}

pub struct ArtifactCoreUnit {
    pub source_origins: Vec[ArtifactSourceOrigin],
    pub external_applications: Vec[core::ExternalTypeApplication],
    pub foreign_types: Option[ffi::ForeignTypeMetadata],
    pub package_name: string,
    pub declared_name: string,
    pub interface_hash: string,
    pub exports: ArtifactPackageExports,
    pub core_ir: core::File,
    pub deps: Vec[(string, string)],
    pub sources: Vec[string],
    pub tests: Vec[ArtifactTestDescriptor],
}
