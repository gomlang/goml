package builtin_codec;

use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn default_callback_requirements_preserve_legacy_builtin_positions() -> () {
    let signature = tast::Type::Func {
        params: Vec::from_array([tast::Type::Param { name: "T" }]),
        ret_ty: tast::Type::String,
    };
    let value = tast::TraitMethodInfo {
        name: "invoke",
        has_receiver: false,
        generics: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::GoCallback(signature)]),
        params: Vec::new(),
        ret_ty: tast::Type::Unit,
        default_name: Some("trait_default#Callback#invoke"),
        default_map_requirements: Vec::from_array([tast::Type::Int]),
        default_raw_function_requirements: Vec::from_array([signature]),
        default_const_requirements: Vec::from_array([tast::const_type(3)]),
        default_callback_requirements: Vec::from_array([signature]),
    };
    let writer = wire::new_artifact_value_writer();
    write_tast_trait_method_info(writer, value);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode method");
    let decoded = testing::expect_ok(read_tast_trait_method_info(encoded), "decode method");
    testing::assert(tast::types_equal(decoded.default_callback_requirements[0], signature));
    match decoded.predicates[0] {
        GoCallback(actual) => testing::assert(tast::types_equal(actual, signature)),
        _ => testing::fail("callback predicate was not retained"),
    }
    for count in[8, 9, 10] {
        let legacy = testing::expect_ok(
            read_tast_trait_method_info(raw_function_metadata_array_prefix(encoded, count)),
            "decode legacy method",
        );
        testing::assert(legacy.default_callback_requirements.is_empty());
        testing::assert(tast::types_equal(legacy.default_map_requirements[0], tast::Type::Int));
        testing::assert_eq(
            legacy.default_raw_function_requirements.len(),
            if count >= 9 {
                1
            } else {
                0
            },
        );
        testing::assert_eq(
            legacy.default_const_requirements.len(),
            if count >= 10 {
                1
            } else {
                0
            },
        );
        testing::assert(legacy.default_name == value.default_name);
    }
}
