package builtin_codec;

use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn constant_comparison_requirements_preserve_kind_and_legacy_positions() -> () {
    let ty = tast::Type::Param { name: "T" };
    let value = tast::TraitMethodInfo {
        name: "compare",
        has_receiver: false,
        generics: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::ConstComparison { ty, ordering: true }]),
        params: Vec::new(),
        ret_ty: tast::Type::Bool,
        default_name: Some("trait_default#Comparison#compare"),
        default_map_requirements: Vec::new(),
        default_raw_function_requirements: Vec::new(),
        default_const_requirements: Vec::new(),
        default_callback_requirements: Vec::new(),
        default_const_comparison_requirements: Vec::from_array([(ty, false), (ty, true)]),
    };
    let writer = wire::new_artifact_value_writer();
    write_tast_trait_method_info(writer, value);
    let encoded = testing::expect_ok(
        wire::artifact_value_finish(writer),
        "encode comparison requirements",
    );
    let decoded = testing::expect_ok(
        read_tast_trait_method_info(encoded),
        "decode comparison requirements",
    );
    testing::assert_eq(decoded.default_const_comparison_requirements.len(), 2);
    testing::assert(!decoded.default_const_comparison_requirements[0].1);
    testing::assert(decoded.default_const_comparison_requirements[1].1);
    testing::assert(tast::types_equal(decoded.default_const_comparison_requirements[0].0, ty));
    match decoded.predicates[0] {
        ConstComparison { ty: actual, ordering } => {
            testing::assert(ordering);
            testing::assert(tast::types_equal(actual, ty));
        },
        _ => testing::fail("comparison predicate was not retained"),
    }
    for count in[8, 9, 10, 11] {
        let legacy = testing::expect_ok(
            read_tast_trait_method_info(raw_function_metadata_array_prefix(encoded, count)),
            "decode legacy comparison requirements",
        );
        testing::assert(legacy.default_const_comparison_requirements.is_empty());
        testing::assert(legacy.default_name == value.default_name);
    }
}
