package builtin_codec;

use module::artifact::wire as wire;
use module::checker;
use module::tast;
use std::testing;

#[test]
fn builtin_metadata_round_trips_without_changing_contract_or_types() -> () {
    let Ok(metadata) = checker::builtin_metadata() else {
        testing::fail("builtin metadata unavailable");
        return
    };
    let Ok(encoded) = encode(metadata) else {
        testing::fail("builtin metadata encode failed");
        return
    };
    let Ok(decoded) = decode(encoded.as_slice()) else {
        testing::fail("builtin metadata decode failed");
        return
    };
    let Ok(reencoded) = encode(decoded) else {
        testing::fail("builtin metadata reencode failed");
        return
    };
    testing::assert(wire::artifact_binary_bytes_equal(encoded, reencoded));
    testing::assert(decoded.lang_items.len() > 0);
    testing::assert(decoded.traits.len() > 0);
    testing::assert(decoded.impls.len() > 0);
    testing::assert(decoded.functions.len() > 0);
    testing::assert(decode(encoded.as_slice().sub(0, encoded.len() - 1)).is_err());
}

#[test]
fn builtin_metadata_rejects_unresolved_deferred_methods() -> () {
    let Ok(metadata) = checker::builtin_metadata() else {
        testing::fail("builtin metadata unavailable");
        return
    };
    let value = tast::BuiltinMetadata {
        functions: Vec::from_array(
            [tast::FunctionScheme { callable: DeferredMethod(0), ..metadata.functions[0] }],
        ),
        ..metadata,
    };
    match encode(value) {
        Err(error) => testing::assert_eq(error, "unresolved deferred method in builtin metadata"),
        Ok(_) => testing::fail("unresolved deferred method was encoded"),
    }
}

#[test]
fn builtin_method_arguments_round_trip_and_reject_invalid_targets() -> () {
    let method = tast::Callable::InherentMethod {
        receiver_ty: tast::Type::Int,
        method_name: "count",
    };
    let instance = tast::Callable::MethodInstance {
        callable: method,
        args: Vec::from_array([tast::Type::Bool]),
    };
    let writer = wire::new_artifact_value_writer();
    testing::assert(write_tast_callable(writer, instance).is_ok());
    let Ok(encoded) = wire::artifact_value_finish(writer) else {
        testing::fail("encode failed");
        return
    };
    let Ok(decoded) = read_tast_callable(encoded) else {
        testing::fail("decode failed");
        return
    };
    let before = wire::new_artifact_json_writer(false);
    let after = wire::new_artifact_json_writer(false);
    testing::assert(write_tast_callable(before, instance).is_ok());
    testing::assert(write_tast_callable(after, decoded).is_ok());
    testing::assert_eq(wire::artifact_json_finish(before), wire::artifact_json_finish(after));
    for target in[instance, tast::Callable::Function("count")] {
        let writer = wire::new_artifact_value_writer();
        testing::assert(
            write_tast_callable(
                writer,
                tast::Callable::MethodInstance { callable: target, args: Vec::new() },
            ).is_ok(),
        );
        let Ok(encoded) = wire::artifact_value_finish(writer) else {
            testing::fail("encode failed");
            return
        };
        match read_tast_callable(encoded) {
            Err(error) => testing::assert_eq(error, "invalid generic method target"),
            Ok(_) => testing::fail("invalid method target accepted"),
        }
    }
}
