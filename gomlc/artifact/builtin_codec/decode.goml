package builtin_codec;

use module::artifact::wire as wire;
use module::artifact::tast_codec as tast_codec;
use module::tast;
use module::hir;
use module::ast;
use module::ffi;

fn read_tast_builtin_metadata(value: wire::ArtifactValue) -> Result[tast::BuiltinMetadata, string] {
    let array = required_tuple(value, 8)?;
    Result::Ok(
        tast::BuiltinMetadata {
            lang_items: read_vec_tast_builtin_lang_item(array.get(0))?,
            traits: read_vec_tast_trait_info(array.get(1))?,
            enums: read_vec_tast_enum_info(array.get(2))?,
            structs: read_vec_tast_struct_info(array.get(3))?,
            functions: read_vec_tast_function_scheme(array.get(4))?,
            arities: read_vec_string_isize(array.get(5))?,
            impls: read_vec_tast_impl_info(array.get(6))?,
            inherent_methods: read_vec_string_string(array.get(7))?,
        },
    )
}

fn read_vec_tast_builtin_lang_item(value: wire::ArtifactValue) -> Result[
    Vec[tast::BuiltinLangItem],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::BuiltinLangItem] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_builtin_lang_item(item)?);
    }
    Result::Ok(result)
}

fn read_tast_builtin_lang_item(value: wire::ArtifactValue) -> Result[tast::BuiltinLangItem, string] {
    let array = required_tuple(value, 8)?;
    Result::Ok(
        tast::BuiltinLangItem {
            item: read_string(array.get(0))?,
            kind: read_tast_builtin_lang_item_kind(array.get(1))?,
            name: read_string(array.get(2))?,
            properties: read_vec_string_string(array.get(3))?,
            variants: read_vec_string(array.get(4))?,
            variant_arities: read_vec_isize(array.get(5))?,
            methods: read_vec_string(array.get(6))?,
            associated_types: read_vec_string(array.get(7))?,
        },
    )
}

fn read_string(value: wire::ArtifactValue) -> Result[string, string] {
    wire::artifact_json_string_value(value, "builtin string")
}

fn read_tast_builtin_lang_item_kind(value: wire::ArtifactValue) -> Result[
    tast::BuiltinLangItemKind,
    string,
] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "Enum" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Enum),
        "Struct" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Struct),
        "Trait" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Trait),
        "Function" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Function),
        "Extern" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Extern),
        "TypeAlias" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::TypeAlias),
        "Constant" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Constant),
        "Static" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Static),
        "Impl" if array.len() == 1 => Result::Ok(tast::BuiltinLangItemKind::Impl),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_vec_string_string(value: wire::ArtifactValue) -> Result[Vec[(string, string)], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[(string, string)] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_string_string(item)?);
    }
    Result::Ok(result)
}

fn read_string_string(value: wire::ArtifactValue) -> Result[(string, string), string] {
    let array = required_tuple(value, 2)?;
    Result::Ok((read_string(array.get(0))?, read_string(array.get(1))?))
}

fn read_vec_string(value: wire::ArtifactValue) -> Result[Vec[string], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[string] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_string(item)?);
    }
    Result::Ok(result)
}

fn read_vec_isize(value: wire::ArtifactValue) -> Result[Vec[isize], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[isize] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_isize(item)?);
    }
    Result::Ok(result)
}

fn read_isize(value: wire::ArtifactValue) -> Result[isize, string] {
    wire::artifact_parse_nonnegative_int(
        wire::artifact_json_number_value(value, "builtin integer")?,
    )
}

fn read_vec_tast_trait_info(value: wire::ArtifactValue) -> Result[Vec[tast::TraitInfo], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::TraitInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_trait_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_trait_info(value: wire::ArtifactValue) -> Result[tast::TraitInfo, string] {
    let array = required_tuple(value, 6)?;
    Result::Ok(
        tast::TraitInfo {
            name: read_string(array.get(0))?,
            generics: read_vec_string(array.get(1))?,
            predicates: read_vec_tast_type_predicate(array.get(2))?,
            supertraits: read_vec_tast_trait_ref(array.get(3))?,
            associated_types: read_vec_tast_associated_type_info(array.get(4))?,
            methods: read_vec_tast_trait_method_info(array.get(5))?,
        },
    )
}

fn read_vec_tast_type_predicate(value: wire::ArtifactValue) -> Result[
    Vec[tast::TypePredicate],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::TypePredicate] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_type_predicate(item)?);
    }
    Result::Ok(result)
}

fn read_tast_type_predicate(value: wire::ArtifactValue) -> Result[tast::TypePredicate, string] {
    tast_codec::artifact_decode_predicate(tast_codec::new_artifact_decode_context(), value)
}

fn read_vec_tast_trait_ref(value: wire::ArtifactValue) -> Result[Vec[tast::TraitRef], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::TraitRef] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_trait_ref(item)?);
    }
    Result::Ok(result)
}

fn read_tast_trait_ref(value: wire::ArtifactValue) -> Result[tast::TraitRef, string] {
    tast_codec::artifact_decode_trait_ref(tast_codec::new_artifact_decode_context(), value)
}

fn read_vec_tast_associated_type_info(value: wire::ArtifactValue) -> Result[
    Vec[tast::AssociatedTypeInfo],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::AssociatedTypeInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_associated_type_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_associated_type_info(value: wire::ArtifactValue) -> Result[
    tast::AssociatedTypeInfo,
    string,
] {
    let array = required_tuple(value, 2)?;
    Result::Ok(
        tast::AssociatedTypeInfo {
            name: read_string(array.get(0))?,
            bounds: read_vec_tast_trait_ref(array.get(1))?,
        },
    )
}

fn read_vec_tast_trait_method_info(value: wire::ArtifactValue) -> Result[
    Vec[tast::TraitMethodInfo],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::TraitMethodInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_trait_method_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_trait_method_info(value: wire::ArtifactValue) -> Result[tast::TraitMethodInfo, string] {
    let array = required_tuple(value, 8)?;
    Result::Ok(
        tast::TraitMethodInfo {
            default_map_requirements: read_vec_tast_type(array.get(0))?,
            name: read_string(array.get(1))?,
            has_receiver: read_bool(array.get(2))?,
            generics: read_vec_string(array.get(3))?,
            predicates: read_vec_tast_type_predicate(array.get(4))?,
            params: read_vec_tast_type(array.get(5))?,
            ret_ty: read_tast_type(array.get(6))?,
            default_name: read_option_string(array.get(7))?,
        },
    )
}

fn read_vec_tast_type(value: wire::ArtifactValue) -> Result[Vec[tast::Type], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::Type] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_type(item)?);
    }
    Result::Ok(result)
}

fn read_tast_type(value: wire::ArtifactValue) -> Result[tast::Type, string] {
    tast_codec::artifact_decode_type(tast_codec::new_artifact_decode_context(), value)
}

fn read_bool(value: wire::ArtifactValue) -> Result[bool, string] {
    wire::artifact_json_bool_value(value, "builtin boolean")
}

fn read_option_string(value: wire::ArtifactValue) -> Result[Option[string], string] {
    match value {
        wire::ArtifactValue::Null => Result::Ok(Option::None),
        other => Result::Ok(Option::Some(read_string(other)?)),
    }
}

fn read_vec_tast_enum_info(value: wire::ArtifactValue) -> Result[Vec[tast::EnumInfo], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::EnumInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_enum_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_enum_info(value: wire::ArtifactValue) -> Result[tast::EnumInfo, string] {
    let array = required_tuple(value, 5)?;
    Result::Ok(
        tast::EnumInfo {
            map_requirements: read_vec_tast_type(array.get(0))?,
            def_id: read_hir_def_id(array.get(1))?,
            name: read_string(array.get(2))?,
            generics: read_vec_string(array.get(3))?,
            variants: read_vec_tast_enum_variant_info(array.get(4))?,
        },
    )
}

fn read_hir_def_id(value: wire::ArtifactValue) -> Result[hir::DefId, string] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "Source" if array.len() == 3 => Result::Ok(
            hir::DefId::Source {
                package_name: read_string(array.get(1))?,
                index: read_isize(array.get(2))?,
            },
        ),
        "External" if array.len() == 2 => Result::Ok(
            hir::DefId::External { name: read_string(array.get(1))? },
        ),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_vec_tast_enum_variant_info(value: wire::ArtifactValue) -> Result[
    Vec[tast::EnumVariantInfo],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::EnumVariantInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_enum_variant_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_enum_variant_info(value: wire::ArtifactValue) -> Result[tast::EnumVariantInfo, string] {
    let array = required_tuple(value, 2)?;
    Result::Ok(
        tast::EnumVariantInfo {
            name: read_string(array.get(0))?,
            fields: read_tast_enum_variant_fields(array.get(1))?,
        },
    )
}

fn read_tast_enum_variant_fields(value: wire::ArtifactValue) -> Result[
    tast::EnumVariantFields,
    string,
] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "Unit" if array.len() == 1 => Result::Ok(tast::EnumVariantFields::Unit),
        "Tuple" if array.len() == 2 => Result::Ok(
            tast::EnumVariantFields::Tuple(read_vec_tast_type(array.get(1))?),
        ),
        "Struct" if array.len() == 2 => Result::Ok(
            tast::EnumVariantFields::Struct(read_vec_string_tast_type(array.get(1))?),
        ),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_vec_string_tast_type(value: wire::ArtifactValue) -> Result[
    Vec[(string, tast::Type)],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[(string, tast::Type)] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_string_tast_type(item)?);
    }
    Result::Ok(result)
}

fn read_string_tast_type(value: wire::ArtifactValue) -> Result[(string, tast::Type), string] {
    let array = required_tuple(value, 2)?;
    Result::Ok((read_string(array.get(0))?, read_tast_type(array.get(1))?))
}

fn read_vec_tast_struct_info(value: wire::ArtifactValue) -> Result[Vec[tast::StructInfo], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::StructInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_struct_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_struct_info(value: wire::ArtifactValue) -> Result[tast::StructInfo, string] {
    let array = wire::artifact_json_array(value, "builtin struct")?;
    if array.len() != 8 && array.len() != 9 {
        return Err(wire::artifact_decode_error("builtin struct fields"))
    }
    Result::Ok(
        tast::StructInfo {
            map_requirements: read_vec_tast_type(array.get(0))?,
            def_id: read_hir_def_id(array.get(1))?,
            name: read_string(array.get(2))?,
            generics: read_vec_string(array.get(3))?,
            fields: read_vec_string_tast_type(array.get(4))?,
            public_fields: read_vec_string(array.get(5))?,
            module_fields: if array.len() == 9 {
                read_vec_string(array.get(8))?
            } else {
                Vec::new()
            },
            has_hidden_fields: read_bool(array.get(6))?,
            go_comparable: read_option_ffi_go_comparability(array.get(7))?,
        },
    )
}

fn read_option_ffi_go_comparability(value: wire::ArtifactValue) -> Result[
    Option[ffi::GoComparability],
    string,
] {
    match value {
        wire::ArtifactValue::Null => Result::Ok(Option::None),
        other => Result::Ok(Option::Some(read_ffi_go_comparability(other)?)),
    }
}

fn read_ffi_go_comparability(value: wire::ArtifactValue) -> Result[ffi::GoComparability, string] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "Always" if array.len() == 1 => Result::Ok(ffi::GoComparability::Always),
        "Never" if array.len() == 1 => Result::Ok(ffi::GoComparability::Never),
        "Parameter" if array.len() == 2 => Result::Ok(
            ffi::GoComparability::Parameter(read_isize(array.get(1))?),
        ),
        "All" if array.len() == 2 => Result::Ok(
            ffi::GoComparability::All(read_vec_ffi_go_comparability(array.get(1))?),
        ),
        "Unknown" if array.len() == 1 => Result::Ok(ffi::GoComparability::Unknown),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_vec_ffi_go_comparability(value: wire::ArtifactValue) -> Result[
    Vec[ffi::GoComparability],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[ffi::GoComparability] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_ffi_go_comparability(item)?);
    }
    Result::Ok(result)
}

fn read_vec_tast_function_scheme(value: wire::ArtifactValue) -> Result[
    Vec[tast::FunctionScheme],
    string,
] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::FunctionScheme] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_function_scheme(item)?);
    }
    Result::Ok(result)
}

fn read_tast_function_scheme(value: wire::ArtifactValue) -> Result[tast::FunctionScheme, string] {
    let array = required_tuple(value, 8)?;
    Result::Ok(
        tast::FunctionScheme {
            def_id: read_option_hir_def_id(array.get(0))?,
            name: read_string(array.get(1))?,
            comptime: read_tast_comptime_capability(array.get(2))?,
            generics: read_vec_string(array.get(3))?,
            predicates: read_vec_tast_type_predicate(array.get(4))?,
            params: read_vec_tast_type(array.get(5))?,
            ret_ty: read_tast_type(array.get(6))?,
            callable: read_tast_callable(array.get(7))?,
        },
    )
}

fn read_option_hir_def_id(value: wire::ArtifactValue) -> Result[Option[hir::DefId], string] {
    match value {
        wire::ArtifactValue::Null => Result::Ok(Option::None),
        other => Result::Ok(Option::Some(read_hir_def_id(other)?)),
    }
}

fn read_tast_comptime_capability(value: wire::ArtifactValue) -> Result[
    tast::ComptimeCapability,
    string,
] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "RuntimeOnly" if array.len() == 1 => Result::Ok(tast::ComptimeCapability::RuntimeOnly),
        "Capable" if array.len() == 1 => Result::Ok(tast::ComptimeCapability::Capable),
        "Derive" if array.len() == 1 => Result::Ok(tast::ComptimeCapability::Derive),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_tast_callable(value: wire::ArtifactValue) -> Result[tast::Callable, string] {
    let array = wire::artifact_json_array(value, "builtin variant")?;
    if array.is_empty() {
        return Result::Err("empty builtin variant");
    }
    let tag = read_string(array.get(0))?;
    match tag {
        "GoInterfaceBridge" if array.len() == 3 => Result::Ok(
            tast::Callable::GoInterfaceBridge {
                binding: read_string(array.get(1))?,
                methods: read_vec_string(array.get(2))?,
            },
        ),
        "Function" if array.len() == 2 => Result::Ok(
            tast::Callable::Function(read_string(array.get(1))?),
        ),
        "FunctionInstance" if array.len() == 3 => Result::Ok(
            tast::Callable::FunctionInstance {
                name: read_string(array.get(1))?,
                bindings: read_vec_string_tast_type(array.get(2))?,
            },
        ),
        "LangItem" if array.len() == 3 => Result::Ok(
            tast::Callable::LangItem {
                item: read_string(array.get(1))?,
                function_name: read_string(array.get(2))?,
            },
        ),
        "Runtime" if array.len() == 2 => Result::Ok(
            tast::Callable::Runtime(read_string(array.get(1))?),
        ),
        "Intrinsic" if array.len() == 2 => Result::Ok(
            tast::Callable::Intrinsic(read_string(array.get(1))?),
        ),
        "GoMethod" if array.len() == 3 => Result::Ok(
            tast::Callable::GoMethod {
                binding: read_string(array.get(1))?,
                symbol: read_string(array.get(2))?,
            },
        ),
        "GoForeign" if array.len() == 4 => Result::Ok(
            tast::Callable::GoForeign {
                binding: read_string(array.get(1))?,
                import_path: read_string(array.get(2))?,
                symbol: read_string(array.get(3))?,
            },
        ),
        "TraitMethod" if array.len() == 5 => Result::Ok(
            tast::Callable::TraitMethod {
                trait_ref: read_tast_trait_ref(array.get(1))?,
                method_name: read_string(array.get(2))?,
                for_ty: read_tast_type(array.get(3))?,
                has_receiver: read_bool(array.get(4))?,
            },
        ),
        "DynTraitMethod" if array.len() == 4 => Result::Ok(
            tast::Callable::DynTraitMethod {
                trait_name: read_string(array.get(1))?,
                dispatch_name: read_string(array.get(2))?,
                method_name: read_string(array.get(3))?,
            },
        ),
        "InherentMethod" if array.len() == 3 => Result::Ok(
            tast::Callable::InherentMethod {
                receiver_ty: read_tast_type(array.get(1))?,
                method_name: read_string(array.get(2))?,
            },
        ),
        _ => Result::Err("invalid builtin variant"),
    }
}

fn read_vec_string_isize(value: wire::ArtifactValue) -> Result[Vec[(string, isize)], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[(string, isize)] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_string_isize(item)?);
    }
    Result::Ok(result)
}

fn read_string_isize(value: wire::ArtifactValue) -> Result[(string, isize), string] {
    let array = required_tuple(value, 2)?;
    Result::Ok((read_string(array.get(0))?, read_isize(array.get(1))?))
}

fn read_vec_tast_impl_info(value: wire::ArtifactValue) -> Result[Vec[tast::ImplInfo], string] {
    let array = wire::artifact_json_array(value, "builtin vector")?;
    let result: Vec[tast::ImplInfo] = Vec::with_capacity(array.len());
    for item in array {
        result.push(read_tast_impl_info(item)?);
    }
    Result::Ok(result)
}

fn read_tast_impl_info(value: wire::ArtifactValue) -> Result[tast::ImplInfo, string] {
    let array = required_tuple(value, 7)?;
    Result::Ok(
        tast::ImplInfo {
            generics: read_vec_string(array.get(0))?,
            predicates: read_vec_tast_type_predicate(array.get(1))?,
            trait_ref: read_tast_trait_ref(array.get(2))?,
            for_type: read_tast_type(array.get(3))?,
            associated_types: read_vec_string_tast_type(array.get(4))?,
            origin: read_string(array.get(5))?,
            span: read_ast_span(array.get(6))?,
        },
    )
}

fn read_ast_span(value: wire::ArtifactValue) -> Result[ast::Span, string] {
    let array = required_tuple(value, 2)?;
    Result::Ok(ast::Span { start: read_isize(array.get(0))?, end: read_isize(array.get(1))? })
}

fn required_tuple(value: wire::ArtifactValue, count: isize) -> Result[wire::ArtifactArray, string] {
    let array = wire::artifact_json_array(value, "builtin record")?;
    if array.len() != count {
        Result::Err("invalid builtin record length")
    } else {
        Result::Ok(array)
    }
}
