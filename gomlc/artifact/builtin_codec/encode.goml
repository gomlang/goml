package builtin_codec;

use module::artifact::wire as wire;
use module::artifact::tast_codec as tast_codec;
use module::tast;
use module::hir;
use module::ast;
use module::ffi;

fn write_tast_builtin_metadata(writer: wire::ArtifactJsonWriter, value: tast::BuiltinMetadata) -> Result[
    (),
    string,
] {
    wire::artifact_json_begin_array(writer);
    write_vec_tast_builtin_lang_item(writer, value.lang_items);
    write_vec_tast_trait_info(writer, value.traits);
    write_vec_tast_enum_info(writer, value.enums);
    write_vec_tast_struct_info(writer, value.structs);
    write_vec_tast_function_scheme(writer, value.functions)?;
    write_vec_string_isize(writer, value.arities);
    write_vec_tast_impl_info(writer, value.impls);
    write_vec_string_string(writer, value.inherent_methods);
    wire::artifact_json_end_array(writer);
    Ok(())
}

fn write_vec_tast_builtin_lang_item(
    writer: wire::ArtifactJsonWriter,
    value: Vec[tast::BuiltinLangItem],
) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_builtin_lang_item(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_builtin_lang_item(writer: wire::ArtifactJsonWriter, value: tast::BuiltinLangItem) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.item);
    write_tast_builtin_lang_item_kind(writer, value.kind);
    write_string(writer, value.name);
    write_vec_string_string(writer, value.properties);
    write_vec_string(writer, value.variants);
    write_vec_isize(writer, value.variant_arities);
    write_vec_string(writer, value.methods);
    write_vec_string(writer, value.associated_types);
    wire::artifact_json_end_array(writer)
}

fn write_string(writer: wire::ArtifactJsonWriter, value: string) -> () {
    wire::artifact_json_string(writer, value)
}

fn write_tast_builtin_lang_item_kind(
    writer: wire::ArtifactJsonWriter,
    value: tast::BuiltinLangItemKind,
) -> () {
    wire::artifact_json_begin_array(writer);
    match value {
        tast::BuiltinLangItemKind::Enum => {
            wire::artifact_json_string(writer, "Enum");
        },
        tast::BuiltinLangItemKind::Struct => {
            wire::artifact_json_string(writer, "Struct");
        },
        tast::BuiltinLangItemKind::Trait => {
            wire::artifact_json_string(writer, "Trait");
        },
        tast::BuiltinLangItemKind::Function => {
            wire::artifact_json_string(writer, "Function");
        },
        tast::BuiltinLangItemKind::Extern => {
            wire::artifact_json_string(writer, "Extern");
        },
        tast::BuiltinLangItemKind::TypeAlias => {
            wire::artifact_json_string(writer, "TypeAlias");
        },
        tast::BuiltinLangItemKind::Constant => {
            wire::artifact_json_string(writer, "Constant");
        },
        tast::BuiltinLangItemKind::Static => {
            wire::artifact_json_string(writer, "Static");
        },
        tast::BuiltinLangItemKind::Impl => {
            wire::artifact_json_string(writer, "Impl");
        },
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_string_string(writer: wire::ArtifactJsonWriter, value: Vec[(string, string)]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_string_string(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_string_string(writer: wire::ArtifactJsonWriter, value: (string, string)) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.0);
    write_string(writer, value.1);
    wire::artifact_json_end_array(writer)
}

fn write_vec_string(writer: wire::ArtifactJsonWriter, value: Vec[string]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_string(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_isize(writer: wire::ArtifactJsonWriter, value: Vec[isize]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_isize(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_isize(writer: wire::ArtifactJsonWriter, value: isize) -> () {
    wire::artifact_json_number(writer, value.to_string())
}

fn write_vec_tast_trait_info(writer: wire::ArtifactJsonWriter, value: Vec[tast::TraitInfo]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_trait_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_trait_info(writer: wire::ArtifactJsonWriter, value: tast::TraitInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.name);
    write_vec_string(writer, value.generics);
    write_vec_tast_type_predicate(writer, value.predicates);
    write_vec_tast_trait_ref(writer, value.supertraits);
    write_vec_tast_associated_type_info(writer, value.associated_types);
    write_vec_tast_trait_method_info(writer, value.methods);
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_type_predicate(writer: wire::ArtifactJsonWriter, value: Vec[tast::TypePredicate]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_type_predicate(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_type_predicate(writer: wire::ArtifactJsonWriter, value: tast::TypePredicate) -> () {
    tast_codec::artifact_json_type_predicate(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    )
}

fn write_vec_tast_trait_ref(writer: wire::ArtifactJsonWriter, value: Vec[tast::TraitRef]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_trait_ref(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_trait_ref(writer: wire::ArtifactJsonWriter, value: tast::TraitRef) -> () {
    tast_codec::artifact_json_trait_ref(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    )
}

fn write_vec_tast_associated_type_info(
    writer: wire::ArtifactJsonWriter,
    value: Vec[tast::AssociatedTypeInfo],
) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_associated_type_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_associated_type_info(
    writer: wire::ArtifactJsonWriter,
    value: tast::AssociatedTypeInfo,
) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.name);
    write_vec_tast_trait_ref(writer, value.bounds);
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_trait_method_info(
    writer: wire::ArtifactJsonWriter,
    value: Vec[tast::TraitMethodInfo],
) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_trait_method_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_trait_method_info(writer: wire::ArtifactJsonWriter, value: tast::TraitMethodInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_vec_tast_type(writer, value.default_map_requirements);
    write_string(writer, value.name);
    write_bool(writer, value.has_receiver);
    write_vec_string(writer, value.generics);
    write_vec_tast_type_predicate(writer, value.predicates);
    write_vec_tast_type(writer, value.params);
    write_tast_type(writer, value.ret_ty);
    write_option_string(writer, value.default_name);
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_type(writer: wire::ArtifactJsonWriter, value: Vec[tast::Type]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_type(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_type(writer: wire::ArtifactJsonWriter, value: tast::Type) -> () {
    tast_codec::artifact_json_type(
        writer,
        tast_codec::artifact_type_context(Vec::new(), Vec::new()),
        value,
    )
}

fn write_bool(writer: wire::ArtifactJsonWriter, value: bool) -> () {
    wire::artifact_json_bool(writer, value)
}

fn write_option_string(writer: wire::ArtifactJsonWriter, value: Option[string]) -> () {
    match value {
        Some(item) => {
            write_string(writer, item);
        },
        None => wire::artifact_json_null(writer),
    }
}

fn write_vec_tast_enum_info(writer: wire::ArtifactJsonWriter, value: Vec[tast::EnumInfo]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_enum_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_enum_info(writer: wire::ArtifactJsonWriter, value: tast::EnumInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_vec_tast_type(writer, value.map_requirements);
    write_hir_def_id(writer, value.def_id);
    write_string(writer, value.name);
    write_vec_string(writer, value.generics);
    write_vec_tast_enum_variant_info(writer, value.variants);
    wire::artifact_json_end_array(writer)
}

fn write_hir_def_id(writer: wire::ArtifactJsonWriter, value: hir::DefId) -> () {
    wire::artifact_json_begin_array(writer);
    match value {
        hir::DefId::Source { package_name, index } => {
            wire::artifact_json_string(writer, "Source");
            write_string(writer, package_name);
            write_isize(writer, index);
        },
        hir::DefId::External { name } => {
            wire::artifact_json_string(writer, "External");
            write_string(writer, name);
        },
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_enum_variant_info(
    writer: wire::ArtifactJsonWriter,
    value: Vec[tast::EnumVariantInfo],
) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_enum_variant_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_enum_variant_info(writer: wire::ArtifactJsonWriter, value: tast::EnumVariantInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.name);
    write_tast_enum_variant_fields(writer, value.fields);
    wire::artifact_json_end_array(writer)
}

fn write_tast_enum_variant_fields(writer: wire::ArtifactJsonWriter, value: tast::EnumVariantFields) -> () {
    wire::artifact_json_begin_array(writer);
    match value {
        tast::EnumVariantFields::Unit => {
            wire::artifact_json_string(writer, "Unit");
        },
        tast::EnumVariantFields::Tuple(value) => {
            wire::artifact_json_string(writer, "Tuple");
            write_vec_tast_type(writer, value);
        },
        tast::EnumVariantFields::Struct(value) => {
            wire::artifact_json_string(writer, "Struct");
            write_vec_string_tast_type(writer, value);
        },
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_string_tast_type(writer: wire::ArtifactJsonWriter, value: Vec[(string, tast::Type)]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_string_tast_type(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_string_tast_type(writer: wire::ArtifactJsonWriter, value: (string, tast::Type)) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.0);
    write_tast_type(writer, value.1);
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_struct_info(writer: wire::ArtifactJsonWriter, value: Vec[tast::StructInfo]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_struct_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_struct_info(writer: wire::ArtifactJsonWriter, value: tast::StructInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_vec_tast_type(writer, value.map_requirements);
    write_hir_def_id(writer, value.def_id);
    write_string(writer, value.name);
    write_vec_string(writer, value.generics);
    write_vec_string_tast_type(writer, value.fields);
    write_vec_string(writer, value.public_fields);
    write_bool(writer, value.has_hidden_fields);
    write_option_ffi_go_comparability(writer, value.go_comparable);
    if !value.module_fields.is_empty() {
        write_vec_string(writer, value.module_fields)
    }
    wire::artifact_json_end_array(writer)
}

fn write_option_ffi_go_comparability(
    writer: wire::ArtifactJsonWriter,
    value: Option[ffi::GoComparability],
) -> () {
    match value {
        Some(item) => {
            write_ffi_go_comparability(writer, item);
        },
        None => wire::artifact_json_null(writer),
    }
}

fn write_ffi_go_comparability(writer: wire::ArtifactJsonWriter, value: ffi::GoComparability) -> () {
    wire::artifact_json_begin_array(writer);
    match value {
        ffi::GoComparability::Always => {
            wire::artifact_json_string(writer, "Always");
        },
        ffi::GoComparability::Never => {
            wire::artifact_json_string(writer, "Never");
        },
        ffi::GoComparability::Parameter(value) => {
            wire::artifact_json_string(writer, "Parameter");
            write_isize(writer, value);
        },
        ffi::GoComparability::All(value) => {
            wire::artifact_json_string(writer, "All");
            write_vec_ffi_go_comparability(writer, value);
        },
        ffi::GoComparability::Unknown => {
            wire::artifact_json_string(writer, "Unknown");
        },
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_ffi_go_comparability(
    writer: wire::ArtifactJsonWriter,
    value: Vec[ffi::GoComparability],
) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_ffi_go_comparability(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_function_scheme(
    writer: wire::ArtifactJsonWriter,
    value: Vec[tast::FunctionScheme],
) -> Result[(), string] {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_function_scheme(writer, item)?;
    }
    wire::artifact_json_end_array(writer);
    Ok(())
}

fn write_tast_function_scheme(writer: wire::ArtifactJsonWriter, value: tast::FunctionScheme) -> Result[
    (),
    string,
] {
    wire::artifact_json_begin_array(writer);
    write_option_hir_def_id(writer, value.def_id);
    write_string(writer, value.name);
    write_tast_comptime_capability(writer, value.comptime);
    write_vec_string(writer, value.generics);
    write_vec_tast_type_predicate(writer, value.predicates);
    write_vec_tast_type(writer, value.params);
    write_tast_type(writer, value.ret_ty);
    write_tast_callable(writer, value.callable)?;
    wire::artifact_json_end_array(writer);
    Ok(())
}

fn write_option_hir_def_id(writer: wire::ArtifactJsonWriter, value: Option[hir::DefId]) -> () {
    match value {
        Some(item) => {
            write_hir_def_id(writer, item);
        },
        None => wire::artifact_json_null(writer),
    }
}

fn write_tast_comptime_capability(writer: wire::ArtifactJsonWriter, value: tast::ComptimeCapability) -> () {
    wire::artifact_json_begin_array(writer);
    match value {
        tast::ComptimeCapability::RuntimeOnly => {
            wire::artifact_json_string(writer, "RuntimeOnly");
        },
        tast::ComptimeCapability::Capable => {
            wire::artifact_json_string(writer, "Capable");
        },
        tast::ComptimeCapability::Derive => {
            wire::artifact_json_string(writer, "Derive");
        },
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_callable(writer: wire::ArtifactJsonWriter, value: tast::Callable) -> Result[
    (),
    string,
] {
    wire::artifact_json_begin_array(writer);
    match value {
        DeferredMethod(_) => return Err("unresolved deferred method in builtin metadata"),
        tast::Callable::GoInterfaceBridge { binding, methods } => {
            wire::artifact_json_string(writer, "GoInterfaceBridge");
            write_string(writer, binding);
            write_vec_string(writer, methods);
        },
        tast::Callable::Function(value) => {
            wire::artifact_json_string(writer, "Function");
            write_string(writer, value);
        },
        tast::Callable::MethodInstance { callable, args } => {
            wire::artifact_json_string(writer, "MethodInstance");
            write_tast_callable(writer, callable)?;
            write_vec_tast_type(writer, args);
        },
        tast::Callable::FunctionInstance { name, bindings } => {
            wire::artifact_json_string(writer, "FunctionInstance");
            write_string(writer, name);
            write_vec_string_tast_type(writer, bindings);
        },
        tast::Callable::LangItem { item, function_name } => {
            wire::artifact_json_string(writer, "LangItem");
            write_string(writer, item);
            write_string(writer, function_name);
        },
        tast::Callable::Runtime(value) => {
            wire::artifact_json_string(writer, "Runtime");
            write_string(writer, value);
        },
        tast::Callable::Intrinsic(value) => {
            wire::artifact_json_string(writer, "Intrinsic");
            write_string(writer, value);
        },
        tast::Callable::GoMethod { binding, symbol } => {
            wire::artifact_json_string(writer, "GoMethod");
            write_string(writer, binding);
            write_string(writer, symbol);
        },
        tast::Callable::GoForeign { binding, import_path, symbol } => {
            wire::artifact_json_string(writer, "GoForeign");
            write_string(writer, binding);
            write_string(writer, import_path);
            write_string(writer, symbol);
        },
        tast::Callable::TraitMethod { trait_ref, method_name, for_ty, has_receiver } => {
            wire::artifact_json_string(writer, "TraitMethod");
            write_tast_trait_ref(writer, trait_ref);
            write_string(writer, method_name);
            write_tast_type(writer, for_ty);
            write_bool(writer, has_receiver);
        },
        tast::Callable::DynTraitMethod { trait_name, dispatch_name, method_name } => {
            wire::artifact_json_string(writer, "DynTraitMethod");
            write_string(writer, trait_name);
            write_string(writer, dispatch_name);
            write_string(writer, method_name);
        },
        tast::Callable::InherentMethod { receiver_ty, method_name } => {
            wire::artifact_json_string(writer, "InherentMethod");
            write_tast_type(writer, receiver_ty);
            write_string(writer, method_name);
        },
    }
    wire::artifact_json_end_array(writer);
    Ok(())
}

fn write_vec_string_isize(writer: wire::ArtifactJsonWriter, value: Vec[(string, isize)]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_string_isize(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_string_isize(writer: wire::ArtifactJsonWriter, value: (string, isize)) -> () {
    wire::artifact_json_begin_array(writer);
    write_string(writer, value.0);
    write_isize(writer, value.1);
    wire::artifact_json_end_array(writer)
}

fn write_vec_tast_impl_info(writer: wire::ArtifactJsonWriter, value: Vec[tast::ImplInfo]) -> () {
    wire::artifact_json_begin_array(writer);
    for item in value {
        write_tast_impl_info(writer, item);
    }
    wire::artifact_json_end_array(writer)
}

fn write_tast_impl_info(writer: wire::ArtifactJsonWriter, value: tast::ImplInfo) -> () {
    wire::artifact_json_begin_array(writer);
    write_vec_string(writer, value.generics);
    write_vec_tast_type_predicate(writer, value.predicates);
    write_tast_trait_ref(writer, value.trait_ref);
    write_tast_type(writer, value.for_type);
    write_vec_string_tast_type(writer, value.associated_types);
    write_string(writer, value.origin);
    write_ast_span(writer, value.span);
    wire::artifact_json_end_array(writer)
}

fn write_ast_span(writer: wire::ArtifactJsonWriter, value: ast::Span) -> () {
    wire::artifact_json_begin_array(writer);
    write_isize(writer, value.start);
    write_isize(writer, value.end);
    wire::artifact_json_end_array(writer)
}
