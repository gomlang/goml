package builtin_codec;

use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn default_raw_function_requirements_preserve_builtin_legacy_positions() -> () {
    let signature = tast::Type::Func {
        params: Vec::from_array([tast::Type::Param { name: "T" }]),
        ret_ty: tast::Type::Unit,
    };
    let value = tast::TraitMethodInfo {
        default_const_comparison_requirements: Vec::new(),
        default_callback_requirements: Vec::new(),
        default_const_requirements: Vec::from_array([tast::Type::Param { name: "$const_param:N" }]),
        name: "invoke",
        has_receiver: false,
        generics: Vec::from_array(["T"]),
        predicates: Vec::from_array([tast::TypePredicate::GoFunction(signature)]),
        params: Vec::new(),
        ret_ty: tast::Type::Unit,
        default_name: Some("trait_default#Callback#invoke"),
        default_map_requirements: Vec::from_array([tast::Type::Int]),
        default_raw_function_requirements: Vec::from_array([signature]),
    };
    let writer = wire::new_artifact_value_writer();
    write_tast_trait_method_info(writer, value);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode method");
    let decoded = testing::expect_ok(read_tast_trait_method_info(encoded), "decode method");
    testing::assert(tast::types_equal(decoded.default_raw_function_requirements[0], signature));
    testing::assert_eq(decoded.default_const_requirements.len(), 1);
    testing::assert(
        tast::types_equal(
            decoded.default_const_requirements[0],
            value.default_const_requirements[0],
        ),
    );
    match decoded.predicates[0] {
        GoFunction(actual) => testing::assert(tast::types_equal(actual, signature)),
        _ => testing::fail("raw function predicate was not retained"),
    }
    let legacy = testing::expect_ok(
        read_tast_trait_method_info(raw_function_metadata_array_prefix(encoded, 8)),
        "decode legacy method",
    );
    testing::assert(legacy.default_raw_function_requirements.is_empty());
    testing::assert(legacy.default_const_requirements.is_empty());
    let previous = testing::expect_ok(
        read_tast_trait_method_info(raw_function_metadata_array_prefix(encoded, 9)),
        "decode previous method",
    );
    testing::assert(previous.default_const_requirements.is_empty());
    testing::assert(tast::types_equal(previous.default_raw_function_requirements[0], signature));
    testing::assert(tast::types_equal(legacy.default_map_requirements[0], tast::Type::Int));
    testing::assert(legacy.default_name == value.default_name);
}
