package builtin_codec;

use module::artifact::wire;
use module::hir;
use module::tast;
use std::testing;

fn raw_function_metadata_array_prefix(value: wire::ArtifactValue, count: isize) -> wire::ArtifactValue {
    let fields = Vec::new();
    if let Array(values) = value {
        for index in 0..count {
            fields.push(values[index])
        }
    }
    wire::ArtifactValue::Array(fields)
}

#[test]
fn builtin_raw_function_requirements_preserve_legacy_array_positions() -> () {
    let requirement = tast::Type::GoFunction {
        signature: tast::Type::Func {
            params: Vec::from_array([tast::Type::Int32]),
            ret_ty: tast::Type::Unit,
        },
    };
    let constant = tast::const_type(7);
    let value = tast::StructInfo {
        def_id: hir::source_definition("audit", 0),
        name: "audit::Callbacks",
        generics: Vec::new(),
        fields: Vec::new(),
        public_fields: Vec::new(),
        module_fields: Vec::new(),
        has_hidden_fields: true,
        go_comparable: None,
        map_requirements: Vec::new(),
        raw_function_requirements: Vec::from_array([requirement]),
        const_requirements: Vec::from_array([constant]),
    };
    let writer = wire::new_artifact_value_writer();
    write_tast_struct_info(writer, value);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode struct");
    let decoded = testing::expect_ok(read_tast_struct_info(encoded), "decode struct");
    testing::assert(tast::types_equal(decoded.raw_function_requirements[0], requirement));
    testing::assert(tast::types_equal(decoded.const_requirements[0], constant));
    for count in[8, 9, 10] {
        let legacy = testing::expect_ok(
            read_tast_struct_info(raw_function_metadata_array_prefix(encoded, count)),
            "decode legacy struct",
        );
        testing::assert(legacy.raw_function_requirements.is_empty());
        testing::assert_eq(
            legacy.const_requirements.len(),
            if count == 10 {
                1
            } else {
                0
            },
        );
    }
    let value = tast::EnumInfo {
        def_id: hir::source_definition("audit", 1),
        name: "audit::Choice",
        generics: Vec::new(),
        variants: Vec::new(),
        map_requirements: Vec::new(),
        raw_function_requirements: Vec::from_array([requirement]),
        const_requirements: Vec::from_array([constant]),
    };
    let writer = wire::new_artifact_value_writer();
    write_tast_enum_info(writer, value);
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "encode enum");
    let decoded = testing::expect_ok(read_tast_enum_info(encoded), "decode enum");
    testing::assert(tast::types_equal(decoded.raw_function_requirements[0], requirement));
    testing::assert(tast::types_equal(decoded.const_requirements[0], constant));
    for count in[5, 6] {
        let legacy = testing::expect_ok(
            read_tast_enum_info(raw_function_metadata_array_prefix(encoded, count)),
            "decode legacy enum",
        );
        testing::assert(legacy.raw_function_requirements.is_empty());
        testing::assert_eq(
            legacy.const_requirements.len(),
            if count == 6 {
                1
            } else {
                0
            },
        );
    }
}
