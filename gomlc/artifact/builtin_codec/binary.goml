package builtin_codec;

use module::artifact::wire as wire;
use module::tast;
use std::bytes;

pub fn encode(value: tast::BuiltinMetadata) -> Result[bytes::Bytes, string] {
    let collector = wire::new_artifact_binary_string_collector();
    write_tast_builtin_metadata(collector, value)?;
    let table = wire::artifact_binary_collected_string_table(collector);
    let writer = wire::new_artifact_binary_value_stream(table);
    write_tast_builtin_metadata(writer, value)?;
    let result = wire::new_artifact_binary_writer();
    let strings = wire::encode_artifact_binary_string_table(table);
    wire::artifact_binary_write_u32(result, strings.len().to_u32());
    wire::artifact_binary_write_raw_bytes(result, strings);
    wire::artifact_binary_write_raw_bytes(result, wire::artifact_binary_stream_finish(writer)?);
    Result::Ok(wire::artifact_binary_writer_finish(result))
}

pub fn decode(data: Slice[byte]) -> Result[tast::BuiltinMetadata, string] {
    let reader = wire::new_artifact_binary_slice_reader(data);
    let length = wire::artifact_binary_read_u32(reader)?.to_isize();
    if length > wire::artifact_binary_reader_remaining(reader) {
        return Result::Err("invalid builtin metadata string table length")
    }
    let table = wire::decode_artifact_binary_string_table_view(data.sub(4, 4 + length))?;
    read_tast_builtin_metadata(
        wire::decode_artifact_binary_value_view(table, data.sub(4 + length, data.len()))?,
    )
}
