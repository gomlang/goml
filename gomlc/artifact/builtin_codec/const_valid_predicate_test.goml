package builtin_codec;

use module::artifact::wire;
use module::tast;
use std::testing;

#[test]
fn builtin_function_schemes_preserve_symbolic_constant_validity() -> () {
    let length = tast::Type::App {
        ty: tast::Type::Con { name: "$const_op:-" },
        args: Vec::from_array([tast::Type::Param { name: "$const_param:N" }, tast::const_type(1)]),
    };
    let value = tast::FunctionScheme {
        def_id: None,
        name: "audit::construct",
        comptime: tast::ComptimeCapability::RuntimeOnly,
        generics: Vec::from_array(["$const_param:N"]),
        predicates: Vec::from_array(
            [
                tast::TypePredicate::ConstValid {
                    ty: length,
                    origins: Vec::from_array(["audit::construct", "audit::forward"]),
                },
            ],
        ),
        params: Vec::new(),
        ret_ty: tast::Type::Unit,
        callable: tast::Callable::Function("audit::construct"),
    };
    let writer = wire::new_artifact_value_writer();
    testing::expect_ok(write_tast_function_scheme(writer, value), "encode function");
    let encoded = testing::expect_ok(wire::artifact_value_finish(writer), "finish function");
    let decoded = testing::expect_ok(read_tast_function_scheme(encoded), "decode function");
    testing::assert_eq(decoded.generics.len(), 1);
    testing::assert_eq(decoded.generics[0], "$const_param:N");
    testing::assert_eq(decoded.predicates.len(), 1);
    match decoded.predicates[0] {
        ConstValid { ty: actual, origins } => {
            testing::assert_eq(origins.len(), 2);
            testing::assert_eq(origins[0], "audit::construct");
            testing::assert_eq(origins[1], "audit::forward");
            testing::assert(tast::types_equal(actual, length));
            let specialized = tast::substitute_params(
                actual,
                decoded.generics,
                Vec::from_array([tast::const_type(0)]),
            );
            testing::assert(tast::const_type_value(specialized) == Option::Some(-1));
        },
        _ => testing::fail("constant validity obligation was not retained"),
    }
}
