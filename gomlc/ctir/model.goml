package ctir;

use std::collections;

pub struct CtTarget {
    pub int_width: isize,
}

pub enum CtType {
    Unit,
    Never,
    Bool,
    Integer {
        signed: bool,
        width: isize,
    },
    String,
    Char,
    Tuple(Vec[CtType]),
    Array {
        len: isize,
        elem: CtType,
    },
    Struct {
        name: string,
        fields: Vec[CtType],
    },
    Enum {
        name: string,
        variants: Vec[Vec[CtType]],
    },
    Meta(string),
}

pub enum CtValue {
    Unit,
    Bool(bool),
    Integer {
        signed: bool,
        width: isize,
        bits: u64,
    },
    String(string),
    Char(char),
    Tuple(Vec[CtValue]),
    Array(Vec[CtValue]),
    Struct {
        name: string,
        fields: Vec[CtValue],
    },
    Enum {
        name: string,
        variant: isize,
        fields: Vec[CtValue],
    },
    Meta {
        kind: string,
        id: isize,
    },
}

pub struct CtOrigin {
    pub source_path: string,
    pub start: isize,
    pub end: isize,
}

pub enum CtUnaryOp {
    Neg,
    Not,
    BitNot,
}

pub enum CtBinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    And,
    Or,
    Less,
    Greater,
    LessEq,
    GreaterEq,
    Eq,
    NotEq,
}

pub enum CtCallTarget {
    Local(isize),
    External {
        package_name: string,
        entry_name: string,
    },
    Intrinsic(string),
}

pub enum CtPattern {
    Wild,
    Bind {
        slot: isize,
    },
    Value(CtValue),
    Constant {
        package_name: string,
        name: string,
    },
    Tuple(Vec[CtPattern]),
    Array {
        prefix: Vec[CtPattern],
        rest: Option[isize],
        suffix: Vec[CtPattern],
    },
    Struct {
        name: string,
        fields: Vec[(isize, CtPattern)],
    },
    Enum {
        name: string,
        variant: isize,
        fields: Vec[CtPattern],
    },
    Alias {
        slot: isize,
        pattern: CtPattern,
    },
    Or(Vec[CtPattern]),
    Range {
        start: CtValue,
        end: CtValue,
        inclusive: bool,
    },
}

pub struct CtExpr {
    pub kind: CtExprKind,
    pub ty: CtType,
    pub origin: isize,
}

pub struct CtArm {
    pub pattern: CtPattern,
    pub guard: Option[CtExpr],
    pub body: CtExpr,
    pub origin: isize,
}

pub enum CtExprKind {
    Value(CtValue),
    Local(isize),
    Constant {
        package_name: string,
        name: string,
    },
    Tuple(Vec[CtExpr]),
    Array(Vec[CtExpr]),
    Struct {
        name: string,
        fields: Vec[CtExpr],
    },
    Enum {
        name: string,
        variant: isize,
        fields: Vec[CtExpr],
    },
    Field {
        value: CtExpr,
        index: isize,
    },
    Index {
        value: CtExpr,
        index: CtExpr,
    },
    Block(CtBlock),
    If {
        condition: CtExpr,
        then_branch: CtExpr,
        else_branch: CtExpr,
    },
    Match {
        value: CtExpr,
        arms: Vec[CtArm],
    },
    While {
        target: isize,
        condition: CtExpr,
        body: CtExpr,
    },
    ForRange {
        target: isize,
        pattern: CtPattern,
        start: CtExpr,
        end: CtExpr,
        inclusive: bool,
        body: CtExpr,
    },
    ForArray {
        target: isize,
        pattern: CtPattern,
        value: CtExpr,
        body: CtExpr,
    },
    Loop {
        target: isize,
        body: CtExpr,
    },
    Break {
        target: isize,
        value: Option[CtExpr],
    },
    Continue {
        target: isize,
    },
    Return(Option[CtExpr]),
    Call {
        target: CtCallTarget,
        args: Vec[CtExpr],
    },
    Unary {
        op: CtUnaryOp,
        value: CtExpr,
    },
    Binary {
        op: CtBinaryOp,
        left: CtExpr,
        right: CtExpr,
    },
    Cast {
        value: CtExpr,
        target: CtType,
    },
    CompileError(CtExpr),
}

pub enum CtStmt {
    Let {
        pattern: CtPattern,
        value: CtExpr,
    },
    Assign {
        slot: isize,
        value: CtExpr,
    },
    Expr(CtExpr),
}

pub struct CtBlock {
    pub statements: Vec[CtStmt],
    pub tail: Option[CtExpr],
    pub origin: isize,
}

pub struct CtFunction {
    pub id: isize,
    pub name: string,
    pub parameter_slots: Vec[isize],
    pub parameter_types: Vec[CtType],
    pub local_count: isize,
    pub local_types: Vec[CtType],
    pub return_type: CtType,
    pub body: CtBlock,
    pub origin: isize,
}

pub struct CtEntry {
    pub name: string,
    pub function_id: isize,
    pub public: bool,
}

pub struct CtDeriveEntry {
    pub name: string,
    pub function_id: isize,
    pub public: bool,
    pub export_name: Option[string],
}

pub enum CtSiteKind {
    Expression,
    Constant { name: string },
}

pub struct CtSite {
    pub id: isize,
    pub kind: CtSiteKind,
    pub local_count: isize,
    pub local_types: Vec[CtType],
    pub expression: CtExpr,
    pub origin: isize,
}

pub struct CtConstant {
    pub name: string,
    pub value: CtValue,
}

pub struct CtModule {
    pub package_name: string,
    pub target: CtTarget,
    pub functions: Vec[CtFunction],
    pub entries: Vec[CtEntry],
    pub derive_entries: Vec[CtDeriveEntry],
    pub sites: Vec[CtSite],
    pub constants: Vec[CtConstant],
    pub origins: Vec[CtOrigin],
}

pub fn empty_module(package_name: string) -> CtModule {
    let origins: Vec[CtOrigin] = Vec::new();
    origins.push(CtOrigin { source_path: "<unknown>", start: 0, end: 0 });
    CtModule {
        package_name,
        target: CtTarget { int_width: 64 },
        functions: Vec::new(),
        entries: Vec::new(),
        derive_entries: Vec::new(),
        sites: Vec::new(),
        constants: Vec::new(),
        origins,
    }
}

struct CtReachability {
    function_ids: Vec[isize],
    functions: collections::HashSet[isize],
    constants: collections::HashSet[string],
}

fn new_ct_reachability() -> CtReachability {
    CtReachability {
        function_ids: Vec::new(),
        functions: collections::HashSet::new(),
        constants: collections::HashSet::new(),
    }
}

fn add_reachable_function(values: CtReachability, id: isize) -> () {
    if values.functions.insert(id) {
        values.function_ids.push(id)
    }
}

fn add_reachable_constant(values: CtReachability, name: string) -> () {
    let _ = values.constants.insert(name);
}

fn collect_reachable_expr(package_name: string, value: CtExpr, reachable: CtReachability) -> () {
    match value.kind {
        Value(_) | Local(_) | Continue { .. } => (),
        Constant { package_name: owner, name } => if owner == package_name {
            add_reachable_constant(reachable, name)
        },
        Tuple(values) | Array(values) | Struct { fields: values, .. } | Enum { fields: values, .. } => for value in values {
            collect_reachable_expr(package_name, value, reachable)
        },
        Field { value, index: _ } | Unary { op: _, value } | Cast { value, target: _ } | CompileError(value,) => collect_reachable_expr(
            package_name,
            value,
            reachable,
        ),
        Index { value, index } | Binary { op: _, left: value, right: index } => {
            collect_reachable_expr(package_name, value, reachable);
            collect_reachable_expr(package_name, index, reachable)
        },
        Block(value) => collect_reachable_block(package_name, value, reachable),
        If { condition, then_branch, else_branch } => {
            collect_reachable_expr(package_name, condition, reachable);
            collect_reachable_expr(package_name, then_branch, reachable);
            collect_reachable_expr(package_name, else_branch, reachable)
        },
        Match { value, arms } => {
            collect_reachable_expr(package_name, value, reachable);
            for arm in arms {
                if let Some(value) = arm.guard {
                    collect_reachable_expr(package_name, value, reachable)
                }
                collect_reachable_expr(package_name, arm.body, reachable)
            }
        },
        While { target: _, condition, body } => {
            collect_reachable_expr(package_name, condition, reachable);
            collect_reachable_expr(package_name, body, reachable)
        },
        ForRange { target: _, pattern: _, start, end, inclusive: _, body } => {
            collect_reachable_expr(package_name, start, reachable);
            collect_reachable_expr(package_name, end, reachable);
            collect_reachable_expr(package_name, body, reachable)
        },
        ForArray { target: _, pattern: _, value, body } => {
            collect_reachable_expr(package_name, value, reachable);
            collect_reachable_expr(package_name, body, reachable)
        },
        Loop { target: _, body } => collect_reachable_expr(package_name, body, reachable),
        Break { target: _, value } | Return(value) => if let Some(value) = value {
            collect_reachable_expr(package_name, value, reachable)
        },
        Call { target, args } => {
            match target {
                Local(id) => add_reachable_function(reachable, id),
                External { .. } | Intrinsic(_) => (),
            }
            for value in args {
                collect_reachable_expr(package_name, value, reachable)
            }
        },
    }
}

fn collect_reachable_block(package_name: string, value: CtBlock, reachable: CtReachability) -> () {
    for statement in value.statements {
        match statement {
            Let { pattern: _, value } | Assign { slot: _, value } | Expr(value) => {
                collect_reachable_expr(package_name, value, reachable)
            },
        }
    }
    if let Some(value) = value.tail {
        collect_reachable_expr(package_name, value, reachable)
    }
}

pub fn public_module(value: CtModule, public_entries: Vec[string], public_constants: Vec[string]) -> CtModule {
    let reachable = new_ct_reachability();
    for name in public_constants {
        add_reachable_constant(reachable, name)
    }
    let public_entry_names: collections::HashSet[string] = collections::HashSet::new();
    for name in public_entries {
        let _ = public_entry_names.insert(name);
    }
    let entries: Vec[CtEntry] = Vec::with_capacity(value.entries.len());
    for entry in value.entries {
        if public_entry_names.contains(entry.name) {
            entries.push(entry);
            add_reachable_function(reachable, entry.function_id)
        }
    }
    let derive_entries: Vec[CtDeriveEntry] = Vec::with_capacity(value.derive_entries.len());
    for entry in value.derive_entries {
        if entry.public {
            derive_entries.push(entry);
            add_reachable_function(reachable, entry.function_id)
        }
    }
    let functions_by_id: HashMap[isize, CtFunction] = HashMap::new();
    for function in value.functions {
        functions_by_id[function.id] = function;
    }
    let mut index = 0;
    while index < reachable.function_ids.len() {
        if let Some(function) = functions_by_id[reachable.function_ids[index]] {
            collect_reachable_block(value.package_name, function.body, reachable)
        }
        index += 1;
    }
    let functions: Vec[CtFunction] = Vec::with_capacity(reachable.function_ids.len());
    for function in value.functions {
        if reachable.functions.contains(function.id) {
            functions.push(function)
        }
    }
    CtModule {
        package_name: value.package_name,
        target: value.target,
        functions,
        entries,
        derive_entries,
        sites: Vec::new(),
        constants: {
            let result: Vec[CtConstant] = Vec::with_capacity(reachable.constants.len());
            for constant in value.constants {
                if reachable.constants.contains(constant.name) {
                    result.push(constant)
                }
            }
            result
        },
        origins: value.origins,
    }
}
