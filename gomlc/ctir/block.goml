package ctir;

impl CtBlock {
    pub fn result_type(self: Self) -> CtType {
        for statement in self.statements {
            let value = match statement {
                Let { value, .. } | Assign { value, .. } | Expr(value) => value,
            };
            if let Never = value.ty {
                return Never
            }
        }
        match self.tail {
            Some(value) => value.ty,
            None => Unit,
        }
    }
}
