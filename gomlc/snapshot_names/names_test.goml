package snapshot_names;

use std::testing;
use std::collections;

#[test]
fn shared_reserved_names_keep_local_counters_independent() -> () {
    let reserved: collections::HashSet[string] = collections::HashSet::new();
    let _ = reserved.insert("t0");
    let _ = reserved.insert("t2");
    let first = names_with_reserved(reserved);
    let second = names_with_reserved(reserved);
    testing::assert_eq(canonical(first, "t801"), "t1");
    testing::assert_eq(canonical(first, "t802"), "t3");
    testing::assert_eq(canonical(second, "t801"), "t1");
    testing::assert_eq(canonical(second, "t803"), "t3");
    testing::assert_eq(reserved.len(), 2);
}

#[test]
fn canonicalizes_ids_by_prefix() -> () {
    let values = names();
    testing::assert_eq(canonical(values, "self/401"), "self/0");
    testing::assert_eq(canonical(values, "self/812"), "self/1");
    testing::assert_eq(canonical(values, "mtmp802"), "mtmp0");
    testing::assert_eq(canonical(values, "_wild803"), "_wild0");
    testing::assert_eq(canonical(values, "mtmp802"), "mtmp0");
    testing::assert_eq(canonical(values, "stable"), "stable")
}

#[test]
fn skips_exact_reserved_names() -> () {
    let values = names();
    reserve(values, "t1");
    reserve(values, "t3");
    testing::assert_eq(canonical(values, "t801"), "t0");
    testing::assert_eq(canonical(values, "t802"), "t2");
    testing::assert_eq(canonical(values, "t803"), "t4")
}
