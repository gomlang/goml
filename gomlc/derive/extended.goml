package derive;

use module::ast;
use module::ctir;

fn extended_intrinsic_specs() -> Vec[DeriveIntrinsicSpec] {
    Vec::from_array(
        [
            spec("derive_span", one_type(DERIVE_INPUT_NAME), META_SPAN_NAME),
            spec("derive_field_span", two_types(DERIVE_INPUT_NAME, INT_TYPE_NAME), META_SPAN_NAME),
            spec(
                "derive_variant_field_span",
                three_types(DERIVE_INPUT_NAME, INT_TYPE_NAME, INT_TYPE_NAME),
                META_SPAN_NAME,
            ),
            spec("meta_attribute_span", one_type(META_ATTRIBUTE_NAME), META_SPAN_NAME),
            spec(
                "meta_attribute_argument_span",
                two_types(META_ATTRIBUTE_NAME, INT_TYPE_NAME),
                META_SPAN_NAME,
            ),
            spec("derive_set_span", one_type(META_SPAN_NAME), UNIT_TYPE_NAME),
            spec(
                "derive_error_span",
                two_types(META_SPAN_NAME, STRING_TYPE_NAME),
                DERIVE_OUTPUT_NAME,
            ),
            spec(
                "meta_type_function",
                two_types(META_TYPE_LIST_NAME, META_TYPE_NAME),
                META_TYPE_NAME,
            ),
            spec(
                "meta_expr_closure",
                two_types(META_PARAM_LIST_NAME, META_EXPR_NAME),
                META_EXPR_NAME,
            ),
            spec("meta_expr_invoke", two_types(META_EXPR_NAME, META_EXPR_LIST_NAME), META_EXPR_NAME),
            spec(
                "meta_expr_type_member",
                four_types(
                    META_TYPE_NAME,
                    STRING_TYPE_NAME,
                    META_TYPE_LIST_NAME,
                    META_EXPR_LIST_NAME,
                ),
                META_EXPR_NAME,
            ),
            spec(
                "derive_output_merge",
                two_types(DERIVE_OUTPUT_NAME, DERIVE_OUTPUT_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_associated_type",
                three_types(DERIVE_OUTPUT_NAME, STRING_TYPE_NAME, META_TYPE_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_constant",
                four_types(DERIVE_OUTPUT_NAME, STRING_TYPE_NAME, META_TYPE_NAME, META_EXPR_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_function",
                two_types(DERIVE_OUTPUT_NAME, META_METHOD_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_type_alias",
                three_types(DERIVE_OUTPUT_NAME, STRING_TYPE_NAME, META_TYPE_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_struct",
                three_types(DERIVE_OUTPUT_NAME, STRING_TYPE_NAME, META_PARAM_LIST_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_set_trait_arguments",
                two_types(DERIVE_OUTPUT_NAME, META_TYPE_LIST_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_output_add_equality",
                three_types(DERIVE_OUTPUT_NAME, META_TYPE_NAME, META_TYPE_NAME),
                UNIT_TYPE_NAME,
            ),
            spec(
                "derive_error_at",
                two_types(META_ATTRIBUTE_NAME, STRING_TYPE_NAME),
                DERIVE_OUTPUT_NAME,
            ),
            spec(
                "derive_error_at_argument",
                three_types(META_ATTRIBUTE_NAME, INT_TYPE_NAME, STRING_TYPE_NAME),
                DERIVE_OUTPUT_NAME,
            ),
            spec(
                "meta_attribute_argument_type",
                two_types(META_ATTRIBUTE_NAME, INT_TYPE_NAME),
                META_TYPE_NAME,
            ),
            spec(
                "meta_attribute_argument_expr",
                two_types(META_ATTRIBUTE_NAME, INT_TYPE_NAME),
                META_EXPR_NAME,
            ),
        ],
    )
}

fn is_extended_intrinsic(name: string) -> bool {
    for value in extended_intrinsic_specs() {
        if value.name == name {
            return true
        }
    }
    false
}

fn output_index(state: DeriveState, args: Vec[ctir::CtValue], index: isize) -> Result[isize, string] {
    checked_index(
        handle_argument(args, index, DERIVE_OUTPUT_NAME)?,
        state.outputs.len(),
        "derive output",
    )
}

fn type_list_value(state: DeriveState, args: Vec[ctir::CtValue], index: isize) -> Result[
    Vec[ast::TypeExpr],
    string,
] {
    let id = checked_index(
        handle_argument(args, index, META_TYPE_LIST_NAME)?,
        state.type_lists.len(),
        "meta type list",
    )?;
    Result::Ok(state.type_lists[id])
}

fn expr_list_value(state: DeriveState, args: Vec[ctir::CtValue], index: isize) -> Result[
    Vec[ast::Expr],
    string,
] {
    let id = checked_index(
        handle_argument(args, index, META_EXPR_LIST_NAME)?,
        state.expr_lists.len(),
        "meta expression list",
    )?;
    Result::Ok(state.expr_lists[id])
}

fn extended_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let value_span = span(state);
    if name == "derive_span" || name == "derive_field_span" || name == "derive_variant_field_span"
        || name == "meta_attribute_span"
        || name == "meta_attribute_argument_span"
        || name == "derive_set_span"
        || name == "derive_error_span" {
        return span_intrinsic(state, name, args)
    }
    if name == "meta_type_function" {
        return Result::Ok(
            push_type(
                state,
                ast::TypeExpr::Func {
                    params: type_list_value(state, args, 0)?,
                    ret_ty: type_value(state, args, 1)?,
                },
            ),
        )
    }
    if name == "meta_expr_closure" {
        let id = checked_index(
            handle_argument(args, 0, META_PARAM_LIST_NAME)?,
            state.param_lists.len(),
            "meta parameter list",
        )?;
        let params: Vec[ast::ClosureParam] = Vec::new();
        for param in state.param_lists[id] {
            params.push(
                ast::ClosureParam { name: param.0, ty: Option::Some(param.1), span: value_span },
            )
        }
        return Result::Ok(
            push_expr(
                state,
                ast::Expr::Closure { params, body: expr_value(state, args, 1)?, span: value_span },
            ),
        )
    }
    if name == "meta_expr_invoke" {
        return Result::Ok(
            push_expr(
                state,
                ast::Expr::Call {
                    func: expr_value(state, args, 0)?,
                    args: expr_list_value(state, args, 1)?,
                    span: value_span,
                },
            ),
        )
    }
    if name == "meta_expr_type_member" {
        let owner = type_value(state, args, 0)?;
        let (owner, owner_type_args) = match owner {
            ast::TypeExpr::App { ty, args } => (ty, args),
            _ => (owner, Vec::new()),
        };
        let ast::TypeExpr::Con { path: owner_path } = owner else {
            return Result::Err("meta_expr_type_member requires a named owner type")
        };
        let func = ast::Expr::Path {
            path: path(path_text(owner_path) + "::" + string_argument(args, 1)?, value_span),
            owner_type_args,
            member_type_args: type_list_value(state, args, 2)?,
            span: value_span,
        };
        return Result::Ok(
            push_expr(
                state,
                ast::Expr::Call { func, args: expr_list_value(state, args, 3)?, span: value_span },
            ),
        )
    }
    if name == "derive_error_at" || name == "derive_error_at_argument" {
        let attribute = attribute_handle(state, args, 0)?;
        if name == "derive_error_at_argument" {
            let argument = structured_argument(attribute, int_argument(args, 1)?)?;
            state.error_span.set(Option::Some(argument.span));
            return Result::Err(string_argument(args, 2)?)
        }
        state.error_span.set(Option::Some(attribute.span));
        return Result::Err(string_argument(args, 1)?)
    }
    if name == "meta_attribute_argument_type" || name == "meta_attribute_argument_expr" {
        return attribute_syntax_intrinsic(state, name, args)
    }
    let id = output_index(state, args, 0)?;
    if name == "derive_output_merge" {
        let source = output_index(state, args, 1)?;
        if source == id {
            return Result::Err("cannot merge a derive output into itself")
        }
        let count = state.output_items[source].len() + 1;
        if count > 100000 - state.operations.get() {
            return Result::Err("derive generated syntax limit exceeded")
        }
        state.operations.set(state.operations.get() + count);
        let snapshot = output(state, meta(DERIVE_OUTPUT_NAME, source))?;
        for item in snapshot {
            state.output_items[id].push(item)
        }
    } else if name == "derive_output_add_associated_type" {
        if state.outputs[id].trait_ref.is_none() {
            return Result::Err("associated types require a trait implementation")
        }
        state.outputs[id].associated_types.push(
            (string_argument(args, 1)?, type_value(state, args, 2)?),
        );
    } else if name == "derive_output_add_equality" {
        state.outputs[id].predicates.push(
            ast::Predicate::Equality {
                lhs: type_value(state, args, 1)?,
                rhs: type_value(state, args, 2)?,
            },
        );
    } else if name == "derive_output_set_trait_arguments" {
        let Some(mut trait_ref) = state.outputs[id].trait_ref else {
            return Result::Err("trait arguments require a trait implementation")
        };
        trait_ref.args = type_list_value(state, args, 1)?;
        let mut block = state.outputs[id];
        block.trait_ref = Option::Some(trait_ref);
        state.outputs[id] = block;
    } else if name == "derive_output_add_constant" {
        let ty = type_value(state, args, 2)?;
        let value = expr_value(state, args, 3)?;
        if !ast::associated_constant_expression(value) {
            return Result::Err("invalid generated associated constant expression")
        }
        state.outputs[id].methods.push(
            ast::Function {
                attrs: Vec::new(),
                visibility: ast::Visibility::Private,
                name: "$associated_const:" + string_argument(args, 1)?,
                name_span: value_span,
                generics: Vec::new(),
                generic_bounds: Vec::new(),
                predicates: Vec::new(),
                params: Vec::new(),
                param_type_spans: Vec::new(),
                ret_ty: Option::Some(ty),
                ret_ty_span: Option::Some(value_span),
                body: ast::Block { stmts: Vec::new(), tail: Option::Some(value), span: value_span },
            },
        );
    } else if name == "derive_output_add_function" {
        let method = checked_index(
            handle_argument(args, 1, META_METHOD_NAME)?,
            state.methods.len(),
            "meta method",
        )?;
        state.output_items[id].push(ast::Item::Function(state.methods[method]));
    } else if name == "derive_output_add_type_alias" {
        state.output_items[id].push(
            ast::Item::TypeAlias(
                ast::TypeAlias {
                    attrs: Vec::new(),
                    visibility: ast::Visibility::Private,
                    name: string_argument(args, 1)?,
                    generics: Vec::new(),
                    ty: type_value(state, args, 2)?,
                    ty_span: value_span,
                },
            ),
        );
    } else if name == "derive_output_add_struct" {
        let fields = checked_index(
            handle_argument(args, 2, META_PARAM_LIST_NAME)?,
            state.param_lists.len(),
            "meta parameter list",
        )?;
        let field_type_spans: Vec[ast::Span] = Vec::new();
        let field_attrs: Vec[Vec[ast::Attribute]] = Vec::new();
        for _ in state.param_lists[fields] {
            field_type_spans.push(value_span);
            field_attrs.push(Vec::new());
        }
        state.output_items[id].push(
            ast::Item::StructDef(
                ast::StructDef {
                    attrs: Vec::new(),
                    visibility: ast::Visibility::Private,
                    name: string_argument(args, 1)?,
                    generics: Vec::new(),
                    newtype: false,
                    fields: state.param_lists[fields],
                    field_type_spans,
                    field_attrs,
                    public_fields: Vec::new(),
                },
            ),
        );
    } else {
        return Result::Err("unknown extended derive intrinsic `" + name + "`")
    }
    Result::Ok(unit_value())
}
