package derive;

use module::ast;
use module::ctir;
use module::parser;
use std::testing;
use std::panic;

fn must[T](value: Result[T, string]) -> T {
    match value {
        Ok(value) => value,
        Err(message) => panic::raise(message),
    }
}

fn test_state() -> DeriveState {
    let parsed = ast::lower(
        parser::parse(
            "#[derive(Example)] #[option(priority = 10, extras = Option[string], callback = parse(1, 2), raw = r\"\\w+\", enabled = true)] struct Item {}",
        ),
    );
    testing::assert_eq(parsed.diagnostics.len(), 0);
    let Some(file) = parsed.ast else {
        panic::raise("missing AST")
    };
    let ast::Item::StructDef(item) = file.items[0] else {
        panic::raise("missing struct")
    };
    new_state(
        DeriveRequest {
            item: DeriveItem::Struct(item),
            attribute: item.attrs[0],
            handler_package: "example::derive",
        },
        64,
    )
}

#[test]
fn structured_attributes_preserve_nested_syntax_and_literals() -> () {
    let state = test_state();
    let DeriveItem::Struct(item) = state.request.item else {
        panic::raise("missing struct")
    };
    let args = must(structured_arguments(item.attrs[1]));
    testing::assert_eq(args.len(), 5);
    testing::assert_eq(args[0].kind, "integer");
    testing::assert_eq(args[0].text, "10");
    testing::assert_eq(args[1].source, "Option[string]");
    testing::assert_eq(args[2].source, "parse(1, 2)");
    testing::assert_eq(args[3].text, "\\w+");
    testing::assert_eq(args[4].kind, "bool");
    testing::assert(args[0].span.start > item.attrs[1].span.start);
    testing::assert(args[0].span.end < args[1].span.start)
}

#[test]
fn derive_outputs_combine_impls_and_helpers() -> () {
    let state = test_state();
    let input = meta(DERIVE_INPUT_NAME, 0);
    let first = must(
        call_intrinsic(state, "example", "derive_output_inherent", Vec::from_array([input])),
    );
    let second = must(
        call_intrinsic(
            state,
            "example",
            "derive_output_new",
            Vec::from_array([input, ctir::CtValue::String("Trait")]),
        ),
    );
    let ty = push_type(state, ast::TypeExpr::Int);
    let _ = must(
        call_intrinsic(
            state,
            "example",
            "derive_output_add_associated_type",
            Vec::from_array([second, ctir::CtValue::String("Output"), ty]),
        ),
    );
    let _ = must(
        call_intrinsic(
            state,
            "example",
            "derive_output_add_type_alias",
            Vec::from_array([second, ctir::CtValue::String("Helper"), ty]),
        ),
    );
    let _ = must(
        call_intrinsic(state, "example", "derive_output_merge", Vec::from_array([first, second])),
    );
    let items = must(output(state, first));
    testing::assert_eq(items.len(), 3);
    let ast::Item::ImplBlock(value) = items[1] else {
        panic::raise("missing impl")
    };
    testing::assert_eq(value.associated_types.len(), 1);
    testing::assert(
        call_intrinsic(state, "example", "derive_output_merge", Vec::from_array([first, first])).is_err(),
    )
}

#[test]
fn derive_error_selects_the_attribute_argument_span() -> () {
    let state = test_state();
    let DeriveItem::Struct(item) = state.request.item else {
        panic::raise("missing struct")
    };
    state.attributes.push(item.attrs[1]);
    let result = call_intrinsic(
        state,
        "example",
        "derive_error_at_argument",
        Vec::from_array(
            [
                meta(META_ATTRIBUTE_NAME, 0),
                int_value(state, 0),
                ctir::CtValue::String("bad priority"),
            ],
        ),
    );
    testing::assert(result.is_err());
    let Some(selected) = state.error_span.get() else {
        panic::raise("missing diagnostic span")
    };
    let expected = must(structured_argument(item.attrs[1], 0)).span;
    testing::assert_eq(selected.start, expected.start);
    testing::assert_eq(selected.end, expected.end)
}
