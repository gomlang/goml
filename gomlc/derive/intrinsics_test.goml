package derive;

use std::collections;
use std::testing;

#[test]
fn intrinsic_specs_preserve_signatures_and_isolate_mutable_copies() -> () {
    let original = intrinsic_specs();
    let names = collections::IndexSet::new();
    for index in 0..original.len() {
        let value = original.get(index);
        testing::assert(names.insert(value.name));
        testing::assert(is_intrinsic(value.name));
        let params = value.params.to_vec();
        params.clear();
    }
    let copied = original.to_vec();
    copied.clear();
    testing::assert_eq(intrinsic_specs().len(), original.len());
    let current = intrinsic_specs();
    for index in 0..current.len() {
        let value = current.get(index);
        if value.name == "derive_item_name" {
            testing::assert_eq(value.params.len(), 1);
            testing::assert_eq(value.params.get(0), "DeriveInput");
            testing::assert_eq(value.ret, "string");
        }
        if value.name == "derive_span" {
            testing::assert_eq(value.params.get(0), "DeriveInput");
            testing::assert_eq(value.ret, "MetaSpan");
            testing::assert(is_extended_intrinsic(value.name));
        }
    }
    testing::assert(names.contains("derive_item_name"));
    testing::assert(names.contains("derive_span"));
    testing::assert(!is_intrinsic("unknown_intrinsic"));
    testing::assert(!is_extended_intrinsic("derive_item_name"));
}
