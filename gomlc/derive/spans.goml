package derive;

use module::ctir;

fn span_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    if name == "derive_set_span" || name == "derive_error_span" {
        let id = checked_index(
            handle_argument(args, 0, META_SPAN_NAME)?,
            state.spans.len(),
            "meta span",
        )?;
        if name == "derive_error_span" {
            state.error_span.set(Option::Some(state.spans[id]));
            return Result::Err(string_argument(args, 1)?)
        }
        state.current_span.set(state.spans[id]);
        return Result::Ok(unit_value())
    }
    let selected = if name == "meta_attribute_span" {
        attribute_handle(state, args, 0)?.span
    } else if name == "meta_attribute_argument_span" {
        structured_argument(attribute_handle(state, args, 0)?, int_argument(args, 1)?)?.span
    } else if name == "derive_field_span" {
        let DeriveItem::Struct(value) = state.request.item else {
            return Result::Err("field spans require a struct")
        };
        value.field_type_spans[checked_index(
            int_argument(args, 1)?,
            value.field_type_spans.len(),
            "field",
        )?]
    } else if name == "derive_variant_field_span" {
        let DeriveItem::Enum(value) = state.request.item else {
            return Result::Err("variant field spans require an enum")
        };
        let variant = value.variants[checked_index(
            int_argument(args, 1)?,
            value.variants.len(),
            "variant",
        )?];
        variant.field_type_spans[checked_index(
            int_argument(args, 2)?,
            variant.field_type_spans.len(),
            "variant field",
        )?]
    } else {
        state.request.attribute.span
    };
    let id = state.spans.len();
    state.spans.push(selected);
    Result::Ok(meta(META_SPAN_NAME, id))
}
