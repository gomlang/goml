    let extended = extended_intrinsic_specs();
    for index in 0..extended.len() {
        result.push(extended.get(index))
    }
    result.freeze()
}

pub fn is_intrinsic(name: string) -> bool {
    let specs = intrinsic_specs();
    for index in 0..specs.len() {
        let value = specs.get(index);
        if value.name == name {
            return true
        }
    }
    false
}

pub fn is_meta_type(name: string) -> bool {
    name == DERIVE_INPUT_NAME || name == DERIVE_OUTPUT_NAME || name == META_TYPE_NAME
        || name == META_SPAN_NAME
        || name == META_TYPE_LIST_NAME
        || name == META_ATTRIBUTE_NAME
        || name == META_EXPR_NAME
        || name == META_EXPR_LIST_NAME
        || name == META_EXPR_FIELD_LIST_NAME
        || name == META_PATTERN_NAME
        || name == META_PATTERN_LIST_NAME
        || name == META_PATTERN_FIELD_LIST_NAME
        || name == META_ARM_NAME
        || name == META_ARM_LIST_NAME
        || name == META_BLOCK_NAME
        || name == META_PARAM_LIST_NAME
        || name == META_GENERIC_LIST_NAME
        || name == META_METHOD_NAME
}

pub enum DeriveItem {
    Struct(ast::StructDef),
    Enum(ast::EnumDef),
}

pub struct DeriveRequest {
    pub item: DeriveItem,
    pub attribute: ast::Attribute,
    pub handler_package: string,
}

pub struct DeriveState {
    pub request: DeriveRequest,
    int_width: isize,
    definition_package: Ref[string],
    pub types: Vec[ast::TypeExpr],
    pub type_lists: Vec[Vec[ast::TypeExpr]],
    pub attributes: Vec[ast::Attribute],
    pub exprs: Vec[ast::Expr],
    pub expr_lists: Vec[Vec[ast::Expr]],
    pub expr_fields: Vec[Vec[(string, ast::Expr)]],
    pub patterns: Vec[ast::Pat],
    pub pattern_lists: Vec[Vec[ast::Pat]],
    pub pattern_fields: Vec[Vec[(string, ast::Pat)]],
    pub arms: Vec[ast::Arm],
    pub arm_lists: Vec[Vec[ast::Arm]],
    pub blocks: Vec[ast::Block],
    pub param_lists: Vec[Vec[(string, ast::TypeExpr)]],
    pub generic_lists: Vec[Vec[(string, Vec[ast::TraitRef])]],
    pub methods: Vec[ast::Function],
    pub outputs: Vec[ast::ImplBlock],
    pub output_items: Vec[Vec[ast::Item]],
    pub error_span: Ref[Option[ast::Span]],
    pub spans: Vec[ast::Span],
    pub current_span: Ref[ast::Span],
    pub fresh: Ref[isize],
    pub operations: Ref[isize],
}

pub fn new_state(request: DeriveRequest, int_width: isize) -> DeriveState {
    DeriveState {
        request,
        int_width,
        definition_package: Ref::new(request.handler_package),
        types: Vec::new(),
        type_lists: Vec::new(),
        attributes: Vec::new(),
        exprs: Vec::new(),
        expr_lists: Vec::new(),
        expr_fields: Vec::new(),
        patterns: Vec::new(),
        pattern_lists: Vec::new(),
        pattern_fields: Vec::new(),
        arms: Vec::new(),
        arm_lists: Vec::new(),
        blocks: Vec::new(),
        param_lists: Vec::new(),
        generic_lists: Vec::new(),
        methods: Vec::new(),
        outputs: Vec::new(),
        output_items: Vec::new(),
        error_span: Ref::new(Option::None),
        spans: Vec::new(),
        current_span: Ref::new(request.attribute.span),
        fresh: Ref::new(0),
        operations: Ref::new(0),
    }
}

fn span(state: DeriveState) -> ast::Span {
    state.current_span.get()
}

fn path(value: string, value_span: ast::Span) -> ast::Path {
    let segments: Vec[ast::PathSegment] = Vec::new();
    for value in text::split(value, "::") {
        if value == "" {} else {
            segments.push(ast::PathSegment { ident: value, span: value_span })
        }
    }
    ast::Path { segments }
}

fn definition_name(state: DeriveState, value: string) -> string {
    let package_name = state.definition_package.get();
    let qualified = text::find(value, "::").is_some();
    let relative_owner = value.byte_len() > 0 && value.byte_get(0) >= b'A'
        && value.byte_get(0) <= b'Z';
    if (qualified && !relative_owner) || package_name == "" || package_name == "builtin"
        || package_name == "main" {
        value
    } else {
        package_name + "::" + value
    }
}

fn primitive_type(value: string) -> Option[ast::TypeExpr] {
    if value == UNIT_TYPE_NAME {
        Some(ast::TypeExpr::Unit)
    } else if value == BOOL_TYPE_NAME {
        Some(ast::TypeExpr::Bool)
    } else if value == INT_TYPE_NAME {
        Some(ast::TypeExpr::Int)
    } else if value == "i8" {
        Some(ast::TypeExpr::Int8)
    } else if value == "i16" {
        Some(ast::TypeExpr::Int16)
    } else if value == "i32" {
        Some(ast::TypeExpr::Int32)
    } else if value == "i64" {
        Some(ast::TypeExpr::Int64)
    } else if value == "usize" {
        Some(ast::TypeExpr::Uint)
    } else if value == "u8" || value == "byte" {
        Some(ast::TypeExpr::Uint8)
    } else if value == "u16" {
        Some(ast::TypeExpr::Uint16)
    } else if value == "u32" {
        Some(ast::TypeExpr::Uint32)
    } else if value == "u64" {
        Some(ast::TypeExpr::Uint64)
    } else if value == "f32" {
        Some(ast::TypeExpr::Float32)
    } else if value == "f64" {
        Some(ast::TypeExpr::Float64)
    } else if value == STRING_TYPE_NAME {
        Some(ast::TypeExpr::String)
    } else if value == "char" {
        Some(ast::TypeExpr::Char)
    } else {
        None
    }
}

fn named_type(value: string, value_span: ast::Span) -> ast::TypeExpr {
    match primitive_type(value) {
        Some(ty) => ty,
        None => Con { path: path(value, value_span) },
    }
}

fn item_name(value: DeriveItem) -> string {
    match value {
        Struct(value) => value.name,
        Enum(value) => value.name,
    }
}

fn item_generics(value: DeriveItem) -> Vec[string] {
    match value {
        Struct(value) => value.generics,
        Enum(value) => value.generics,
    }
}

fn item_attributes(value: DeriveItem) -> Vec[ast::Attribute] {
    match value {
        Struct(value) => value.attrs,
        Enum(value) => value.attrs,
    }
}

fn target_type(value: DeriveItem, value_span: ast::Span) -> ast::TypeExpr {
    let base = ast::TypeExpr::Con { path: path(item_name(value), value_span) };
    let args: Vec[ast::TypeExpr] = Vec::new();
    for generic in item_generics(value) {
        args.push(
            Con { path: path(consts::parameter_name(generic).unwrap_or(generic), value_span) },
        )
    }
    if args.is_empty() {
        base
    } else {
        App { ty: base, args }
    }
}

fn meta(kind: string, id: isize) -> ctir::CtValue {
    Meta { kind, id }
}

fn unit_value() -> ctir::CtValue {
    Unit
}

fn int_value(state: DeriveState, value: isize) -> ctir::CtValue {
    Integer { signed: true, width: state.int_width, bits: value.to_u64() }
}

fn argument(values: Vec[ctir::CtValue], index: isize) -> Result[ctir::CtValue, string] {
    if index < 0 || index >= values.len() {
        Err("derive intrinsic argument is missing")
    } else {
        Ok(values[index])
    }
}

fn int_argument(values: Vec[ctir::CtValue], index: isize) -> Result[isize, string] {
    match argument(values, index)? {
        Integer { bits, .. } => Ok(bits.to_isize()),
        _ => Err("derive intrinsic expects an integer argument"),
    }
}

fn bool_argument(values: Vec[ctir::CtValue], index: isize) -> Result[bool, string] {
    match argument(values, index)? {
        Bool(value) => Ok(value),
        _ => Err("derive intrinsic expects a boolean argument"),
    }
}

fn string_argument(values: Vec[ctir::CtValue], index: isize) -> Result[string, string] {
    match argument(values, index)? {
        String(value) => Ok(value),
        _ => Err("derive intrinsic expects a string argument"),
    }
}

fn handle_argument(values: Vec[ctir::CtValue], index: isize, kind: string) -> Result[isize, string] {
    match argument(values, index)? {
        Meta { kind: actual, id } => if actual == kind {
            Ok(id)
        } else {
            Err("derive intrinsic expected " + kind + ", got " + actual)
        },
        _ => Err("derive intrinsic expects " + kind),
    }
}

fn checked_index(index: isize, len: isize, description: string) -> Result[isize, string] {
    if index < 0 || index >= len {
        Err(f"{description} index {index} is out of bounds")
    } else {
        Ok(index)
    }
}

fn push_type(state: DeriveState, value: ast::TypeExpr) -> ctir::CtValue {
    let id = state.types.len();
    state.types.push(value);
    meta(META_TYPE_NAME, id)
}

fn push_attribute(state: DeriveState, value: ast::Attribute) -> ctir::CtValue {
    let id = state.attributes.len();
    state.attributes.push(value);
    meta(META_ATTRIBUTE_NAME, id)
}

fn push_expr(state: DeriveState, value: ast::Expr) -> ctir::CtValue {
    let id = state.exprs.len();
    state.exprs.push(value);
    meta(META_EXPR_NAME, id)
}

fn push_pattern(state: DeriveState, value: ast::Pat) -> ctir::CtValue {
    let id = state.patterns.len();
    state.patterns.push(value);
    meta(META_PATTERN_NAME, id)
}

fn type_value(state: DeriveState, values: Vec[ctir::CtValue], index: isize) -> Result[
    ast::TypeExpr,
    string,
] {
    let id = handle_argument(values, index, META_TYPE_NAME)?;
    let id = checked_index(id, state.types.len(), "meta type")?;
    Ok(state.types[id])
}

fn expr_value(state: DeriveState, values: Vec[ctir::CtValue], index: isize) -> Result[
    ast::Expr,
    string,
] {
    let id = handle_argument(values, index, META_EXPR_NAME)?;
    let id = checked_index(id, state.exprs.len(), "meta expression")?;
    Ok(state.exprs[id])
}

fn pattern_value(state: DeriveState, values: Vec[ctir::CtValue], index: isize) -> Result[
    ast::Pat,
    string,
] {
    let id = handle_argument(values, index, META_PATTERN_NAME)?;
    let id = checked_index(id, state.patterns.len(), "meta pattern")?;
    Ok(state.patterns[id])
}

fn attribute_handle(state: DeriveState, values: Vec[ctir::CtValue], index: isize) -> Result[
    ast::Attribute,
    string,
] {
    let id = handle_argument(values, index, META_ATTRIBUTE_NAME)?;
    let id = checked_index(id, state.attributes.len(), "meta attribute")?;
    Ok(state.attributes[id])
}

fn struct_field(value: ast::StructDef, index: isize) -> Result[(string, ast::TypeExpr), string] {
    let index = checked_index(index, value.fields.len(), "derive field")?;
    Ok(value.fields[index])
}

fn enum_variant(value: ast::EnumDef, index: isize) -> Result[ast::EnumVariant, string] {
    let index = checked_index(index, value.variants.len(), "derive variant")?;
    Ok(value.variants[index])
}

fn variant_field_count(value: ast::EnumVariant) -> isize {
    match value.fields {
        Unit => 0,
        Tuple(values) => values.len(),
        ast::EnumVariantFields::Struct(values) => values.len(),
    }
}

fn variant_field(value: ast::EnumVariant, index: isize) -> Result[(string, ast::TypeExpr), string] {
    match value.fields {
        Unit => Err("unit variant has no fields"),
        Tuple(values) => {
            let index = checked_index(index, values.len(), "derive variant field")?;
            Ok((index.to_string(), values[index]))
        },
        ast::EnumVariantFields::Struct(values) => {
            let index = checked_index(index, values.len(), "derive variant field")?;
            Ok(values[index])
        },
    }
}

fn attribute_value(values: Vec[ast::Attribute], index: isize, description: string, text_value: bool) -> Result[
    ctir::CtValue,
    string,
] {
    let index = checked_index(index, values.len(), description)?;
    if text_value {
        Ok(ctir::CtValue::String(values[index].text))
    } else {
        Ok(ctir::CtValue::String(values[index].name))
    }
}

fn selected_attribute(values: Vec[ast::Attribute], index: isize, description: string) -> Result[
    ast::Attribute,
    string,
] {
    let index = checked_index(index, values.len(), description)?;
    Ok(values[index])
}

fn write_path_text(builder: text::StringBuilder, value: ast::Path) -> () {
    let mut first = true;
    for segment in value.segments {
        if first {} else {
            builder.write_string("::")
        }
        builder.write_string(segment.ident);
        first = false;
    }
}

fn path_text(value: ast::Path) -> string {
    let builder = text::StringBuilder::new();
    write_path_text(builder, value);
    builder.finish()
}

fn primitive_type_name(value: ast::TypeExpr) -> Option[string] {
    match value {
        Unit => Some(UNIT_TYPE_NAME),
        Bool => Some(BOOL_TYPE_NAME),
        Int => Some(INT_TYPE_NAME),
        Int8 => Some("i8"),
        Int16 => Some("i16"),
        Int32 => Some("i32"),
        Int64 => Some("i64"),
        Uint => Some("usize"),
        Uint8 => Some("u8"),
        Uint16 => Some("u16"),
        Uint32 => Some("u32"),
        Uint64 => Some("u64"),
        Float32 => Some("f32"),
        Float64 => Some("f64"),
        String => Some(STRING_TYPE_NAME),
        Char => Some("char"),
        _ => None,
    }
}

fn meta_type_kind(value: ast::TypeExpr) -> string {
    match value {
        Tuple { .. } => "tuple",
        Con { .. } => "named",
        Dyn { .. } => "dyn",
        App { .. } => "application",
        Array { .. } => "array",
        Func { .. } => "function",
        _ => "primitive",
    }
}

fn write_meta_type_key(builder: text::StringBuilder, value: ast::TypeExpr) -> () {
    match value {
        Unit => builder.write_string(UNIT_TYPE_NAME),
        Bool => builder.write_string(BOOL_TYPE_NAME),
        Int => builder.write_string(INT_TYPE_NAME),
        Int8 => builder.write_string("i8"),
        Int16 => builder.write_string("i16"),
        Int32 => builder.write_string("i32"),
        Int64 => builder.write_string("i64"),
        Uint => builder.write_string("usize"),
        Uint8 => builder.write_string("u8"),
        Uint16 => builder.write_string("u16"),
        Uint32 => builder.write_string("u32"),
        Uint64 => builder.write_string("u64"),
        Float32 => builder.write_string("f32"),
        Float64 => builder.write_string("f64"),
        String => builder.write_string(STRING_TYPE_NAME),
        Char => builder.write_string("char"),
        Tuple { items } => {
            builder.write_char('(');
            for item in items {
                write_meta_type_key(builder, item);
                builder.write_char(',')
            }
            builder.write_char(')')
        },
        Con { path } => write_path_text(builder, path),
        Dyn { bounds } => {
            builder.write_string("dyn ");
            for bound in bounds {
                write_path_text(builder, bound.trait_path);
                builder.write_char('[');
                for arg in bound.args {
                    write_meta_type_key(builder, arg);
                    builder.write_char(',')
                }
                for binding in bound.associated_types {
                    builder.write_string(binding.0);
                    builder.write_char('=');
                    write_meta_type_key(builder, binding.1);
                    builder.write_char(',')
                }
                builder.write_string("]+")
            }
        },
        App { ty, args } => {
            write_meta_type_key(builder, ty);
            builder.write_char('[');
            for arg in args {
                write_meta_type_key(builder, arg);
                builder.write_char(',')
            }
            builder.write_char(']')
        },
        Array { len, elem } => {
            builder.write_char('[');
            write_meta_type_key(builder, elem);
            builder.write_char(';');
            builder.write_string(len);
            builder.write_char(']')
        },
        Func { params, ret_ty } => {
            builder.write_string("fn(");
            for param in params {
                write_meta_type_key(builder, param);
                builder.write_char(',')
            }
            builder.write_string(")->");
            write_meta_type_key(builder, ret_ty)
        },
    }
}

fn meta_type_key(value: ast::TypeExpr) -> string {
    let builder = text::StringBuilder::new();
    write_meta_type_key(builder, value);
    builder.finish()
}

fn type_mentions_generics(value: ast::TypeExpr, generics: Vec[string]) -> bool {
    match value {
        Con { path } => if path.segments.len() == 1 {
            for generic in generics {
                if generic == path.segments[0].ident {
                    return true
                }
            }
            false
        } else {
            false
        },
        Tuple { items } => {
            for item in items {
                if type_mentions_generics(item, generics) {
                    return true
                }
            }
            false
        },
        Dyn { bounds } => {
            for bound in bounds {
                for argument in bound.args {
                    if type_mentions_generics(argument, generics) {
                        return true
                    }
                }
                for associated in bound.associated_types {
                    if type_mentions_generics(associated.1, generics) {
                        return true
                    }
                }
            }
            false
        },
        App { ty, args } => {
            if type_mentions_generics(ty, generics) {
                true
            } else {
                for argument in args {
                    if type_mentions_generics(argument, generics) {
                        return true
                    }
                }
                false
            }
        },
        Array { len, elem } => {
            if type_mentions_generics(elem, generics) {
                return true
            }
            for generic in generics {
                if let Some(name) = consts::parameter_name(generic) {
                    if let Ok(expression) = consts::parse(len) {
                        if consts::contains_name(expression, name) {
                            return true
                        }
                    }
                }
            }
            false
        },
        Func { params, ret_ty } => {
            for parameter in params {
                if type_mentions_generics(parameter, generics) {
                    return true
                }
            }
            type_mentions_generics(ret_ty, generics)
        },
        _ => false,
    }
}

fn unary_op(value: isize) -> Result[ast::UnaryOp, string] {
    match value {
        0 => Ok(ast::UnaryOp::Neg),
        1 => Ok(ast::UnaryOp::Not),
        2 => Ok(ast::UnaryOp::BitNot),
        _ => Err(f"unknown meta unary operator {value}"),
    }
}

fn binary_op(value: isize) -> Result[ast::BinaryOp, string] {
    match value {
        0 => Ok(ast::BinaryOp::Add),
        1 => Ok(ast::BinaryOp::Sub),
        2 => Ok(ast::BinaryOp::Mul),
        3 => Ok(ast::BinaryOp::Div),
        4 => Ok(ast::BinaryOp::Rem),
        5 => Ok(ast::BinaryOp::BitAnd),
        6 => Ok(ast::BinaryOp::BitOr),
        7 => Ok(ast::BinaryOp::BitXor),
        8 => Ok(ast::BinaryOp::Shl),
        9 => Ok(ast::BinaryOp::Shr),
        10 => Ok(ast::BinaryOp::And),
        11 => Ok(ast::BinaryOp::Or),
        12 => Ok(ast::BinaryOp::Less),
        13 => Ok(ast::BinaryOp::Greater),
        14 => Ok(ast::BinaryOp::LessEq),
        15 => Ok(ast::BinaryOp::GreaterEq),
        16 => Ok(ast::BinaryOp::Eq),
        17 => Ok(ast::BinaryOp::NotEq),
        _ => Err(f"unknown meta binary operator {value}"),
    }
}

fn input_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    if name == "derive_item_name" {
        return Ok(ctir::CtValue::String(item_name(state.request.item)))
    } else if name == "derive_item_kind" {
        return Ok(
            int_value(
                state,
                match state.request.item {
                    Struct(_) => 0,
                    Enum(_) => 1,
                },
            ),
        )
    } else if name == "derive_generic_count" {
        return Ok(int_value(state, item_generics(state.request.item).len()))
    } else if name == "derive_generic_name" {
        let values = item_generics(state.request.item);
        let index = checked_index(int_argument(args, 1)?, values.len(), "derive generic")?;
        return Ok(ctir::CtValue::String(values[index]))
    } else if name == "derive_field_count" {
        return match state.request.item {
            Struct(value) => Ok(int_value(state, value.fields.len())),
            Enum(_) => Err("derive_field_count expects a struct"),
        }
    } else if name == "derive_field_name" {
        return match state.request.item {
            Struct(value) => {
                let field = struct_field(value, int_argument(args, 1)?)?;
                Ok(ctir::CtValue::String(field.0))
            },
            Enum(_) => Err("derive_field_name expects a struct"),
        }
    } else if name == "derive_field_type" {
        return match state.request.item {
            Struct(value) => {
                let field = struct_field(value, int_argument(args, 1)?)?;
                Ok(push_type(state, field.1))
            },
            Enum(_) => Err("derive_field_type expects a struct"),
        }
    } else if name.starts_with("derive_field_attribute_") {
        return match state.request.item {
            Struct(value) => {
                let field = checked_index(
                    int_argument(args, 1)?,
                    value.field_attrs.len(),
                    "derive field",
                )?;
                let values = value.field_attrs[field];
                if name == "derive_field_attribute_count" {
                    Ok(int_value(state, values.len()))
                } else {
                    attribute_value(
                        values,
                        int_argument(args, 2)?,
                        "derive field attribute",
                        name == "derive_field_attribute_text",
                    )
                }
            },
            Enum(_) => Err("derive_field_attribute intrinsic expects a struct"),
        }
    } else if name == "derive_field_attribute" {
        return match state.request.item {
            Struct(value) => {
                let field = checked_index(
                    int_argument(args, 1)?,
                    value.field_attrs.len(),
                    "derive field",
                )?;
                Ok(
                    push_attribute(
                        state,
                        selected_attribute(
                            value.field_attrs[field],
                            int_argument(args, 2)?,
                            "derive field attribute",
                        )?,
                    ),
                )
            },
            Enum(_) => Err("derive_field_attribute expects a struct"),
        }
    } else if name == "derive_variant_count" {
        return match state.request.item {
            Enum(value) => Ok(int_value(state, value.variants.len())),
            Struct(_) => Err("derive_variant_count expects an enum"),
        }
    } else if name == "derive_variant_name" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                Ok(ctir::CtValue::String(variant.name))
            },
            Struct(_) => Err("derive_variant_name expects an enum"),
        }
    } else if name == "derive_variant_kind" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                Ok(
                    int_value(
                        state,
                        match variant.fields {
                            Unit => 0,
                            Tuple(_) => 1,
                            ast::EnumVariantFields::Struct(_) => 2,
                        },
                    ),
                )
            },
            Struct(_) => Err("derive_variant_kind expects an enum"),
        }
    } else if name.starts_with("derive_variant_attribute_") {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                if name == "derive_variant_attribute_count" {
                    Ok(int_value(state, variant.attrs.len()))
                } else {
                    attribute_value(
                        variant.attrs,
                        int_argument(args, 2)?,
                        "derive variant attribute",
                        name == "derive_variant_attribute_text",
                    )
                }
            },
            Struct(_) => Err("derive_variant_attribute intrinsic expects an enum"),
        }
    } else if name == "derive_variant_attribute" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                Ok(
                    push_attribute(
                        state,
                        selected_attribute(
                            variant.attrs,
                            int_argument(args, 2)?,
                            "derive variant attribute",
                        )?,
                    ),
                )
            },
            Struct(_) => Err("derive_variant_attribute expects an enum"),
        }
    } else if name == "derive_variant_field_count" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                Ok(int_value(state, variant_field_count(variant)))
            },
            Struct(_) => Err("derive_variant_field_count expects an enum"),
        }
    } else if name == "derive_variant_field_name" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                let field = variant_field(variant, int_argument(args, 2)?)?;
                Ok(ctir::CtValue::String(field.0))
            },
            Struct(_) => Err("derive_variant_field_name expects an enum"),
        }
    } else if name == "derive_variant_field_type" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                let field = variant_field(variant, int_argument(args, 2)?)?;
                Ok(push_type(state, field.1))
            },
            Struct(_) => Err("derive_variant_field_type expects an enum"),
        }
    } else if name.starts_with("derive_variant_field_attribute_") {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                let field = checked_index(
                    int_argument(args, 2)?,
                    variant.field_attrs.len(),
                    "derive variant field",
                )?;
                let values = variant.field_attrs[field];
                if name == "derive_variant_field_attribute_count" {
                    Ok(int_value(state, values.len()))
                } else {
                    attribute_value(
                        values,
                        int_argument(args, 3)?,
                        "derive variant field attribute",
                        name == "derive_variant_field_attribute_text",
                    )
                }
            },
            Struct(_) => Err("derive_variant_field_attribute intrinsic expects an enum"),
        }
    } else if name == "derive_variant_field_attribute" {
        return match state.request.item {
            Enum(value) => {
                let variant = enum_variant(value, int_argument(args, 1)?)?;
                let field = checked_index(
                    int_argument(args, 2)?,
                    variant.field_attrs.len(),
                    "derive variant field",
                )?;
                Ok(
                    push_attribute(
                        state,
                        selected_attribute(
                            variant.field_attrs[field],
                            int_argument(args, 3)?,
                            "derive variant field attribute",
                        )?,
                    ),
                )
            },
            Struct(_) => {
                Err("derive_variant_field_attribute expects an enum")
            },
        }
    } else if name == "derive_attribute_count" {
        return Ok(int_value(state, item_attributes(state.request.item).len()))
    } else if name == "derive_attribute_name" || name == "derive_attribute_text" {
        let values = item_attributes(state.request.item);
        let index = checked_index(int_argument(args, 1)?, values.len(), "derive attribute")?;
        if name == "derive_attribute_name" {
            return Ok(ctir::CtValue::String(values[index].name))
        } else {
            return Ok(ctir::CtValue::String(values[index].text))
        }
    } else if name == "derive_attribute" {
        let values = item_attributes(state.request.item);
        return Ok(
            push_attribute(
                state,
                selected_attribute(values, int_argument(args, 1)?, "derive attribute")?,
            ),
        )
    } else if name == "derive_target_type" {
        return Ok(push_type(state, target_type(state.request.item, span(state))))
    } else if name == "derive_fresh_name" {
        let id = state.fresh.get();
        state.fresh.set(id + 1);
        return Ok(ctir::CtValue::String(f"#derive{id}_" + string_argument(args, 1)?))
    } else {
        Err("unknown derive input intrinsic `" + name + "`")
    }
}

fn attribute_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let attribute = attribute_handle(state, args, 0)?;
    if name == "meta_attribute_name" {
        Ok(ctir::CtValue::String(attribute.name))
    } else if name == "meta_attribute_text" {
        Ok(ctir::CtValue::String(attribute.text))
    } else if name == "meta_attribute_has_argument_list" {
        Ok(ctir::CtValue::Bool(attribute.has_argument_list))
    } else if name == "meta_attribute_argument_count" {
        Ok(int_value(state, structured_arguments(attribute)?.len()))
    } else if name == "meta_attribute_argument_kind" || name == "meta_attribute_argument_name"
        || name == "meta_attribute_argument_value_kind"
        || name == "meta_attribute_argument_text" {
        let argument = structured_argument(attribute, int_argument(args, 1)?)?;
        let value = if name == "meta_attribute_argument_kind" {
            if argument.name == "" {
                argument.kind
            } else {
                "named"
            }
        } else if name == "meta_attribute_argument_name" {
            if argument.name == "" {
                argument.text
            } else {
                argument.name
            }
        } else if name == "meta_attribute_argument_value_kind" {
            argument.kind
        } else {
            argument.text
        };
        Ok(ctir::CtValue::String(value))
    } else {
        Err("unknown derive attribute intrinsic `" + name + "`")
    }
}

fn type_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    if name == "meta_type_named" {
        let value = string_argument(args, 1)?;
        let ty = match primitive_type(value) {
            Some(ty) => ty,
            None => Con { path: path(definition_name(state, value), span(state)) },
        };
        Ok(push_type(state, ty))
    } else if name == "meta_type_call_site" {
        Ok(push_type(state, named_type(string_argument(args, 0)?, span(state))))
    } else if name == "meta_type_list_new" {
        let id = state.type_lists.len();
        let values: Vec[ast::TypeExpr] = Vec::new();
        state.type_lists.push(values);
        Ok(meta(META_TYPE_LIST_NAME, id))
    } else if name == "meta_type_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_TYPE_LIST_NAME)?,
            state.type_lists.len(),
            "meta type list",
        )?;
        state.type_lists[id].push(type_value(state, args, 1)?);
        Ok(unit_value())
    } else if name == "meta_type_tuple" {
        let items = type_list_value(state, args, 0)?;
        Ok(push_type(state, ast::TypeExpr::Tuple { items }))
    } else if name == "meta_type_apply" {
        let base = type_value(state, args, 0)?;
        let type_args = type_list_value(state, args, 1)?;
        Ok(push_type(state, ast::TypeExpr::App { ty: base, args: type_args }))
    } else if name == "meta_type_array" {
        Ok(
            push_type(
                state,
                Array { len: int_argument(args, 1)?.to_string(), elem: type_value(state, args, 0)? },
            ),
        )
    } else if name == "meta_type_projection" {
        Ok(
            push_type(
                state,
                Con {
                    path: path(
                        meta_type_key(type_value(state, args, 0)?) + "::"
                            + string_argument(args, 1)?,
                        span(state),
                    ),
                },
            ),
        )
    } else if name == "meta_type_kind" {
        Ok(ctir::CtValue::String(meta_type_kind(type_value(state, args, 0)?)))
    } else if name == "meta_type_name" {
        let value = type_value(state, args, 0)?;
        match primitive_type_name(value) {
            Some(name) => Ok(ctir::CtValue::String(name)),
            None => match value {
                Con { path } => Ok(ctir::CtValue::String(path_text(path))),
                _ => Err("meta_type_name expects a primitive or named type"),
            },
        }
    } else if name == "meta_type_argument_count" {
        match type_value(state, args, 0)? {
            App { ty: _, args: values } => {
                Ok(int_value(state, values.len()))
            },
            _ => Err("meta_type_argument_count expects an applied type"),
        }
    } else if name == "meta_type_argument" {
        match type_value(state, args, 0)? {
            App { ty: _, args: values } => {
                let index = checked_index(
                    int_argument(args, 1)?,
                    values.len(),
                    "meta type argument",
                )?;
                Ok(push_type(state, values[index]))
            },
            _ => Err("meta_type_argument expects an applied type"),
        }
    } else if name == "meta_type_tuple_count" {
        match type_value(state, args, 0)? {
            Tuple { items } => Ok(int_value(state, items.len())),
            _ => Err("meta_type_tuple_count expects a tuple type"),
        }
    } else if name == "meta_type_tuple_item" {
        match type_value(state, args, 0)? {
            Tuple { items } => {
                let index = checked_index(int_argument(args, 1)?, items.len(), "meta tuple item")?;
                Ok(push_type(state, items[index]))
            },
            _ => Err("meta_type_tuple_item expects a tuple type"),
        }
    } else if name == "meta_type_array_length" {
        match type_value(state, args, 0)? {
            Array { len, elem: _ } => num::parse_int_structured(len).map(
                |value| int_value(state, value),
            ).map_err(|_| "meta array length is not a concrete integer"),
            _ => Err("meta_type_array_length expects an array type"),
        }
    } else if name == "meta_type_array_element" {
        match type_value(state, args, 0)? {
            Array { len: _, elem } => Ok(push_type(state, elem)),
            _ => Err("meta_type_array_element expects an array type"),
        }
    } else if name == "meta_type_function_parameter_count" {
        match type_value(state, args, 0)? {
            Func { params, ret_ty: _ } => {
                Ok(int_value(state, params.len()))
            },
            _ => Err("meta_type_function_parameter_count expects a function type"),
        }
    } else if name == "meta_type_function_parameter" {
        match type_value(state, args, 0)? {
            Func { params, ret_ty: _ } => {
                let index = checked_index(
                    int_argument(args, 1)?,
                    params.len(),
                    "meta function parameter",
                )?;
                Ok(push_type(state, params[index]))
            },
            _ => Err("meta_type_function_parameter expects a function type"),
        }
    } else if name == "meta_type_function_return" {
        match type_value(state, args, 0)? {
            Func { params: _, ret_ty } => Ok(push_type(state, ret_ty)),
            _ => Err("meta_type_function_return expects a function type"),
        }
    } else if name == "meta_type_contains_generic" {
        Ok(
            Bool(
                type_mentions_generics(
                    type_value(state, args, 1)?,
                    item_generics(state.request.item),
                ),
            ),
        )
    } else if name == "meta_type_equal" {
        Ok(
            Bool(
                meta_type_key(type_value(state, args, 0)?)
                    == meta_type_key(type_value(state, args, 1)?),
            ),
        )
    } else {
        Err("unknown derive type intrinsic `" + name + "`")
    }
}

fn expr_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let value_span = span(state);
    if name == "meta_expr_var" {
        Ok(
            push_expr(
                state,
                ast::Expr::Path {
                    path: path(string_argument(args, 0)?, value_span),
                    owner_type_args: Vec::new(),
                    member_type_args: Vec::new(),
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_unit" {
        Ok(push_expr(state, ast::Expr::Unit { span: value_span }))
    } else if name == "meta_expr_bool" {
        Ok(push_expr(state, ast::Expr::Bool { value: bool_argument(args, 0)?, span: value_span }))
    } else if name == "meta_expr_int" {
        Ok(push_expr(state, Int { value: int_argument(args, 0)?.to_string(), span: value_span }))
    } else if name == "meta_expr_integer" {
        let Some(value) = numeric::normalize_integer(string_argument(args, 0)?) else {
            return Err("meta_expr_integer expects a valid integer literal");
        };
        let ty = type_value(state, args, 1)?;
        let integer = match ty {
            Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 => true,
            _ => false,
        };
        if !integer {
            Err("meta_expr_integer expects an integer type")
        } else {
            let method_name = match ty {
                Int8 => Option::Some("to_i8"),
                Int16 => Option::Some("to_i16"),
                Int32 => Option::Some("to_i32"),
                Int64 => Option::Some("to_i64"),
                Uint => Option::Some("to_usize"),
                Uint8 => Option::Some("to_u8"),
                Uint16 => Option::Some("to_u16"),
                Uint32 => Option::Some("to_u32"),
                Uint64 => Option::Some("to_u64"),
                _ => Option::None,
            };
            let lhs = match method_name {
                Some(field_name) => ast::Expr::Call {
                    func: ast::Expr::Field {
                        expr: ast::Expr::Int { value: "0", span: value_span },
                        field_name,
                        method_type_args: Vec::new(),
                        span: value_span,
                    },
                    args: Vec::new(),
                    span: value_span,
                },
                None => ast::Expr::Int { value: "0", span: value_span },
            };
            Ok(
                push_expr(
                    state,
                    Binary {
                        op: ast::BinaryOp::Add,
                        lhs,
                        rhs: ast::Expr::Int { value, span: value_span },
                        span: value_span,
                    },
                ),
            )
        }
    } else if name == "meta_expr_string" {
        Ok(push_expr(state, String { value: string_argument(args, 0)?, span: value_span }))
    } else if name == "meta_expr_char" {
        Ok(push_expr(state, ast::Expr::Char { value: string_argument(args, 0)?, span: value_span }))
    } else if name == "meta_expr_field" {
        Ok(
            push_expr(
                state,
                Field {
                    expr: expr_value(state, args, 0)?,
                    field_name: string_argument(args, 1)?,
                    method_type_args: Vec::new(),
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_index" {
        Ok(
            push_expr(
                state,
                ast::Expr::Index {
                    base: expr_value(state, args, 0)?,
                    index: expr_value(state, args, 1)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_unary" {
        Ok(
            push_expr(
                state,
                Unary {
                    op: unary_op(int_argument(args, 0)?)?,
                    expr: expr_value(state, args, 1)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_binary" {
        Ok(
            push_expr(
                state,
                Binary {
                    op: binary_op(int_argument(args, 0)?)?,
                    lhs: expr_value(state, args, 1)?,
                    rhs: expr_value(state, args, 2)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_trait_call" || name == "meta_expr_trait_call_site" {
        let offset = if name == "meta_expr_trait_call" {
            1
        } else {
            0
        };
        let call_args = expr_list_value(state, args, 2 + offset)?;
        let trait_name = if name == "meta_expr_trait_call" {
            definition_name(state, string_argument(args, 1)?)
        } else {
            string_argument(args, 0)?
        };
        let function_name = trait_name + "::" + string_argument(args, 1 + offset)?;
        Ok(
            push_expr(
                state,
                Call {
                    func: ast::Expr::Path {
                        path: path(function_name, value_span),
                        owner_type_args: Vec::new(),
                        member_type_args: Vec::new(),
                        span: value_span,
                    },
                    args: call_args,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_call" || name == "meta_expr_call_site" {
        let path_arg = if name == "meta_expr_call" {
            1
        } else {
            0
        };
        let list_arg = if name == "meta_expr_call" {
            2
        } else {
            1
        };
        let call_args = expr_list_value(state, args, list_arg)?;
        let function_name = if name == "meta_expr_call" {
            definition_name(state, string_argument(args, path_arg)?)
        } else {
            string_argument(args, path_arg)?
        };
        Ok(
            push_expr(
                state,
                Call {
                    func: ast::Expr::Path {
                        path: path(function_name, value_span),
                        owner_type_args: Vec::new(),
                        member_type_args: Vec::new(),
                        span: value_span,
                    },
                    args: call_args,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_tuple" || name == "meta_expr_array" {
        let items = expr_list_value(state, args, 0)?;
        let value = if name == "meta_expr_tuple" {
            ast::Expr::Tuple { items, span: value_span }
        } else {
            ast::Expr::Array { items, span: value_span }
        };
        Ok(push_expr(state, value))
    } else if name == "meta_expr_if" {
        Ok(
            push_expr(
                state,
                If {
                    cond: expr_value(state, args, 0)?,
                    then_branch: expr_value(state, args, 1)?,
                    else_branch: expr_value(state, args, 2)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_while" {
        Ok(
            push_expr(
                state,
                While {
                    label: Option::None,
                    cond: expr_value(state, args, 0)?,
                    body: expr_value(state, args, 1)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_match" {
        let list = checked_index(
            handle_argument(args, 1, META_ARM_LIST_NAME)?,
            state.arm_lists.len(),
            "meta arm list",
        )?;
        Ok(
            push_expr(
                state,
                Match {
                    expr: expr_value(state, args, 0)?,
                    arms: state.arm_lists[list],
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_cast" {
        let ty = type_value(state, args, 1)?;
        match ty {
            Dyn { bounds: _ } => (),
            _ => return Err("meta_expr_cast target must be a dyn trait type"),
        }
        Ok(push_expr(state, Cast { expr: expr_value(state, args, 0)?, ty, span: value_span }))
    } else if name == "meta_expr_constructor" || name == "meta_expr_target_constructor" {
        let name_index = if name == "meta_expr_target_constructor" {
            1
        } else {
            0
        };
        let list_index = if name == "meta_expr_target_constructor" {
            2
        } else {
            1
        };
        let constructor_args = expr_list_value(state, args, list_index)?;
        let constructor = if name == "meta_expr_target_constructor" {
            item_name(state.request.item) + "::" + string_argument(args, name_index)?
        } else {
            string_argument(args, name_index)?
        };
        Ok(
            push_expr(
                state,
                Constr {
                    constructor: path(constructor, value_span),
                    args: constructor_args,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_field_list_new" {
        let id = state.expr_fields.len();
        let values: Vec[(string, ast::Expr)] = Vec::new();
        state.expr_fields.push(values);
        Ok(meta(META_EXPR_FIELD_LIST_NAME, id))
    } else if name == "meta_expr_field_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_EXPR_FIELD_LIST_NAME)?,
            state.expr_fields.len(),
            "meta expression field list",
        )?;
        state.expr_fields[id].push((string_argument(args, 1)?, expr_value(state, args, 2)?));
        Ok(unit_value())
    } else if name == "meta_expr_struct" || name == "meta_expr_struct_call_site"
        || name == "meta_expr_target_struct"
        || name == "meta_expr_target_variant_struct" {
        let name_index = if name == "meta_expr_struct" {
            1
        } else {
            0
        };
        let list_index = if name == "meta_expr_struct" || name == "meta_expr_target_variant_struct" {
            2
        } else if name == "meta_expr_target_struct" {
            1
        } else {
            1
        };
        let id = checked_index(
            handle_argument(args, list_index, META_EXPR_FIELD_LIST_NAME)?,
            state.expr_fields.len(),
            "meta expression field list",
        )?;
        let name = if name == "meta_expr_struct" {
            definition_name(state, string_argument(args, name_index)?)
        } else if name == "meta_expr_target_variant_struct" {
            item_name(state.request.item) + "::" + string_argument(args, 1)?
        } else if name == "meta_expr_target_struct" {
            item_name(state.request.item)
        } else {
            string_argument(args, name_index)?
        };
        Ok(
            push_expr(
                state,
                StructLiteral {
                    name: path(name, value_span),
                    fields: state.expr_fields[id],
                    base: Option::None,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_method_call" {
        let call_args = expr_list_value(state, args, 2)?;
        Ok(
            push_expr(
                state,
                Call {
                    func: ast::Expr::Field {
                        expr: expr_value(state, args, 0)?,
                        field_name: string_argument(args, 1)?,
                        method_type_args: Vec::new(),
                        span: value_span,
                    },
                    args: call_args,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_expr_return" {
        Ok(
            push_expr(
                state,
                Return { expr: Option::Some(expr_value(state, args, 0)?), span: value_span },
            ),
        )
    } else if name == "meta_expr_try" {
        Ok(push_expr(state, ast::Expr::Try { expr: expr_value(state, args, 0)?, span: value_span }))
    } else if name == "meta_expr_list_new" {
        let id = state.expr_lists.len();
        let values: Vec[ast::Expr] = Vec::new();
        state.expr_lists.push(values);
        Ok(meta(META_EXPR_LIST_NAME, id))
    } else if name == "meta_expr_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_EXPR_LIST_NAME)?,
            state.expr_lists.len(),
            "meta expression list",
        )?;
        state.expr_lists[id].push(expr_value(state, args, 1)?);
        Ok(unit_value())
    } else {
        Err("unknown derive expression intrinsic `" + name + "`")
    }
}

fn pattern_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let value_span = span(state);
    if name == "meta_pattern_wild" {
        Ok(push_pattern(state, ast::Pat::Wild { span: value_span }))
    } else if name == "meta_pattern_bind" {
        Ok(
            push_pattern(
                state,
                Var { name: string_argument(args, 0)?, is_mut: false, span: value_span },
            ),
        )
    } else if name == "meta_pattern_unit" {
        Ok(push_pattern(state, ast::Pat::Unit { span: value_span }))
    } else if name == "meta_pattern_bool" {
        Ok(push_pattern(state, ast::Pat::Bool { value: bool_argument(args, 0)?, span: value_span }))
    } else if name == "meta_pattern_int" {
        Ok(push_pattern(state, Int { value: int_argument(args, 0)?.to_string(), span: value_span }))
    } else if name == "meta_pattern_string" {
        Ok(push_pattern(state, String { value: string_argument(args, 0)?, span: value_span }))
    } else if name == "meta_pattern_char" {
        Ok(push_pattern(state, Char { value: string_argument(args, 0)?, span: value_span }))
    } else if name == "meta_pattern_tuple" {
        let id = checked_index(
            handle_argument(args, 0, META_PATTERN_LIST_NAME)?,
            state.pattern_lists.len(),
            "meta pattern list",
        )?;
        Ok(push_pattern(state, Tuple { items: state.pattern_lists[id], span: value_span }))
    } else if name == "meta_pattern_array" {
        let id = checked_index(
            handle_argument(args, 0, META_PATTERN_LIST_NAME)?,
            state.pattern_lists.len(),
            "meta pattern list",
        )?;
        Ok(
            push_pattern(
                state,
                Array {
                    prefix: state.pattern_lists[id],
                    rest: Option::None,
                    suffix: Vec::new(),
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_pattern_constructor" || name == "meta_pattern_target_constructor" {
        let name_index = if name == "meta_pattern_target_constructor" {
            1
        } else {
            0
        };
        let list_index = if name == "meta_pattern_target_constructor" {
            2
        } else {
            1
        };
        let id = checked_index(
            handle_argument(args, list_index, META_PATTERN_LIST_NAME)?,
            state.pattern_lists.len(),
            "meta pattern list",
        )?;
        let constructor = if name == "meta_pattern_target_constructor" {
            item_name(state.request.item) + "::" + string_argument(args, name_index)?
        } else {
            string_argument(args, name_index)?
        };
        Ok(
            push_pattern(
                state,
                Constr {
                    constructor: path(constructor, value_span),
                    args: state.pattern_lists[id],
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_pattern_field_list_new" {
        let id = state.pattern_fields.len();
        let values: Vec[(string, ast::Pat)] = Vec::new();
        state.pattern_fields.push(values);
        Ok(meta(META_PATTERN_FIELD_LIST_NAME, id))
    } else if name == "meta_pattern_field_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_PATTERN_FIELD_LIST_NAME)?,
            state.pattern_fields.len(),
            "meta pattern field list",
        )?;
        state.pattern_fields[id].push((string_argument(args, 1)?, pattern_value(state, args, 2)?));
        Ok(unit_value())
    } else if name == "meta_pattern_struct" || name == "meta_pattern_target_struct" {
        let list_index = if name == "meta_pattern_target_struct" {
            1
        } else {
            1
        };
        let id = checked_index(
            handle_argument(args, list_index, META_PATTERN_FIELD_LIST_NAME)?,
            state.pattern_fields.len(),
            "meta pattern field list",
        )?;
        let pattern_name = if name == "meta_pattern_target_struct" {
            item_name(state.request.item)
        } else {
            string_argument(args, 0)?
        };
        Ok(
            push_pattern(
                state,
                ast::Pat::Struct {
                    name: path(pattern_name, value_span),
                    fields: state.pattern_fields[id],
                    has_rest: bool_argument(args, 2)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_pattern_alias" {
        Ok(
            push_pattern(
                state,
                Alias {
                    name: string_argument(args, 0)?,
                    pat: pattern_value(state, args, 1)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_pattern_or" {
        let id = checked_index(
            handle_argument(args, 0, META_PATTERN_LIST_NAME)?,
            state.pattern_lists.len(),
            "meta pattern list",
        )?;
        Ok(push_pattern(state, ast::Pat::Or { pats: state.pattern_lists[id], span: value_span }))
    } else if name == "meta_pattern_range" {
        Ok(
            push_pattern(
                state,
                ast::Pat::Range {
                    start: pattern_value(state, args, 0)?,
                    end: pattern_value(state, args, 1)?,
                    inclusive: bool_argument(args, 2)?,
                    span: value_span,
                },
            ),
        )
    } else if name == "meta_pattern_list_new" {
        let id = state.pattern_lists.len();
        let values: Vec[ast::Pat] = Vec::new();
        state.pattern_lists.push(values);
        Ok(meta(META_PATTERN_LIST_NAME, id))
    } else if name == "meta_pattern_list_push" || name == "meta_pattern_list_prepend" {
        let id = checked_index(
            handle_argument(args, 0, META_PATTERN_LIST_NAME)?,
            state.pattern_lists.len(),
            "meta pattern list",
        )?;
        let pattern = pattern_value(state, args, 1)?;
        if name == "meta_pattern_list_push" {
            state.pattern_lists[id].push(pattern)
        } else {
            state.pattern_lists[id].insert(0, pattern)
        }
        Ok(unit_value())
    } else if name == "meta_arm" {
        let id = state.arms.len();
        state.arms.push(
            ast::Arm {
                pat: pattern_value(state, args, 0)?,
                guard: Option::None,
                body: expr_value(state, args, 1)?,
            },
        );
        Ok(meta(META_ARM_NAME, id))
    } else if name == "meta_arm_guarded" {
        let id = state.arms.len();
        state.arms.push(
            ast::Arm {
                pat: pattern_value(state, args, 0)?,
                guard: Option::Some(expr_value(state, args, 1)?),
                body: expr_value(state, args, 2)?,
            },
        );
        Ok(meta(META_ARM_NAME, id))
    } else if name == "meta_arm_list_new" {
        let id = state.arm_lists.len();
        let values: Vec[ast::Arm] = Vec::new();
        state.arm_lists.push(values);
        Ok(meta(META_ARM_LIST_NAME, id))
    } else if name == "meta_arm_list_push" {
        let list = checked_index(
            handle_argument(args, 0, META_ARM_LIST_NAME)?,
            state.arm_lists.len(),
            "meta arm list",
        )?;
        let arm = checked_index(
            handle_argument(args, 1, META_ARM_NAME)?,
            state.arms.len(),
            "meta arm",
        )?;
        state.arm_lists[list].push(state.arms[arm]);
        Ok(unit_value())
    } else {
        Err("unknown derive pattern intrinsic `" + name + "`")
    }
}

fn block_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let value_span = span(state);
    if name == "meta_block_new" {
        let id = state.blocks.len();
        state.blocks.push(ast::Block { stmts: Vec::new(), tail: Option::None, span: value_span });
        Ok(meta(META_BLOCK_NAME, id))
    } else if name == "meta_block_let" || name == "meta_block_let_mut" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        let is_mut = name == "meta_block_let_mut";
        state.blocks[id].stmts.push(
            Let {
                is_mut,
                pat: ast::Pat::Var { name: string_argument(args, 1)?, is_mut, span: value_span },
                annotation: Option::None,
                value: expr_value(state, args, 2)?,
                else_branch: Option::None,
                span: value_span,
            },
        );
        Ok(unit_value())
    } else if name == "meta_block_let_typed" || name == "meta_block_let_mut_typed" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        let is_mut = name == "meta_block_let_mut_typed";
        state.blocks[id].stmts.push(
            Let {
                is_mut,
                pat: ast::Pat::Var { name: string_argument(args, 1)?, is_mut, span: value_span },
                annotation: Option::Some(type_value(state, args, 2)?),
                value: expr_value(state, args, 3)?,
                else_branch: Option::None,
                span: value_span,
            },
        );
        Ok(unit_value())
    } else if name == "meta_block_let_pattern" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        state.blocks[id].stmts.push(
            Let {
                is_mut: false,
                pat: pattern_value(state, args, 1)?,
                annotation: Option::None,
                value: expr_value(state, args, 2)?,
                else_branch: Option::None,
                span: value_span,
            },
        );
        Ok(unit_value())
    } else if name == "meta_block_assign" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        state.blocks[id].stmts.push(
            Assign {
                target: expr_value(state, args, 1)?,
                op: ast::AssignmentOp::Plain,
                value: expr_value(state, args, 2)?,
                span: value_span,
            },
        );
        Ok(unit_value())
    } else if name == "meta_block_expr" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        state.blocks[id].stmts.push(Expr { expr: expr_value(state, args, 1)?, span: value_span });
        Ok(unit_value())
    } else if name == "meta_block_finish" || name == "meta_block_finish_unit" {
        let id = checked_index(
            handle_argument(args, 0, META_BLOCK_NAME)?,
            state.blocks.len(),
            "meta block",
        )?;
        let tail = if name == "meta_block_finish" {
            Option::Some(expr_value(state, args, 1)?)
        } else {
            Option::None
        };
        Ok(
            push_expr(
                state,
                ast::Expr::Block {
                    block: ast::Block { stmts: state.blocks[id].stmts, tail, span: value_span },
                    span: value_span,
                },
            ),
        )
    } else {
        Err("unknown derive block intrinsic `" + name + "`")
    }
}

fn output_intrinsic(state: DeriveState, name: string, args: Vec[ctir::CtValue]) -> Result[
    ctir::CtValue,
    string,
] {
    let value_span = span(state);
    if name == "meta_param_list_new" {
        let id = state.param_lists.len();
        let values: Vec[(string, ast::TypeExpr)] = Vec::new();
        state.param_lists.push(values);
        Ok(meta(META_PARAM_LIST_NAME, id))
    } else if name == "meta_param_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_PARAM_LIST_NAME)?,
            state.param_lists.len(),
            "meta parameter list",
        )?;
        state.param_lists[id].push((string_argument(args, 1)?, type_value(state, args, 2)?));
        Ok(unit_value())
    } else if name == "meta_generic_list_new" {
        let id = state.generic_lists.len();
        let values: Vec[(string, Vec[ast::TraitRef])] = Vec::new();
        state.generic_lists.push(values);
        Ok(meta(META_GENERIC_LIST_NAME, id))
    } else if name == "meta_generic_list_push" {
        let id = checked_index(
            handle_argument(args, 0, META_GENERIC_LIST_NAME)?,
            state.generic_lists.len(),
            "meta generic list",
        )?;
        state.generic_lists[id].push((string_argument(args, 1)?, Vec::new()));
        Ok(unit_value())
    } else if name == "meta_generic_list_add_bound" {
        let id = checked_index(
            handle_argument(args, 1, META_GENERIC_LIST_NAME)?,
            state.generic_lists.len(),
            "meta generic list",
        )?;
        let generic_name = string_argument(args, 2)?;
        let mut found = false;
        for index in 0..state.generic_lists[id].len() {
            if state.generic_lists[id][index].0 == generic_name {
                let entry = state.generic_lists[id][index];
                entry.1.push(
                    ast::TraitRef {
                        path: path(definition_name(state, string_argument(args, 3)?), value_span),
                        args: Vec::new(),
                    },
                );
                state.generic_lists[id].set(index, entry);
                found = true;
            }
        }
        if found {
            Ok(unit_value())
        } else {
            Err("meta generic list has no parameter `" + generic_name + "`")
        }
    } else if name == "meta_method" || name == "meta_method_generic" {
        let generic_offset = if name == "meta_method_generic" {
            1
        } else {
            0
        };
        let params = checked_index(
            handle_argument(args, 1 + generic_offset, META_PARAM_LIST_NAME)?,
            state.param_lists.len(),
            "meta parameter list",
        )?;
        let generics: Vec[string] = Vec::new();
        let generic_bounds: Vec[(string, Vec[ast::TraitRef])] = Vec::new();
        if name == "meta_method_generic" {
            let generic_list = checked_index(
                handle_argument(args, 1, META_GENERIC_LIST_NAME)?,
                state.generic_lists.len(),
                "meta generic list",
            )?;
            for generic in state.generic_lists[generic_list] {
                generics.push(generic.0);
                generic_bounds.push(generic)
            }
        }
        let param_type_spans: Vec[ast::Span] = Vec::new();
        for _ in state.param_lists[params] {
            param_type_spans.push(value_span)
        }
        let id = state.methods.len();
        state.methods.push(
            ast::Function {
                attrs: Vec::new(),
                visibility: ast::Visibility::Private,
                name: string_argument(args, 0)?,
                name_span: value_span,
                generics,
                generic_bounds,
                predicates: Vec::new(),
                params: state.param_lists[params],
                param_type_spans,
                ret_ty: Option::Some(type_value(state, args, 2 + generic_offset)?),
                ret_ty_span: Option::Some(value_span),
                body: ast::Block {
                    stmts: Vec::new(),
                    tail: Option::Some(expr_value(state, args, 3 + generic_offset)?),
                    span: value_span,
                },
            },
        );
        Ok(meta(META_METHOD_NAME, id))
    } else if name == "derive_output_new" || name == "derive_output_new_call_site"
        || name == "derive_output_inherent" {
        let trait_ref = if name == "derive_output_inherent" {
            Option::None
        } else {
            let trait_name = if name == "derive_output_new" {
                definition_name(state, string_argument(args, 1)?)
            } else {
                string_argument(args, 1)?
            };
            Option::Some(ast::TraitRef { path: path(trait_name, value_span), args: Vec::new() })
        };
        let id = state.outputs.len();
        state.output_items.push(Vec::new());
        state.outputs.push(
            ast::ImplBlock {
                attrs: Vec::new(),
                generics: item_generics(state.request.item),
                generic_bounds: Vec::new(),
                predicates: Vec::new(),
                associated_types: Vec::new(),
                trait_ref,
                for_type: target_type(state.request.item, value_span),
                for_type_span: value_span,
                methods: Vec::new(),
            },
        );
        Ok(meta(DERIVE_OUTPUT_NAME, id))
    } else if name == "derive_output_add_predicate"
        || name == "derive_output_add_call_site_predicate" {
        let id = output_index(state, args, 0)?;
        let trait_name = if name == "derive_output_add_predicate" {
            definition_name(state, string_argument(args, 2)?)
        } else {
            string_argument(args, 2)?
        };
        state.outputs[id].predicates.push(
            Trait {
                ty: type_value(state, args, 1)?,
                trait_ref: ast::TraitRef { path: path(trait_name, value_span), args: Vec::new() },
            },
        );
        Ok(unit_value())
    } else if name == "derive_output_add_method" || name == "derive_output_add_public_method" {
        let output = output_index(state, args, 0)?;
        let method = checked_index(
            handle_argument(args, 1, META_METHOD_NAME)?,
            state.methods.len(),
            "meta method",
        )?;
        let mut method = state.methods[method];
        if name == "derive_output_add_public_method" {
            if state.outputs[output].trait_ref.is_some() {
                return Err("public derive methods require an inherent implementation")
            }
            method.visibility = ast::Visibility::Public;
        }
        state.outputs[output].methods.push(method);
        Ok(unit_value())
    } else if name == "derive_error" {
        Err(string_argument(args, 1)?)
    } else {
        Err("unknown derive output intrinsic `" + name + "`")
    }
}

pub fn call_intrinsic(
    state: DeriveState,
    definition_package: string,
    name: string,
    args: Vec[ctir::CtValue],
) -> Result[ctir::CtValue, string] {
    state.definition_package.set(definition_package);
    let operations = state.operations.get();
    if operations >= 100000 {
        return Err("derive generated syntax limit exceeded")
    } else {
        state.operations.set(operations + 1)
    }
    if is_extended_intrinsic(name) {
        extended_intrinsic(state, name, args)
    } else if name.starts_with("derive_item_") || name.starts_with("derive_generic_")
        || name.starts_with("derive_field_")
        || name.starts_with("derive_variant_")
        || name.starts_with("derive_attribute_")
        || name == "derive_attribute"
        || name == "derive_target_type"
        || name == "derive_fresh_name" {
        input_intrinsic(state, name, args)
    } else if name.starts_with("meta_attribute_") {
        attribute_intrinsic(state, name, args)
    } else if name.starts_with("meta_type_") {
        type_intrinsic(state, name, args)
    } else if name.starts_with("meta_expr_") {
        expr_intrinsic(state, name, args)
    } else if name.starts_with("meta_pattern_") || name.starts_with("meta_arm") {
        pattern_intrinsic(state, name, args)
    } else if name.starts_with("meta_block_") {
        block_intrinsic(state, name, args)
    } else {
        output_intrinsic(state, name, args)
    }
}

pub fn output(state: DeriveState, value: ctir::CtValue) -> Result[Vec[ast::Item], string] {
    let id = match value {
        Meta { kind, id } => if kind == DERIVE_OUTPUT_NAME {
            id
        } else {
            return Err("derive handler returned " + kind + " instead of DeriveOutput")
        },
        _ => return Err("derive handler did not return DeriveOutput"),
    };
    let id = checked_index(id, state.outputs.len(), "derive output")?;
    let result = Vec::from_array([ast::Item::ImplBlock(state.outputs[id])]);
    for item in state.output_items[id] {
        result.push(item)
    }
    Ok(result)
}
