package derive;

use module::ast;
use module::consts;
use module::ctir;
use module::numeric;
use std::num;
use std::text;

const DERIVE_INPUT_NAME: string = "DeriveInput";

const DERIVE_OUTPUT_NAME: string = "DeriveOutput";

const META_SPAN_NAME: string = "MetaSpan";

const META_TYPE_NAME: string = "MetaType";

const META_TYPE_LIST_NAME: string = "MetaTypeList";

const META_EXPR_NAME: string = "MetaExpr";

const META_EXPR_LIST_NAME: string = "MetaExprList";

const META_EXPR_FIELD_LIST_NAME: string = "MetaExprFieldList";

const META_PATTERN_NAME: string = "MetaPattern";

const META_PATTERN_LIST_NAME: string = "MetaPatternList";

const META_PATTERN_FIELD_LIST_NAME: string = "MetaPatternFieldList";

const META_ARM_NAME: string = "MetaArm";

const META_ARM_LIST_NAME: string = "MetaArmList";

const META_BLOCK_NAME: string = "MetaBlock";

const META_PARAM_LIST_NAME: string = "MetaParamList";

const META_GENERIC_LIST_NAME: string = "MetaGenericList";

const META_METHOD_NAME: string = "MetaMethod";

const META_ATTRIBUTE_NAME: string = "MetaAttribute";

const STRING_TYPE_NAME: string = "string";

const INT_TYPE_NAME: string = "isize";

const BOOL_TYPE_NAME: string = "bool";

const UNIT_TYPE_NAME: string = "()";

static intrinsic_specs_cache: OnceCell[FrozenVec[DeriveIntrinsicSpec]] = OnceCell::new();

pub struct DeriveIntrinsicSpec {
    pub name: string,
    pub params: FrozenVec[string],
    pub ret: string,
}

fn spec(name: string, params: Vec[string], ret: string) -> DeriveIntrinsicSpec {
    DeriveIntrinsicSpec { name, params: params.freeze(), ret }
}

fn no_types() -> Vec[string] {
    Vec::new()
}

fn one_type(first: string) -> Vec[string] {
    Vec::from_array([first])
}

fn two_types(first: string, second: string) -> Vec[string] {
    Vec::from_array([first, second])
}

fn three_types(first: string, second: string, third: string) -> Vec[string] {
    Vec::from_array([first, second, third])
}

fn four_types(first: string, second: string, third: string, fourth: string) -> Vec[string] {
    Vec::from_array([first, second, third, fourth])
}

fn five_types(first: string, second: string, third: string, fourth: string, fifth: string) -> Vec[
    string,
] {
    Vec::from_array([first, second, third, fourth, fifth])
}

pub fn intrinsic_specs() -> FrozenVec[DeriveIntrinsicSpec] {
    intrinsic_specs_cache.get_or_init(|| load_intrinsic_specs())
}

fn load_intrinsic_specs() -> FrozenVec[DeriveIntrinsicSpec] {
    let result = Vec::from_array(
