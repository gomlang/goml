package lsp;

use module::query;
use std::json;
use std::testing;

#[test]
fn completion_serializes_enum_arm_snippets_after_unsaved_edits() -> () {
    let server = new_server();
    let uri = "file:///tmp/formatting.goml";
    let source = "fn run(value: Option[isize]) -> () { match value { None => (), Some(_) => () } }";
    formatting_document(server, uri, source);
    let original = testing::expect_some(server_document(server, uri), "expected document");
    let _ = document_analysis(server, original);
    let updated = source.replace("Some(_) => ()", "So");
    change_document(server, uri, updated, 2);
    let offset = testing::expect_some(updated.find("So"), "expected prefix") + 2;
    let params = protocol_test_json(
        "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":0,\"character\":"
            + offset.to_string()
            + "}}",
    );
    let response = testing::expect_ok(completion_response(server, params), "expected completions");
    let items = testing::expect_some(json::as_array(response), "expected completion list");
    testing::assert_eq(items.len(), 1);
    let item = items[0];
    testing::assert(json::as_string(diagnostic_test_field(item, "label")) == Option::Some("Some"));
    testing::assert(
        json::as_string(diagnostic_test_field(item, "insertText"))
            == Option::Some("Some(${1:value}) => ${2:()},"),
    );
    testing::assert(
        json::as_int(diagnostic_test_field(item, "insertTextFormat")) == Option::Some(2),
    );
}

#[test]
fn completion_match_keyword_includes_a_scrutinee_outside_receive_arms() -> () {
    let item = query::CompletionItem {
        label: "match",
        detail: "",
        kind: Keyword,
        insert_text: None,
    };
    let snippet = testing::expect_some(completion_snippet(item), "expected match snippet");
    testing::assert(snippet.contains("match ${1:value} {"));
}

#[test]
fn completion_replaces_the_whole_identifier_and_preserves_existing_arguments() -> () {
    let server = new_server();
    let uri = "file:///tmp/formatting.goml";
    let source = "fn run() -> Option[isize] { let _ = \"😀\"; Option::Some(1) }";
    formatting_document(server, uri, source);
    let offset = testing::expect_some(source.find("Some"), "expected constructor") + 2;
    let params = protocol_test_json(
        "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":0,\"character\":"
            + (offset - 2).to_string()
            + "}}",
    );
    let response = testing::expect_ok(completion_response(server, params), "expected completions");
    let items = testing::expect_some(json::as_array(response), "expected completion list");
    testing::assert_eq(items.len(), 1);
    let edit = diagnostic_test_field(items[0], "textEdit");
    let range = testing::expect_ok(
        parse_range(diagnostic_test_field(edit, "range")),
        "expected range",
    );
    testing::assert_eq(range.start.character, offset - 4);
    testing::assert_eq(range.end.character, offset);
    testing::assert(json::as_string(diagnostic_test_field(edit, "newText")) == Option::Some("Some"));
}
