package lsp;

use module::query;
use std::collections;
use std::text as text_index;

pub struct Document {
    pub uri: string,
    pub path: string,
    pub text: string,
    pub version: isize,
    pub line_index: text_index::LineIndex,
}

struct CachedAnalysis {
    path: string,
    generation: isize,
    analysis: query::Analysis,
}

struct CachedLineIndex {
    path: string,
    generation: isize,
    index: text_index::LineIndex,
}

pub struct Server {
    documents: collections::IndexMap[string, Document],
    analyses: collections::IndexMap[string, CachedAnalysis],
    line_indexes: collections::IndexMap[string, CachedLineIndex],
    analysis_context: query::AnalysisContext,
    generation: Ref[isize],
    running: Ref[bool],
    shutdown: Ref[bool],
}

pub fn new_server() -> Server {
    Server {
        documents: collections::IndexMap::new(),
        analyses: collections::IndexMap::new(),
        line_indexes: collections::IndexMap::new(),
        analysis_context: query::analysis_context(),
        generation: Ref::new(0),
        running: Ref::new(true),
        shutdown: Ref::new(false),
    }
}

pub fn server_running(value: Server) -> bool {
    value.running.get()
}

fn advance_generation(value: Server) -> () {
    value.generation.set(value.generation.get() + 1);
    value.line_indexes.clear()
}

pub fn invalidate_analyses(value: Server) -> () {
    query::clear_analysis_cache(value.analysis_context);
    value.analyses.clear();
    advance_generation(value)
}

fn invalidate_other_analyses(value: Server, path: string) -> () {
    let current = value.analyses.get(path);
    value.analyses.clear();
    if let Some(cached) = current {
        let _ = value.analyses.insert(path, cached);
    }
    advance_generation(value)
}

pub fn server_document(value: Server, uri: string) -> Option[Document] {
    value.documents.get(uri)
}

fn source_line_index(value: Server, source_path: string, source: string) -> text_index::LineIndex {
    let documents = value.documents.values();
    let mut document_cursor = documents.len() - 1;
    while document_cursor >= 0 {
        let document = documents[document_cursor];
        if document.path == source_path {
            return document.line_index
        } else {
            document_cursor -= 1;
        }
    }
    if let Some(cached) = value.line_indexes.get(source_path) {
        if cached.path == source_path && cached.generation == value.generation.get() {
            return cached.index
        }
    }
    let index = line_index(source);
    let _ = value.line_indexes.insert(
        source_path,
        CachedLineIndex { path: source_path, generation: value.generation.get(), index },
    );
    index
}

pub fn open_document(value: Server, document: Document) -> () {
    let path = document.path;
    let _ = value.documents.insert(document.uri, document);
    invalidate_other_analyses(value, path)
}

pub fn change_document(value: Server, uri: string, text: string, version: isize) -> () {
    if let Some(current) = value.documents.get(uri) {
        let _ = value.documents.insert(
            uri,
            Document {
                uri: current.uri,
                path: current.path,
                text,
                version,
                line_index: line_index(text),
            },
        );
        invalidate_other_analyses(value, current.path)
    }
}

pub fn close_document(value: Server, uri: string) -> () {
    if let Some(_) = value.documents.remove(uri) {
        invalidate_analyses(value)
    }
}

pub fn cached_document_analysis(value: Server, document: Document) -> Option[query::Analysis] {
    value.analyses.get(document.path).map(|cached| cached.analysis)
}

fn source_overrides(value: Server) -> Vec[query::SourceOverride] {
    let result: Vec[query::SourceOverride] = Vec::new();
    for (_, document) in value.documents {
        result.push(query::SourceOverride { path: document.path, source: document.text })
    }
    result
}

pub fn document_analysis(value: Server, document: Document) -> query::Analysis {
    if let Some(cached) = value.analyses.get(document.path) {
        if cached.path == document.path && cached.generation == value.generation.get() {
            return cached.analysis
        }
    }
    let analysis = query::analyze_with_context(
        value.analysis_context,
        document.path,
        document.text,
        source_overrides(value),
    );
    let cached = CachedAnalysis {
        path: document.path,
        generation: value.generation.get(),
        analysis,
    };
    let _ = value.analyses.insert(document.path, cached);
    analysis
}
