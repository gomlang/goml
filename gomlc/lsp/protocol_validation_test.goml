package lsp;

use std::json;
use std::testing;

fn protocol_test_json(source: string) -> json::Value {
    testing::expect_ok(json::parse(source), "valid test JSON")
}

#[test]
fn rpc_content_lengths_reject_overflow_and_nondecimal_values() -> () {
    for value in Vec::from_array(
        [
            "",
            "+1",
            "-1",
            "1.0",
            "0x10",
            "1_000",
            "9223372036854775808",
            "18446744073709551616",
            "999999999999999999999999999",
        ],
    ) {
        testing::assert(content_length("Content-Length: " + value).is_err())
    }
    testing::assert_eq(
        testing::expect_ok(content_length("Content-Length: 00042"), "decimal length"),
        42,
    );
    testing::assert_eq(testing::expect_ok(content_length("Content-Length: 0"), "empty payload"), 0);
    testing::assert_eq(
        testing::expect_ok(content_length("Content-Length: 9223372036854775807"), "maximum length"),
        9223372036854775807,
    );
}

#[test]
fn rpc_envelopes_validate_request_ids_and_parameter_shapes() -> () {
    for source in Vec::from_array(
        [
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":true}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":[]}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":{}}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":false}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":1}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":\"text\"}",
        ],
    ) {
        testing::assert(parse_rpc_message(protocol_test_json(source)).is_err())
    }
    for source in Vec::from_array(
        [
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\"}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":\"request\",\"params\":{}}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":1,\"params\":[]}",
            "{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"id\":null,\"params\":null}",
        ],
    ) {
        testing::assert(parse_rpc_message(protocol_test_json(source)).is_ok())
    }
}

#[test]
fn protocol_ranges_require_nonnegative_ordered_positions() -> () {
    testing::assert(parse_position(protocol_test_json("{\"line\":-1,\"character\":0}")).is_err());
    testing::assert(parse_position(protocol_test_json("{\"line\":0,\"character\":-1}")).is_err());
    for value in Vec::from_array(
        [
            Range {
                start: Position { line: 2, character: 0 },
                end: Position { line: 1, character: 20 },
            },
            Range {
                start: Position { line: 1, character: 2 },
                end: Position { line: 1, character: 1 },
            },
        ],
    ) {
        testing::assert(parse_range(range_json(value)).is_err())
    }
    testing::assert(
        parse_range(
            range_json(
                Range {
                    start: Position { line: 0, character: 0 },
                    end: Position { line: 0, character: 0 },
                },
            ),
        ).is_ok(),
    );
    testing::assert(
        parse_range(
            range_json(
                Range {
                    start: Position { line: 0, character: 20 },
                    end: Position { line: 1, character: 0 },
                },
            ),
        ).is_ok(),
    );
}

#[test]
fn file_uris_separate_local_paths_from_authority_and_metadata() -> () {
    testing::assert_eq(
        testing::expect_ok(uri_to_path("file://localhost/tmp/main.goml"), "localhost URI"),
        "/tmp/main.goml",
    );
    let path = "/tmp/a?#%语言.goml";
    testing::assert_eq(testing::expect_ok(uri_to_path(path_to_uri(path)), "escaped filename"), path);
    for value in Vec::from_array(
        [
            "file://",
            "file://remote/tmp/main.goml",
            "file://localhost",
            "file:///tmp/main.goml?query",
            "file:///tmp/main.goml#fragment",
            "file:///tmp/%00.goml",
            "file:///tmp/%",
            "file:///tmp/%0",
            "file:///tmp/%GG",
        ],
    ) {
        testing::assert(uri_to_path(value).is_err())
    }
}
