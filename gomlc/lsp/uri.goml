package lsp;

use std::bytes;
use std::path;
use std::text;
use std::utf8;
use utf8::BytesUtf8;

fn uri_unreserved(value: u8) -> bool {
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122) || (value >= 48 && value <= 57)
        || value == 45
        || value == 46
        || value == 95
        || value == 126
}

fn uri_hex(value: u8) -> char {
    "0123456789ABCDEF".get(value.to_isize())
}

pub fn path_to_uri(value: string) -> string {
    let absolute = path::absolute_structured(value).unwrap_or_else(|_| path::clean(value));
    let builder = text::StringBuilder::new();
    builder.write_string("file://");
    for index in 0..absolute.byte_len() {
        let byte = absolute.byte_get(index);
        if uri_unreserved(byte) || byte == b'/' || byte == b':' {
            builder.write_string(absolute.byte_slice(index, index + 1))
        } else {
            builder.write_char('%');
            builder.write_char(uri_hex(byte / 16));
            builder.write_char(uri_hex(byte % 16))
        }
    }
    builder.finish()
}

fn uri_hex_value(value: u8) -> Option[u8] {
    if value >= 48 && value <= 57 {
        Option::Some(value - 48)
    } else if value >= 65 && value <= 70 {
        Option::Some(value - 55)
    } else if value >= 97 && value <= 102 {
        Option::Some(value - 87)
    } else {
        Option::None
    }
}

pub fn uri_to_path(value: string) -> Result[string, string] {
    let prefix = "file://";
    if !value.starts_with(prefix) {
        return Result::Err("unsupported URI: " + value)
    }
    let mut index = prefix.byte_len();
    if value.starts_with("file://localhost/") {
        index += "localhost".byte_len();
    }
    if index >= value.byte_len() || value.byte_get(index) != b'/' {
        return Result::Err("file URI must have an absolute path and local authority")
    }
    let decoded_bytes: Vec[u8] = Vec::new();
    while index < value.byte_len() {
        let byte = value.byte_get(index);
        let decoded = if byte == b'%' {
            if index + 2 >= value.byte_len() {
                return Result::Err("invalid URI escape")
            }
            let high = uri_hex_value(value.byte_get(index + 1)).ok_or("invalid URI escape")?;
            let low = uri_hex_value(value.byte_get(index + 2)).ok_or("invalid URI escape")?;
            index += 3;
            high * 16 + low
        } else {
            if byte == b'?' || byte == b'#' {
                return Result::Err("file URI must not contain a query or fragment")
            }
            index += 1;
            byte
        };
        if decoded == 0 {
            return Result::Err("file URI path must not contain a null byte")
        }
        decoded_bytes.push(decoded);
    }
    bytes::Bytes::from_vec(decoded_bytes).to_string_utf8().map(|decoded| path::clean(decoded)).map_err(
        |_| "URI path is not valid UTF-8",
    )
}
