package lsp;

use std::json;
use std::testing;

fn formatting_result(server: Server, uri: string) -> Vec[json::Value] {
    let text_document = Vec::new();
    push_json_field(text_document, "uri", json::Value::String(uri));
    let options = Vec::new();
    push_json_field(options, "tabSize", json::Value::Number("2"));
    push_json_field(options, "insertSpaces", json::Value::Bool(false));
    let params = Vec::new();
    push_json_field(params, "textDocument", json::Value::Object(text_document));
    push_json_field(params, "options", json::Value::Object(options));
    let request = Vec::new();
    push_json_field(request, "jsonrpc", json::Value::String("2.0"));
    push_json_field(request, "id", json::Value::Number("20"));
    push_json_field(request, "method", json::Value::String("textDocument/formatting"));
    push_json_field(request, "params", json::Value::Object(params));
    let messages = handle_json(server, json::Value::Object(request));
    testing::assert_eq(messages.len(), 1);
    match json::field(messages.get(0), "result") {
        Some(value) => match json::as_array(value) {
            Some(value) => value,
            None => {
                testing::fail("formatting result must be an array");
                Vec::new()
            },
        },
        None => {
            testing::fail("missing formatting result");
            Vec::new()
        },
    }
}

fn formatting_document(server: Server, uri: string, text: string) -> () {
    open_document(
        server,
        Document {
            uri,
            path: "/tmp/formatting.goml",
            text,
            version: 1,
            line_index: line_index(text),
        },
    )
}

#[test]
fn advertises_document_formatting() -> () {
    let result = initialize_result();
    match json::field(result, "capabilities") {
        Some(capabilities) => match json::field(capabilities, "documentFormattingProvider") {
            Some(value) => match json::as_bool(value) {
                Some(value) => testing::assert(value),
                None => testing::fail("formatting capability must be boolean"),
            },
            None => testing::fail("missing formatting capability"),
        },
        None => testing::fail("missing server capabilities"),
    }
}

#[test]
fn formats_the_latest_unicode_document() -> () {
    let server = new_server();
    let uri = "file:///tmp/formatting.goml";
    formatting_document(server, uri, "package main;\n");
    let source =
        \\package main;
        \\fn main( )->string{let value=0xFF; // keep
        \\"😀"}
    ;
    change_document(server, uri, source, 2);
    let edits = formatting_result(server, uri);
    testing::assert_eq(edits.len(), 1);
    let edit = edits.get(0);
    match json::field(edit, "newText") {
        Some(value) => match json::as_string(value) {
            Some(value) => testing::assert_eq(
                value,
                \\package main;
                \\
                \\fn main() -> string {
                \\    let value = 0xFF; // keep
                \\    "😀"
                \\}
                \\
                ,
            ),
            None => testing::fail("formatted text must be a string"),
        },
        None => testing::fail("missing formatted text"),
    }
    match json::field(edit, "range") {
        Some(value) => match parse_range(value) {
            Ok(value) => {
                testing::assert_eq(value.start.line, 0);
                testing::assert_eq(value.start.character, 0);
                testing::assert_eq(value.end.line, 2);
                testing::assert_eq(value.end.character, 5)
            },
            Err(error) => testing::fail(error.to_string()),
        },
        None => testing::fail("missing formatting range"),
    }
    match server_document(server, uri) {
        Some(value) => {
            testing::assert_eq(value.version, 2);
            testing::assert_eq(value.text, source)
        },
        None => testing::fail("missing open document"),
    }
}

#[test]
fn returns_no_edits_for_formatted_or_invalid_source() -> () {
    let formatted_server = new_server();
    let formatted_uri = "file:///tmp/formatted.goml";
    formatting_document(
        formatted_server,
        formatted_uri,
        \\package main;
        \\
        \\fn main() -> () {}
        \\
        ,
    );
    testing::assert_eq(formatting_result(formatted_server, formatted_uri).len(), 0);
    let invalid_server = new_server();
    let invalid_uri = "file:///tmp/invalid.goml";
    formatting_document(
        invalid_server,
        invalid_uri,
        \\package main;
        \\fn broken( {
        ,
    );
    testing::assert_eq(formatting_result(invalid_server, invalid_uri).len(), 0)
}

#[test]
fn formats_redundant_unit_tail() -> () {
    let server = new_server();
    let uri = "file:///tmp/redundant-().goml";
    formatting_document(
        server,
        uri,
        \\package main;
        \\
        \\fn main() -> () {
        \\    ()
        \\}
        \\
        ,
    );
    let edits = formatting_result(server, uri);
    testing::assert_eq(edits.len(), 1);
    match json::field(edits.get(0), "newText") {
        Some(value) => match json::as_string(value) {
            Some(value) => testing::assert_eq(
                value,
                \\package main;
                \\
                \\fn main() -> () {}
                \\
                ,
            ),
            None => testing::fail("formatted text must be a string"),
        },
        None => testing::fail("missing formatted text"),
    }
}
