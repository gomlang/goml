package lsp;

use module::formatter;
use std::json;

fn formatting_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let Ok(formatted) = formatter::format_source(document.text) else {
        return Result::Ok(json::Value::Array(Vec::new()))
    };
    if formatted == document.text {
        Result::Ok(json::Value::Array(Vec::new()))
    } else {
        let edit: Vec[(string, json::Value)] = Vec::new();
        push_json_field(
            edit,
            "range",
            range_json(
                offsets_to_range_with_index(document.line_index, 0, document.text.byte_len()),
            ),
        );
        push_json_field(edit, "newText", json::Value::String(formatted));
        Result::Ok(json::Value::Array(Vec::from_array([json::Value::Object(edit)])))
    }
}
