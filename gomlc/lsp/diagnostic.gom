package lsp;

use module::query;
use module::tast;
use std::json;

fn diagnostic_strings(values: Vec[string]) -> json::Value {
    let result: Vec[json::Value] = Vec::new();
    for value in values {
        result.push(json::Value::String(value))
    }
    json::Value::Array(result)
}

fn diagnostic_fix_json(
    server: Server,
    document: Document,
    analysis: query::Analysis,
    fix: tast::DiagnosticFix,
) -> Option[json::Value] {
    let edits: Vec[json::Value] = Vec::new();
    for edit in fix.edits {
        let path = if edit.source_path == "" {
            document.path
        } else {
            edit.source_path
        };
        let source = if path == document.path {
            document.text
        } else {
            source_for_path(analysis, path)?
        };
        let index = source_line_index(server, path, source);
        let fields: Vec[(string, json::Value)] = Vec::new();
        push_json_field(fields, "uri", json::Value::String(path_to_uri(path)));
        push_json_field(
            fields,
            "range",
            range_json(offsets_to_range_with_index(index, edit.span.start, edit.span.end)),
        );
        push_json_field(fields, "replacement", json::Value::String(edit.replacement));
        edits.push(json::Value::Object(fields))
    }
    let fields: Vec[(string, json::Value)] = Vec::new();
    push_json_field(fields, "title", json::Value::String(fix.title));
    push_json_field(
        fields,
        "applicability",
        json::Value::String(tast::fix_applicability_text(fix.applicability)),
    );
    push_json_field(
        fields,
        "preferred",
        json::Value::Bool(
            match fix.applicability {
                MachineApplicable => true,
                RequiresReview => false,
            },
        ),
    );
    push_json_field(fields, "edits", json::Value::Array(edits));
    Option::Some(json::Value::Object(fields))
}

fn diagnostic_data(
    server: Server,
    document: Document,
    analysis: query::Analysis,
    value: tast::Diagnostic,
) -> json::Value {
    let fields: Vec[(string, json::Value)] = Vec::new();
    push_json_field(fields, "uri", json::Value::String(document.uri));
    push_json_field(fields, "version", json::Value::Number(document.version.to_string()));
    push_json_field(fields, "notes", diagnostic_strings(value.notes));
    push_json_field(fields, "help", diagnostic_strings(value.help));
    let fixes: Vec[json::Value] = Vec::new();
    for fix in value.fixes {
        if let Some(encoded) = diagnostic_fix_json(server, document, analysis, fix) {
            fixes.push(encoded)
        }
    }
    push_json_field(fields, "fixes", json::Value::Array(fixes));
    json::Value::Object(fields)
}

fn diagnostic_version_matches(server: Server, data: json::Value) -> bool {
    let Some(version) = json::field(data, "version") else {
        return true
    };
    let Some(uri) = json::field(data, "uri") else {
        return false
    };
    let Some(uri) = json::as_string(uri) else {
        return false
    };
    let Some(document) = server_document(server, uri) else {
        return false
    };
    json::as_int(version) == Option::Some(document.version)
}

fn fix_changes(fix: json::Value) -> Option[Vec[(string, json::Value)]] {
    let edits = match json::field(fix, "edits") {
        Some(Array(edits)) => edits,
        Some(_) => return Option::None,
        None => Vec::from_array([fix]),
    };
    if edits.is_empty() {
        return Option::None
    }
    let changes: Vec[(string, json::Value)] = Vec::new();
    for edit in edits {
        let uri = json::as_string(json::field(edit, "uri")?)?;
        let range = json::field(edit, "range")?;
        let replacement = json::as_string(json::field(edit, "replacement")?)?;
        let fields: Vec[(string, json::Value)] = Vec::new();
        push_json_field(fields, "range", range);
        push_json_field(fields, "newText", json::Value::String(replacement));
        let encoded = json::Value::Object(fields);
        let mut found = false;
        for change in changes {
            if change.0 == uri {
                if let Array(values) = change.1 {
                    values.push(encoded);
                    found = true;
                }
            }
        }
        if !found {
            changes.push((uri, json::Value::Array(Vec::from_array([encoded]))))
        }
    }
    Option::Some(changes)
}
