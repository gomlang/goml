package lsp;

use module::query;
use module::tast;
use std::json;
use json::Serialize;

#[derive(Serialize)]
struct DiagnosticEditOutput {
    uri: string,
    range: Range,
    replacement: string,
}

#[derive(Serialize)]
struct DiagnosticFixOutput {
    title: string,
    applicability: string,
    preferred: bool,
    edits: Vec[DiagnosticEditOutput],
}

#[derive(Serialize)]
struct DiagnosticDataOutput {
    uri: string,
    version: isize,
    notes: Vec[string],
    help: Vec[string],
    fixes: Vec[DiagnosticFixOutput],
}

#[derive(Serialize)]
struct DiagnosticLocationOutput {
    uri: string,
    range: Range,
}

#[derive(Serialize)]
struct DiagnosticRelatedOutput {
    location: DiagnosticLocationOutput,
    message: string,
}

#[derive(Serialize)]
struct DiagnosticOutput {
    range: Range,
    severity: isize,
    source: string,
    message: string,
    #[serde(skip_serializing_if = "Option::is_none")]
    code: Option[string],
    data: DiagnosticDataOutput,
    #[serde(rename = "relatedInformation", skip_serializing_if = "Vec::is_empty")]
    related: Vec[DiagnosticRelatedOutput],
}

fn diagnostic_fix_output(
    server: Server,
    document: Document,
    analysis: query::Analysis,
    fix: tast::DiagnosticFix,
) -> Option[DiagnosticFixOutput] {
    let edits = Vec::new();
    for edit in fix.edits {
        let path = if edit.source_path == "" {
            document.path
        } else {
            edit.source_path
        };
        let source = if path == document.path {
            document.text
        } else {
            source_for_path(analysis, path)?
        };
        let index = source_line_index(server, path, source);
        edits.push(
            DiagnosticEditOutput {
                uri: path_to_uri(path),
                range: offsets_to_range_with_index(index, edit.span.start, edit.span.end),
                replacement: edit.replacement,
            },
        )
    }
    Some(
        DiagnosticFixOutput {
            title: fix.title,
            applicability: tast::fix_applicability_text(fix.applicability),
            preferred: match fix.applicability {
                MachineApplicable => true,
                RequiresReview => false,
            },
            edits,
        },
    )
}

fn diagnostic_data(
    server: Server,
    document: Document,
    analysis: query::Analysis,
    value: tast::Diagnostic,
) -> DiagnosticDataOutput {
    let fixes = Vec::new();
    for fix in value.fixes {
        if let Some(encoded) = diagnostic_fix_output(server, document, analysis, fix) {
            fixes.push(encoded)
        }
    }
    DiagnosticDataOutput {
        uri: document.uri,
        version: document.version,
        notes: value.notes,
        help: value.help,
        fixes,
    }
}

fn diagnostic_version_matches(server: Server, data: json::Value) -> bool {
    let Some(version) = json::field(data, "version") else {
        return true
    };
    let Some(uri) = json::field(data, "uri") else {
        return false
    };
    let Some(uri) = json::as_string(uri) else {
        return false
    };
    let Some(document) = server_document(server, uri) else {
        return false
    };
    json::as_int(version) == Option::Some(document.version)
}

fn fix_changes(fix: json::Value) -> Option[Vec[(string, json::Value)]] {
    let edits = match json::field(fix, "edits") {
        Some(Array(edits)) => edits,
        Some(_) => return Option::None,
        None => Vec::from_array([fix]),
    };
    if edits.is_empty() {
        return Option::None
    }
    let changes: Vec[(string, json::Value)] = Vec::new();
    for edit in edits {
        let uri = json::as_string(json::field(edit, "uri")?)?;
        let range = json::field(edit, "range")?;
        let replacement = json::as_string(json::field(edit, "replacement")?)?;
        let fields: Vec[(string, json::Value)] = Vec::new();
        push_json_field(fields, "range", range);
        push_json_field(fields, "newText", json::Value::String(replacement));
        let encoded = json::Value::Object(fields);
        let mut found = false;
        for change in changes {
            if change.0 == uri {
                if let Array(values) = change.1 {
                    values.push(encoded);
                    found = true;
                }
            }
        }
        if !found {
            changes.push((uri, json::Value::Array(Vec::from_array([encoded]))))
        }
    }
    Option::Some(changes)
}
