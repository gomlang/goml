package lsp;

use module::query;
use module::checker;
use std::fs;
use std::json;
use std::testing;

#[test]
fn opaque_external_type_diagnostics_follow_unsaved_documents() -> () {
    let root = "/tmp/gomllsp-external-types";
    if let Err(error) = fs::create_dir_all(root + "/native") {
        testing::fail(error.to_string())
    }
    for (name, source) in Vec::from_array(
        [
            ("goml.toml", "[module]\npath = \"example::editor\"\n"),
            ("go.mod", "module example.com/editor\n\ngo 1.26\n"),
            ("native/types.go", "package native\ntype Number = int64\n"),
        ],
    ) {
        if let Err(error) = fs::write_file_structured(root + "/" + name, source) {
            testing::fail(error.to_string())
        }
    }
    let server = new_server();
    let source = "package editor; #[go_type(\"example.com/editor/native\", \"Number\")] extern type Number; pub fn echo(value: Number) -> Number { value }";
    let uri = "file://" + root + "/main.goml";
    let document = Document {
        uri,
        path: root + "/main.goml",
        text: source,
        version: 1,
        line_index: line_index(source),
    };
    open_document(server, document);
    testing::assert(
        !checker::diagnostics_have_errors(query::diagnostics(document_analysis(server, document))),
    );
    let invalid = source + " pub fn bad(value: bool) -> Number { value }";
    change_document(server, uri, invalid, 2);
    let current = server_document(server, uri).unwrap_or(document);
    testing::assert(
        checker::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    change_document(server, uri, source, 3);
    let current = server_document(server, uri).unwrap_or(document);
    testing::assert(
        !checker::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    if let Err(error) = fs::write_file_structured(
        root + "/native/types.go",
        "package native\ntype Number = bool\n",
    ) {
        testing::fail(error.to_string())
    }
    let changes = json::object(
        Vec::from_array(
            [
                (
                    "changes",
                    Array(
                        Vec::from_array(
                            [
                                json::object(
                                    Vec::from_array(
                                        [
                                            ("uri", String("file://" + root + "/native/types.go")),
                                            ("type", json::Value::Number("2")),
                                        ],
                                    ),
                                ),
                            ],
                        ),
                    ),
                ),
            ],
        ),
    );
    if let Err(error) = did_change_watched_files(server, changes) {
        testing::fail(error)
    }
    testing::assert(
        !checker::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    let invalid = source + " pub fn field(value: Number) -> i64 { value.Value }";
    change_document(server, uri, invalid, 4);
    let current = server_document(server, uri).unwrap_or(document);
    let mut diagnosed = false;
    for diagnostic in query::diagnostics(document_analysis(server, current)) {
        if diagnostic.message.contains("opaque external Go type") {
            testing::assert_eq(diagnostic.source_path, document.path);
            testing::assert(diagnostic.span.is_some());
            diagnosed = true;
        }
    }
    testing::assert(diagnosed);
    let _ = fs::remove_dir_all(root);
}
