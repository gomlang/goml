package lsp;

use std::text as text_index;
use std::json;
use json::Serialize;

#[derive(Serialize)]
pub struct Position {
    pub line: isize,
    pub character: isize,
}

#[derive(Serialize)]
pub struct Range {
    pub start: Position,
    pub end: Position,
}

pub fn line_index(source: string) -> text_index::LineIndex {
    text_index::LineIndex::new(source)
}

pub fn offset_to_position_with_index(index: text_index::LineIndex, offset: isize) -> Position {
    let position = index.offset_to_line_column(offset, text_index::PositionEncoding::Utf16);
    Position { line: position.line, character: position.column }
}

pub fn position_to_offset_with_index(index: text_index::LineIndex, position: Position) -> isize {
    index.line_column_to_offset(
        text_index::LineColumn { line: position.line, column: position.character },
        text_index::PositionEncoding::Utf16,
    )
}

pub fn position_to_offset_checked_with_index(index: text_index::LineIndex, position: Position) -> Option[
    isize,
] {
    index.line_column_to_offset_checked(
        text_index::LineColumn { line: position.line, column: position.character },
        text_index::PositionEncoding::Utf16,
    )
}

pub fn offsets_to_range_with_index(index: text_index::LineIndex, start: isize, end: isize) -> Range {
    Range {
        start: offset_to_position_with_index(index, start),
        end: offset_to_position_with_index(index, end),
    }
}

pub fn offset_to_position(source: string, offset: isize) -> Position {
    offset_to_position_with_index(line_index(source), offset)
}

pub fn position_to_offset(source: string, position: Position) -> isize {
    position_to_offset_with_index(line_index(source), position)
}

pub fn position_to_offset_checked(source: string, position: Position) -> Option[isize] {
    position_to_offset_checked_with_index(line_index(source), position)
}

pub fn offsets_to_range(source: string, start: isize, end: isize) -> Range {
    offsets_to_range_with_index(line_index(source), start, end)
}
