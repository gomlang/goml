#[test]
fn publishes_recovered_parser_diagnostics_at_utf16_positions() -> () {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/recovery.goml\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> () {\\r\\n    let text = \\\"中\\\"\\r\\n    println(text);\\r\\n}\\r\\n\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            let encoded = json::encode(messages.get(0));
            testing::assert(encoded.contains("expect \\\";\\\""));
            testing::assert(
                encoded.contains(
                    "\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":18}",
                ),
            );
            testing::assert(!encoded.contains("Unknown value text"))
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn publishes_unreachable_code_as_a_warning() -> () {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/unreachable.goml\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> () {\\n    return;\\n    println(\\\"dead\\\")\\n}\\n\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            let encoded = json::encode(messages[0]);
            testing::assert(encoded.contains("unreachable_code: unreachable code"));
            testing::assert(encoded.contains("\"severity\":2"))
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn publishes_unused_function_as_a_warning() -> () {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/unused.goml\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn dead() -> () {}\\nfn main() -> () {}\\n\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            let encoded = json::encode(messages[0]);
            testing::assert(encoded.contains("unused_function: function dead is never used"));
            testing::assert(encoded.contains("\"severity\":2"));
            testing::assert(
                encoded.contains(
                    "\"start\":{\"line\":0,\"character\":3},\"end\":{\"line\":0,\"character\":7}",
                ),
            )
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn publishes_unused_result_as_a_warning() -> () {
    let server = new_server();
    let open = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file:///tmp/unused-result.goml\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> () {\\n    let value: Result[(), string] = Err(\\\"failed\\\");\\n    value;\\n}\\n\"}}}";
    match handle_payload(server, open) {
        Ok(messages) => {
            testing::assert_eq(messages.len(), 1);
            let encoded = json::encode(messages[0]);
            testing::assert(encoded.contains("\"code\":\"unused_result\""));
            testing::assert(encoded.contains("let _ = ..."));
            testing::assert(encoded.contains("\"severity\":2"));
            testing::assert(
                encoded.contains(
                    "\"start\":{\"line\":2,\"character\":4},\"end\":{\"line\":2,\"character\":9}",
                ),
            );
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn rejects_legacy_source_documents() -> () {
    let server = new_server();
    let params = testing::expect_ok(
        json::parse(
            "{\"textDocument\":{\"uri\":\"file:///tmp/legacy.gom\",\"languageId\":\"goml\",\"version\":1,\"text\":\"fn main() -> () {}\"}}",
        ),
        "legacy document params",
    );
    let error = testing::expect_err(did_open(server, params), "legacy document rejection");
    testing::assert_eq(error, "source file must use the .goml extension: /tmp/legacy.gom");
    testing::assert(server_document(server, "file:///tmp/legacy.gom").is_none());
}
