package lsp;

use std::bytes;
use std::io;
use std::testing;

#[test]
fn rpc_payload_preserves_io_cause_after_partial_header() -> () {
    let calls = Ref::new(0);
    let cause = io::Error::new(
        io::ErrorKind::PermissionDenied,
        "read",
        Some("pipe"),
        Some(13),
        "denied",
    );
    let result = read_payload(
        |_: isize| {
            calls.set(calls.get() + 1);
            if calls.get() == 1 {
                Ok(bytes::Bytes::from_string("C"))
            } else {
                Err(cause)
            }
        },
    );
    let report = testing::expect_err(result, "expected I/O failure");
    let found = testing::expect_some(
        report.find_map(
            |value| match value {
                Io(value) => Some(value),
                _ => None,
            },
        ),
        "expected typed cause",
    );
    testing::assert(found.kind() == io::ErrorKind::PermissionDenied);
    testing::assert(found.raw_os_code() == Option::Some(13));
    testing::assert(found.context() == Option::Some("pipe"));
    testing::assert_eq(calls.get(), 2);
}

#[test]
fn rpc_payload_reads_framed_utf8_and_preserves_protocol_failures() -> () {
    let input = "Content-Length: 2\r\n\r\n{}";
    let offset = Ref::new(0);
    let result = read_payload(
        |length: isize| {
            let start = offset.get();
            offset.set(start + length);
            Ok(bytes::Bytes::from_string(input.byte_slice(start, start + length)))
        },
    );
    testing::assert_eq(testing::expect_ok(result, "valid frame"), "{}");
    testing::assert_eq(offset.get(), input.byte_len());
    let input = "Content-Length: 0\r\nContent-Length: 0\r\n";
    let offset = Ref::new(0);
    let result = read_payload(
        |length: isize| {
            let start = offset.get();
            offset.set(start + length);
            Ok(bytes::Bytes::from_string(input.byte_slice(start, start + length)))
        },
    );
    let report = testing::expect_err(result, "duplicate header");
    testing::assert(
        report.find_map(
            |value| match value {
                Protocol(message) => Some(message),
                _ => None,
            },
        )
            == Option::Some("duplicate Content-Length header"),
    );
}
