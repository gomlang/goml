package lsp;

use std::json;
use std::testing;

fn inlay_test_string(value: json::Value, name: string) -> string {
    let field = testing::expect_some(json::field(value, name), "expected inlay hint field " + name);
    testing::expect_some(json::as_string(field), "expected plain string inlay hint field " + name)
}

#[test]
fn inlay_response_sends_compact_labels_with_complete_plain_text_tooltips() -> () {
    let server = new_server();
    let name = "AnUnusuallyLongNominalTypeForInlayHints";
    let source = "struct " + name + " {} fn main() -> () { let value = " + name
        + " {}; let number = 1; () }";
    let document = Document {
        uri: "file:///tmp/gomllsp-inlay-tooltip.goml",
        path: "/tmp/gomllsp-inlay-tooltip.goml",
        text: source,
        version: 1,
        line_index: line_index(source),
    };
    open_document(server, document);
    let params = json::Value::Object(
        Vec::from_array(
            [
                (
                    "textDocument",
                    Object(Vec::from_array([("uri", json::Value::String(document.uri))])),
                ),
                (
                    "range",
                    range_json(
                        Range {
                            start: Position { line: 0, character: 0 },
                            end: Position { line: 0, character: source.byte_len() },
                        },
                    ),
                ),
            ],
        ),
    );
    let result = testing::expect_ok(inlay_response(server, params), "expected inlay hint response");
    let hints = testing::expect_some(json::as_array(result), "expected inlay hint array");
    testing::assert_eq(hints.len(), 2);
    let found_long = Ref::new(false);
    let found_short = Ref::new(false);
    for hint in hints {
        let tooltip = inlay_test_string(hint, "tooltip");
        let label = inlay_test_string(hint, "label");
        if tooltip == name {
            found_long.set(true);
            testing::assert(label.starts_with(": "));
            testing::assert(label.contains("…"));
            let mut characters = 0;
            for _ in label.chars() {
                characters += 1;
            }
            testing::assert(characters <= 27);
        } else if tooltip == "isize" {
            found_short.set(true);
            testing::assert_eq(label, ": isize");
        } else {
            testing::fail("unexpected inlay tooltip: " + tooltip)
        }
    }
    testing::assert(found_long.get());
    testing::assert(found_short.get());
}
