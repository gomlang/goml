package lsp;

use std::json;
use std::testing;

fn diagnostic_test_field(value: json::Value, name: string) -> json::Value {
    testing::expect_some(json::field(value, name), "expected " + name)
}

fn diagnostic_test_actions(server: Server, diagnostic: json::Value) -> json::Value {
    let context = json::Value::Object(
        Vec::from_array([("diagnostics", json::Value::Array(Vec::from_array([diagnostic])))]),
    );
    testing::expect_ok(
        code_action_response(server, json::Value::Object(Vec::from_array([("context", context)]))),
        "expected code actions",
    )
}

#[test]
fn structured_diagnostic_lsp_publishes_and_applies_multiple_edits() -> () {
    let server = new_server();
    let uri = "file:///tmp/formatting.gom";
    let source = "pub fn run(value: Result[(), string]) -> () { let text = \"😀\"; if true { value } else { value } let _ = (); }";
    formatting_document(server, uri, source);
    let document = testing::expect_some(server_document(server, uri), "expected document");
    let params = diagnostic_test_field(publish_diagnostics(server, document), "params");
    let diagnostics = testing::expect_some(
        json::as_array(diagnostic_test_field(params, "diagnostics")),
        "expected diagnostics",
    );
    testing::assert_eq(diagnostics.len(), 1);
    let diagnostic = diagnostics[0];
    testing::assert(
        json::as_string(diagnostic_test_field(diagnostic, "code")) == Option::Some("unused_result"),
    );
    let actions = testing::expect_some(
        json::as_array(diagnostic_test_actions(server, diagnostic)),
        "expected quick fix",
    );
    testing::assert_eq(actions.len(), 1);
    testing::assert(
        json::as_bool(diagnostic_test_field(actions[0], "isPreferred")) == Option::Some(false),
    );
    let changes = diagnostic_test_field(diagnostic_test_field(actions[0], "edit"), "changes");
    let edits = testing::expect_some(
        json::as_array(diagnostic_test_field(changes, uri)),
        "expected edits",
    );
    testing::assert_eq(edits.len(), 2);
    let mut fixed = source;
    let mut cursor = edits.len() - 1;
    while cursor >= 0 {
        let edit = edits[cursor];
        let range = diagnostic_test_field(edit, "range");
        let start = testing::expect_ok(
            parse_position(diagnostic_test_field(range, "start")),
            "expected position",
        );
        let end = testing::expect_ok(
            parse_position(diagnostic_test_field(range, "end")),
            "expected position",
        );
        let start = testing::expect_some(
            position_to_offset_checked_with_index(document.line_index, start),
            "expected offset",
        );
        let end = testing::expect_some(
            position_to_offset_checked_with_index(document.line_index, end),
            "expected offset",
        );
        let replacement = testing::expect_some(
            json::as_string(diagnostic_test_field(edit, "newText")),
            "expected replacement",
        );
        fixed = fixed.byte_slice(0, start) + replacement + fixed.byte_slice(end, fixed.byte_len());
        cursor -= 1;
    }
    testing::assert(fixed.contains("let _ = if true { value } else { value }"));
    change_document(server, uri, fixed, 2);
    testing::assert_eq(json::encode(diagnostic_test_actions(server, diagnostic)), "null");
    let updated = testing::expect_some(server_document(server, uri), "expected updated document");
    let params = diagnostic_test_field(publish_diagnostics(server, updated), "params");
    testing::assert_eq(
        testing::expect_some(
            json::as_array(diagnostic_test_field(params, "diagnostics")),
            "expected diagnostics",
        ).len(),
        0,
    );
}

#[test]
fn structured_diagnostic_lsp_try_code_and_related_return_location() -> () {
    let server = new_server();
    let uri = "file:///tmp/formatting.gom";
    let source = "pub fn run(value: Result[i32, string]) -> Result[i32, i32] { Ok(value?) }";
    formatting_document(server, uri, source);
    let document = testing::expect_some(server_document(server, uri), "expected document");
    let params = diagnostic_test_field(publish_diagnostics(server, document), "params");
    let diagnostics = testing::expect_some(
        json::as_array(diagnostic_test_field(params, "diagnostics")),
        "expected diagnostics",
    );
    testing::assert_eq(diagnostics.len(), 1);
    let diagnostic = diagnostics[0];
    testing::assert(
        json::as_string(diagnostic_test_field(diagnostic, "code"))
            == Option::Some("try_error_mismatch"),
    );
    let message = testing::expect_some(
        json::as_string(diagnostic_test_field(diagnostic, "message")),
        "expected message",
    );
    testing::assert(message.contains("map_err"));
    let related = testing::expect_some(
        json::as_array(diagnostic_test_field(diagnostic, "relatedInformation")),
        "expected return location",
    );
    testing::assert_eq(related.len(), 1);
    let data = diagnostic_test_field(diagnostic, "data");
    testing::assert_eq(
        testing::expect_some(json::as_array(diagnostic_test_field(data, "notes")), "expected notes").len(),
        1,
    );
    testing::assert_eq(json::encode(diagnostic_test_actions(server, diagnostic)), "null");
}
