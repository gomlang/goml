package lsp;

use std::json;
use std::testing;

fn validation_document(server: Server) -> Document {
    let document = Document {
        uri: "file:///tmp/gomllsp-document-validation.goml",
        path: "/tmp/gomllsp-document-validation.goml",
        text: "current 😀",
        version: 2,
        line_index: line_index("current 😀"),
    };
    open_document(server, document);
    document
}

fn document_change_params(document: Document, version: json::Value, changes: string) -> json::Value {
    json::Value::Object(
        Vec::from_array(
            [
                (
                    "textDocument",
                    json::Value::Object(
                        Vec::from_array(
                            [("uri", json::Value::String(document.uri)), ("version", version)],
                        ),
                    ),
                ),
                ("contentChanges", protocol_test_json(changes)),
            ],
        ),
    )
}

#[test]
fn document_changes_validate_full_replacements_before_mutating_state() -> () {
    let server = new_server();
    let document = validation_document(server);
    for changes in Vec::from_array(
        [
            "[]",
            "[{}]",
            "[{\"text\":\"next\"},{}]",
            "[{}, {\"text\":\"next\"}]",
            "[{\"text\":\"partial\",\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}}}]",
            "[{\"text\":\"partial\",\"rangeLength\":1}]",
        ],
    ) {
        testing::assert(
            did_change(server, document_change_params(document, json::Value::Number("3"), changes)).is_err(),
        );
        let current = testing::expect_some(server_document(server, document.uri), "open document");
        testing::assert_eq(current.text, document.text);
        testing::assert_eq(current.version, document.version);
    }
    testing::assert(
        did_change(
            server,
            document_change_params(document, json::Value::String("3"), "[{\"text\":\"next\"}]"),
        ).is_err(),
    );
    testing::expect_ok(
        did_change(
            server,
            document_change_params(
                document,
                json::Value::Number("3"),
                "[{\"text\":\"first\"},{\"text\":\"last\"}]",
            ),
        ),
        "full replacements",
    );
    let current = testing::expect_some(server_document(server, document.uri), "changed document");
    testing::assert_eq(current.text, "last");
    testing::assert_eq(current.version, 3);
}

#[test]
fn document_versions_do_not_regress_or_invalidate_analyses_for_stale_edits() -> () {
    let server = new_server();
    let document = validation_document(server);
    let generation = server.generation.get();
    for version in Vec::from_array([1, 2]) {
        change_document(server, document.uri, "stale", version);
        let current = testing::expect_some(server_document(server, document.uri), "open document");
        testing::assert_eq(current.text, document.text);
        testing::assert_eq(current.version, 2);
        testing::assert_eq(server.generation.get(), generation);
        testing::assert_eq(
            position_to_offset_with_index(current.line_index, Position { line: 0, character: 10 }),
            document.text.byte_len(),
        );
    }
    change_document(server, document.uri, "new", 3);
    testing::assert_eq(server.generation.get(), generation + 1);
    let current = testing::expect_some(server_document(server, document.uri), "changed document");
    testing::assert_eq(current.text, "new");
    testing::assert_eq(
        position_to_offset_with_index(current.line_index, Position { line: 0, character: 3 }),
        3,
    );
}
