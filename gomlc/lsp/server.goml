package lsp;

use gomlang::toolchain_manifest as source_files;
use module::ast;
use module::query;
use module::tast;
use module::version;
use std::collections;
use std::fs;
use std::json;
use std::text;

const INITIALIZE_METHOD: string = "initialize";

const SHUTDOWN_METHOD: string = "shutdown";

const EXIT_METHOD: string = "exit";

const INITIALIZED_METHOD: string = "initialized";

const HOVER_METHOD: string = "textDocument/hover";

const EXPANDED_DERIVE_METHOD: string = "goml/expandedDerive";

const COMPLETION_METHOD: string = "textDocument/completion";

const SIGNATURE_HELP_METHOD: string = "textDocument/signatureHelp";

const INLAY_HINT_METHOD: string = "textDocument/inlayHint";

const DEFINITION_METHOD: string = "textDocument/definition";

const CODE_LENS_METHOD: string = "textDocument/codeLens";

const CODE_ACTION_METHOD: string = "textDocument/codeAction";

const FORMATTING_METHOD: string = "textDocument/formatting";

const DID_OPEN_METHOD: string = "textDocument/didOpen";

const DID_CHANGE_METHOD: string = "textDocument/didChange";

const DID_CLOSE_METHOD: string = "textDocument/didClose";

const DID_SAVE_METHOD: string = "textDocument/didSave";

const DID_CHANGE_WATCHED_FILES_METHOD: string = "workspace/didChangeWatchedFiles";

const PUBLISH_DIAGNOSTICS_METHOD: string = "textDocument/publishDiagnostics";

const STATUS_METHOD: string = "goml/status";

const CHECK_DIAGNOSTICS_METHOD: string = "goml/checkDiagnostics";

fn required_field(value: json::Value, name: string) -> Result[json::Value, string] {
    json::field(value, name).ok_or("missing field " + name)
}

fn required_string_field(value: json::Value, name: string) -> Result[string, string] {
    json::as_string(required_field(value, name)?).ok_or("field " + name + " must be a string")
}

fn optional_int_field(value: json::Value, name: string, fallback: isize) -> isize {
    match json::field(value, name) {
        Some(field) => json::as_int(field).unwrap_or(fallback),
        None => fallback,
    }
}

fn text_document(value: json::Value) -> Result[json::Value, string] {
    required_field(value, "textDocument")
}

fn text_document_uri(value: json::Value) -> Result[string, string] {
    text_document(value).and_then(|document| required_string_field(document, "uri"))
}

fn request_document(server: Server, params: json::Value) -> Result[Document, string] {
    let uri = text_document_uri(params)?;
    server_document(server, uri).ok_or("document is not open: " + uri)
}

fn request_position(params: json::Value) -> Result[Position, string] {
    required_field(params, "position").and_then(|position| parse_position(position))
}

fn request_offset(document: Document, position: Position) -> Result[isize, string] {
    position_to_offset_checked_with_index(document.line_index, position).ok_or(
        "position is outside the document",
    )
}

fn initialize_result() -> json::Value {
    let triggers: Vec[json::Value] = Vec::new();
    triggers.push(json::Value::String("."));
    triggers.push(json::Value::String(":"));
    let completion: Vec[(string, json::Value)] = Vec::new();
    push_json_field(completion, "triggerCharacters", json::Value::Array(triggers));
    push_json_field(completion, "resolveProvider", json::Value::Bool(false));
    let signature_triggers: Vec[json::Value] = Vec::new();
    signature_triggers.push(json::Value::String("("));
    signature_triggers.push(json::Value::String(","));
    let retriggers: Vec[json::Value] = Vec::new();
    retriggers.push(json::Value::String(","));
    let signature: Vec[(string, json::Value)] = Vec::new();
    push_json_field(signature, "triggerCharacters", json::Value::Array(signature_triggers));
    push_json_field(signature, "retriggerCharacters", json::Value::Array(retriggers));
    let capabilities: Vec[(string, json::Value)] = Vec::new();
    push_json_field(capabilities, "positionEncoding", json::Value::String("utf-16"));
    push_json_field(capabilities, "textDocumentSync", json::Value::Number("1"));
    push_json_field(capabilities, "hoverProvider", json::Value::Bool(true));
    push_json_field(capabilities, "completionProvider", json::Value::Object(completion));
    push_json_field(capabilities, "signatureHelpProvider", json::Value::Object(signature));
    push_json_field(capabilities, "inlayHintProvider", json::Value::Bool(true));
    push_json_field(capabilities, "definitionProvider", json::Value::Bool(true));
    let code_lens: Vec[(string, json::Value)] = Vec::new();
    push_json_field(code_lens, "resolveProvider", json::Value::Bool(false));
    push_json_field(capabilities, "codeLensProvider", json::Value::Object(code_lens));
    push_json_field(capabilities, "codeActionProvider", json::Value::Bool(true));
    push_json_field(capabilities, "documentFormattingProvider", json::Value::Bool(true));
    let experimental: Vec[(string, json::Value)] = Vec::new();
    push_json_field(experimental, "expandedDerive", json::Value::Bool(true));
    push_json_field(capabilities, "experimental", json::Value::Object(experimental));
    let server_info: Vec[(string, json::Value)] = Vec::new();
    push_json_field(server_info, "name", json::Value::String("gomllsp"));
    push_json_field(server_info, "version", json::Value::String(version::current()));
    let result: Vec[(string, json::Value)] = Vec::new();
    push_json_field(result, "capabilities", json::Value::Object(capabilities));
    push_json_field(result, "serverInfo", json::Value::Object(server_info));
    json::Value::Object(result)
}

fn source_for_path(analysis: query::Analysis, source_path: string) -> Option[string] {
    let mut index = analysis.sources.len() - 1;
    while index >= 0 {
        let source = analysis.sources[index];
        if source.path == source_path {
            return Option::Some(source.source)
        } else {
            index -= 1;
        }
    }
    match fs::read_file_structured(source_path) {
        Ok(source) => Option::Some(source),
        Err(_) => Option::None,
    }
}

fn diagnostic_text(value: tast::Diagnostic) -> string {
    let message = match value.primary_label {
        Some(label) => value.message + "\n" + label,
        None => value.message,
    };
    message + tast::diagnostic_guidance(value)
}

fn diagnostic_contains_offset(value: tast::Diagnostic, source_path: string, offset: isize) -> bool {
    (value.source_path == "" || value.source_path == source_path)
        && match value.span {
            Some(span) => if span.start == span.end {
                offset == span.start
            } else {
                span.start <= offset && offset < span.end
            },
            None => offset == 0,
        }
}

fn join_strings(values: Vec[string], separator: string) -> string {
    text::join(values, separator)
}

fn hover_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let position = request_position(params)?;
    let analysis = document_analysis(server, document);
    let offset = request_offset(document, position)?;
    let sections: Vec[string] = Vec::new();
    if let Some(hover) = query::hover(analysis, offset) {
        sections.push("```goml\n" + hover.contents + "\n```")
    }
    let diagnostic_lines = collections::IndexSet::new();
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic_contains_offset(diagnostic, document.path, offset) {
            let line = match diagnostic.severity {
                Error => "- ",
                Warning => "+ ",
            }
                + diagnostic_text(diagnostic);
            let _ = diagnostic_lines.insert(line);
        }
    }
    if !diagnostic_lines.is_empty() {
        sections.push(
            "**Diagnostics**\n```diff\n" + join_strings(diagnostic_lines.to_vec(), "\n") + "\n```",
        )
    }
    if sections.is_empty() {
        Result::Ok(json::Value::Null)
    } else {
        let contents: Vec[(string, json::Value)] = Vec::new();
        push_json_field(contents, "kind", json::Value::String("markdown"));
        push_json_field(contents, "value", json::Value::String(join_strings(sections, "\n\n")));
        let result: Vec[(string, json::Value)] = Vec::new();
        push_json_field(result, "contents", json::Value::Object(contents));
        Result::Ok(json::Value::Object(result))
    }
}

fn expanded_derive_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let analysis = document_analysis(server, document);
    Result::Ok(json::Value::String(query::expanded_derive(analysis)))
}

fn completion_kind(value: query::CompletionKind) -> isize {
    match value {
        Package => 9,
        Method => 2,
        Function => 3,
        Field => 5,
        Variable => 6,
        Keyword => 14,
        Trait => 8,
        Enum => 13,
        Variant => 20,
        Struct => 22,
    }
}

fn completion_snippet(value: query::CompletionItem) -> Option[string] {
    match value.kind {
        query::CompletionKind::Keyword => match value.label {
            "select" => Option::Some(
                \\select {
                \\    ${1:recv(channel) as value => value},
                \\}
                ,
            ),
            "priority" => Option::Some(
                \\priority {
                \\    ${1:recv(channel) as value => value},
                \\    default => ${2:value},
                \\}
                ,
            ),
            "recv" => Option::Some("recv(${1:channel}) as ${2:value} => ${3:body}"),
            "send" => Option::Some("send(${1:channel}, ${2:value}) => ${3:body}"),
            "default" => Option::Some("default => ${1:body}"),
            "when" => Option::Some("when ${1:condition}"),
            "as" => Option::Some("as ${1:value} => ${2:body}"),
            "match" => Option::Some(
                \\match {
                \\    ${1:Some(value) => value},
                \\    ${2:None => value},
                \\}
                ,
            ),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn completion_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let position = request_position(params)?;
    let offset = request_offset(document, position)?;
    let items = match cached_document_analysis(server, document) {
        Some(analysis) => if analysis.source == document.text {
            query::completions(analysis, offset)
        } else {
            query::cached_completions(analysis, document.text, offset)
        },
        None => query::completions(document_analysis(server, document), offset),
    };
    let result: Vec[json::Value] = Vec::new();
    for item in items {
        let fields: Vec[(string, json::Value)] = Vec::new();
        push_json_field(fields, "label", json::Value::String(item.label));
        push_json_field(fields, "detail", json::Value::String(item.detail));
        push_json_field(fields, "kind", json::Value::Number(completion_kind(item.kind).to_string()));
        if let Some(value) = completion_snippet(item) {
            push_json_field(fields, "insertText", json::Value::String(value));
            push_json_field(fields, "insertTextFormat", json::Value::Number("2"))
        }
        result.push(json::Value::Object(fields))
    }
    Result::Ok(json::Value::Array(result))
}

fn signature_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let position = request_position(params)?;
    let analysis = document_analysis(server, document);
    let offset = request_offset(document, position)?;
    match query::signature_help(analysis, offset) {
        Some(signature) => {
            let parameters: Vec[json::Value] = Vec::new();
            for parameter in signature.parameters {
                let fields: Vec[(string, json::Value)] = Vec::new();
                push_json_field(fields, "label", json::Value::String(parameter));
                parameters.push(json::Value::Object(fields))
            }
            let item: Vec[(string, json::Value)] = Vec::new();
            push_json_field(item, "label", json::Value::String(signature.label));
            push_json_field(item, "parameters", json::Value::Array(parameters));
            let signatures: Vec[json::Value] = Vec::new();
            signatures.push(json::Value::Object(item));
            let result: Vec[(string, json::Value)] = Vec::new();
            push_json_field(result, "signatures", json::Value::Array(signatures));
            push_json_field(result, "activeSignature", json::Value::Number("0"));
            push_json_field(
                result,
                "activeParameter",
                json::Value::Number(signature.active_parameter.to_string()),
            );
            Result::Ok(json::Value::Object(result))
        },
        None => Result::Ok(json::Value::Null),
    }
}

fn inlay_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let requested_range = parse_range(required_field(params, "range")?)?;
    let range_start = request_offset(document, requested_range.start)?;
    let range_end = request_offset(document, requested_range.end)?;
    let analysis = document_analysis(server, document);
    let result: Vec[json::Value] = Vec::new();
    for hint in query::inlay_hints_in_range(analysis, range_start, range_end) {
        let mut position = hint.position;
        while position > 0
            && (document.text.byte_get(position - 1) == b' '
                || document.text.byte_get(position - 1) == b'\t') {
            position -= 1;
        }
        let fields: Vec[(string, json::Value)] = Vec::new();
        push_json_field(
            fields,
            "position",
            position_json(offset_to_position_with_index(document.line_index, position)),
        );
        push_json_field(fields, "label", json::Value::String(hint.label));
        push_json_field(fields, "kind", json::Value::Number("1"));
        push_json_field(fields, "paddingRight", json::Value::Bool(true));
        result.push(json::Value::Object(fields))
    }
    Result::Ok(json::Value::Array(result))
}

fn definition_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let position = request_position(params)?;
    let analysis = document_analysis(server, document);
    let offset = request_offset(document, position)?;
    let locations: Vec[json::Value] = Vec::new();
    for definition in query::goto_definitions(analysis, offset) {
        if let Some(source) = source_for_path(analysis, definition.source_path) {
            let source_index = source_line_index(server, definition.source_path, source);
            let location: Vec[(string, json::Value)] = Vec::new();
            push_json_field(
                location,
                "uri",
                json::Value::String(path_to_uri(definition.source_path)),
            );
            push_json_field(
                location,
                "range",
                range_json(
                    offsets_to_range_with_index(
                        source_index,
                        definition.span.start,
                        definition.span.end,
                    ),
                ),
            );
            locations.push(json::Value::Object(location))
        }
    }
    if locations.is_empty() {
        Result::Ok(json::Value::Null)
    } else if locations.len() == 1 {
        Result::Ok(locations[0])
    } else {
        Result::Ok(json::Value::Array(locations))
    }
}

fn test_kind_name(value: query::TestItemKind) -> string {
    match value {
        Internal => "internal",
        External => "external",
    }
}

fn code_lens_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let document = request_document(server, params)?;
    let result: Vec[json::Value] = Vec::new();
    for item in query::test_items(document.path, document.text) {
        let arguments: Vec[json::Value] = Vec::new();
        arguments.push(json::Value::String(document.uri));
        arguments.push(json::Value::String(item.name));
        arguments.push(json::Value::String(test_kind_name(item.kind)));
        let command: Vec[(string, json::Value)] = Vec::new();
        push_json_field(command, "title", json::Value::String("Run Test"));
        push_json_field(command, "command", json::Value::String("goml.runTest"));
        push_json_field(command, "arguments", json::Value::Array(arguments));
        let lens: Vec[(string, json::Value)] = Vec::new();
        push_json_field(
            lens,
            "range",
            range_json(
                offsets_to_range_with_index(document.line_index, item.span.start, item.span.end),
            ),
        );
        push_json_field(lens, "command", json::Value::Object(command));
        result.push(json::Value::Object(lens))
    }
    Result::Ok(json::Value::Array(result))
}

fn fix_action(diagnostic: json::Value, fix: json::Value) -> Option[json::Value] {
    let changes = fix_changes(fix)?;
    let title = match json::field(fix, "title") {
        Some(value) => json::as_string(value).unwrap_or("Apply suggested fix"),
        None => "Apply suggested fix",
    };
    let preferred = match json::field(fix, "preferred") {
        Some(Bool(value)) => value,
        _ => false,
    };
    let workspace_edit: Vec[(string, json::Value)] = Vec::new();
    push_json_field(workspace_edit, "changes", json::Value::Object(changes));
    let diagnostics: Vec[json::Value] = Vec::new();
    diagnostics.push(diagnostic);
    let action: Vec[(string, json::Value)] = Vec::new();
    push_json_field(action, "title", json::Value::String(title));
    push_json_field(action, "kind", json::Value::String("quickfix"));
    push_json_field(action, "diagnostics", json::Value::Array(diagnostics));
    push_json_field(action, "edit", json::Value::Object(workspace_edit));
    push_json_field(action, "isPreferred", json::Value::Bool(preferred));
    Option::Some(json::Value::Object(action))
}

fn code_action_response(server: Server, params: json::Value) -> Result[json::Value, string] {
    let context = required_field(params, "context")?;
    let Array(diagnostics) = required_field(context, "diagnostics")? else {
        return Result::Err("field diagnostics must be an array");
    };
    let actions: Vec[json::Value] = Vec::new();
    for diagnostic in diagnostics {
        if let Some(data) = json::field(diagnostic, "data") {
            if !diagnostic_version_matches(server, data) {
                continue
            }
            if let Some(Array(fixes)) = json::field(data, "fixes") {
                for fix in fixes {
                    if let Some(action) = fix_action(diagnostic, fix) {
                        actions.push(action)
                    }
                }
            }
        }
    }
    if actions.is_empty() {
        Result::Ok(json::Value::Null)
    } else {
        Result::Ok(json::Value::Array(actions))
    }
}

fn diagnostic_severity(value: tast::DiagnosticSeverity) -> isize {
    match value {
        Error => 1,
        Warning => 2,
    }
}

fn diagnostic_json(
    server: Server,
    document: Document,
    analysis: query::Analysis,
    value: tast::Diagnostic,
) -> json::Value {
    let span = value.span.unwrap_or_else(|| ast::span(0, 0));
    let related = Vec::new();
    for label in value.secondary_labels {
        if let Some(source) = source_for_path(analysis, label.source_path) {
            let index = source_line_index(server, label.source_path, source);
            related.push(
                DiagnosticRelatedOutput {
                    location: DiagnosticLocationOutput {
                        uri: path_to_uri(label.source_path),
                        range: offsets_to_range_with_index(index, label.span.start, label.span.end),
                    },
                    message: label.message,
                },
            )
        }
    }
    protocol_value(
        DiagnosticOutput {
            range: offsets_to_range_with_index(document.line_index, span.start, span.end),
            severity: diagnostic_severity(value.severity),
            source: "goml",
            message: diagnostic_text(value),
            code: value.code,
            data: diagnostic_data(server, document, analysis, value),
            related,
        },
    )
}

fn publish_diagnostics(server: Server, document: Document) -> json::Value {
    let analysis = document_analysis(server, document);
    let _ = query::build_symbol_index(analysis);
    let diagnostics: Vec[json::Value] = Vec::new();
    for diagnostic in analysis.checked.diagnostics {
        if diagnostic.source_path == "" || diagnostic.source_path == document.path {
            diagnostics.push(diagnostic_json(server, document, analysis, diagnostic))
        }
    }
    let params: Vec[(string, json::Value)] = Vec::new();
    push_json_field(params, "uri", json::Value::String(document.uri));
    push_json_field(params, "version", json::Value::Number(document.version.to_string()));
    push_json_field(params, "diagnostics", json::Value::Array(diagnostics));
    rpc_notification(PUBLISH_DIAGNOSTICS_METHOD, json::Value::Object(params))
}

fn status_operation(payload: string) -> Option[string] {
    let message = match json::parse(payload) {
        Ok(value) => match parse_rpc_message(value) {
            Ok(message) => message,
            Err(_) => return Option::None,
        },
        Err(_) => return Option::None,
    };
    match message.method {
        DID_OPEN_METHOD | DID_SAVE_METHOD | CHECK_DIAGNOSTICS_METHOD => {
            Option::Some("Checking diagnostics")
        },
        HOVER_METHOD => Option::Some("Hover"),
        EXPANDED_DERIVE_METHOD => Option::Some("Expanding derive"),
        COMPLETION_METHOD => Option::Some("Completion"),
        SIGNATURE_HELP_METHOD => Option::Some("Signature help"),
        INLAY_HINT_METHOD => Option::Some("Inlay hints"),
        DEFINITION_METHOD => Option::Some("Go to definition"),
        CODE_LENS_METHOD => Option::Some("Code lenses"),
        CODE_ACTION_METHOD => Option::Some("Code actions"),
        FORMATTING_METHOD => Option::Some("Formatting"),
        _ => Option::None,
    }
}

fn status_notification(state: string, operation: string) -> json::Value {
    let params: Vec[(string, json::Value)] = Vec::new();
    push_json_field(params, "state", json::Value::String(state));
    push_json_field(params, "operation", json::Value::String(operation));
    rpc_notification(STATUS_METHOD, json::Value::Object(params))
}

fn did_open(server: Server, params: json::Value) -> Result[json::Value, string] {
    let text_document = text_document(params)?;
    let uri = required_string_field(text_document, "uri")?;
    let path = uri_to_path(uri)?;
    if !source_files::is_source_file(path) {
        return Result::Err("source file must use the .goml extension: " + path)
    }
    let text = required_string_field(text_document, "text")?;
    let document = Document {
        uri,
        path,
        text,
        version: optional_int_field(text_document, "version", 0),
        line_index: line_index(text),
    };
    open_document(server, document);
    Result::Ok(publish_diagnostics(server, document))
}

fn did_change(server: Server, params: json::Value) -> Result[(), string] {
    let uri = text_document_uri(params)?;
    let text_document = text_document(params)?;
    let version = optional_int_field(text_document, "version", 0);
    let Some(changes) = json::as_array(required_field(params, "contentChanges")?) else {
        return Result::Err("contentChanges must be an array");
    };
    if changes.is_empty() {
        return Result::Err("contentChanges must not be empty")
    }
    let text = required_string_field(changes[changes.len() - 1], "text")?;
    change_document(server, uri, text, version);
    server_document(server, uri).map(|_| ()).ok_or("document is not open: " + uri)
}

fn check_diagnostics(server: Server, params: json::Value) -> Result[json::Value, string] {
    let uri = text_document_uri(params)?;
    server_document(server, uri).map(|document| publish_diagnostics(server, document)).ok_or(
        "document is not open: " + uri,
    )
}

fn did_close(server: Server, params: json::Value) -> Result[json::Value, string] {
    let uri = text_document_uri(params)?;
    close_document(server, uri);
    let diagnostic_params: Vec[(string, json::Value)] = Vec::new();
    push_json_field(diagnostic_params, "uri", json::Value::String(uri));
    push_json_field(diagnostic_params, "diagnostics", json::Value::Array(Vec::new()));
    Result::Ok(rpc_notification(PUBLISH_DIAGNOSTICS_METHOD, json::Value::Object(diagnostic_params)))
}

fn did_save(server: Server, params: json::Value) -> Result[json::Value, string] {
    let uri = text_document_uri(params)?;
    server_document(server, uri).map(|document| publish_diagnostics(server, document)).ok_or(
        "document is not open: " + uri,
    )
}

fn did_change_watched_files(server: Server, params: json::Value) -> Result[(), string] {
    let Some(changes) = json::as_array(required_field(params, "changes")?) else {
        return Result::Err("changes must be an array");
    };
    for change in changes {
        let _ = uri_to_path(required_string_field(change, "uri")?)?;
    }
    if !changes.is_empty() {
        invalidate_analyses(server)
    }
    Result::Ok(())
}

fn request_result(server: Server, message: RpcMessage) -> Result[json::Value, string] {
    match message.method {
        INITIALIZE_METHOD => Result::Ok(initialize_result()),
        SHUTDOWN_METHOD => {
            server.shutdown.set(true);
            Result::Ok(json::Value::Null)
        },
        HOVER_METHOD => hover_response(server, message.params),
        EXPANDED_DERIVE_METHOD => expanded_derive_response(server, message.params),
        COMPLETION_METHOD => completion_response(server, message.params),
        SIGNATURE_HELP_METHOD => signature_response(server, message.params),
        INLAY_HINT_METHOD => inlay_response(server, message.params),
        DEFINITION_METHOD => definition_response(server, message.params),
        CODE_LENS_METHOD => code_lens_response(server, message.params),
        CODE_ACTION_METHOD => code_action_response(server, message.params),
        FORMATTING_METHOD => formatting_response(server, message.params),
        _ => Result::Err("method not found: " + message.method),
    }
}

pub fn handle_json(server: Server, value: json::Value) -> Vec[json::Value] {
    let output: Vec[json::Value] = Vec::new();
    match parse_rpc_message(value) {
        Ok(message) => if server.shutdown.get() && message.method != EXIT_METHOD {
            if let Some(id) = message.id {
                output.push(rpc_error(id, -32600, "server has shut down"))
            }
        } else {
            match message.method {
                EXIT_METHOD => server.running.set(false),
                INITIALIZED_METHOD => (),
                DID_OPEN_METHOD => if let Ok(notification) = did_open(server, message.params) {
                    output.push(notification)
                },
                DID_CHANGE_METHOD => match did_change(server, message.params) {
                    Ok(()) => (),
                    Err(_) => (),
                },
                CHECK_DIAGNOSTICS_METHOD => if let Ok(notification) = check_diagnostics(
                    server,
                    message.params,
                ) {
                    output.push(notification)
                },
                DID_CLOSE_METHOD => if let Ok(notification) = did_close(server, message.params) {
                    output.push(notification)
                },
                DID_SAVE_METHOD => if let Ok(notification) = did_save(server, message.params) {
                    output.push(notification)
                },
                DID_CHANGE_WATCHED_FILES_METHOD => {
                    let _ = did_change_watched_files(server, message.params);
                },
                _ => match message.id {
                    Some(id) => match request_result(server, message) {
                        Ok(result) => output.push(rpc_success(id, result)),
                        Err(error) => output.push(
                            rpc_error(
                                id,
                                if error.starts_with("method not found:") {
                                    -32601
                                } else {
                                    -32602
                                },
                                error,
                            ),
                        ),
                    },
                    None => (),
                },
            }
        },
        Err(error) => output.push(rpc_error(json::Value::Null, -32600, error)),
    }
    output
}

pub fn handle_payload(server: Server, payload: string) -> Result[Vec[json::Value], string] {
    match json::parse(payload) {
        Ok(value) => Result::Ok(handle_json(server, value)),
        Err(error) => Result::Ok(Vec::from_array([rpc_error(json::Value::Null, -32700, error)])),
    }
}

pub fn run_server() -> Result[(), LspFailure] {
    let server = new_server();
    while server_running(server) {
        let payload = read_rpc_payload()?;
        let operation = status_operation(payload);
        if let Some(name) = operation {
            write_rpc_message(status_notification("busy", name))?
        }
        for message in handle_payload(server, payload).map_err(protocol_failure)? {
            write_rpc_message(message)?
        }
        if let Some(name) = operation {
            write_rpc_message(status_notification("ready", name))?
        }
    }
    if server.shutdown.get() {
        Result::Ok(())
    } else {
        Result::Err(protocol_failure("exit notification received before shutdown"))
    }
}
