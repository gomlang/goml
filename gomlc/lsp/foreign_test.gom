package lsp;

use module::query;
use module::tast;
use std::env;
use std::fs;
use std::json;
use std::path;
use std::testing;

#[test]
fn external_type_diagnostics_follow_unsaved_documents_and_watched_go_changes() -> () {
    let root = "/tmp/gomllsp-external-types";
    if let Err(error) = fs::create_dir_all(root + "/native") {
        testing::fail(error.to_string())
    }
    for (name, source) in Vec::from_array(
        [
            ("goml.toml", "[module]\npath = \"example::editor\"\n"),
            ("go.mod", "module example.com/editor\n\ngo 1.26\n"),
            ("native/types.go", "package native\ntype Number = int64\n"),
        ],
    ) {
        if let Err(error) = fs::write_file_structured(root + "/" + name, source) {
            testing::fail(error.to_string())
        }
    }
    let compiler = env::var_structured("GOML_TEST_GOMLC").unwrap_or("../stage2/bin/gomlc");
    let helper = path::absolute_structured(compiler).map_err(|error| error.to_string()).and_then(
        |compiler| path::parent(compiler).ok_or("compiler has no directory"),
    ).map(|directory| path::join(directory, "goml-go-meta"));
    let server = Server {
        analysis_context: query::analysis_context_with_foreign_helper(helper),
        ..new_server(),
    };
    let source = "package editor; #[go_type(\"example.com/editor/native\", \"Number\")] extern type Number; pub fn echo(value: Number) -> i64 { value }";
    let uri = "file://" + root + "/main.gom";
    let document = Document {
        uri,
        path: root + "/main.gom",
        text: source,
        version: 1,
        line_index: line_index(source),
    };
    open_document(server, document);
    testing::assert(
        !tast::diagnostics_have_errors(query::diagnostics(document_analysis(server, document))),
    );
    let invalid = source + " pub fn bad(value: bool) -> Number { value }";
    change_document(server, uri, invalid, 2);
    let current = server_document(server, uri).unwrap_or(document);
    testing::assert(
        tast::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    change_document(server, uri, source, 3);
    let current = server_document(server, uri).unwrap_or(document);
    testing::assert(
        !tast::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    if let Err(error) = fs::write_file_structured(
        root + "/native/types.go",
        "package native\ntype Number = bool\n",
    ) {
        testing::fail(error.to_string())
    }
    let changes = json::object(
        Vec::from_array(
            [
                (
                    "changes",
                    json::Value::Array(
                        Vec::from_array(
                            [
                                json::object(
                                    Vec::from_array(
                                        [
                                            (
                                                "uri",
                                                json::Value::String(
                                                    "file://" + root + "/native/types.go",
                                                ),
                                            ),
                                            ("type", json::Value::Number("2")),
                                        ],
                                    ),
                                ),
                            ],
                        ),
                    ),
                ),
            ],
        ),
    );
    if let Err(error) = did_change_watched_files(server, changes) {
        testing::fail(error)
    }
    testing::assert(
        tast::diagnostics_have_errors(query::diagnostics(document_analysis(server, current))),
    );
    let _ = fs::remove_dir_all(root);
}
