package go_runtime;

use module::go_ir::{Type, UnaryOp, BinaryOp, Expr, Block, Stmt, Item};
use module::go_types::{lower_type};
use module::repr;

fn linux_process_spawn_result_type() -> Type {
    std_tuple_type(
        Vec::from_array(
            [
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::Int,
                repr::Type::Uint,
                repr::Type::String,
            ],
        ),
    )
}

fn linux_process_spawn_result(ok: bool, pid: Expr, handle: Expr, code: Expr, message: Expr) -> Stmt {
    Return {
        expr: Option::Some(
            runtime_tuple_expr(
                linux_process_spawn_result_type(),
                Vec::from_array([Expr::Bool { value: ok }, pid, handle, code, message]),
            ),
        ),
    }
}

fn linux_process_spawn_error() -> Stmt {
    If {
        cond: Expr::Binary { op: BinaryOp::NotEq, lhs: Expr::Var { name: "err" }, rhs: Expr::Nil },
        then_: Block {
            stmts: Vec::from_array(
                [
                    Stmt::Var {
                        name: "code",
                        ty: Type::Named { name: "_goml_syscall.Errno" },
                        value: Option::None,
                    },
                    Stmt::Expr {
                        expr: runtime_call(
                            "_goml_errors.As",
                            Vec::from_array(
                                [
                                    Expr::Var { name: "err" },
                                    Unary { op: UnaryOp::Address, expr: Expr::Var { name: "code" } },
                                ],
                            ),
                        ),
                    },
                    If {
                        cond: runtime_call(
                            "_goml_errors.Is",
                            Vec::from_array(
                                [
                                    Expr::Var { name: "err" },
                                    Expr::Var { name: "_goml_exec.ErrNotFound" },
                                ],
                            ),
                        ),
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    Assign {
                                        name: "code",
                                        value: Expr::Var { name: "_goml_syscall.ENOENT" },
                                    },
                                ],
                            ),
                        },
                        else_: Option::None,
                    },
                    linux_process_spawn_result(
                        false,
                        Expr::Int { value: "0" },
                        Expr::Int { value: "-1" },
                        Convert { ty: Type::Uint, expr: Expr::Var { name: "code" } },
                        std_method_call(Expr::Var { name: "err" }, "Error", Vec::new()),
                    ),
                ],
            ),
        },
        else_: Option::None,
    }
}

fn linux_process_spawn_item(key: string) -> Item {
    let params = Vec::from_array(
        [
            ("program", Type::String),
            ("arguments", lower_type(std_vec_type(repr::Type::String))),
            ("directory", Type::String),
            ("environment", lower_type(std_vec_type(repr::Type::String))),
            ("files", lower_type(std_vec_type(repr::Type::Uint))),
            ("new_session", Type::Bool),
            ("new_process_group", Type::Bool),
        ],
    );
    let stmts = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Or,
                lhs: Expr::Binary {
                    op: BinaryOp::NotEq,
                    lhs: Expr::Var { name: "_goml_runtime_pkg.GOOS" },
                    rhs: Expr::String { value: "linux" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::NotEq,
                    lhs: Expr::Var { name: "_goml_runtime_pkg.GOARCH" },
                    rhs: Expr::String { value: "amd64" },
                },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        linux_process_spawn_result(
                            false,
                            Expr::Int { value: "0" },
                            Expr::Int { value: "-1" },
                            Expr::Int { value: "38" },
                            Expr::String { value: "Linux amd64 is required" },
                        ),
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "path",
            ty: Type::String,
            value: Option::Some(Expr::Var { name: "program" }),
        },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::Var {
            name: "lookup",
            ty: Type::Bool,
            value: Option::Some(Expr::Bool { value: true }),
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["_", "character"]),
            expr: Expr::Var { name: "program" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        If {
                            cond: Expr::Binary {
                                op: BinaryOp::Eq,
                                lhs: Expr::Var { name: "character" },
                                rhs: Expr::Int { value: "47" },
                            },
                            then_: Block {
                                stmts: Vec::from_array(
                                    [
                                        Assign {
                                            name: "lookup",
                                            value: Expr::Bool { value: false },
                                        },
                                        Break,
                                    ],
                                ),
                            },
                            else_: Option::None,
                        },
                    ],
                ),
            },
        },
    );
    stmts.push(
        If {
            cond: Expr::Var { name: "lookup" },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        MultiAssign {
                            names: Vec::from_array(["path", "err"]),
                            value: runtime_call(
                                "_goml_exec.LookPath",
                                Vec::from_array([Expr::Var { name: "program" }]),
                            ),
                        },
                        linux_process_spawn_error(),
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "argv",
            ty: Type::Slice { elem: Type::String },
            value: Option::Some(
                CallSpread {
                    func: Expr::Var { name: "append" },
                    args: Vec::from_array(
                        [
                            ArrayLiteral {
                                ty: Type::Slice { elem: Type::String },
                                items: Vec::from_array([Expr::Var { name: "program" }]),
                            },
                        ],
                    ),
                    spread: Expr::Field {
                        expr: Expr::Var { name: "arguments" },
                        field_name: "items",
                    },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "raw_files",
            ty: Type::Slice { elem: Type::Named { name: "uintptr" } },
            value: Option::Some(
                Make {
                    ty: Type::Slice { elem: Type::Named { name: "uintptr" } },
                    args: Vec::from_array(
                        [
                            runtime_call(
                                "len",
                                Vec::from_array(
                                    [
                                        Field {
                                            expr: Expr::Var { name: "files" },
                                            field_name: "items",
                                        },
                                    ],
                                ),
                            ),
                        ],
                    ),
                },
            ),
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "raw"]),
            expr: Expr::Field { expr: Expr::Var { name: "files" }, field_name: "items" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        IndexAssign {
                            base: Expr::Var { name: "raw_files" },
                            index: Expr::Var { name: "index" },
                            value: runtime_call(
                                "uintptr",
                                Vec::from_array([Expr::Var { name: "raw" }]),
                            ),
                        },
                    ],
                ),
            },
        },
    );
    stmts.push(
        Stmt::Var { name: "pidfd", ty: Type::Int, value: Option::Some(Expr::Int { value: "-1" }) },
    );
    stmts.push(Stmt::Var { name: "pid", ty: Type::Int, value: Option::None });
    let attributes = Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: "_goml_syscall.ProcAttr" },
            fields: Vec::from_array(
                [
                    ("Dir", Expr::Var { name: "directory" }),
                    ("Env", Field { expr: Expr::Var { name: "environment" }, field_name: "items" }),
                    ("Files", Expr::Var { name: "raw_files" }),
                    (
                        "Sys",
                        Unary {
                            op: UnaryOp::Address,
                            expr: Expr::StructLiteral {
                                ty: Type::Named { name: "_goml_syscall.SysProcAttr" },
                                fields: Vec::from_array(
                                    [
                                        (
                                            "PidFD",
                                            Unary {
                                                op: UnaryOp::Address,
                                                expr: Expr::Var { name: "pidfd" },
                                            },
                                        ),
                                        ("Setsid", Expr::Var { name: "new_session" }),
                                        (
                                            "Setpgid",
                                            Binary {
                                                op: BinaryOp::And,
                                                lhs: Expr::Var { name: "new_process_group" },
                                                rhs: Expr::Unary {
                                                    op: UnaryOp::Not,
                                                    expr: Expr::Var { name: "new_session" },
                                                },
                                            },
                                        ),
                                    ],
                                ),
                            },
                        },
                    ),
                ],
            ),
        },
    };
    stmts.push(
        MultiAssign {
            names: Vec::from_array(["pid", "err"]),
            value: runtime_call(
                "_goml_syscall.ForkExec",
                Vec::from_array(
                    [Expr::Var { name: "path" }, Expr::Var { name: "argv" }, attributes],
                ),
            ),
        },
    );
    stmts.push(linux_process_spawn_error());
    stmts.push(
        linux_process_spawn_result(
            true,
            Expr::Var { name: "pid" },
            Expr::Var { name: "pidfd" },
            Expr::Int { value: "0" },
            Expr::String { value: "" },
        ),
    );
    runtime_function_item(key, params, linux_process_spawn_result_type(), stmts)
}
