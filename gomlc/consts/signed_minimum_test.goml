package consts;

use std::testing;

#[test]
fn signed_minimum_literals_parse_before_magnitude_range_checks() -> () {
    let minimum: isize = -9223372036854775807 - 1;
    for source in[
        "-9223372036854775808",
        "-9_223_372_036_854_775_808",
        "-0x8000000000000000",
        "-(9223372036854775808)",
        "-({0x8000000000000000})",
    ] {
        testing::assert_eq(constant_result(source).unwrap_or(0), minimum);
    }
    testing::assert_eq(
        constant_result("-9223372036854775808 + 9223372036854775807 + 1").unwrap_or(-1),
        0,
    );
    for source in[
        "9223372036854775808",
        "-9223372036854775809",
        "--9223372036854775808",
        "-(9223372036854775808 + 1)",
        "-(9223372036854775808]",
    ] {
        testing::assert(constant_result(source).is_err());
    }
}
