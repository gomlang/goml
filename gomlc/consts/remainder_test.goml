package consts;

use std::testing;

#[test]
fn minimum_remainder_does_not_overflow() -> () {
    let minimum: isize = -9223372036854775807 - 1;
    testing::assert_eq(binary("%", minimum, -1).unwrap_or(-1), 0);
    testing::assert_eq(binary("%", minimum, 1).unwrap_or(-1), 0);
    testing::assert_eq(binary("%", minimum, 3).unwrap_or(0), -2);
    testing::assert(binary("/", minimum, -1).is_err());
    testing::assert(binary("%", minimum, 0).is_err());
    testing::assert_eq(constant_result("(-9223372036854775807 - 1) % -1").unwrap_or(-1), 0);
}
