package consts;

use std::testing;

fn constant_result(source: string) -> Result[isize, string] {
    evaluate(
        parse(source)?,
        |name| if name == "WIDTH" {
            Result::Ok(3)
        } else {
            Result::Err("unknown " + name)
        },
    )
}

#[test]
fn integer_constant_precedence_names_and_radices() -> () {
    testing::assert_eq(constant_result("WIDTH * 2 + (8 >> 1)").unwrap_or(-1), 10);
    testing::assert_eq(constant_result("{0x10 + 0b11 + 0o7}").unwrap_or(-1), 26);
    testing::assert_eq(constant_result("1_000 - 1").unwrap_or(-1), 999);
    testing::assert_eq(constant_result("~0 & 7").unwrap_or(-1), 7);
}

#[test]
fn invalid_constant_expressions_are_recoverable() -> () {
    for value in Vec::from_array(
        [
            "1 / 0",
            "1 % 0",
            "9223372036854775807 + 1",
            "9223372036854775807 * 2",
            "1 << 63",
            "1 >> 64",
            "MISSING",
            "(1 + 2",
            "f()",
            "1 2",
        ],
    ) {
        testing::assert(constant_result(value).is_err())
    }
}
