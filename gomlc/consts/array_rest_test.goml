package consts;

use std::testing;

#[test]
fn symbolic_array_rest_lengths_saturate_short_instances() -> () {
    for values in[(0, 0), (1, 0), (2, 0), (4, 2)] {
        testing::assert_eq(binary("saturating_sub", values.0, 2).unwrap_or(-1), values.1);
    }
    testing::assert_eq(
        binary("saturating_sub", 9223372036854775807, 2).unwrap_or(-1),
        9223372036854775805,
    );
    testing::assert_eq(binary("saturating_sub", 3, 0).unwrap_or(-1), 3);
}
