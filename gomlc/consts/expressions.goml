package consts;

use module::lexer;
use module::numeric;
use std::num;

pub enum Expr {
    Value(isize),
    Name(string),
    Unary {
        op: string,
        value: Expr,
    },
    Binary {
        op: string,
        left: Expr,
        right: Expr,
    },
}

struct Parser {
    tokens: Vec[lexer::Token],
    position: Ref[isize],
}

fn peek(parser: Parser) -> string {
    let index = parser.position.get();
    if index < parser.tokens.len() {
        parser.tokens[index].text
    } else {
        ""
    }
}

fn take(parser: Parser) -> string {
    let value = peek(parser);
    parser.position.set(parser.position.get() + 1);
    value
}

fn precedence(op: string) -> isize {
    match op {
        "|" => 1,
        "^" => 2,
        "&" => 3,
        "<<" | ">>" => 4,
        "+" | "-" => 5,
        "*" | "/" | "%" => 6,
        _ => 0,
    }
}

fn expression(parser: Parser, minimum: isize, depth: isize) -> Result[Expr, string] {
    if depth > 128 {
        return Result::Err("constant expression is too deeply nested")
    }
    let token = take(parser);
    let mut left = if token == "(" || token == "{" {
        let inner = expression(parser, 1, depth + 1)?;
        let close = if token == "(" {
            ")"
        } else {
            "}"
        };
        if take(parser) != close {
            return Result::Err("missing closing delimiter in constant expression")
        }
        inner
    } else if token == "+" || token == "-" || token == "~" {
        Expr::Unary { op: token, value: expression(parser, 7, depth + 1)? }
    } else if token.byte_len() > 0 && token.byte_get(0) >= b'0' && token.byte_get(0) <= b'9' {
        match integer(token) {
            Some(value) => Expr::Value(value),
            None => return Result::Err("Invalid array length: " + token),
        }
    } else if token.byte_len() > 0
        && ((token.byte_get(0) >= b'A' && token.byte_get(0) <= b'Z')
            || (token.byte_get(0) >= b'a' && token.byte_get(0) <= b'z')
            || token.byte_get(0) == b'_') {
        let mut name = token;
        while peek(parser) == "::" {
            let _ = take(parser);
            let segment = take(parser);
            if segment == "" {
                return Result::Err("missing constant name after ::")
            }
            name = name + "::" + segment;
        }
        Expr::Name(name)
    } else {
        return Result::Err("expected an integer constant expression")
    };
    while precedence(peek(parser)) >= minimum {
        let op = take(parser);
        let right = expression(parser, precedence(op) + 1, depth + 1)?;
        left = Expr::Binary { op, left, right };
    }
    Result::Ok(left)
}

pub fn parse(source: string) -> Result[Expr, string] {
    let tokens: Vec[lexer::Token] = Vec::new();
    for token in lexer::lex(source) {
        if token.error.is_some() {
            return Result::Err("invalid token in constant expression")
        }
        if !lexer::token_is_trivia(token.kind) {
            tokens.push(token)
        }
    }
    let parser = Parser { tokens, position: Ref::new(0) };
    let result = expression(parser, 1, 0)?;
    if parser.position.get() != parser.tokens.len() {
        Result::Err("unsupported constant expression: " + source)
    } else {
        Result::Ok(result)
    }
}

pub fn binary(op: string, left: isize, right: isize) -> Result[isize, string] {
    let maximum: isize = 9223372036854775807;
    let minimum: isize = -9223372036854775807 - 1;
    match op {
        "+" => if (right > 0 && left > maximum - right) || (right < 0 && left < minimum - right) {
            Result::Err("integer overflow in constant expression")
        } else {
            Result::Ok(left + right)
        },
        "-" => if (right < 0 && left > maximum + right) || (right > 0 && left < minimum + right) {
            Result::Err("integer overflow in constant expression")
        } else {
            Result::Ok(left - right)
        },
        "*" => if left == 0 || right == 0 {
            Result::Ok(0)
        } else if (left == minimum && right == -1) || (right == minimum && left == -1) {
            Result::Err("integer overflow in constant expression")
        } else {
            let value = left * right;
            if value / right != left {
                Result::Err("integer overflow in constant expression")
            } else {
                Result::Ok(value)
            }
        },
        "/" | "%" => if right == 0 {
            Result::Err("division by zero in constant expression")
        } else if left == minimum && right == -1 {
            Result::Err("integer overflow in constant expression")
        } else if op == "/" {
            Result::Ok(left / right)
        } else {
            Result::Ok(left % right)
        },
        "<<" | ">>" => if right < 0 || right >= 64 {
            Result::Err("invalid shift in constant expression")
        } else if op == ">>" {
            Result::Ok(left >> right)
        } else {
            let value = left << right;
            if value >> right != left {
                Result::Err("integer overflow in constant expression")
            } else {
                Result::Ok(value)
            }
        },
        "&" => Result::Ok(left & right),
        "|" => Result::Ok(left | right),
        "^" => Result::Ok(left ^ right),
        _ => Result::Err("unsupported constant operator " + op),
    }
}

pub fn evaluate(value: Expr, lookup: (string) -> Result[isize, string]) -> Result[isize, string] {
    match value {
        Value(value) => Result::Ok(value),
        Name(name) => lookup(name),
        Unary { op, value } => {
            let value = evaluate(value, lookup)?;
            if op == "-" {
                binary("-", 0, value)
            } else if op == "~" {
                Result::Ok(~value)
            } else {
                Result::Ok(value)
            }
        },
        Binary { op, left, right } => binary(op, evaluate(left, lookup)?, evaluate(right, lookup)?),
    }
}

pub fn parameter(name: string) -> string {
    "$const_param:" + name
}

pub fn parameter_name(name: string) -> Option[string] {
    if name.starts_with("$const_param:") {
        Option::Some(name.byte_slice(13, name.byte_len()))
    } else {
        Option::None
    }
}

pub fn value_name(value: isize) -> string {
    "$const_value:" + value.to_string()
}

pub fn value_number(name: string) -> Option[isize] {
    if name.starts_with("$const_value:") {
        integer(name.byte_slice(13, name.byte_len()))
    } else {
        Option::None
    }
}

pub fn integer(value: string) -> Option[isize] {
    let normalized = if value.starts_with("-") {
        Option::Some(value)
    } else {
        numeric::normalize_integer(value)
    }?;
    match num::parse_int_structured(normalized) {
        Ok(value) => Option::Some(value),
        Err(_) => Option::None,
    }
}

pub fn contains_name(value: Expr, name: string) -> bool {
    match value {
        Name(value) => value == name,
        Unary { value, .. } => contains_name(value, name),
        Binary { left, right, .. } => contains_name(left, name) || contains_name(right, name),
        Value(_) => false,
    }
}
