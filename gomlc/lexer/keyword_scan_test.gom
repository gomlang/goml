package lexer;

use std::testing;

#[test]
fn keyword_scan_skips_identifiers_comments_and_literals() -> () {
    let sources = Vec::from_array(
        [
            "fn external(extern_value: string) -> string { extern_value }",
            "// extern fn ignored();\nfn plain() -> () {}",
            "fn value() -> string { \"extern \\\"quoted\\\"\" }",
            "fn value() -> string { r###\"extern \"quoted\"\"### }",
            "fn value() -> string { f\"extern {r#\"extern\"#}\" }",
            "fn value() -> Bytes { br##\"extern \"quoted\"\"## }",
            "fn value() -> Bytes { b\"extern \\\"quoted\\\"\" }",
            "fn value() -> char { '\"' }",
            "fn value() -> u8 { b'\"' }",
            "fn value() -> string {\n    \\\\extern fn ignored();\n    \\\\extern type Ignored;\n}",
        ],
    );
    for source in sources {
        testing::assert(!may_contain_keyword(source, "extern"));
        testing::assert(may_contain_keyword(source + "\nextern fn real();", "extern"))
    }
}

#[test]
fn keyword_scan_falls_back_on_unterminated_literals() -> () {
    for source in Vec::from_array(["\"unfinished", "r#\"unfinished", "f\"{", "'", "b\""]) {
        testing::assert(may_contain_keyword(source, "extern"))
    }
}
