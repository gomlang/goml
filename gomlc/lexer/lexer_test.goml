package lexer;

use std::testing;
use std::text;

fn assert_token(
    tokens: Vec[Token],
    index: isize,
    kind: TokenKind,
    text_value: string,
    start: isize,
    end: isize,
) -> () {
    let token = tokens.get(index);
    testing::assert(token_kind_equal(token.kind, kind));
    testing::assert_eq(token.text, text_value);
    testing::assert_eq(token.start, start);
    testing::assert_eq(token.end, end)
}

fn assert_error_token(tokens: Vec[Token], index: isize, message: string) -> () {
    let token = tokens.get(index);
    testing::assert(token_kind_equal(token.kind, TokenKind::Error));
    match token.error {
        Some(error) => testing::assert_eq(error.message, message),
        None => testing::fail("expected lexer error metadata"),
    }
}

#[test]
fn lexes_basic_tokens() -> () {
    let tokens = lex("let a = 123");
    testing::assert_eq(tokens.len(), 7);
    assert_token(tokens, 0, TokenKind::LetKeyword, "let", 0, 3);
    assert_token(tokens, 1, TokenKind::Whitespace, " ", 3, 4);
    assert_token(tokens, 2, TokenKind::Ident, "a", 4, 5);
    assert_token(tokens, 3, TokenKind::Whitespace, " ", 5, 6);
    assert_token(tokens, 4, TokenKind::Eq, "=", 6, 7);
    assert_token(tokens, 5, TokenKind::Whitespace, " ", 7, 8);
    assert_token(tokens, 6, TokenKind::IntLit, "123", 8, 11)
}

#[test]
fn lexes_operator_tokens() -> () {
    let source = "(){}[] =;,:::+-*/%....=..@&&&|||^~!<<<>>>>=<= == != ?# -> =>";
    let tokens = lex(source);
    testing::assert_eq(
        encode_tokens(tokens),
        "LParen\t0\t1\t28\nRParen\t1\t2\t29\nLBrace\t2\t3\t7b\nRBrace\t3\t4\t7d\nLBracket\t4\t5\t5b\nRBracket\t5\t6\t5d\nWhitespace\t6\t7\t20\nEq\t7\t8\t3d\nSemi\t8\t9\t3b\nComma\t9\t10\t2c\nColonColon\t10\t12\t3a3a\nColon\t12\t13\t3a\nPlus\t13\t14\t2b\nMinus\t14\t15\t2d\nStar\t15\t16\t2a\nSlash\t16\t17\t2f\nPercent\t17\t18\t25\nDotDot\t18\t20\t2e2e\nDotDotEq\t20\t23\t2e2e3d\nDotDot\t23\t25\t2e2e\nAt\t25\t26\t40\nAndAnd\t26\t28\t2626\nAmp\t28\t29\t26\nOrOr\t29\t31\t7c7c\nPipe\t31\t32\t7c\nCaret\t32\t33\t5e\nTilde\t33\t34\t7e\nBang\t34\t35\t21\nLessLess\t35\t37\t3c3c\nLess\t37\t38\t3c\nGreaterGreater\t38\t40\t3e3e\nGreaterGreaterEq\t40\t43\t3e3e3d\nLessEq\t43\t45\t3c3d\nWhitespace\t45\t46\t20\nEqEq\t46\t48\t3d3d\nWhitespace\t48\t49\t20\nNotEq\t49\t51\t213d\nWhitespace\t51\t52\t20\nQuestion\t52\t53\t3f\nPound\t53\t54\t23\nWhitespace\t54\t55\t20\nArrow\t55\t57\t2d3e\nWhitespace\t57\t58\t20\nFatArrow\t58\t60\t3d3e\n",
    )
}

#[test]
fn lexes_compound_assignment_tokens() -> () {
    let tokens = lex("+= -= *= /= %= &= |= ^= <<= >>=");
    let builder = text::StringBuilder::new();
    for token in tokens {
        if !token_kind_equal(token.kind, TokenKind::Whitespace) {
            if !builder.is_empty() {
                builder.write_string(" ")
            }
            builder.write_string(token_kind_name(token.kind))
        }
    }
    testing::assert_eq(
        builder.finish(),
        "PlusEq MinusEq StarEq SlashEq PercentEq AmpEq PipeEq CaretEq LessLessEq GreaterGreaterEq",
    )
}

#[test]
fn lexes_interpolated_string_segments() -> () {
    let tokens = lex("f\"hi {{x}} {value + 1}!\"");
    let builder = text::StringBuilder::new();
    for token in tokens {
        if !token_kind_equal(token.kind, TokenKind::Whitespace) {
            if !builder.is_empty() {
                builder.write_string("|")
            }
            builder.write_string(token_kind_name(token.kind));
            builder.write_string(":");
            builder.write_string(token.text)
        }
    }
    testing::assert_eq(
        builder.finish(),
        "FStringStart:f\"|FStringText:hi {{x}} |FStringExprStart:{|Ident:value|Plus:+|IntLit:1|FStringExprEnd:}|FStringText:!|FStringEnd:\"",
    );
    testing::assert_eq(tokens.get(3).start, 12);
    testing::assert_eq(tokens.get(3).end, 17);
    let recovered = lex("f\"bad \\q tail\" next");
    testing::assert_eq(recovered.len(), 7);
    testing::assert(token_kind_equal(recovered.get(2).kind, TokenKind::Error));
    testing::assert(token_kind_equal(recovered.get(4).kind, TokenKind::FStringEnd));
    testing::assert(token_kind_equal(recovered.get(6).kind, TokenKind::Ident));
    match recovered.get(2).error {
        Some(error) => {
            testing::assert_eq(error.start, 6);
            testing::assert_eq(error.end, 7)
        },
        None => testing::fail("expected interpolated string error metadata"),
    }
}

#[test]
fn lexes_keywords_and_identifiers() -> () {
    let source = "extern package use import as pub mod crate super fn trait impl for enum struct type const static where match if else let mut in return go defer while break continue dyn true false _ unit bool isize i8 i16 i32 i64 usize u8 u16 u32 u64 f32 f64 int int8 int16 int32 int64 uint uint8 uint16 uint32 uint64 float32 float64 string char array self _x __ x1";
    let tokens = lex(source);
    let expected = "ExternKeyword PackageKeyword UseKeyword Ident AsKeyword PubKeyword Ident Ident Ident FnKeyword TraitKeyword ImplKeyword ForKeyword EnumKeyword StructKeyword TypeKeyword ConstKeyword StaticKeyword WhereKeyword MatchKeyword IfKeyword ElseKeyword LetKeyword MutKeyword InKeyword ReturnKeyword GoKeyword DeferKeyword WhileKeyword BreakKeyword ContinueKeyword DynKeyword TrueKeyword FalseKeyword WildcardKeyword Ident BoolKeyword IsizeKeyword I8Keyword I16Keyword I32Keyword I64Keyword UsizeKeyword U8Keyword U16Keyword U32Keyword U64Keyword F32Keyword F64Keyword Ident Ident Ident Ident Ident Ident Ident Ident Ident Ident Ident Ident StringKeyword CharKeyword Ident Ident Ident Ident Ident";
    let builder = text::StringBuilder::new();
    for token in tokens {
        if !token_kind_equal(token.kind, TokenKind::Whitespace) {
            if !builder.is_empty() {
                builder.write_string(" ")
            }
            builder.write_string(token_kind_name(token.kind))
        }
    }
    testing::assert_eq(builder.finish(), expected)
}

#[test]
fn lexes_radix_and_byte_literals() -> () {
    let tokens = lex(
        "0b1010 0B1_001 0o755 0O7_0 0xff 0XCA_FE b'A' b'\\n' b'\\xFF' b\"text\" 0b102 0x_1 0o7_ b'é'",
    );
    let builder = text::StringBuilder::new();
    for token in tokens {
        if !token_kind_equal(token.kind, TokenKind::Whitespace) {
            if !builder.is_empty() {
                builder.write_string(" ")
            }
            builder.write_string(token_kind_name(token.kind));
            builder.write_string(":");
            builder.write_string(token.text)
        }
    }
    testing::assert_eq(
        builder.finish(),
        "IntLit:0b1010 IntLit:0B1_001 IntLit:0o755 IntLit:0O7_0 IntLit:0xff IntLit:0XCA_FE ByteCharLit:b'A' ByteCharLit:b'\\n' ByteCharLit:b'\\xFF' ByteStr:b\"text\" Error:0b102 Error:0x_1 Error:0o7_ Error:b'é'",
    )
}

#[test]
fn lexes_numeric_literals() -> () {
    let tokens = lex(
        "0 12 1i8 2i16 3i32 4i64 5u8 6u16 7u32 8u64 1.25 2.5f32 3.75f64 1. 1f32 1.2f33 9i32x",
    );
    let builder = text::StringBuilder::new();
    for token in tokens {
        if !token_kind_equal(token.kind, TokenKind::Whitespace) {
            if !builder.is_empty() {
                builder.write_string(" ")
            }
            builder.write_string(token_kind_name(token.kind));
            builder.write_string(":");
            builder.write_string(token.text)
        }
    }
    testing::assert_eq(
        builder.finish(),
        "IntLit:0 IntLit:12 Error:1i8 Error:2i16 Error:3i32 Error:4i64 Error:5u8 Error:6u16 Error:7u32 Error:8u64 Float:1.25 Error:2.5f32 Error:3.75f64 IntLit:1 Dot:. IntLit:1 F32Keyword:f32 Float:1.2 Ident:f33 Error:9i32 Ident:x",
    )
}

#[test]
fn lexes_strings_chars_comments_and_multiline_strings() -> () {
    let source =
        \\"héllo \n \u0041" '中' '\n' // λ
        \\\\first
        \\  \\second
        \\next
    ;
    let tokens = lex(source);
    testing::assert_eq(tokens.len(), 11);
    testing::assert(token_kind_equal(tokens.get(0).kind, TokenKind::Str));
    testing::assert(token_kind_equal(tokens.get(2).kind, TokenKind::CharLit));
    testing::assert(token_kind_equal(tokens.get(4).kind, TokenKind::CharLit));
    testing::assert(token_kind_equal(tokens.get(6).kind, TokenKind::Comment));
    testing::assert(token_kind_equal(tokens.get(8).kind, TokenKind::MultilineStr));
    testing::assert_eq(
        tokens.get(8).text,
        \\\\first
        \\  \\second
        ,
    );
    testing::assert(token_kind_equal(tokens.get(9).kind, TokenKind::Whitespace));
    testing::assert(token_kind_equal(tokens.get(10).kind, TokenKind::Ident))
}

#[test]
fn rejects_surrogate_unicode_escapes() -> () {
    assert_error_token(lex("\"\\uD800\""), 0, "invalid escape sequence in string literal");
    assert_error_token(lex("\"\\uDFFF\""), 0, "invalid escape sequence in string literal");
    assert_error_token(
        lex("f\"\\uD800\""),
        1,
        "invalid escape sequence in interpolated string literal",
    );
    assert_error_token(
        lex("f\"\\uDFFF\""),
        1,
        "invalid escape sequence in interpolated string literal",
    );
    assert_error_token(lex("'\\uD800'"), 0, "invalid character literal");
    assert_error_token(lex("'\\uDFFF'"), 0, "invalid character literal");
    let strings = lex("\"\\uD7FF\\uE000\"");
    testing::assert_eq(strings.len(), 1);
    testing::assert(token_kind_equal(strings.get(0).kind, TokenKind::Str));
    let interpolated = lex("f\"\\uD7FF\\uE000\"");
    testing::assert_eq(interpolated.len(), 3);
    testing::assert(token_kind_equal(interpolated.get(1).kind, TokenKind::FStringText));
    let chars = lex("'\\uD7FF' '\\uE000'");
    testing::assert_eq(chars.len(), 3);
    testing::assert(token_kind_equal(chars.get(0).kind, TokenKind::CharLit));
    testing::assert(token_kind_equal(chars.get(2).kind, TokenKind::CharLit))
}

#[test]
fn preserves_utf8_byte_ranges_and_error_partition() -> () {
    let nul = match char_from_u32(0) {
        Some(value) => value.to_string(),
        None => "",
    };
    let tokens = lex("é中🦀 $ " + nul + " _é");
    testing::assert_eq(tokens.len(), 10);
    assert_token(tokens, 0, TokenKind::Error, "é", 0, 2);
    assert_token(tokens, 1, TokenKind::Error, "中", 2, 5);
    assert_token(tokens, 2, TokenKind::Error, "🦀", 5, 9);
    assert_token(tokens, 4, TokenKind::Error, "$", 10, 11);
    assert_token(tokens, 6, TokenKind::Error, nul, 12, 13);
    assert_token(tokens, 8, TokenKind::WildcardKeyword, "_", 14, 15);
    assert_token(tokens, 9, TokenKind::Error, "é", 15, 17)
}

#[test]
fn rejects_invalid_string_and_char_literals_like_logos() -> () {
    let unterminated = "\"unterminated";
    let tokens = lex(unterminated);
    testing::assert_eq(tokens.len(), 1);
    testing::assert(token_kind_equal(tokens.get(0).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(0).text, "\"unterminated");
    match tokens.get(0).error {
        Some(error) => {
            testing::assert_eq(error.message, "unterminated string literal");
            testing::assert_eq(error.start, unterminated.byte_len());
            testing::assert_eq(error.end, unterminated.byte_len())
        },
        None => testing::fail("expected unterminated string metadata"),
    }
    let chars = lex("'ab'");
    testing::assert_eq(chars.len(), 1);
    testing::assert(token_kind_equal(chars.get(0).kind, TokenKind::Error));
    testing::assert_eq(chars.get(0).text, "'ab'");
    match chars.get(0).error {
        Some(error) => {
            testing::assert_eq(error.message, "invalid character literal");
            testing::assert_eq(error.start, 0);
            testing::assert_eq(error.end, 4)
        },
        None => testing::fail("expected invalid character metadata"),
    }
    let unterminated_char = lex("'1");
    match unterminated_char.get(0).error {
        Some(error) => {
            testing::assert_eq(error.message, "unterminated character literal");
            testing::assert_eq(error.start, 2);
            testing::assert_eq(error.end, 2)
        },
        None => testing::fail("expected unterminated character metadata"),
    }
    let multiline = lex(
        \\"hello \
        \\world";
        ,
    );
    testing::assert_eq(multiline.get(0).text, "\"hello \\");
    match multiline.get(0).error {
        Some(error) => {
            testing::assert_eq(error.message, "unterminated string literal");
            testing::assert_eq(error.start, 8);
            testing::assert_eq(error.end, 8)
        },
        None => testing::fail("expected escaped newline string metadata"),
    }
    testing::assert_eq(multiline.get(3).text, "\";")
}

#[test]
fn lexes_raw_strings_and_preserves_delimiters() -> () {
    let source =
        \\r"plain \\ text" r##"quoted "text" and #
        \\next"## r#"unterminated
    ;
    let tokens = lex(source);
    assert_token(tokens, 0, TokenKind::RawStr, "r\"plain \\\\ text\"", 0, 16);
    testing::assert(token_kind_equal(tokens.get(2).kind, TokenKind::RawStr));
    testing::assert_eq(
        tokens.get(2).text,
        \\r##"quoted "text" and #
        \\next"##
        ,
    );
    testing::assert(token_kind_equal(tokens.get(4).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(4).text, "r#\"unterminated")
}

#[test]
fn lexes_byte_strings_and_raw_byte_strings() -> () {
    let source =
        \\b"A\n\xFF" br#"raw \\ text"# br##"quoted "text" and #
        \\next"##
    ;
    let tokens = lex(source);
    assert_token(tokens, 0, TokenKind::ByteStr, "b\"A\\n\\xFF\"", 0, 10);
    testing::assert(token_kind_equal(tokens.get(2).kind, TokenKind::RawByteStr));
    testing::assert_eq(tokens.get(2).text, "br#\"raw \\\\ text\"#");
    testing::assert(token_kind_equal(tokens.get(4).kind, TokenKind::RawByteStr));
    testing::assert_eq(
        tokens.get(4).text,
        \\br##"quoted "text" and #
        \\next"##
        ,
    )
}

#[test]
fn rejects_invalid_byte_strings() -> () {
    let tokens = lex("b\"é\" b\"\\u0041\" br#\"é\"# br#\"unterminated");
    testing::assert(token_kind_equal(tokens.get(0).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(0).text, "b\"é\"");
    testing::assert(token_kind_equal(tokens.get(2).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(2).text, "b\"\\u0041\"");
    testing::assert(token_kind_equal(tokens.get(4).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(4).text, "br#\"é\"#");
    testing::assert(token_kind_equal(tokens.get(6).kind, TokenKind::Error));
    testing::assert_eq(tokens.get(6).text, "br#\"unterminated")
}

#[test]
fn skips_raw_byte_string_braces_in_interpolation() -> () {
    let tokens = lex("f\"{br#\"}\"#}\"");
    let errors = Ref::new(0);
    let raw_bytes = Ref::new(0);
    for token in tokens {
        if token_kind_equal(token.kind, TokenKind::Error) {
            errors.set(errors.get() + 1)
        } else if token_kind_equal(token.kind, TokenKind::RawByteStr) {
            raw_bytes.set(raw_bytes.get() + 1)
        }
    }
    testing::assert_eq(errors.get(), 0);
    testing::assert_eq(raw_bytes.get(), 1)
}
