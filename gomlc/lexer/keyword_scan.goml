package lexer;

use std::text;

fn keyword_scan_literal_end(source: string, start: isize) -> Option[isize] {
    let value = byte_at(source, start);
    if value == b'"' {
        let (valid, end) = scan_string(source, start);
        if valid {
            Option::Some(end)
        } else {
            Option::None
        }
    } else if value == b'\'' {
        scan_char_end(source, start)
    } else if value == b'\\' && text::starts_with_at(source, start, "\\\\") {
        scan_multiline_string_end(source, start)
    } else if value == b'r' && starts_raw_string(source, start) {
        scan_raw_string_end(source, start, raw_string_hash_count(source, start)?)
    } else if value == b'f' && text::starts_with_at(source, start, "f\"") {
        scan_fstring_end(source, start)
    } else if value == b'b' && start + 1 < source.byte_len() {
        let next = byte_at(source, start + 1);
        if next == b'"' {
            scan_byte_string_end(source, start)
        } else if next == b'\'' {
            scan_byte_char_end(source, start)
        } else if next == b'r' && starts_raw_string(source, start + 1) {
            scan_raw_string_end(source, start + 1, raw_string_hash_count(source, start + 1)?)
        } else {
            Option::Some(start)
        }
    } else {
        Option::Some(start)
    }
}

pub fn may_contain_keyword(source: string, keyword: string) -> bool {
    let mut index = 0;
    while index < source.byte_len() {
        let start = index;
        let value = byte_at(source, start);
        if value == b'/' && text::starts_with_at(source, start, "//") {
            index += 2;
            while index < source.byte_len() && byte_at(source, index) != b'\n' {
                index += 1;
            }
        } else {
            let Some(end) = keyword_scan_literal_end(source, start) else {
                return true;
            };
            if end > start {
                index = end;
            } else if is_ident_continue(value) {
                index += 1;
                while index < source.byte_len() && is_ident_continue(byte_at(source, index)) {
                    index += 1;
                }
                if index - start == keyword.byte_len()
                    && text::starts_with_at(source, start, keyword) {
                    return true
                }
            } else {
                index += 1;
            }
        }
    }
    false
}
