package lexer;

pub fn is_simd_type_name(value: string) -> bool {
    match value {
        "f32x4" | "f32x8" | "f64x2" | "f64x4" | "i8x16" | "i8x32" | "u8x16" | "u8x32" | "i16x8" | "i16x16" | "u16x8" | "u16x16" | "i32x4" | "i32x8" | "u32x4" | "u32x8" | "i64x2" | "i64x4" | "u64x2" | "u64x4" | "mask8x16" | "mask8x32" | "mask16x8" | "mask16x16" | "mask32x4" | "mask32x8" | "mask64x2" | "mask64x4" => true,
        _ => false,
    }
}
