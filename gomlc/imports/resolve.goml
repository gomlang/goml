package imports;

use module::ast;
use std::text;

pub struct AliasEntry {
    pub alias: string,
    pub target: Vec[string],
    pub item: bool,
}

pub struct ResolvedUses {
    pub aliases: Vec[AliasEntry],
    pub traits: Vec[string],
    pub public_reexports: Vec[(string, string)],
    pub diagnostics: Vec[string],
}

pub fn path_segments(path: ast::Path) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for segment in path.segments {
        result.push(segment.ident)
    }
    result
}

pub fn copy_strings(values: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

pub fn append_strings(first: Vec[string], second: Vec[string]) -> Vec[string] {
    let result = copy_strings(first);
    for value in second {
        result.push(value)
    }
    result
}

pub fn join_segments(values: Vec[string]) -> string {
    let builder = text::StringBuilder::new();
    let mut index = 0;
    for value in values {
        if index > 0 {
            builder.write_string("::")
        }
        builder.write_string(value);
        index += 1;
    }
    builder.finish()
}

pub fn last_string(values: Vec[string]) -> Option[string] {
    if values.is_empty() {
        None
    } else {
        Some(values[values.len() - 1])
    }
}

pub fn expand_use_alias(aliases: Vec[AliasEntry], target: Vec[string]) -> Option[Vec[string]] {
    if !target.is_empty() {
        for alias in aliases {
            if !alias.item && alias.alias == target[0] {
                let expanded = copy_strings(alias.target);
                for index in 1..target.len() {
                    expanded.push(target[index])
                }
                return Some(expanded)
            }
        }
    }
    None
}

pub fn prospective_use_aliases(file: ast::File) -> Vec[AliasEntry] {
    let result: Vec[AliasEntry] = Vec::new();
    for use_decl in file.uses {
        if use_decl.items.is_empty() {
            let target = path_segments(use_decl.path);
            let alias = match use_decl.alias {
                Some(value) => Option::Some(value),
                None => last_string(target),
            };
            if let Some(value) = alias {
                result.push(AliasEntry { alias: value, target, item: false })
            }
        }
    }
    result
}

fn expand_any_use_alias(aliases: Vec[AliasEntry], prospective: Vec[AliasEntry], target: Vec[string]) -> Option[
    Vec[string],
] {
    match expand_use_alias(aliases, target) {
        Some(value) => Some(value),
        None => expand_use_alias(prospective, target),
    }
}

pub fn resolved_uses_from_file(file: ast::File) -> ResolvedUses {
    let aliases: Vec[AliasEntry] = Vec::new();
    let prospective = prospective_use_aliases(file);
    let traits: Vec[string] = Vec::new();
    let public_reexports: Vec[(string, string)] = Vec::new();
    let diagnostics: Vec[string] = Vec::new();
    for use_decl in file.uses {
        let target = path_segments(use_decl.path);
        if !use_decl.items.is_empty() {
            let base = expand_any_use_alias(aliases, prospective, target).unwrap_or(target);
            for item in use_decl.items {
                let item_target = copy_strings(base);
                item_target.push(item.name);
                aliases.push(
                    AliasEntry {
                        alias: item.alias.unwrap_or(item.name),
                        target: item_target,
                        item: true,
                    },
                );
                match use_decl.visibility {
                    ast::Visibility::Public => public_reexports.push(
                        (item.alias.unwrap_or(item.name), join_segments(item_target)),
                    ),
                    ast::Visibility::Private => (),
                }
                traits.push(join_segments(item_target))
            }
        } else {
            match expand_any_use_alias(aliases, prospective, target) {
                Some(expanded) => {
                    let exported_name = use_decl.alias.unwrap_or_else(
                        || last_string(expanded).unwrap_or(""),
                    );
                    if let Some(alias) = use_decl.alias {
                        aliases.push(AliasEntry { alias, target: expanded, item: true })
                    }
                    traits.push(join_segments(expanded));
                    match use_decl.visibility {
                        ast::Visibility::Public => if exported_name != "" {
                            public_reexports.push((exported_name, join_segments(expanded)))
                        },
                        ast::Visibility::Private => (),
                    }
                },
                None => match use_decl.alias {
                    Some(alias) => {
                        aliases.push(AliasEntry { alias, target, item: false });
                        match use_decl.visibility {
                            ast::Visibility::Public => {
                                public_reexports.push((alias, join_segments(target)))
                            },
                            ast::Visibility::Private => (),
                        }
                    },
                    None => match last_string(target) {
                        Some(default_alias) => {
                            aliases.push(AliasEntry { alias: default_alias, target, item: false });
                            match use_decl.visibility {
                                ast::Visibility::Public => public_reexports.push(
                                    (default_alias, join_segments(target)),
                                ),
                                ast::Visibility::Private => (),
                            }
                        },
                        None => (),
                    },
                },
            }
        }
    }
    for index in 0..aliases.len() {
        let current = aliases[index];
        for previous_index in 0..index {
            let previous = aliases[previous_index];
            if join_segments(previous.target) == join_segments(current.target)
                && (!previous.item || !current.item || previous.alias == current.alias) {
                diagnostics.push(
                    if current.item {
                        "Duplicate imported item " + join_segments(current.target)
                    } else {
                        "Duplicate package use " + join_segments(current.target)
                    },
                )
            } else if previous.alias == current.alias {
                diagnostics.push("Ambiguous use alias " + current.alias)
            }
        }
    }
    for index in 0..public_reexports.len() {
        for previous_index in 0..index {
            if public_reexports[previous_index].0 == public_reexports[index].0 {
                diagnostics.push("Duplicate public re-export " + public_reexports[index].0)
            }
        }
    }
    ResolvedUses { aliases, traits, public_reexports, diagnostics }
}
