package go_types;

use module::repr;
use std::collections;

fn planned_map_key_uncomparable_inner(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
    visiting: collections::HashSet[string],
) -> bool {
    match repr::resolve_type(value) {
        Slice { .. } | MutSlice { .. } | GoMap { .. } | GoFunction { .. } | Func { .. } => true,
        Array { elem, .. } => planned_map_key_uncomparable_inner(elem, structs, variants, visiting),
        Tuple { items } => {
            for item in items {
                if planned_map_key_uncomparable_inner(item, structs, variants, visiting) {
                    return true
                }
            }
            false
        },
        Named { name } | ClosureEnvironment { name } => {
            if visiting.contains(name) {
                return false
            }
            let _ = visiting.insert(name);
            let mut result = false;
            if let Some(definition) = find_struct(structs, name) {
                for field in definition.fields {
                    if planned_map_key_uncomparable_inner(field.1, structs, variants, visiting) {
                        result = true;
                    }
                }
            } else if let Some(info) = variants.owners[name] {
                if let Flat = info.storage {
                    for field in info.fields {
                        if planned_map_key_uncomparable_inner(field.1, structs, variants, visiting) {
                            result = true;
                        }
                    }
                }
            }
            let _ = visiting.remove(name);
            result
        },
        _ => false,
    }
}

pub fn planned_map_key_uncomparable(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> bool {
    planned_map_key_uncomparable_inner(value, structs, variants, collections::HashSet::new())
}
