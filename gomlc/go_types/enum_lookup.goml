package go_types;

use module::repr;
use module::tast;

pub fn find_enum(values: Vec[repr::EnumDef], name: string) -> Option[repr::EnumDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Some(value)
        } else {
            index -= 1;
        }
    }
    None
}

pub fn find_struct(values: Vec[repr::StructDef], name: string) -> Option[repr::StructDef] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Some(value)
        } else {
            index -= 1;
        }
    }
    None
}

pub fn instance_by_name(values: Vec[repr::TypeInstance], name: string) -> Option[repr::TypeInstance] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Some(value)
        } else {
            index -= 1;
        }
    }
    None
}

pub fn builtin_sum_enum(
    builtin: tast::BuiltinContract,
    definition: repr::EnumDef,
    instances: Vec[repr::TypeInstance],
) -> bool {
    let base_name = match instance_by_name(instances, definition.name) {
        Some(instance) => instance.base_name,
        None => definition.name,
    };
    backend_names_match(base_name, builtin.option.name)
        || backend_names_match(base_name, builtin.result.name)
}

pub fn enum_field_types(value: repr::EnumVariantFields) -> Vec[repr::Type] {
    match value {
        Unit => Vec::new(),
        Tuple(values) => values,
        Struct(values) => {
            let result: Vec[repr::Type] = Vec::with_capacity(values.len());
            for value in values {
                result.push(value.1)
            }
            result
        },
    }
}
