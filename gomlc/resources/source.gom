pub fn standard_package_spec(package_name: string) -> Option[StandardPackageSpec] {
    for spec in standard_package_specs() {
        if spec.name == package_name {
            return Option::Some(spec)
        }
    }
    Option::None
}

pub fn standard_package_children(package_name: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for spec in standard_package_specs() {
        if package_name == STD_ROOT_PACKAGE && spec.name == STD_IO_PACKAGE {
            result.push("internal")
        }
        if spec.parent == package_name {
            result.push(spec.declared_name)
        }
    }
    result
}

fn add_standard_package_closure(result: Vec[string], package_name: string) -> () {
    for value in result {
        if value == package_name {
            return
        }
    }
    if let Some(spec) = standard_package_spec(package_name) {
        for dependency in spec.dependencies {
            add_standard_package_closure(result, dependency)
        }
        result.push(package_name)
    }
}

pub fn standard_package_closure(package_names: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for package_name in package_names {
        add_standard_package_closure(result, package_name)
    }
    result
}

fn add_standard_link_closure(result: Vec[string], package_name: string) -> () {
    for value in result {
        if value == package_name {
            return
        }
    }
    if let Some(spec) = standard_package_spec(package_name) {
        for dependency in spec.link_dependencies {
            add_standard_link_closure(result, dependency)
        }
        result.push(package_name)
    }
}

pub fn standard_package_link_closure(package_names: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for package_name in package_names {
        add_standard_link_closure(result, package_name)
    }
    result
}

pub fn toolchain_lib_dir() -> Result[string, string] {
    let executable = env::current_exe_structured().map_err(
        |error| f"could not locate compiler executable: {error}",
    )?;
    let binary_dir = path::parent(executable).ok_or(
        "compiler executable has no parent directory: " + executable,
    )?;
    let prefix = path::parent(binary_dir).ok_or(
        "compiler bin directory has no parent directory: " + binary_dir,
    )?;
    Result::Ok(path::join(prefix, "lib"))
}

fn read_sources_from_dir(lib_dir: string, category: string, relative_paths: Vec[string]) -> Result[
    Vec[Source],
    string,
] {
    let result: Vec[Source] = Vec::new();
    for relative_path in relative_paths {
        let source_path = path::join(lib_dir, relative_path);
        let source = fs::read_file_structured(source_path).map_err(
            |error| f"could not read {category} resource {source_path}: {error}",
        )?;
        result.push(Source { path: source_path, source })
    }
    Result::Ok(result)
}

fn read_sources(category: string, relative_paths: Vec[string]) -> Result[Vec[Source], string] {
    read_sources_from_dir(toolchain_lib_dir()?, category, relative_paths)
}

pub fn builtin_layer_sources() -> Result[Vec[Source], string] {
    read_sources(
        "builtin",
        Vec::from_array(
            [
                "builtin/contract.gom",
                "builtin/intrinsics.gom",
                "builtin/runtime.gom",
                "builtin/impls.gom",
                "builtin/language.gom",
                "builtin/numeric.gom",
                "builtin/derive.gom",
                "builtin/ordering.gom",
            ],
        ),
    )
}

pub fn builtin_contract_source() -> Result[Source, string] {
    let values = read_sources("builtin", Vec::from_array(["builtin/contract.gom"]))?;
    Result::Ok(values[0])
}

pub fn builtin_enum_sources() -> Result[Vec[Source], string] {
    read_sources("builtin", Vec::from_array(["builtin/contract.gom"]))
}

pub fn prelude_sources() -> Result[Vec[Source], string] {
    read_sources("prelude", Vec::from_array(["prelude/prelude.gom"]))
}

