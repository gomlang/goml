package resources;

pub struct CallableAbiSpec {
    pub key: string,
    pub source_name: string,
    pub artifact_id: string,
}

fn callable_abi(key: string, source_name: string, artifact_id: string) -> CallableAbiSpec {
    CallableAbiSpec { key, source_name, artifact_id }
}

pub fn intrinsic_abi_specs() -> Vec[CallableAbiSpec] {
    let result = Vec::from_array(
        [
            callable_abi("array.get", "array_get", "array_get"),
            callable_abi("array.set", "array_set", "array_set"),
            callable_abi("go_error.is", "go_error_is", "go_error_is"),
            callable_abi(
                "go_error.message_bytes",
                "go_error_message_bytes",
                "go_error_message_bytes",
            ),
            callable_abi("go_map.new", "go_map_new", "go_map_new"),
            callable_abi("go_map.len", "go_map_len", "go_map_len"),
            callable_abi("go_map.lookup", "go_map_lookup", "go_map_lookup"),
            callable_abi("go_map.set", "go_map_set", "go_map_set"),
            callable_abi("go_map.delete", "go_map_delete", "go_map_delete"),
            callable_abi("go_map.copy", "go_map_copy", "go_map_copy"),
            callable_abi("go_map.nil", "go_map_nil", "go_map_nil"),
            callable_abi("go_map.is_nil", "go_map_is_nil", "go_map_is_nil"),
            callable_abi("go_slice.nil", "go_slice_nil", "go_slice_nil"),
            callable_abi("go_slice.is_nil", "go_slice_is_nil", "go_slice_is_nil"),
            callable_abi("go_slice.capacity", "go_slice_capacity", "go_slice_capacity"),
            callable_abi("go_slice.append", "go_slice_append", "go_slice_append"),
            callable_abi("go_string.from_bytes", "go_string_from_bytes", "go_string_from_bytes"),
            callable_abi("go_string.from_text", "go_string_from_text", "go_string_from_text"),
            callable_abi("go_string.bytes", "go_string_bytes", "go_string_bytes"),
            callable_abi("go_error.nil", "go_error_nil", "go_error_nil"),
            callable_abi("go_error.is_nil", "go_error_is_nil", "go_error_is_nil"),
            callable_abi("go_func.from_closure", "go_func_from_closure", "go_func_from_closure"),
            callable_abi("go_func.to_closure", "go_func_to_closure", "go_func_to_closure"),
            callable_abi("go_func.nil", "go_func_nil", "go_func_nil"),
            callable_abi("go_func.is_nil", "go_func_is_nil", "go_func_is_nil"),
            callable_abi("go_ptr.null", "go_ptr_null", "go_ptr_null"),
            callable_abi("go_ptr.is_nil", "go_ptr_is_nil", "go_ptr_is_nil"),
            callable_abi("ref.new", "ref", "ref_new"),
            callable_abi("ref.get", "ref_get", "ref_get"),
            callable_abi("ref.set", "ref_set", "ref_set"),
            callable_abi("ref.ptr_eq", "ptr_eq", "ref_ptr_eq"),
            callable_abi("ref.ptr_hash", "ptr_hash", "ref_ptr_hash"),
            callable_abi("vec.new", "vec_new", "vec_new"),
            callable_abi("vec.with_capacity", "vec_with_capacity", "vec_with_capacity"),
            callable_abi("vec.push", "vec_push", "vec_push"),
            callable_abi("vec.get", "vec_get", "vec_get"),
            callable_abi("vec.set", "vec_set", "vec_set"),
            callable_abi("vec.len", "vec_len", "vec_len"),
            callable_abi("vec.capacity", "vec_capacity", "vec_capacity"),
            callable_abi("vec.reserve", "vec_reserve", "vec_reserve"),
            callable_abi("vec.truncate", "vec_truncate", "vec_truncate"),
            callable_abi("vec.from_array", "vec_from_array", "vec_from_array"),
            callable_abi("once_cell.new", "once_cell_new", "once_cell_new"),
            callable_abi("once_cell.get_or_init", "once_cell_get_or_init", "once_cell_get_or_init"),
            callable_abi("slice.new", "slice", "slice_new"),
            callable_abi("slice.get", "slice_get", "slice_get"),
            callable_abi("slice.len", "slice_len", "slice_len"),
            callable_abi("slice.sub", "slice_sub", "slice_sub"),
            callable_abi("mut_slice.new", "mut_slice", "mut_slice_new"),
            callable_abi("mut_slice.get", "mut_slice_get", "mut_slice_get"),
            callable_abi("mut_slice.set", "mut_slice_set", "mut_slice_set"),
            callable_abi("mut_slice.len", "mut_slice_len", "mut_slice_len"),
            callable_abi("mut_slice.sub", "mut_slice_sub", "mut_slice_sub"),
            callable_abi("mut_slice.as_slice", "mut_slice_as_slice", "mut_slice_as_slice"),
            callable_abi("mut_slice.copy_from", "mut_slice_copy_from", "mut_slice_copy_from"),
            callable_abi("hashmap.new", "hashmap_new", "hash_map_new"),
            callable_abi("hashmap.get", "hashmap_get", "hash_map_get"),
            callable_abi("hashmap.set", "hashmap_set", "hash_map_set"),
            callable_abi("hashmap.insert", "hashmap_insert", "hash_map_insert"),
            callable_abi(
                "hashmap.get_or_insert_with",
                "hashmap_get_or_insert_with",
                "hash_map_get_or_insert_with",
            ),
            callable_abi("hashmap.update", "hashmap_update", "hash_map_update"),
            callable_abi("hashmap.remove_value", "hashmap_remove_value", "hash_map_remove_value"),
            callable_abi("hashmap.remove", "hashmap_remove", "hash_map_remove"),
            callable_abi("hashmap.len", "hashmap_len", "hash_map_len"),
            callable_abi("hashmap.contains", "hashmap_contains", "hash_map_contains"),
            callable_abi("hashmap.entries", "hashmap_entries", "hash_map_entries"),
            callable_abi("hashmap.from_array", "hashmap_from_array", "hash_map_from_array"),
            callable_abi("channel.new", "channel_new", "channel_new"),
            callable_abi("channel.send", "channel_send", "channel_send"),
            callable_abi("channel.recv", "channel_recv", "channel_recv"),
            callable_abi("channel.send_cancel", "channel_send_cancel", "channel_send_cancel"),
            callable_abi("channel.recv_cancel", "channel_recv_cancel", "channel_recv_cancel"),
            callable_abi("channel.close", "channel_close", "channel_close"),
            callable_abi("channel.sender", "channel_sender", "channel_sender"),
            callable_abi("channel.receiver", "channel_receiver", "channel_receiver"),
            callable_abi("channel.split", "channel_split", "channel_split"),
            callable_abi(
                "channel.dynamic_select",
                "channel_dynamic_select",
                "channel_dynamic_select",
            ),
            callable_abi(
                "channel.dynamic_try_select",
                "channel_dynamic_try_select",
                "channel_dynamic_try_select",
            ),
            callable_abi(
                "channel.dynamic_try_select_priority",
                "channel_dynamic_try_select_priority",
                "channel_dynamic_try_select_priority",
            ),
            callable_abi("compiler.missing", "missing", "missing"),
        ],
    );
    for (name, operations) in simd_intrinsic_groups() {
        for operation in operations {
            result.push(
                callable_abi(
                    "simd." + name + "." + operation,
                    "simd_" + name + "_" + operation,
                    "__goml_simd_" + name + "_" + operation,
                ),
            )
        }
    }
    result
}

fn callable_abi_by_key(values: Vec[CallableAbiSpec], key: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.key == key {
            return Option::Some(value)
        }
    }
    Option::None
}

fn callable_abi_by_id(values: Vec[CallableAbiSpec], id: string) -> Option[CallableAbiSpec] {
    for value in values {
        if value.artifact_id == id {
            return Option::Some(value)
        }
    }
    Option::None
}

pub fn intrinsic_abi_by_key(key: string) -> Option[CallableAbiSpec] {
    callable_abi_by_key(intrinsic_abi_specs(), key)
}

pub fn intrinsic_abi_by_id(id: string) -> Option[CallableAbiSpec] {
    callable_abi_by_id(intrinsic_abi_specs(), id)
}
