package resources;

#[derive(PartialEq, Eq)]
pub enum RuntimeHook {
    Core(CoreRuntimeHook),
    Standard(StandardRuntimeHook),
}

#[derive(PartialEq, Eq)]
pub enum CoreRuntimeHook {
    UnitToString,
    BoolToString,
    StringLen,
    StringGet,
    StringByteGet,
    StringByteSlice,
    StringToBytes,
    StringFromUtf8,
    StringConcat,
    CharToString,
    CharFromUint32,
    IntToString,
    Int8ToString,
    Int16ToString,
    Int32ToString,
    Int64ToString,
    UintToString,
    Uint8ToString,
    Uint16ToString,
    Uint32ToString,
    Uint64ToString,
    IntHash,
    Int8Hash,
    Int16Hash,
    Int32Hash,
    Int64Hash,
    CharHash,
    UintHash,
    Uint8Hash,
    Uint16Hash,
    Uint32Hash,
    Float32Hash,
    Float64Hash,
    StringHash,
    StringPrint,
    StringPrintln,
}

#[derive(PartialEq, Eq)]
pub enum StandardRuntimeHook {
    LinuxSyscall6,
    Env(EnvRuntimeHook),
    Fs(FsRuntimeHook),
    Io(IoRuntimeHook),
    Path(PathRuntimeHook),
    Process(ProcessRuntimeHook),
    TestingFail,
    Math(MathRuntimeHook),
    Crypto(CryptoRuntimeHook),
    Time(TimeRuntimeHook),
    Task(TaskRuntimeHook),
}

#[derive(PartialEq, Eq)]
pub enum EnvRuntimeHook {
    Args,
    CurrentDir,
    CurrentExe,
    Var,
    Vars,
}

#[derive(PartialEq, Eq)]
pub enum FsRuntimeHook {
    ReadFile,
    WriteFile,
    ReadBytes,
    ReadBytesV2,
    WriteBytes,
    WriteBytesV2,
    PathOperationV2,
    MetadataV2,
    AtomicWriteV2,
    CreateDirAll,
    RemoveFile,
    RemoveDirAll,
    FileExists,
    IsFile,
    IsDir,
    Canonicalize,
    ReadDir,
    ReadDirV2,
    Sha256File,
}

#[derive(PartialEq, Eq)]
pub enum IoRuntimeHook {
    Print,
    Println,
    Eprint,
    ReadStdin,
    ReadStdinV2,
    ReadStdinExact,
    ReadStdinExactV2,
    WriteStdout,
    WriteStdoutV2,
    WriteStderr,
    WriteStderrV2,
}

#[derive(PartialEq, Eq)]
pub enum PathRuntimeHook {
    Join,
    Clean,
    IsAbsolute,
    Parent,
    FileName,
    Extension,
    FileStem,
    WithExtension,
    Absolute,
    Relative,
    Separator,
}

#[derive(PartialEq, Eq)]
pub enum ProcessRuntimeHook {
    Exit,
    LookPath,
    Output,
    OutputTimeout,
    OutputCancel,
    Status,
    StatusTimeout,
    StatusCancel,
}

#[derive(PartialEq, Eq)]
pub enum MathRuntimeHook {
    Float32Unary,
    Float32Pow,
}

#[derive(PartialEq, Eq)]
pub enum CryptoRuntimeHook {
    RandomBytes,
}

#[derive(PartialEq, Eq)]
pub enum TimeRuntimeHook {
    MonotonicNanoseconds,
    UnixNanoseconds,
    SleepNanoseconds,
    TimerNew,
    TimerStop,
}

#[derive(PartialEq, Eq)]
pub enum TaskRuntimeHook {
    ScopeNew,
    ScopeRun,
    ScopeSpawn,
    ScopeTrySpawn,
    ScopeCancel,
    ScopeFinish,
    ScopeCancelled,
    ScopeDone,
    Sleep,
    ActiveScopeCount,
}

pub struct RuntimeAbiSpec {
    pub hook: RuntimeHook,
    pub key: string,
    pub source_name: string,
    pub artifact_id: string,
}

fn runtime_abi(hook: RuntimeHook, key: string, source_name: string, artifact_id: string) -> RuntimeAbiSpec {
    RuntimeAbiSpec { hook, key, source_name, artifact_id }
}

