                "std.task.sleep",
                "scope_sleep",
                "std_task_scope_sleep",
            ),
            runtime_abi(
                RuntimeHook::Standard(StandardRuntimeHook::Task(TaskRuntimeHook::ActiveScopeCount)),
                "std.task.active_scope_count",
                "scope_count",
                "std_task_active_scope_count",
            ),
        ],
    )
}

pub fn runtime_abi_by_key(key: string) -> Option[RuntimeAbiSpec] {
    for spec in runtime_abi_specs() {
        if spec.key == key {
            return Option::Some(spec)
        }
    }
    Option::None
}

pub fn runtime_abi_by_id(id: string) -> Option[RuntimeAbiSpec] {
    for spec in runtime_abi_specs() {
        if spec.artifact_id == id {
            return Option::Some(spec)
        }
    }
    Option::None
}

pub fn runtime_abi_by_hook(hook: RuntimeHook) -> Option[RuntimeAbiSpec] {
    for spec in runtime_abi_specs() {
        if spec.hook == hook {
            return Option::Some(spec)
        }
    }
    Option::None
}
