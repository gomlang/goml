package resources;

use std::testing;

fn assert_strings(actual: Vec[string], expected: Vec[string]) -> () {
    testing::assert_eq(actual.len(), expected.len());
    for index in 0..actual.len() {
        testing::assert_eq(actual[index], expected[index])
    }
}

fn required_abi(value: Option[CallableAbiSpec]) -> CallableAbiSpec {
    match value {
        Some(spec) => spec,
        None => {
            testing::fail("expected callable ABI entry");
            callable_abi("", "", "")
        },
    }
}

fn required_runtime_abi(value: Option[RuntimeAbiSpec]) -> RuntimeAbiSpec {
    match value {
        Some(spec) => spec,
        None => {
            testing::fail("expected runtime ABI entry");
            runtime_abi(RuntimeHook::Core(CoreRuntimeHook::UnitToString), "", "", "")
        },
    }
}

#[test]
fn loads_builtin_and_prelude_layers_independently() -> () {
    match builtin_layer_sources() {
        Ok(values) => {
            testing::assert_eq(values.len(), 8);
            testing::assert(values[0].path.ends_with("/builtin/contract.gom"));
            testing::assert(values[1].path.ends_with("/builtin/intrinsics.gom"));
            testing::assert(values[2].path.ends_with("/builtin/runtime.gom"));
            testing::assert(values[3].path.ends_with("/builtin/impls.gom"));
            testing::assert(values[4].path.ends_with("/builtin/language.gom"));
            testing::assert(values[5].path.ends_with("/builtin/numeric.gom"));
            testing::assert(values[6].path.ends_with("/builtin/derive.gom"));
            testing::assert(values[7].path.ends_with("/builtin/ordering.gom"))
        },
        Err(error) => testing::fail(error.to_string()),
    }
    match prelude_sources() {
        Ok(values) => {
            testing::assert_eq(values.len(), 1);
            testing::assert(values[0].path.ends_with("/prelude/prelude.gom"))
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn exposes_explicit_prelude_builtin_surface() -> () {
    let names = prelude_builtin_export_names();
    testing::assert(names.contains("Option"));
    testing::assert(names.contains("Iterator"));
    testing::assert(names.contains("vec_new"));
    testing::assert(!names.contains("string_get_raw"));
    testing::assert(!names.contains("derive_output_new"))
}

#[test]
fn keeps_runtime_bridges_in_the_builtin_layer() -> () {
    let found_standard_runtime = Ref::new(false);
    for source in match builtin_layer_sources() {
        Ok(values) => values,
        Err(error) => {
            testing::fail(error.to_string());
            Vec::new()
        },
    } {
        if source.source.contains("#[runtime(\"std.") {
            found_standard_runtime.set(true)
        }
    }
    testing::assert(found_standard_runtime.get());
    for source in match prelude_sources() {
        Ok(values) => values,
        Err(error) => {
            testing::fail(error.to_string());
            Vec::new()
        },
    } {
        testing::assert(!source.source.contains("#[runtime("))
    }
    for spec in standard_package_specs() {
        match standard_sources(spec.name) {
            Ok(Some(values)) => for source in values {
                testing::assert(!source.source.contains("#[runtime("))
            },
            Ok(None) => testing::fail("expected standard package source"),
            Err(error) => testing::fail(error.to_string()),
        }
    }
}

#[test]
fn loads_multifile_standard_package() -> () {
    match standard_sources("std::collections") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 15),
        Ok(None) => testing::fail("expected standard package"),
        Err(error) => testing::fail(error.to_string()),
    }
    match standard_sources("std::json") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 3),
        Ok(None) => testing::fail("expected standard package"),
        Err(error) => testing::fail(error.to_string()),
    }
    match standard_sources("std::bincode") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 3),
        Ok(None) => testing::fail("expected bincode package"),
        Err(error) => testing::fail(error.to_string()),
    }
    match standard_sources("std::text") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 5),
        Ok(None) => testing::fail("expected text package"),
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn ignores_unknown_standard_package() -> () {
    for name in Vec::from_array(["example::unknown", "std::fs::notify", "std::fs::walkdir"]) {
        testing::assert(standard_package_spec(name).is_none());
        testing::assert(standard_package_closure(Vec::from_array([name])).is_empty());
        testing::assert(standard_package_link_closure(Vec::from_array([name])).is_empty());
        match standard_sources(name) {
            Ok(value) => testing::assert(value.is_none()),
            Err(error) => testing::fail(error.to_string()),
        }
    }
}

#[test]
fn pure_algorithm_packages_have_explicit_source_only_dependencies() -> () {
    assert_strings(
        standard_package_closure(Vec::from_array(["std::unicode"])),
        Vec::from_array(["std::unicode"]),
    );
    testing::assert(
        standard_package_closure(Vec::from_array(["std::text"])).contains("std::unicode"),
    );
    assert_strings(
        standard_package_closure(Vec::from_array(["std::bytes"])),
        Vec::from_array(["std::unicode", "std::bytes"]),
    );
    assert_strings(standard_package_children("std::path"), Vec::from_array(["slash"]));
    assert_strings(
        standard_package_closure(Vec::from_array(["std::path::slash"])),
        Vec::from_array(["std::path::slash"]),
    );
    assert_strings(
        standard_package_closure(Vec::from_array(["std::math::bits"])),
        Vec::from_array(["std::math::bits"]),
    );
    assert_strings(
        standard_package_link_closure(Vec::from_array(["std::hash::fnv"])),
        Vec::from_array(
            ["std::unicode", "std::bytes", "std::hash", "std::math::bits", "std::hash::fnv"],
        ),
    );
    testing::assert(!standard_package_closure(Vec::from_array(["std::hash"])).contains("std::io"));
    testing::assert(!standard_package_closure(Vec::from_array(["std::text"])).contains("std::io"));
    let text_stream = standard_package_closure(Vec::from_array(["std::text::stream"]));
    testing::assert(text_stream.contains("std::text"));
    testing::assert(text_stream.contains("std::io"));
    let hash_stream = standard_package_link_closure(Vec::from_array(["std::hash::stream"]));
    testing::assert(hash_stream.contains("std::hash"));
    testing::assert(hash_stream.contains("std::io"));
    testing::assert(!hash_stream.contains("std::hash::fnv"));
    for name in Vec::from_array(
        [
            "std::encoding::base32",
            "std::encoding::pem",
            "std::path::slash",
            "std::net::url",
            "std::collections",
            "std::utf8",
            "std::bytes",
            "std::unicode",
            "std::text",
            "std::text::stream",
            "std::text::format",
            "std::bytes::endian",
            "std::num",
            "std::bytes::endian::stream",
            "std::math::bits",
            "std::hash",
            "std::hash::adler32",
            "std::hash::crc32",
            "std::hash::crc64",
            "std::hash::fnv",
            "std::hash::stream",
        ],
    ) {
        let sources = testing::expect_some(
            testing::expect_ok(standard_sources(name), "sources"),
            "standard package",
        );
        testing::assert(!sources.is_empty());
        for source in sources {
            testing::assert(!source.source.contains("#[go_ffi("));
            testing::assert(!source.source.contains("extern fn"));
            testing::assert(!source.source.contains("module::internal::host"));
        }
    }
}

#[test]
fn text_format_package_has_source_only_dependencies() -> () {
    let spec = testing::expect_some(
        standard_package_spec(STD_TEXT_FORMAT_PACKAGE),
        "text format package",
    );
    testing::assert_eq(spec.declared_name, "format");
    assert_strings(
        spec.source_paths,
        Vec::from_array(
            [
                "std/text/format/model.gom",
                "std/text/format/text.gom",
                "std/text/format/numeric.gom",
                "std/text/format/io.gom",
            ],
        ),
    );
    let dependencies = Vec::from_array(
        [STD_TEXT_PACKAGE, STD_NUM_PACKAGE, STD_BYTES_PACKAGE, STD_IO_PACKAGE],
    );
    assert_strings(spec.dependencies, dependencies);
    assert_strings(spec.link_dependencies, dependencies);
    testing::assert(standard_package_children(STD_TEXT_PACKAGE).contains("format"));
    let closure = standard_package_closure(Vec::from_array([STD_TEXT_FORMAT_PACKAGE]));
    let linked = standard_package_link_closure(Vec::from_array([STD_TEXT_FORMAT_PACKAGE]));
    for dependency in dependencies {
        testing::assert(closure.contains(dependency));
        testing::assert(linked.contains(dependency));
    }
    testing::assert(
        !standard_package_closure(Vec::from_array([STD_TEXT_PACKAGE])).contains(
            STD_TEXT_FORMAT_PACKAGE,
        ),
    );
    testing::assert(
        !standard_package_closure(Vec::from_array([STD_IO_PACKAGE])).contains(
            STD_TEXT_FORMAT_PACKAGE,
        ),
    );
}

#[test]
fn exposes_standard_package_sources_dependencies_and_namespaces_from_one_catalog() -> () {
    let net = testing::expect_some(standard_package_spec("std::net"), "network package metadata");
    let net_dependencies = Vec::from_array(
        ["std::cmp", "std::context", "std::io", "std::os::linux::syscall", "std::task", "std::time"],
    );
    assert_strings(net.dependencies, net_dependencies);
    assert_strings(net.link_dependencies, net_dependencies);
    let fs = match standard_package_spec("std::fs") {
        Some(value) => value,
        None => {
            testing::fail("expected std::fs package metadata");
            standard_package("", "", "", Vec::new(), Vec::new(), Vec::new())
        },
    };
    testing::assert_eq(fs.declared_name, "fs");
    assert_strings(
        fs.source_paths,
        Vec::from_array(
            [
                "std/fs/error.gom",
                "std/fs/fs.gom",
                "std/fs/portable.gom",
                "std/fs/sub.gom",
                "std/fs/directory.gom",
                "std/fs/read_directory.gom",
                "std/fs/walk.gom",
                "std/fs/glob.gom",
                "std/fs/links.gom",
                "std/fs/mode.gom",
                "std/fs/format.gom",
            ],
        ),
    );
    assert_strings(
        fs.dependencies,
        Vec::from_array(
            [
                "std::bytes",
                "std::collections",
                "std::internal::host",
                "std::io",
                "std::path::slash",
                "std::utf8",
            ],
        ),
    );
    assert_strings(
        fs.link_dependencies,
        Vec::from_array(
            [
                "std::bytes",
                "std::collections",
                "std::internal::host",
                "std::io",
                "std::path::slash",
                "std::utf8",
            ],
        ),
    );
    let memory = testing::expect_some(
        standard_package_spec("std::testing::fs"),
        "memory filesystem package",
    );
    testing::assert_eq(memory.declared_name, "fs");
    assert_strings(
        memory.source_paths,
        Vec::from_array(
            [
                "std/testing/fs/model.gom",
                "std/testing/fs/resolve.gom",
                "std/testing/fs/handle.gom",
                "std/testing/fs/check_model.gom",
                "std/testing/fs/check_runtime.gom",
                "std/testing/fs/check_file.gom",
                "std/testing/fs/check_directory.gom",
                "std/testing/fs/check_tree.gom",
                "std/testing/fs/check_capabilities.gom",
                "std/testing/fs/check_seek.gom",
                "std/testing/fs/check_read_at.gom",
                "std/testing/fs/check_links.gom",
                "std/testing/fs/check_observed.gom",
                "std/testing/fs/check_helpers.gom",
            ],
        ),
    );
    let memory_dependencies = Vec::from_array(
        ["std::bytes", "std::collections", "std::fs", "std::io", "std::panic"],
    );
    assert_strings(memory.dependencies, memory_dependencies);
    assert_strings(memory.link_dependencies, memory_dependencies);
    let host = match standard_package_spec("std::internal::host") {
        Some(value) => value,
        None => {
            testing::fail("expected std::internal::host package metadata");
            standard_package("", "", "", Vec::new(), Vec::new(), Vec::new())
        },
    };
    assert_strings(host.source_paths, Vec::from_array(["std/internal/host/host.gom"]));
    assert_strings(
        standard_package_children("std"),
        Vec::from_array(
            [
                "ascii",
                "bincode",
                "bytes",
                "channel",
                "context",
                "cmp",
                "collections",
                "error",
                "crypto",
                "encoding",
                "hash",
                "ffi",
                "c",
                "env",
                "fs",
                "net",
                "internal",
                "io",
                "iter",
                "json",
                "num",
                "math",
                "simd",
                "os",
                "path",
                "panic",
                "process",
                "resource",
                "rand",
                "serde",
                "task",
                "testing",
                "text",
                "toml",
                "time",
                "utf8",
                "utf16",
                "unicode",
            ],
        ),
    );
    assert_strings(
        standard_package_children("std::internal"),
        Vec::from_array(["host", "task", "syscall", "linux"]),
    );
    assert_strings(standard_package_children("std::fs"), Vec::new());
    assert_strings(standard_package_children("std::encoding::base32"), Vec::from_array(["stream"]));
    let base32_stream_dependencies = standard_package_closure(
        Vec::from_array(["std::encoding::base32::stream"]),
    );
    testing::assert(base32_stream_dependencies.contains("std::io"));
    testing::assert(base32_stream_dependencies.contains("std::encoding::base32"));
    testing::assert(
        !standard_package_closure(Vec::from_array(["std::encoding::base32"])).contains("std::io"),
    );
    assert_strings(standard_package_children("std::net"), Vec::from_array(["url", "tls"]));
    let url_dependencies = standard_package_link_closure(Vec::from_array(["std::net::url"]));
    testing::assert(url_dependencies.contains("std::bytes"));
    testing::assert(!url_dependencies.contains("std::net"));
    testing::assert(!url_dependencies.contains("std::io"));
    testing::assert(!url_dependencies.contains("std::internal::host"));
    assert_strings(standard_package_children("std::bytes"), Vec::from_array(["endian"]));
    assert_strings(standard_package_children("std::bytes::endian"), Vec::from_array(["stream"]));
    let stream_dependencies = standard_package_closure(
        Vec::from_array(["std::bytes::endian::stream"]),
    );
    testing::assert(stream_dependencies.contains("std::io"));
    testing::assert(stream_dependencies.contains("std::bytes::endian"));
    testing::assert(
        !standard_package_closure(Vec::from_array(["std::bytes::endian"])).contains("std::io"),
    );
    assert_strings(standard_package_children("std::crypto"), Vec::from_array(["hash", "rand"]));
    assert_strings(
        standard_package_children("std::encoding"),
        Vec::from_array(["base32", "base64", "pem", "hex"]),
    );
    assert_strings(
        standard_package_children("std::hash"),
        Vec::from_array(["adler32", "crc32", "crc64", "fnv", "stream"]),
    );
    assert_strings(standard_package_children("std::math"), Vec::from_array(["bits"]));
    assert_strings(standard_package_children("std::os"), Vec::from_array(["linux"]));
    assert_strings(
        standard_package_children("std::os::linux"),
        Vec::from_array(["syscall", "abi", "fd", "memory", "process", "ipc"]),
    );
    let syscall_packages = Vec::from_array(["std::internal::syscall", "std::os::linux::syscall"]);
    assert_strings(
        standard_package_closure(Vec::from_array(["std::os::linux::syscall"])),
        syscall_packages,
    );
    assert_strings(
        standard_package_link_closure(Vec::from_array(["std::os::linux::syscall"])),
        syscall_packages,
    );
    match standard_sources("std::serde") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 6),
        Ok(None) => testing::fail("expected serde package"),
        Err(error) => testing::fail(error.to_string()),
    }
    match standard_sources("std::toml") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 2),
        Ok(None) => testing::fail("expected TOML package"),
        Err(error) => testing::fail(error.to_string()),
    }
    match standard_sources("std::error") {
        Ok(Some(values)) => testing::assert_eq(values.len(), 1),
        Ok(None) => testing::fail("expected error package"),
        Err(error) => testing::fail(error.to_string()),
    }
    assert_strings(
        standard_package_closure(Vec::from_array(["std::json", "std::fs"])),
        Vec::from_array(
            [
                "std::internal::host",
                "std::unicode",
                "std::bytes",
                "std::utf8",
                "std::resource",
                "std::io",
                "std::num",
                "std::serde",
                "std::ascii",
                "std::text",
                "std::json",
                "std::cmp",
                "std::collections",
                "std::path::slash",
                "std::fs",
            ],
        ),
    );
    assert_strings(
        standard_package_link_closure(Vec::from_array(["std::json", "std::fs"])),
        Vec::from_array(
            [
                "std::internal::host",
                "std::unicode",
                "std::bytes",
                "std::utf8",
                "std::resource",
                "std::io",
                "std::num",
                "std::serde",
                "std::ascii",
                "std::text",
                "std::json",
                "std::cmp",
                "std::collections",
                "std::path::slash",
                "std::fs",
            ],
        ),
    )
}

#[test]
fn linux_descriptor_packages_keep_their_abi_dependencies() -> () {
    let expected = Vec::from_array(
        [
            "std::unicode",
            "std::bytes",
            "std::internal::host",
            "std::utf8",
            "std::resource",
            "std::io",
            "std::internal::syscall",
            "std::os::linux::syscall",
            "std::internal::linux",
            "std::bytes::endian",
            "std::os::linux::abi",
            "std::os::linux::fd",
        ],
    );
    assert_strings(standard_package_closure(Vec::from_array(["std::os::linux::fd"])), expected);
    assert_strings(standard_package_link_closure(Vec::from_array(["std::os::linux::fd"])), expected);
}

#[test]
fn intrinsic_abi_catalog_is_isolated_from_returned_vectors() -> () {
    let values = intrinsic_abi_specs();
    let count = values.len();
    let original = values[count - 1];
    values[count - 1] = callable_abi("unknown.key", "unknown_source", "unknown_id");
    values.clear();
    let fresh = intrinsic_abi_specs();
    testing::assert_eq(fresh.len(), count);
    testing::assert_eq(fresh[count - 1].key, original.key);
    testing::assert_eq(fresh[count - 1].source_name, original.source_name);
    testing::assert_eq(fresh[count - 1].artifact_id, original.artifact_id);
    testing::assert_eq(
        required_abi(intrinsic_abi_by_key(original.key)).artifact_id,
        original.artifact_id,
    );
    testing::assert_eq(required_abi(intrinsic_abi_by_id(original.artifact_id)).key, original.key);
    testing::assert(intrinsic_abi_by_key("unknown.key").is_none());
    testing::assert(intrinsic_abi_by_id("unknown_id").is_none())
}

#[test]
fn callable_abi_catalog_round_trips_keys_and_ids() -> () {
    for spec in intrinsic_abi_specs() {
        testing::assert_eq(
            required_abi(intrinsic_abi_by_key(spec.key)).artifact_id,
            spec.artifact_id,
        );
        testing::assert_eq(required_abi(intrinsic_abi_by_id(spec.artifact_id)).key, spec.key)
    }
    let runtime_specs = runtime_abi_specs();
    testing::assert_eq(runtime_specs.len(), 123);
    for left in 0..runtime_specs.len() {
        for right in left + 1..runtime_specs.len() {
            testing::assert(runtime_specs[left].hook != runtime_specs[right].hook);
            testing::assert(runtime_specs[left].key != runtime_specs[right].key);
            testing::assert(runtime_specs[left].artifact_id != runtime_specs[right].artifact_id)
        }
    }
    for spec in runtime_specs {
        testing::assert_eq(
            required_runtime_abi(runtime_abi_by_key(spec.key)).artifact_id,
            spec.artifact_id,
        );
        testing::assert_eq(required_runtime_abi(runtime_abi_by_id(spec.artifact_id)).key, spec.key);
        testing::assert_eq(required_runtime_abi(runtime_abi_by_hook(spec.hook)).key, spec.key)
    }
}
