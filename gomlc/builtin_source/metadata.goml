package builtin_source;

pub fn lang_items() -> Result[Vec[BuiltinLangItem], string] {
    Ok(builtin_source_lang_items.get_or_init(|| load_builtin_source_lang_items())?.to_vec())
}

pub fn inherent_methods() -> Vec[(string, string)] {
    builtin_source_inherent_methods.get_or_init(|| load_builtin_source_inherent_methods()).to_vec()
}

pub fn install_metadata(lang_items: Vec[BuiltinLangItem], inherent_methods: Vec[(string, string)]) -> Result[
    (),
    string,
] {
    let _ = builtin_source_lang_items.get_or_init(|| Ok(lang_items.freeze()))?;
    let _ = builtin_source_inherent_methods.get_or_init(|| inherent_methods.freeze());
    Ok(())
}
