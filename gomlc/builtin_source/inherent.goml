package builtin_source;

use module::hir;
use module::names::{short_name};

static builtin_source_inherent_methods: OnceCell[FrozenVec[(string, string)]] = OnceCell::new();

fn load_builtin_source_inherent_methods() -> FrozenVec[(string, string)] {
    let result: Vec[(string, string)] = Vec::new();
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for item in file.items {
            if let hir::Item::ImplBlock(value) = item {
                if let Some(name) = builtin_lang_item_type_name(value.for_type) {
                    for method in value.methods {
                        result.push((short_name(name), method.name));
                    }
                }
            }
        }
    }
    result.freeze()
}
