package numeric;

use std::testing;

#[test]
fn normalizes_integer_bases_without_machine_width_limits() -> () {
    match normalize_integer("0b1111_0000") {
        Some(value) => testing::assert_eq(value, "240"),
        None => testing::fail("expected binary integer"),
    }
    match normalize_integer("0o17_777") {
        Some(value) => testing::assert_eq(value, "8191"),
        None => testing::fail("expected octal integer"),
    }
    match normalize_integer("0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF") {
        Some(value) => testing::assert_eq(value, "340282366920938463463374607431768211455"),
        None => testing::fail("expected hexadecimal integer"),
    }
    match normalize_integer("1_000_000") {
        Some(value) => testing::assert_eq(value, "1000000"),
        None => testing::fail("expected decimal integer"),
    }
}

#[test]
fn rejects_invalid_normalized_integers() -> () {
    if let Some(_) = normalize_integer("0x") {
        testing::fail("expected missing hexadecimal digits")
    }
    if let Some(_) = normalize_integer("0b102") {
        testing::fail("expected invalid binary digit")
    }
    if let Some(_) = normalize_integer("0o8") {
        testing::fail("expected invalid octal digit")
    }
    if let Some(_) = normalize_integer("0x_1") {
        testing::fail("expected invalid leading separator")
    }
    if let Some(_) = normalize_integer("10_") {
        testing::fail("expected invalid trailing separator")
    }
}

fn assert_float_integer(value: string, expected: string) -> () {
    match normalize_float_integer(value, 20) {
        Some(actual) => testing::assert_eq(actual, expected),
        None => testing::fail("expected exact integer float"),
    }
}

fn assert_non_integer_float(value: string) -> () {
    if let Some(_) = normalize_float_integer(value, 20) {
        testing::fail("expected non-integer float")
    }
}

#[test]
fn normalizes_exact_float_integers_without_rounding() -> () {
    assert_float_integer("1.0", "1");
    assert_float_integer("1.23e2", "123");
    assert_float_integer("1200e-2", "12");
    assert_float_integer("-42.000", "-42");
    assert_float_integer("0e-999999", "0");
    assert_float_integer("9007199254740993.0", "9007199254740993");
    assert_float_integer("9223372036854775807.0", "9223372036854775807");
    assert_float_integer("18446744073709551615.0", "18446744073709551615");
    assert_non_integer_float("1.5");
    assert_non_integer_float("1201e-2");
    assert_non_integer_float("1.0000000000000001");
    assert_non_integer_float("1e-999999");
    assert_non_integer_float("1e999999")
}

#[test]
fn parses_valid_float32() -> () {
    match parse_float32("3.5") {
        Some(value) => testing::assert(value == 3.5),
        None => testing::fail("expected f32"),
    }
    if let Some(_) = parse_float32("not-a-number") {
        testing::fail("expected invalid f32")
    }
}
