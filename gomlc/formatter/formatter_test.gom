#[test]
fn rejects_invalid_source() -> () {
    match format_source("fn main( {") {
        Ok(_) => testing::fail("invalid source formatted"),
        Err(error) => testing::assert(!error.diagnostics.is_empty()),
    }
}

#[test]
fn formats_select_arms_vertically() -> () {
    expect_format(
        "fn choose(input:Channel[isize],output:Channel[isize])->isize{select{recv(input)as value=>value.unwrap_or(0),send(output,1)=>2,default=>{let fallback=3;fallback},}}",
        \\fn choose(input: Channel[isize], output: Channel[isize]) -> isize {
        \\    select {
        \\        recv(input) as value => value.unwrap_or(0),
        \\        send(output, 1) => 2,
        \\        default => {
        \\            let fallback = 3;
        \\            fallback
        \\        },
        \\    }
        \\}
        \\
        ,
    )
}

#[test]
fn formats_advanced_select_arms() -> () {
    expect_format(
        "fn choose(input:Channel[isize],output:Channel[isize])->isize{select priority{recv(input)when true match{Some(value)=>value,None=>0,},send(output,1)when false=>2,default=>3,}}",
        \\fn choose(input: Channel[isize], output: Channel[isize]) -> isize {
        \\    select priority {
        \\        recv(input) when true match {
        \\            Some(value) => value,
        \\            None => 0,
        \\        },
        \\        send(output, 1) when false => 2,
        \\        default => 3,
        \\    }
        \\}
        \\
        ,
    )
}

