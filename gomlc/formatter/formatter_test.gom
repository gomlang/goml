package formatter;

use module::lexer;
use module::parser;
use std::env;
use std::fs;
use std::path;
use std::testing;
use std::text;

#[test]
fn format_go_interface_mapping() -> () {
    expect_format(
        "#[go_interface(raw::Reader,ReaderAdapter,read=\"Read\")]pub trait Reader{fn read(self:Self,buffer:ffi::RawSlice[u8])->(isize,ffi::Error);}",
        "#[go_interface(raw::Reader,ReaderAdapter,read=\"Read\")]\npub trait Reader {\n    fn read(self: Self, buffer: ffi::RawSlice[u8]) -> (isize, ffi::Error);\n}\n",
    );
}

fn token_signature(source: string) -> string {
    let parsed = parser::parse(source);
    format_token_signature(source, located_node(parsed.root, 0))
}

fn token_kind_signature(source: string, expected: lexer::TokenKind) -> string {
    let output = text::StringBuilder::new();
    for token in lexer::lex(source) {
        if lexer::token_kind_equal(token.kind, expected) {
            output.write_string(lexer::encode_text_hex(token.text));
            output.write_string("\n")
        }
    }
    output.finish()
}

fn literal_token(kind: lexer::TokenKind) -> bool {
    match kind {
        Float | IntLit | Str | RawStr | MultilineStr | FStringStart | FStringText | FStringExprStart | FStringExprEnd | FStringEnd | CharLit | ByteCharLit | ByteStr | RawByteStr => true,
        _ => false,
    }
}

fn literal_signature(source: string) -> string {
    let output = text::StringBuilder::new();
    for token in lexer::lex(source) {
        if literal_token(token.kind) {
            output.write_string(lexer::token_kind_name(token.kind));
            output.write_string(":");
            output.write_string(lexer::encode_text_hex(format_token_text(token)));
            output.write_string("\n")
        }
    }
    output.finish()
}

fn has_trailing_space(source: string) -> bool {
    let tokens = lexer::lex(source);
    for index in 0..source.byte_len() {
        let byte = source.byte_get(index);
        if byte == 10 && index > 0 {
            let previous = source.byte_get(index - 1);
            if (previous == 32 || previous == 9)
                && !inside_multiline_or_raw_string(tokens, index - 1) {
                return true
            }
        }
    }
    false
}

fn inside_multiline_or_raw_string(tokens: Vec[lexer::Token], position: isize) -> bool {
    let mut index = 0;
    while index < tokens.len() {
        let token = tokens[index];
        if token.start <= position && position < token.end {
            match token.kind {
                MultilineStr | RawStr | RawByteStr => {
                    return true
                },
                _ => (),
            }
        }
        index += 1;
    }
    false
}

fn has_carriage_return(source: string) -> bool {
    for index in 0..source.byte_len() {
        if source.byte_get(index) == 13 {
            return true
        }
    }
    false
}

fn expect_format(source: string, expected: string) -> () {
    match format_source(source) {
        Ok(formatted) => {
            testing::assert_eq(formatted, expected);
            testing::assert_eq(parser::parse(formatted).diagnostics.len(), 0);
            match format_source(formatted) {
                Ok(again) => testing::assert_eq(again, formatted),
                Err(_) => testing::fail("second format failed"),
            }
        },
        Err(_) => testing::fail("format failed"),
    }
}

fn repository_root() -> string {
    env::var_structured("GOML_REPO").unwrap_or("..")
}

fn read_fixture(path_value: string) -> string {
    match fs::read_file_structured(path_value) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(f"{path_value}: {error}");
            ""
        },
    }
}

fn assert_format_invariants(source: string, formatted: string) -> () {
    testing::assert_eq(parser::parse(formatted).diagnostics.len(), 0);
    match format_source(formatted) {
        Ok(again) => testing::assert_eq(again, formatted),
        Err(_) => testing::fail("second format failed"),
    }
    testing::assert_eq(token_signature(formatted), token_signature(source));
    testing::assert_eq(literal_signature(formatted), literal_signature(source));
    testing::assert_eq(
        token_kind_signature(formatted, lexer::TokenKind::Comment),
        token_kind_signature(source, lexer::TokenKind::Comment),
    );
    testing::assert(!has_trailing_space(formatted))
}

fn formatter_fixture_root() -> string {
    path::join(repository_root(), "gomlc/testdata/formatter")
}

fn formatter_golden_path(name: string) -> string {
    let suffix = ".input.gom";
    name.byte_slice(0, name.byte_len() - suffix.byte_len()) + ".golden.gom"
}

#[test]
fn formatter_goldens_match() -> () {
    let root = formatter_fixture_root();
    let names = match fs::read_dir(root) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            Vec::new()
        },
    };
    for name in names {
        if name.ends_with(".input.gom") {
            let input_path = path::join(root, name);
            let golden_path = path::join(root, formatter_golden_path(name));
            let source = read_fixture(input_path);
            let formatted = match format_source(source) {
                Ok(value) => value,
                Err(_) => {
                    testing::fail("fixture format failed: " + name);
                    ""
                },
            };
            if env::var_structured("UPDATE_EXPECT").is_ok() {
                if let Err(error) = fs::write_file_structured(golden_path, formatted) {
                    testing::fail(error.to_string())
                }
            } else {
                testing::assert_eq(formatted, read_fixture(golden_path))
            }
            assert_format_invariants(source, formatted)
        }
    }
}

#[test]
fn formats_basic_file() -> () {
    expect_format(
        \\package main;
        \\use alpha::beta;
        \\fn main( )->(){let x=call(1,2,3);x}
        \\
        ,
        \\package main;
        \\
        \\use alpha::beta;
        \\
        \\fn main() -> () {
        \\    let x = call(1, 2, 3);
        \\    x
        \\}
        \\
        ,
    )
}

#[test]
fn formats_empty_tuple_function_types() -> () {
    expect_format(
        "type Callback=(()) ->();fn consume(value:(),callback:Callback)->(){callback(value)}",
        \\type Callback = (()) -> ();
        \\
        \\fn consume(value: (), callback: Callback) -> () {
        \\    callback(value)
        \\}
        \\
        ,
    )
}

#[test]
fn formats_multiline_strings_as_indented_blocks() -> () {
    expect_format(
        "fn main()->(){let poem=\\\\  first\n  \\\\second\n;println(poem)}",
        "fn main() -> () {\n    let poem =\n        \\\\  first\n        \\\\second\n    ;\n    println(poem)\n}\n",
    );
    expect_format(
        "fn poem()->string{\\\\first\n \\\\second\n}",
        "fn poem() -> string {\n    \\\\first\n    \\\\second\n}\n",
    );
    expect_format(
        "fn main()->(){consume(\\\\first\n\t\\\\second\n);}",
        "fn main() -> () {\n    consume(\n        \\\\first\n        \\\\second\n        ,\n    );\n}\n",
    );
    expect_format(
        "fn combine()->string{\"prefix\"+\\\\first\n \\\\second\n}",
        "fn combine() -> string {\n    \"prefix\" +\n        \\\\first\n        \\\\second\n}\n",
    )
}

#[test]
fn renders_flat_and_broken_groups() -> () {
    let docs = doc_builder();
    let document = docs.group(
        concat(
            Vec::from_array(
                [
                    text("call("),
                    Doc::Line,
                    indent(
                        join(
                            concat2(text(","), Doc::SoftLine),
                            Vec::from_array([text("first"), text("second")]),
                        ),
                    ),
                    Doc::Line,
                    text(")"),
                ],
            ),
        ),
    ).doc;
    testing::assert_eq(render(document, 40), "call(first, second)");
    testing::assert_eq(
        render(document, 10),
        \\call(
        \\    first,
        \\    second
        \\)
        ,
    )
}

#[test]
fn renders_nested_groups_independently() -> () {
    let docs = doc_builder();
    let inner = docs.group(
        concat(
            Vec::from_array(
                [
                    text("inner("),
                    Doc::Line,
                    indent(
                        join(
                            concat2(text(","), Doc::SoftLine),
                            Vec::from_array([text("one"), text("two")]),
                        ),
                    ),
                    Doc::Line,
                    text(")"),
                ],
            ),
        ),
    ).doc;
    let outer = docs.group(
        concat(Vec::from_array([text("a_very_long_outer_prefix"), Doc::SoftLine, indent(inner)])),
    ).doc;
    testing::assert_eq(
        render(outer, 28),
        \\a_very_long_outer_prefix
        \\    inner(one, two)
        ,
    )
}

#[test]
fn measures_unicode_by_codepoint() -> () {
    let docs = doc_builder();
    let fits = docs.group(concat(Vec::from_array([text("你好"), Doc::SoftLine, text("世界")]))).doc;
    testing::assert_eq(render(fits, 5), "你好 世界");
    let breaks = doc_builder().group(
        concat(Vec::from_array([text("你好"), Doc::SoftLine, text("世界")])),
    ).doc;
    testing::assert_eq(
        render(breaks, 4),
        \\你好
        \\世界
        ,
    )
}

#[test]
fn renders_conditional_commas_suffixes_and_verbatim_text() -> () {
    let docs = doc_builder();
    let id = docs.new_group_id();
    let list = docs.group_with_id(
        id,
        concat(
            Vec::from_array(
                [
                    text("["),
                    Doc::Line,
                    indent(
                        concat(Vec::from_array([text("alphabet"), if_break(id, text(","), nil())])),
                    ),
                    Doc::Line,
                    text("]"),
                    line_suffix(concat2(text(" "), text("// 尾注释"))),
                    Doc::HardLine,
                    verbatim(
                        \\\\raw
                        \\\\text
                        ,
                    ),
                ],
            ),
        ),
    ).doc;
    testing::assert_eq(
        render(list, 8),
        \\[
        \\    alphabet,
        \\] // 尾注释
        \\\\raw
        \\\\text
        ,
    )
}

#[test]
fn normalizes_line_endings_and_empty_input() -> () {
    match format_source("") {
        Ok(formatted) => testing::assert_eq(formatted, ""),
        Err(_) => testing::fail("empty format failed"),
    }
    match format_source("fn main() -> () {\r\n    ()\r\n}\r\n\r\n") {
        Ok(formatted) => {
            testing::assert(!has_carriage_return(formatted));
            testing::assert(formatted.ends_with("\n"));
            testing::assert(!formatted.ends_with("\n\n"))
        },
        Err(_) => testing::fail("line ending format failed"),
    }
}

#[test]
fn preserves_tokens_literals_comments_and_ast() -> () {
    let source =
        \\fn sample() -> () { // 注释
        \\let value = Vec::from_array([0xFF_FF, 1_000]); let ch = '\u0041'; let byte = b'\xFF'; let text = f"值={value.get(0)}"; () }
        \\
    ;
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_block_and_byte_string_expressions_losslessly() -> () {
    let source =
        \\fn bytes()->Vec[byte]{let plain=b"A\n\xFF";let raw=br#"first
        \\second"#;{let selected=raw;selected}}
        \\
    ;
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_lexical_task_scope_contextual_forms_losslessly() -> () {
    let source = "use std::task;fn main()->(){let task=scope{spawn|cancel|cancel.is_cancelled()};let scope=1;let spawn=|value:isize|value;println(spawn(scope));let _=task;}\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted)
}

#[test]
fn formats_comptime_contextually_without_reserving_the_name() -> () {
    let source = "#[comptime]fn factorial(value:isize)->isize{if value<2{1}else{value*factorial(value-1)}}fn comptime()->isize{1}fn main()->isize{let value=comptime{factorial(4)};value+comptime()}\n";
    let formatted = match format_source(source) {
        Ok(value) => value,
        Err(_) => {
            testing::fail("format failed");
            ""
        },
    };
    assert_format_invariants(source, formatted);
    testing::assert(formatted.contains("let value = comptime {"));
    testing::assert(formatted.contains("value + comptime()"))
}

#[test]
fn removes_redundant_unit_expressions_and_semicolons() -> () {
    expect_format(
        "fn empty()->(){;;;()}fn control(flag:bool,values:Vec[isize])->(){while flag{();};for value in values{let _=value;()};loop{break;};if flag{()}else{();};match flag{true=>(),false=>(),};()}fn retain(flag:bool)->(){if flag{1}else{2};match flag{true=>1,false=>2,};loop{break 1};}fn boundary(values:Vec[isize])->(Vec[isize],Vec[isize]){for value in values{let _=value;};(values,values)}",
        \\fn empty() -> () {}
        \\
        \\fn control(flag: bool, values: Vec[isize]) -> () {
        \\    while flag {}
        \\    for value in values {
        \\        let _ = value;
        \\    }
        \\    loop {
        \\        break;
        \\    }
        \\    if flag {}
        \\    match flag {
        \\        true => (),
        \\        false => (),
        \\    };
        \\}
        \\
        \\fn retain(flag: bool) -> () {
        \\    if flag {
        \\        1
        \\    } else {
        \\        2
        \\    }
        \\    match flag {
        \\        true => 1,
        \\        false => 2,
        \\    }
        \\    loop {
        \\        break 1
        \\    };
        \\}
        \\
        \\fn boundary(values: Vec[isize]) -> (Vec[isize], Vec[isize]) {
        \\    for value in values {
        \\        let _ = value;
        \\    };
        \\    (values, values)
        \\}
        \\
        ,
    )
}

#[test]
fn normalizes_empty_else_and_braced_control_statements() -> () {
    expect_format(
        \\fn flow(flag:bool,ch:Channel[isize])->(){if flag{println("first")}else{};if flag{println("yes")}else{println("no")};match flag{true=>println("yes"),false=>println("no"),};select{recv(ch)as _=>(),default=>(),};println("done")}fn nested(first:bool,second:bool)->(){if first{println("first")}else if second{println("second")}else{()};}fn value(flag:bool)->(){let _=if flag{()}else{};if flag{1}else{2};}fn comments(flag:bool)->(){if flag{}else{
        \\// keep
        \\};}
        ,
        \\fn flow(flag: bool, ch: Channel[isize]) -> () {
        \\    if flag {
        \\        println("first")
        \\    }
        \\    if flag {
        \\        println("yes")
        \\    } else {
        \\        println("no")
        \\    }
        \\    match flag {
        \\        true => println("yes"),
        \\        false => println("no"),
        \\    }
        \\    select {
        \\        recv(ch) as _ => (),
        \\        default => (),
        \\    }
        \\    println("done")
        \\}
        \\
        \\fn nested(first: bool, second: bool) -> () {
        \\    if first {
        \\        println("first")
        \\    } else if second {
        \\        println("second")
        \\    }
        \\}
        \\
        \\fn value(flag: bool) -> () {
        \\    let _ = if flag {};
        \\    if flag {
        \\        1
        \\    } else {
        \\        2
        \\    };
        \\}
        \\
        \\fn comments(flag: bool) -> () {
        \\    if flag {} else {
        \\        // keep
        \\    };
        \\}
        \\
        ,
    )
}

#[test]
fn normalizes_empty_if_let_else() -> () {
    expect_format(
        "fn inspect(candidate:Option[isize])->(){if let Some(value)=candidate{println(value)}else{};}",
        \\fn inspect(candidate: Option[isize]) -> () {
        \\    if let Some(value) = candidate {
        \\        println(value)
        \\    }
        \\}
        \\
        ,
    )
}

#[test]
fn preserves_control_semicolons_before_expression_continuations() -> () {
    expect_format(
        "fn if_boundary(flag:bool)->(){if flag{}else{};(println)(\"if\")}fn match_boundary(flag:bool)->(){match flag{true=>(),false=>(),};(println)(\"match\")}fn select_boundary(channel:Channel[isize])->(){select{recv(channel)as _=>(),default=>(),};(println)(\"select\")}fn select_value(channel:Channel[isize])->(){select{recv(channel)as _=>1,default=>2,};}",
        \\fn if_boundary(flag: bool) -> () {
        \\    if flag {};
        \\    (println)("if")
        \\}
        \\
        \\fn match_boundary(flag: bool) -> () {
        \\    match flag {
        \\        true => (),
        \\        false => (),
        \\    };
        \\    (println)("match")
        \\}
        \\
        \\fn select_boundary(channel: Channel[isize]) -> () {
        \\    select {
        \\        recv(channel) as _ => (),
        \\        default => (),
        \\    };
        \\    (println)("select")
        \\}
        \\
        \\fn select_value(channel: Channel[isize]) -> () {
        \\    select {
        \\        recv(channel) as _ => 1,
        \\        default => 2,
        \\    };
        \\}
        \\
        ,
    )
}

#[test]
fn preserves_semicolons_after_labeled_while_and_for_statements() -> () {
    expect_format(
        "fn main(values:Vec[isize])->(){'retry:while false{continue 'retry;};println(1);'items:for value in values{let _=value;break 'items;};println(2)}",
        \\fn main(values: Vec[isize]) -> () {
        \\    'retry: while false {
        \\        continue 'retry;
        \\    };
        \\    println(1);
        \\    'items: for value in values {
        \\        let _ = value;
        \\        break 'items;
        \\    };
        \\    println(2)
        \\}
        \\
        ,
    )
}

#[test]
fn formats_enum_variants_like_rustfmt() -> () {
    expect_format(
        "enum Compact[T]{None,One{value:T},Two(T)}enum Expanded[T]{One{value:T},Pair{left:T,right:T},Other{value:T}}enum Wide{First{value:ExtremelyLongTypeNameThatMakesTheVariantExceedTheConfiguredOneHundredColumnLineWidth},Second{value:isize}}",
        \\enum Compact[T] {
        \\    None,
        \\    One { value: T },
        \\    Two(T),
        \\}
        \\
        \\enum Expanded[T] {
        \\    One {
        \\        value: T,
        \\    },
        \\    Pair {
        \\        left: T,
        \\        right: T,
        \\    },
        \\    Other {
        \\        value: T,
        \\    },
        \\}
        \\
        \\enum Wide {
        \\    First {
        \\        value: ExtremelyLongTypeNameThatMakesTheVariantExceedTheConfiguredOneHundredColumnLineWidth,
        \\    },
        \\    Second {
        \\        value: isize,
        \\    },
        \\}
        \\
        ,
    )
}

