#[test]
fn formats_raw_ffi_boundary_types_and_receiver_bindings() -> () {
    expect_format(
        "type Pointer=ffi::Ptr[File];type Error=ffi::Error;type Text=ffi::String;type Rune=ffi::Rune;type Buffer=ffi::RawSlice[byte];type Files=ffi::RawMap[ffi::String,ffi::Ptr[File]];#[go_method(\"Read\")]extern fn read(file:Pointer,buffer:Buffer)->(isize,Error);",
        "type Pointer = ffi::Ptr[File];\n\ntype Error = ffi::Error;\n\ntype Text = ffi::String;\n\ntype Rune = ffi::Rune;\n\ntype Buffer = ffi::RawSlice[byte];\n\ntype Files = ffi::RawMap[ffi::String, ffi::Ptr[File]];\n\n#[go_method(\"Read\")]\nextern fn read(file: Pointer, buffer: Buffer) -> (isize, Error);\n",
    )
}
