package formatter;

pub enum Doc {
    Nil,
    Text(string, isize),
    Verbatim(string),
    MultilineString(Vec[string]),
    Concat(Vec[Doc]),
    Group(isize, Doc),
    IfBreak(isize, Doc, Doc),
    SoftLine,
    Line,
    HardLine,
    Indent(Doc),
    LineSuffix(Doc),
    BreakParent,
}

struct DocBuilder {
    next_group: Ref[isize],
}

struct GroupedDoc {
    id: isize,
    doc: Doc,
}

fn doc_builder() -> DocBuilder {
    DocBuilder { next_group: Ref::new(0) }
}

fn nil() -> Doc {
    Doc::Nil
}

fn codepoint_width(value: string) -> isize {
    let width: Ref[isize] = Ref::new(0);
    for _ in value.chars() {
        width.set(width.get() + 1)
    }
    width.get()
}

fn text(value: string) -> Doc {
    if value == "" {
        Doc::Nil
    } else {
        Doc::Text(value, codepoint_width(value))
    }
}

fn verbatim(value: string) -> Doc {
    if value == "" {
        Doc::Nil
    } else {
        Doc::Verbatim(value)
    }
}

fn multiline_string(value: string) -> Doc {
    Doc::MultilineString(multiline_string_lines(value))
}

fn concat(values: Vec[Doc]) -> Doc {
    let flattened: Vec[Doc] = Vec::new();
    for value in values {
        match value {
            Nil => (),
            Concat(children) => for child in children {
                match child {
                    Nil => (),
                    _ => flattened.push(child),
                }
            },
            _ => flattened.push(value),
        }
    }
    if flattened.is_empty() {
        Doc::Nil
    } else if flattened.len() == 1 {
        flattened[0]
    } else {
        Doc::Concat(flattened)
    }
}

fn concat2(first: Doc, second: Doc) -> Doc {
    concat(Vec::from_array([first, second]))
}

fn concat3(first: Doc, second: Doc, third: Doc) -> Doc {
    concat(Vec::from_array([first, second, third]))
}

fn indent(value: Doc) -> Doc {
    match value {
        Nil => Doc::Nil,
        _ => Doc::Indent(value),
    }
}

fn if_break(group_id: isize, broken: Doc, flat: Doc) -> Doc {
    Doc::IfBreak(group_id, broken, flat)
}

fn line_suffix(value: Doc) -> Doc {
    Doc::LineSuffix(value)
}

fn join(separator: Doc, values: Vec[Doc]) -> Doc {
    let result: Vec[Doc] = Vec::new();
    for index in 0..values.len() {
        if index > 0 {
            result.push(separator)
        }
        result.push(values[index])
    }
    concat(result)
}

impl DocBuilder {
    fn new_group_id(self: DocBuilder) -> isize {
        let id = self.next_group.get();
        self.next_group.set(id + 1);
        id
    }

    fn group_with_id(self: DocBuilder, id: isize, content: Doc) -> GroupedDoc {
        GroupedDoc { id, doc: Doc::Group(id, content) }
    }

    fn group(self: DocBuilder, content: Doc) -> GroupedDoc {
        let id = self.new_group_id();
        self.group_with_id(id, content)
    }
}
