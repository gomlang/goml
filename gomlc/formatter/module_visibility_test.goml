package formatter;

#[test]
fn format_module_visibility_in_imports_fields_and_methods() -> () {
    expect_format(
        "pub ( module ) use module::api::{Value};pub(module) struct State{pub (module) value:isize}impl State{pub(module) fn read(self:State)->isize{self.value}}",
        "pub(module) use module::api::{Value};\n\npub(module) struct State {\n    pub(module) value: isize,\n}\n\nimpl State {\n    pub(module) fn read(self: State) -> isize {\n        self.value\n    }\n}\n",
    );
}
