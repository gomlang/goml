package formatter;

use std::collections;
use std::text;

enum RenderMode {
    Flat,
    Broken,
}

struct Renderer {
    output: text::StringBuilder,
    column: Ref[isize],
    indent_level: Ref[isize],
    line_width: isize,
    line_start: Ref[bool],
    broken_groups: collections::BitSet,
    suffixes: collections::Deque[Doc],
}

fn renderer(line_width: isize) -> Renderer {
    Renderer {
        output: text::StringBuilder::new(),
        column: Ref::new(0),
        indent_level: Ref::new(0),
        line_width,
        line_start: Ref::new(true),
        broken_groups: collections::BitSet::new(),
        suffixes: collections::Deque::new(),
    }
}

fn render_mode_flat(mode: RenderMode) -> bool {
    match mode {
        Flat => true,
        Broken => false,
    }
}

fn string_contains_newline(value: string) -> bool {
    for index in 0..value.byte_len() {
        if value.byte_get(index) == b'\n' {
            return true
        }
    }
    false
}

fn limited_add(left: isize, right: isize, limit: isize) -> isize {
    if left > limit || right > limit || left > limit - right {
        limit + 1
    } else {
        left + right
    }
}

fn flat_width(value: Doc, broken_groups: collections::BitSet, limit: isize) -> isize {
    match value {
        Nil => 0,
        Text(_, width) => if width > limit {
            limit + 1
        } else {
            width
        },
        Verbatim(text_value) => if string_contains_newline(text_value) {
            limit + 1
        } else {
            let width = codepoint_width(text_value);
            if width > limit {
                limit + 1
            } else {
                width
            }
        },
        MultilineString(_) => limit + 1,
        Concat(values) => {
            let width: Ref[isize] = Ref::new(0);
            for child in values {
                width.set(
                    limited_add(
                        width.get(),
                        flat_width(
                            child,
                            broken_groups,
                            limit
                                - if width.get() > limit {
                                    limit
                                } else {
                                    width.get()
                                },
                        ),
                        limit,
                    ),
                )
            }
            width.get()
        },
        Group(id, content) => if broken_groups.contains(id) {
            limit + 1
        } else {
            flat_width(content, broken_groups, limit)
        },
        IfBreak(id, broken, flat) => if broken_groups.contains(id) {
            flat_width(broken, broken_groups, limit)
        } else {
            flat_width(flat, broken_groups, limit)
        },
        SoftLine => if limit < 1 {
            limit + 1
        } else {
            1
        },
        Line => 0,
        HardLine => limit + 1,
        Indent(content) => flat_width(content, broken_groups, limit),
        LineSuffix(_) => 0,
        BreakParent => limit + 1,
    }
}

fn write_indent(value: Renderer) -> () {
    if value.line_start.get() {
        for _ in 0..value.indent_level.get() {
            value.output.write_string("    ")
        }
        value.column.set(value.indent_level.get() * 4);
        value.line_start.set(false)
    }
}

fn write_text(value: Renderer, content: string, width: isize) -> () {
    if content == "" {} else {
        write_indent(value);
        value.output.write_string(content);
        value.column.set(value.column.get() + width)
    }
}

fn raw_last_line_width(content: string) -> isize {
    let start: Ref[isize] = Ref::new(0);
    for index in 0..content.byte_len() {
        if content.byte_get(index) == b'\n' {
            start.set(index + 1)
        }
    }
    codepoint_width(content.byte_slice(start.get(), content.byte_len()))
}

fn write_verbatim(value: Renderer, content: string) -> () {
    if content == "" {} else {
        write_indent(value);
        value.output.write_string(content);
        if string_contains_newline(content) {
            let width = raw_last_line_width(content);
            value.column.set(width);
            value.line_start.set(width == 0)
        } else {
            value.column.set(value.column.get() + codepoint_width(content))
        }
    }
}

fn write_multiline_string(value: Renderer, lines: Vec[string]) -> () {
    if lines.is_empty() {} else {
        let nested = !value.line_start.get();
        if nested {
            write_newline(value);
            value.indent_level.set(value.indent_level.get() + 1)
        }
        for index in 0..lines.len() {
            if index > 0 {
                write_newline(value)
            }
            write_text(value, lines[index], codepoint_width(lines[index]))
        }
        write_newline(value);
        if nested {
            value.indent_level.set(value.indent_level.get() - 1)
        }
    }
}

fn flush_suffixes(value: Renderer) -> () {
    while !value.suffixes.is_empty() {
        if let Some(suffix) = value.suffixes.pop_front() {
            render_doc(value, suffix, RenderMode::Flat)
        }
    }
}

fn write_newline(value: Renderer) -> () {
    flush_suffixes(value);
    value.output.write_char('\n');
    value.column.set(0);
    value.line_start.set(true)
}

fn render_group(value: Renderer, id: isize, content: Doc, mode: RenderMode) -> () {
    if render_mode_flat(mode) {
        render_doc(value, content, RenderMode::Flat)
    } else {
        let decision_column = if value.line_start.get() {
            value.indent_level.get() * 4
        } else {
            value.column.get()
        };
        let remaining = if decision_column >= value.line_width {
            0
        } else {
            value.line_width - decision_column
        };
        if flat_width(content, value.broken_groups, remaining) > remaining {
            let _ = value.broken_groups.insert(id);
            render_doc(value, content, RenderMode::Broken)
        } else {
            render_doc(value, content, RenderMode::Flat)
        }
    }
}

fn render_doc(value: Renderer, doc: Doc, mode: RenderMode) -> () {
    match doc {
        Nil => (),
        Text(content, width) => write_text(value, content, width),
        Verbatim(content) => write_verbatim(value, content),
        MultilineString(lines) => write_multiline_string(value, lines),
        Concat(values) => for child in values {
            render_doc(value, child, mode)
        },
        Group(id, content) => render_group(value, id, content, mode),
        IfBreak(id, broken, flat) => if value.broken_groups.contains(id) {
            render_doc(value, broken, RenderMode::Broken)
        } else {
            render_doc(value, flat, mode)
        },
        SoftLine => if render_mode_flat(mode) {
            write_text(value, " ", 1)
        } else {
            write_newline(value)
        },
        Line => if render_mode_flat(mode) {} else {
            write_newline(value)
        },
        HardLine => write_newline(value),
        Indent(content) => {
            value.indent_level.set(value.indent_level.get() + 1);
            render_doc(value, content, mode);
            value.indent_level.set(value.indent_level.get() - 1)
        },
        LineSuffix(content) => value.suffixes.push_back(content),
        BreakParent => (),
    }
}

fn render(value: Doc, line_width: isize) -> string {
    let output = renderer(line_width);
    render_doc(output, value, RenderMode::Broken);
    flush_suffixes(output);
    output.output.finish()
}
