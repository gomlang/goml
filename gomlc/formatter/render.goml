package formatter;

use std::collections;
use std::text;

enum RenderMode {
    Flat,
    Broken,
}

struct Renderer {
    output: text::StringBuilder,
    column: Ref[isize],
    indent_level: Ref[isize],
    line_width: isize,
    line_start: Ref[bool],
    broken_groups: collections::BitSet,
    suffixes: collections::Deque[Doc],
}

fn renderer(line_width: isize) -> Renderer {
    Renderer {
        output: text::StringBuilder::new(),
        column: Ref::new(0),
        indent_level: Ref::new(0),
        line_width,
        line_start: Ref::new(true),
        broken_groups: collections::BitSet::new(),
        suffixes: collections::Deque::new(),
    }
}

fn render_mode_flat(mode: RenderMode) -> bool {
    match mode {
        Flat => true,
        Broken => false,
    }
}

fn last_line_start(value: string) -> Option[isize] {
    let mut index = value.byte_len() - 1;
    while index >= 0 {
        if value.byte_get(index) == b'\n' {
            return Some(index + 1)
        }
        index -= 1;
    }
    None
}

fn flat_width(value: Doc, broken_groups: collections::BitSet, limit: isize) -> isize {
    match value {
        Nil => 0,
        Text(_, width) => if width > limit {
            limit + 1
        } else {
            width
        },
        Verbatim(text_value) => if last_line_start(text_value).is_some() {
            limit + 1
        } else {
            let width = codepoint_width(text_value);
            if width > limit {
                limit + 1
            } else {
                width
            }
        },
        MultilineString(_) => limit + 1,
        Concat(values) => {
            let mut width: isize = 0;
            for child in values {
                let remaining = limit - width;
                let child_width = flat_width(child, broken_groups, remaining);
                if child_width > remaining {
                    return limit + 1
                }
                width += child_width;
            }
            width
        },
        Group(id, content) => if broken_groups.contains(id) {
            limit + 1
        } else {
            flat_width(content, broken_groups, limit)
        },
        IfBreak(id, broken, flat) => if broken_groups.contains(id) {
            flat_width(broken, broken_groups, limit)
        } else {
            flat_width(flat, broken_groups, limit)
        },
        SoftLine => if limit < 1 {
            limit + 1
        } else {
            1
        },
        Line => 0,
        HardLine => limit + 1,
        Indent(content) => flat_width(content, broken_groups, limit),
        LineSuffix(_) => 0,
        BreakParent => limit + 1,
    }
}

impl Renderer {
    fn write_indent(self: Renderer) -> () {
        if self.line_start.get() {
            for _ in 0..self.indent_level.get() {
                self.output.write_string("    ")
            }
            self.column.set(self.indent_level.get() * 4);
            self.line_start.set(false)
        }
    }

    fn write_text(self: Renderer, content: string, width: isize) -> () {
        if content != "" {
            self.write_indent();
            self.output.write_string(content);
            self.column.set(self.column.get() + width)
        }
    }

    fn write_verbatim(self: Renderer, content: string) -> () {
        if content != "" {
            self.write_indent();
            self.output.write_string(content);
            if let Some(start) = last_line_start(content) {
                let width = codepoint_width(content.byte_slice(start, content.byte_len()));
                self.column.set(width);
                self.line_start.set(width == 0)
            } else {
                self.column.set(self.column.get() + codepoint_width(content))
            }
        }
    }

    fn write_multiline_string(self: Renderer, lines: Vec[string]) -> () {
        if !lines.is_empty() {
            let nested = !self.line_start.get();
            if nested {
                self.write_newline();
                self.indent_level.set(self.indent_level.get() + 1)
            }
            for index in 0..lines.len() {
                if index > 0 {
                    self.write_newline()
                }
                self.write_text(lines[index], codepoint_width(lines[index]))
            }
            self.write_newline();
            if nested {
                self.indent_level.set(self.indent_level.get() - 1)
            }
        }
    }

    fn flush_suffixes(self: Renderer) -> () {
        while let Some(suffix) = self.suffixes.pop_front() {
            self.render_doc(suffix, RenderMode::Flat)
        }
    }

    fn write_newline(self: Renderer) -> () {
        self.flush_suffixes();
        self.output.write_char('\n');
        self.column.set(0);
        self.line_start.set(true)
    }

    fn render_group(self: Renderer, id: isize, content: Doc, mode: RenderMode) -> () {
        if render_mode_flat(mode) {
            self.render_doc(content, RenderMode::Flat)
        } else {
            let decision_column = if self.line_start.get() {
                self.indent_level.get() * 4
            } else {
                self.column.get()
            };
            let remaining = if decision_column >= self.line_width {
                0
            } else {
                self.line_width - decision_column
            };
            if flat_width(content, self.broken_groups, remaining) > remaining {
                let _ = self.broken_groups.insert(id);
                self.render_doc(content, RenderMode::Broken)
            } else {
                self.render_doc(content, RenderMode::Flat)
            }
        }
    }

    fn render_doc(self: Renderer, doc: Doc, mode: RenderMode) -> () {
        match doc {
            Nil => (),
            Text(content, width) => self.write_text(content, width),
            Verbatim(content) => self.write_verbatim(content),
            MultilineString(lines) => self.write_multiline_string(lines),
            Concat(values) => for child in values {
                self.render_doc(child, mode)
            },
            Group(id, content) => self.render_group(id, content, mode),
            IfBreak(id, broken, flat) => if self.broken_groups.contains(id) {
                self.render_doc(broken, RenderMode::Broken)
            } else {
                self.render_doc(flat, mode)
            },
            SoftLine => if render_mode_flat(mode) {
                self.write_text(" ", 1)
            } else {
                self.write_newline()
            },
            Line => if !render_mode_flat(mode) {
                self.write_newline()
            },
            HardLine => self.write_newline(),
            Indent(content) => {
                self.indent_level.set(self.indent_level.get() + 1);
                self.render_doc(content, mode);
                self.indent_level.set(self.indent_level.get() - 1)
            },
            LineSuffix(content) => self.suffixes.push_back(content),
            BreakParent => (),
        }
    }
}

fn render(value: Doc, line_width: isize) -> string {
    let output = renderer(line_width);
    output.render_doc(value, RenderMode::Broken);
    output.flush_suffixes();
    output.output.finish()
}
