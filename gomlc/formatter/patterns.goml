package formatter;

use module::cst;

fn node_kind_is_pattern(kind: cst::NodeKind) -> bool {
    match kind {
        PATTERN | PATTERN_UNIT | PATTERN_BOOL | PATTERN_STRING | PATTERN_INT | PATTERN_FLOAT | PATTERN_CHAR | PATTERN_BYTE | PATTERN_TUPLE | PATTERN_ARRAY | PATTERN_CONSTR | PATTERN_VARIABLE | PATTERN_WILDCARD | PATTERN_ALIAS | PATTERN_OR | PATTERN_RANGE | PATTERN_REST | STRUCT_PATTERN_FIELD | STRUCT_PATTERN_FIELD_LIST => true,
        _ => false,
    }
}

fn format_pattern(value: Builder, node: LocatedNode) -> BuiltDoc {
    if node_kind_is_delimited_list(cst::node_kind(node.node)) {
        format_delimited_list(value, node)
    } else {
        format_generic(value, node)
    }
}
