package formatter;

use module::cst;
use module::lexer;
use std::text;

struct LocatedNode {
    node: cst::CstNode,
    start: isize,
    end: isize,
}

struct LocatedToken {
    token: lexer::Token,
    start: isize,
    end: isize,
}

enum LocatedElement {
    Node(LocatedNode),
    Token(LocatedToken),
}

struct ChildCursor {
    elements: Vec[cst::CstElement],
    index: Ref[isize],
    offset: Ref[isize],
}

fn located_node(node: cst::CstNode, start: isize) -> LocatedNode {
    LocatedNode { node, start, end: start + cst::node_byte_len(node) }
}

fn child_cursor(value: LocatedNode) -> ChildCursor {
    ChildCursor {
        elements: cst::node_children(value.node),
        index: Ref::new(0),
        offset: Ref::new(value.start),
    }
}

fn node_is(value: LocatedNode, kind: cst::NodeKind) -> bool {
    cst::node_kind_equal(cst::node_kind(value.node), kind)
}

fn token_is(value: LocatedToken, kind: lexer::TokenKind) -> bool {
    lexer::token_kind_equal(value.token.kind, kind)
}

impl ChildCursor {
    fn remaining(self: ChildCursor) -> isize {
        self.elements.len() - self.index.get()
    }

    fn peek(self: ChildCursor) -> Option[LocatedElement] {
        if self.index.get() < self.elements.len() {
            let element = self.elements[self.index.get()];
            let start = self.offset.get();
            let end = start + cst::element_byte_len(element);
            Option::Some(
                match element {
                    Node(node) => LocatedElement::Node(LocatedNode { node, start, end }),
                    Token(token) => LocatedElement::Token(LocatedToken { token, start, end }),
                },
            )
        } else {
            Option::None
        }
    }

    fn next(self: ChildCursor) -> Option[LocatedElement] {
        match self.peek() {
            Some(value) => {
                self.offset.set(
                    match value {
                        Node(node) => node.end,
                        Token(token) => token.end,
                    },
                );
                self.index.set(self.index.get() + 1);
                Option::Some(value)
            },
            None => Option::None,
        }
    }
}

fn first_significant_token(value: LocatedNode) -> Option[LocatedToken] {
    let cursor = child_cursor(value);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(node)) => if let Some(token) = first_significant_token(node) {
                return Option::Some(token)
            },
            Some(Token(token)) => if !lexer::token_is_trivia(token.token.kind) {
                return Option::Some(token)
            },
            None => (),
        }
    }
    Option::None
}

fn last_significant_token(value: LocatedNode) -> Option[LocatedToken] {
    let elements = cst::node_children(value.node);
    let mut index = elements.len() - 1;
    let mut end = value.end;
    while index >= 0 {
        let start = end - cst::element_byte_len(elements[index]);
        match elements[index] {
            Node(node) => if let Some(token) = last_significant_token(
                LocatedNode { node, start, end },
            ) {
                return Option::Some(token)
            },
            Token(token) => if !lexer::token_is_trivia(token.kind) {
                return Option::Some(LocatedToken { token, start, end })
            },
        }
        end = start;
        index -= 1;
    }
    Option::None
}

fn node_has_comment(value: LocatedNode) -> bool {
    let cursor = child_cursor(value);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(node)) => if node_has_comment(node) {
                return true
            },
            Some(Token(token)) => if token_is(token, lexer::TokenKind::Comment) {
                return true
            },
            None => (),
        }
    }
    false
}

fn write_node_source(value: LocatedNode, output: text::StringBuilder) -> () {
    let cursor = child_cursor(value);
    while cursor.remaining() > 0 {
        match cursor.next() {
            Some(Node(node)) => write_node_source(node, output),
            Some(Token(token)) => output.write_string(token.token.text),
            None => (),
        }
    }
}

fn node_source(value: LocatedNode) -> string {
    let output = text::StringBuilder::with_capacity(value.end - value.start);
    write_node_source(value, output);
    output.finish()
}

fn node_significant_source(value: LocatedNode) -> string {
    match (first_significant_token(value), last_significant_token(value)) {
        (Some(first), Some(last)) => {
            let source = node_source(value);
            source.byte_slice(first.start - value.start, last.end - value.start)
        },
        _ => "",
    }
}

fn direct_nodes(value: LocatedNode) -> Vec[LocatedNode] {
    let result: Vec[LocatedNode] = Vec::new();
    let cursor = child_cursor(value);
    while cursor.remaining() > 0 {
        if let Some(Node(node)) = cursor.next() {
            result.push(node)
        }
    }
    result
}
