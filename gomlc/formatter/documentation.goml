package formatter;

use module::cst;
use module::doc_comment;
use module::lexer;

fn documentation_declaration(kind: cst::NodeKind) -> bool {
    match kind {
        FN | EXTERN | EXTERN_TYPE | STRUCT | ENUM | TRAIT | IMPL | TYPE_ALIAS | CONST | STATIC | USE | TRAIT_METHOD_SIG | TRAIT_ASSOCIATED_TYPE | IMPL_ASSOCIATED_TYPE | VARIANT | STRUCT_FIELD | NEWTYPE_FIELD | ENUM_TUPLE_FIELD => true,
        _ => false,
    }
}

fn collect_attached_documentation(
    node: LocatedNode,
    comments: Vec[doc_comment::Comment],
    result: Vec[doc_comment::Comment],
) -> () {
    if documentation_declaration(node.node.kind) {
        if let Some(token) = first_significant_token(node) {
            for comment in comments {
                if comment.target == token.start {
                    result.push(comment)
                }
            }
        }
    }
    let cursor = child_cursor(node);
    while let Some(element) = cursor.next() {
        if let Node(child) = element {
            collect_attached_documentation(child, comments, result)
        }
    }
}

fn attach_documentation_node(node: LocatedNode, source: string, comments: Vec[doc_comment::Comment]) -> cst::CstNode {
    let children = Vec::new();
    if documentation_declaration(node.node.kind) {
        if let Some(token) = first_significant_token(node) {
            for comment in comments {
                if comment.target == token.start {
                    for prefix in lexer::lex(source.byte_slice(comment.start, comment.target)) {
                        children.push(cst::CstElement::Token(prefix))
                    }
                }
            }
        }
    }
    let cursor = child_cursor(node);
    while let Some(element) = cursor.next() {
        match element {
            Node(child) => children.push(
                cst::CstElement::Node(attach_documentation_node(child, source, comments)),
            ),
            Token(token) => {
                let mut moved = false;
                for comment in comments {
                    if token.start >= comment.start && token.end <= comment.target {
                        moved = true;
                    }
                }
                if !moved {
                    children.push(cst::CstElement::Token(token.token))
                }
            },
        }
    }
    let mut byte_len = 0;
    for child in children {
        byte_len += cst::element_byte_len(child);
    }
    cst::node(node.node.kind, children, byte_len)
}

fn attach_documentation(root: LocatedNode, source: string) -> LocatedNode {
    let root = located_node(lift_documentation_trivia(root.node).0, 0);
    let comments = doc_comment::collect(source);
    let attached = Vec::new();
    collect_attached_documentation(root, comments.items, attached);
    if attached.is_empty() {
        root
    } else {
        located_node(attach_documentation_node(root, source, attached), 0)
    }
}

fn lift_documentation_trivia(node: cst::CstNode) -> (cst::CstNode, Vec[cst::CstElement]) {
    let children = Vec::new();
    for child in node.children {
        match child {
            Node(value) => {
                let lifted = lift_documentation_trivia(value);
                children.push(cst::CstElement::Node(lifted.0));
                for trivia in lifted.1 {
                    children.push(trivia)
                }
            },
            Token(_) => children.push(child),
        }
    }
    let mut start = children.len();
    let mut has_documentation = false;
    while start > 0 {
        match children[start - 1] {
            Token(token) => if lexer::token_is_trivia(token.kind) {
                if token.kind == lexer::TokenKind::Comment && doc_comment::is_outer(token.text) {
                    has_documentation = true;
                }
                start -= 1;
            } else {
                break
            },
            Node(_) => break,
        }
    }
    if !has_documentation || node.kind == cst::NodeKind::FILE {
        start = children.len();
    }
    let kept = Vec::new();
    let trailing = Vec::new();
    let mut byte_len = 0;
    for index in 0..children.len() {
        if index < start {
            kept.push(children[index]);
            byte_len += cst::element_byte_len(children[index]);
        } else {
            trailing.push(children[index])
        }
    }
    return (cst::node(node.kind, kept, byte_len), trailing)
}
