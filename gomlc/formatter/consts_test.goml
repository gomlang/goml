package formatter;

#[test]
fn formats_const_generics_lengths_and_associated_constants() -> () {
    expect_format(
        "struct Buffer[T,const N:usize]{values:[T;N+1]}\ntrait Capacity{const LIMIT:usize;const LABEL:string=\"buffer\";}\nimpl[const N:usize] Buffer[i32,N]{pub const SIZE:usize=N;}",
        "struct Buffer[T, const N: usize] {\n    values: [T; N + 1],\n}\n\ntrait Capacity {\n    const LIMIT: usize;\n    const LABEL: string = \"buffer\";\n}\n\nimpl[const N: usize] Buffer[i32, N] {\n    pub const SIZE: usize = N;\n}\n",
    )
}
