package formatter;

#[test]
fn syntax_extensions_format_repetition_and_chained_conditions() -> () {
    expect_format(
        "fn choose(value:Option[isize])->[isize;2]{if let Some(x)=value&&x>0&&let Some(y)=Some(x+1){[y;2]}else{[0;2]}}\nfn drain(next:()->Option[isize]){while let Some(x)=next()&&(x==1||x==2){println(x);}}",
        "fn choose(value: Option[isize]) -> [isize; 2] {\n    if let Some(x) = value && x > 0 && let Some(y) = Some(x + 1) {\n        [y; 2]\n    } else {\n        [0; 2]\n    }\n}\n\nfn drain(next: () -> Option[isize]) {\n    while let Some(x) = next() && (x == 1 || x == 2) {\n        println(x);\n    }\n}\n",
    )
}

#[test]
fn syntax_extensions_format_opaque_and_dynamic_bounds() -> () {
    expect_format(
        "fn make[T](value:T)->impl Source[T,Item=string]+Label{value}\nfn erase(value:dyn Source[isize,Item=string]+Label)->dyn Label+Source[isize,Item=string]{value}",
        "fn make[T](value: T) -> impl Source[T, Item = string] + Label {\n    value\n}\n\nfn erase(value: dyn Source[isize, Item = string] + Label) -> dyn Label + Source[isize, Item = string] {\n    value\n}\n",
    )
}
