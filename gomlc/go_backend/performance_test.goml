package go_backend;

use module::go_ir::{Type, Expr, Block, Stmt, Function, Item, File};
use module::go_ir::{function_doc};
use module::pretty;
use std::testing;

#[test]
fn performance_facts_count_static_operations_and_exact_function_bytes() -> () {
    let array = Type::Array { len: 64, elem: Int };
    let field = Expr::Field { expr: Var { name: "state" }, field_name: "memory" };
    let function = Function {
        name: "work",
        params: Vec::from_array([("callback", Type::Func { params: Vec::new(), ret_ty: Int })]),
        ret_ty: Some(Int),
        body: Block {
            stmts: Vec::from_array(
                [
                    Stmt::Var { name: "copy", ty: array, value: Some(field) },
                    Stmt::Var {
                        name: "projection",
                        ty: Pointer { elem: array },
                        value: Some(Unary { op: Address, expr: field }),
                    },
                    Stmt::Expr { expr: Call { func: Var { name: "callback" }, args: Vec::new() } },
                    Stmt::LabeledLoop {
                        label: "Shared_exit",
                        body: Block {
                            stmts: Vec::from_array([Stmt::BreakLabel { label: "Shared_exit" }]),
                        },
                    },
                    Stmt::Return {
                        expr: Some(
                            Expr::Index { base: Var { name: "copy" }, index: Int { value: "0" } },
                        ),
                    },
                ],
            ),
        },
    };
    let records = performance_functions(File { items: Vec::from_array([Item::Function(function)]) });
    testing::assert_eq(records.len(), 1);
    let record = records[0];
    testing::assert_eq(record.name, "work");
    testing::assert_eq(record.bytes, pretty::pretty(100, function_doc(function)).byte_len());
    testing::assert_eq(record.value_copies, 1);
    testing::assert_eq(record.borrowed_projections, 1);
    testing::assert_eq(record.indexed_accesses, 1);
    testing::assert_eq(record.indirect_calls, 1);
    testing::assert_eq(record.function_literals, 0);
    testing::assert_eq(record.shared_continuations, 1);
}
