package go_backend;

use std::testing;

#[test]
fn go_expression_printing_preserves_precedence_and_grouping() -> () {
    let a = Expr::Var { name: "a" };
    let b = Expr::Var { name: "b" };
    let c = Expr::Var { name: "c" };
    let cases = Vec::from_array(
        [
            (
                Expr::Binary {
                    op: BinaryOp::Shr,
                    lhs: a,
                    rhs: Expr::Binary { op: BinaryOp::Mul, lhs: b, rhs: c },
                },
                "a >> (b * c)",
            ),
            (
                Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Binary { op: BinaryOp::Add, lhs: a, rhs: b },
                    rhs: c,
                },
                "(a + b) * c",
            ),
            (
                Expr::Binary {
                    op: BinaryOp::Sub,
                    lhs: a,
                    rhs: Expr::Binary { op: BinaryOp::Sub, lhs: b, rhs: c },
                },
                "a - (b - c)",
            ),
            (
                Expr::Binary {
                    op: BinaryOp::BitAnd,
                    lhs: a,
                    rhs: Expr::Binary { op: BinaryOp::Add, lhs: b, rhs: c },
                },
                "a & (b + c)",
            ),
            (
                Expr::Unary { op: UnaryOp::Neg, expr: Expr::Unary { op: UnaryOp::Neg, expr: a } },
                "-(-a)",
            ),
            (
                Expr::Unary {
                    op: UnaryOp::Deref,
                    expr: Expr::Binary { op: BinaryOp::Add, lhs: a, rhs: b },
                },
                "*(a + b)",
            ),
            (Expr::Index { base: Expr::Unary { op: UnaryOp::Deref, expr: a }, index: b }, "(*a)[b]"),
            (
                Expr::Call { func: Expr::Unary { op: UnaryOp::Deref, expr: a }, args: Vec::new() },
                "(*a)()",
            ),
        ],
    );
    for (expression, expected) in cases {
        testing::assert_eq(expr_doc(expression).render(1000), expected);
    }
}
