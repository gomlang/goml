package go_backend;

use module::repr;
use std::testing;

#[test]
fn pointer_container_names_do_not_collide_with_user_types() -> () {
    let pointer = repr::Type::GoPointer { elem: repr::Type::Int64 };
    let named = repr::Type::Named { name: type_name(pointer) };
    let pointer_tuple = repr::Type::Tuple { items: Vec::from_array([pointer]) };
    let named_tuple = repr::Type::Tuple { items: Vec::from_array([named]) };
    testing::assert(type_name(pointer_tuple) != type_name(named_tuple));
    testing::assert(encode_type(pointer) != encode_type(named));
    testing::assert(
        type_name(pointer) != type_name(repr::Type::RefType { elem: repr::Type::Int64 }),
    );
}
