package go_backend;

use std::collections;

type NameSet = collections::IndexSet[string];

fn new_name_set() -> NameSet {
    collections::IndexSet::new()
}

fn name_present(values: NameSet, expected: string) -> bool {
    values.contains(expected)
}

fn add_reachable(values: NameSet, value: string) -> () {
    let _ = values.insert(value);
}

fn collect_type_names(result: NameSet, value: Type) -> () {
    match value {
        Apply { base, args } => {
            collect_type_names(result, base);
            for arg in args {
                collect_type_names(result, arg)
            }
        },
        Named { name } => add_reachable(result, name),
        Pointer { elem: inner } | Array { len: _, elem: inner } | Slice { elem: inner } | Chan {
            elem: inner,
            direction: _,
        } => {
            collect_type_names(result, inner)
        },
        Map { key, value } => {
            collect_type_names(result, key);
            collect_type_names(result, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_type_names(result, param)
            }
            collect_type_names(result, ret_ty)
        },
        Multi { items: values } => {
            for value in values {
                collect_type_names(result, value)
            }
        },
        Struct { fields } => {
            for field in fields {
                collect_type_names(result, field.1)
            }
        },
        Void | Any | Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => (),
    }
}

fn collect_expr_names(result: NameSet, value: Expr) -> () {
    match value {
        Var { name } => add_reachable(result, name),
        Call { func, args } => {
            collect_expr_names(result, func);
            for arg in args {
                collect_expr_names(result, arg)
            }
        },
        Instantiate { expr, args } => {
            collect_expr_names(result, expr);
            for arg in args {
                collect_type_names(result, arg);
            }
        },
        CallSpread { func, args, spread } => {
            collect_expr_names(result, func);
            for arg in args {
                collect_expr_names(result, arg);
            }
            collect_expr_names(result, spread);
        },
        Unary { op: _, expr } => collect_expr_names(result, expr),
        Binary { op: _, lhs, rhs } => {
            collect_expr_names(result, lhs);
            collect_expr_names(result, rhs)
        },
        Field { expr, field_name: _ } => collect_expr_names(result, expr),
        Index { base: expr, index } => {
            collect_expr_names(result, expr);
            collect_expr_names(result, index)
        },
        Slice { base: expr, start, end } => {
            collect_expr_names(result, expr);
            collect_expr_names(result, start);
            collect_expr_names(result, end)
        },
        MethodExpression { receiver, name: _ } => collect_type_names(result, receiver),
        Cast { expr, ty } | Convert { ty, expr } => {
            collect_expr_names(result, expr);
            collect_type_names(result, ty)
        },
        Make { ty, args } => {
            collect_type_names(result, ty);
            for arg in args {
                collect_expr_names(result, arg)
            }
        },
        Send { channel, value } => {
            collect_expr_names(result, channel);
            collect_expr_names(result, value)
        },
        Receive { channel } => collect_expr_names(result, channel),
        StructLiteral { ty, fields } => {
            collect_type_names(result, ty);
            for field in fields {
                collect_expr_names(result, field.1)
            }
        },
        ArrayLiteral { ty, items: values } => {
            collect_type_names(result, ty);
            for value in values {
                collect_expr_names(result, value)
            }
        },
        FuncLit { params, ret_ty, body } => {
            for param in params {
                collect_type_names(result, param.1)
            }
            collect_type_names(result, ret_ty);
            collect_block_names(result, body)
        },
        Nil | Unit | Bool { value: _ } | Int { value: _ } | Float { value: _ } | String { value: _ } => (),
    }
}

fn collect_stmt_names(result: NameSet, value: Stmt) -> () {
    match value {
        Expr { expr } | Go { call: expr } | Defer { call: expr } => collect_expr_names(result, expr),
        Var { name: _, ty, value: initial } => {
            collect_type_names(result, ty);
            if let Some(expr) = initial {
                collect_expr_names(result, expr)
            }
        },
        Assign { name: _, value: expr } => collect_expr_names(result, expr),
        FieldAssign { target, field_name: _, value: expr } => {
            collect_expr_names(result, target);
            collect_expr_names(result, expr)
        },
        IndexAssign { base: target, index, value: expr } => {
            collect_expr_names(result, target);
            collect_expr_names(result, index);
            collect_expr_names(result, expr)
        },
        MultiAssign { names: _, value: expr } => collect_expr_names(result, expr),
        Return { expr } => if let Some(expr) = expr {
            collect_expr_names(result, expr)
        },
        ReturnMulti { exprs: values } => {
            for value in values {
                collect_expr_names(result, value)
            }
        },
        If { cond, then_, else_ } => {
            collect_expr_names(result, cond);
            collect_block_names(result, then_);
            if let Some(body) = else_ {
                collect_block_names(result, body)
            }
        },
        Loop { body } | LabeledLoop { label: _, body } => collect_block_names(result, body),
        Range { names: _, expr, body } => {
            collect_expr_names(result, expr);
            collect_block_names(result, body)
        },
        Switch { expr, cases, default } => {
            collect_expr_names(result, expr);
            for case in cases {
                collect_expr_names(result, case.value);
                collect_block_names(result, case.body)
            }
            if let Some(body) = default {
                collect_block_names(result, body)
            }
        },
        TypeSwitch { binding: _, expr, cases, default } => {
            collect_expr_names(result, expr);
            for case in cases {
                collect_type_names(result, case.ty);
                collect_block_names(result, case.body)
            }
            if let Some(body) = default {
                collect_block_names(result, body)
            }
        },
        Select { cases, default } => {
            for case in cases {
                match case.operation {
                    Receive { names: _, channel } => collect_expr_names(result, channel),
                    Send { channel, value } => {
                        collect_expr_names(result, channel);
                        collect_expr_names(result, value)
                    },
                }
                collect_block_names(result, case.body)
            }
            if let Some(body) = default {
                collect_block_names(result, body)
            }
        },
        Break | BreakLabel { label: _ } | Continue | ContinueLabel { label: _ } | Panic {
            message: _,
        } | Unreachable => (),
    }
}

fn collect_block_names(result: NameSet, value: Block) -> () {
    for stmt in value.stmts {
        collect_stmt_names(result, stmt)
    }
}

fn name_uses_import(name: string, alias: string) -> bool {
    if name == alias {
        true
    } else if name.byte_len() <= alias.byte_len() {
        false
    } else {
        name.starts_with(alias) && name.byte_get(alias.byte_len()) == b'.'
    }
}

fn import_is_used(names: NameSet, alias: string) -> bool {
    for name in names {
        if name_uses_import(name, alias) {
            return true
        }
    }
    false
}

fn collect_item_names(result: NameSet, value: Item) -> () {
    match value {
        TypeDef(definition) => collect_type_names(result, definition.ty),
        ConstGroup(group) => {
            for spec in group.specs {
                collect_type_names(result, spec.ty);
                collect_expr_names(result, spec.value)
            }
        },
        Global(global) => {
            if let Some(ty) = global.ty {
                collect_type_names(result, ty)
            }
            collect_expr_names(result, global.value)
        },
        Interface(definition) => {
            for method in definition.methods {
                for param in method.params {
                    collect_type_names(result, param)
                }
                if let Some(ty) = method.ret_ty {
                    collect_type_names(result, ty)
                }
            }
        },
        Struct(definition) => {
            for field in definition.fields {
                collect_type_names(result, field.1)
            }
        },
        Function(function) => {
            for param in function.params {
                collect_type_names(result, param.1)
            }
            if let Some(ty) = function.ret_ty {
                collect_type_names(result, ty)
            }
            collect_block_names(result, function.body)
        },
        Method(method) => {
            collect_type_names(result, method.receiver.1);
            for param in method.params {
                collect_type_names(result, param.1)
            }
            if let Some(ty) = method.ret_ty {
                collect_type_names(result, ty)
            }
            collect_block_names(result, method.body)
        },
        ImportGroup(_) => (),
    }
}

fn prune_imports(values: Vec[Item]) -> Vec[Item] {
    let names = new_name_set();
    for value in values {
        collect_item_names(names, value)
    }
    let result: Vec[Item] = Vec::new();
    for value in values {
        match value {
            ImportGroup(imports) => {
                let retained: Vec[(string, string)] = Vec::new();
                for entry in imports {
                    if import_is_used(names, entry.0) {
                        retained.push(entry)
                    }
                }
                if !retained.is_empty() {
                    result.push(Item::ImportGroup(retained))
                }
            },
            other => result.push(other),
        }
    }
    result
}

pub fn prune_functions_with_roots(value: File, roots: Vec[string]) -> File {
    let reachable = new_name_set();
    let expanded = new_name_set();
    for root in roots {
        add_reachable(reachable, root)
    }
    for item in value.items {
        if let Global(global) = item {
            if global.name == "_" {
                collect_item_names(reachable, item);
            }
        }
    }
    loop {
        let previous_len = expanded.len();
        for item in value.items {
            match item {
                Function(function) => {
                    if name_present(reachable, function.name)
                        && !name_present(expanded, function.name) {
                        add_reachable(expanded, function.name);
                        collect_block_names(reachable, function.body)
                    }
                },
                Global(global) => {
                    if name_present(reachable, global.name) && !name_present(expanded, global.name) {
                        add_reachable(expanded, global.name);
                        collect_expr_names(reachable, global.value)
                    }
                },
                ConstGroup(group) => {
                    for spec in group.specs {
                        if name_present(reachable, spec.name) && !name_present(expanded, spec.name) {
                            add_reachable(expanded, spec.name);
                            collect_expr_names(reachable, spec.value)
                        }
                    }
                },
                _ => (),
            }
        }
        if expanded.len() == previous_len {
            break
        }
    }
    let items: Vec[Item] = Vec::new();
    for item in value.items {
        match item {
            Function(function) => {
                if name_present(reachable, function.name) {
                    items.push(Item::Function(function))
                }
            },
            ConstGroup(group) => {
                let was_empty = group.specs.is_empty();
                let specs: Vec[ConstSpec] = Vec::new();
                for spec in group.specs {
                    if name_present(reachable, spec.name) {
                        specs.push(spec)
                    }
                }
                if was_empty || !specs.is_empty() {
                    items.push(Item::ConstGroup(ConstGroup { specs }))
                }
            },
            Global(global) => {
                if global.name == "_" || name_present(reachable, global.name) {
                    items.push(Item::Global(global))
                }
            },
            _ => items.push(item),
        }
    }
    File { items: prune_imports(items) }
}

pub fn prune_functions(value: File) -> File {
    prune_functions_with_roots(value, Vec::from_array(["main"]))
}
