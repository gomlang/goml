package go_backend;

use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

#[test]
fn bind_go_generic_call_nodes_preserve_types_spreads_and_effects() -> () {
    let slice = Type::Slice { elem: Type::Int64 };
    let body = eliminate_dead_vars(
        Block {
            stmts: Vec::from_array(
                [
                    Stmt::Var {
                        name: "values",
                        ty: slice,
                        value: Option::Some(
                            Expr::ArrayLiteral {
                                ty: slice,
                                items: Vec::from_array(
                                    [Expr::Int { value: "1" }, Expr::Int { value: "2" }],
                                ),
                            },
                        ),
                    },
                    Stmt::Assign {
                        name: "values",
                        value: Expr::CallSpread {
                            func: Expr::Var { name: "append" },
                            args: Vec::from_array([Expr::Var { name: "values" }]),
                            spread: Expr::ArrayLiteral {
                                ty: slice,
                                items: Vec::from_array([Expr::Int { value: "3" }]),
                            },
                        },
                    },
                    Stmt::Expr {
                        expr: Expr::Call {
                            func: Expr::Instantiate {
                                expr: Expr::Var { name: "zero" },
                                args: Vec::from_array([Type::Named { name: "Kept" }]),
                            },
                            args: Vec::new(),
                        },
                    },
                    Stmt::Expr {
                        expr: Expr::Call {
                            func: Expr::Instantiate {
                                expr: Expr::Var { name: "zero" },
                                args: Vec::from_array([Type::Named { name: "native_io.Reader" }]),
                            },
                            args: Vec::new(),
                        },
                    },
                    Stmt::Return {
                        expr: Option::Some(
                            Expr::CallSpread {
                                func: Expr::Instantiate {
                                    expr: Expr::Var { name: "sum" },
                                    args: Vec::from_array([Type::Int64]),
                                },
                                args: Vec::new(),
                                spread: Expr::Var { name: "values" },
                            },
                        ),
                    },
                ],
            ),
        },
    );
    let file = File {
        items: Vec::from_array(
            [
                Item::ImportGroup(Vec::from_array([("native_io", "io"), ("discarded_fmt", "fmt")])),
                Item::Struct(StructDef { name: "Kept", fields: Vec::new() }),
                Item::Function(
                    Function {
                        name: "Entry",
                        params: Vec::new(),
                        ret_ty: Option::Some(Type::Int64),
                        body,
                    },
                ),
            ],
        ),
    };
    let roots = Vec::from_array(["Entry"]);
    let file = prune_functions_with_roots(file, roots);
    let source = encode_package(privatize_library(file, roots), "bridge");
    if !source.contains("sum[int64](values...)") || !source.contains("values = append(")
        || source.contains("type Kept struct")
        || source.contains("discarded_fmt")
        || !source.contains("zero[native_io.Reader]()") {
        testing::fail(source);
        return
    }
    let root = "_artifact/go-generic-call-nodes";
    testing::assert(fs::create_dir_all(root).is_ok());
    testing::assert(
        fs::write_file_structured(path::join(root, "go.mod"), "module bridge\n\ngo 1.26\n").is_ok(),
    );
    testing::assert(fs::write_file_structured(path::join(root, "bridge.go"), source).is_ok());
    testing::assert(
        fs::write_file_structured(
            path::join(root, "bridge_test.go"),
            "package bridge\nimport \"testing\"\nvar calls int\nfunc zero[T any]() T { calls++; var value T; return value }\nfunc sum[T ~int64](values ...T) T { var result T; for _, value := range values { result += value }; return result }\nfunc TestCalls(t *testing.T) { if value:=Entry(); value!=6 || calls!=2 { t.Fatal(value,calls) } }\n",
        ).is_ok(),
    );
    match process::Command::new("go").args(Vec::from_array(["test", "./..."])).current_dir(root).env(
        "GOWORK",
        "off",
    ).env("GOTOOLCHAIN", "local").env("GOPROXY", "off").output_structured() {
        Ok(output) => if !output.status().success() {
            testing::fail(output.stderr().to_string_utf8().unwrap_or("generic Go AST test failed"));
        },
        Err(error) => testing::fail(error.to_string()),
    }
}
