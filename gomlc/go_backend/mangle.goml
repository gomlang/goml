package go_backend;

use module::hash;
use std::ascii;
use std::text;

fn is_ascii_letter(value: char) -> bool {
    let code = value.to_u32();
    code <= 0x7f && ascii::is_alphabetic(code.to_u8())
}

fn is_ascii_digit(value: char) -> bool {
    let code = value.to_u32();
    code <= 0x7f && ascii::is_digit(code.to_u8())
}

fn is_valid_ident(value: string) -> bool {
    let characters = value.chars();
    let Some(first) = Iterator::next(characters) else {
        return false
    };
    if !(is_ascii_letter(first) || first == '_') {
        return false
    }
    for character in characters {
        if !(is_ascii_letter(character) || is_ascii_digit(character) || character == '_') {
            return false
        }
    }
    true
}

fn is_keyword(value: string) -> bool {
    value == "break" || value == "default" || value == "func" || value == "interface"
        || value == "select"
        || value == "case"
        || value == "defer"
        || value == "go"
        || value == "map"
        || value == "struct"
        || value == "chan"
        || value == "else"
        || value == "goto"
        || value == "package"
        || value == "switch"
        || value == "const"
        || value == "fallthrough"
        || value == "if"
        || value == "range"
        || value == "type"
        || value == "continue"
        || value == "for"
        || value == "import"
        || value == "return"
        || value == "var"
}

fn is_predeclared(value: string) -> bool {
    value == "any" || value == "append" || value == "cap" || value == "clear" || value == "close"
        || value == "comparable"
        || value == "complex"
        || value == "copy"
        || value == "delete"
        || value == "error"
        || value == "false"
        || value == "imag"
        || value == "iota"
        || value == "len"
        || value == "make"
        || value == "max"
        || value == "min"
        || value == "new"
        || value == "nil"
        || value == "panic"
        || value == "print"
        || value == "println"
        || value == "real"
        || value == "recover"
        || value == "true"
}

fn is_generated_value(value: string) -> bool {
    value.starts_with("_goml_") || value.starts_with("dyn__")
        || (value.starts_with("ref_") && value.ends_with("_x"))
        || (value.starts_with("hashmap_") && (value.ends_with("_x") || value.ends_with("_x_entry")))
        || value.starts_with("array_get__")
        || value.starts_with("array_set__")
        || value.starts_with("vec_new__")
        || value.starts_with("vec_with_capacity__")
        || value.starts_with("vec_push__")
        || value.starts_with("vec_get__")
        || value.starts_with("vec_set__")
        || value.starts_with("vec_len__")
        || value.starts_with("vec_capacity__")
        || value.starts_with("vec_reserve__")
        || value.starts_with("vec_truncate__")
        || value.starts_with("ref__")
        || value.starts_with("ref_get__")
        || value.starts_with("ref_set__")
        || value.starts_with("ptr_eq__")
        || value.starts_with("ptr_hash__")
        || value.starts_with("hashmap_new__")
        || value.starts_with("hashmap_len__")
        || value.starts_with("hashmap_contains__")
        || value.starts_with("hashmap_lookup__")
        || value.starts_with("hashmap_get__")
        || value.starts_with("hashmap_set__")
        || value.starts_with("hashmap_remove__")
        || value.starts_with("hashmap_entries__")
        || value.starts_with("missing__")
}

fn write_hex_byte(builder: text::StringBuilder, value: u8) -> () {
    let digits = "0123456789abcdef";
    builder.write_char(digits.get((value / 16).to_isize()));
    builder.write_char(digits.get((value % 16).to_isize()))
}

fn write_utf8_hex(builder: text::StringBuilder, value: char) -> () {
    let code = value.to_u32();
    if code <= 0x7f {
        write_hex_byte(builder, code.to_u8())
    } else if code <= 0x7ff {
        write_hex_byte(builder, (0xc0 | (code >> 6)).to_u8());
        write_hex_byte(builder, (0x80 | (code & 0x3f)).to_u8())
    } else if code <= 0xffff {
        write_hex_byte(builder, (0xe0 | (code >> 12)).to_u8());
        write_hex_byte(builder, (0x80 | ((code >> 6) & 0x3f)).to_u8());
        write_hex_byte(builder, (0x80 | (code & 0x3f)).to_u8())
    } else {
        write_hex_byte(builder, (0xf0 | (code >> 18)).to_u8());
        write_hex_byte(builder, (0x80 | ((code >> 12) & 0x3f)).to_u8());
        write_hex_byte(builder, (0x80 | ((code >> 6) & 0x3f)).to_u8());
        write_hex_byte(builder, (0x80 | (code & 0x3f)).to_u8())
    }
}

fn write_encoded_char(builder: text::StringBuilder, value: char) -> () {
    if is_ascii_letter(value) || is_ascii_digit(value) {
        builder.write_char(value)
    } else if value == '_' {
        builder.write_string("__")
    } else if value == '#' {
        builder.write_string("_i_")
    } else if value == '[' {
        builder.write_string("_l_")
    } else if value == ']' {
        builder.write_string("_r_")
    } else if value == '(' {
        builder.write_string("_o_")
    } else if value == ')' {
        builder.write_string("_q_")
    } else if value == '{' {
        builder.write_string("_b_")
    } else if value == '}' {
        builder.write_string("_e_")
    } else if value == ',' {
        builder.write_string("_c_")
    } else if value == ':' {
        builder.write_string("_k_")
    } else if value == '$' {
        builder.write_string("_d_")
    } else if value == '-' {
        builder.write_string("_m_")
    } else if value == '.' {
        builder.write_string("_t_")
    } else if value == '/' {
        builder.write_string("_f_")
    } else if value == '*' {
        builder.write_string("_a_")
    } else if value == '&' {
        builder.write_string("_n_")
    } else if value == '+' {
        builder.write_string("_u_")
    } else if value == '<' {
        builder.write_string("_v_")
    } else if value == '>' {
        builder.write_string("_z_")
    } else {
        builder.write_string("_x");
        write_utf8_hex(builder, value);
        builder.write_char('_')
    }
}

fn encode_name(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    let mut pending_colon = false;
    for character in value.chars() {
        if pending_colon {
            if character == ':' {
                builder.write_string("_p_");
                pending_colon = false;
            } else {
                write_encoded_char(builder, ':');
                write_encoded_char(builder, character);
                pending_colon = false;
            }
        } else if character == ':' {
            pending_colon = true;
        } else {
            write_encoded_char(builder, character)
        }
    }
    if pending_colon {
        write_encoded_char(builder, ':')
    }
    builder.finish()
}

fn compact_ident(value: string) -> string {
    if value.byte_len() <= 80 {
        value
    } else {
        let marker = "_h" + hash::sha256_prefix(value) + "_";
        let budget = 80 - marker.byte_len();
        let head_len = budget * 2 / 3;
        let tail_len = budget - head_len;
        value.byte_slice(0, head_len) + marker
            + value.byte_slice(value.byte_len() - tail_len, value.byte_len())
    }
}

fn bounded_hint(value: string, budget: isize) -> string {
    if value.byte_len() <= budget {
        value
    } else {
        let content_budget = budget - 1;
        let head_len = content_budget * 2 / 3;
        let tail_len = content_budget - head_len;
        value.byte_slice(0, head_len) + "_"
            + value.byte_slice(value.byte_len() - tail_len, value.byte_len())
    }
}

pub fn go_hashed_ident(kind: string, value: string) -> string {
    let prefix = "_goml_" + kind + "_";
    let digest = hash::sha256_prefix(kind + "\u0000" + value);
    let suffix = "_h" + digest;
    let budget = 80 - prefix.byte_len() - suffix.byte_len();
    prefix + bounded_hint(encode_name(value), budget) + suffix
}

fn go_ident_impl(value: string, protect_generated: bool) -> string {
    if is_valid_ident(value) && !is_keyword(value) && !is_predeclared(value) {
        if protect_generated && is_generated_value(value) {
            compact_ident("_goml_user_" + value)
        } else {
            compact_ident(value)
        }
    } else {
        compact_ident("_goml_m_" + encode_name(value))
    }
}

pub fn go_ident(value: string) -> string {
    go_ident_impl(value, true)
}

pub fn go_local_ident(value: string) -> string {
    let builder = text::StringBuilder::with_capacity(value.byte_len());
    for character in value.chars() {
        if character == '/' {
            builder.write_string("__")
        } else {
            builder.write_char(character)
        }
    }
    go_ident(builder.finish())
}

pub fn go_generated_ident(value: string) -> string {
    go_ident_impl(value, false)
}

pub fn go_dyn_struct_name(trait_name: string) -> string {
    if trait_name.ends_with("_vtable") {
        go_generated_ident("_goml_dyn_object_" + trait_name)
    } else {
        go_generated_ident("dyn__" + trait_name)
    }
}

pub fn is_generated_tuple_type_name(value: string) -> bool {
    if !value.starts_with("Tuple") {
        false
    } else {
        let mut index = 5;
        while index < value.len() && is_ascii_digit(value.get(index)) {
            index += 1;
        }
        index > 5 && (index == value.len() || value.get(index) == '_')
    }
}

fn generated_type_name(value: string) -> bool {
    value.starts_with("Tuple") || value.starts_with("Array") || value.starts_with("Slice_")
        || value.starts_with("Vec_")
        || value.starts_with("Ptr_")
        || value.starts_with("HashMap_")
        || value.starts_with("TFunc")
}

pub fn go_user_type_name(value: string) -> string {
    let ident = go_ident(value);
    if generated_type_name(ident) || ident == "main" || ident == "init" {
        go_generated_ident("_goml_user_" + ident)
    } else {
        ident
    }
}
