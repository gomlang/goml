package go_backend;

use module::repr;
use module::tast;
use std::collections;

struct EnumLayout {
    size: isize,
    alignment: isize,
    known: bool,
}

struct EnumSlot {
    name: string,
    ty: repr::Type,
    size: isize,
    alignment: isize,
}

struct AllocatedSlots {
    slots: Vec[EnumSlot],
    names: Vec[Vec[Option[string]]],
}

fn enum_known_layout(size: isize, alignment: isize) -> EnumLayout {
    EnumLayout { size, alignment, known: true }
}

fn enum_unknown_layout() -> EnumLayout {
    EnumLayout { size: 0, alignment: 1, known: false }
}

fn enum_aligned_size(size: isize, alignment: isize) -> isize {
    (size + alignment - 1) / alignment * alignment
}

pub fn enum_tag_type(count: isize) -> Type {
    if count <= 256 {
        Type::Uint8
    } else if count <= 65536 {
        Type::Uint16
    } else if count <= 4294967296 {
        Type::Uint32
    } else {
        Type::Uint64
    }
}

pub fn enum_pack_helper_name(owner_name: string) -> string {
    go_generated_ident("_goml_enum_pack_" + go_user_type_name(owner_name))
}

pub fn enum_node_tag_helper_name(owner_name: string) -> string {
    go_generated_ident("_goml_enum_tag_" + go_user_type_name(owner_name))
}

pub fn enum_storage_is_direct(value: EnumStorage) -> bool {
    match value {
        Singleton | TagOnly | Flat | PointerNiche | Packed | Node => true,
        Interface => false,
    }
}

fn enum_model_type_layout(value: Type) -> EnumLayout {
    match value {
        Uint8 | Int8 | Bool => enum_known_layout(1, 1),
        Uint16 | Int16 => enum_known_layout(2, 2),
        Uint32 | Int32 | Float32 | Char => enum_known_layout(4, 4),
        Uint | Int | Uint64 | Int64 | Float64 | Pointer { elem: _ } | Chan { .. } | Func { .. } => enum_known_layout(
            8,
            8,
        ),
        String | Any => enum_known_layout(16, 8),
        Slice { elem: _ } => enum_known_layout(24, 8),
        Unit => enum_known_layout(0, 1),
        Void | Apply { .. } | Named { name: _ } | Array { .. } | Map { .. } | Multi { .. } | Struct {
            ..,
        } => enum_unknown_layout(),
    }
}

fn enum_type_list_layout(
    values: Vec[repr::Type],
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
    depth: isize,
) -> EnumLayout {
    let mut size = 0;
    let mut alignment = 1;
    for value in values {
        let field = enum_type_layout(value, structs, variants, depth + 1);
        if !field.known {
            return enum_unknown_layout()
        }
        size = enum_aligned_size(size, field.alignment) + field.size;
        if field.alignment > alignment {
            alignment = field.alignment;
        }
    }
    enum_known_layout(enum_aligned_size(size, alignment), alignment)
}

fn enum_named_layout(
    name: string,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
    depth: isize,
) -> EnumLayout {
    match find_struct(structs, name) {
        Some(definition) => {
            let fields: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
            for field in definition.fields {
                fields.push(field.1)
            }
            enum_type_list_layout(fields, structs, variants, depth + 1)
        },
        None => match variants.owners[name] {
            Some(info) => match info.storage {
                Singleton => enum_known_layout(0, 1),
                TagOnly | Packed => enum_model_type_layout(info.tag_ty),
                Flat => {
                    let fields: Vec[repr::Type] = Vec::with_capacity(info.fields.len() + 1);
                    let tag_layout = enum_model_type_layout(info.tag_ty);
                    let mut size = 0;
                    let mut alignment = 1;
                    for field in info.fields {
                        let field_layout = enum_type_layout(field.1, structs, variants, depth + 1);
                        if !field_layout.known {
                            return enum_unknown_layout()
                        }
                        size = enum_aligned_size(size, field_layout.alignment) + field_layout.size;
                        if field_layout.alignment > alignment {
                            alignment = field_layout.alignment;
                        }
                    }
                    size = enum_aligned_size(size, tag_layout.alignment) + tag_layout.size;
                    if tag_layout.alignment > alignment {
                        alignment = tag_layout.alignment;
                    }
                    enum_known_layout(enum_aligned_size(size, alignment), alignment)
                },
                PointerNiche | Node => enum_known_layout(8, 8),
                Interface => enum_known_layout(16, 8),
            },
            None => enum_unknown_layout(),
        },
    }
}

fn enum_type_layout(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
    depth: isize,
) -> EnumLayout {
    if depth >= 32 {
        enum_unknown_layout()
    } else {
        match repr::resolve_type(value) {
            Unit | Never => enum_known_layout(0, 1),
            Bool | Int8 | Uint8 => enum_known_layout(1, 1),
            Int16 | Uint16 => enum_known_layout(2, 2),
            Int32 | Uint32 | Float32 | Char => enum_known_layout(4, 4),
            Int | Int64 | Uint | Uint64 | Float64 => enum_known_layout(8, 8),
            External { .. } => enum_unknown_layout(),
            String => enum_known_layout(16, 8),
            Tuple { items } => enum_type_list_layout(items, structs, variants, depth + 1),
            Named { name } | ClosureEnvironment { name } => {
                enum_named_layout(name, structs, variants, depth + 1)
            },
            Dyn { .. } => enum_known_layout(16, 8),
            Array { len, elem } => {
                let item = enum_type_layout(elem, structs, variants, depth + 1);
                if item.known {
                    enum_known_layout(
                        enum_aligned_size(item.size, item.alignment) * len,
                        item.alignment,
                    )
                } else {
                    item
                }
            },
            Slice { elem: _ } | MutSlice { elem: _ } => enum_known_layout(24, 8),
            VecType { elem: _ } | GoPointer { elem: _ } | GoFunction { signature: _ } | RefType {
                elem: _,
            } | HashMap { .. } | GoMap { .. } | Channel { elem: _, direction: _ } | Func { .. } => enum_known_layout(
                8,
                8,
            ),
        }
    }
}

pub fn enum_type_is_zero_sized(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> bool {
    let layout = enum_type_layout(value, structs, variants, 0);
    layout.known && layout.size == 0
}

pub fn enum_zero_expr(value: repr::Type) -> Expr {
    match repr::resolve_type(value) {
        Unit | Never => Expr::Unit,
        Array { len: _, elem: _ } => Expr::ArrayLiteral { ty: lower_type(value), items: Vec::new() },
        _ => Expr::StructLiteral { ty: lower_type(value), fields: Vec::new() },
    }
}

fn enum_fields_by_variant(definition: repr::EnumDef) -> Vec[Vec[repr::Type]] {
    let result: Vec[Vec[repr::Type]] = Vec::with_capacity(definition.variants.len());
    for variant in definition.variants {
        result.push(enum_field_types(variant.fields))
    }
    result
}

fn enum_type_reaches(
    target: string,
    value: repr::Type,
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    path: collections::HashSet[string],
    depth: isize,
) -> bool {
    if depth >= 64 {
        true
    } else {
        match repr::resolve_type(value) {
            Tuple { items } => {
                for item in items {
                    if enum_type_reaches(target, item, structs, enums, path, depth + 1) {
                        return true
                    }
                }
                false
            },
            Array { len: _, elem } => enum_type_reaches(
                target,
                elem,
                structs,
                enums,
                path,
                depth + 1,
            ),
            Named { name } | ClosureEnvironment { name } => if name == target {
                true
            } else if path.contains(name) {
                false
            } else {
                let _ = path.insert(name);
                let result = match find_struct(structs, name) {
                    Some(definition) => {
                        let mut result = false;
                        for field in definition.fields {
                            if enum_type_reaches(target, field.1, structs, enums, path, depth + 1) {
                                result = true;
                            }
                        }
                        result
                    },
                    None => match find_enum(enums, name) {
                        Some(definition) => {
                            let mut result = false;
                            for fields in enum_fields_by_variant(definition) {
                                for field in fields {
                                    if enum_type_reaches(
                                        target,
                                        field,
                                        structs,
                                        enums,
                                        path,
                                        depth + 1,
                                    ) {
                                        result = true;
                                    }
                                }
                            }
                            result
                        },
                        None => false,
                    },
                };
                let _ = path.remove(name);
                result
            },
            _ => false,
        }
    }
}

fn enum_is_recursive(
    definition: repr::EnumDef,
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
) -> bool {
    let path: collections::HashSet[string] = collections::HashSet::new();
    let _ = path.insert(definition.name);
    for fields in enum_fields_by_variant(definition) {
        for field in fields {
            if enum_type_reaches(definition.name, field, structs, enums, path, 0) {
                return true
            }
        }
    }
    false
}

fn enum_pointer_payload(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        VecType { elem: _ } | RefType { elem: _ } | HashMap { .. } => true,
        _ => false,
    }
}

fn enum_packed_carrier(value: repr::Type) -> Option[Type] {
    match repr::resolve_type(value) {
        Bool => Option::Some(Type::Uint8),
        Int8 | Uint8 => Option::Some(Type::Uint16),
        Int16 | Uint16 => Option::Some(Type::Uint32),
        Int32 | Uint32 | Char => Option::Some(Type::Uint64),
        _ => Option::None,
    }
}

fn enum_packed_unsigned_type(value: repr::Type) -> Type {
    match repr::resolve_type(value) {
        Int8 | Uint8 => Type::Uint8,
        Int16 | Uint16 => Type::Uint16,
        Int32 | Uint32 | Char => Type::Uint32,
        _ => lower_type(value),
    }
}

fn enum_packed_signed_type(value: repr::Type) -> Option[(Type, string)] {
    match repr::resolve_type(value) {
        Int8 => Option::Some((Type::Int16, "128")),
        Int16 => Option::Some((Type::Int32, "32768")),
        Int32 => Option::Some((Type::Int64, "2147483648")),
        _ => Option::None,
    }
}

pub fn enum_packed_value_expr(
    owner: EnumInfo,
    owner_ty: repr::Type,
    payload_ty: repr::Type,
    value: Expr,
) -> Expr {
    match repr::resolve_type(payload_ty) {
        Bool => Expr::Call {
            func: Expr::Var { name: enum_pack_helper_name(owner.owner_name) },
            args: Vec::from_array([value]),
        },
        _ => {
            let encoded = match enum_packed_signed_type(payload_ty) {
                Some(value_info) => Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Convert { ty: value_info.0, expr: value },
                    rhs: Expr::Int { value: value_info.1 },
                },
                None => Expr::Convert { ty: enum_packed_unsigned_type(payload_ty), expr: value },
            };
            Expr::Convert {
                ty: lower_type(owner_ty),
                expr: Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Convert { ty: owner.tag_ty, expr: encoded },
                    rhs: Expr::Int { value: "1" },
                },
            }
        },
    }
}

pub fn enum_packed_payload_expr(owner: EnumInfo, value: Expr) -> Expr {
    let payload_ty = owner.payload_ty.unwrap_or(repr::Type::Unit);
    match repr::resolve_type(payload_ty) {
        Bool => Expr::Binary {
            op: BinaryOp::Eq,
            lhs: value,
            rhs: Expr::Convert {
                ty: Type::Named { name: go_user_type_name(owner.owner_name) },
                expr: Expr::Int { value: "2" },
            },
        },
        _ => {
            let decoded = Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Convert { ty: owner.tag_ty, expr: value },
                rhs: Expr::Int { value: "1" },
            };
            match enum_packed_signed_type(payload_ty) {
                Some(value_info) => Expr::Convert {
                    ty: lower_type(payload_ty),
                    expr: Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: Expr::Convert { ty: value_info.0, expr: decoded },
                        rhs: Expr::Int { value: value_info.1 },
                    },
                },
                None => Expr::Convert { ty: lower_type(payload_ty), expr: decoded },
            }
        },
    }
}

fn enum_two_case_payload(fields: Vec[Vec[repr::Type]]) -> Option[(isize, isize, repr::Type)] {
    if fields.len() != 2 {
        Option::None
    } else if fields[0].is_empty() && fields[1].len() == 1 {
        Option::Some((0, 1, fields[1][0]))
    } else if fields[1].is_empty() && fields[0].len() == 1 {
        Option::Some((1, 0, fields[0][0]))
    } else {
        Option::None
    }
}

fn enum_slot_index(slots: Vec[EnumSlot], used: Vec[bool], ty: repr::Type) -> Option[isize] {
    for index in 0..slots.len() {
        if !used[index] && repr::types_equal(slots[index].ty, ty) {
            return Option::Some(index)
        }
    }
    Option::None
}

fn enum_sort_slots(values: Vec[EnumSlot]) -> Vec[EnumSlot] {
    let result: Vec[EnumSlot] = Vec::with_capacity(values.len());
    for value in values {
        let mut index = 0;
        while index < result.len()
            && (result[index].alignment > value.alignment
                || (result[index].alignment == value.alignment && result[index].size >= value.size)) {
            index += 1;
        }
        result.insert(index, value)
    }
    result
}

fn enum_allocate_slots(
    fields: Vec[Vec[repr::Type]],
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> AllocatedSlots {
    let slots: Vec[EnumSlot] = Vec::new();
    let names: Vec[Vec[Option[string]]] = Vec::with_capacity(fields.len());
    for variant_fields in fields {
        let used: Vec[bool] = Vec::new();
        for _ in slots {
            used.push(false)
        }
        let variant_names: Vec[Option[string]] = Vec::with_capacity(variant_fields.len());
        for field in variant_fields {
            if enum_type_is_zero_sized(field, structs, variants) {
                variant_names.push(Option::None)
            } else {
                let index = match enum_slot_index(slots, used, field) {
                    Some(index) => index,
                    None => {
                        let layout = enum_type_layout(field, structs, variants, 0);
                        let index = slots.len();
                        slots.push(
                            EnumSlot {
                                name: f"_p{index}",
                                ty: field,
                                size: layout.size,
                                alignment: layout.alignment,
                            },
                        );
                        used.push(false);
                        index
                    },
                };
                used[index] = true;
                variant_names.push(Option::Some(slots[index].name))
            }
        }
        names.push(variant_names)
    }
    AllocatedSlots { slots: enum_sort_slots(slots), names }
}

fn enum_plan_fields(value: AllocatedSlots) -> Vec[(string, repr::Type)] {
    let result: Vec[(string, repr::Type)] = Vec::with_capacity(value.slots.len());
    for slot in value.slots {
        result.push((slot.name, slot.ty))
    }
    result
}

fn enum_flat_layout(
    tag_ty: Type,
    fields: Vec[(string, repr::Type)],
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> EnumLayout {
    let tag = enum_model_type_layout(tag_ty);
    let mut size = 0;
    let mut alignment = 1;
    for field in fields {
        let layout = enum_type_layout(field.1, structs, variants, 0);
        if !layout.known {
            return enum_unknown_layout()
        }
        size = enum_aligned_size(size, layout.alignment) + layout.size;
        if layout.alignment > alignment {
            alignment = layout.alignment;
        }
    }
    size = enum_aligned_size(size, tag.alignment) + tag.size;
    if tag.alignment > alignment {
        alignment = tag.alignment;
    }
    enum_known_layout(enum_aligned_size(size, alignment), alignment)
}

fn enum_info_placeholder(definition: repr::EnumDef, storage: EnumStorage) -> EnumInfo {
    EnumInfo {
        owner_name: definition.name,
        storage,
        tag_ty: enum_tag_type(definition.variants.len()),
        fields: Vec::new(),
        node_name: go_generated_ident(go_user_type_name(definition.name) + "_node"),
        nil_tag: Option::None,
        payload_tag: Option::None,
        payload_ty: Option::None,
    }
}

fn enum_plan_dependencies(
    value: repr::Type,
    builtin: tast::BuiltinContract,
    variants: VariantInfos,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> () {
    match repr::resolve_type(value) {
        Tuple { items } => for item in items {
            enum_plan_dependencies(
                item,
                builtin,
                variants,
                enums,
                structs,
                instances,
                function_names,
            )
        },
        Array { len: _, elem } => {
            enum_plan_dependencies(
                elem,
                builtin,
                variants,
                enums,
                structs,
                instances,
                function_names,
            )
        },
        Named { name } | ClosureEnvironment { name } => match find_struct(structs, name) {
            Some(definition) => for field in definition.fields {
                enum_plan_dependencies(
                    field.1,
                    builtin,
                    variants,
                    enums,
                    structs,
                    instances,
                    function_names,
                )
            },
            None => if let Some(definition) = find_enum(enums, name) {
                enum_plan_definition(
                    builtin,
                    variants,
                    definition,
                    enums,
                    structs,
                    instances,
                    function_names,
                )
            },
        },
        _ => (),
    }
}

fn enum_add_variant_infos(
    variants: VariantInfos,
    definition: repr::EnumDef,
    fields: Vec[Vec[repr::Type]],
    names: Vec[Vec[Option[string]]],
    enums: Vec[repr::EnumDef],
    function_names: FunctionNames,
) -> () {
    let values: Vec[VariantInfo] = Vec::with_capacity(definition.variants.len());
    for index in 0..definition.variants.len() {
        values.push(
            VariantInfo {
                owner_name: definition.name,
                tag: index,
                variant_name: concrete_variant_go_name(
                    definition.name,
                    definition.variants[index].name,
                    enums,
                    function_names,
                ),
                field_types: fields[index],
                field_names: names[index],
            },
        )
    }
    variants.by_owner[definition.name] = values;
}

fn enum_empty_names(fields: Vec[Vec[repr::Type]]) -> Vec[Vec[Option[string]]] {
    let result: Vec[Vec[Option[string]]] = Vec::with_capacity(fields.len());
    for variant in fields {
        let names: Vec[Option[string]] = Vec::with_capacity(variant.len());
        for _ in variant {
            names.push(Option::None)
        }
        result.push(names)
    }
    result
}

fn enum_fields_are_zero_sized(
    fields: Vec[Vec[repr::Type]],
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> bool {
    for variant in fields {
        for field in variant {
            if !enum_type_is_zero_sized(field, structs, variants) {
                return false
            }
        }
    }
    true
}

fn enum_plan_definition(
    builtin: tast::BuiltinContract,
    variants: VariantInfos,
    definition: repr::EnumDef,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> () {
    if variants.owners.contains(definition.name) {
        return ()
    }
    let fields = enum_fields_by_variant(definition);
    let recursive = enum_is_recursive(definition, structs, enums);
    if recursive {
        variants.owners[definition.name] = enum_info_placeholder(definition, EnumStorage::Node);
    }
    for variant in fields {
        for field in variant {
            enum_plan_dependencies(
                field,
                builtin,
                variants,
                enums,
                structs,
                instances,
                function_names,
            )
        }
    }
    if recursive {
        let allocated = enum_allocate_slots(fields, structs, variants);
        let names = allocated.names;
        let mut info = match variants.owners[definition.name] {
            Some(value) => value,
            None => enum_info_placeholder(definition, EnumStorage::Node),
        };
        info.fields = enum_plan_fields(allocated);
        for index in 0..fields.len() {
            if fields[index].is_empty() {
                info.nil_tag = Option::Some(index);
                break
            }
        }
        variants.owners[definition.name] = info;
        enum_add_variant_infos(variants, definition, fields, names, enums, function_names);
        return ()
    }
    if enum_fields_are_zero_sized(fields, structs, variants) {
        let storage = if definition.variants.len() <= 1 {
            EnumStorage::Singleton
        } else {
            EnumStorage::TagOnly
        };
        variants.owners[definition.name] = enum_info_placeholder(definition, storage);
        enum_add_variant_infos(
            variants,
            definition,
            fields,
            enum_empty_names(fields),
            enums,
            function_names,
        );
        return ()
    }
    if let Some(shape) = enum_two_case_payload(fields) {
        if enum_pointer_payload(shape.2) {
            let mut info = enum_info_placeholder(definition, EnumStorage::PointerNiche);
            info.nil_tag = Option::Some(shape.0);
            info.payload_tag = Option::Some(shape.1);
            info.payload_ty = Option::Some(shape.2);
            info.fields.push(("_value", shape.2));
            variants.owners[definition.name] = info;
            let names = enum_empty_names(fields);
            names[shape.1][0] = Option::Some("_value");
            enum_add_variant_infos(variants, definition, fields, names, enums, function_names);
            return ()
        }
        if let Some(carrier) = enum_packed_carrier(shape.2) {
            let mut info = enum_info_placeholder(definition, EnumStorage::Packed);
            info.tag_ty = carrier;
            info.nil_tag = Option::Some(shape.0);
            info.payload_tag = Option::Some(shape.1);
            info.payload_ty = Option::Some(shape.2);
            variants.owners[definition.name] = info;
            enum_add_variant_infos(
                variants,
                definition,
                fields,
                enum_empty_names(fields),
                enums,
                function_names,
            );
            return ()
        }
    }
    let allocated = enum_allocate_slots(fields, structs, variants);
    let names = allocated.names;
    let planned_fields = enum_plan_fields(allocated);
    let tag_ty = enum_tag_type(definition.variants.len());
    let layout = enum_flat_layout(tag_ty, planned_fields, structs, variants);
    let limit = if builtin_sum_enum(builtin, definition, instances) {
        48
    } else {
        24
    };
    let compact = layout.known && layout.size <= limit;
    let mut info = enum_info_placeholder(
        definition,
        if compact {
            EnumStorage::Flat
        } else {
            EnumStorage::Interface
        },
    );
    if compact {
        info.fields = planned_fields;
    }
    variants.owners[definition.name] = info;
    enum_add_variant_infos(variants, definition, fields, names, enums, function_names)
}

pub fn plan_variant_infos(
    builtin: tast::BuiltinContract,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> VariantInfos {
    let result = VariantInfos { by_owner: HashMap::new(), owners: HashMap::new() };
    for definition in enums {
        enum_plan_definition(builtin, result, definition, enums, structs, instances, function_names)
    }
    result
}

pub fn find_enum_info(variants: VariantInfos, owner_ty: repr::Type) -> Option[EnumInfo] {
    match repr::resolve_type(owner_ty) {
        Named { name } => variants.owners[name],
        _ => Option::None,
    }
}
