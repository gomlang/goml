package go_backend;

use module::anf;
use module::ast;
use module::repr;
use std::testing;

fn pointer_test_large_type() -> repr::Type {
    repr::Type::Named { name: "Large" }
}

fn pointer_test_structs() -> Vec[repr::StructDef] {
    Vec::from_array(
        [
            repr::StructDef {
                name: "Large",
                fields: Vec::from_array(
                    [("storage", repr::Type::Array { len: 10, elem: repr::Type::Int64 })],
                ),
                public_fields: Vec::new(),
                has_hidden_fields: false,
            },
        ],
    )
}

fn pointer_test_signature() -> repr::Type {
    repr::Type::Func {
        params: Vec::from_array(
            [pointer_test_large_type(), pointer_test_large_type(), repr::Type::Int],
        ),
        ret_ty: repr::Type::Unit,
    }
}

fn pointer_test_function(name: string, body: anf::Block) -> anf::Function {
    anf::Function {
        name,
        origin: anf::FunctionOrigin::Source,
        root: true,
        trait_impl: Option::None,
        params: Vec::from_array(
            [
                ("left", pointer_test_large_type()),
                ("right", pointer_test_large_type()),
                ("index", repr::Type::Int),
            ],
        ),
        ret_ty: anf::term_type(body.term),
        body,
    }
}

fn pointer_test_unit() -> anf::Imm {
    anf::Imm::Prim { value: repr::Primitive::Unit, ty: repr::Type::Unit }
}

fn pointer_test_block(binds: Vec[anf::Bind]) -> anf::Block {
    anf::Block { binds, term: anf::Term::Return(pointer_test_unit()) }
}

fn pointer_test_binding(name: string, value: anf::Value) -> anf::Bind {
    anf::Bind::Let(anf::LetBind { name, ty: anf::value_type(value), value })
}

fn pointer_test_callable(name: string) -> anf::Imm {
    anf::Imm::Callable { callable: repr::Callable::Function(name), ty: pointer_test_signature() }
}

fn pointer_test_call(callee: anf::Imm) -> anf::Bind {
    pointer_test_binding(
        "result",
        anf::Value::Call {
            func: callee,
            args: Vec::from_array(
                [
                    anf::Imm::Var { name: "left", ty: pointer_test_large_type() },
                    anf::Imm::Var { name: "right", ty: pointer_test_large_type() },
                    anf::Imm::Prim {
                        value: repr::Primitive::Int { value: "1" },
                        ty: repr::Type::Int,
                    },
                ],
            ),
            ty: repr::Type::Unit,
        },
    )
}

#[test]
fn pointer_parameters_preserve_independent_copy_and_call_decisions() -> () {
    let assigned = pointer_test_binding(
        "assigned",
        anf::Value::Assign {
            name: "left",
            value: anf::Imm::Var { name: "right", ty: pointer_test_large_type() },
            target_ty: pointer_test_large_type(),
            ty: repr::Type::Unit,
        },
    );
    for callee in Vec::from_array(
        [
            pointer_test_callable("used"),
            anf::Imm::Var { name: "used", ty: pointer_test_signature() },
            anf::Imm::Callable {
                callable: repr::Callable::LangItem { item: "test", function_name: "used" },
                ty: pointer_test_signature(),
            },
        ],
    ) {
        let infos = build_pointer_param_infos(
            Vec::from_array(
                [
                    pointer_test_function("used", pointer_test_block(Vec::from_array([assigned]))),
                    pointer_test_function("unused", pointer_test_block(Vec::new())),
                    pointer_test_function(
                        "caller",
                        pointer_test_block(Vec::from_array([pointer_test_call(callee)])),
                    ),
                ],
            ),
            pointer_test_structs(),
        );
        testing::assert(pointer_param_enabled(infos, "used", 0));
        testing::assert(pointer_param_enabled(infos, "used", 1));
        testing::assert(!pointer_param_enabled(infos, "used", 2));
        testing::assert(pointer_param_copied(infos, "used", 0));
        testing::assert(!pointer_param_copied(infos, "used", 1));
        testing::assert(!pointer_param_enabled(infos, "unused", 0));
        testing::assert(!pointer_param_enabled(infos, "caller", 0));
    }
}

#[test]
fn pointer_parameters_reject_escapes_independently_of_function_order() -> () {
    let callee = pointer_test_callable("used");
    let returning = anf::Block { binds: Vec::new(), term: anf::Term::Return(callee) };
    let joined = anf::Block {
        binds: Vec::from_array(
            [
                anf::Bind::Join(
                    anf::JoinBind {
                        name: "accept",
                        role: anf::JoinRole::Continuation,
                        params: Vec::from_array([("function", pointer_test_signature())]),
                        ret_ty: repr::Type::Unit,
                        body: pointer_test_block(Vec::new()),
                    },
                ),
            ],
        ),
        term: anf::Term::Jump {
            target: "accept",
            args: Vec::from_array([callee]),
            ret_ty: repr::Type::Unit,
        },
    };
    let selected = anf::Block {
        binds: Vec::new(),
        term: anf::Term::Select {
            mode: ast::SelectMode::Normal,
            arms: Vec::new(),
            default: Option::Some(returning),
            ret_ty: pointer_test_signature(),
        },
    };
    let packed = pointer_test_block(
        Vec::from_array(
            [
                pointer_test_binding(
                    "closure",
                    anf::Value::PackClosure {
                        environment: anf::Imm::Var { name: "left", ty: pointer_test_large_type() },
                        apply: "used",
                        ty: repr::Type::Func {
                            params: Vec::from_array([pointer_test_large_type(), repr::Type::Int]),
                            ret_ty: repr::Type::Unit,
                        },
                    },
                ),
            ],
        ),
    );
    for body in Vec::from_array([returning, joined, selected, packed]) {
        let target = pointer_test_function("used", pointer_test_block(Vec::new()));
        let direct = pointer_test_function(
            "caller",
            pointer_test_block(Vec::from_array([pointer_test_call(callee)])),
        );
        let escape = pointer_test_function("escape", body);
        for functions in Vec::from_array(
            [Vec::from_array([target, direct, escape]), Vec::from_array([escape, direct, target])],
        ) {
            let infos = build_pointer_param_infos(functions, pointer_test_structs());
            testing::assert(!pointer_param_enabled(infos, "used", 0));
            testing::assert(!pointer_param_enabled(infos, "used", 1));
            testing::assert(!pointer_param_copied(infos, "used", 0));
        }
    }
}
