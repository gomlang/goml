package go_backend;

use module::anf;
use std::collections;

fn enum_compare_var(value: Expr, expected: string) -> bool {
    match value {
        Var { name } => name == expected,
        _ => false,
    }
}

fn enum_compare_return(body: Block, expected: bool) -> bool {
    if body.stmts.len() != 1 {
        return false
    }
    match body.stmts[0] {
        Return { expr: Some(Expr::Bool { value }) } => value == expected,
        _ => false,
    }
}

fn enum_compare_body(
    body: Block,
    params: Vec[(string, Type)],
    source: anf::Function,
    variants: VariantInfos,
) -> Option[Block] {
    if params.len() != 2 || body.stmts.len() != 1 {
        return Option::None
    }
    let first = find_enum_info(variants, source.params[0].1)?;
    let second = find_enum_info(variants, source.params[1].1)?;
    if first.owner_name != second.owner_name {
        return Option::None
    }
    match first.storage {
        TagOnly => {},
        _ => return Option::None,
    }
    let members = variants.by_owner[first.owner_name]?;
    let (tag, cases, fallback) = match body.stmts[0] {
        Switch { expr: Expr::Var { name }, cases, default: Some(fallback) } => (
            name,
            cases,
            fallback,
        ),
        _ => return Option::None,
    };
    let other = if tag == params[0].0 {
        params[1].0
    } else if tag == params[1].0 {
        params[0].0
    } else {
        return Option::None
    };
    if cases.len() == 0 || cases.len() != members.len() {
        return Option::None
    }
    let expected: collections::HashSet[string] = collections::HashSet::new();
    for index in 0..members.len() {
        let member = members[index];
        if member.tag != index {
            return Option::None
        }
        let _ = expected.insert(member.variant_name);
    }
    for case in cases {
        let name = match case.value {
            Var { name } => name,
            _ => return Option::None,
        };
        if !expected.remove(name) || case.body.stmts.len() != 1 {
            return Option::None
        }
        match case.body.stmts[0] {
            Switch { expr, cases: inner, default: Some(default) } => {
                if !enum_compare_var(expr, other) || inner.len() != 1
                    || !enum_compare_return(default, false)
                    || !enum_compare_var(inner[0].value, name)
                    || !enum_compare_return(inner[0].body, true) {
                    return Option::None
                }
            },
            _ => return Option::None,
        }
    }
    Option::Some(
        Block {
            stmts: Vec::from_array(
                [
                    Stmt::If {
                        cond: Expr::Binary {
                            op: BinaryOp::LessEq,
                            lhs: Expr::Var { name: tag },
                            rhs: Expr::Var { name: members[members.len() - 1].variant_name },
                        },
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Return {
                                        expr: Option::Some(
                                            Expr::Binary {
                                                op: BinaryOp::Eq,
                                                lhs: Expr::Var { name: other },
                                                rhs: Expr::Var { name: tag },
                                            },
                                        ),
                                    },
                                ],
                            ),
                        },
                        else_: Option::Some(fallback),
                    },
                ],
            ),
        },
    )
}
