package go_backend;

use module::repr;

fn interface_bridge_key(value: repr::GoInterfaceBridge) -> string {
    let mut result = encode_type(value.target);
    for method in value.methods {
        let signature = encode_type(method.signature);
        result = result + "_" + method.name.byte_len().to_string() + method.name + "_"
            + signature.byte_len().to_string()
            + signature;
    }
    result
}

fn interface_bridge_owner(value: repr::GoInterfaceBridge) -> string {
    go_hashed_ident("interface_bridge", interface_bridge_key(value))
}

fn interface_bridge_factory(value: repr::GoInterfaceBridge) -> string {
    go_hashed_ident("interface_make", interface_bridge_key(value))
}

fn interface_bridge_forward(owner: Type, field: string, method: repr::GoInterfaceBridgeMethod) -> Result[
    Item,
    string,
] {
    let Func { params: parameter_types, ret_ty } = method.signature else {
        return Result::Err("Go interface bridge method has no function signature")
    };
    let params = Vec::new();
    let args = Vec::new();
    for index in 0..parameter_types.len() {
        let name = "p" + index.to_string();
        params.push((name, lower_type(parameter_types[index])));
        args.push(Expr::Var { name });
    }
    let call = Expr::Call {
        func: Expr::Field { expr: Expr::Var { name: "self" }, field_name: field },
        args,
    };
    let stmts = Vec::new();
    match ret_ty {
        Unit => {
            stmts.push(Stmt::Expr { expr: call });
            stmts.push(Stmt::Return { expr: Option::None });
        },
        Tuple { items } if items.is_empty() => {
            stmts.push(Stmt::Expr { expr: call });
            stmts.push(Stmt::Return { expr: Option::None });
        },
        Tuple { items } => {
            stmts.push(
                Stmt::Var { name: "result", ty: lower_type(ret_ty), value: Option::Some(call) },
            );
            let exprs = Vec::new();
            for index in 0..items.len() {
                exprs.push(
                    Expr::Field {
                        expr: Expr::Var { name: "result" },
                        field_name: "_" + index.to_string(),
                    },
                );
            }
            stmts.push(Stmt::ReturnMulti { exprs });
        },
        _ => stmts.push(Stmt::Return { expr: Option::Some(call) }),
    }
    let Func { ret_ty: native_return, .. } = lower_type(
        repr::Type::GoFunction { signature: method.signature },
    ) else {
        return Result::Err("Go interface bridge has no native method signature")
    };
    Result::Ok(
        Item::Method(
            Method {
                receiver: ("self", owner),
                name: method.name,
                params,
                ret_ty: if let Void = native_return {
                    Option::None
                } else {
                    Option::Some(native_return)
                },
                body: Block { stmts },
            },
        ),
    )
}

fn emit_interface_bridge(value: repr::GoInterfaceBridge) -> Result[Vec[Item], string] {
    repr::validate_go_interface_bridge(value, repr::go_interface_bridge_type(value))?;
    let owner = Type::Named { name: interface_bridge_owner(value) };
    let fields = Vec::new();
    let values = Vec::new();
    let items = Vec::new();
    for index in 0..value.methods.len() {
        let method = value.methods[index];
        let field = "method" + index.to_string();
        fields.push((field, lower_type(method.signature)));
        values.push((field, Expr::Var { name: field }));
        items.push(interface_bridge_forward(owner, field, method)?);
    }
    items.push(Item::Struct(StructDef { name: interface_bridge_owner(value), fields }));
    items.push(
        Item::Global(
            Global {
                name: "_",
                ty: Option::Some(lower_type(value.target)),
                value: Expr::StructLiteral { ty: owner, fields: Vec::new() },
            },
        ),
    );
    items.push(
        Item::Function(
            Function {
                name: interface_bridge_factory(value),
                params: fields,
                ret_ty: Option::Some(lower_type(value.target)),
                body: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::Return {
                                expr: Option::Some(
                                    Expr::StructLiteral { ty: owner, fields: values },
                                ),
                            },
                        ],
                    ),
                },
            },
        ),
    );
    Result::Ok(items)
}

fn add_interface_bridge(values: Vec[repr::GoInterfaceBridge], value: repr::GoInterfaceBridge) -> () {
    let key = interface_bridge_key(value);
    for existing in values {
        if interface_bridge_key(existing) == key {
            return
        }
    }
    values.push(value);
}
