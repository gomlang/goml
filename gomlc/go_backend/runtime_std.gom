fn std_bytes_error_failure_stmts() -> Vec[Stmt] {
    Vec::from_array(
        [
            Stmt::MultiAssign {
                names: Vec::from_array(["has_raw_code", "raw_code"]),
                value: std_call(
                    "_goml_runtime_error_raw_code",
                    Vec::from_array([Expr::Var { name: "err" }]),
                ),
            },
            Stmt::Return {
                expr: Option::Some(
                    std_bool_bytes_error_expr(
                        false,
                        std_vec_expr(repr::Type::Uint8, Expr::Nil),
                        std_call(
                            "_goml_runtime_error_kind",
                            Vec::from_array([Expr::Var { name: "err" }]),
                        ),
                        Expr::Var { name: "has_raw_code" },
                        Expr::Var { name: "raw_code" },
                        std_error_string(),
                    ),
                ),
            },
        ],
    )
}

fn std_bytes_error_success(data: Expr) -> Stmt {
    Stmt::Return {
        expr: Option::Some(
            std_bool_bytes_error_expr(
                true,
                std_vec_expr(repr::Type::Uint8, data),
                Expr::Int { value: "0" },
                Expr::Bool { value: false },
                Expr::Int { value: "0" },
                Expr::String { value: "" },
            ),
        ),
    }
}

fn std_io_read_stdin_v2_item(key: string) -> Item {
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["data", "err"]),
            value: std_call(
                "_goml_io.ReadAll",
                Vec::from_array([Expr::Var { name: "_goml_os.Stdin" }]),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: std_bytes_error_failure_stmts() },
            else_: Option::None,
        },
    );
    stmts.push(std_bytes_error_success(Expr::Var { name: "data" }));
    std_function_item(key, Vec::new(), std_bool_bytes_error_type(), stmts)
}

