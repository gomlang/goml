    names.push("value");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_filepath.Abs", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "value" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_string_type(), stmts)
}

