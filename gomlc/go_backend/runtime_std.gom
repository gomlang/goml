fn std_math_float32_call(function_name: string, args: Vec[Expr]) -> Expr {
    let converted: Vec[Expr] = Vec::new();
    for arg in args {
        converted.push(Expr::Convert { ty: Type::Float64, expr: arg })
    }
    Expr::Convert { ty: Type::Float32, expr: std_call(function_name, converted) }
}

fn std_math_float32_unary_item(key: string) -> Item {
    let params = Vec::from_array([("operation", Type::Int), ("value", Type::Float32)]);
    let functions = Vec::from_array(
        [
            "_goml_math.Sqrt",
            "_goml_math.Exp",
            "_goml_math.Log",
            "_goml_math.Sin",
            "_goml_math.Cos",
            "_goml_math.Tan",
            "_goml_math.Floor",
            "_goml_math.Ceil",
            "_goml_math.Round",
            "_goml_math.Trunc",
        ],
    );
    let cases: Vec[SwitchCase] = Vec::new();
    for index in 0..functions.len() {
        cases.push(
            SwitchCase {
                value: Expr::Int { value: index.to_string() },
                body: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::Return {
                                expr: Option::Some(
                                    std_math_float32_call(
                                        functions[index],
                                        Vec::from_array([Expr::Var { name: "value" }]),
                                    ),
                                ),
                            },
                        ],
                    ),
                },
            },
        )
    }
    let stmts = Vec::from_array(
        [
            Stmt::Switch {
                expr: Expr::Var { name: "operation" },
                cases,
                default: Option::Some(
                    Block {
                        stmts: Vec::from_array(
                            [Stmt::Return { expr: Option::Some(Expr::Var { name: "value" }) }],
                        ),
                    },
                ),
            },
        ],
    );
    std_function_item(key, params, Type::Float32, stmts)
}

