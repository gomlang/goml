            value: Option::Some(std_call("_goml_filepath.Clean", clean_args)),
        },
    );
    let parent_args: Vec[Expr] = Vec::new();
    parent_args.push(Expr::Var { name: "cleaned" });
    stmts.push(
        Stmt::Var {
            name: "parent",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Dir", parent_args)),
        },
    );
    let base_args: Vec[Expr] = Vec::new();
    base_args.push(Expr::Var { name: "cleaned" });
    stmts.push(
        Stmt::Var {
            name: "base",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Base", base_args)),
        },
    );
    let missing_condition = Expr::Binary {
        op: BinaryOp::Or,
        lhs: Expr::Binary {
            op: BinaryOp::Eq,
            lhs: Expr::Var { name: "cleaned" },
            rhs: Expr::Var { name: "parent" },
        },
        rhs: Expr::Binary {
            op: BinaryOp::Or,
            lhs: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "base" },
                rhs: Expr::String { value: "." },
            },
            rhs: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "base" },
                rhs: Expr::String { value: ".." },
            },
        },
    };
    let missing: Vec[Stmt] = Vec::new();
    missing.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, Expr::String { value: "" })) },
    );
    stmts.push(
        Stmt::If { cond: missing_condition, then_: Block { stmts: missing }, else_: Option::None },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(true, Expr::Var { name: "base" })) },
    );
    std_function_item(key, params, std_bool_string_type(), stmts)
}

