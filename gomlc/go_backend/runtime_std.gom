fn std_process_timeout_setup() -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "ctx",
            ty: Type::Named { name: "_goml_context.Context" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "cancel",
            ty: Type::Named { name: "_goml_context.CancelFunc" },
            value: Option::None,
        },
    );
    let duration_args = Vec::from_array([Expr::Var { name: "timeout_ms" }]);
    let timeout = Expr::Binary {
        op: BinaryOp::Mul,
        lhs: std_call("_goml_time.Duration", duration_args),
        rhs: Expr::Var { name: "_goml_time.Millisecond" },
    };
    let timeout_args = Vec::from_array([std_call("_goml_context.Background", Vec::new()), timeout]);
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["ctx", "cancel"]),
            value: std_call("_goml_context.WithTimeout", timeout_args),
        },
    );
    stmts
}

fn std_process_cancel_setup() -> Vec[Stmt] {
    Vec::from_array(
        [
            Stmt::Var {
                name: "ctx",
                ty: Type::Named { name: "_goml_context.Context" },
                value: Option::Some(
                    std_call(task_context_name(), Vec::from_array([Expr::Var { name: "scope_id" }])),
                ),
            },
        ],
    )
}

fn std_process_command_setup(command_function: string) -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    let command_args: Vec[Expr] = Vec::new();
    if command_function == "_goml_exec.CommandContext" {
        command_args.push(Expr::Var { name: "ctx" })
    }
    command_args.push(Expr::Var { name: "program" });
    command_args.push(Expr::Var { name: "arguments.items..." });
    stmts.push(
        Stmt::Var {
            name: "cmd",
            ty: Type::Pointer { elem: Type::Named { name: "_goml_exec.Cmd" } },
            value: Option::Some(std_call(command_function, command_args)),
        },
    );
    let set_directory: Vec[Stmt] = Vec::new();
    set_directory.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Dir",
            value: Expr::Var { name: "directory" },
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "has_directory" },
            then_: Block { stmts: set_directory },
            else_: Option::None,
        },
    );
    let set_environment: Vec[Stmt] = Vec::new();
    set_environment.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Field {
                    expr: Expr::Index {
                        base: Expr::Field {
                            expr: Expr::Var { name: "environment" },
                            field_name: "items",
                        },
                        index: Expr::Int { value: "0" },
                    },
                    field_name: "_0",
                },
                rhs: Expr::String { value: "" },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::FieldAssign {
                            target: Expr::Var { name: "cmd" },
                            field_name: "Env",
                            value: Expr::Nil,
                        },
                    ],
                ),
            },
            else_: Option::Some(
                Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::FieldAssign {
                                target: Expr::Var { name: "cmd" },
                                field_name: "Env",
                                value: std_call("_goml_os.Environ", Vec::new()),
                            },
                        ],
                    ),
                },
            ),
        },
    );
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "Env" });
    append_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "_0" },
                rhs: Expr::String { value: "=" },
            },
            rhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "_1" },
        },
    );
    let range_body: Vec[Stmt] = Vec::new();
    range_body.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "_0" },
                rhs: Expr::String { value: "" },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::FieldAssign {
                            target: Expr::Var { name: "cmd" },
                            field_name: "Env",
                            value: std_call("append", append_args),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    set_environment.push(
        Stmt::Range {
            names: Vec::from_array(["_", "entry"]),
            expr: Expr::Field { expr: Expr::Var { name: "environment" }, field_name: "items" },
            body: Block { stmts: range_body },
        },
    );
    let length_args: Vec[Expr] = Vec::new();
    length_args.push(Expr::Field { expr: Expr::Var { name: "environment" }, field_name: "items" });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Greater,
                lhs: std_call("len", length_args),
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: set_environment },
            else_: Option::None,
        },
    );
    stmts
}

fn std_process_cancel_group_setup() -> Vec[Stmt] {
    let cancel_body: Vec[Stmt] = Vec::new();
    cancel_body.push(
        Stmt::Return {
            expr: Option::Some(
                std_call(
                    "_goml_syscall.Kill",
                    Vec::from_array(
                        [
                            Expr::Unary {
                                op: UnaryOp::Neg,
                                expr: Expr::Field {
                                    expr: Expr::Field {
                                        expr: Expr::Var { name: "cmd" },
                                        field_name: "Process",
                                    },
                                    field_name: "Pid",
                                },
                            },
                            Expr::Var { name: "_goml_syscall.SIGKILL" },
                        ],
                    ),
                ),
            ),
        },
    );
    Vec::from_array(
        [
            Stmt::FieldAssign {
                target: Expr::Var { name: "cmd" },
                field_name: "SysProcAttr",
                value: Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: "_goml_syscall.SysProcAttr" },
                        fields: Vec::from_array([("Setpgid", Expr::Bool { value: true })]),
                    },
                },
            },
            Stmt::FieldAssign {
                target: Expr::Var { name: "cmd" },
                field_name: "Cancel",
                value: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Named { name: "error" },
                    body: Block { stmts: cancel_body },
                },
            },
        ],
    )
}

fn std_process_buffer(name: string) -> Expr {
    std_vec_expr(repr::Type::Uint8, std_method_call(Expr::Var { name }, "Bytes", Vec::new()))
}

fn std_process_output_expr(valid: bool, code: Expr, error: Expr, timed: bool) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(code);
    values.push(std_process_buffer("stdout"));
    values.push(std_process_buffer("stderr"));
    values.push(error);
    if timed {
        values.push(Expr::Var { name: "timed_out" });
        std_tuple_expr(std_process_output_timeout_type(), values)
    } else {
        std_tuple_expr(std_process_output_type(), values)
    }
}

fn std_process_status_expr(valid: bool, code: Expr, error: Expr, timed: bool) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(code);
    values.push(error);
    if timed {
        values.push(Expr::Var { name: "timed_out" });
        std_tuple_expr(std_process_status_timeout_type(), values)
    } else {
        std_tuple_expr(std_process_status_type(), values)
    }
}

fn std_process_exit_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("code", Type::Int));
    let convert_args: Vec[Expr] = Vec::new();
    convert_args.push(Expr::Var { name: "code" });
    let exit_args: Vec[Expr] = Vec::new();
    exit_args.push(std_call("int", convert_args));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Expr { expr: std_call("_goml_os.Exit", exit_args) });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    std_function_item(key, params, Type::Unit, stmts)
}

fn std_process_look_path_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("program", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "result", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["result", "err"]),
            value: std_call("_goml_exec.LookPath", Vec::from_array([Expr::Var { name: "program" }])),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "result" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_string_type(), stmts)
}

enum ProcessExecutionMode {
    Plain,
    Timeout,
    Cancel,
}

fn std_process_output_item_for(key: string, mode: ProcessExecutionMode) -> Item {
    let timed = match mode {
        Timeout => true,
        Plain | Cancel => false,
    };
    let cancelled = match mode {
        Cancel => true,
        Plain | Timeout => false,
    };
    let contextual = timed || cancelled;
    let stmts = if timed {
        std_process_timeout_setup()
    } else if cancelled {
        std_process_cancel_setup()
    } else {
        Vec::new()
    };
    for stmt in std_process_command_setup(
        if contextual {
            "_goml_exec.CommandContext"
        } else {
            "_goml_exec.Command"
        },
    ) {
        stmts.push(stmt)
    }
    if cancelled {
        for stmt in std_process_cancel_group_setup() {
            stmts.push(stmt)
        }
    }
    let set_input: Vec[Stmt] = Vec::new();
    let reader_args: Vec[Expr] = Vec::new();
    reader_args.push(Expr::Field { expr: Expr::Var { name: "input" }, field_name: "items" });
    set_input.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdin",
            value: std_call("_goml_bytes.NewReader", reader_args),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "has_input" },
            then_: Block { stmts: set_input },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "stdout",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "stderr",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdout",
            value: Expr::Unary { op: UnaryOp::Address, expr: Expr::Var { name: "stdout" } },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stderr",
            value: Expr::Unary { op: UnaryOp::Address, expr: Expr::Var { name: "stderr" } },
        },
    );
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_method_call(Expr::Var { name: "cmd" }, "Run", Vec::new())),
        },
    );
    if contextual {
        stmts.push(
            Stmt::Var {
                name: "timed_out",
                ty: Type::Bool,
                value: Option::Some(
                    if timed {
                        Expr::Binary {
                            op: BinaryOp::Eq,
                            lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                            rhs: Expr::Var { name: "_goml_context.DeadlineExceeded" },
                        }
                    } else {
                        Expr::Binary {
                            op: BinaryOp::And,
                            lhs: Expr::Binary {
                                op: BinaryOp::NotEq,
                                lhs: Expr::Var { name: "err" },
                                rhs: Expr::Nil,
                            },
                            rhs: Expr::Binary {
                                op: BinaryOp::NotEq,
                                lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                                rhs: Expr::Nil,
                            },
                        }
                    },
                ),
            },
        );
        if timed {
            stmts.push(Stmt::Expr { expr: std_call("cancel", Vec::new()) })
        }
    }
    stmts.push(
        Stmt::Var { name: "code", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let failed: Vec[Stmt] = Vec::new();
    let missing_state: Vec[Stmt] = Vec::new();
    missing_state.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_output_expr(
                    false,
                    Expr::Int { value: "-1" },
                    std_error_string(),
                    contextual,
                ),
            ),
        },
    );
    failed.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
                rhs: Expr::Nil,
            },
            then_: Block { stmts: missing_state },
            else_: Option::None,
        },
    );
    let code_args: Vec[Expr] = Vec::new();
    code_args.push(
        std_method_call(
            Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
            "ExitCode",
            Vec::new(),
        ),
    );
    failed.push(Stmt::Assign { name: "code", value: std_call("int", code_args) });
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_output_expr(
                    true,
                    Expr::Var { name: "code" },
                    Expr::String { value: "" },
                    contextual,
                ),
            ),
        },
    );
    std_function_item(
        key,
        if timed {
            std_process_output_timeout_params()
        } else if cancelled {
            std_process_output_cancel_params()
        } else {
            std_process_output_params()
        },
        if contextual {
            std_process_output_timeout_type()
        } else {
            std_process_output_type()
        },
        stmts,
    )
}

fn std_process_status_item_for(key: string, mode: ProcessExecutionMode) -> Item {
    let timed = match mode {
        Timeout => true,
        Plain | Cancel => false,
    };
    let cancelled = match mode {
        Cancel => true,
        Plain | Timeout => false,
    };
    let contextual = timed || cancelled;
    let stmts = if timed {
        std_process_timeout_setup()
    } else if cancelled {
        std_process_cancel_setup()
    } else {
        Vec::new()
    };
    for stmt in std_process_command_setup(
        if contextual {
            "_goml_exec.CommandContext"
        } else {
            "_goml_exec.Command"
        },
    ) {
        stmts.push(stmt)
    }
    if cancelled {
        for stmt in std_process_cancel_group_setup() {
            stmts.push(stmt)
        }
    }
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdin",
            value: Expr::Var { name: "_goml_os.Stdin" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stdout",
            value: Expr::Var { name: "_goml_os.Stdout" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cmd" },
            field_name: "Stderr",
            value: Expr::Var { name: "_goml_os.Stderr" },
        },
    );
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_method_call(Expr::Var { name: "cmd" }, "Run", Vec::new())),
        },
    );
    if contextual {
        stmts.push(
            Stmt::Var {
                name: "timed_out",
                ty: Type::Bool,
                value: Option::Some(
                    if timed {
                        Expr::Binary {
                            op: BinaryOp::Eq,
                            lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                            rhs: Expr::Var { name: "_goml_context.DeadlineExceeded" },
                        }
                    } else {
                        Expr::Binary {
                            op: BinaryOp::And,
                            lhs: Expr::Binary {
                                op: BinaryOp::NotEq,
                                lhs: Expr::Var { name: "err" },
                                rhs: Expr::Nil,
                            },
                            rhs: Expr::Binary {
                                op: BinaryOp::NotEq,
                                lhs: std_method_call(Expr::Var { name: "ctx" }, "Err", Vec::new()),
                                rhs: Expr::Nil,
                            },
                        }
                    },
                ),
            },
        );
        if timed {
            stmts.push(Stmt::Expr { expr: std_call("cancel", Vec::new()) })
        }
    }
    stmts.push(
        Stmt::Var { name: "code", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let failed: Vec[Stmt] = Vec::new();
    let missing_state: Vec[Stmt] = Vec::new();
    missing_state.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_status_expr(
                    false,
                    Expr::Int { value: "-1" },
                    std_error_string(),
                    contextual,
                ),
            ),
        },
    );
    failed.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
                rhs: Expr::Nil,
            },
            then_: Block { stmts: missing_state },
            else_: Option::None,
        },
    );
    let code_args: Vec[Expr] = Vec::new();
    code_args.push(
        std_method_call(
            Expr::Field { expr: Expr::Var { name: "cmd" }, field_name: "ProcessState" },
            "ExitCode",
            Vec::new(),
        ),
    );
    failed.push(Stmt::Assign { name: "code", value: std_call("int", code_args) });
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_process_status_expr(
                    true,
                    Expr::Var { name: "code" },
                    Expr::String { value: "" },
                    contextual,
                ),
            ),
        },
    );
    std_function_item(
        key,
        if timed {
            let params = std_process_params();
            params.push(("timeout_ms", Type::Int));
            params
        } else if cancelled {
            let params = std_process_params();
            params.push(("scope_id", Type::Int64));
            params
        } else {
            std_process_params()
        },
        if contextual {
            std_process_status_timeout_type()
        } else {
            std_process_status_type()
        },
        stmts,
    )
}

fn std_env_runtime_hook_item(hook: resources::EnvRuntimeHook, key: string) -> Item {
    match hook {
        Args => std_env_args_item(key),
        CurrentDir => std_string_result_item(key, "_goml_os.Getwd"),
        CurrentExe => std_string_result_item(key, "_goml_os.Executable"),
        Var => std_env_var_item(key),
        Vars => std_env_vars_item(key),
    }
}

fn std_fs_runtime_hook_item(hook: resources::FsRuntimeHook, key: string) -> Item {
    match hook {
        ReadFile => std_fs_read_file_item(key),
        WriteFile => std_fs_write_file_item(key),
        ReadBytes => std_fs_read_bytes_item(key),
        ReadBytesV2 => std_fs_read_bytes_v2_item(key),
        WriteBytes => std_fs_write_bytes_item(key),
        WriteBytesV2 => std_fs_write_bytes_v2_item(key),
        PathOperationV2 => std_fs_path_operation_v2_item(key),
        MetadataV2 => std_fs_metadata_v2_item(key),
        AtomicWriteV2 => std_fs_atomic_write_v2_item(key),
        CreateDirAll => std_fs_create_dir_all_item(key),
        RemoveFile => std_fs_remove_item(key, "_goml_os.Remove"),
        RemoveDirAll => std_fs_remove_item(key, "_goml_os.RemoveAll"),
        FileExists => std_fs_file_exists_item(key),
        IsFile => std_fs_stat_kind_item(key, false),
        IsDir => std_fs_stat_kind_item(key, true),
        Canonicalize => std_fs_canonicalize_item(key),
        ReadDir => std_fs_read_dir_item(key),
        ReadDirV2 => std_fs_read_dir_v2_item(key),
        Sha256File => std_fs_sha256_file_item(key),
    }
}

fn std_io_runtime_hook_item(hook: resources::IoRuntimeHook, key: string) -> Item {
    match hook {
        Print => std_io_output_item(key, false, false),
        Println => std_io_output_item(key, true, false),
        Eprint => std_io_output_item(key, false, true),
        ReadStdin => std_io_read_stdin_item(key),
        ReadStdinV2 => std_io_read_stdin_v2_item(key),
        ReadStdinExact => std_io_read_stdin_exact_item(key),
        ReadStdinExactV2 => std_io_read_stdin_exact_v2_item(key),
        WriteStdout => std_io_write_item(key, "_goml_os.Stdout"),
        WriteStdoutV2 => std_io_write_v2_item(key, "_goml_os.Stdout"),
        WriteStderr => std_io_write_item(key, "_goml_os.Stderr"),
        WriteStderrV2 => std_io_write_v2_item(key, "_goml_os.Stderr"),
    }
}

fn std_path_runtime_hook_item(hook: resources::PathRuntimeHook, key: string) -> Item {
    match hook {
        Join => std_path_join_item(key),
        Clean => std_path_unary_item(key, "_goml_filepath.Clean", Type::String),
        IsAbsolute => std_path_unary_item(key, "_goml_filepath.IsAbs", Type::Bool),
        Parent => std_path_parent_item(key),
        FileName => std_path_file_name_item(key),
        Extension => std_path_extension_item(key),
        FileStem => std_path_file_stem_item(key),
        WithExtension => std_path_with_extension_item(key),
        Absolute => std_path_absolute_item(key),
        Relative => std_path_relative_item(key),
        Separator => std_path_separator_item(key),
    }
}

fn std_process_runtime_hook_item(hook: resources::ProcessRuntimeHook, key: string) -> Item {
    match hook {
        Exit => std_process_exit_item(key),
        LookPath => std_process_look_path_item(key),
        Output => std_process_output_item_for(key, ProcessExecutionMode::Plain),
        OutputTimeout => std_process_output_item_for(key, ProcessExecutionMode::Timeout),
        OutputCancel => std_process_output_item_for(key, ProcessExecutionMode::Cancel),
        Status => std_process_status_item_for(key, ProcessExecutionMode::Plain),
        StatusTimeout => std_process_status_item_for(key, ProcessExecutionMode::Timeout),
        StatusCancel => std_process_status_item_for(key, ProcessExecutionMode::Cancel),
    }
}

fn std_math_runtime_hook_item(hook: resources::MathRuntimeHook, key: string) -> Item {
    match hook {
        Float32Unary => std_math_float32_unary_item(key),
        Float32Pow => std_math_float32_pow_item(key),
    }
}

fn std_crypto_runtime_hook_item(hook: resources::CryptoRuntimeHook, key: string) -> Item {
    match hook {
        RandomBytes => std_crypto_random_bytes_item(key),
    }
}

fn std_time_runtime_hook_item(hook: resources::TimeRuntimeHook, key: string) -> Item {
    match hook {
        MonotonicNanoseconds => std_time_monotonic_nanoseconds_item(key),
        UnixNanoseconds => std_time_unix_nanoseconds_item(key),
        SleepNanoseconds => std_time_sleep_nanoseconds_item(key),
        TimerNew => std_time_timer_new_item(key),
        TimerStop => std_time_timer_stop_item(key),
    }
}

fn standard_runtime_hook_item(hook: resources::StandardRuntimeHook, key: string) -> Item {
    match hook {
        LinuxSyscall6 => linux_syscall6_item(key, false),
        LinuxSyscall6Pointers => linux_syscall6_item(key, true),
        LinuxProcessSpawn => linux_process_spawn_item(key),
        Env(hook) => std_env_runtime_hook_item(hook, key),
        Fs(hook) => std_fs_runtime_hook_item(hook, key),
        Io(hook) => std_io_runtime_hook_item(hook, key),
        Path(hook) => std_path_runtime_hook_item(hook, key),
        Process(hook) => std_process_runtime_hook_item(hook, key),
        TestingFail => std_testing_fail_item(key),
        Math(hook) => std_math_runtime_hook_item(hook, key),
        Crypto(hook) => std_crypto_runtime_hook_item(hook, key),
        Time(hook) => std_time_runtime_hook_item(hook, key),
        Task(hook) => task_runtime_hook_item(hook, key),
    }
}
