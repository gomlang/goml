fn std_testing_fail_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("message", Type::String));
    let print_args: Vec[Expr] = Vec::new();
    print_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::Var { name: "message" },
            rhs: Expr::String { value: "\n" },
        },
    );
