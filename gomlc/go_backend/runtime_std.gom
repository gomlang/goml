    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "_goml_os.Stdin" });
    args.push(Expr::Var { name: "data" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_io.ReadFull", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_bytes_string_expr(
                    false,
                    std_vec_expr(repr::Type::Uint8, Expr::Nil),
