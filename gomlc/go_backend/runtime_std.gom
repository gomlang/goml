fn std_fs_stat_kind_item(key: string, directory: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "info",
            ty: Type::Named { name: "_goml_os.FileInfo" },
            value: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("info");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.Stat", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    let predicate = if directory {
        std_method_call(Expr::Var { name: "info" }, "IsDir", Vec::new())
    } else {
        std_method_call(
            std_method_call(Expr::Var { name: "info" }, "Mode", Vec::new()),
            "IsRegular",
            Vec::new(),
        )
    };
    stmts.push(Stmt::Return { expr: Option::Some(predicate) });
    std_function_item(key, params, Type::Bool, stmts)
}

fn std_fs_canonicalize_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "absolute", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "result", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let absolute_names: Vec[string] = Vec::new();
    absolute_names.push("absolute");
    absolute_names.push("err");
    let absolute_args: Vec[Expr] = Vec::new();
    absolute_args.push(Expr::Var { name: "path" });
    stmts.push(
        Stmt::MultiAssign {
            names: absolute_names,
            value: std_call("_goml_filepath.Abs", absolute_args),
        },
    );
    let absolute_failed: Vec[Stmt] = Vec::new();
    absolute_failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: absolute_failed },
            else_: Option::None,
        },
    );
    let result_names: Vec[string] = Vec::new();
    result_names.push("result");
    result_names.push("err");
    let result_args: Vec[Expr] = Vec::new();
    result_args.push(Expr::Var { name: "absolute" });
    stmts.push(
        Stmt::MultiAssign {
            names: result_names,
            value: std_call("_goml_filepath.EvalSymlinks", result_args),
        },
    );
    let result_failed: Vec[Stmt] = Vec::new();
    result_failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: result_failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "result" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_string_type(), stmts)
}

fn std_fs_read_dir_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let entries_type = Type::Slice { elem: Type::Named { name: "_goml_os.DirEntry" } };
    let names_type = Type::Slice { elem: Type::String };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "entries", ty: entries_type, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let assignment_names: Vec[string] = Vec::new();
    assignment_names.push("entries");
    assignment_names.push("err");
    let read_args: Vec[Expr] = Vec::new();
    read_args.push(Expr::Var { name: "path" });
    stmts.push(
        Stmt::MultiAssign {
            names: assignment_names,
            value: std_call("_goml_os.ReadDir", read_args),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_strings_string_expr(
                    false,
                    std_vec_expr(repr::Type::String, Expr::Nil),
                    std_error_string(),
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "names", ty: names_type, value: Option::None });
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "entries" });
    let finished: Vec[Stmt] = Vec::new();
    finished.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert { ty: Type::Int, expr: std_call("len", len_args) },
            },
            then_: Block { stmts: finished },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: Type::Named { name: "_goml_os.DirEntry" },
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "entries" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Var { name: "names" });
    append_args.push(std_method_call(Expr::Var { name: "entry" }, "Name", Vec::new()));
    loop_stmts.push(Stmt::Assign { name: "names", value: std_call("append", append_args) });
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_strings_string_expr(
                    true,
                    std_vec_expr(repr::Type::String, Expr::Var { name: "names" }),
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_strings_string_type(), stmts)
}

fn std_fs_read_dir_v2_item(key: string) -> Item {
    let params = Vec::from_array([("path", Type::String)]);
    let entries_type = Type::Slice { elem: Type::Named { name: "_goml_os.DirEntry" } };
    let names_type = Type::Slice { elem: Type::String };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "entries", ty: entries_type, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["entries", "err"]),
            value: std_call("_goml_os.ReadDir", Vec::from_array([Expr::Var { name: "path" }])),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::MultiAssign {
                            names: Vec::from_array(["has_raw_code", "raw_code"]),
                            value: std_call(
                                "_goml_runtime_error_raw_code",
                                Vec::from_array([Expr::Var { name: "err" }]),
                            ),
                        },
                        Stmt::Return {
                            expr: Option::Some(
                                std_bool_strings_error_expr(
                                    false,
                                    std_vec_expr(repr::Type::String, Expr::Nil),
                                    std_call(
                                        "_goml_runtime_error_kind",
                                        Vec::from_array([Expr::Var { name: "err" }]),
                                    ),
                                    Expr::Var { name: "has_raw_code" },
                                    Expr::Var { name: "raw_code" },
                                    std_error_string(),
                                ),
                            ),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "names", ty: names_type, value: Option::None });
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: std_call("len", Vec::from_array([Expr::Var { name: "entries" }])),
                },
            },
            then_: Block { stmts: Vec::from_array([Stmt::Break]) },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: Type::Named { name: "_goml_os.DirEntry" },
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "entries" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "names",
            value: std_call(
                "append",
                Vec::from_array(
                    [
                        Expr::Var { name: "names" },
                        std_method_call(Expr::Var { name: "entry" }, "Name", Vec::new()),
                    ],
                ),
            ),
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_strings_error_expr(
                    true,
                    std_vec_expr(repr::Type::String, Expr::Var { name: "names" }),
                    Expr::Int { value: "0" },
                    Expr::Bool { value: false },
                    Expr::Int { value: "0" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_strings_error_type(), stmts)
}

fn std_io_output_item(key: string, newline: bool, stderr: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("value", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(
        if newline {
            Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "value" },
                rhs: Expr::String { value: "\n" },
            }
        } else {
            Expr::Var { name: "value" }
        },
    );
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Expr {
            expr: std_call(
                if stderr {
                    "_goml_os.Stderr.WriteString"
                } else {
                    "_goml_os.Stdout.WriteString"
                },
                args,
            ),
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    std_function_item(key, params, Type::Unit, stmts)
}

