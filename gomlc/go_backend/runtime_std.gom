package go_backend;

use module::ast;
use module::resources;
use module::repr;

fn std_function_item(key: string, params: Vec[(string, Type)], ret_ty: Type, stmts: Vec[Stmt]) -> Item {
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn std_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Var { name }, args }
}

fn std_method_call(value: Expr, name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Field { expr: value, field_name: name }, args }
}

fn std_tuple_type(values: Vec[repr::Type]) -> Type {
    lower_type(repr::Type::Tuple { items: values })
}

fn std_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in 0..values.len() {
        fields.push((f"_{index}", values[index]))
    }
    Expr::StructLiteral { ty, fields }
}

fn std_vec_type(elem: repr::Type) -> repr::Type {
    repr::Type::VecType { elem }
}

fn std_vec_expr(elem: repr::Type, items: Expr) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("items", items));
    Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))) },
            fields,
        },
    }
}

fn std_error_string() -> Expr {
    std_method_call(Expr::Var { name: "err" }, "Error", Vec::new())
}

fn std_error_condition() -> Expr {
    Expr::Binary { op: BinaryOp::NotEq, lhs: Expr::Var { name: "err" }, rhs: Expr::Nil }
}

fn std_bool_string_type() -> Type {
    let values: Vec[repr::Type] = Vec::new();
    values.push(repr::Type::Bool);
    values.push(repr::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_expr(valid: bool, value: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    std_tuple_expr(std_bool_string_type(), values)
}

fn std_bool_string_string_type() -> Type {
    let values: Vec[repr::Type] = Vec::new();
    values.push(repr::Type::Bool);
    values.push(repr::Type::String);
    values.push(repr::Type::String);
    std_tuple_type(values)
}

fn std_bool_string_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_string_string_type(), values)
}

fn std_bool_bytes_string_type() -> Type {
    let values: Vec[repr::Type] = Vec::new();
    values.push(repr::Type::Bool);
    values.push(std_vec_type(repr::Type::Uint8));
    values.push(repr::Type::String);
    std_tuple_type(values)
}

fn std_bool_bytes_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_bytes_string_type(), values)
}

fn std_bool_bytes_error_type() -> Type {
    std_tuple_type(
        Vec::from_array(
            [
                repr::Type::Bool,
                std_vec_type(repr::Type::Uint8),
                repr::Type::Int,
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::String,
            ],
        ),
    )
}

fn std_bool_bytes_error_expr(
    valid: bool,
    value: Expr,
    kind_code: Expr,
    has_raw_code: Expr,
    raw_code: Expr,
    message: Expr,
) -> Expr {
    std_tuple_expr(
        std_bool_bytes_error_type(),
        Vec::from_array(
            [Expr::Bool { value: valid }, value, kind_code, has_raw_code, raw_code, message],
        ),
    )
}

fn std_error_result_type() -> Type {
    std_tuple_type(
        Vec::from_array(
            [
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::String,
            ],
        ),
    )
}

fn std_error_result_expr(
    valid: bool,
    kind_code: Expr,
    has_raw_code: Expr,
    raw_code: Expr,
    message: Expr,
) -> Expr {
    std_tuple_expr(
        std_error_result_type(),
        Vec::from_array([Expr::Bool { value: valid }, kind_code, has_raw_code, raw_code, message]),
    )
}

fn std_error_failure_stmts() -> Vec[Stmt] {
    Vec::from_array(
        [
            Stmt::MultiAssign {
                names: Vec::from_array(["has_raw_code", "raw_code"]),
                value: std_call(
                    "_goml_runtime_error_raw_code",
                    Vec::from_array([Expr::Var { name: "err" }]),
                ),
            },
            Stmt::Return {
                expr: Option::Some(
                    std_error_result_expr(
                        false,
                        std_call(
                            "_goml_runtime_error_kind",
                            Vec::from_array([Expr::Var { name: "err" }]),
                        ),
                        Expr::Var { name: "has_raw_code" },
                        Expr::Var { name: "raw_code" },
                        std_error_string(),
                    ),
                ),
            },
        ],
    )
}

fn std_error_success_stmt() -> Stmt {
    Stmt::Return {
        expr: Option::Some(
            std_error_result_expr(
                true,
                Expr::Int { value: "0" },
                Expr::Bool { value: false },
                Expr::Int { value: "0" },
                Expr::String { value: "" },
            ),
        ),
    }
}

fn std_runtime_error_kind_item() -> Item {
    let params = Vec::from_array([("err", Type::Named { name: "error" })]);
    let stmts: Vec[Stmt] = Vec::new();
    let predicates = Vec::from_array(
        [
            ("_goml_os.IsNotExist", 1),
            ("_goml_os.IsPermission", 2),
            ("_goml_os.IsExist", 3),
            ("_goml_os.IsTimeout", 6),
        ],
    );
    for predicate in predicates {
        let then_stmts = Vec::from_array(
            [Stmt::Return { expr: Option::Some(Expr::Int { value: predicate.1.to_string() }) }],
        );
        stmts.push(
            Stmt::If {
                cond: std_call(predicate.0, Vec::from_array([Expr::Var { name: "err" }])),
                then_: Block { stmts: then_stmts },
                else_: Option::None,
            },
        )
    }
    let stable_errors = Vec::from_array(
        [
            ("_goml_syscall.EINVAL", 4),
            ("_goml_syscall.ENAMETOOLONG", 4),
            ("_goml_syscall.EINTR", 7),
            ("_goml_io.ErrUnexpectedEOF", 8),
            ("_goml_io.EOF", 8),
            ("_goml_io.ErrShortWrite", 9),
            ("_goml_syscall.EPIPE", 10),
            ("_goml_syscall.EAGAIN", 11),
        ],
    );
    for stable_error in stable_errors {
        stmts.push(
            Stmt::If {
                cond: std_call(
                    "_goml_errors.Is",
                    Vec::from_array([Expr::Var { name: "err" }, Expr::Var { name: stable_error.0 }]),
                ),
                then_: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::Return {
                                expr: Option::Some(Expr::Int { value: stable_error.1.to_string() }),
                            },
                        ],
                    ),
                },
                else_: Option::None,
            },
        )
    }
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Int { value: "0" }) });
    Item::Function(
        Function {
            name: "_goml_runtime_error_kind",
            params,
            ret_ty: Option::Some(Type::Int),
            body: Block { stmts },
        },
    )
}

fn std_runtime_errno_switch(value: Expr) -> Stmt {
    let success = Vec::from_array(
        [
            Stmt::ReturnMulti {
                exprs: Vec::from_array(
                    [
                        Expr::Bool { value: true },
                        Expr::Convert { ty: Type::Int, expr: Expr::Var { name: "errno" } },
                    ],
                ),
            },
        ],
    );
    Stmt::TypeSwitch {
        binding: Option::Some("errno"),
        expr: value,
        cases: Vec::from_array(
            [
                TypeSwitchCase {
                    ty: Type::Named { name: "_goml_syscall.Errno" },
                    body: Block { stmts: success },
                },
            ],
        ),
        default: Option::None,
    }
}

fn std_runtime_error_raw_code_item() -> Item {
    let stmts = Vec::from_array(
        [
            Stmt::TypeSwitch {
                binding: Option::Some("host_error"),
                expr: Expr::Var { name: "err" },
                cases: Vec::from_array(
                    [
                        TypeSwitchCase {
                            ty: Type::Pointer { elem: Type::Named { name: "_goml_os.PathError" } },
                            body: Block {
                                stmts: Vec::from_array(
                                    [
                                        std_runtime_errno_switch(
                                            Expr::Field {
                                                expr: Expr::Var { name: "host_error" },
                                                field_name: "Err",
                                            },
                                        ),
                                    ],
                                ),
                            },
                        },
                        TypeSwitchCase {
                            ty: Type::Pointer { elem: Type::Named { name: "_goml_os.LinkError" } },
                            body: Block {
                                stmts: Vec::from_array(
                                    [
                                        std_runtime_errno_switch(
                                            Expr::Field {
                                                expr: Expr::Var { name: "host_error" },
                                                field_name: "Err",
                                            },
                                        ),
                                    ],
                                ),
                            },
                        },
                        TypeSwitchCase {
                            ty: Type::Pointer {
                                elem: Type::Named { name: "_goml_os.SyscallError" },
                            },
                            body: Block {
                                stmts: Vec::from_array(
                                    [
                                        std_runtime_errno_switch(
                                            Expr::Field {
                                                expr: Expr::Var { name: "host_error" },
                                                field_name: "Err",
                                            },
                                        ),
                                    ],
                                ),
                            },
                        },
                    ],
                ),
                default: Option::None,
            },
            Stmt::ReturnMulti {
                exprs: Vec::from_array([Expr::Bool { value: false }, Expr::Int { value: "0" }]),
            },
        ],
    );
    Item::Function(
        Function {
            name: "_goml_runtime_error_raw_code",
            params: Vec::from_array([("err", Type::Named { name: "error" })]),
            ret_ty: Option::Some(Type::Multi { items: Vec::from_array([Type::Bool, Type::Int]) }),
            body: Block { stmts },
        },
    )
}

fn std_bool_strings_string_type() -> Type {
    let values: Vec[repr::Type] = Vec::new();
    values.push(repr::Type::Bool);
    values.push(std_vec_type(repr::Type::String));
    values.push(repr::Type::String);
    std_tuple_type(values)
}

fn std_bool_strings_string_expr(valid: bool, value: Expr, error: Expr) -> Expr {
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: valid });
    values.push(value);
    values.push(error);
    std_tuple_expr(std_bool_strings_string_type(), values)
}

fn std_bool_strings_error_type() -> Type {
    std_tuple_type(
        Vec::from_array(
            [
                repr::Type::Bool,
                std_vec_type(repr::Type::String),
                repr::Type::Int,
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::String,
            ],
        ),
    )
}

fn std_bool_strings_error_expr(
    valid: bool,
    value: Expr,
    kind_code: Expr,
    has_raw_code: Expr,
    raw_code: Expr,
    message: Expr,
) -> Expr {
    std_tuple_expr(
        std_bool_strings_error_type(),
        Vec::from_array(
            [Expr::Bool { value: valid }, value, kind_code, has_raw_code, raw_code, message],
        ),
    )
}

fn std_env_args_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_vec_expr(repr::Type::String, Expr::Var { name: "_goml_os.Args" }),
            ),
        },
    );
    std_function_item(key, Vec::new(), lower_type(std_vec_type(repr::Type::String)), stmts)
}

fn std_env_vars_item(key: string) -> Item {
    let stmts = Vec::from_array(
        [
            Stmt::Return {
                expr: Option::Some(
                    std_vec_expr(repr::Type::String, std_call("_goml_os.Environ", Vec::new())),
                ),
            },
        ],
    );
    std_function_item(key, Vec::new(), lower_type(std_vec_type(repr::Type::String)), stmts)
}

fn std_string_result_item(key: string, function: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("err");
    stmts.push(Stmt::MultiAssign { names, value: std_call(function, Vec::new()) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Var { name: "value" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, Vec::new(), std_bool_string_string_type(), stmts)
}

fn std_env_var_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("name", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: Type::String, value: Option::None });
    stmts.push(Stmt::Var { name: "found", ty: Type::Bool, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("found");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "name" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.LookupEnv", args) });
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Var { name: "found" });
    values.push(Expr::Var { name: "value" });
    stmts.push(Stmt::Return { expr: Option::Some(std_tuple_expr(std_bool_string_type(), values)) });
    std_function_item(key, params, std_bool_string_type(), stmts)
}

fn std_fs_read_file_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("data");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.ReadFile", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Convert { ty: Type::String, expr: Expr::Var { name: "data" } },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_string_type(), stmts)
}

fn std_fs_sha256_file_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "file",
            ty: Type::Pointer { elem: Type::Named { name: "_goml_os.File" } },
            value: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["file", "err"]),
            value: std_call("_goml_os.Open", Vec::from_array([Expr::Var { name: "path" }])),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "digest",
            ty: Type::Named { name: "_goml_hash.Hash" },
            value: Option::Some(std_call("_goml_sha256.New", Vec::new())),
        },
    );
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["_", "err"]),
            value: std_call(
                "_goml_io.Copy",
                Vec::from_array([Expr::Var { name: "digest" }, Expr::Var { name: "file" }]),
            ),
        },
    );
    let copy_failed: Vec[Stmt] = Vec::new();
    copy_failed.push(
        Stmt::Expr { expr: std_method_call(Expr::Var { name: "file" }, "Close", Vec::new()) },
    );
    copy_failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(false, Expr::String { value: "" }, std_error_string()),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: copy_failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Expr { expr: std_method_call(Expr::Var { name: "file" }, "Close", Vec::new()) },
    );
    stmts.push(
        Stmt::Var {
            name: "sum",
            ty: Type::Slice { elem: Type::Uint8 },
            value: Option::Some(
                std_method_call(Expr::Var { name: "digest" }, "Sum", Vec::from_array([Expr::Nil])),
            ),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "encoded",
            ty: Type::Slice { elem: Type::Uint8 },
            value: Option::Some(
                Expr::Make {
                    ty: Type::Slice { elem: Type::Uint8 },
                    args: Vec::from_array(
                        [
                            Expr::Binary {
                                op: BinaryOp::Mul,
                                lhs: std_call("len", Vec::from_array([Expr::Var { name: "sum" }])),
                                rhs: Expr::Int { value: "2" },
                            },
                        ],
                    ),
                },
            ),
        },
    );
    let range_stmts: Vec[Stmt] = Vec::new();
    let encoded_index = Expr::Binary {
        op: BinaryOp::Mul,
        lhs: Expr::Var { name: "index" },
        rhs: Expr::Int { value: "2" },
    };
    let hex_digits = Expr::String { value: "0123456789abcdef" };
    range_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "encoded" },
            index: encoded_index,
            value: Expr::Index {
                base: hex_digits,
                index: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Binary {
                        op: BinaryOp::Shr,
                        lhs: Expr::Var { name: "value" },
                        rhs: Expr::Int { value: "4" },
                    },
                },
            },
        },
    );
    range_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "encoded" },
            index: Expr::Binary {
                op: BinaryOp::Add,
                lhs: encoded_index,
                rhs: Expr::Int { value: "1" },
            },
            value: Expr::Index {
                base: hex_digits,
                index: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Binary {
                        op: BinaryOp::BitAnd,
                        lhs: Expr::Var { name: "value" },
                        rhs: Expr::Int { value: "15" },
                    },
                },
            },
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "value"]),
            expr: Expr::Var { name: "sum" },
            body: Block { stmts: range_stmts },
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_string_expr(
                    true,
                    Expr::Convert { ty: Type::String, expr: Expr::Var { name: "encoded" } },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_string_type(), stmts)
}

fn std_fs_write_file_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("content", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    args.push(
        Expr::Convert { ty: Type::Named { name: "[]byte" }, expr: Expr::Var { name: "content" } },
    );
    args.push(Expr::Int { value: "0644" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_call("_goml_os.WriteFile", args)),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, std_error_string())) },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(true, Expr::String { value: "" })) },
    );
    std_function_item(key, params, std_bool_string_type(), stmts)
}

fn std_fs_read_bytes_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("data");
    names.push("err");
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    stmts.push(Stmt::MultiAssign { names, value: std_call("_goml_os.ReadFile", args) });
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_bytes_string_expr(
                    false,
                    std_vec_expr(repr::Type::Uint8, Expr::Nil),
                    std_error_string(),
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_bytes_string_expr(
                    true,
                    std_vec_expr(repr::Type::Uint8, Expr::Var { name: "data" }),
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_bytes_string_type(), stmts)
}

fn std_fs_read_bytes_v2_item(key: string) -> Item {
    let params = Vec::from_array([("path", Type::String)]);
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["data", "err"]),
            value: std_call("_goml_os.ReadFile", Vec::from_array([Expr::Var { name: "path" }])),
        },
    );
    let failed = Vec::from_array(
        [
            Stmt::MultiAssign {
                names: Vec::from_array(["has_raw_code", "raw_code"]),
                value: std_call(
                    "_goml_runtime_error_raw_code",
                    Vec::from_array([Expr::Var { name: "err" }]),
                ),
            },
            Stmt::Return {
                expr: Option::Some(
                    std_bool_bytes_error_expr(
                        false,
                        std_vec_expr(repr::Type::Uint8, Expr::Nil),
                        std_call(
                            "_goml_runtime_error_kind",
                            Vec::from_array([Expr::Var { name: "err" }]),
                        ),
                        Expr::Var { name: "has_raw_code" },
                        Expr::Var { name: "raw_code" },
                        std_error_string(),
                    ),
                ),
            },
        ],
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_bytes_error_expr(
                    true,
                    std_vec_expr(repr::Type::Uint8, Expr::Var { name: "data" }),
                    Expr::Int { value: "0" },
                    Expr::Bool { value: false },
                    Expr::Int { value: "0" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_bytes_error_type(), stmts)
}

fn std_fs_write_bytes_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("data", lower_type(std_vec_type(repr::Type::Uint8))));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    args.push(Expr::Field { expr: Expr::Var { name: "data" }, field_name: "items" });
    args.push(Expr::Int { value: "0644" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_call("_goml_os.WriteFile", args)),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, std_error_string())) },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(true, Expr::String { value: "" })) },
    );
    std_function_item(key, params, std_bool_string_type(), stmts)
}

fn std_fs_write_bytes_v2_item(key: string) -> Item {
    let params = Vec::from_array(
        [("path", Type::String), ("data", lower_type(std_vec_type(repr::Type::Uint8)))],
    );
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(
                std_call(
                    "_goml_os.WriteFile",
                    Vec::from_array(
                        [
                            Expr::Var { name: "path" },
                            Expr::Field { expr: Expr::Var { name: "data" }, field_name: "items" },
                            Expr::Int { value: "0644" },
                        ],
                    ),
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::MultiAssign {
                            names: Vec::from_array(["has_raw_code", "raw_code"]),
                            value: std_call(
                                "_goml_runtime_error_raw_code",
                                Vec::from_array([Expr::Var { name: "err" }]),
                            ),
                        },
                        Stmt::Return {
                            expr: Option::Some(
                                std_error_result_expr(
                                    false,
                                    std_call(
                                        "_goml_runtime_error_kind",
                                        Vec::from_array([Expr::Var { name: "err" }]),
                                    ),
                                    Expr::Var { name: "has_raw_code" },
                                    Expr::Var { name: "raw_code" },
                                    std_error_string(),
                                ),
                            ),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_error_result_expr(
                    true,
                    Expr::Int { value: "0" },
                    Expr::Bool { value: false },
                    Expr::Int { value: "0" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(key, params, std_error_result_type(), stmts)
}

fn std_error_call_block(call: Expr) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::Some(call) },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: std_error_failure_stmts() },
            else_: Option::None,
        },
    );
    stmts.push(std_error_success_stmt());
    Block { stmts }
}

fn std_fs_copy_case_block() -> Block {
    let bytes = Type::Slice { elem: Type::Uint8 };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "data", ty: bytes, value: Option::None });
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["data", "err"]),
            value: std_call("_goml_os.ReadFile", Vec::from_array([Expr::Var { name: "first" }])),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: std_error_failure_stmts() },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: std_call(
                "_goml_os.WriteFile",
                Vec::from_array(
                    [
                        Expr::Var { name: "second" },
                        Expr::Var { name: "data" },
                        Expr::Int { value: "0644" },
                    ],
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: std_error_failure_stmts() },
            else_: Option::None,
        },
    );
    stmts.push(std_error_success_stmt());
    Block { stmts }
}

fn std_fs_path_operation_v2_item(key: string) -> Item {
    let params = Vec::from_array(
        [("operation", Type::Int), ("first", Type::String), ("second", Type::String)],
    );
    let cases = Vec::from_array(
        [
            SwitchCase {
                value: Expr::Int { value: "0" },
                body: std_error_call_block(
                    std_call(
                        "_goml_os.Mkdir",
                        Vec::from_array([Expr::Var { name: "first" }, Expr::Int { value: "0755" }]),
                    ),
                ),
            },
            SwitchCase {
                value: Expr::Int { value: "1" },
                body: std_error_call_block(
                    std_call(
                        "_goml_os.Rename",
                        Vec::from_array([Expr::Var { name: "first" }, Expr::Var { name: "second" }]),
                    ),
                ),
            },
            SwitchCase {
                value: Expr::Int { value: "2" },
                body: std_error_call_block(
                    std_call(
                        "_goml_os.Link",
                        Vec::from_array([Expr::Var { name: "first" }, Expr::Var { name: "second" }]),
                    ),
                ),
            },
            SwitchCase {
                value: Expr::Int { value: "3" },
                body: std_error_call_block(
                    std_call(
                        "_goml_os.Symlink",
                        Vec::from_array([Expr::Var { name: "first" }, Expr::Var { name: "second" }]),
                    ),
                ),
            },
            SwitchCase { value: Expr::Int { value: "4" }, body: std_fs_copy_case_block() },
        ],
    );
    let stmts = Vec::from_array(
        [
            Stmt::Switch {
                expr: Expr::Var { name: "operation" },
                cases,
                default: Option::Some(
                    Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Return {
                                    expr: Option::Some(
                                        std_error_result_expr(
                                            false,
                                            Expr::Int { value: "4" },
                                            Expr::Bool { value: false },
                                            Expr::Int { value: "0" },
                                            Expr::String { value: "invalid filesystem operation" },
                                        ),
                                    ),
                                },
                            ],
                        ),
                    },
                ),
            },
        ],
    );
    std_function_item(key, params, std_error_result_type(), stmts)
}

fn std_fs_metadata_type() -> Type {
    std_tuple_type(
        Vec::from_array(
            [
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::Int64,
                repr::Type::Uint32,
                repr::Type::Int64,
                repr::Type::Int,
                repr::Type::Bool,
                repr::Type::Int,
                repr::Type::String,
            ],
        ),
    )
}

fn std_fs_metadata_expr(
    ok: bool,
    file_type: Expr,
    size: Expr,
    mode: Expr,
    modified: Expr,
    kind: Expr,
    has_raw_code: Expr,
    raw_code: Expr,
    message: Expr,
) -> Expr {
    std_tuple_expr(
        std_fs_metadata_type(),
        Vec::from_array(
            [
                Expr::Bool { value: ok },
                file_type,
                size,
                mode,
                modified,
                kind,
                has_raw_code,
                raw_code,
                message,
            ],
        ),
    )
}

fn std_fs_metadata_v2_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "info",
            ty: Type::Named { name: "_goml_os.FileInfo" },
            value: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "follow" },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::MultiAssign {
                            names: Vec::from_array(["info", "err"]),
                            value: std_call(
                                "_goml_os.Stat",
                                Vec::from_array([Expr::Var { name: "path" }]),
                            ),
                        },
                    ],
                ),
            },
            else_: Option::Some(
                Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::MultiAssign {
                                names: Vec::from_array(["info", "err"]),
                                value: std_call(
                                    "_goml_os.Lstat",
                                    Vec::from_array([Expr::Var { name: "path" }]),
                                ),
                            },
                        ],
                    ),
                },
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::MultiAssign {
                            names: Vec::from_array(["has_raw_code", "raw_code"]),
                            value: std_call(
                                "_goml_runtime_error_raw_code",
                                Vec::from_array([Expr::Var { name: "err" }]),
                            ),
                        },
                        Stmt::Return {
                            expr: Option::Some(
                                std_fs_metadata_expr(
                                    false,
                                    Expr::Int { value: "3" },
                                    Expr::Int { value: "0" },
                                    Expr::Int { value: "0" },
                                    Expr::Int { value: "0" },
                                    std_call(
                                        "_goml_runtime_error_kind",
                                        Vec::from_array([Expr::Var { name: "err" }]),
                                    ),
                                    Expr::Var { name: "has_raw_code" },
                                    Expr::Var { name: "raw_code" },
                                    std_error_string(),
                                ),
                            ),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "file_type",
            ty: Type::Int,
            value: Option::Some(Expr::Int { value: "3" }),
        },
    );
    let mode = std_method_call(Expr::Var { name: "info" }, "Mode", Vec::new());
    stmts.push(
        Stmt::If {
            cond: std_method_call(mode, "IsRegular", Vec::new()),
            then_: Block {
                stmts: Vec::from_array(
                    [Stmt::Assign { name: "file_type", value: Expr::Int { value: "0" } }],
                ),
            },
            else_: Option::Some(
                Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::If {
                                cond: std_method_call(
                                    Expr::Var { name: "info" },
                                    "IsDir",
                                    Vec::new(),
                                ),
                                then_: Block {
                                    stmts: Vec::from_array(
                                        [
                                            Stmt::Assign {
                                                name: "file_type",
                                                value: Expr::Int { value: "1" },
                                            },
                                        ],
                                    ),
                                },
                                else_: Option::Some(
                                    Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::If {
                                                    cond: Expr::Binary {
                                                        op: BinaryOp::NotEq,
                                                        lhs: Expr::Binary {
                                                            op: BinaryOp::BitAnd,
                                                            lhs: std_method_call(
                                                                Expr::Var { name: "info" },
                                                                "Mode",
                                                                Vec::new(),
                                                            ),
                                                            rhs: Expr::Var {
                                                                name: "_goml_os.ModeSymlink",
                                                            },
                                                        },
                                                        rhs: Expr::Int { value: "0" },
                                                    },
                                                    then_: Block {
                                                        stmts: Vec::from_array(
                                                            [
                                                                Stmt::Assign {
                                                                    name: "file_type",
                                                                    value: Expr::Int { value: "2" },
                                                                },
                                                            ],
                                                        ),
                                                    },
                                                    else_: Option::None,
                                                },
                                            ],
                                        ),
                                    },
                                ),
                            },
                        ],
                    ),
                },
            ),
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_fs_metadata_expr(
                    true,
                    Expr::Var { name: "file_type" },
                    std_method_call(Expr::Var { name: "info" }, "Size", Vec::new()),
                    Expr::Convert {
                        ty: Type::Uint32,
                        expr: std_method_call(
                            std_method_call(Expr::Var { name: "info" }, "Mode", Vec::new()),
                            "Perm",
                            Vec::new(),
                        ),
                    },
                    std_method_call(
                        std_method_call(Expr::Var { name: "info" }, "ModTime", Vec::new()),
                        "UnixNano",
                        Vec::new(),
                    ),
                    Expr::Int { value: "0" },
                    Expr::Bool { value: false },
                    Expr::Int { value: "0" },
                    Expr::String { value: "" },
                ),
            ),
        },
    );
    std_function_item(
        key,
        Vec::from_array([("path", Type::String), ("follow", Type::Bool)]),
        std_fs_metadata_type(),
        stmts,
    )
}

fn std_fs_atomic_failure(close_file: bool) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    if close_file {
        stmts.push(
            Stmt::Expr { expr: std_method_call(Expr::Var { name: "file" }, "Close", Vec::new()) },
        )
    }
    for stmt in std_error_failure_stmts() {
        stmts.push(stmt)
    }
    Block { stmts }
}

fn std_fs_atomic_write_v2_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "file",
            ty: Type::Pointer { elem: Type::Named { name: "_goml_os.File" } },
            value: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "err", ty: Type::Named { name: "error" }, value: Option::None });
    stmts.push(Stmt::Var { name: "has_raw_code", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "raw_code", ty: Type::Int, value: Option::None });
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["file", "err"]),
            value: std_call(
                "_goml_os.CreateTemp",
                Vec::from_array(
                    [
                        std_call(
                            "_goml_filepath.Dir",
                            Vec::from_array([Expr::Var { name: "path" }]),
                        ),
                        Expr::Binary {
                            op: BinaryOp::Add,
                            lhs: Expr::Binary {
                                op: BinaryOp::Add,
                                lhs: Expr::String { value: "." },
                                rhs: std_call(
                                    "_goml_filepath.Base",
                                    Vec::from_array([Expr::Var { name: "path" }]),
                                ),
                            },
                            rhs: Expr::String { value: ".tmp-*" },
                        },
                    ],
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(false),
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "temporary_path",
            ty: Type::String,
            value: Option::Some(std_method_call(Expr::Var { name: "file" }, "Name", Vec::new())),
        },
    );
    stmts.push(
        Stmt::Defer {
            call: std_call(
                "_goml_os.Remove",
                Vec::from_array([Expr::Var { name: "temporary_path" }]),
            ),
        },
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: std_method_call(
                Expr::Var { name: "file" },
                "Chmod",
                Vec::from_array(
                    [
                        Expr::Convert {
                            ty: Type::Named { name: "_goml_os.FileMode" },
                            expr: Expr::Int { value: "0644" },
                        },
                    ],
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(true),
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["_", "err"]),
            value: std_method_call(
                Expr::Var { name: "file" },
                "Write",
                Vec::from_array(
                    [Expr::Field { expr: Expr::Var { name: "data" }, field_name: "items" }],
                ),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(true),
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: std_method_call(Expr::Var { name: "file" }, "Sync", Vec::new()),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(true),
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: std_method_call(Expr::Var { name: "file" }, "Close", Vec::new()),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(false),
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: std_call(
                "_goml_os.Rename",
                Vec::from_array([Expr::Var { name: "temporary_path" }, Expr::Var { name: "path" }]),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: std_fs_atomic_failure(false),
            else_: Option::None,
        },
    );
    stmts.push(std_error_success_stmt());
    std_function_item(
        key,
        Vec::from_array(
            [("path", Type::String), ("data", lower_type(std_vec_type(repr::Type::Uint8)))],
        ),
        std_error_result_type(),
        stmts,
    )
}

fn std_fs_create_dir_all_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "path" });
    args.push(Expr::Int { value: "0755" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "err",
            ty: Type::Named { name: "error" },
            value: Option::Some(std_call("_goml_os.MkdirAll", args)),
        },
    );
    let failed: Vec[Stmt] = Vec::new();
    failed.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, std_error_string())) },
    );
    stmts.push(
        Stmt::If {
            cond: std_error_condition(),
            then_: Block { stmts: failed },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(true, Expr::String { value: "" })) },
    );
    std_function_item(key, params, std_bool_string_type(), stmts)
}

fn std_fs_remove_item(key: string, function: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
