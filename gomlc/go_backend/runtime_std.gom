fn std_path_file_stem_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let base_args: Vec[Expr] = Vec::new();
    base_args.push(Expr::Var { name: "path" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "base",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Base", base_args)),
        },
    );
    let missing_condition = Expr::Binary {
        op: BinaryOp::Or,
        lhs: Expr::Binary {
            op: BinaryOp::Eq,
            lhs: Expr::Var { name: "base" },
            rhs: Expr::String { value: "." },
        },
        rhs: Expr::Binary {
            op: BinaryOp::Eq,
            lhs: Expr::Var { name: "base" },
            rhs: Expr::String { value: ".." },
        },
    };
    let missing: Vec[Stmt] = Vec::new();
    missing.push(
        Stmt::Return { expr: Option::Some(std_bool_string_expr(false, Expr::String { value: "" })) },
    );
    stmts.push(
        Stmt::If { cond: missing_condition, then_: Block { stmts: missing }, else_: Option::None },
    );
    let extension_args: Vec[Expr] = Vec::new();
    extension_args.push(Expr::Var { name: "base" });
    stmts.push(
        Stmt::Var {
            name: "extension",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Ext", extension_args)),
        },
    );
    let clear_extension: Vec[Stmt] = Vec::new();
    clear_extension.push(Stmt::Assign { name: "extension", value: Expr::String { value: "" } });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "extension" },
                rhs: Expr::Var { name: "base" },
            },
            then_: Block { stmts: clear_extension },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_bool_string_expr(
                    true,
                    Expr::Slice {
                        base: Expr::Var { name: "base" },
                        start: Expr::Int { value: "0" },
                        end: Expr::Binary {
                            op: BinaryOp::Sub,
                            lhs: std_call("len", Vec::from_array([Expr::Var { name: "base" }])),
                            rhs: std_call("len", Vec::from_array([Expr::Var { name: "extension" }])),
                        },
                    },
                ),
            ),
        },
    );
    std_function_item(key, params, std_bool_string_type(), stmts)
}

fn std_path_with_extension_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    params.push(("extension", Type::String));
    let base_args: Vec[Expr] = Vec::new();
    base_args.push(Expr::Var { name: "path" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "base",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Base", base_args)),
        },
    );
    let current_args: Vec[Expr] = Vec::new();
    current_args.push(Expr::Var { name: "path" });
    stmts.push(
        Stmt::Var {
            name: "current",
            ty: Type::String,
            value: Option::Some(std_call("_goml_filepath.Ext", current_args)),
        },
    );
    let clear_current: Vec[Stmt] = Vec::new();
    clear_current.push(Stmt::Assign { name: "current", value: Expr::String { value: "" } });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "current" },
                rhs: Expr::Var { name: "base" },
            },
            then_: Block { stmts: clear_current },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "without",
            ty: Type::String,
            value: Option::Some(
                Expr::Slice {
                    base: Expr::Var { name: "path" },
                    start: Expr::Int { value: "0" },
                    end: Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: std_call("len", Vec::from_array([Expr::Var { name: "path" }])),
                        rhs: std_call("len", Vec::from_array([Expr::Var { name: "current" }])),
                    },
                },
            ),
        },
    );
    let empty: Vec[Stmt] = Vec::new();
    empty.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "without" }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "extension" },
                rhs: Expr::String { value: "" },
            },
            then_: Block { stmts: empty },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Binary {
                    op: BinaryOp::Greater,
                    lhs: std_call("len", Vec::from_array([Expr::Var { name: "extension" }])),
                    rhs: Expr::Int { value: "0" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Eq,
                    lhs: Expr::Index {
                        base: Expr::Var { name: "extension" },
                        index: Expr::Int { value: "0" },
                    },
                    rhs: Expr::Int { value: "46" },
                },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Assign {
                            name: "extension",
                            value: Expr::Slice {
                                base: Expr::Var { name: "extension" },
                                start: Expr::Int { value: "1" },
                                end: std_call(
                                    "len",
                                    Vec::from_array([Expr::Var { name: "extension" }]),
                                ),
                            },
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "without" },
                        rhs: Expr::String { value: "." },
                    },
                    rhs: Expr::Var { name: "extension" },
                },
            ),
        },
    );
    std_function_item(key, params, Type::String, stmts)
}

fn std_path_absolute_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("path", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: Type::String, value: Option::None });
