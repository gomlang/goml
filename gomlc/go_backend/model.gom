package go_backend;

use module::ast;
use module::repr;

pub enum Type {
    Void,
    Any,
    Unit,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    Apply {
        base: Type,
        args: Vec[Type],
    },
    Named {
        name: string,
    },
    Pointer {
        elem: Type,
    },
    Array {
        len: isize,
        elem: Type,
    },
    Slice {
        elem: Type,
    },
    Map {
        key: Type,
        value: Type,
    },
    Chan {
        elem: Type,
        direction: ast::ChannelDirection,
    },
    Func {
        params: Vec[Type],
        ret_ty: Type,
    },
    Multi {
        items: Vec[Type],
    },
    Struct {
        fields: Vec[(string, Type)],
    },
}

pub enum UnaryOp {
    Neg,
    Not,
    BitNot,
    Address,
    Deref,
}

pub enum BinaryOp {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    BitAnd,
    BitOr,
    BitXor,
    Shl,
    Shr,
    Less,
    Greater,
    LessEq,
    GreaterEq,
    Eq,
    NotEq,
    And,
    Or,
}

pub enum Expr {
    MethodExpression {
        receiver: Type,
        name: string,
    },
    Nil,
    Unit,
    Var {
        name: string,
    },
    Bool {
        value: bool,
    },
    Int {
        value: string,
    },
    Float {
        value: string,
    },
    String {
        value: string,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
    },
    Instantiate {
        expr: Expr,
        args: Vec[Type],
    },
    CallSpread {
        func: Expr,
        args: Vec[Expr],
        spread: Expr,
    },
    Unary {
        op: UnaryOp,
        expr: Expr,
    },
    Binary {
        op: BinaryOp,
        lhs: Expr,
        rhs: Expr,
    },
    Field {
        expr: Expr,
        field_name: string,
    },
    Index {
        base: Expr,
        index: Expr,
    },
    Slice {
        base: Expr,
        start: Expr,
        end: Expr,
    },
    Cast {
        expr: Expr,
        ty: Type,
    },
    Convert {
        ty: Type,
        expr: Expr,
    },
    Make {
        ty: Type,
        args: Vec[Expr],
    },
    Send {
        channel: Expr,
        value: Expr,
    },
    Receive {
        channel: Expr,
    },
    StructLiteral {
        ty: Type,
        fields: Vec[(string, Expr)],
    },
    ArrayLiteral {
        ty: Type,
        items: Vec[Expr],
    },
    FuncLit {
        params: Vec[(string, Type)],
        ret_ty: Type,
        body: Block,
    },
}

pub struct Block {
    pub stmts: Vec[Stmt],
}

pub struct SwitchCase {
    pub value: Expr,
    pub body: Block,
}

pub struct TypeSwitchCase {
    pub ty: Type,
    pub body: Block,
}

pub enum SelectOperation {
    Receive {
        names: Vec[string],
        channel: Expr,
    },
    Send {
        channel: Expr,
        value: Expr,
    },
}

pub struct SelectCase {
    pub operation: SelectOperation,
    pub body: Block,
}

pub enum Stmt {
    Expr {
        expr: Expr,
    },
    Go {
        call: Expr,
    },
    Defer {
        call: Expr,
    },
    Var {
        name: string,
        ty: Type,
        value: Option[Expr],
    },
    Assign {
        name: string,
        value: Expr,
    },
    FieldAssign {
        target: Expr,
        field_name: string,
        value: Expr,
    },
    IndexAssign {
        base: Expr,
        index: Expr,
        value: Expr,
    },
    MultiAssign {
        names: Vec[string],
        value: Expr,
    },
    Return {
        expr: Option[Expr],
    },
    ReturnMulti {
        exprs: Vec[Expr],
    },
    If {
        cond: Expr,
        then_: Block,
        else_: Option[Block],
    },
    Loop {
        body: Block,
    },
    LabeledLoop {
        label: string,
        body: Block,
    },
    Range {
        names: Vec[string],
        expr: Expr,
        body: Block,
    },
    Break,
    BreakLabel {
        label: string,
    },
    Continue,
    ContinueLabel {
        label: string,
    },
    Switch {
        expr: Expr,
        cases: Vec[SwitchCase],
        default: Option[Block],
    },
    TypeSwitch {
        binding: Option[string],
        expr: Expr,
        cases: Vec[TypeSwitchCase],
        default: Option[Block],
    },
    Select {
        cases: Vec[SelectCase],
        default: Option[Block],
    },
    Panic {
        message: string,
    },
    Unreachable,
}

pub struct StructDef {
    pub name: string,
    pub fields: Vec[(string, Type)],
}

pub struct InterfaceMethod {
    pub name: string,
    pub params: Vec[Type],
    pub ret_ty: Option[Type],
}

pub struct InterfaceDef {
    pub name: string,
    pub methods: Vec[InterfaceMethod],
}

pub struct TypeDef {
    pub name: string,
    pub ty: Type,
}

pub struct ConstSpec {
    pub name: string,
    pub ty: Type,
    pub value: Expr,
}

pub struct ConstGroup {
    pub specs: Vec[ConstSpec],
}

pub struct Global {
    pub name: string,
    pub ty: Option[Type],
    pub value: Expr,
}

pub struct Function {
    pub name: string,
    pub params: Vec[(string, Type)],
    pub ret_ty: Option[Type],
    pub body: Block,
}

pub struct Method {
    pub receiver: (string, Type),
    pub name: string,
    pub params: Vec[(string, Type)],
    pub ret_ty: Option[Type],
    pub body: Block,
}

pub enum Item {
    ImportGroup(Vec[(string, string)]),
    TypeDef(TypeDef),
    ConstGroup(ConstGroup),
    Global(Global),
    Interface(InterfaceDef),
    Struct(StructDef),
    Function(Function),
    Method(Method),
}

pub struct File {
    pub items: Vec[Item],
}

pub struct DynCoercion {
    pub trait_name: string,
    pub for_ty: repr::Type,
}

pub struct DynHelperNames {
    pub factories: Vec[(string, string, string)],
    pub wrappers: Vec[(string, string, string, string)],
}

pub enum EnumStorage {
    Singleton,
    TagOnly,
    Flat,
    PointerNiche,
    Packed,
    Node,
    Interface,
}

pub struct EnumInfo {
    pub owner_name: string,
    pub storage: EnumStorage,
    pub tag_ty: Type,
    pub fields: Vec[(string, repr::Type)],
    pub node_name: string,
    pub nil_tag: Option[isize],
    pub payload_tag: Option[isize],
    pub payload_ty: Option[repr::Type],
}

pub struct VariantInfo {
    pub owner_name: string,
    pub tag: isize,
    pub variant_name: string,
    pub field_types: Vec[repr::Type],
    pub field_names: Vec[Option[string]],
}

pub struct VariantInfos {
    pub by_owner: HashMap[string, Vec[VariantInfo]],
    pub owners: HashMap[string, EnumInfo],
}
