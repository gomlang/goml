package go_backend;

use std::testing;

fn conditional_return_source(count: isize, use_try: bool) -> string {
    let mut source = "fn check(fail: bool) -> Result[(), string] { if fail { Err(\"failure\") } else { Ok(()) } } fn work(active: bool, fail: bool) -> Result[isize, string] {";
    for _ in 0..count {
        source += if use_try {
            "if active { check(fail)?; }"
        } else {
            "if active { if fail { return Err(\"failure\") } }"
        };
    }
    source
        + "println(\"shared-tail-marker\"); Ok(7) } fn main() -> () { let _ = work(true, false); }"
}

#[test]
fn conditional_returns_share_continuations_with_linear_generated_size() -> () {
    for use_try in[false, true] {
        let mut previous = 0;
        for count in[2, 4, 8, 16] {
            let generated = encode(lower_source(conditional_return_source(count, use_try)));
            testing::assert_eq(generated.split("\"shared-tail-marker\"").len(), 2);
            testing::assert(generated.byte_len() < 20000 + count * 4000);
            if previous > 0 {
                testing::assert(generated.byte_len() < previous * 3);
            }
            testing::assert(!generated.contains("goto "));
            previous = generated.byte_len();
        }
    }
}

#[test]
fn terminating_match_and_select_arms_share_the_remaining_path() -> () {
    for branch in[
        "match active { true => { if fail { return 0 } }, false => () };",
        "select { recv(empty) as _ => (), default => { if fail { return 0 } } };",
    ] {
        let source = "fn work(active: bool, fail: bool) -> isize { let empty = Channel::[isize]::new(0); "
            + branch
            + branch
            + "println(\"shared-tail-marker\"); 7 } fn main() -> () { println(work(true, false)); }";
        let generated = encode(lower_source(source));
        testing::assert_eq(generated.split("\"shared-tail-marker\"").len(), 2);
    }
}
