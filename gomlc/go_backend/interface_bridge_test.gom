package go_backend;

use module::repr;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::utf8;
use utf8::BytesUtf8;

#[test]
fn go_interface_bridge_emission_satisfies_native_reader_and_preserves_results() -> () {
    let error = repr::Type::External { import_path: "", name: "error", args: Vec::new() };
    let tuple = repr::Type::Tuple { items: Vec::from_array([repr::Type::Int, error]) };
    let bridge = repr::GoInterfaceBridge {
        target: repr::Type::External { import_path: "io", name: "ReadCloser", args: Vec::new() },
        methods: Vec::from_array(
            [
                repr::GoInterfaceBridgeMethod {
                    name: "Read",
                    signature: repr::Type::Func {
                        params: Vec::from_array([repr::Type::MutSlice { elem: repr::Type::Uint8 }]),
                        ret_ty: tuple,
                    },
                },
                repr::GoInterfaceBridgeMethod {
                    name: "Close",
                    signature: repr::Type::Func { params: Vec::new(), ret_ty: error },
                },
            ],
        ),
    };
    let Ok(generated) = emit_interface_bridge(bridge) else {
        testing::fail("expected valid reader bridge");
        return
    };
    let items = Vec::from_array(
        [
            Item::ImportGroup(Vec::from_array([(go_foreign_import_alias("io"), "io")])),
            Item::Struct(
                StructDef {
                    name: type_name(tuple),
                    fields: Vec::from_array([("_0", Type::Int), ("_1", lower_type(error))]),
                },
            ),
        ],
    );
    for item in generated {
        items.push(item);
    }
    let source = encode_package(
        prune_functions_with_roots(
            File { items },
            Vec::from_array([interface_bridge_factory(bridge)]),
        ),
        "bridge",
    );
    testing::assert(source.contains("var _ "));
    testing::assert(source.contains("return result._0, result._1"));
    let root = "_artifact/go-interface-bridge-emission";
    testing::assert(fs::create_dir_all(root).is_ok());
    testing::assert(
        fs::write_file_structured(path::join(root, "go.mod"), "module bridge\n\ngo 1.26\n").is_ok(),
    );
    testing::assert(fs::write_file_structured(path::join(root, "bridge.go"), source).is_ok());
    let host = "package bridge\nimport (\"io\"; \"testing\")\nfunc TestBridge(t *testing.T) { calls:=0; closed:=0; value:="
        + interface_bridge_factory(bridge)
        + "(func(buffer []byte) "
        + type_name(tuple)
        + " { calls++; n:=copy(buffer,[]byte{97,98,99}); return "
        + type_name(tuple)
        + "{_0:n,_1:io.EOF} },func() error { closed++; return nil }); for i:=0;i<2;i++ { buffer:=make([]byte,3); n,err:=value.Read(buffer); if n!=3 || err!=io.EOF || string(buffer)!=\"abc\" { t.Fatal(n,err,buffer) } }; if value==nil || calls!=2 || value.Close()!=nil || closed!=1 { t.Fatal(calls,closed) } }\n";
    testing::assert(fs::write_file_structured(path::join(root, "bridge_test.go"), host).is_ok());
    match process::Command::new("go").args(Vec::from_array(["test", "./..."])).current_dir(root).env(
        "GOWORK",
        "off",
    ).env("GOTOOLCHAIN", "local").env("GOPROXY", "off").output_structured() {
        Ok(output) => if !output.status().success() {
            testing::fail(output.stderr().to_string_utf8().unwrap_or("Go bridge test failed"));
        },
        Err(error) => testing::fail(error.to_string()),
    }
}

#[test]
fn go_interface_bridge_empty_tuple_results_preserve_effects() -> () {
    let tuple = repr::Type::Tuple { items: Vec::new() };
    let signature = repr::Type::Func { params: Vec::new(), ret_ty: tuple };
    let bridge = repr::GoInterfaceBridge {
        target: repr::Type::External { import_path: "sync", name: "Locker", args: Vec::new() },
        methods: Vec::from_array(
            [
                repr::GoInterfaceBridgeMethod { name: "Lock", signature },
                repr::GoInterfaceBridgeMethod { name: "Unlock", signature },
            ],
        ),
    };
    let Ok(generated) = emit_interface_bridge(bridge) else {
        testing::fail("expected empty-tuple bridge emission");
        return
    };
    let items = Vec::from_array(
        [
            Item::ImportGroup(Vec::from_array([(go_foreign_import_alias("sync"), "sync")])),
            Item::Struct(StructDef { name: type_name(tuple), fields: Vec::new() }),
        ],
    );
    for item in generated {
        items.push(item);
    }
    let source = encode_package(
        prune_functions_with_roots(
            File { items },
            Vec::from_array([interface_bridge_factory(bridge)]),
        ),
        "bridge",
    );
    testing::assert(source.contains("var _ "));
    testing::assert(!source.contains("var result"));
    let root = "_artifact/go-interface-empty-tuple";
    testing::assert(fs::create_dir_all(root).is_ok());
    testing::assert(
        fs::write_file_structured(path::join(root, "go.mod"), "module bridge\n\ngo 1.26\n").is_ok(),
    );
    testing::assert(fs::write_file_structured(path::join(root, "bridge.go"), source).is_ok());
    let host = "package bridge\nimport \"testing\"\nfunc TestEffects(t *testing.T) { count:=0; value:="
        + interface_bridge_factory(bridge)
        + "(func() "
        + type_name(tuple)
        + " { count++; return "
        + type_name(tuple)
        + "{} },func() "
        + type_name(tuple)
        + " { count--; return "
        + type_name(tuple)
        + "{} }); value.Lock(); value.Lock(); value.Unlock(); if count!=1 { t.Fatal(count) } }\n";
    testing::assert(fs::write_file_structured(path::join(root, "bridge_test.go"), host).is_ok());
    match process::Command::new("go").args(Vec::from_array(["test", "./..."])).current_dir(root).env(
        "GOWORK",
        "off",
    ).env("GOTOOLCHAIN", "local").env("GOPROXY", "off").output_structured() {
        Ok(output) => if !output.status().success() {
            testing::fail(output.stderr().to_string_utf8().unwrap_or("empty-tuple Go test failed"));
        },
        Err(error) => testing::fail(error.to_string()),
    }
}
