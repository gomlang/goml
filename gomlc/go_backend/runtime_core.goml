package go_backend;

use module::resources;
use module::repr;

fn core_function_item(key: string, params: Vec[(string, Type)], ret_ty: Type, stmts: Vec[Stmt]) -> Item {
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn core_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Var { name }, args }
}

fn core_len(value: Expr) -> Expr {
    let args: Vec[Expr] = Vec::new();
    args.push(value);
    core_call("len", args)
}

fn core_int(value: Expr) -> Expr {
    Expr::Convert { ty: Type::Int, expr: value }
}

fn core_tuple_type2(first: repr::Type, second: repr::Type) -> Type {
    let values: Vec[repr::Type] = Vec::new();
    values.push(first);
    values.push(second);
    lower_type(repr::Type::Tuple { items: values })
}

fn core_tuple_expr(ty: Type, values: Vec[Expr]) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    for index in 0..values.len() {
        fields.push((f"_{index}", values[index]))
    }
    Expr::StructLiteral { ty, fields }
}

fn string_len_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(core_int(core_len(Expr::Var { name: "s" }))) });
    core_function_item(key, params, Type::Int, stmts)
}

fn string_get_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Convert {
                    ty: Type::Char,
                    expr: Expr::Index {
                        base: Expr::Var { name: "s" },
                        index: Expr::Var { name: "i" },
                    },
                },
            ),
        },
    );
    core_function_item(key, params, Type::Char, stmts)
}

fn string_byte_get_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("i", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Index { base: Expr::Var { name: "s" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    core_function_item(key, params, Type::Uint8, stmts)
}

fn string_byte_slice_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    params.push(("start", Type::Int));
    params.push(("end", Type::Int));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Slice {
                    base: Expr::Var { name: "s" },
                    start: Expr::Var { name: "start" },
                    end: Expr::Var { name: "end" },
                },
            ),
        },
    );
    core_function_item(key, params, Type::String, stmts)
}

fn string_to_bytes_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let elem = repr::Type::Uint8;
    let vec_ty = repr::Type::VecType { elem };
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(
        (
            "items",
            Expr::Convert { ty: Type::Named { name: "[]byte" }, expr: Expr::Var { name: "s" } },
        ),
    );
    let value = Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))) },
            fields,
        },
    };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(value) });
    core_function_item(key, params, lower_type(vec_ty), stmts)
}

fn char_to_string_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", Type::Char));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::String, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item(key, params, Type::String, stmts)
}

fn char_from_uint32_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("value", Type::Uint32));
    let ret_ty = core_tuple_type2(repr::Type::Bool, repr::Type::Char);
    let stmts: Vec[Stmt] = Vec::new();
    let values: Vec[Expr] = Vec::new();
    values.push(Expr::Bool { value: true });
    values.push(Expr::Convert { ty: Type::Char, expr: Expr::Var { name: "value" } });
    stmts.push(Stmt::Return { expr: Option::Some(core_tuple_expr(ret_ty, values)) });
    core_function_item(key, params, ret_ty, stmts)
}

fn integer_hash_hook_item(key: string, ty: Type) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(Expr::Convert { ty: Type::Uint64, expr: Expr::Var { name: "x" } }),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn float_hash_hook_item(key: string, ty: Type, go_name: string, widen: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let zero_stmts: Vec[Stmt] = Vec::new();
    zero_stmts.push(Stmt::Return { expr: Option::Some(Expr::Int { value: "0" }) });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "x" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: zero_stmts },
            else_: Option::None,
        },
    );
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "x" });
    let bits = core_call(go_name, args);
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                if widen {
                    Expr::Convert { ty: Type::Uint64, expr: bits }
                } else {
                    bits
                },
            ),
        },
    );
    core_function_item(key, params, Type::Uint64, stmts)
}

fn string_hash_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(Expr::Int { value: "14695981039346656037" }),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: core_int(core_len(Expr::Var { name: "s" })),
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "h",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Var { name: "h" },
                    rhs: Expr::Int { value: "1099511628211" },
                },
                rhs: Expr::Convert {
                    ty: Type::Uint64,
                    expr: Expr::Index {
                        base: Expr::Var { name: "s" },
                        index: Expr::Var { name: "i" },
                    },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "h" }) });
    core_function_item(key, params, Type::Uint64, stmts)
}

fn core_runtime_hook_item(hook: resources::CoreRuntimeHook, key: string) -> Item {
    match hook {
        DeferPush => defer_push_item(key),
        DeferPop => defer_pop_item(key),
        UnitToString => unit_to_string_hook_item(key),
        BoolToString => bool_to_string_hook_item(key),
        StringLen => string_len_hook_item(key),
        StringGet => string_get_hook_item(key),
        StringByteGet => string_byte_get_hook_item(key),
        StringByteSlice => string_byte_slice_hook_item(key),
        StringToBytes => string_to_bytes_hook_item(key),
        StringFromUtf8 => string_from_utf8_hook_item(key),
        StringConcat => string_concat_hook_item(key),
        CharToString => char_to_string_hook_item(key),
        CharFromUint32 => char_from_uint32_hook_item(key),
        IntToString => integer_to_string_hook_item(key, Type::Int, true),
        Int8ToString => integer_to_string_hook_item(key, Type::Int8, true),
        Int16ToString => integer_to_string_hook_item(key, Type::Int16, true),
        Int32ToString => integer_to_string_hook_item(key, Type::Int32, true),
        Int64ToString => integer_to_string_hook_item(key, Type::Int64, true),
        UintToString => integer_to_string_hook_item(key, Type::Uint, false),
        Uint8ToString => integer_to_string_hook_item(key, Type::Uint8, false),
        Uint16ToString => integer_to_string_hook_item(key, Type::Uint16, false),
        Uint32ToString => integer_to_string_hook_item(key, Type::Uint32, false),
        Uint64ToString => integer_to_string_hook_item(key, Type::Uint64, false),
        IntHash => integer_hash_hook_item(key, Type::Int),
        Int8Hash => integer_hash_hook_item(key, Type::Int8),
        Int16Hash => integer_hash_hook_item(key, Type::Int16),
        Int32Hash => integer_hash_hook_item(key, Type::Int32),
        Int64Hash => integer_hash_hook_item(key, Type::Int64),
        CharHash => integer_hash_hook_item(key, Type::Char),
        UintHash => integer_hash_hook_item(key, Type::Uint),
        Uint8Hash => integer_hash_hook_item(key, Type::Uint8),
        Uint16Hash => integer_hash_hook_item(key, Type::Uint16),
        Uint32Hash => integer_hash_hook_item(key, Type::Uint32),
        Float32Hash => float_hash_hook_item(key, Type::Float32, "_goml_math.Float32bits", true),
        Float64Hash => float_hash_hook_item(key, Type::Float64, "_goml_math.Float64bits", false),
        StringHash => string_hash_hook_item(key),
        StringPrint => string_output_hook_item(key, false),
        StringPrintln => string_output_hook_item(key, true),
    }
}
