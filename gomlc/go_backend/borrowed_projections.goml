package go_backend;

use module::anf;
use module::repr;
use std::collections;

struct ProjectionBindings {
    bindings: Vec[anf::LetBind],
    locals: collections::HashSet[string],
    mutable: collections::HashSet[string],
}

impl ProjectionBindings {
    fn declare(self: ProjectionBindings, name: string) -> () {
        if !self.locals.insert(name) {
            let _ = self.mutable.insert(name);
        }
    }

    fn join(self: ProjectionBindings, value: anf::JoinBind) -> () {
        for (name, _) in value.params {
            self.declare(name);
            let _ = self.mutable.insert(name);
        }
        self.block(value.body);
    }

    fn block(self: ProjectionBindings, value: anf::Block) -> () {
        for binding in value.binds {
            match binding {
                Let(value) => {
                    self.declare(value.name);
                    self.bindings.push(value);
                    if let anf::Value::Assign { name, .. } = value.value {
                        let _ = self.mutable.insert(name);
                    }
                },
                Join(value) => self.join(value),
                JoinRec(values) => for value in values {
                    self.join(value);
                },
            }
        }
        match value.term {
            If { then_, else_, .. } => {
                self.block(then_);
                self.block(else_);
            },
            Match { arms, default, .. } => {
                for arm in arms {
                    self.block(arm.body);
                }
                if let Some(body) = default {
                    self.block(body);
                }
            },
            Select { arms, default, .. } => {
                for arm in arms {
                    match arm {
                        Receive { binding, body, .. } => {
                            self.declare(binding);
                            let _ = self.mutable.insert(binding);
                            self.block(body);
                        },
                        Send { body, .. } => self.block(body),
                    }
                }
                if let Some(body) = default {
                    self.block(body);
                }
            },
            Return(_) | Jump { .. } | Unreachable { .. } => (),
        }
    }
}

fn borrowed_struct_projections(function: anf::Function, structs: Vec[repr::StructDef]) -> collections::HashSet[
    string,
] {
    let collected = ProjectionBindings {
        bindings: Vec::new(),
        locals: collections::HashSet::new(),
        mutable: collections::HashSet::new(),
    };
    for (name, _) in function.params {
        collected.declare(name);
    }
    collected.block(function.body);
    let result: collections::HashSet[string] = collections::HashSet::new();
    for binding in collected.bindings {
        if let anf::Value::ConstrGet { expr: anf::Imm::Var { name, .. }, constructor, .. } = binding.value {
            if constructor.is_struct && collected.locals.contains(name)
                && !collected.mutable.contains(name)
                && !collected.mutable.contains(binding.name)
                && borrowable_projection_type(structs, binding.ty) {
                let _ = result.insert(binding.name);
            }
        }
    }
    result
}

fn borrowable_projection_type(structs: Vec[repr::StructDef], value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Array { .. } => true,
        _ => large_named_struct(structs, value),
    }
}
