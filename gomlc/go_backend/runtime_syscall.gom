package go_backend;

use module::repr;

fn linux_syscall6_result_type() -> Type {
    std_tuple_type(
        Vec::from_array([repr::Type::Bool, repr::Type::Uint, repr::Type::Uint, repr::Type::Uint]),
    )
}

fn linux_syscall_saved_pointer() -> Expr {
    Expr::Slice {
        base: Expr::Index { base: Expr::Var { name: "saved" }, index: Expr::Var { name: "index" } },
        start: Expr::Int { value: "0" },
        end: Expr::Int { value: "8" },
    }
}

fn linux_syscall_pin(name: string) -> Stmt {
    Stmt::If {
        cond: Expr::Binary {
            op: BinaryOp::Greater,
            lhs: std_call("len", Vec::from_array([Expr::Var { name }])),
            rhs: Expr::Int { value: "0" },
        },
        then_: Block {
            stmts: Vec::from_array(
                [
                    Stmt::Expr {
                        expr: std_method_call(
                            Expr::Var { name: "pins" },
                            "Pin",
                            Vec::from_array(
                                [
                                    Expr::Unary {
                                        op: UnaryOp::Address,
                                        expr: Expr::Index {
                                            base: Expr::Var { name },
                                            index: Expr::Int { value: "0" },
                                        },
                                    },
                                ],
                            ),
                        ),
                    },
                ],
            ),
        },
        else_: Option::None,
    }
}

fn linux_syscall_pointer_stmts(stmts: Vec[Stmt]) -> () {
    let saved_type = Type::Slice { elem: Type::Array { len: 8, elem: Type::Uint8 } };
    stmts.push(
        Stmt::Var {
            name: "saved",
            ty: saved_type,
            value: Option::Some(
                Expr::Make {
                    ty: saved_type,
                    args: Vec::from_array(
                        [std_call("len", Vec::from_array([Expr::Var { name: "slots" }]))],
                    ),
                },
            ),
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "slot"]),
            expr: Expr::Var { name: "slots" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        linux_syscall_pin("slot"),
                        Stmt::Var {
                            name: "target",
                            ty: Type::Slice { elem: Type::Uint8 },
                            value: Option::Some(
                                Expr::Index {
                                    base: Expr::Var { name: "targets" },
                                    index: Expr::Var { name: "index" },
                                },
                            ),
                        },
                        linux_syscall_pin("target"),
                        Stmt::Expr {
                            expr: std_call(
                                "copy",
                                Vec::from_array(
                                    [linux_syscall_saved_pointer(), Expr::Var { name: "slot" }],
                                ),
                            ),
                        },
                    ],
                ),
            },
        },
    );
    stmts.push(
        Stmt::Defer {
            call: Expr::Call {
                func: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Void,
                    body: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Range {
                                    names: Vec::from_array(["index", "slot"]),
                                    expr: Expr::Var { name: "slots" },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Expr {
                                                    expr: std_call(
                                                        "copy",
                                                        Vec::from_array(
                                                            [
                                                                Expr::Var { name: "slot" },
                                                                linux_syscall_saved_pointer(),
                                                            ],
                                                        ),
                                                    ),
                                                },
                                            ],
                                        ),
                                    },
                                },
                            ],
                        ),
                    },
                },
                args: Vec::new(),
            },
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "target"]),
            expr: Expr::Var { name: "targets" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Var {
                            name: "address",
                            ty: Type::Named { name: "uintptr" },
                            value: Option::None,
                        },
                        Stmt::If {
                            cond: Expr::Binary {
                                op: BinaryOp::Greater,
                                lhs: std_call(
                                    "len",
                                    Vec::from_array([Expr::Var { name: "target" }]),
                                ),
                                rhs: Expr::Int { value: "0" },
                            },
                            then_: Block {
                                stmts: Vec::from_array(
                                    [
                                        Stmt::Assign {
                                            name: "address",
                                            value: std_call(
                                                "uintptr",
                                                Vec::from_array(
                                                    [
                                                        std_call(
                                                            "_goml_unsafe.Pointer",
                                                            Vec::from_array(
                                                                [
                                                                    Expr::Unary {
                                                                        op: UnaryOp::Address,
                                                                        expr: Expr::Index {
                                                                            base: Expr::Var {
                                                                                name: "target",
                                                                            },
                                                                            index: Expr::Int {
                                                                                value: "0",
                                                                            },
                                                                        },
                                                                    },
                                                                ],
                                                            ),
                                                        ),
                                                    ],
                                                ),
                                            ),
                                        },
                                    ],
                                ),
                            },
                            else_: Option::None,
                        },
                        Stmt::Range {
                            names: Vec::from_array(["offset"]),
                            expr: Expr::Int { value: "8" },
                            body: Block {
                                stmts: Vec::from_array(
                                    [
                                        Stmt::IndexAssign {
                                            base: Expr::Index {
                                                base: Expr::Var { name: "slots" },
                                                index: Expr::Var { name: "index" },
                                            },
                                            index: Expr::Var { name: "offset" },
                                            value: std_call(
                                                "byte",
                                                Vec::from_array(
                                                    [
                                                        Expr::Binary {
                                                            op: BinaryOp::Shr,
                                                            lhs: Expr::Var { name: "address" },
                                                            rhs: Expr::Binary {
                                                                op: BinaryOp::Mul,
                                                                lhs: Expr::Var { name: "offset" },
                                                                rhs: Expr::Int { value: "8" },
                                                            },
                                                        },
                                                    ],
                                                ),
                                            ),
                                        },
                                    ],
                                ),
                            },
                        },
                    ],
                ),
            },
        },
    );
}

fn linux_syscall6_item(key: string, with_pointers: bool) -> Item {
    let uintptr = Type::Named { name: "uintptr" };
    let params = Vec::from_array(
        [
            ("number", Type::Uint),
            ("words", Type::Array { len: 6, elem: Type::Uint }),
            ("buffers", Type::Array { len: 6, elem: Type::Slice { elem: Type::Uint8 } }),
        ],
    );
    if with_pointers {
        let views = Type::Slice { elem: Type::Slice { elem: Type::Uint8 } };
        params.push(("slots", views));
        params.push(("targets", views));
    }
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Or,
                lhs: Expr::Binary {
                    op: BinaryOp::NotEq,
                    lhs: Expr::Var { name: "_goml_runtime_pkg.GOOS" },
                    rhs: Expr::String { value: "linux" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::NotEq,
                    lhs: Expr::Var { name: "_goml_runtime_pkg.GOARCH" },
                    rhs: Expr::String { value: "amd64" },
                },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Return {
                            expr: Option::Some(
                                std_tuple_expr(
                                    linux_syscall6_result_type(),
                                    Vec::from_array(
                                        [
                                            Expr::Bool { value: false },
                                            Expr::Int { value: "0" },
                                            Expr::Int { value: "0" },
                                            Expr::Int { value: "0" },
                                        ],
                                    ),
                                ),
                            ),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "pins",
            ty: Type::Named { name: "_goml_runtime_pkg.Pinner" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Defer { call: std_method_call(Expr::Var { name: "pins" }, "Unpin", Vec::new()) },
    );
    stmts.push(
        Stmt::Var {
            name: "arguments",
            ty: Type::Array { len: 6, elem: uintptr },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "word"]),
            expr: Expr::Var { name: "words" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::IndexAssign {
                            base: Expr::Var { name: "arguments" },
                            index: Expr::Var { name: "index" },
                            value: std_call(
                                "uintptr",
                                Vec::from_array([Expr::Var { name: "word" }]),
                            ),
                        },
                    ],
                ),
            },
        },
    );
    let pointer = Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::Index { base: Expr::Var { name: "buffer" }, index: Expr::Int { value: "0" } },
    };
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["index", "buffer"]),
            expr: Expr::Var { name: "buffers" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::If {
                            cond: Expr::Binary {
                                op: BinaryOp::Greater,
                                lhs: std_call(
                                    "len",
                                    Vec::from_array([Expr::Var { name: "buffer" }]),
                                ),
                                rhs: Expr::Int { value: "0" },
                            },
                            then_: Block {
                                stmts: Vec::from_array(
                                    [
                                        Stmt::Expr {
                                            expr: std_method_call(
                                                Expr::Var { name: "pins" },
                                                "Pin",
                                                Vec::from_array([pointer]),
                                            ),
                                        },
                                        Stmt::IndexAssign {
                                            base: Expr::Var { name: "arguments" },
                                            index: Expr::Var { name: "index" },
                                            value: std_call(
                                                "uintptr",
                                                Vec::from_array(
                                                    [
                                                        std_call(
                                                            "_goml_unsafe.Pointer",
                                                            Vec::from_array([pointer]),
                                                        ),
                                                    ],
                                                ),
                                            ),
                                        },
                                    ],
                                ),
                            },
                            else_: Option::None,
                        },
                    ],
                ),
            },
        },
    );
    stmts.push(Stmt::Var { name: "r1", ty: uintptr, value: Option::None });
    if with_pointers {
        linux_syscall_pointer_stmts(stmts);
    }
    stmts.push(Stmt::Var { name: "r2", ty: uintptr, value: Option::None });
    stmts.push(
        Stmt::Var {
            name: "errno",
            ty: Type::Named { name: "_goml_syscall.Errno" },
            value: Option::None,
        },
    );
    let arguments = Vec::from_array(
        [std_call("uintptr", Vec::from_array([Expr::Var { name: "number" }]))],
    );
    for index in 0..6 {
        arguments.push(
            Expr::Index {
                base: Expr::Var { name: "arguments" },
                index: Expr::Int { value: index.to_string() },
            },
        )
    }
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["r1", "r2", "errno"]),
            value: std_call("_goml_syscall.Syscall6", arguments),
        },
    );
    stmts.push(
        Stmt::Expr {
            expr: std_call(
                "_goml_runtime_pkg.KeepAlive",
                Vec::from_array([Expr::Var { name: "buffers" }]),
            ),
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                std_tuple_expr(
                    linux_syscall6_result_type(),
                    Vec::from_array(
                        [
                            Expr::Bool { value: true },
                            std_call("uint", Vec::from_array([Expr::Var { name: "r1" }])),
                            std_call("uint", Vec::from_array([Expr::Var { name: "r2" }])),
                            std_call("uint", Vec::from_array([Expr::Var { name: "errno" }])),
                        ],
                    ),
                ),
            ),
        },
    );
    std_function_item(key, params, linux_syscall6_result_type(), stmts)
}
