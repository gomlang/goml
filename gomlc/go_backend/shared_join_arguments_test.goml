package go_backend;

use module::anf;
use module::ast;
use module::repr;
use std::fs;
use std::path;
use std::process;
use std::testing;
use std::time;
use std::utf8;
use utf8::BytesUtf8;

fn shared_args_int(value: string) -> anf::Imm {
    Prim { value: repr::Primitive::Int { value }, ty: repr::Type::Int }
}

fn shared_args_var(name: string, ty: repr::Type) -> anf::Imm {
    Var { name, ty }
}

fn shared_args_bind(name: string, value: anf::Value) -> anf::Bind {
    Let(anf::LetBind { name, ty: anf::value_type(value), value })
}

fn shared_args_jump(target: string, args: Vec[anf::Imm]) -> anf::Block {
    anf::Block { binds: Vec::new(), term: Jump { target, args, ret_ty: repr::Type::Int } }
}

#[test]
fn nested_shared_joins_assign_tuple_and_struct_arguments_before_exiting() -> () {
    let int_ty = repr::Type::Int;
    let pair_ty = repr::Type::Tuple { items: Vec::from_array([int_ty, int_ty]) };
    let record_ty = repr::Type::Named { name: "Payload" };
    let constructor = repr::Constructor {
        name: "Payload",
        fields: Vec::from_array(["value"]),
        is_struct: true,
        tag: None,
    };
    let finish = anf::JoinBind {
        name: "finish",
        role: anf::JoinRole::Continuation,
        params: Vec::from_array([("result_pair", pair_ty), ("result_record", record_ty)]),
        ret_ty: int_ty,
        body: anf::Block {
            binds: Vec::from_array(
                [
                    shared_args_bind(
                        "left",
                        Proj {
                            tuple: shared_args_var("result_pair", pair_ty),
                            index: 0,
                            ty: int_ty,
                        },
                    ),
                    shared_args_bind(
                        "right",
                        Proj {
                            tuple: shared_args_var("result_pair", pair_ty),
                            index: 1,
                            ty: int_ty,
                        },
                    ),
                    shared_args_bind(
                        "extra",
                        ConstrGet {
                            expr: shared_args_var("result_record", record_ty),
                            constructor,
                            field_index: 0,
                            ty: int_ty,
                        },
                    ),
                    shared_args_bind(
                        "sum",
                        Binary {
                            op: ast::BinaryOp::Add,
                            lhs: shared_args_var("left", int_ty),
                            rhs: shared_args_var("right", int_ty),
                            ty: int_ty,
                        },
                    ),
                    shared_args_bind(
                        "total",
                        Binary {
                            op: ast::BinaryOp::Add,
                            lhs: shared_args_var("sum", int_ty),
                            rhs: shared_args_var("extra", int_ty),
                            ty: int_ty,
                        },
                    ),
                ],
            ),
            term: anf::Term::Return(shared_args_var("total", int_ty)),
        },
    };
    let relay = anf::JoinBind {
        name: "relay",
        role: anf::JoinRole::Continuation,
        params: Vec::from_array([("relay_pair", pair_ty), ("relay_record", record_ty)]),
        ret_ty: int_ty,
        body: anf::Block {
            binds: Vec::new(),
            term: If {
                cond: shared_args_var("early", repr::Type::Bool),
                then_: anf::Block {
                    binds: Vec::new(),
                    term: anf::Term::Return(shared_args_int("999")),
                },
                else_: shared_args_jump(
                    "finish",
                    Vec::from_array(
                        [
                            shared_args_var("relay_pair", pair_ty),
                            shared_args_var("relay_record", record_ty),
                        ],
                    ),
                ),
                ret_ty: int_ty,
            },
        },
    };
    let bindings = Vec::new();
    for (name, first, second) in[("pair_a", "10", "20"), ("pair_b", "40", "50")] {
        bindings.push(
            shared_args_bind(
                name,
                Tuple {
                    items: Vec::from_array([shared_args_int(first), shared_args_int(second)]),
                    ty: pair_ty,
                },
            ),
        );
    }
    for (name, value) in[("record_a", "30"), ("record_b", "60")] {
        bindings.push(
            shared_args_bind(
                name,
                Constr {
                    constructor,
                    args: Vec::from_array([shared_args_int(value)]),
                    ty: record_ty,
                },
            ),
        );
    }
    bindings.push(anf::Bind::Join(finish));
    bindings.push(anf::Bind::Join(relay));
    let route = anf::Function {
        name: "route",
        origin: anf::FunctionOrigin::Source,
        root: true,
        trait_impl: None,
        params: Vec::from_array(
            [("first", repr::Type::Bool), ("second", repr::Type::Bool), ("early", repr::Type::Bool)],
        ),
        ret_ty: int_ty,
        body: anf::Block {
            binds: bindings,
            term: If {
                cond: shared_args_var("first", repr::Type::Bool),
                then_: anf::Block {
                    binds: Vec::new(),
                    term: If {
                        cond: shared_args_var("second", repr::Type::Bool),
                        then_: anf::Block {
                            binds: Vec::new(),
                            term: anf::Term::Return(shared_args_int("3")),
                        },
                        else_: shared_args_jump(
                            "relay",
                            Vec::from_array(
                                [
                                    shared_args_var("pair_a", pair_ty),
                                    shared_args_var("record_a", record_ty),
                                ],
                            ),
                        ),
                        ret_ty: int_ty,
                    },
                },
                else_: shared_args_jump(
                    "finish",
                    Vec::from_array(
                        [shared_args_var("pair_b", pair_ty), shared_args_var("record_b", record_ty)],
                    ),
                ),
                ret_ty: int_ty,
            },
        },
    };
    let flag = anf::Imm::Prim {
        value: repr::Primitive::Bool { value: false },
        ty: repr::Type::Bool,
    };
    let main = anf::Function {
        name: "main",
        origin: anf::FunctionOrigin::Source,
        root: true,
        trait_impl: None,
        params: Vec::new(),
        ret_ty: repr::Type::Unit,
        body: anf::Block {
            binds: Vec::from_array(
                [
                    shared_args_bind(
                        "result",
                        Call {
                            func: Callable {
                                callable: repr::Callable::Function("route"),
                                ty: repr::Type::Func {
                                    params: Vec::from_array(
                                        [repr::Type::Bool, repr::Type::Bool, repr::Type::Bool],
                                    ),
                                    ret_ty: int_ty,
                                },
                            },
                            args: Vec::from_array([flag, flag, flag]),
                            ty: int_ty,
                        },
                    ),
                ],
            ),
            term: anf::Term::Return(
                anf::Imm::Prim { value: repr::Primitive::Unit, ty: repr::Type::Unit },
            ),
        },
    };
    let generated = encode(
        required_lower(
            lower_anf_for_test(
                anf::File {
                    functions: Vec::from_array([route, main]),
                    enums: Vec::new(),
                    structs: Vec::from_array(
                        [
                            repr::StructDef {
                                name: "Payload",
                                fields: Vec::from_array([("value", int_ty)]),
                                public_fields: Vec::new(),
                                has_hidden_fields: false,
                            },
                        ],
                    ),
                    type_instances: Vec::new(),
                    constants: Vec::new(),
                    statics: Vec::new(),
                    closure_defs: Vec::new(),
                },
            ),
        ),
    );
    let root = "_artifact/shared-join-arguments";
    testing::assert(fs::create_dir_all(root).is_ok());
    testing::assert(
        fs::write_file_structured(path::join(root, "go.mod"), "module sharedjoins\n\ngo 1.26\n").is_ok(),
    );
    testing::assert(fs::write_file_structured(path::join(root, "generated.go"), generated).is_ok());
    let host =
        \\package main
        \\import "testing"
        \\func TestJoinArguments(t *testing.T) {
        \\    for _, first := range []bool{false, true} {
        \\        for _, second := range []bool{false, true} {
        \\            for _, early := range []bool{false, true} {
        \\                want := 150
        \\                if first {
        \\                    if second { want = 3 } else if early { want = 999 } else { want = 60 }
        \\                }
        \\                if got := route(first, second, early); got != want {
        \\                    t.Fatalf("route(%v,%v,%v) = %d, want %d", first, second, early, got, want)
        \\                }
        \\            }
        \\        }
        \\    }
        \\}
    ;
    testing::assert(fs::write_file_structured(path::join(root, "generated_test.go"), host).is_ok());
    let output = process::Command::new("go").args(
        Vec::from_array(["test", "-pgo=off", "-count=1", "-timeout=30s", "."]),
    ).current_dir(root).env("GOWORK", "off").env("GOTOOLCHAIN", "local").env("GOPROXY", "off").output_timeout_structured(
        time::Duration::from_seconds(120),
    );
    match output {
        Ok(output) => if !output.status().success() {
            testing::fail(
                output.stdout().to_string_utf8().unwrap_or("")
                    + output.stderr().to_string_utf8().unwrap_or("shared join arguments failed"),
            );
        },
        Err(error) => testing::fail(error.to_string()),
    }
}
