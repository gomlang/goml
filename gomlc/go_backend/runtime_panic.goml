package go_backend;

fn defer_stack_name() -> string {
    go_generated_ident("_goml_defer_stack")
}

fn defer_stack_type() -> Type {
    Type::Named { name: go_generated_ident("_goml_defer_state") }
}

fn defer_action_type() -> Type {
    Type::Func { params: Vec::new(), ret_ty: Type::Unit }
}

fn defer_drain_name() -> string {
    go_generated_ident("_goml_defer_drain")
}

fn defer_take_name() -> string {
    go_generated_ident("_goml_defer_take")
}

fn runtime_var(name: string) -> Expr {
    Expr::Var { name }
}

fn runtime_field(name: string, field_name: string) -> Expr {
    Expr::Field { expr: runtime_var(name), field_name }
}

fn defer_support_items() -> Vec[Item] {
    let items = Vec::new();
    items.push(
        Item::Struct(
            StructDef {
                name: go_generated_ident("_goml_defer_state"),
                fields: Vec::from_array([("actions", Type::Slice { elem: defer_action_type() })]),
            },
        ),
    );
    let actions = runtime_field("stack", "actions");
    let take = Vec::from_array(
        [
            Stmt::Var {
                name: "index",
                ty: Type::Int,
                value: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: std_call("len", Vec::from_array([actions])),
                        rhs: Expr::Int { value: "1" },
                    },
                ),
            },
            Stmt::Var {
                name: "action",
                ty: defer_action_type(),
                value: Option::Some(Expr::Index { base: actions, index: runtime_var("index") }),
            },
            Stmt::IndexAssign { base: actions, index: runtime_var("index"), value: Expr::Nil },
            Stmt::FieldAssign {
                target: runtime_var("stack"),
                field_name: "actions",
                value: Expr::Slice {
                    base: actions,
                    start: Expr::Int { value: "0" },
                    end: runtime_var("index"),
                },
            },
            Stmt::Return { expr: Option::Some(runtime_var("action")) },
        ],
    );
    let params = Vec::from_array([("stack", Type::Pointer { elem: defer_stack_type() })]);
    items.push(
        Item::Function(
            Function {
                name: defer_take_name(),
                params,
                ret_ty: Option::Some(defer_action_type()),
                body: Block { stmts: take },
            },
        ),
    );
    let drain = Vec::from_array(
        [
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::NotEq,
                    lhs: std_call("len", Vec::from_array([actions])),
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::Var {
                                name: "action",
                                ty: defer_action_type(),
                                value: Option::Some(
                                    std_call(
                                        defer_take_name(),
                                        Vec::from_array([runtime_var("stack")]),
                                    ),
                                ),
                            },
                            Stmt::Defer {
                                call: std_call(
                                    defer_drain_name(),
                                    Vec::from_array([runtime_var("stack")]),
                                ),
                            },
                            Stmt::Expr { expr: std_call("action", Vec::new()) },
                        ],
                    ),
                },
                else_: Option::None,
            },
        ],
    );
    items.push(
        Item::Function(
            Function {
                name: defer_drain_name(),
                params,
                ret_ty: Option::None,
                body: Block { stmts: drain },
            },
        ),
    );
    items
}

fn defer_push_item(key: string) -> Item {
    std_function_item(
        key,
        Vec::from_array(
            [("stack", Type::Pointer { elem: defer_stack_type() }), ("action", defer_action_type())],
        ),
        Type::Unit,
        Vec::from_array(
            [
                Stmt::FieldAssign {
                    target: runtime_var("stack"),
                    field_name: "actions",
                    value: std_call(
                        "append",
                        Vec::from_array([runtime_field("stack", "actions"), runtime_var("action")]),
                    ),
                },
                Stmt::Return { expr: Option::Some(Expr::Unit) },
            ],
        ),
    )
}

fn defer_pop_item(key: string) -> Item {
    std_function_item(
        key,
        Vec::from_array([("stack", Type::Pointer { elem: defer_stack_type() })]),
        Type::Unit,
        Vec::from_array(
            [
                Stmt::Var {
                    name: "action",
                    ty: defer_action_type(),
                    value: Option::Some(
                        std_call(defer_take_name(), Vec::from_array([runtime_var("stack")])),
                    ),
                },
                Stmt::Return { expr: Option::Some(std_call("action", Vec::new())) },
            ],
        ),
    )
}

fn panic_info_type() -> Type {
    Type::Pointer { elem: Type::Named { name: go_generated_ident("_goml_panic_info") } }
}

fn panic_payload_type() -> Type {
    Type::Named { name: go_generated_ident("_goml_panic_payload") }
}

fn panic_diagnostic(value: Expr) -> Expr {
    Expr::Convert {
        ty: Type::String,
        expr: Expr::Convert { ty: Type::Slice { elem: Type::Char }, expr: value },
    }
}

fn panic_info_value(value: Expr, message: Expr, stack: Expr) -> Expr {
    Expr::Unary {
        op: UnaryOp::Address,
        expr: Expr::StructLiteral {
            ty: Type::Named { name: go_generated_ident("_goml_panic_info") },
            fields: Vec::from_array(
                [
                    ("value", value),
                    ("message", panic_diagnostic(message)),
                    ("stack", panic_diagnostic(stack)),
                ],
            ),
        },
    }
}

fn panic_support_items() -> Vec[Item] {
    let items = Vec::from_array(
        [
            Item::Struct(
                StructDef {
                    name: go_generated_ident("_goml_panic_info"),
                    fields: Vec::from_array(
                        [("value", Type::Any), ("message", Type::String), ("stack", Type::String)],
                    ),
                },
            ),
        ],
    );
    let methods = Vec::new();
    for (name, field, ty) in Vec::from_array(
        [
            ("Error", "message", Type::String),
            ("GomlPanicValue", "value", Type::Any),
            ("GomlPanicMessage", "message", Type::String),
            ("GomlPanicStack", "stack", Type::String),
        ],
    ) {
        items.push(
            Item::Method(
                Method {
                    receiver: ("info", panic_info_type()),
                    name,
                    params: Vec::new(),
                    ret_ty: Option::Some(ty),
                    body: Block {
                        stmts: Vec::from_array(
                            [Stmt::Return { expr: Option::Some(runtime_field("info", field)) }],
                        ),
                    },
                },
            ),
        );
        if name != "Error" {
            methods.push(InterfaceMethod { name, params: Vec::new(), ret_ty: Option::Some(ty) });
        }
    }
    items.push(
        Item::Interface(InterfaceDef { name: go_generated_ident("_goml_panic_payload"), methods }),
    );
    items
}

fn panic_raise_item(key: string) -> Item {
    std_function_item(
        key,
        Vec::from_array([("message", Type::String)]),
        Type::Unit,
        Vec::from_array(
            [Stmt::Expr { expr: std_call("panic", Vec::from_array([runtime_var("message")])) }],
        ),
    )
}

fn panic_catch_item(key: string) -> Item {
    let resume = Expr::FuncLit {
        params: Vec::new(),
        ret_ty: Type::Unit,
        body: Block {
            stmts: Vec::from_array(
                [Stmt::Expr { expr: std_call("panic", Vec::from_array([runtime_var("info")])) }],
            ),
        },
    };
    let caught = Vec::from_array(
        [
            Stmt::Var { name: "info", ty: panic_info_type(), value: Option::None },
            Stmt::TypeSwitch {
                binding: Option::Some("value"),
                expr: runtime_var("recovered"),
                cases: Vec::from_array(
                    [
                        TypeSwitchCase {
                            ty: panic_info_type(),
                            body: Block {
                                stmts: Vec::from_array(
                                    [Stmt::Assign { name: "info", value: runtime_var("value") }],
                                ),
                            },
                        },
                        TypeSwitchCase {
                            ty: panic_payload_type(),
                            body: Block {
                                stmts: Vec::from_array(
                                    [
                                        Stmt::Assign {
                                            name: "info",
                                            value: panic_info_value(
                                                std_call("value.GomlPanicValue", Vec::new()),
                                                std_call("value.GomlPanicMessage", Vec::new()),
                                                std_call("value.GomlPanicStack", Vec::new()),
                                            ),
                                        },
                                    ],
                                ),
                            },
                        },
                    ],
                ),
                default: Option::Some(
                    Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Assign {
                                    name: "info",
                                    value: panic_info_value(
                                        runtime_var("recovered"),
                                        std_call(
                                            "_goml_fmt.Sprint",
                                            Vec::from_array([runtime_var("recovered")]),
                                        ),
                                        Expr::Convert {
                                            ty: Type::String,
                                            expr: std_call("_goml_debug.Stack", Vec::new()),
                                        },
                                    ),
                                },
                            ],
                        ),
                    },
                ),
            },
            Stmt::Expr {
                expr: std_call(
                    "caught",
                    Vec::from_array(
                        [runtime_field("info", "message"), runtime_field("info", "stack"), resume],
                    ),
                ),
            },
        ],
    );
    let cleanup = Expr::FuncLit {
        params: Vec::new(),
        ret_ty: Type::Void,
        body: Block {
            stmts: Vec::from_array(
                [
                    Stmt::Var {
                        name: "recovered",
                        ty: Type::Any,
                        value: Option::Some(std_call("recover", Vec::new())),
                    },
                    Stmt::If {
                        cond: Expr::Binary {
                            op: BinaryOp::NotEq,
                            lhs: runtime_var("recovered"),
                            rhs: Expr::Nil,
                        },
                        then_: Block { stmts: caught },
                        else_: Option::None,
                    },
                ],
            ),
        },
    };
    std_function_item(
        key,
        Vec::from_array(
            [
                ("body", defer_action_type()),
                (
                    "caught",
                    Type::Func {
                        params: Vec::from_array([Type::String, Type::String, defer_action_type()]),
                        ret_ty: Type::Unit,
                    },
                ),
            ],
        ),
        Type::Unit,
        Vec::from_array(
            [
                Stmt::Defer { call: Expr::Call { func: cleanup, args: Vec::new() } },
                Stmt::Expr { expr: std_call("body", Vec::new()) },
                Stmt::Return { expr: Option::Some(Expr::Unit) },
            ],
        ),
    )
}
