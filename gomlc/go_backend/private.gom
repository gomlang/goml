package go_backend;

struct PrivateNames {
    replacements: HashMap[string, string],
    used: NameSet,
}

fn private_name(ctx: PrivateNames, name: string) -> string {
    add_reachable(ctx.used, name);
    ctx.replacements[name].unwrap_or(name)
}

fn private_type(ctx: PrivateNames, value: Type) -> Type {
    match value {
        Void => value,
        Any => value,
        Unit => value,
        Bool => value,
        Int => value,
        Int8 => value,
        Int16 => value,
        Int32 => value,
        Int64 => value,
        Uint => value,
        Uint8 => value,
        Uint16 => value,
        Uint32 => value,
        Uint64 => value,
        Float32 => value,
        Float64 => value,
        String => value,
        Char => value,
        Apply { base, args } => Type::Apply {
            base: private_type(ctx, base),
            args: private_map(args, |arg| private_type(ctx, arg)),
        },
        Named { name } => Type::Named { name: private_name(ctx, name) },
        Pointer { elem } => Type::Pointer { elem: private_type(ctx, elem) },
        Array { len, elem } => Type::Array { len: len, elem: private_type(ctx, elem) },
        Slice { elem } => Type::Slice { elem: private_type(ctx, elem) },
        Map { key, value } => Type::Map {
            key: private_type(ctx, key),
            value: private_type(ctx, value),
        },
        Chan { elem, direction } => Type::Chan {
            elem: private_type(ctx, elem),
            direction: direction,
        },
        Func { params, ret_ty } => Type::Func {
            params: private_map(params, |inner| private_type(ctx, inner)),
            ret_ty: private_type(ctx, ret_ty),
        },
        Multi { items } => Type::Multi {
            items: private_map(items, |inner| private_type(ctx, inner)),
        },
        Struct { fields } => Type::Struct {
            fields: private_map(fields, |inner| (inner.0, private_type(ctx, inner.1))),
        },
    }
}

fn private_expr(ctx: PrivateNames, value: Expr) -> Expr {
    match value {
        Nil => value,
        Unit => value,
        Var { name } => Expr::Var { name: private_name(ctx, name) },
        Bool { value } => Expr::Bool { value: value },
        Int { value } => Expr::Int { value: value },
        Float { value } => Expr::Float { value: value },
        String { value } => Expr::String { value: value },
        Call { func, args } => Expr::Call {
            func: private_expr(ctx, func),
            args: private_map(args, |inner| private_expr(ctx, inner)),
        },
        Instantiate { expr, args } => Expr::Instantiate {
            expr: private_expr(ctx, expr),
            args: private_map(args, |inner| private_type(ctx, inner)),
        },
        CallSpread { func, args, spread } => Expr::CallSpread {
            func: private_expr(ctx, func),
            args: private_map(args, |inner| private_expr(ctx, inner)),
            spread: private_expr(ctx, spread),
        },
        Unary { op, expr } => Expr::Unary { op: op, expr: private_expr(ctx, expr) },
        Binary { op, lhs, rhs } => Expr::Binary {
            op: op,
            lhs: private_expr(ctx, lhs),
            rhs: private_expr(ctx, rhs),
        },
        Field { expr, field_name } => Expr::Field {
            expr: private_expr(ctx, expr),
            field_name: field_name,
        },
        Index { base, index } => Expr::Index {
            base: private_expr(ctx, base),
            index: private_expr(ctx, index),
        },
        Slice { base, start, end } => Expr::Slice {
            base: private_expr(ctx, base),
            start: private_expr(ctx, start),
            end: private_expr(ctx, end),
        },
        MethodExpression { receiver, name } => Expr::MethodExpression {
            receiver: private_type(ctx, receiver),
            name,
        },
        Cast { expr, ty } => Expr::Cast { expr: private_expr(ctx, expr), ty: private_type(ctx, ty) },
        Convert { ty, expr } => Expr::Convert {
            ty: private_type(ctx, ty),
            expr: private_expr(ctx, expr),
        },
        Make { ty, args } => Expr::Make {
            ty: private_type(ctx, ty),
            args: private_map(args, |inner| private_expr(ctx, inner)),
        },
        Send { channel, value } => Expr::Send {
            channel: private_expr(ctx, channel),
            value: private_expr(ctx, value),
        },
        Receive { channel } => Expr::Receive { channel: private_expr(ctx, channel) },
        StructLiteral { ty, fields } => Expr::StructLiteral {
            ty: private_type(ctx, ty),
            fields: private_map(fields, |inner| (inner.0, private_expr(ctx, inner.1))),
        },
        ArrayLiteral { ty, items } => Expr::ArrayLiteral {
            ty: private_type(ctx, ty),
            items: private_map(items, |inner| private_expr(ctx, inner)),
        },
        FuncLit { params, ret_ty, body } => Expr::FuncLit {
            params: private_map(
                params,
                |inner| (private_name(ctx, inner.0), private_type(ctx, inner.1)),
            ),
            ret_ty: private_type(ctx, ret_ty),
            body: private_block(ctx, body),
        },
    }
}

fn private_stmt(ctx: PrivateNames, value: Stmt) -> Stmt {
    match value {
        Expr { expr } => Stmt::Expr { expr: private_expr(ctx, expr) },
        Go { call } => Stmt::Go { call: private_expr(ctx, call) },
        Defer { call } => Stmt::Defer { call: private_expr(ctx, call) },
        Var { name, ty, value } => Stmt::Var {
            name: private_name(ctx, name),
            ty: private_type(ctx, ty),
            value: value.map(|inner| private_expr(ctx, inner)),
        },
        Assign { name, value } => Stmt::Assign {
            name: private_name(ctx, name),
            value: private_expr(ctx, value),
        },
        FieldAssign { target, field_name, value } => Stmt::FieldAssign {
            target: private_expr(ctx, target),
            field_name: field_name,
            value: private_expr(ctx, value),
        },
        IndexAssign { base, index, value } => Stmt::IndexAssign {
            base: private_expr(ctx, base),
            index: private_expr(ctx, index),
            value: private_expr(ctx, value),
        },
        MultiAssign { names, value } => Stmt::MultiAssign {
            names: private_map(names, |inner| private_name(ctx, inner)),
            value: private_expr(ctx, value),
        },
        Return { expr } => Stmt::Return { expr: expr.map(|inner| private_expr(ctx, inner)) },
        ReturnMulti { exprs } => Stmt::ReturnMulti {
            exprs: private_map(exprs, |inner| private_expr(ctx, inner)),
        },
        If { cond, then_, else_ } => Stmt::If {
            cond: private_expr(ctx, cond),
            then_: private_block(ctx, then_),
            else_: else_.map(|inner| private_block(ctx, inner)),
        },
        Loop { body } => Stmt::Loop { body: private_block(ctx, body) },
        LabeledLoop { label, body } => Stmt::LabeledLoop {
            label: label,
            body: private_block(ctx, body),
        },
        Range { names, expr, body } => Stmt::Range {
            names: private_map(names, |inner| private_name(ctx, inner)),
            expr: private_expr(ctx, expr),
            body: private_block(ctx, body),
        },
        Break => value,
        BreakLabel { label } => Stmt::BreakLabel { label: label },
        Continue => value,
        ContinueLabel { label } => Stmt::ContinueLabel { label: label },
        Switch { expr, cases, default } => Stmt::Switch {
            expr: private_expr(ctx, expr),
            cases: private_map(cases, |inner| private_switchcase(ctx, inner)),
            default: default.map(|inner| private_block(ctx, inner)),
        },
        TypeSwitch { binding, expr, cases, default } => Stmt::TypeSwitch {
            binding: binding.map(|inner| private_name(ctx, inner)),
            expr: private_expr(ctx, expr),
            cases: private_map(cases, |inner| private_typeswitchcase(ctx, inner)),
            default: default.map(|inner| private_block(ctx, inner)),
        },
        Select { cases, default } => Stmt::Select {
            cases: private_map(cases, |inner| private_selectcase(ctx, inner)),
            default: default.map(|inner| private_block(ctx, inner)),
        },
        Panic { message } => Stmt::Panic { message: message },
        Unreachable => value,
    }
}

fn private_selectoperation(ctx: PrivateNames, value: SelectOperation) -> SelectOperation {
    match value {
        Receive { names, channel } => SelectOperation::Receive {
            names: private_map(names, |inner| private_name(ctx, inner)),
            channel: private_expr(ctx, channel),
        },
        Send { channel, value } => SelectOperation::Send {
            channel: private_expr(ctx, channel),
            value: private_expr(ctx, value),
        },
    }
}

fn private_block(ctx: PrivateNames, value: Block) -> Block {
    Block { stmts: private_map(value.stmts, |inner| private_stmt(ctx, inner)) }
}

fn private_switchcase(ctx: PrivateNames, value: SwitchCase) -> SwitchCase {
    SwitchCase { value: private_expr(ctx, value.value), body: private_block(ctx, value.body) }
}

fn private_typeswitchcase(ctx: PrivateNames, value: TypeSwitchCase) -> TypeSwitchCase {
    TypeSwitchCase { ty: private_type(ctx, value.ty), body: private_block(ctx, value.body) }
}

fn private_selectcase(ctx: PrivateNames, value: SelectCase) -> SelectCase {
    SelectCase {
        operation: private_selectoperation(ctx, value.operation),
        body: private_block(ctx, value.body),
    }
}

fn private_function(ctx: PrivateNames, value: Function) -> Function {
    Function {
        name: private_name(ctx, value.name),
        params: private_map(
            value.params,
            |inner| (private_name(ctx, inner.0), private_type(ctx, inner.1)),
        ),
        ret_ty: value.ret_ty.map(|inner| private_type(ctx, inner)),
        body: private_block(ctx, value.body),
    }
}

fn private_global(ctx: PrivateNames, value: Global) -> Global {
    Global {
        name: private_name(ctx, value.name),
        ty: value.ty.map(|inner| private_type(ctx, inner)),
        value: private_expr(ctx, value.value),
    }
}

fn private_typedef(ctx: PrivateNames, value: TypeDef) -> TypeDef {
    TypeDef { name: private_name(ctx, value.name), ty: private_type(ctx, value.ty) }
}

fn private_structdef(ctx: PrivateNames, value: StructDef) -> StructDef {
    StructDef {
        name: private_name(ctx, value.name),
        fields: private_map(value.fields, |inner| (inner.0, private_type(ctx, inner.1))),
    }
}

fn private_constspec(ctx: PrivateNames, value: ConstSpec) -> ConstSpec {
    ConstSpec {
        name: private_name(ctx, value.name),
        ty: private_type(ctx, value.ty),
        value: private_expr(ctx, value.value),
    }
}

fn private_constgroup(ctx: PrivateNames, value: ConstGroup) -> ConstGroup {
    ConstGroup { specs: private_map(value.specs, |inner| private_constspec(ctx, inner)) }
}

fn private_method(ctx: PrivateNames, value: Method) -> Method {
    Method {
        receiver: (private_name(ctx, value.receiver.0), private_type(ctx, value.receiver.1)),
        name: value.name,
        params: private_map(
            value.params,
            |inner| (private_name(ctx, inner.0), private_type(ctx, inner.1)),
        ),
        ret_ty: value.ret_ty.map(|inner| private_type(ctx, inner)),
        body: private_block(ctx, value.body),
    }
}

fn private_interfacedef(ctx: PrivateNames, value: InterfaceDef) -> InterfaceDef {
    InterfaceDef {
        name: private_name(ctx, value.name),
        methods: private_map(value.methods, |inner| private_interfacemethod(ctx, inner)),
    }
}

fn private_interfacemethod(ctx: PrivateNames, value: InterfaceMethod) -> InterfaceMethod {
    InterfaceMethod {
        name: value.name,
        params: private_map(value.params, |inner| private_type(ctx, inner)),
        ret_ty: value.ret_ty.map(|inner| private_type(ctx, inner)),
    }
}

fn private_map[A, B](values: Vec[A], transform: (A) -> B) -> Vec[B] {
    let result: Vec[B] = Vec::with_capacity(values.len());
    for value in values {
        result.push(transform(value))
    }
    result
}

fn private_item(ctx: PrivateNames, value: Item) -> Item {
    match value {
        Function(inner) => Item::Function(private_function(ctx, inner)),
        Method(inner) => Item::Method(private_method(ctx, inner)),
        Global(inner) => Item::Global(private_global(ctx, inner)),
        Struct(inner) => Item::Struct(private_structdef(ctx, inner)),
        TypeDef(inner) => Item::TypeDef(private_typedef(ctx, inner)),
        ConstGroup(inner) => Item::ConstGroup(private_constgroup(ctx, inner)),
        Interface(inner) => Item::Interface(private_interfacedef(ctx, inner)),
        ImportGroup(imports) => {
            for imported in imports {
                add_reachable(ctx.used, imported.0)
            }
            value
        },
    }
}

fn privatize_library_with_names(value: File, exports: Vec[string], renamed: Vec[(string, string)]) -> File {
    let ctx = PrivateNames { replacements: HashMap::new(), used: new_name_set() };
    for item in value.items {
        let _ = private_item(ctx, item);
    }
    let names = library_item_names(value.items);
    let imports = new_name_set();
    for item in value.items {
        if let Item::ImportGroup(values) = item {
            for imported in values {
                add_reachable(imports, imported.0)
            }
        }
    }
    for name in names.to_vec() {
        if name == "" || exports.contains(name) || name_present(imports, name) {
            continue
        }
        let first = name.get(0);
        if first < 'A' || first > 'Z' {
            continue
        }
        let base = go_hashed_ident("private", name);
        let mut replacement = base;
        let mut suffix = 0;
        while name_present(ctx.used, replacement) {
            suffix += 1;
            replacement = base + "_" + suffix.to_string();
        }
        add_reachable(ctx.used, replacement);
        ctx.replacements[name] = replacement;
        renamed.push((name, replacement));
    }
    File { items: private_map(value.items, |item| private_item(ctx, item)) }
}
