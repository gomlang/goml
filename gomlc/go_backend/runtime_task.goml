package go_backend;

use module::ast;
use module::resources;

fn task_state_name() -> string {
    go_generated_ident("_goml_task_scope_state")
}

fn task_registry_mutex_name() -> string {
    go_generated_ident("_goml_task_registry_mutex")
}

fn task_registry_name() -> string {
    go_generated_ident("_goml_task_registry")
}

fn task_next_id_name() -> string {
    go_generated_ident("_goml_task_next_id")
}

fn task_lookup_name() -> string {
    go_generated_ident("_goml_task_lookup")
}

fn task_run_name() -> string {
    go_generated_ident("_goml_task_run")
}

fn task_record_panic_name() -> string {
    go_generated_ident("_goml_task_record_panic")
}

fn task_context_name() -> string {
    go_generated_ident("_goml_task_context")
}

fn task_context_done_expr(id: Expr) -> Expr {
    Expr::Call {
        func: Expr::Field {
            expr: task_call(task_context_name(), Vec::from_array([id])),
            field_name: "Done",
        },
        args: Vec::new(),
    }
}

fn task_state_type() -> Type {
    Type::Named { name: task_state_name() }
}

fn task_state_pointer_type() -> Type {
    Type::Pointer { elem: task_state_type() }
}

fn task_registry_type() -> Type {
    Type::Map { key: Type::Int64, value: task_state_pointer_type() }
}

fn task_var(name: string) -> Expr {
    Expr::Var { name }
}

fn task_field(value: string, field: string) -> Expr {
    Expr::Field { expr: task_var(value), field_name: field }
}

fn task_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: task_var(name), args }
}

fn task_method(value: string, name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: task_field(value, name), args }
}

fn task_expr(expr: Expr) -> Stmt {
    Stmt::Expr { expr }
}

fn task_return(expr: Expr) -> Stmt {
    Stmt::Return { expr: Option::Some(expr) }
}

fn task_runtime_support_items() -> Vec[Item] {
    let items: Vec[Item] = Vec::new();
    items.push(
        Item::Struct(
            StructDef {
                name: task_state_name(),
                fields: Vec::from_array(
                    [
                        ("mu", Type::Named { name: "_goml_sync.Mutex" }),
                        ("wg", Type::Named { name: "_goml_sync.WaitGroup" }),
                        ("state", Type::Int),
                        ("ctx", Type::Named { name: "_goml_context.Context" }),
                        ("cancel", Type::Named { name: "_goml_context.CancelFunc" }),
                        ("panicked", Type::Bool),
                        ("panic_value", Type::Any),
                    ],
                ),
            },
        ),
    );
    items.push(
        Item::Global(
            Global {
                name: task_registry_mutex_name(),
                ty: Option::Some(Type::Named { name: "_goml_sync.Mutex" }),
                value: Expr::StructLiteral {
                    ty: Type::Named { name: "_goml_sync.Mutex" },
                    fields: Vec::new(),
                },
            },
        ),
    );
    items.push(
        Item::Global(
            Global {
                name: task_registry_name(),
                ty: Option::Some(task_registry_type()),
                value: Expr::Make { ty: task_registry_type(), args: Vec::new() },
            },
        ),
    );
    items.push(
        Item::Global(
            Global {
                name: task_next_id_name(),
                ty: Option::Some(Type::Int64),
                value: Expr::Int { value: "1" },
            },
        ),
    );
    let lookup: Vec[Stmt] = Vec::new();
    lookup.push(task_expr(task_method(task_registry_mutex_name(), "Lock", Vec::new())));
    lookup.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                Expr::Index { base: task_var(task_registry_name()), index: task_var("id") },
            ),
        },
    );
    lookup.push(task_expr(task_method(task_registry_mutex_name(), "Unlock", Vec::new())));
    lookup.push(task_return(task_var("scope")));
    items.push(
        Item::Function(
            Function {
                name: task_lookup_name(),
                params: Vec::from_array([("id", Type::Int64)]),
                ret_ty: Option::Some(task_state_pointer_type()),
                body: Block { stmts: lookup },
            },
        ),
    );
    let context: Vec[Stmt] = Vec::new();
    context.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(task_call(task_lookup_name(), Vec::from_array([task_var("id")]))),
        },
    );
    context.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::NotEq, lhs: task_var("scope"), rhs: Expr::Nil },
            then_: Block { stmts: Vec::from_array([task_return(task_field("scope", "ctx"))]) },
            else_: Option::None,
        },
    );
    context.push(
        Stmt::Var {
            name: "ctx",
            ty: Type::Named { name: "_goml_context.Context" },
            value: Option::None,
        },
    );
    context.push(
        Stmt::Var {
            name: "cancel",
            ty: Type::Named { name: "_goml_context.CancelFunc" },
            value: Option::None,
        },
    );
    context.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["ctx", "cancel"]),
            value: task_call(
                "_goml_context.WithCancel",
                Vec::from_array([task_call("_goml_context.Background", Vec::new())]),
            ),
        },
    );
    context.push(task_expr(task_call("cancel", Vec::new())));
    context.push(task_return(task_var("ctx")));
    items.push(
        Item::Function(
            Function {
                name: task_context_name(),
                params: Vec::from_array([("id", Type::Int64)]),
                ret_ty: Option::Some(Type::Named { name: "_goml_context.Context" }),
                body: Block { stmts: context },
            },
        ),
    );
    let record: Vec[Stmt] = Vec::new();
    record.push(task_expr(task_method("scope", "mu.Lock", Vec::new())));
    record.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: task_field("scope", "panicked") },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::FieldAssign {
                            target: task_var("scope"),
                            field_name: "panicked",
                            value: Expr::Bool { value: true },
                        },
                        Stmt::FieldAssign {
                            target: task_var("scope"),
                            field_name: "panic_value",
                            value: task_var("value"),
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    record.push(task_expr(task_method("scope", "mu.Unlock", Vec::new())));
    record.push(task_expr(task_call("scope.cancel", Vec::new())));
    items.push(
        Item::Function(
            Function {
                name: task_record_panic_name(),
                params: Vec::from_array(
                    [("scope", task_state_pointer_type()), ("value", Type::Any)],
                ),
                ret_ty: Option::None,
                body: Block { stmts: record },
            },
        ),
    );
    let cleanup: Vec[Stmt] = Vec::new();
    cleanup.push(
        Stmt::Var {
            name: "recovered",
            ty: Type::Any,
            value: Option::Some(task_call("recover", Vec::new())),
        },
    );
    cleanup.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::NotEq, lhs: task_var("recovered"), rhs: Expr::Nil },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        task_expr(
                            task_call(
                                task_record_panic_name(),
                                Vec::from_array([task_var("scope"), task_var("recovered")]),
                            ),
                        ),
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    cleanup.push(task_expr(task_method("scope", "wg.Done", Vec::new())));
    let run: Vec[Stmt] = Vec::new();
    run.push(
        Stmt::Defer {
            call: Expr::Call {
                func: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Void,
                    body: Block { stmts: cleanup },
                },
                args: Vec::new(),
            },
        },
    );
    run.push(task_expr(task_call("body", Vec::new())));
    items.push(
        Item::Function(
            Function {
                name: task_run_name(),
                params: Vec::from_array(
                    [
                        ("scope", task_state_pointer_type()),
                        ("body", Type::Func { params: Vec::new(), ret_ty: Type::Unit }),
                    ],
                ),
                ret_ty: Option::None,
                body: Block { stmts: run },
            },
        ),
    );
    items
}

fn task_scope_run_item(key: string) -> Item {
    let recover_body: Vec[Stmt] = Vec::new();
    recover_body.push(
        Stmt::Var {
            name: "recovered",
            ty: Type::Any,
            value: Option::Some(task_call("recover", Vec::new())),
        },
    );
    recover_body.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::NotEq, lhs: task_var("recovered"), rhs: Expr::Nil },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        task_expr(
                            task_call(
                                task_record_panic_name(),
                                Vec::from_array([task_var("scope"), task_var("recovered")]),
                            ),
                        ),
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    let invoke: Vec[Stmt] = Vec::new();
    invoke.push(
        Stmt::Defer {
            call: Expr::Call {
                func: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Void,
                    body: Block { stmts: recover_body },
                },
                args: Vec::new(),
            },
        },
    );
    invoke.push(task_expr(task_call("body", Vec::new())));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("scope_id")])),
            ),
        },
    );
    stmts.push(
        task_expr(
            Expr::Call {
                func: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Void,
                    body: Block { stmts: invoke },
                },
                args: Vec::new(),
            },
        ),
    );
    stmts.push(task_return(Expr::Unit));
    std_function_item(
        key,
        Vec::from_array(
            [
                ("scope_id", Type::Int64),
                ("body", Type::Func { params: Vec::new(), ret_ty: Type::Unit }),
            ],
        ),
        Type::Unit,
        stmts,
    )
}

fn task_scope_new_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "parent_context",
            ty: Type::Named { name: "_goml_context.Context" },
            value: Option::Some(task_call("_goml_context.Background", Vec::new())),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "parent_missing",
            ty: Type::Bool,
            value: Option::Some(Expr::Bool { value: false }),
        },
    );
    let parent: Vec[Stmt] = Vec::new();
    parent.push(
        Stmt::Var {
            name: "parent_scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("parent")])),
            ),
        },
    );
    parent.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: task_var("parent_scope"),
                rhs: Expr::Nil,
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Assign {
                            name: "parent_context",
                            value: task_field("parent_scope", "ctx"),
                        },
                    ],
                ),
            },
            else_: Option::Some(
                Block {
                    stmts: Vec::from_array(
                        [Stmt::Assign { name: "parent_missing", value: Expr::Bool { value: true } }],
                    ),
                },
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: task_var("parent"),
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: parent },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "ctx",
            ty: Type::Named { name: "_goml_context.Context" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "cancel",
            ty: Type::Named { name: "_goml_context.CancelFunc" },
            value: Option::None,
        },
    );
    stmts.push(
        Stmt::MultiAssign {
            names: Vec::from_array(["ctx", "cancel"]),
            value: task_call(
                "_goml_context.WithCancel",
                Vec::from_array([task_var("parent_context")]),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: task_var("parent_missing"),
            then_: Block { stmts: Vec::from_array([task_expr(task_call("cancel", Vec::new()))]) },
            else_: Option::None,
        },
    );
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Lock", Vec::new())));
    stmts.push(
        Stmt::Var {
            name: "id",
            ty: Type::Int64,
            value: Option::Some(task_var(task_next_id_name())),
        },
    );
    stmts.push(
        Stmt::Assign {
            name: task_next_id_name(),
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: task_var(task_next_id_name()),
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: task_state_type(),
                        fields: Vec::from_array(
                            [
                                ("state", Expr::Int { value: "0" }),
                                ("ctx", task_var("ctx")),
                                ("cancel", task_var("cancel")),
                            ],
                        ),
                    },
                },
            ),
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: task_var(task_registry_name()),
            index: task_var("id"),
            value: task_var("scope"),
        },
    );
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Unlock", Vec::new())));
    stmts.push(task_return(task_var("id")));
    std_function_item(key, Vec::from_array([("parent", Type::Int64)]), Type::Int64, stmts)
}

fn task_scope_spawn_item(key: string, panic_when_closed: bool) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("scope_id")])),
            ),
        },
    );
    let missing = if panic_when_closed {
        Vec::from_array([Stmt::Panic { message: "task scope is closed" }])
    } else {
        Vec::from_array([task_return(Expr::Bool { value: false })])
    };
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: task_var("scope"), rhs: Expr::Nil },
            then_: Block { stmts: missing },
            else_: Option::None,
        },
    );
    stmts.push(task_expr(task_method("scope", "mu.Lock", Vec::new())));
    let closed: Vec[Stmt] = Vec::new();
    closed.push(task_expr(task_method("scope", "mu.Unlock", Vec::new())));
    if panic_when_closed {
        closed.push(Stmt::Panic { message: "task scope is closed" })
    } else {
        closed.push(task_return(Expr::Bool { value: false }))
    }
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: task_field("scope", "state"),
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: closed },
            else_: Option::None,
        },
    );
    stmts.push(
        task_expr(task_method("scope", "wg.Add", Vec::from_array([Expr::Int { value: "1" }]))),
    );
    stmts.push(task_expr(task_method("scope", "mu.Unlock", Vec::new())));
    stmts.push(
        Stmt::Go {
            call: task_call(task_run_name(), Vec::from_array([task_var("scope"), task_var("body")])),
        },
    );
    stmts.push(task_return(Expr::Bool { value: true }));
    std_function_item(
        key,
        Vec::from_array(
            [
                ("scope_id", Type::Int64),
                ("body", Type::Func { params: Vec::new(), ret_ty: Type::Unit }),
            ],
        ),
        Type::Bool,
        stmts,
    )
}

fn task_scope_cancel_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("scope_id")])),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::NotEq, lhs: task_var("scope"), rhs: Expr::Nil },
            then_: Block {
                stmts: Vec::from_array([task_expr(task_call("scope.cancel", Vec::new()))]),
            },
            else_: Option::None,
        },
    );
    stmts.push(task_return(Expr::Unit));
    std_function_item(key, Vec::from_array([("scope_id", Type::Int64)]), Type::Unit, stmts)
}

fn task_scope_finish_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("scope_id")])),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: task_var("scope"), rhs: Expr::Nil },
            then_: Block { stmts: Vec::from_array([task_return(Expr::Unit)]) },
            else_: Option::None,
        },
    );
    stmts.push(task_expr(task_method("scope", "mu.Lock", Vec::new())));
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: task_field("scope", "state"),
                rhs: Expr::Int { value: "0" },
            },
            then_: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::FieldAssign {
                            target: task_var("scope"),
                            field_name: "state",
                            value: Expr::Int { value: "1" },
                        },
                    ],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(task_expr(task_method("scope", "mu.Unlock", Vec::new())));
    stmts.push(task_expr(task_method("scope", "wg.Wait", Vec::new())));
    stmts.push(task_expr(task_call("scope.cancel", Vec::new())));
    stmts.push(task_expr(task_method("scope", "mu.Lock", Vec::new())));
    stmts.push(
        Stmt::Var {
            name: "panicked",
            ty: Type::Bool,
            value: Option::Some(task_field("scope", "panicked")),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "panic_value",
            ty: Type::Any,
            value: Option::Some(task_field("scope", "panic_value")),
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: task_var("scope"),
            field_name: "state",
            value: Expr::Int { value: "2" },
        },
    );
    stmts.push(task_expr(task_method("scope", "mu.Unlock", Vec::new())));
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Lock", Vec::new())));
    stmts.push(
        task_expr(
            task_call(
                "delete",
                Vec::from_array([task_var(task_registry_name()), task_var("scope_id")]),
            ),
        ),
    );
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Unlock", Vec::new())));
    stmts.push(
        Stmt::If {
            cond: task_var("panicked"),
            then_: Block {
                stmts: Vec::from_array(
                    [task_expr(task_call("panic", Vec::from_array([task_var("panic_value")])))],
                ),
            },
            else_: Option::None,
        },
    );
    stmts.push(task_return(Expr::Unit));
    std_function_item(key, Vec::from_array([("scope_id", Type::Int64)]), Type::Unit, stmts)
}

fn task_active_scope_count_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Lock", Vec::new())));
    stmts.push(
        Stmt::Var {
            name: "count",
            ty: Type::Int,
            value: Option::Some(task_call("len", Vec::from_array([task_var(task_registry_name())]))),
        },
    );
    stmts.push(task_expr(task_method(task_registry_mutex_name(), "Unlock", Vec::new())));
    stmts.push(task_return(task_var("count")));
    std_function_item(key, Vec::new(), Type::Int, stmts)
}

fn task_scope_cancelled_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "scope",
            ty: task_state_pointer_type(),
            value: Option::Some(
                task_call(task_lookup_name(), Vec::from_array([task_var("scope_id")])),
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: task_var("scope"), rhs: Expr::Nil },
            then_: Block { stmts: Vec::from_array([task_return(Expr::Bool { value: true })]) },
            else_: Option::None,
        },
    );
    stmts.push(
        task_return(
            Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: task_method("scope", "ctx.Err", Vec::new()),
                rhs: Expr::Nil,
            },
        ),
    );
    std_function_item(key, Vec::from_array([("scope_id", Type::Int64)]), Type::Bool, stmts)
}

fn task_scope_done_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(task_return(task_context_done_expr(task_var("scope_id"))));
    std_function_item(
        key,
        Vec::from_array([("scope_id", Type::Int64)]),
        Type::Chan { elem: Type::Unit, direction: ast::ChannelDirection::Receive },
        stmts,
    )
}

fn task_scope_sleep_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "timer",
            ty: Type::Pointer { elem: Type::Named { name: "_goml_time.Timer" } },
            value: Option::Some(
                task_call(
                    "_goml_time.NewTimer",
                    Vec::from_array(
                        [
                            Expr::Convert {
                                ty: Type::Named { name: "_goml_time.Duration" },
                                expr: task_var("nanoseconds"),
                            },
                        ],
                    ),
                ),
            ),
        },
    );
    stmts.push(Stmt::Var { name: "completed", ty: Type::Bool, value: Option::None });
    stmts.push(
        Stmt::Select {
            cases: Vec::from_array(
                [
                    SelectCase {
                        operation: SelectOperation::Receive {
                            names: Vec::new(),
                            channel: task_field("timer", "C"),
                        },
                        body: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Assign {
                                        name: "completed",
                                        value: Expr::Bool { value: true },
                                    },
                                ],
                            ),
                        },
                    },
                    SelectCase {
                        operation: SelectOperation::Receive {
                            names: Vec::new(),
                            channel: task_context_done_expr(task_var("scope_id")),
                        },
                        body: Block {
                            stmts: Vec::from_array(
                                [
                                    task_expr(task_method("timer", "Stop", Vec::new())),
                                    Stmt::Assign {
                                        name: "completed",
                                        value: Expr::Bool { value: false },
                                    },
                                ],
                            ),
                        },
                    },
                ],
            ),
            default: Option::None,
        },
    );
    stmts.push(task_return(task_var("completed")));
    std_function_item(
        key,
        Vec::from_array([("scope_id", Type::Int64), ("nanoseconds", Type::Int64)]),
        Type::Bool,
        stmts,
    )
}

fn task_runtime_hook_item(hook: resources::TaskRuntimeHook, key: string) -> Item {
    match hook {
        ScopeNew => task_scope_new_item(key),
        ScopeRun => task_scope_run_item(key),
        ScopeSpawn => task_scope_spawn_item(key, true),
        ScopeTrySpawn => task_scope_spawn_item(key, false),
        ScopeCancel => task_scope_cancel_item(key),
        ScopeFinish => task_scope_finish_item(key),
        ScopeCancelled => task_scope_cancelled_item(key),
        ScopeDone => task_scope_done_item(key),
        Sleep => task_scope_sleep_item(key),
        ActiveScopeCount => task_active_scope_count_item(key),
    }
}
