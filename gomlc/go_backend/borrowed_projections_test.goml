package go_backend;

use module::anf;
use module::ast;
use module::repr;
use std::testing;

fn projection_test_field(root: string, target: string, is_struct: bool) -> anf::Bind {
    pointer_test_binding(
        target,
        anf::Value::ConstrGet {
            expr: anf::Imm::Var { name: root, ty: pointer_test_large_type() },
            constructor: repr::Constructor {
                name: "Outer",
                fields: Vec::from_array(["inner"]),
                is_struct,
                tag: None,
            },
            field_index: 0,
            ty: pointer_test_large_type(),
        },
    )
}

fn projection_test_assignment(name: string) -> anf::Bind {
    pointer_test_binding(
        "assigned",
        anf::Value::Assign {
            name,
            value: anf::Imm::Var { name: "right", ty: pointer_test_large_type() },
            target_ty: pointer_test_large_type(),
            ty: repr::Type::Unit,
        },
    )
}

#[test]
fn borrowed_projections_require_local_immutable_struct_bindings() -> () {
    for root in["left", "global"] {
        for is_struct in[false, true] {
            let mut binds = Vec::from_array([projection_test_field(root, "field", is_struct)]);
            let result = borrowed_struct_projections(
                pointer_test_function("example", pointer_test_block(binds)),
                pointer_test_structs(),
            );
            testing::assert_eq(result.contains("field"), root == "left" && is_struct);
            binds = Vec::from_array(
                [projection_test_field(root, "field", is_struct), projection_test_assignment(root)],
            );
            testing::assert(
                borrowed_struct_projections(
                    pointer_test_function("example", pointer_test_block(binds)),
                    pointer_test_structs(),
                ).is_empty(),
            );
        }
    }
    for mutation in Vec::from_array(
        [projection_test_assignment("field"), projection_test_field("right", "field", true)],
    ) {
        let binds = Vec::from_array([projection_test_field("left", "field", true), mutation]);
        testing::assert(
            borrowed_struct_projections(
                pointer_test_function("example", pointer_test_block(binds)),
                pointer_test_structs(),
            ).is_empty(),
        );
    }
}

#[test]
fn borrowed_projections_reject_join_parameters_and_nested_assignments() -> () {
    for root in["left", "loop_value"] {
        let join = anf::JoinBind {
            name: "loop",
            role: anf::JoinRole::Continuation,
            params: Vec::from_array([("loop_value", pointer_test_large_type())]),
            ret_ty: repr::Type::Unit,
            body: pointer_test_block(Vec::from_array([projection_test_assignment("left")])),
        };
        let body = pointer_test_block(
            Vec::from_array(
                [
                    projection_test_field(root, "field", true),
                    anf::Bind::JoinRec(Vec::from_array([join])),
                ],
            ),
        );
        testing::assert(
            borrowed_struct_projections(
                pointer_test_function("example", body),
                pointer_test_structs(),
            ).is_empty(),
        );
    }
    let branch = pointer_test_block(Vec::from_array([projection_test_assignment("left")]));
    let body = anf::Block {
        binds: Vec::from_array([projection_test_field("left", "field", true)]),
        term: anf::Term::Select {
            mode: ast::SelectMode::Normal,
            arms: Vec::new(),
            default: Some(branch),
            ret_ty: repr::Type::Unit,
        },
    };
    testing::assert(
        borrowed_struct_projections(pointer_test_function("example", body), pointer_test_structs()).is_empty(),
    );
}

#[test]
fn borrowed_projections_include_arrays_without_borrowing_reference_contents() -> () {
    for ty in[
        repr::Type::Array { len: 0, elem: repr::Type::Int },
        repr::Type::Array { len: 16, elem: repr::Type::Int },
        repr::Type::Array { len: 4, elem: repr::Type::Array { len: 4, elem: repr::Type::Int } },
    ] {
        let bind = pointer_test_binding(
            "array",
            anf::Value::ConstrGet {
                expr: anf::Imm::Var { name: "left", ty: pointer_test_large_type() },
                constructor: repr::Constructor {
                    name: "Large",
                    fields: Vec::from_array(["values"]),
                    is_struct: true,
                    tag: None,
                },
                field_index: 0,
                ty,
            },
        );
        let result = borrowed_struct_projections(
            pointer_test_function("example", pointer_test_block(Vec::from_array([bind]))),
            pointer_test_structs(),
        );
        testing::assert(result.contains("array"));
    }
    for ty in[
        repr::Type::Int,
        repr::Type::RefType { elem: pointer_test_large_type() },
        repr::Type::VecType { elem: pointer_test_large_type() },
    ] {
        testing::assert(!borrowable_projection_type(pointer_test_structs(), ty));
    }
}

#[test]
fn immutable_array_field_reads_avoid_array_argument_copies() -> () {
    let generated = encode(
        lower_source(
            "struct Registers { values: [isize; 32] } struct Device { registers: Registers } fn sum(value: Device, count: isize) -> isize { let mut total = 0; let mut index = 0; while index < count { total += value.registers.values[index]; index += 1; } total } fn main() -> () { println(sum(Device { registers: Registers { values: [1; 32] } }, 32)); }",
        ),
    );
    testing::assert(generated.contains("*Registers = &"));
    testing::assert(generated.contains("*[32]int = &"));
    testing::assert(!generated.contains("= array_get__Array_32_3int("));
    testing::assert(!generated.contains("[32]int = (*"));
}
