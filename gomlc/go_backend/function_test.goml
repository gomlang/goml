package go_backend;

use module::go_ir::{Type};
use module::go_types::{encode_type, lower_type, type_name};
use module::repr;
use std::testing;

#[test]
fn raw_function_types_preserve_unit_and_multiple_results() -> () {
    let empty = repr::Type::Func { params: Vec::new(), ret_ty: repr::Type::Unit };
    let raw = repr::Type::GoFunction { signature: empty };
    testing::assert(encode_type(raw) != encode_type(repr::Type::GoPointer { elem: empty }));
    testing::assert(type_name(raw) != type_name(empty));
    match lower_type(raw) {
        Func { params, ret_ty: Type::Void } => testing::assert(params.is_empty()),
        _ => testing::fail("expected raw Go func()"),
    }
    let tuple = repr::Type::Tuple { items: Vec::from_array([repr::Type::Int64, repr::Type::Bool]) };
    match lower_type(
        GoFunction {
            signature: repr::Type::Func {
                params: Vec::from_array([repr::Type::Int64]),
                ret_ty: tuple,
            },
        },
    ) {
        Func { params, ret_ty: Multi { items } } => {
            testing::assert_eq(params.len(), 1);
            testing::assert_eq(items.len(), 2);
        },
        _ => testing::fail("expected raw Go multiple results"),
    }
}
