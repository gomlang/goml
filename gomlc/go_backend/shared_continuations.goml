package go_backend;

use module::go_ir::{Block, Stmt};
use module::go_types::{go_local_ident};
use module::anf;

fn shared_join_label(env: LowerEnv, name: string) -> Option[string] {
    for index in 0..env.shared_joins.len() {
        let entry = env.shared_joins[env.shared_joins.len() - 1 - index];
        if entry.0 == name {
            return Some(entry.1)
        }
    }
    None
}

fn shareable_pending_join(pending: Vec[anf::JoinBind]) -> Option[anf::JoinBind] {
    for join in pending {
        match join.role {
            Continuation | anf::JoinRole::Return => return Some(join),
            LoopExit => (),
        }
    }
    None
}

fn remaining_shared_joins(pending: Vec[anf::JoinBind], name: string) -> Vec[anf::JoinBind] {
    let result = Vec::new();
    for join in pending {
        if join.name != name {
            result.push(join);
        }
    }
    result
}

fn compile_shared_term(env: LowerEnv, value: anf::Term, pending: Vec[anf::JoinBind]) -> Vec[Stmt] {
    let Some(join) = shareable_pending_join(pending) else {
        return compile_term_leaf(env, value)
    };
    let label = fresh_loop_label_with_suffix(
        env.emitted_loop_labels,
        "Shared_" + go_local_ident(join.name),
        1,
    );
    env.shared_joins.push((join.name, label));
    let body = Block {
        stmts: compile_term_with_pending(env, value, remaining_shared_joins(pending, join.name)),
    };
    let _ = env.shared_joins.remove(env.shared_joins.len() - 1);
    if !block_contains_loop_label(body, label) {
        return body.stmts
    }
    let result = Vec::from_array([Stmt::LabeledLoop { label, body }]);
    append_stmts(result, compile_block(env, join.body).stmts);
    result
}

fn compile_shared_loop_term(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
    loop_name: string,
    exit_name: string,
    loop_label: string,
) -> Vec[Stmt] {
    let Some(join) = shareable_pending_join(pending) else {
        return compile_loop_term_leaf(env, value, loop_name, exit_name, loop_label)
    };
    let label = fresh_loop_label_with_suffix(
        env.emitted_loop_labels,
        "Shared_" + go_local_ident(join.name),
        1,
    );
    env.shared_joins.push((join.name, label));
    let body = Block {
        stmts: compile_loop_term_with_pending(
            env,
            value,
            remaining_shared_joins(pending, join.name),
            loop_name,
            exit_name,
            loop_label,
        ),
    };
    let _ = env.shared_joins.remove(env.shared_joins.len() - 1);
    if !block_contains_loop_label(body, label) {
        return body.stmts
    }
    let result = Vec::from_array([Stmt::LabeledLoop { label, body }]);
    append_stmts(result, compile_loop_block(env, join.body, loop_name, exit_name, loop_label).stmts);
    result
}
