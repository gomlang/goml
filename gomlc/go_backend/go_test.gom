}

#[test]
fn emits_breaking_while_loops() -> () {
    let source = "fn main() { let i = Ref::new(0); while i.get() < 10 { if i.get() == 5 { break } else { () }; let _ = println(i.get()); i.set(i.get() + 1); }; let _ = println(\"done\"); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type ref_int_x struct {
        \\    value int
        \\}
        \\
        \\func main0() struct{} {
        \\    var i__0 *ref_int_x = _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_new(0)
        \\    Loop_loop7:
        \\    for {
        \\        var t8 int = _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_get(i__0)
        \\        var t9 bool = t8 < 10
        \\        if t9 {
        \\            var t14 int = _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_get(i__0)
        \\            var t15 bool = t14 == 5
        \\            if t15 {
        \\                break Loop_loop7
        \\            } else {
        \\                var t11 int = _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_get(i__0)
        \\                _goml_m_println(t11)
        \\                var t12 int = _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_get(i__0)
        \\                var t13 int = t12 + 1
        \\                _goml_m_inherent_i_Ref_i_Ref_l_isize_r__i_set(i__0, t13)
        \\                continue
        \\            }
        \\        } else {
        \\            break Loop_loop7
        \\        }
        \\    }
        \\    _goml_m_println("done")
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn emits_value_and_infinite_loops_without_expanding_continuations() -> () {
    let source = "fn choose(flag: bool) -> isize { loop { if flag { break 7; } else { continue; }; } } fn spin() -> isize { loop {} } fn main() -> () { let flag = Ref::new(false); println(choose(!flag.get())); if flag.get() { println(spin()); }; }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func choose(flag__0 bool) int {"));
    testing::assert(string_contains(output, "Loop_loop_expr"));
    testing::assert(
        string_contains(
            output,
            \\ = 7
            \\            break Loop_loop_expr
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\func spin() int {
            \\    for {
            ,
        ),
    );
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
fn recognizes_recursive_joins_independently_of_their_names() -> () {
    let ty = repr::Type::Unit;
    let recursive = anf::JoinBind {
        name: "renamed_control_node",
        role: anf::JoinRole::Continuation,
        params: Vec::new(),
        ret_ty: ty,
        body: anf::Block {
            binds: Vec::new(),
            term: anf::Term::Jump { target: "renamed_control_node", args: Vec::new(), ret_ty: ty },
        },
    };
    let recursive_group: Vec[anf::JoinBind] = Vec::new();
    recursive_group.push(recursive);
    let binds: Vec[anf::Bind] = Vec::new();
    binds.push(anf::Bind::JoinRec(recursive_group));
    let functions: Vec[anf::Function] = Vec::new();
    functions.push(
        anf::Function {
            name: "main",
            origin: anf::FunctionOrigin::Source,
            root: true,
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: ty,
            body: anf::Block {
                binds,
                term: anf::Term::Jump {
                    target: "renamed_control_node",
                    args: Vec::new(),
                    ret_ty: ty,
                },
            },
        },
    );
    let output = encode(
        required_lower(
            lower(
                anf::File {
                    functions,
                    enums: Vec::new(),
                    structs: Vec::new(),
                    type_instances: Vec::new(),
                    constants: Vec::new(),
                    statics: Vec::new(),
                    closure_defs: Vec::new(),
                },
            ),
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\func main0() struct{} {
            \\    for {
            ,
        ),
    );
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
fn rejects_unsupported_mutually_recursive_join_groups_before_emission() -> () {
    let ty = repr::Type::Unit;
    let joins: Vec[anf::JoinBind] = Vec::new();
    joins.push(
        anf::JoinBind {
            name: "first",
            role: anf::JoinRole::Continuation,
            params: Vec::new(),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::new(),
                term: anf::Term::Jump { target: "second", args: Vec::new(), ret_ty: ty },
            },
        },
    );
    joins.push(
        anf::JoinBind {
            name: "second",
            role: anf::JoinRole::Continuation,
            params: Vec::new(),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::new(),
                term: anf::Term::Jump { target: "first", args: Vec::new(), ret_ty: ty },
            },
        },
    );
    let functions: Vec[anf::Function] = Vec::new();
    functions.push(
        anf::Function {
            name: "cycle",
            origin: anf::FunctionOrigin::Source,
            root: true,
            trait_impl: Option::None,
            params: Vec::new(),
            ret_ty: ty,
            body: anf::Block {
                binds: Vec::from_array([anf::Bind::JoinRec(joins)]),
                term: anf::Term::Jump { target: "first", args: Vec::new(), ret_ty: ty },
            },
        },
    );
    match lower(
        anf::File {
            functions,
            enums: Vec::new(),
            structs: Vec::new(),
            type_instances: Vec::new(),
            constants: Vec::new(),
            statics: Vec::new(),
            closure_defs: Vec::new(),
        },
    ) {
        Err(error) => testing::assert_eq(
            error,
            "in function cycle: Go backend requires each recursive join group to contain exactly one join",
        ),
        Ok(_) => testing::fail("expected recursive join validation error"),
    }
}

fn callable_file(callable: repr::Callable) -> anf::File {
    let ty = repr::Type::Func { params: Vec::new(), ret_ty: repr::Type::Unit };
    anf::File {
        functions: Vec::from_array(
            [
                anf::Function {
                    name: "invalid_callable",
                    origin: anf::FunctionOrigin::Source,
                    root: true,
                    trait_impl: Option::None,
                    params: Vec::new(),
                    ret_ty: ty,
                    body: anf::Block {
                        binds: Vec::new(),
                        term: anf::Term::Return(anf::Imm::Callable { callable, ty }),
                    },
                },
            ],
        ),
        enums: Vec::new(),
        structs: Vec::new(),
        type_instances: Vec::new(),
        constants: Vec::new(),
        statics: Vec::new(),
        closure_defs: Vec::new(),
    }
}

#[test]
fn rejects_unknown_runtime_hooks_before_emission() -> () {
    match lower(callable_file(repr::Callable::Runtime("vendor.unknown"))) {
        Err(error) => testing::assert_eq(error, "unknown runtime hook vendor.unknown"),
        Ok(_) => testing::fail("expected runtime hook validation error"),
    }
}

#[test]
fn rejects_unknown_intrinsics_before_emission() -> () {
    match lower(callable_file(repr::Callable::Intrinsic("vendor.unknown"))) {
        Err(error) => testing::assert_eq(error, "unknown intrinsic vendor.unknown"),
        Ok(_) => testing::fail("expected intrinsic validation error"),
    }
}

#[test]
fn lowers_go_ffi_calls_through_abi_wrappers() -> () {
    let output = encode(
        lower_source(
            "#[go_ffi(\"strings\", \"Cut\")] extern fn cut(value: string, separator: string) -> (string, string, bool); #[go_ffi(\"runtime\", \"Gosched\")] extern fn gosched() -> (); fn main() -> () { let _ = cut(\"a:b\", \":\"); gosched() }",
        ),
    );
    testing::assert(string_contains(output, "\"strings\""));
    testing::assert(string_contains(output, "\"runtime\""));
    testing::assert(string_contains(output, ".Cut(arg0, arg1)"));
    testing::assert(string_contains(output, "result0, result1, result2 ="));
    testing::assert(
        string_contains(
            output,
            \\.Gosched()
            \\    return struct{}{}
            ,
        ),
    )
}

#[test]
fn lowers_empty_marker_dyn_go_ffi_values_through_data() -> () {
    let output = encode(
        lower_source(
            "trait NativeValue {} struct Box {} impl NativeValue for Box {} #[go_ffi(\"example.com/ffi\", \"Echo\")] extern fn echo(value: dyn NativeValue) -> dyn NativeValue; fn main() -> () { let value: dyn NativeValue = Box {} as dyn NativeValue; let _ = echo(value); }",
        ),
    );
    if !string_contains(output, ".Echo(arg0.data)")
        || !string_contains(output, "return dyn__NativeValue{")
        || !string_contains(output, "data: _goml_ffi_import_") {
        testing::fail(output)
    }
}

#[test]
fn preserves_loop_carried_assignments() -> () {
    let source = "fn main() -> () { let mut i = 0; while i < 3 { println(i); i = i + 1; } }";
    testing::assert(string_contains(encode(lower_source(source)), "\n            i__0 = "))
}

#[test]
fn preserves_outer_loop_continuation_after_nested_while() -> () {
    let source = "fn main() -> () { let mut index = 0; while index < 2 { let start = index; if start == 0 { index = start + 1; while index < 1 { index = index + 1; }; println(\"space\") } else { index = index + 1; println(\"other\") } } }";
    let output = encode(lower_source(source));
    testing::assert(!output.contains("panic(\"unreachable\")"));
    testing::assert(output.contains("_goml_m_println(\"space\")"));
    testing::assert(output.contains("continue"))
}

#[test]
fn preserves_all_exit_while_conditions() -> () {
    let source = "fn loop_return_unit(flag: bool) -> () { while if flag { return } else { return } { println(\"unreachable\"); }; } fn main() -> () { loop_return_unit(true) }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\func loop_return_unit(flag__0 bool) struct{} {
            \\    if flag__0 {
            \\        return struct{}{}
            \\    } else {
            \\        return struct{}{}
            \\    }
            \\}
            ,
        ),
    )
}

#[test]
fn preserves_reused_loop_labels() -> () {
    let source = "enum Event { Open, Close, Advance, Error, } fn main() -> () { let running = Ref::new(true); while running.get() { let event = Event::Open; match event { Event::Open => { let scanning = Ref::new(false); while scanning.get() {} }, Event::Close => (), Event::Advance => (), Event::Error => (), }; let scanning = Ref::new(false); while scanning.get() {}; running.set(false) }; println(\"ok\") }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\Loop_loop6:
            \\    for {
            ,
        ),
    );
    testing::assert(string_contains(output, "Loop_loop11__2:"));
    testing::assert(string_contains(output, "Loop_loop11__3:"));
    testing::assert(string_contains(output, "Loop_loop11__4:"));
    testing::assert(!string_contains(output, "panic(\"unreachable\")"))
}

#[test]
