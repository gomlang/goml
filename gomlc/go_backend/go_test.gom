}

#[test]
fn contextualizes_closures_in_generic_struct_fields() -> () {
    let source = "struct Wrapper[T] { value: T, transform: (T) -> string, } fn show_wrapper[T](wrapper: Wrapper[T]) -> string { wrapper.transform(wrapper.value) } fn main() -> () { let wrapper = if true { Wrapper { value: 42, transform: |value: i32| value.to_string() } } else { Wrapper { value: 0, transform: |value: i32| \"zero\" } }; println(show_wrapper(wrapper)); }";
    let output = encode(lower_source(source));
