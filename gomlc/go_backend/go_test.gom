#[test]
fn sorts_dyn_helpers_and_compacts_builtin_impl_names() -> () {
    let source = "fn main() { let inner: dyn Hash = 1 as dyn Hash; let r = Ref::new(inner); let alias = r; let value: dyn Hash = r as dyn Hash; println((Hash::hash(value) == Hash::hash(alias)).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type ref_Dyn_Hash_x struct {
        \\    value dyn__Hash
        \\}
        \\
        \\type dyn__Hash_vtable struct {
        \\    hash func(any) uint64
        \\}
        \\
        \\type dyn__Hash struct {
        \\    data any
        \\    vtable *dyn__Hash_vtable
        \\}
        \\
        \\func dyn__Hash__wrap__Ref_8Dyn_Hash__hash(self any) uint64 {
        \\    return _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(self.(*ref_Dyn_Hash_x))
        \\}
        \\
        \\func dyn__Hash__vtable__Ref_8Dyn_Hash() *dyn__Hash_vtable {
        \\    return &dyn__Hash_vtable{
        \\        hash: dyn__Hash__wrap__Ref_8Dyn_Hash__hash,
        \\    }
        \\}
        \\
        \\func dyn__Hash__wrap__int__hash(self any) uint64 {
        \\    return _goml_m_trait__impl_i_Hash_i_isize_i_hash(self.(int))
        \\}
        \\
        \\func dyn__Hash__vtable__int() *dyn__Hash_vtable {
        \\    return &dyn__Hash_vtable{
        \\        hash: dyn__Hash__wrap__int__hash,
        \\    }
        \\}
        \\
        \\func main0() struct{} {
        \\    var inner__0 dyn__Hash = dyn__Hash{
        \\        data: int(1),
        \\        vtable: dyn__Hash__vtable__int(),
        \\    }
        \\    var r__1 *ref_Dyn_Hash_x = _goml_m_inherent_i_Ref_i_Ref_l_dynHash_r__i_new(inner__0)
        \\    var value__3 dyn__Hash = dyn__Hash{
        \\        data: r__1,
        \\        vtable: dyn__Hash__vtable__Ref_8Dyn_Hash(),
        \\    }
        \\    var t2 uint64 = value__3.vtable.hash(value__3.data)
        \\    var t3 uint64 = _goml_m_trait__impl_i_Hash_i_Ref_l_dynHash_r__i_hash(r__1)
        \\    var t4 bool = t2 == t3
        \\    var t5 string = _goml_m_trait__impl_i_ToString_i_bool_i_to__string(t4)
        \\    _goml_m_println(t5)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn uses_synthetic_hashmap_options_when_unmaterialized() -> () {
    let source = "fn main() -> () { let map: HashMap[i32, string] = HashMap::new(); map[1] = \"ok\"; println(\"ok\"); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type _goml_synthetic__goml_option__string interface"));
    testing::assert(
        string_contains(
            output,
            "func hashmap_get__HashMap_5int32_6string(m *hashmap_int32_string_x, key int32) _goml_synthetic__goml_option__string",
        ),
    );
    testing::assert(!string_contains(output, "type Option__string interface"))
}

#[test]
fn uses_linked_hashmap_option_variants() -> () {
    let source = "fn main() -> () { let map: HashMap[i32, i32] = HashMap::new(); map.set(1, 2); match map.get(1) { Option::Some(value) => println(value), Option::None => println(0), } }";
    let output = encode(lower_linked_source(source));
    testing::assert(string_contains(output, "type Option__i32 uint64"));
    testing::assert(string_contains(output, "uint64(int64(value) + 2147483648) + 1"));
    testing::assert(string_contains(output, "Option__i32(0)"))
}

#[test]
fn reuses_materialized_hashmap_option_types() -> () {
    let source = "struct HashmapI32I32X { value: i32, } fn main() -> () { let c = HashmapI32I32X { value: 4 }; let m: HashMap[i32, i32] = HashMap::new(); m.set(1, 5); match m.get(1) { Option::Some(v) => println(c.value + v), Option::None => println(0), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Option__i32 uint64"));
    testing::assert(string_contains(output, " != Option__i32(0)"));
    testing::assert(string_contains(output, "int32(int64(uint64("));
    testing::assert(!string_contains(output, "type Option__i32 interface"))
}

#[test]
fn reuses_wide_compact_hashmap_option_types() -> () {
    let source = "enum Payload { Left(string, string), Right(string, string), } fn main() -> () { let map: HashMap[string, Payload] = HashMap::new(); map.set(\"key\", Payload::Left(\"a\", \"b\")); match map.get(\"key\") { Option::Some(value) => match value { Payload::Left(a, _) => println(a), Payload::Right(a, _) => println(a), }, Option::None => println(\"missing\"), } }";
    let output = encode(lower_linked_source(source));
    testing::assert(string_contains(output, "type Option__Payload struct"));
    testing::assert(string_contains(output, "func hashmap_get__HashMap_6string_7Payload("));
    testing::assert(string_contains(output, "_p0: value"));
    testing::assert(!string_contains(output, "Option__Payload_Some"))
}

