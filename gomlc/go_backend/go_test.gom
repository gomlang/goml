}

#[test]
fn emits_while_conditions_with_try_matches() -> () {
    let source = "fn step(i: i32) -> Option[bool] { match i { 0 => Option::Some(true), 1 => Option::Some(true), 2 => Option::Some(false), _ => Option::None, } } fn main() -> Option[()] { let i = Ref::new(0); while match step(i.get())? { true => { i.set(i.get() + 1); true }, false => false, } { () }; Option::Some(()) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Option__bool uint8"));
    testing::assert(string_contains(output, "type _goml_m_Option_____o__q_ uint8"));
    testing::assert(string_contains(output, " != Option__bool(0)"));
    testing::assert(string_contains(output, "break Loop_loop16"))
}

#[test]
fn emits_entry_wrapper_without_main() -> () {
