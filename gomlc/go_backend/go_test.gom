#[test]
fn emits_missing_runtime_helpers() -> () {
    let source = "enum Never {} fn never() -> Never { never() } fn missing_int(value: Never) -> i32 { match value {} } fn missing_string(value: Never) -> string { match value {} } fn main() -> () { println(missing_int(never())); println(missing_string(never())); }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\func _goml_intrinsic_missing(s string) struct{} {
            \\    println("missing: " + s)
            \\    panic("")
            \\    return struct{}{}
            \\}
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\func missing__int32(s string) int32 {
            \\    _goml_intrinsic_missing(s)
            \\    var ret int32
            \\    return ret
            \\}
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\func missing__string(s string) string {
            \\    _goml_intrinsic_missing(s)
            \\    var ret string
            \\    return ret
            \\}
            ,
        ),
    )
}

#[test]
fn emits_hidden_ref_intrinsic_helpers() -> () {
    let source = "fn ref(x: i32) -> Ref[i32] { println(\"user ref \" + x.to_string()); Ref::new(x + 10) } fn ref_get(r: Ref[i32]) -> i32 { println(\"user get\"); 100 } fn ref_set(r: Ref[i32], x: i32) -> () { println(\"user set \" + x.to_string()); } fn main() -> () { let mut x: i32 = 0; let inc = || { x = x + 1; x }; println(inc().to_string()); println(x.to_string()); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func ref__Ref_5int32(value int32) *ref_int32_x"));
    testing::assert(
        string_contains(output, "func ref_get__Ref_5int32(reference *ref_int32_x) int32"),
    );
    testing::assert(
        string_contains(
            output,
            "func ref_set__Ref_5int32(reference *ref_int32_x, value int32) struct{}",
        ),
    );
    testing::assert(string_contains(output, "type closure_env_inc_0 struct"));
    testing::assert(string_contains(output, "var inc__5 func() int32 = func() int32"));
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__inc__0_i_closure__env__inc__0_i_apply(",
        ),
    )
}

#[test]
fn protects_go_init_from_user_functions() -> () {
    let source = "fn init(x: i32) -> i32 { x + 1 } fn main() -> () { println(init(4)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\func main0() struct{} {
        \\    var t5 int32
        \\    var inline7 int32 = 4
        \\    var inline8 int32 = inline7 + 1
        \\    t5 = inline8
        \\    _goml_m_println(t5)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn protects_entry_wrapper_from_user_main0() -> () {
    let source = "fn main0() -> () { println(\"user\") } fn main() -> () { main0() }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\func main0__1() struct{} {
        \\    _goml_m_println("user")
        \\    return struct{}{}
        \\}
