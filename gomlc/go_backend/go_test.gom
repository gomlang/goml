    testing::assert(!string_contains(output, "for _, entry := range values"))
}

#[test]
fn emits_complete_hashmap_and_ref_runtime_helpers() -> () {
    let Ok(builtin) = tast::builtin_contract() else {
        testing::fail("expected builtin contract");
        return
    };
    let key = repr::Type::String;
    let value = repr::Type::Int32;
    let map_output = encode(
        File {
            items: hashmap_items(
                builtin,
                key,
                value,
                Vec::new(),
                Vec::new(),
                Vec::new(),
                new_function_names(),
                test_variant_infos(),
                true,
            ),
        },
    );
    testing::assert(
        string_contains(
            map_output,
            "func hashmap_new__HashMap_6string_5int32() *hashmap_string_int32_x",
        ),
    );
    testing::assert(string_contains(map_output, "indices: make(map[string]int),"));
    testing::assert(string_contains(map_output, "entries: nil,"));
    testing::assert(string_contains(map_output, "func hashmap_len__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_remove__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_contains__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "func hashmap_entries__HashMap_6string_5int32("));
    testing::assert(string_contains(map_output, "for _, entry := range m.entries {"));
    let ref_output = encode(
        File { items: ref_runtime_items(repr::Type::RefType { elem: repr::Type::Int32 }) },
    );
    testing::assert(
        string_contains(ref_output, "return uint64(_goml_reflect.ValueOf(reference).Pointer())"),
    )
}

#[test]
fn emits_tuple_types_and_prunes_dead_bindings() -> () {
    let source = "fn main() { let _ = (); let a = (true, false, (true, false)); let b = match a { (x, y, (z, w)) => w }; let _ = print(b); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type Tuple2_4bool_4bool struct {
        \\    _0 bool
        \\    _1 bool
        \\}
        \\
        \\type Tuple3_4bool_4bool_18Tuple2_4bool_4bool struct {
        \\    _0 bool
        \\    _1 bool
        \\    _2 Tuple2_4bool_4bool
        \\}
        \\
        \\func main0() struct{} {
        \\    var x5 bool = false
        \\    _goml_m_print(x5)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn preserves_unused_panicking_expressions() -> () {
    let source = "fn main() -> () { let divisor: isize = 2; let shift: isize = 1; let dead_div = 8 / divisor; let dead_rem = 8 % divisor; let dead_shl = 1 << shift; let dead_shr = 8 >> shift; let values = Vec::from_array([1]); let view = values.slice(0, 1); let dead_get = view[1]; let dead_sub = view.sub(0, 2); let dead_add = 1 + 2; println(42) }";
    let output = encode(lower_linked_source(source));
    testing::assert(string_contains(output, "_ = 8 / divisor__0\n"));
    testing::assert(string_contains(output, "_ = 8 % divisor__0\n"));
    testing::assert(string_contains(output, "_ = 1 << shift__0\n"));
    testing::assert(string_contains(output, "_ = 8 >> shift__0\n"));
    testing::assert(string_contains(output, "_ = view__0[1]\n"));
    testing::assert(string_contains(output, "_ = view__0[inline3:inline4]\n"));
    testing::assert(!string_contains(output, "1 + 2"))
}

#[test]
fn preserves_nested_tuple_discovery_order() -> () {
