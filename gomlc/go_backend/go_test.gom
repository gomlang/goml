}

#[test]
fn adapts_closures_for_dynamic_call_function_parameters() -> () {
    let source = "trait Mapper { fn map(self: Self, arg1: (i32) -> i32) -> i32; } struct Boxed { value: i32, } impl Mapper for Boxed { fn map(self: Boxed, f: (i32) -> i32) -> i32 { f(self.value) } } fn main() -> () { let x: dyn Mapper = (Boxed { value: 1 }) as dyn Mapper; println(Mapper::map(x, |n| n + 1)); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "var t9 func(int32) int32 = func(p0 int32) int32 {"));
    testing::assert(string_contains(output, "vtable._goml_m_map(x__2.data, t9)"));
    testing::assert(
        string_contains(
            output,
            "return _goml_m_inherent_i_closure__env__main__0_i_closure__env__main__0_i_apply(t8, p0)",
        ),
    );
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__main__0_i_closure__env__main__0_i_apply(",
        ),
    )
}

#[test]
fn emits_user_trait_objects_without_name_collisions() -> () {
    let source = "trait Display { fn display(self: Self) -> string; } fn dyn__Display() -> i32 { 1 } struct Box { text: string, } impl Display for Box { fn display(self: Self) -> string { self.text } } fn main() -> () { let d: dyn Display = (Box { text: \"ok\" }) as dyn Display; println(Display::display(d) + dyn__Display().to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type Box struct {
        \\    text string
        \\}
        \\
        \\type dyn__Display_vtable struct {
        \\    display func(any) string
        \\}
        \\
        \\type dyn__Display struct {
        \\    data any
        \\    vtable *dyn__Display_vtable
        \\}
        \\
        \\func dyn__Display__wrap__Box__display(self any) string {
        \\    return _goml_m_trait__impl_i_Display_i_Box_i_display(self.(Box))
        \\}
        \\
        \\func dyn__Display__vtable__Box() *dyn__Display_vtable {
        \\    return &dyn__Display_vtable{
        \\        display: dyn__Display__wrap__Box__display,
        \\    }
        \\}
        \\
        \\func _goml_m_trait__impl_i_Display_i_Box_i_display(self__0 Box) string {
        \\    var t5 string = self__0.text
        \\    return t5
        \\}
        \\
        \\func main0() struct{} {
        \\    var t7 Box = Box{
        \\        text: "ok",
        \\    }
        \\    var d__1 dyn__Display = dyn__Display{
        \\        data: t7,
        \\        vtable: dyn__Display__vtable__Box(),
        \\    }
        \\    var t8 string = d__1.vtable.display(d__1.data)
        \\    var t9 int32
        \\    t9 = 1
        \\    var t10 string = _goml_m_inherent_i_i32_i_i32_i_to__string(t9)
        \\    var t11 string = t8 + t10
        \\    _goml_m_println(t11)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn emits_non_repeating_joinrec_as_straight_line_control_flow() -> () {
    let source = "fn f(flag: i32) -> i32 { while true { if flag == 0 { return 1 } else { break }; }; 2 } fn main() -> () { println(f(0).to_string()); println(f(1).to_string()); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\func f(flag__0 int32) int32 {
        \\    var t9 bool = flag__0 == 0
        \\    if t9 {
        \\        return 1
        \\    } else {
        \\        return 2
        \\    }
        \\}
        \\
        \\func main0() struct{} {
        \\    var t11 int32 = f(0)
        \\    var t12 string = _goml_m_inherent_i_i32_i_i32_i_to__string(t11)
        \\    _goml_m_println(t12)
        \\    var t13 int32 = f(1)
        \\    var t14 string = _goml_m_inherent_i_i32_i_i32_i_to__string(t13)
        \\    _goml_m_println(t14)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn emits_closures_inside_enum_payloads() -> () {
    let source = "enum MaybeFn { Some((i32) -> i32), None, } fn next(flag: bool) -> MaybeFn { if flag { MaybeFn::Some(|x| x + 1) } else { MaybeFn::None } } fn main() -> () { match next(true) { MaybeFn::Some(f) => println(f(41).to_string()), MaybeFn::None => println(\"none\"), } }";
