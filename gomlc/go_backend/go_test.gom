#[test]
fn lowers_tag_only_enums_as_constants() -> () {
    let source = "enum E { Tuple2_int32_int32, } fn main() -> () { let t = (10, 13); let tag = E::Tuple2_int32_int32; match tag { E::Tuple2_int32_int32 => println(t.0 + t.1), }; }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type Tuple2_3int_3int struct {
        \\    _0 int
        \\    _1 int
        \\}
        \\
        \\type E struct{}
        \\
        \\func main0() struct{} {
        \\    var tag__1 E = E{}
        \\    switch tag__1 {
        \\    case E{}:
        \\        var t3 int = 10
        \\        var t4 int = 13
        \\        var t5 int = t3 + t4
        \\        _goml_m_println(t5)
        \\    default:
        \\        panic("non-exhaustive match")
        \\    }
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn shares_enum_payload_slots_and_uses_narrow_tags() -> () {
    let source = "enum Choice { First(u8), Second(u8), Wide(u16), Empty, } fn read(value: Choice) -> isize { match value { Choice::First(value) => value.to_isize(), Choice::Second(value) => value.to_isize(), Choice::Wide(value) => value.to_isize(), Choice::Empty => 0, } } fn main() -> () { println(read(Choice::Second(3))) }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\type Choice struct {
            \\    _p1 uint16
            \\    _p0 uint8
            \\    _tag uint8
            \\}
            ,
        ),
    );
    testing::assert(!string_contains(output, "_v0_0"));
    testing::assert(!string_contains(output, "_v1_0"))
}

#[test]
fn erases_zero_sized_enum_payloads() -> () {
    let source = "struct Marker {} enum Choice { MarkerValue(Marker), UnitValue(()), } fn main() -> () { let value = Choice::MarkerValue(Marker {}); match value { Choice::MarkerValue(_) => println(1), Choice::UnitValue(_) => println(2), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Choice uint8"));
    testing::assert(!string_contains(output, "type Choice struct"));
    testing::assert(!string_contains(output, "_p0 Marker"))
}

#[test]
fn uses_pointer_niches_for_optional_pointer_payloads() -> () {
    let source = "enum MaybeVec { None, Some(Vec[i32]), } fn size(value: MaybeVec) -> isize { match value { MaybeVec::None => 0, MaybeVec::Some(items) => items.len(), } } fn main() -> () { let items: Vec[i32] = Vec::new(); println(size(MaybeVec::Some(items))) }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\type MaybeVec struct {
            \\    _value *_goml_vec_int32
            \\}
            ,
        ),
    );
    testing::assert(!string_contains(output, "type MaybeVec interface"));
    testing::assert(!string_contains(output, "_tag uint8"))
}

#[test]
fn packs_optional_small_scalars() -> () {
    let source = "enum MaybeByte { None, Some(u8), } fn read(value: MaybeByte) -> u8 { match value { MaybeByte::None => 0, MaybeByte::Some(value) => value, } } fn main() -> () { println(read(MaybeByte::Some(255))) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type MaybeByte uint16"));
    testing::assert(!string_contains(output, "type MaybeByte struct"))
}

#[test]
fn packs_negative_signed_scalars_without_overflowing_go_constants() -> () {
    let source = "enum MaybeSigned { None, Some(i32), } fn read(value: MaybeSigned) -> i32 { match value { MaybeSigned::None => 0, MaybeSigned::Some(value) => value, } } fn main() -> () { println(read(MaybeSigned::Some(-7))) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type MaybeSigned uint64"));
    testing::assert(!string_contains(output, "uint32(-7)"))
}

#[test]
fn plans_nested_enums_before_their_owners() -> () {
    let source = "enum Outer { None, Some(Inner), } enum Inner { Left(u8), Right(u8), } fn main() -> () { let value = Outer::Some(Inner::Right(9)); match value { Outer::None => println(0), Outer::Some(Inner::Left(x)) => println(x), Outer::Some(Inner::Right(x)) => println(x), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Inner struct"));
    testing::assert(string_contains(output, "type Outer struct"));
    testing::assert(!string_contains(output, "type Outer interface"))
}

#[test]
fn stores_recursive_enums_behind_node_pointers() -> () {
    let source = "enum List { Nil, Cons(i32, List), } fn sum(value: List) -> i32 { match value { List::Nil => 0, List::Cons(head, tail) => head + sum(tail), } } fn main() -> () { println(sum(List::Cons(1, List::Nil))) }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\type List struct {
            \\    _node *List_node
            \\}
            ,
        ),
    );
    testing::assert(string_contains(output, "type List_node struct"));
    testing::assert(string_contains(output, "func _goml_enum_tag_List(value List) uint8"));
    testing::assert(!string_contains(output, "type List interface"))
}

#[test]
fn stores_wide_recursive_variants_in_separate_payloads() -> () {
    let source = "enum Tree { Empty, Leaf(i32), Branch(Tree, Tree), Named(string, string, string, string, Tree), } fn count(value: Tree) -> i32 { match value { Tree::Empty => 0, Tree::Leaf(value) => value, Tree::Branch(left, right) => count(left) + count(right), Tree::Named(_, _, _, _, child) => count(child), } } fn main() -> () { println(count(Tree::Branch(Tree::Leaf(2), Tree::Named(\"a\", \"b\", \"c\", \"d\", Tree::Empty)))) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Tree interface"));
    testing::assert(string_contains(output, "type Leaf struct"));
    testing::assert(!string_contains(output, "type Tree_node struct"))
}

#[test]
fn preserves_user_structs_before_mono_instances() -> () {
    let source = "struct Box[T] { value: T, } struct Box__i32 { value: i32, } fn main() -> () { let a = Box { value: 10 }; let b = Box__i32 { value: 20 }; println(a.value + b.value) }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type Box__i32 struct {
        \\    value int32
        \\}
        \\
        \\type Box__i32__mono1 struct {
        \\    value int32
        \\}
        \\
        \\func main0() struct{} {
        \\    var t1 int32 = 10
        \\    var t2 int32 = 20
        \\    var t3 int32 = t1 + t2
        \\    _goml_m_println(t3)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn disambiguates_enum_variants_from_user_types() -> () {
    let source = "struct E__i32_A { value: i32, } enum E[T] { A(T, T, T, T), B, } fn main() -> () { let c = E__i32_A { value: 3 }; let _: E[string] = E::A(\"w\", \"x\", \"y\", \"z\"); let y: E[i32] = E::A(4, 0, 0, 0); match y { E::A(v, _, _, _) => println(v + c.value), E::B => println(0), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type E__i32_A struct"));
    testing::assert(string_contains(output, "type E__string interface"));
    testing::assert(string_contains(output, "type E__i32 struct"));
    testing::assert(!string_contains(output, "type E__i32 interface"));
    testing::assert(!string_contains(output, "type E__i32_A__variant1 struct"))
}

#[test]
fn emits_compact_generic_enums_without_variant_types() -> () {
    let source = "enum Option[T] { Some(T), None, } fn main() -> () { let x: Option[u8] = Option::Some(42); match x { Option::Some(v) => println(v.to_string()), Option::None => println(\"none\"), }; }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Option__u8 uint16"));
    testing::assert(!string_contains(output, "type Option__u8 interface"));
    testing::assert(!string_contains(output, "type Some struct"));
    testing::assert(!string_contains(output, "type None struct"))
}

#[test]
fn emits_compact_builtin_sums_around_interface_payloads() -> () {
    let source = "enum Payload { Left(string, string), Right(string, string), } fn result(value: Payload) -> Result[Payload, string] { Result::Ok(value) } fn option(value: Payload) -> Option[Payload] { Option::Some(value) } fn main() -> () { let value = Payload::Left(\"a\", \"b\"); let _ = result(value); let _ = option(value); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Payload interface"));
    testing::assert(
        string_contains(
            output,
            \\type Result__Payload__string struct {
            \\    _p0 Payload
            \\    _p1 string
            \\    _tag uint8
            \\}
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\type Option__Payload struct {
            \\    _p0 Payload
            \\    _tag uint8
            \\}
            ,
        ),
    );
    testing::assert(!string_contains(output, "type Result__Payload__string interface"));
    testing::assert(!string_contains(output, "type Option__Payload interface"))
}

#[test]
fn materializes_numeric_runtime_operands() -> () {
    let source = "fn main() -> () { let a: u8 = 13 % 5; let b: u8 = 1 << 7; let c: u8 = ~0; let d: u8 = 511.to_u8(); println(a); println(b); println(c); println(d); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\func main0() struct{} {
        \\    var a__0_lhs uint8 = 13
        \\    var a__0_rhs uint8 = 5
        \\    var a__0 uint8 = a__0_lhs % a__0_rhs
        \\    var b__1_lhs uint8 = 1
        \\    var b__1_rhs int = 7
        \\    var b__1 uint8 = b__1_lhs << b__1_rhs
        \\    var c__2_operand uint8 = 0
        \\    var c__2 uint8 = ^c__2_operand
        \\    var d__3_source int = 511
        \\    var d__3 uint8 = uint8(int(d__3_source))
        \\    _goml_m_println(a__0)
        \\    _goml_m_println(b__1)
        \\    _goml_m_println(c__2)
        \\    _goml_m_println(d__3)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn lowers_uint_and_runtime_traits() -> () {
    let output = encode(
        lower_linked_source(
            "fn main() -> () { let value: usize = 40 + 2; println(value.to_string()); let values: HashMap[usize, string] = HashMap::new(); values.set(value, \"stored\"); match values.get(42) { Option::Some(item) => println(item), Option::None => println(\"missing\"), }; }",
        ),
    );
    testing::assert(string_contains(output, "var value__0 uint"));
    testing::assert(string_contains(output, "uint_to_string"));
    testing::assert(string_contains(output, "key uint"))
}

#[test]
fn preserves_float32_literals_for_go_rounding() -> () {
    let source = "fn identity[T](x: T) -> T { x } fn main() -> () { let value: f32 = identity(3.14); println(value.to_string()) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "float32 = 3.14\n"))
}

#[test]
fn emits_go_safe_float_boundaries() -> () {
    let source = "fn identity[T](value: T) -> T { value } fn main() -> () { let below: f32 = 1.0000000596046447753906249999999999999999; let midpoint: f32 = 1.000000059604644775390625; let above: f32 = 1.0000000596046447753906250000000000000001; let generic: f32 = identity(1.0000000596046447753906250000000000000001); let maximum32: f32 = 3.4028235e38; let maximum64: f64 = 1.7976931348623157e308; println(below.to_bits()); println(midpoint.to_bits()); println(above.to_bits()); println(generic.to_bits()); println(maximum32.to_bits()); println(maximum64.to_bits()) }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "var below__"));
    testing::assert(string_contains(output, "var midpoint__"));
    testing::assert(string_contains(output, "float32 = 1\n"));
    testing::assert(string_contains(output, "float32 = 1.0000001\n"));
    testing::assert(string_contains(output, "float32 = 340282350000000000000000000000000000000\n"));
    testing::assert(string_contains(output, "float64 = 17976931348623157e292\n"))
}

#[test]
fn compacts_long_integer_float_literals() -> () {
    let zeros = "0000000000000000" + "0000000000000000" + "0000000000000000" + "0000000000000000"
        + "0000000000000000";
    testing::assert_eq(compact_go_float_literal("123" + zeros), "123e80");
    testing::assert_eq(compact_go_float_literal("-123" + zeros), "-123e80");
    testing::assert_eq(compact_go_float_literal(zeros), zeros);
    testing::assert_eq(compact_go_float_literal("-" + zeros), "-" + zeros);
    testing::assert_eq(compact_go_float_literal("1." + zeros), "1." + zeros);
    testing::assert_eq(compact_go_float_literal("1e" + zeros), "1e" + zeros);
    testing::assert_eq(compact_go_float_literal("1000"), "1000")
}

#[test]
fn canonicalizes_float64_literals() -> () {
    let source = "fn main() -> () { let value: f64 = 0.0; println(value.to_string()) }";
    testing::assert(string_contains(encode(lower_source(source)), "var value__0 float64 = 0\n"))
}

#[test]
fn disambiguates_dyn_helper_names() -> () {
    let source = "trait A { fn foo(self: Self) -> i32; fn b__foo(self: Self) -> i32; } struct C {} struct C__B {} impl A for C { fn foo(self: C) -> i32 { 1 } fn b__foo(self: C) -> i32 { 2 } } impl A for C__B { fn foo(self: C__B) -> i32 { 10 } fn b__foo(self: C__B) -> i32 { 20 } } fn main() -> () { let left: dyn A = (C {}) as dyn A; let right: dyn A = (C__B {}) as dyn A; println(A::b__foo(left)); println(A::foo(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type C struct {}
        \\
        \\type C__B struct {}
        \\
        \\type dyn__A_vtable struct {
        \\    foo func(any) int32
        \\    b__foo func(any) int32
        \\}
        \\
        \\type dyn__A struct {
        \\    data any
        \\    vtable *dyn__A_vtable
        \\}
        \\
        \\func dyn__A__wrap__C__foo(self any) int32 {
        \\    return _goml_m_trait__impl_i_A_i_C_i_foo(self.(C))
        \\}
        \\
        \\func dyn__A__wrap__C__b__foo(self any) int32 {
        \\    return _goml_m_trait__impl_i_A_i_C_i_b____foo(self.(C))
        \\}
        \\
        \\func dyn__A__vtable__C() *dyn__A_vtable {
        \\    return &dyn__A_vtable{
        \\        foo: dyn__A__wrap__C__foo,
        \\        b__foo: dyn__A__wrap__C__b__foo,
        \\    }
        \\}
        \\
        \\func dyn__A__wrap__C__B__foo(self any) int32 {
        \\    return _goml_m_trait__impl_i_A_i_C____B_i_foo(self.(C__B))
        \\}
        \\
        \\func dyn__A__wrap__C__B__b__foo(self any) int32 {
        \\    return _goml_m_trait__impl_i_A_i_C____B_i_b____foo(self.(C__B))
        \\}
        \\
        \\func dyn__A__vtable__C__B() *dyn__A_vtable {
        \\    return &dyn__A_vtable{
        \\        foo: dyn__A__wrap__C__B__foo,
        \\        b__foo: dyn__A__wrap__C__B__b__foo,
        \\    }
        \\}
        \\
        \\func _goml_m_trait__impl_i_A_i_C_i_foo(self__0 C) int32 {
        \\    return 1
        \\}
        \\
        \\func _goml_m_trait__impl_i_A_i_C_i_b____foo(self__1 C) int32 {
        \\    return 2
        \\}
        \\
        \\func _goml_m_trait__impl_i_A_i_C____B_i_foo(self__2 C__B) int32 {
        \\    return 10
        \\}
        \\
        \\func _goml_m_trait__impl_i_A_i_C____B_i_b____foo(self__3 C__B) int32 {
        \\    return 20
        \\}
        \\
        \\func main0() struct{} {
        \\    var t11 C = C{}
        \\    var left__4 dyn__A = dyn__A{
        \\        data: t11,
        \\        vtable: dyn__A__vtable__C(),
        \\    }
        \\    var t12 C__B = C__B{}
        \\    var right__5 dyn__A = dyn__A{
        \\        data: t12,
        \\        vtable: dyn__A__vtable__C__B(),
        \\    }
        \\    var t13 int32 = left__4.vtable.b__foo(left__4.data)
        \\    _goml_m_println(t13)
        \\    var t14 int32 = right__5.vtable.foo(right__5.data)
        \\    _goml_m_println(t14)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn emits_blank_assignment_for_discarded_non_call_side_effects() -> () {
    let source = "struct S {} impl ToString for S { fn to_string(self: S) -> string { \"S\" } } fn main() -> () { let value = S {}; let dynamic: dyn ToString = value as dyn ToString; let _ = dynamic; }";
    testing::assert(string_contains(encode(lower_source(source)), "_ = dyn__ToString{"))
}

#[test]
fn protects_index_intrinsics_from_user_functions() -> () {
    let source = "fn array_get(arr: [i32; 2], index: i32) -> i32 { 90 + index } fn array_set(arr: [i32; 2], index: i32, value: i32) -> [i32; 2] { [77, 88] } fn vec_get(v: Vec[i32], index: i32) -> i32 { 70 + index } fn vec_set(v: Vec[i32], index: i32, value: i32) -> () { () } fn slice_get(s: Slice[i32], index: i32) -> i32 { 60 + index } fn hashmap_get(m: HashMap[string, i32], key: string) -> Option[i32] { Option::Some(55) } fn hashmap_set(m: HashMap[string, i32], key: string, value: i32) -> () { () } fn main() -> () { let a = [4, 5]; println(array_get(a, 1)); println(a[1]); let c: [i32; 2] = array_set(a, 0, 9); println(c[0]); let mut b = [1, 2]; b[0] = 9; println(array_get(b, 0)); println(b[0]); let v: Vec[i32] = Vec::new().pushed(8).pushed(9); println(vec_get(v, 1)); println(v[1]); let mut v2: Vec[i32] = Vec::new().pushed(1).pushed(2); vec_set(v2, 0, 99); println(v2[0]); v2[1] = 99; println(v2[1]); let s = v.slice(0, 2); println(slice_get(s, 1)); println(s[1]); let text = \"ab\"; println(string_get(text, 0)); println(text[1]); let m: HashMap[string, i32] = HashMap::new(); hashmap_set(m, \"b\", 11); match m[\"b\"] { Option::Some(x) => println(x), Option::None => println(0), }; m[\"a\"] = 42; match hashmap_get(m, \"a\") { Option::Some(x) => println(x), Option::None => println(0), }; match m[\"a\"] { Option::Some(x) => println(x), Option::None => println(0), }; } fn string_get(s: string, index: i32) -> char { 'x' }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "func array_get__Array_2_5int32("));
    testing::assert(string_contains(output, "func array_set__Array_2_5int32("));
    testing::assert(string_contains(output, "func vec_get__Vec_5int32("));
    testing::assert(string_contains(output, "func vec_set__Vec_5int32("));
    testing::assert(string_contains(output, "func hashmap_lookup__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_get__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "func hashmap_set__HashMap_6string_5int32("));
    testing::assert(string_contains(output, "var inline115 int32 = 90 + inline114"));
    testing::assert(string_contains(output, "var inline105 int32 = 70 + inline104"));
    testing::assert(string_contains(output, "t75 = 120"));
    testing::assert(string_contains(output, "uint64(int64(55) + 2147483648) + 1"));
    testing::assert(string_contains(output, "array_get__Array_2_5int32(a__17, 1)"));
    testing::assert(string_contains(output, "s__22[1]"));
    testing::assert(string_contains(output, "_goml_runtime_core_string_get("));
    testing::assert(string_contains(output, "hashmap_get__HashMap_6string_5int32(m__"));
    testing::assert(!string_contains(output, "_goml_m_array_t_get"));
    testing::assert(!string_contains(output, "_goml_m_vec_t_get"));
    testing::assert(!string_contains(output, "_goml_m_hashmap_t_get"))
}

#[test]
fn emits_unused_non_generic_enums() -> () {
    testing::assert_eq(
        encode(lower_source("enum Status { Idle, Busy(i32), }")),
        \\package main
        \\
        \\type Status uint64
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn orders_runtime_types_before_tuples() -> () {
    let source = "fn make_counter() -> (() -> i32, () -> ()) { let cell = Ref::new(0); let next = || cell.get(); let reset = || cell.set(0); (next, reset) } fn main() -> () { let _ = make_counter(); }";
    testing::assert(
        string_contains(
            encode(lower_source(source)),
            \\type ref_int32_x struct {
            \\    value int32
            \\}
            \\
            \\type Tuple2_17TFunc0_ret_5int32_16TFunc0_ret_4unit struct
            ,
        ),
    )
}

#[test]
fn lowers_callable_intrinsics() -> () {
    let source = "fn main() -> () { let to_text: (i32) -> string = int32_to_string; println(to_text(7)); let get: (Vec[i32], isize) -> i32 = vec_get; let push: (Vec[i32], i32) -> () = vec_push; let values: Vec[i32] = Vec::new(); push(values, 11); push(values, 22); println(get(values, 1)); let make_slice: (Vec[i32], isize, isize) -> Slice[i32] = slice; let slice_get_value: (Slice[i32], isize) -> i32 = slice_get; let view = make_slice(values, 0, 2); println(slice_get_value(view, 0)); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "int32_to_string(7)"));
    testing::assert(string_contains(output, "var push__2 func("));
    testing::assert(string_contains(output, "var get__1 func("));
    testing::assert(!string_contains(output, "\"fmt\""))
}

#[test]
fn hoists_continuations_through_nested_matches() -> () {
    let source = "enum T { A, B(bool, bool), } fn test(t: T) -> () { match t { A => println((1).to_string()), B(false, false) => println((2).to_string()), B(false, true) => println((3).to_string()), _ => println((4).to_string()), } } fn main() { let _ = test(B(true, true)); let _ = test(B(false, true)); let _ = test(B(false, false)); let _ = test(A); () }";
    let output = encode(lower_source(source));
    testing::assert(
        string_contains(
            output,
            \\type T struct {
            \\    _p0 bool
            \\    _p1 bool
            \\    _tag uint8
            \\}
            ,
        ),
    );
    testing::assert(string_contains(output, "switch t__0._tag {"));
    testing::assert(string_contains(output, "var x0 bool = t__0._p0"));
    testing::assert(string_contains(output, "var x1 bool = t__0._p1"));
    testing::assert(string_contains(output, "var t22 T = T{"))
}

#[test]
fn keeps_mixed_match_continuations_in_branches() -> () {
    let source = "enum Choice { Early, Keep(i32), } fn choose(choice: Choice) -> i32 { let value = match choice { Choice::Early => return 1, Choice::Keep(value) => value, }; value + 1 } fn main() -> () { println(choose(Choice::Keep(2))); }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Choice uint64"));
    testing::assert(string_contains(output, "var inline15 int32 = 2"));
    testing::assert(string_contains(output, "var inline14 int32 = inline12 + 1"));
    testing::assert(string_contains(output, "_goml_m_println(t9)"))
}

#[test]
fn emits_string_hooks_and_vec_new_helpers() -> () {
    let source = "fn main() -> () { let values: Vec[i32] = vec_new(); string_print(values.len().to_string()); string_println(\"!\"); let bytes: Vec[u8] = Vec::new(); let (_, text) = string_from_utf8(bytes); string_print(text); let parts: Vec[string] = Vec::new(); string_println(string_concat(parts)); }";
    let output = encode(lower_linked_source(source));
    let _ = required_text_position(
        output,
        \\import (
        \\    _goml_os "os"
        \\)
        ,
    );
    let _ = required_text_position(output, "func _goml_runtime_core_string_from_utf8(");
    testing::assert(
        string_contains(output, "func string_concat(")
            || string_contains(output, "func __goml_builtin_string_concat("),
    );
    let _ = required_text_position(output, "func _goml_runtime_core_string_print(");
    let _ = required_text_position(output, "func _goml_runtime_core_string_println(");
    let _ = required_text_position(output, "func vec_new__Vec_5int32()");
}
