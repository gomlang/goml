}

#[test]
fn indexes_builtin_hashmap_keys_directly() -> () {
    let Ok(builtin) = tast::builtin_contract() else {
        testing::fail("expected builtin contract");
        return
    };
    let output = encode(
        File {
            items: hashmap_items(
                builtin,
                repr::Type::Int,
                repr::Type::String,
                Vec::new(),
                Vec::new(),
                Vec::new(),
                new_function_names(),
                test_variant_infos(),
                true,
            ),
        },
    );
    testing::assert(
        string_contains(
            output,
            \\type hashmap_int_string_x struct {
            \\    indices map[int]int
            \\    entries []hashmap_int_string_x_entry
            \\    len int
            \\}
            ,
        ),
    );
    testing::assert(string_contains(output, "index, found = m.indices[key]"));
    testing::assert(string_contains(output, "m.entries[index] = hashmap_int_string_x_entry{"));
    testing::assert(!string_contains(output, "buckets map[uint64]"));
    testing::assert(!string_contains(output, "_goml_m_trait__impl_i_Hash_i_isize_i_hash(key)"))
}

#[test]
fn dispatches_dyn_hashmap_keys_through_vtables() -> () {
    let source = "impl PartialEq for dyn Hash { fn eq(self: dyn Hash, other: dyn Hash) -> bool { Hash::hash(self) == Hash::hash(other) } } impl Eq for dyn Hash {} fn main() -> () { let values: HashMap[dyn Hash, string] = HashMap::new(); let key: dyn Hash = 1 as dyn Hash; values.set(key, \"one\"); println(values.contains(key).to_string()); }";
    let output = encode(lower_linked_source(source));
    testing::assert_eq(string_contains(output, "key.vtable.hash(key.data)"), true);
    testing::assert_eq(
        string_contains(output, "_goml_m_trait__impl_i_Hash_i_dynHash_i_hash"),
        false,
    )
}

#[test]
fn emits_generic_enum_instances_and_type_switches() -> () {
    let source = "enum Weird[T] { Next(Ref[Weird[(i32) -> i32]]), Done(T), } fn main() -> () { let x: Weird[i32] = Weird::Done(1); match x { Weird::Done(v) => println(v.to_string()), Weird::Next(_) => println(\"next\"), } }";
    let output = encode(lower_source(source));
    testing::assert(string_contains(output, "type Weird__i32 struct {"));
    testing::assert(string_contains(output, "_p0 *ref_"));
    testing::assert(string_contains(output, "_p1 int32"));
    testing::assert(string_contains(output, "_tag uint8"));
    testing::assert(!string_contains(output, "type Weird__i32 interface"));
    testing::assert(string_contains(output, "type _goml_m_Weird_____o_i32_q__m__z_i32 struct"));
    testing::assert(string_contains(output, "_p1 func(int32) int32"))
}

#[test]
fn dispatches_trait_objects_for_enum_receivers() -> () {
    let source = "trait Area { fn area(self: Self) -> i32; } enum Shape { Circle(i32), } impl Area for Shape { fn area(self: Shape) -> i32 { match self { Shape::Circle(radius) => radius * radius, } } } fn main() -> () { let shape: dyn Area = Shape::Circle(3) as dyn Area; println(Area::area(shape)); }";
    testing::assert(
        string_contains(
