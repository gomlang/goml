package go_backend;

use module::anf;
use module::ast;
use module::core;
use module::hash;
use module::hir;
use module::lift;
use module::mono;
use module::parser;
use module::repr;
use module::resources;
use module::tast;
use std::collections;
use std::text;
use std::testing;

fn test_variant_infos() -> VariantInfos {
    VariantInfos { by_owner: HashMap::new(), owners: HashMap::new() }
}

fn test_builtins(counter: Ref[isize]) -> core::File {
    match core::lower_builtins(counter) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            core::File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn test_prelude(builtins: core::File, counter: Ref[isize]) -> core::File {
    match core::lower_prelude(builtins, counter) {
        Ok(value) => value,
        Err(error) => {
            testing::fail(error.to_string());
            core::File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn required_lower(value: Result[File, string]) -> File {
    match value {
        Ok(file) => file,
        Err(error) => {
            testing::fail(error.to_string());
            File { items: Vec::new() }
        },
    }
}

fn test_external_functions() -> Vec[string] {
    Vec::from_array(
        [
            "print",
            "println",
            "int32_to_string",
            "trait_impl#ToString#bool#to_string",
            "trait_impl#ToString#u8#to_string",
            "trait_impl#ToString#f32#to_string",
            "trait_impl#ToString#f64#to_string",
            "trait_impl#Hash#Ref[dynHash]#hash",
        ],
    )
}

fn lower_anf_for_test(value: anf::File) -> Result[File, string] {
    validate_anf_with_external_functions(value, test_external_functions())?;
    lower_with_target(value, false, Option::None, Vec::new())
}

fn lower_anf_tests_for_test(
    value: anf::File,
    test_cases: Vec[(string, string, Vec[(string, string)])],
) -> Result[File, string] {
    validate_anf_with_external_functions(value, test_external_functions())?;
    lower_with_target(value, true, Option::None, test_cases)
}

fn lower_source(source: string) -> File {
    required_lower(
        lower_anf_for_test(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::lower(
                            tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
                        ),
                    ),
                ),
            ),
        ),
    )
}

fn lower_source_with_counter(source: string, start: isize) -> File {
    required_lower(
        lower_anf_for_test(
            anf::canonicalize_names(
                anf::lower(
                    lift::lower(
                        mono::lower(
                            core::lower_with_counter(
                                tast::check(
                                    hir::lower(ast::lower(parser::parse(source)), "main.gom"),
                                ),
                                Ref::new(start),
                            ),
                        ),
                    ),
                ),
            ),
        ),
    )
}

#[test]
fn generates_stable_go_names_across_ir_counters() -> () {
    let source = "fn stable2(value: i32) -> i32 { if value <= 0 { 0 } else { stable2(value - 1) + 1 } } fn main() -> () { println(stable2(2).to_string()) }";
    let initial = encode(lower_source_with_counter(source, 0));
    let shifted = encode(lower_source_with_counter(source, 500));
    testing::assert_eq(initial, shifted);
    testing::assert(initial.contains("func stable2("));
    testing::assert(initial.contains(" = stable2("))
}

#[test]
fn separates_top_level_and_local_go_names() -> () {
    let source = "const value__0: isize = 42; fn t0(value: isize) -> isize { if value == 0 { 5 } else { t0(value - 1) + 1 } } fn main() -> () { let value = 7; println(t0(0) + t0(1)); println(value); println(value__0) }";
    let output = encode(lower_source_with_counter(source, 0));
    testing::assert(
        output.contains(
            \\const (
            \\    value__0 int = 42
            ,
        ),
    );
    testing::assert(output.contains("func t0(_goml_local_value__0 int) int"));
    testing::assert(output.contains(" = t0(0)"));
    testing::assert(output.contains(" = t0(1)"));
    testing::assert(!output.contains("_goml_local_t0("));
    testing::assert(output.contains("var _goml_local_value__0 int = 7"));
    testing::assert(!output.contains("var value__0 int = 7"));
    let type_names: collections::HashSet[string] = collections::HashSet::new();
    let _ = type_names.insert("Marker");
    testing::assert_eq(local_ident(type_names, "Marker"), "_goml_local_Marker")
}

#[test]
fn detects_yaegi_incompatible_select_control_flow() -> () {
    testing::assert(
        !yaegi_compatible(
            \\Loop_outer:
            \\for {
            \\    select {
            \\    default:
            \\        break Loop_outer
            \\    }
            \\}
            \\
            ,
        ),
    );
    testing::assert(
        !yaegi_compatible(
            \\Loop_outer:
            \\for {
            \\    select {
            \\    default:
            \\        continue Loop_outer
            \\    }
            \\}
            \\
            ,
        ),
    );
    testing::assert(
        yaegi_compatible(
            \\select {
            \\default:
            \\    break
            \\}
            \\
            ,
        ),
    );
    testing::assert(
        yaegi_compatible(
            \\select {
            \\default:
            \\}
            \\Loop_outer:
            \\for {
            \\    break Loop_outer
            \\}
            \\
            ,
        ),
    )
}

fn lower_linked_source(source: string) -> File {
    let counter = Ref::new(0);
    let builtins = test_builtins(counter);
    let prelude = test_prelude(builtins, counter);
    let user = core::lower_with_counter_and_types(
        tast::check_for_link(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
        counter,
        core::enum_defs_to_tast(builtins.enums),
        core::struct_defs_to_tast(builtins.structs),
    );
    required_lower(
        lower(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::link_with_dependencies(builtins, Vec::from_array([prelude]), user),
                    ),
                ),
            ),
        ),
    )
}

fn lower_test_source(source: string, test_cases: Vec[(string, string, Vec[(string, string)])]) -> File {
    required_lower(
        lower_anf_tests_for_test(
            anf::lower(
                lift::lower(
                    mono::lower(
                        core::lower(
                            tast::check(hir::lower(ast::lower(parser::parse(source)), "main.gom")),
                        ),
                    ),
                ),
            ),
            test_cases,
        ),
    )
}

fn string_contains(value: string, expected: string) -> bool {
    value.contains(expected)
}

fn required_text_position(value: string, expected: string) -> isize {
    match text::find(value, expected) {
        Some(position) => position,
        None => {
            testing::fail("missing " + expected);
            -1
        },
    }
}

fn assert_appears_before(value: string, before: string, after: string) -> () {
    testing::assert(required_text_position(value, before) < required_text_position(value, after))
}

fn large_struct_source(body: string) -> string {
    let mut fields = "";
    let mut values = "";
    for index in 0..64 {
        let name = f"field{index}";
        fields += name + ": i32,";
        values += f"{name}: {index},";
    }
    "struct Large {" + fields + "} " + body + " fn main() -> () { let value = Large {" + values
        + "}; println(run(value, 1)); }"
}

fn string_struct_source(field_count: isize, body: string) -> string {
    let mut fields = "";
    let mut values = "";
    for index in 0..field_count {
        let name = f"field{index}";
        fields += name + ": string,";
        values += name + ": \"\",";
    }
    "struct Wide {" + fields + "} " + body + " fn main() -> () { let value = Wide {" + values
        + "}; println(run(value, 1)); }"
}

#[test]
fn passes_physically_large_struct_parameters_by_pointer() -> () {
    let output = encode(
        lower_source(
            string_struct_source(
                5,
                "fn run(value: Wide, depth: i32) -> i32 { if depth == 0 { value.field0.len() as i32 } else { run(value, depth - 1) } }",
            ),
        ),
    );
    testing::assert(string_contains(output, "func run(value__0 *Wide"))
}

#[test]
fn keeps_physically_small_struct_parameters_value_typed() -> () {
    let output = encode(
        lower_source(
            string_struct_source(
                4,
                "fn run(value: Wide, depth: i32) -> i32 { if depth == 0 { value.field0.len() as i32 } else { run(value, depth - 1) } }",
            ),
        ),
    );
    testing::assert(string_contains(output, "func run(value__0 Wide"))
}

#[test]
fn keeps_nine_word_struct_parameters_value_typed() -> () {
    let source = "struct Edge { a: isize, b: isize, c: isize, d: isize, e: isize, f: isize, g: isize, h: isize, i: isize } fn run(value: Edge, depth: isize) -> isize { if depth == 0 { value.a } else { run(value, depth - 1) } } fn main() -> () { let value = Edge { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9 }; println(run(value, 1)); }";
    testing::assert(encode(lower_source(source)).contains("func run(value__0 Edge"));
}

#[test]
fn passes_read_only_large_struct_parameters_by_pointer() -> () {
    let output = encode(
        lower_source(
            large_struct_source(
                "fn run(value: Large, depth: i32) -> i32 { if depth == 0 { value.field0 } else { run(value, depth - 1) } }",
            ),
        ),
    );
    testing::assert(string_contains(output, "func run(value__0 *Large"));
    testing::assert(string_contains(output, "run(value__0"));
    testing::assert(string_contains(output, "run(&value__2"))
}

#[test]
fn copies_mutated_large_struct_parameters_locally() -> () {
    let output = encode(
        lower_source(
            large_struct_source(
                "fn run(value: Large, depth: i32) -> i32 { value.field0 = depth; if depth == 0 { value.field0 } else { run(value, depth - 1) } }",
            ),
        ),
    );
    testing::assert(string_contains(output, "func run(value__0_pointer *Large"));
    testing::assert(string_contains(output, "var value__0 Large = *value__0_pointer"));
    testing::assert(string_contains(output, "run(&value__0"))
}

#[test]
fn keeps_escaped_large_struct_functions_value_typed() -> () {
    let output = encode(
        lower_source(
            large_struct_source(
                "fn read(value: Large, depth: i32) -> i32 { if depth == 0 { value.field0 } else { read(value, depth - 1) } } fn apply(function: (Large, i32) -> i32, value: Large, depth: i32) -> i32 { function(value, depth) } fn run(value: Large, depth: i32) -> i32 { apply(read, value, depth) }",
            ),
        ),
    );
    testing::assert(string_contains(output, "func read(value__0 Large"));
    testing::assert(!string_contains(output, "func read(value__0 *Large"))
}

#[test]
fn bounds_qualified_variant_names_after_qualification() -> () {
    let owner = "Option__(gomlc::ast::Path,Vec[gomlc::ast::TypeExpr])";
    testing::assert_eq(
        qualified_variant_go_name(owner, "None"),
        "_goml_m_Option_____o_gomlc_p_a_h6cc0136a7bfc53a6682c48309b51a455_Expr_r__q__None",
    );
    testing::assert_eq(
        qualified_variant_go_name(owner, "Some"),
        "_goml_m_Option_____o_gomlc_p_a_h820f68a828634622d946b6231c7d0ba1_Expr_r__q__Some",
    )
}

#[test]
fn emits_test_runner_entrypoint() -> () {
    let test_cases = Vec::new();
    test_cases.push(("example::alpha", "alpha", Vec::new()));
    test_cases.push(("example::beta", "beta", Vec::new()));
    let output = encode(
        lower_test_source("fn beta() -> () {} fn alpha() -> () {} fn unused() -> () {}", test_cases),
    );
    testing::assert(string_contains(output, "_goml_os \"os\""));
    testing::assert(string_contains(output, "switch _goml_os.Args[1]"));
    testing::assert(
        string_contains(
            output,
            \\case "example::alpha":
            \\        alpha()
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\case "example::beta":
            \\        beta()
            ,
        ),
    );
    testing::assert(
        string_contains(
            output,
            \\default:
            \\        _goml_runtime_std_testing_fail("unknown test id")
            ,
        ),
    );
    testing::assert(!string_contains(output, "func unused("))
}

#[test]
fn emits_parameterized_test_arguments() -> () {
    let test_cases = Vec::new();
    test_cases.push(
        (
            "example::parameterized::case_123",
            "parameterized",
            Vec::from_array([("string", "left"), ("bool", "true")]),
        ),
    );
    let output = encode(
        lower_test_source("fn parameterized(value: string, expected: bool) -> () {}", test_cases),
    );
    testing::assert(
        string_contains(
            output,
            \\case "example::parameterized::case_123":
            \\        parameterized("left", true)
            ,
        ),
    )
}

#[test]
fn emits_if_continuations() -> () {
    let source = "fn choose(flag: bool, x: i32, y: i32) -> i32 { if flag { x } else { y } } fn main() { let yes = choose(true, 10, 99); let no = choose(false, 10, 99); let _ = println(\"yes=\" + yes.to_string()); let _ = println(\"no=\" + no.to_string()); () }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\func main0() struct{} {
        \\    var yes__3 int32
        \\    var inline16 bool = true
        \\    var inline17 int32 = 10
        \\    var inline18 int32 = 99
        \\    if inline16 {
        \\        yes__3 = inline17
        \\    } else {
        \\        yes__3 = inline18
        \\    }
        \\    var no__4 int32
        \\    var inline12 bool = false
        \\    var inline13 int32 = 10
        \\    var inline14 int32 = 99
        \\    if inline12 {
        \\        no__4 = inline13
        \\    } else {
        \\        no__4 = inline14
        \\    }
        \\    var t7 string = _goml_m_inherent_i_i32_i_i32_i_to__string(yes__3)
        \\    var t8 string = "yes=" + t7
        \\    _goml_m_println(t8)
        \\    var t9 string = _goml_m_inherent_i_i32_i_i32_i_to__string(no__4)
        \\    var t10 string = "no=" + t9
        \\    _goml_m_println(t10)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

#[test]
fn emits_linked_bool_to_string_runtime() -> () {
    let output = encode(lower_linked_source("fn main() -> () { print(true) }"));
    testing::assert(
        string_contains(
            output,
            \\func _goml_runtime_core_bool_to_string(x bool) string {
            \\    if x {
            \\        return "true"
            \\    } else {
            \\        return "false"
            \\    }
            \\}
            ,
        ),
    );
    testing::assert(
        string_contains(output, "func _goml_m_trait__impl_i_ToString_i_bool_i_to__string"),
    )
}

fn required_runtime_key(hook: resources::RuntimeHook) -> string {
    match resources::runtime_abi_by_hook(hook) {
        Some(spec) => spec.key,
        None => {
            testing::fail("expected runtime ABI entry");
            ""
        },
    }
}

fn all_core_runtime_hooks() -> Vec[resources::RuntimeHook] {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    for spec in resources::runtime_abi_specs() {
        match spec.hook {
            Core(_) => hooks.push(spec.hook),
            Standard(_) => (),
        }
    }
    hooks
}

#[test]
fn emits_every_core_runtime_hook() -> () {
    let hooks = all_core_runtime_hooks();
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_math \"math\"\n" + "    _goml_os \"os\"\n" + ")",
        ),
    );
    for hook in hooks {
        testing::assert(
            string_contains(output, "func " + runtime_hook_name(required_runtime_key(hook)) + "("),
        )
    }
    testing::assert(!string_contains(output, "unicode/utf8"));
    testing::assert(string_contains(output, "return rune(s[i])"));
    testing::assert(string_contains(output, "return s[start:end]"));
    testing::assert(string_contains(output, "items: []byte(s),"));
    testing::assert(!string_contains(output, "strconv"));
    testing::assert(!string_contains(output, "fmt"));
    testing::assert(!string_contains(output, "strings"));
    testing::assert(string_contains(output, "return uint64(_goml_math.Float32bits(x))"));
    testing::assert(string_contains(output, "h = h * 1099511628211 + uint64(s[i])"))
}

fn all_standard_runtime_hooks() -> Vec[resources::RuntimeHook] {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    for spec in resources::runtime_abi_specs() {
        match spec.hook {
            Core(_) => (),
            Standard(_) => hooks.push(spec.hook),
        }
    }
    hooks
}

#[test]
fn emits_every_standard_runtime_hook() -> () {
    let hooks = all_standard_runtime_hooks();
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(
        string_contains(
            output,
            "import (\n" + "    _goml_fmt \"fmt\"\n" + "    _goml_debug \"runtime/debug\"\n"
                + "    _goml_net \"net\"\n"
                + "    _goml_tls \"crypto/tls\"\n"
                + "    _goml_x509 \"crypto/x509\"\n"
                + "    _goml_bytes \"bytes\"\n"
                + "    _goml_context \"context\"\n"
                + "    _goml_cryptorand \"crypto/rand\"\n"
                + "    _goml_errors \"errors\"\n"
                + "    _goml_hash \"hash\"\n"
                + "    _goml_io \"io\"\n"
                + "    _goml_math \"math\"\n"
                + "    _goml_os \"os\"\n"
                + "    _goml_exec \"os/exec\"\n"
                + "    _goml_filepath \"path/filepath\"\n"
                + "    _goml_sha256 \"crypto/sha256\"\n"
                + "    _goml_sync \"sync\"\n"
                + "    _goml_runtime_pkg \"runtime\"\n"
                + "    _goml_syscall \"syscall\"\n"
                + "    _goml_time \"time\"\n"
                + "    _goml_unsafe \"unsafe\"\n"
                + ")",
        ),
    );
    for hook in hooks {
        testing::assert(
            string_contains(output, "func " + runtime_hook_name(required_runtime_key(hook)) + "("),
        )
    }
    testing::assert(string_contains(output, "data, err = _goml_os.ReadFile(path)"));
    testing::assert(string_contains(output, "func _goml_runtime_error_kind(err error) int"));
    testing::assert(
        string_contains(output, "func _goml_runtime_error_raw_code(err error) (bool, int)"),
    );
    testing::assert(string_contains(output, "case _goml_syscall.Errno:"));
    testing::assert(string_contains(output, "if _goml_os.IsNotExist(err)"));
    testing::assert(string_contains(output, "if _goml_os.IsPermission(err)"));
    testing::assert(string_contains(output, "func _goml_runtime_std_fs_read_bytes_v2("));
    testing::assert(
        string_contains(output, "var err error = _goml_os.WriteFile(path, data.items, 0644)"),
    );
    testing::assert(string_contains(output, "var err error = _goml_os.MkdirAll(path, 0755)"));
    testing::assert(string_contains(output, "result, err = _goml_filepath.EvalSymlinks(absolute)"));
    testing::assert(string_contains(output, "names = append(names, entry.Name())"));
    testing::assert(string_contains(output, "file, err = _goml_os.Open(path)"));
    testing::assert(string_contains(output, "var digest _goml_hash.Hash = _goml_sha256.New()"));
    testing::assert(string_contains(output, "_, err = _goml_io.Copy(digest, file)"));
    testing::assert(string_contains(output, "var encoded []uint8 = make([]uint8, len(sum) * 2)"));
    testing::assert(string_contains(output, "_goml_os.Stderr.WriteString(value)"));
    testing::assert(string_contains(output, "data, err = _goml_io.ReadAll(_goml_os.Stdin)"));
    testing::assert(string_contains(output, "_, err = _goml_io.ReadFull(_goml_os.Stdin, data)"));
    testing::assert(string_contains(output, "return _goml_filepath.Join(base, child)"));
    testing::assert(string_contains(output, "base[0:len(base) - len(extension)]"));
    testing::assert(
        string_contains(
            output,
            "var cmd *_goml_exec.Cmd = _goml_exec.Command(program, arguments.items...)",
        ),
    );
    testing::assert(string_contains(output, "result, err = _goml_exec.LookPath(program)"));
    testing::assert(string_contains(output, "for _, entry := range environment.items"));
    testing::assert(string_contains(output, "_goml_os.Stderr.WriteString(message + \"\\n\")"));
    testing::assert(string_contains(output, "_goml_fmt.Sprint(recovered)"));
    testing::assert(string_contains(output, "_goml_debug.Stack()"));
    testing::assert(!string_contains(output, "\"strconv\""));
    testing::assert(!string_contains(output, "\"strings\""))
}

#[test]
fn closes_string_runtime_dependencies() -> () {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    hooks.push(resources::RuntimeHook::Core(resources::CoreRuntimeHook::StringGet));
    hooks.push(resources::RuntimeHook::Core(resources::CoreRuntimeHook::StringByteSlice));
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, hooks, Vec::new());
    let output = encode(File { items });
    testing::assert(string_contains(output, "func _goml_runtime_core_string_get("));
    testing::assert(string_contains(output, "func _goml_runtime_core_string_byte_slice("));
    testing::assert(!string_contains(output, "unicode/utf8"))
}

#[test]
fn imports_intrinsic_runtime_dependencies() -> () {
    let intrinsics: Vec[string] = Vec::new();
    intrinsics.push("ref.ptr_hash");
    intrinsics.push("vec.reserve");
    let items: Vec[Item] = Vec::new();
    emit_runtime_hook_items(items, Vec::new(), intrinsics);
    let output = encode(File { items });
    testing::assert(string_contains(output, "_goml_reflect \"reflect\""));
    testing::assert(!string_contains(output, "\"slices\""))
}

#[test]
fn prunes_imports_used_only_by_dead_helpers() -> () {
    let output = encode(
        lower_linked_source(
            "fn main() -> () { let cell = Ref::new(1); cell.set(cell.get() + 1); let values: Vec[i32] = Vec::new(); values.push(cell.get()); println(values.len()); }",
        ),
    );
    testing::assert(!string_contains(output, "_goml_reflect \"reflect\""))
}

#[test]
fn keeps_imports_used_by_reachable_types() -> () {
    let imports: Vec[(string, string)] = Vec::new();
    imports.push(("_goml_bytes", "bytes"));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "buffer",
            ty: Type::Named { name: "_goml_bytes.Buffer" },
            value: Option::None,
        },
    );
    let items: Vec[Item] = Vec::new();
    items.push(Item::ImportGroup(imports));
    items.push(
        Item::Function(
            Function {
                name: "main",
                params: Vec::new(),
                ret_ty: Option::None,
                body: Block { stmts },
            },
        ),
    );
    let output = encode(prune_functions(File { items }));
    testing::assert(string_contains(output, "_goml_bytes \"bytes\""))
}

#[test]
fn emits_complete_vec_runtime_helpers() -> () {
    let ty = repr::Type::VecType { elem: repr::Type::Int32 };
    let output = encode(File { items: vec_runtime_items(ty) });
    testing::assert(
        string_contains(output, "func vec_with_capacity__Vec_5int32(capacity int) *_goml_vec_int32"),
    );
    testing::assert(string_contains(output, "items: make([]int32, 0, capacity),"));
    testing::assert(
        string_contains(
            output,
            "func vec_reserve__Vec_5int32(vec *_goml_vec_int32, additional int) struct{}",
        ),
    );
    testing::assert(string_contains(output, "if additional < 0 {"));
    testing::assert(string_contains(output, "var required int = length + additional"));
    testing::assert(string_contains(output, "var next_capacity int = cap(vec.items) * 2"));
    testing::assert(
        string_contains(output, "var next_items []int32 = make([]int32, length, next_capacity)"),
    );
    testing::assert(string_contains(output, "copy(next_items, vec.items)"));
    testing::assert(string_contains(output, "clear(vec.items[new_len:int(len(vec.items))])"));
    testing::assert(string_contains(output, "vec.items = vec.items[0:new_len]"))
}

#[test]
fn stores_vec_from_array_header_and_items_together() -> () {
    let output = encode(
        lower_linked_source(
            "fn main() -> () { let values = Vec::from_array([1, 2]); let empty: Vec[isize] = Vec::new(); println(values.len() + empty.len()) }",
        ),
    );
    testing::assert(string_contains(output, "var storage struct {"));
    testing::assert(string_contains(output, "vector _goml_vec_int"));
    testing::assert(string_contains(output, "values [2]int"));
    testing::assert(
        string_contains(output, "storage.vector.items = storage.values[0:len(storage.values)]"),
    );
    testing::assert(string_contains(output, "return &storage.vector"));
    testing::assert(!string_contains(output, "values [0]int"))
}

#[test]
fn builds_hashmap_array_literals_directly() -> () {
    let output = encode(
        lower_linked_source(
            "fn main() -> () { let values = HashMap::from_array([(\"a\", 1), (\"b\", 2)]); println(values.len()) }",
        ),
