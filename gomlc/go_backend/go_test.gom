#[test]
fn preserves_user_struct_order_before_closure_environments() -> () {
    let source = "struct GomlInherentClosureEnvF0ClosureEnvF0Apply { value: i32, } fn main() -> () { let y = 1; let f = |x: i32| x + y; let c = GomlInherentClosureEnvF0ClosureEnvF0Apply { value: 2 }; println((f(3) + c.value).to_string()) }";
    let output = encode(lower_source(source));
    assert_appears_before(
        output,
        "type GomlInherentClosureEnvF0ClosureEnvF0Apply struct",
        "type closure_env_f_0 struct",
    );
    testing::assert(
        string_contains(
            output,
            "func _goml_m_inherent_i_closure__env__f__0_i_closure__env__f__0_i_apply(",
        ),
    )
}

#[test]
fn hashes_and_compacts_long_go_identifiers() -> () {
    testing::assert_eq(hash::sha256_prefix("abc"), "ba7816bf8f01cfea414140de5dae2223");
    testing::assert_eq(
        hash::sha256_hex("abc"),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
    );
    testing::assert_eq(
        go_ident("inherent#closure_env_grow_T_int32_0#closure_env_grow_T_int32_0#apply"),
        "_goml_m_inherent_i_closure__en_hc8c2267ce73456d4efdb3aa5198c65a2_nt32__0_i_apply",
    )
}

#[test]
fn mangles_unicode_identifiers_without_byte_indexing() -> () {
    testing::assert(!is_valid_ident("变量"));
    testing::assert_eq(go_ident("a::b"), "_goml_m_a_p_b");
    testing::assert_eq(go_local_ident("包/变量"), go_ident("包__变量"))
}

#[test]
fn emits_structs_before_generic_enums() -> () {
    let source = "fn build() -> Option[() -> i32] { let _: Option[i32] = Option::Some(1); Option::Some(|| 1) } fn main() -> () { match build() { Option::Some(f) => println(f()), Option::None => println(0), } }";
    let output = encode(lower_source(source));
    assert_appears_before(
        output,
        "type closure_env_build_0 struct",
        "type _goml_m_Option_____o__q__m__z_i32 struct",
    );
    testing::assert(string_contains(output, "type Option__i32 uint64"));
    testing::assert(!string_contains(output, "type Option__i32 interface"));
    testing::assert(string_contains(output, "var inline19 func() int32 = func() int32"))
}

#[test]
fn preserves_enums_before_field_instances() -> () {
    let output = encode(
        lower_source(
            "enum Expr { Num(i32), Add(Option[Expr]), } fn main() -> () { let value: Option[Expr] = Option::None; match value { Option::Some(_) => (), Option::None => (), }; }",
        ),
    );
    let prefix =
        \\package main
        \\
        \\type Expr struct {
        \\    _node *Expr_node
        \\}
    ;
    testing::assert_eq(output.byte_slice(0, prefix.byte_len()), prefix);
    testing::assert(string_contains(output, "type Option__Expr struct"));
    testing::assert(!string_contains(output, "type Option__Expr interface"))
}

#[test]
fn protects_dyn_object_names_from_vtable_collisions() -> () {
    let source = "trait A { fn f(self: Self) -> i32; } trait A_vtable { fn g(self: Self) -> i32; } struct S {} impl A for S { fn f(self: S) -> i32 { 3 } } impl A_vtable for S { fn g(self: S) -> i32 { 4 } } fn main() -> () { let left: dyn A = (S {}) as dyn A; let right: dyn A_vtable = (S {}) as dyn A_vtable; println(A::f(left) + A_vtable::g(right)); }";
    testing::assert_eq(
        encode(lower_source(source)),
        \\package main
        \\
        \\type S struct {}
        \\
        \\type dyn__A_vtable struct {
        \\    f func(any) int32
        \\}
        \\
        \\type dyn__A struct {
        \\    data any
        \\    vtable *dyn__A_vtable
        \\}
        \\
        \\type dyn__A_vtable_vtable struct {
        \\    g func(any) int32
        \\}
        \\
        \\type _goml_dyn_object_A_vtable struct {
        \\    data any
        \\    vtable *dyn__A_vtable_vtable
        \\}
        \\
        \\func dyn__A__wrap__S__f(self any) int32 {
        \\    return _goml_m_trait__impl_i_A_i_S_i_f(self.(S))
        \\}
        \\
        \\func dyn__A__vtable__S() *dyn__A_vtable {
        \\    return &dyn__A_vtable{
        \\        f: dyn__A__wrap__S__f,
        \\    }
        \\}
        \\
        \\func dyn__A_vtable__wrap__S__g(self any) int32 {
        \\    return _goml_m_trait__impl_i_A__vtable_i_S_i_g(self.(S))
        \\}
        \\
        \\func dyn__A_vtable__vtable__S() *dyn__A_vtable_vtable {
        \\    return &dyn__A_vtable_vtable{
        \\        g: dyn__A_vtable__wrap__S__g,
        \\    }
        \\}
        \\
        \\func _goml_m_trait__impl_i_A_i_S_i_f(self__0 S) int32 {
        \\    return 3
        \\}
        \\
        \\func _goml_m_trait__impl_i_A__vtable_i_S_i_g(self__1 S) int32 {
        \\    return 4
        \\}
        \\
        \\func main0() struct{} {
        \\    var t6 S = S{}
        \\    var left__2 dyn__A = dyn__A{
        \\        data: t6,
        \\        vtable: dyn__A__vtable__S(),
        \\    }
        \\    var t7 S = S{}
        \\    var right__3 _goml_dyn_object_A_vtable = _goml_dyn_object_A_vtable{
        \\        data: t7,
        \\        vtable: dyn__A_vtable__vtable__S(),
        \\    }
        \\    var t8 int32 = left__2.vtable.f(left__2.data)
        \\    var t9 int32 = right__3.vtable.g(right__3.data)
        \\    var t10 int32 = t8 + t9
        \\    _goml_m_println(t10)
        \\    return struct{}{}
        \\}
        \\
        \\func main() {
        \\    main0()
        \\}
        \\
        ,
    )
}

