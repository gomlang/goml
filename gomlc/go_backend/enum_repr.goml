package go_backend;

use module::go_ir::{Type, BinaryOp, Expr};
use module::go_types;
use module::go_types::{go_generated_ident, go_user_type_name, lower_type};
use module::repr;
use module::tast;

pub fn enum_pack_helper_name(owner_name: string) -> string {
    go_generated_ident("_goml_enum_pack_" + go_user_type_name(owner_name))
}

pub fn enum_node_tag_helper_name(owner_name: string) -> string {
    go_generated_ident("_goml_enum_tag_" + go_user_type_name(owner_name))
}

pub fn enum_zero_expr(value: repr::Type) -> Expr {
    match repr::resolve_type(value) {
        Unit | Never => Expr::Unit,
        Array { len: _, elem: _ } => ArrayLiteral { ty: lower_type(value), items: Vec::new() },
        _ => StructLiteral { ty: lower_type(value), fields: Vec::new() },
    }
}

fn enum_packed_unsigned_type(value: repr::Type) -> Type {
    match repr::resolve_type(value) {
        Int8 | Uint8 => Uint8,
        Int16 | Uint16 => Uint16,
        Int32 | Uint32 | Char => Uint32,
        _ => lower_type(value),
    }
}

fn enum_packed_signed_type(value: repr::Type) -> Option[(Type, string)] {
    match repr::resolve_type(value) {
        Int8 => Some((Type::Int16, "128")),
        Int16 => Some((Type::Int32, "32768")),
        Int32 => Some((Type::Int64, "2147483648")),
        _ => None,
    }
}

pub fn enum_packed_value_expr(
    owner: EnumInfo,
    owner_ty: repr::Type,
    payload_ty: repr::Type,
    value: Expr,
) -> Expr {
    match repr::resolve_type(payload_ty) {
        Bool => Call {
            func: Expr::Var { name: enum_pack_helper_name(owner.owner_name) },
            args: Vec::from_array([value]),
        },
        _ => {
            let encoded = match enum_packed_signed_type(payload_ty) {
                Some(value_info) => Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Convert { ty: value_info.0, expr: value },
                    rhs: Expr::Int { value: value_info.1 },
                },
                None => Expr::Convert { ty: enum_packed_unsigned_type(payload_ty), expr: value },
            };
            Convert {
                ty: lower_type(owner_ty),
                expr: Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Convert { ty: owner.tag_ty, expr: encoded },
                    rhs: Expr::Int { value: "1" },
                },
            }
        },
    }
}

pub fn enum_packed_payload_expr(owner: EnumInfo, value: Expr) -> Expr {
    let payload_ty = owner.payload_ty.unwrap_or(repr::Type::Unit);
    match repr::resolve_type(payload_ty) {
        Bool => Binary {
            op: BinaryOp::Eq,
            lhs: value,
            rhs: Expr::Convert {
                ty: Type::Named { name: go_user_type_name(owner.owner_name) },
                expr: Expr::Int { value: "2" },
            },
        },
        _ => {
            let decoded = Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Convert { ty: owner.tag_ty, expr: value },
                rhs: Expr::Int { value: "1" },
            };
            match enum_packed_signed_type(payload_ty) {
                Some(value_info) => Convert {
                    ty: lower_type(payload_ty),
                    expr: Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: Expr::Convert { ty: value_info.0, expr: decoded },
                        rhs: Expr::Int { value: value_info.1 },
                    },
                },
                None => Convert { ty: lower_type(payload_ty), expr: decoded },
            }
        },
    }
}

pub fn plan_variant_infos(
    builtin: tast::BuiltinContract,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> VariantInfos {
    go_types::plan_variant_infos(
        builtin,
        enums,
        structs,
        instances,
        |owner, variant| concrete_variant_go_name(owner, variant, enums, function_names),
    )
}

pub fn enum_tag_type(count: isize) -> Type {
    go_types::enum_tag_type(count)
}

pub fn enum_storage_is_direct(value: EnumStorage) -> bool {
    go_types::enum_storage_is_direct(value)
}

pub fn enum_type_is_zero_sized(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
) -> bool {
    go_types::enum_type_is_zero_sized(value, structs, variants)
}

pub fn enum_type_layout(
    value: repr::Type,
    structs: Vec[repr::StructDef],
    variants: VariantInfos,
    depth: isize,
) -> go_types::EnumLayout {
    go_types::enum_type_layout(value, structs, variants, depth)
}

pub fn enum_info_placeholder(definition: repr::EnumDef, storage: EnumStorage) -> EnumInfo {
    go_types::enum_info_placeholder(definition, storage)
}

pub fn find_enum_info(variants: VariantInfos, owner_ty: repr::Type) -> Option[EnumInfo] {
    go_types::find_enum_info(variants, owner_ty)
}

pub fn find_enum(values: Vec[repr::EnumDef], name: string) -> Option[repr::EnumDef] {
    go_types::find_enum(values, name)
}

pub fn find_struct(values: Vec[repr::StructDef], name: string) -> Option[repr::StructDef] {
    go_types::find_struct(values, name)
}

pub fn instance_by_name(values: Vec[repr::TypeInstance], name: string) -> Option[repr::TypeInstance] {
    go_types::instance_by_name(values, name)
}

pub fn builtin_sum_enum(
    builtin: tast::BuiltinContract,
    definition: repr::EnumDef,
    instances: Vec[repr::TypeInstance],
) -> bool {
    go_types::builtin_sum_enum(builtin, definition, instances)
}

pub fn enum_field_types(value: repr::EnumVariantFields) -> Vec[repr::Type] {
    go_types::enum_field_types(value)
}
