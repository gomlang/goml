package go_backend;

use module::anf;

enum JoinScope {
    Root(Vec[anf::JoinBind]),
    Nested {
        parent: JoinScope,
        joins: Vec[anf::JoinBind],
    },
}

fn scoped_joins(parent: JoinScope, value: anf::Block) -> JoinScope {
    let joins: Vec[anf::JoinBind] = Vec::new();
    for bind in value.binds {
        match bind {
            Join(join) => joins.push(join),
            JoinRec(values) => {
                for join in values {
                    joins.push(join)
                }
            },
            Let(_) => (),
        }
    }
    if joins.is_empty() {
        parent
    } else {
        JoinScope::Nested { parent, joins }
    }
}

fn find_scoped_join(scope: JoinScope, name: string) -> Option[anf::JoinBind] {
    let mut current = scope;
    loop {
        match current {
            Root(joins) => return find_join(joins, name),
            Nested { parent, joins } => {
                if let Some(join) = find_join(joins, name) {
                    return Option::Some(join)
                }
                current = parent;
            },
        }
    }
}
