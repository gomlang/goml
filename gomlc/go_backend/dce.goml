package go_backend;

use module::go_ir::{BinaryOp, Expr, Block, SwitchCase, TypeSwitchCase, SelectOperation, SelectCase, Stmt};
use std::collections;

type DceNames = collections::IndexSet[string];

struct DceJumpTarget {
    label: string,
    break_live: DceNames,
    continue_live: Option[DceNames],
}

struct DceResult {
    block: Block,
    live: DceNames,
    needs_decl: DceNames,
}

fn new_dce_names() -> DceNames {
    collections::IndexSet::new()
}

fn add_name(values: DceNames, value: string) -> () {
    let _ = values.insert(value);
}

fn add_names(target: DceNames, values: DceNames) -> () {
    for value in values {
        add_name(target, value)
    }
}

fn copy_names(values: DceNames) -> DceNames {
    let result = collections::IndexSet::with_capacity(values.len());
    add_names(result, values);
    result
}

fn remove_name(values: DceNames, expected: string) -> () {
    let _ = values.remove(expected);
}

fn add_expr_uses(values: DceNames, value: Expr) -> () {
    match value {
        Var { name } => add_name(values, name),
        Call { func, args } => {
            add_expr_uses(values, func);
            for arg in args {
                add_expr_uses(values, arg)
            }
        },
        Instantiate { expr, .. } => add_expr_uses(values, expr),
        CallSpread { func, args, spread } => {
            add_expr_uses(values, func);
            for arg in args {
                add_expr_uses(values, arg);
            }
            add_expr_uses(values, spread);
        },
        Unary { op: _, expr } => add_expr_uses(values, expr),
        Binary { op: _, lhs, rhs } => {
            add_expr_uses(values, lhs);
            add_expr_uses(values, rhs)
        },
        Field { expr, field_name: _ } => add_expr_uses(values, expr),
        Index { base: expr, index } => {
            add_expr_uses(values, expr);
            add_expr_uses(values, index)
        },
        Slice { base: expr, start, end } => {
            add_expr_uses(values, expr);
            add_expr_uses(values, start);
            add_expr_uses(values, end)
        },
        Cast { expr, ty: _ } | Convert { ty: _, expr } => add_expr_uses(values, expr),
        Make { ty: _, args } => {
            for arg in args {
                add_expr_uses(values, arg)
            }
        },
        Send { channel, value } => {
            add_expr_uses(values, channel);
            add_expr_uses(values, value)
        },
        Receive { channel } => add_expr_uses(values, channel),
        StructLiteral { ty: _, fields } => {
            for field in fields {
                add_expr_uses(values, field.1)
            }
        },
        ArrayLiteral { ty: _, items } => {
            for item in items {
                add_expr_uses(values, item)
            }
        },
        FuncLit { params, ret_ty: _, body } => {
            let uses = new_dce_names();
            add_block_uses(uses, body);
            for param in params {
                remove_name(uses, param.0)
            }
            add_names(values, uses)
        },
        MethodExpression { .. } | Expr::Nil | Unit | Bool { value: _ } | Int { value: _ } | Float {
            value: _,
        } | String { value: _ } => (),
    }
}

fn add_stmt_uses(values: DceNames, value: Stmt) -> () {
    match value {
        Expr { expr } | Go { call: expr } | Defer { call: expr } => add_expr_uses(values, expr),
        Var { name: _, ty: _, value: initial } => if let Some(expr) = initial {
            add_expr_uses(values, expr)
        },
        Assign { name: _, value: expr } => add_expr_uses(values, expr),
        FieldAssign { target, field_name: _, value: expr } => {
            add_expr_uses(values, target);
            add_expr_uses(values, expr)
        },
        IndexAssign { base: target, index, value: expr } => {
            add_expr_uses(values, target);
            add_expr_uses(values, index);
            add_expr_uses(values, expr)
        },
        MultiAssign { names: _, value: expr } => add_expr_uses(values, expr),
        Return { expr } => if let Some(expr) = expr {
            add_expr_uses(values, expr)
        },
        ReturnMulti { exprs } => {
            for expr in exprs {
                add_expr_uses(values, expr)
            }
        },
        If { cond, then_, else_ } => {
            add_expr_uses(values, cond);
            add_block_uses(values, then_);
            if let Some(body) = else_ {
                add_block_uses(values, body)
            }
        },
        Loop { body } | LabeledLoop { label: _, body } => add_block_uses(values, body),
        Range { names, expr, body } => {
            add_expr_uses(values, expr);
            let body_uses = new_dce_names();
            add_block_uses(body_uses, body);
            for name in names {
                remove_name(body_uses, name)
            }
            add_names(values, body_uses)
        },
        Switch { expr, cases, default } => {
            add_expr_uses(values, expr);
            for case in cases {
                add_expr_uses(values, case.value);
                add_block_uses(values, case.body)
            }
            if let Some(body) = default {
                add_block_uses(values, body)
            }
        },
        TypeSwitch { binding: bind, expr, cases, default } => {
            add_expr_uses(values, expr);
            let body_uses = new_dce_names();
            for case in cases {
                add_block_uses(body_uses, case.body)
            }
            if let Some(body) = default {
                add_block_uses(body_uses, body)
            }
            if let Some(name) = bind {
                remove_name(body_uses, name)
            }
            add_names(values, body_uses)
        },
        Select { cases, default } => {
            for case in cases {
                match case.operation {
                    Receive { names, channel } => {
                        add_expr_uses(values, channel);
                        let body_uses = new_dce_names();
                        add_block_uses(body_uses, case.body);
                        for name in names {
                            remove_name(body_uses, name)
                        }
                        add_names(values, body_uses)
                    },
                    Send { channel, value } => {
                        add_expr_uses(values, channel);
                        add_expr_uses(values, value);
                        add_block_uses(values, case.body)
                    },
                }
            }
            if let Some(body) = default {
                add_block_uses(values, body)
            }
        },
        Break | BreakLabel { label: _ } | Continue | ContinueLabel { label: _ } | Panic {
            message: _,
        } | Unreachable => (),
    }
}

fn add_block_uses(values: DceNames, value: Block) -> () {
    for stmt in value.stmts {
        add_stmt_uses(values, stmt)
    }
}

fn free_vars_in_block(value: Block) -> DceNames {
    let used = new_dce_names();
    let declared = new_dce_names();
    for stmt in value.stmts {
        match stmt {
            Var { name, .. } => {
                add_name(declared, name);
                add_stmt_uses(used, stmt)
            },
            If { cond, then_, else_ } => {
                add_expr_uses(used, cond);
                add_names(used, free_vars_in_block(then_));
                if let Some(body) = else_ {
                    add_names(used, free_vars_in_block(body))
                }
            },
            Loop { body } | LabeledLoop { label: _, body } => {
                add_names(used, free_vars_in_block(body))
            },
            Range { names, expr, body } => {
                add_expr_uses(used, expr);
                let body_uses = free_vars_in_block(body);
                for name in names {
                    remove_name(body_uses, name)
                }
                add_names(used, body_uses)
            },
            Switch { expr, cases, default } => {
                add_expr_uses(used, expr);
                for case in cases {
                    add_expr_uses(used, case.value);
                    add_names(used, free_vars_in_block(case.body))
                }
                if let Some(body) = default {
                    add_names(used, free_vars_in_block(body))
                }
            },
            TypeSwitch { binding: bind, expr, cases, default } => {
                add_expr_uses(used, expr);
                for case in cases {
                    let case_uses = free_vars_in_block(case.body);
                    if let Some(name) = bind {
                        remove_name(case_uses, name)
                    }
                    add_names(used, case_uses)
                }
                if let Some(body) = default {
                    let default_uses = free_vars_in_block(body);
                    if let Some(name) = bind {
                        remove_name(default_uses, name)
                    }
                    add_names(used, default_uses)
                }
            },
            Select { cases, default } => {
                for case in cases {
                    let case_uses = free_vars_in_block(case.body);
                    match case.operation {
                        Receive { names, channel } => {
                            add_expr_uses(used, channel);
                            for name in names {
                                remove_name(case_uses, name)
                            }
                        },
                        Send { channel, value } => {
                            add_expr_uses(used, channel);
                            add_expr_uses(used, value)
                        },
                    }
                    add_names(used, case_uses)
                }
                if let Some(body) = default {
                    add_names(used, free_vars_in_block(body))
                }
            },
            _ => add_stmt_uses(used, stmt),
        }
    }
    for name in declared {
        remove_name(used, name)
    }
    used
}

fn call_result_must_be_used(value: Expr) -> bool {
    match value {
        Var { name } => {
            name == "append" || name == "cap" || name == "complex" || name == "imag"
                || name == "len"
                || name == "make"
                || name == "max"
                || name == "min"
                || name == "new"
                || name == "real"
                || name == "bool"
                || name == "byte"
                || name == "rune"
                || name == "string"
                || name == "int"
                || name == "int8"
                || name == "int16"
                || name == "int32"
                || name == "int64"
                || name == "uint"
                || name == "uint8"
                || name == "uint16"
                || name == "uint32"
                || name == "uint64"
                || name == "uintptr"
                || name == "float32"
                || name == "float64"
                || name == "complex64"
                || name == "complex128"
        },
        _ => false,
    }
}

fn append_call(value: Expr) -> bool {
    match value {
        Var { name } => name == "append",
        _ => false,
    }
}

fn append_target(values: Vec[Expr]) -> Option[string] {
    if !values.is_empty() {
        match values[0] {
            Var { name } => Some(name),
            _ => None,
        }
    } else {
        None
    }
}

fn emit_side_effect(value: Expr) -> Stmt {
    match value {
        Call { func, args } | CallSpread { func, args, .. } => if append_call(func) {
            Assign { name: append_target(args).unwrap_or("_"), value }
        } else if call_result_must_be_used(func) {
            Assign { name: "_", value }
        } else {
            Stmt::Expr { expr: value }
        },
        _ => Assign { name: "_", value },
    }
}

fn binary_may_panic(value: BinaryOp) -> bool {
    match value {
        Div | Rem | Shl | Shr => true,
        Add | Sub | Mul | BitAnd | BitOr | BitXor | Less | Greater | LessEq | GreaterEq | Eq | NotEq | And | Or => false,
    }
}

fn exprs_have_side_effects(values: Vec[Expr]) -> bool {
    for value in values {
        if expr_has_side_effects(value) {
            return true
        }
    }
    false
}

fn expr_has_side_effects(value: Expr) -> bool {
    match value {
        Call { func, args } => {
            exprs_have_side_effects(args) || append_call(func) || !call_result_must_be_used(func)
        },
        Instantiate { expr, .. } => expr_has_side_effects(expr),
        CallSpread { func, args, spread } => {
            exprs_have_side_effects(args) || expr_has_side_effects(spread) || append_call(func)
                || !call_result_must_be_used(func)
        },
        Unary { op: _, expr } => expr_has_side_effects(expr),
        Binary { op, lhs, rhs } => {
            binary_may_panic(op) || expr_has_side_effects(lhs) || expr_has_side_effects(rhs)
        },
        Field { expr, field_name: _ } => expr_has_side_effects(expr),
        Index { base: _, index: _ } | Slice { base: _, start: _, end: _ } => true,
        Cast { expr, ty: _ } | Convert { ty: _, expr } => expr_has_side_effects(expr),
        Make { args, .. } => exprs_have_side_effects(args),
        Send { channel: _, value: _ } | Receive { channel: _ } => true,
        StructLiteral { ty: _, fields } => {
            for field in fields {
                if expr_has_side_effects(field.1) {
                    return true
                }
            }
            false
        },
        ArrayLiteral { items, .. } => exprs_have_side_effects(items),
        FuncLit { params: _, ret_ty: _, body: _ } => false,
        MethodExpression { .. } | Expr::Nil | Unit | Var { name: _ } | Bool { value: _ } | Int {
            value: _,
        } | Float { value: _ } | String { value: _ } => false,
    }
}

fn reversed(values: Vec[Stmt]) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        result.push(values[values.len() - index - 1])
    }
    result
}

fn retain_side_effect(output: Vec[Stmt], live: DceNames, value: Expr) -> () {
    if expr_has_side_effects(value) {
        add_expr_uses(live, value);
        output.push(emit_side_effect(value))
    }
}

fn push_dce_jump_target(
    targets: Vec[DceJumpTarget],
    label: string,
    break_live: DceNames,
    continue_live: Option[DceNames],
) -> () {
    targets.push(DceJumpTarget { label, break_live: copy_names(break_live), continue_live });
}

fn restore_dce_jump_live(
    live: DceNames,
    targets: Vec[DceJumpTarget],
    label: string,
    is_continue: bool,
) -> () {
    for index in 0..targets.len() {
        let target = targets[targets.len() - index - 1];
        if label != "" && target.label != label {
            continue;
        }
        if is_continue {
            if let Some(header_live) = target.continue_live {
                add_names(live, header_live);
                return
            }
        } else {
            add_names(live, target.break_live);
            return
        }
    }
}

fn dce_block_with_live(value: Block, live_out: DceNames, targets: Vec[DceJumpTarget]) -> DceResult {
    let live = copy_names(live_out);
    let needs_decl = new_dce_names();
    let output: Vec[Stmt] = Vec::with_capacity(value.stmts.len());
    let mut index = value.stmts.len();
    while index > 0 {
        index -= 1;
        match value.stmts[index] {
            Expr { expr } => {
                if expr_has_side_effects(expr) {
                    add_expr_uses(live, expr);
                    output.push(Stmt::Expr { expr })
                }
            },
            Go { call: expr } => {
                add_expr_uses(live, expr);
                output.push(Stmt::Go { call: expr })
            },
            Defer { call: expr } => {
                add_expr_uses(live, expr);
                output.push(Stmt::Defer { call: expr })
            },
            Var { name, ty, value: initial } => {
                if live.contains(name) {
                    remove_name(live, name);
                    remove_name(needs_decl, name);
                    if let Some(expr) = initial {
                        add_expr_uses(live, expr)
                    }
                    output.push(Stmt::Var { name, ty, value: initial })
                } else {
                    if let Some(expr) = initial {
                        retain_side_effect(output, live, expr)
                    }
                    if needs_decl.contains(name) {
                        remove_name(needs_decl, name);
                        output.push(Stmt::Var { name, ty, value: Option::None })
                    }
                }
            },
            Assign { name, value: expr } => {
                if name == "_" || live.contains(name) {
                    remove_name(live, name);
                    add_expr_uses(live, expr);
                    add_name(needs_decl, name);
                    output.push(Stmt::Assign { name, value: expr })
                } else {
                    retain_side_effect(output, live, expr)
                }
            },
            FieldAssign { target, field_name: field, value: expr } => {
                add_expr_uses(live, target);
                add_expr_uses(live, expr);
                output.push(Stmt::FieldAssign { target, field_name: field, value: expr })
            },
            IndexAssign { base: target, index: target_index, value: expr } => {
                add_expr_uses(live, target);
                add_expr_uses(live, target_index);
                add_expr_uses(live, expr);
                output.push(Stmt::IndexAssign { base: target, index: target_index, value: expr })
            },
            MultiAssign { names, value: expr } => {
                for name in names {
                    remove_name(live, name);
                    add_name(needs_decl, name)
                }
                add_expr_uses(live, expr);
                output.push(Stmt::MultiAssign { names, value: expr })
            },
            Return { expr } => {
                if let Some(value) = expr {
                    add_expr_uses(live, value)
                }
                output.push(Stmt::Return { expr })
            },
            ReturnMulti { exprs } => {
                for expr in exprs {
                    add_expr_uses(live, expr)
                }
                output.push(Stmt::ReturnMulti { exprs })
            },
            If { cond, then_, else_ } => {
                let then_result = dce_block_with_live(then_, live, targets);
                let lowered_else = match else_ {
                    Some(body) => {
                        let result = dce_block_with_live(body, live, targets);
                        add_names(live, result.live);
                        add_names(needs_decl, result.needs_decl);
                        Option::Some(result.block)
                    },
                    None => Option::None,
                };
                add_names(live, then_result.live);
                add_names(needs_decl, then_result.needs_decl);
                add_expr_uses(live, cond);
                output.push(Stmt::If { cond, then_: then_result.block, else_: lowered_else })
            },
            Loop { body } => {
                let loop_live = copy_names(live);
                add_names(loop_live, free_vars_in_block(body));
                push_dce_jump_target(targets, "", live, Some(loop_live));
                let result = dce_block_with_live(body, loop_live, targets);
                let _ = targets.remove(targets.len() - 1);
                add_names(live, result.live);
                add_names(needs_decl, result.needs_decl);
                output.push(Stmt::Loop { body: result.block })
            },
            LabeledLoop { label, body } => {
                let loop_live = copy_names(live);
                add_names(loop_live, free_vars_in_block(body));
                push_dce_jump_target(targets, label, live, Some(loop_live));
                let result = dce_block_with_live(body, loop_live, targets);
                let _ = targets.remove(targets.len() - 1);
                add_names(live, result.live);
                add_names(needs_decl, result.needs_decl);
                output.push(Stmt::LabeledLoop { label, body: result.block })
            },
            Range { names, expr, body } => {
                let loop_live = copy_names(live);
                let body_uses = free_vars_in_block(body);
                for name in names {
                    remove_name(body_uses, name)
                }
                add_names(loop_live, body_uses);
                push_dce_jump_target(targets, "", live, Some(loop_live));
                let result = dce_block_with_live(body, loop_live, targets);
                let _ = targets.remove(targets.len() - 1);
                for name in names {
                    remove_name(result.live, name);
                    remove_name(result.needs_decl, name)
                }
                add_names(live, result.live);
                add_names(needs_decl, result.needs_decl);
                add_expr_uses(live, expr);
                output.push(Stmt::Range { names, expr, body: result.block })
            },
            Break => {
                restore_dce_jump_live(live, targets, "", false);
                output.push(Stmt::Break)
            },
            BreakLabel { label } => {
                restore_dce_jump_live(live, targets, label, false);
                output.push(Stmt::BreakLabel { label })
            },
            Continue => {
                restore_dce_jump_live(live, targets, "", true);
                output.push(Stmt::Continue)
            },
            ContinueLabel { label } => {
                restore_dce_jump_live(live, targets, label, true);
                output.push(Stmt::ContinueLabel { label })
            },
            Switch { expr, cases, default } => {
                push_dce_jump_target(targets, "", live, None);
                let lowered_cases: Vec[SwitchCase] = Vec::with_capacity(cases.len());
                for case in cases {
                    let result = dce_block_with_live(case.body, live, targets);
                    add_expr_uses(live, case.value);
                    add_names(live, result.live);
                    add_names(needs_decl, result.needs_decl);
                    lowered_cases.push(SwitchCase { value: case.value, body: result.block })
                }
                let lowered_default = match default {
                    Some(body) => {
                        let result = dce_block_with_live(body, live, targets);
                        add_names(live, result.live);
                        add_names(needs_decl, result.needs_decl);
                        Option::Some(result.block)
                    },
                    None => Option::None,
                };
                add_expr_uses(live, expr);
                let _ = targets.remove(targets.len() - 1);
                output.push(Stmt::Switch { expr, cases: lowered_cases, default: lowered_default })
            },
            TypeSwitch { binding: bind, expr, cases, default } => {
                push_dce_jump_target(targets, "", live, None);
                let lowered_cases: Vec[TypeSwitchCase] = Vec::with_capacity(cases.len());
                for case in cases {
                    let result = dce_block_with_live(case.body, live, targets);
                    if let Some(name) = bind {
                        remove_name(result.live, name);
                        remove_name(result.needs_decl, name)
                    }
                    add_names(live, result.live);
                    add_names(needs_decl, result.needs_decl);
                    lowered_cases.push(TypeSwitchCase { ty: case.ty, body: result.block })
                }
                let lowered_default = match default {
                    Some(body) => {
                        let result = dce_block_with_live(body, live, targets);
                        if let Some(name) = bind {
                            remove_name(result.live, name);
                            remove_name(result.needs_decl, name)
                        }
                        add_names(live, result.live);
                        add_names(needs_decl, result.needs_decl);
                        Option::Some(result.block)
                    },
                    None => Option::None,
                };
                add_expr_uses(live, expr);
                let _ = targets.remove(targets.len() - 1);
                output.push(
                    TypeSwitch {
                        binding: bind,
                        expr,
                        cases: lowered_cases,
                        default: lowered_default,
                    },
                )
            },
            Select { cases, default } => {
                push_dce_jump_target(targets, "", live, None);
                let lowered_cases: Vec[SelectCase] = Vec::with_capacity(cases.len());
                for case in cases {
                    let result = dce_block_with_live(case.body, live, targets);
                    let operation = match case.operation {
                        Receive { names, channel } => {
                            let lowered_names: Vec[string] = Vec::with_capacity(names.len());
                            for name in names {
                                if result.live.contains(name) {
                                    lowered_names.push(name);
                                    add_name(needs_decl, name)
                                } else {
                                    lowered_names.push("_")
                                }
                                remove_name(result.live, name);
                                remove_name(result.needs_decl, name)
                            }
                            add_expr_uses(live, channel);
                            SelectOperation::Receive { names: lowered_names, channel }
                        },
                        Send { channel, value } => {
                            add_expr_uses(live, channel);
                            add_expr_uses(live, value);
                            SelectOperation::Send { channel, value }
                        },
                    };
                    add_names(live, result.live);
                    add_names(needs_decl, result.needs_decl);
                    lowered_cases.push(SelectCase { operation, body: result.block })
                }
                let lowered_default = match default {
                    Some(body) => {
                        let result = dce_block_with_live(body, live, targets);
                        add_names(live, result.live);
                        add_names(needs_decl, result.needs_decl);
                        Option::Some(result.block)
                    },
                    None => Option::None,
                };
                let _ = targets.remove(targets.len() - 1);
                output.push(Stmt::Select { cases: lowered_cases, default: lowered_default })
            },
            Panic { message } => output.push(Stmt::Panic { message }),
            Unreachable => output.push(Stmt::Unreachable),
        }
    }
    DceResult { block: Block { stmts: reversed(output) }, live, needs_decl }
}

pub fn eliminate_dead_vars(value: Block) -> Block {
    let live = new_dce_names();
    dce_block_with_live(value, live, Vec::new()).block
}
