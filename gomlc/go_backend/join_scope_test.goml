package go_backend;

use module::anf;
use module::repr;
use std::collections;
use std::testing;

fn scope_test_jump(target: string) -> anf::Block {
    anf::Block {
        binds: Vec::new(),
        term: anf::Term::Jump { target, args: Vec::new(), ret_ty: repr::Type::Unit },
    }
}

fn scope_test_join(name: string, role: anf::JoinRole, body: anf::Block) -> anf::JoinBind {
    anf::JoinBind { name, role, params: Vec::new(), ret_ty: repr::Type::Unit, body }
}

fn scope_test_end() -> anf::Block {
    anf::Block {
        binds: Vec::new(),
        term: anf::Term::Return(
            anf::Imm::Prim { value: repr::Primitive::Unit, ty: repr::Type::Unit },
        ),
    }
}

fn assert_scope_target(actual: Option[string], expected: Option[string]) -> () {
    testing::assert(actual == expected)
}

#[test]
fn join_scope_preserves_shadowing_without_leaking_into_siblings() -> () {
    let root = JoinScope::Root(
        Vec::from_array(
            [
                scope_test_join("outer", anf::JoinRole::LoopExit, scope_test_end()),
                scope_test_join("inner", anf::JoinRole::LoopExit, scope_test_end()),
                scope_test_join("dispatch", anf::JoinRole::Continuation, scope_test_jump("outer")),
            ],
        ),
    );
    let child = anf::Block {
        binds: Vec::from_array(
            [
                anf::Bind::Join(
                    scope_test_join(
                        "dispatch",
                        anf::JoinRole::Continuation,
                        scope_test_jump("inner"),
                    ),
                ),
            ],
        ),
        term: scope_test_jump("dispatch").term,
    };
    assert_scope_target(
        block_tail_target_through_joins(child, root, collections::IndexSet::new()),
        Option::Some("inner"),
    );
    assert_scope_target(
        block_tail_target_through_joins(
            scope_test_jump("dispatch"),
            root,
            collections::IndexSet::new(),
        ),
        Option::Some("outer"),
    );
    assert_scope_target(
        block_tail_target_through_joins(
            scope_test_jump("missing"),
            root,
            collections::IndexSet::new(),
        ),
        Option::None,
    );
}

#[test]
fn join_scope_resolves_recursive_groups_and_outer_loop_exits() -> () {
    let root = JoinScope::Root(
        Vec::from_array([scope_test_join("exit", anf::JoinRole::LoopExit, scope_test_end())]),
    );
    let repeating = scope_test_join(
        "repeat",
        anf::JoinRole::Continuation,
        scope_test_jump("repeat"),
    );
    let body = anf::Block {
        binds: Vec::from_array([anf::Bind::JoinRec(Vec::from_array([repeating]))]),
        term: anf::Term::If {
            cond: anf::Imm::Prim {
                value: repr::Primitive::Bool { value: true },
                ty: repr::Type::Bool,
            },
            then_: scope_test_jump("repeat"),
            else_: scope_test_jump("exit"),
            ret_ty: repr::Type::Unit,
        },
    };
    assert_scope_target(find_loop_exit(body, "repeat", root), Option::Some("exit"));
    testing::assert(block_reaches_target(body, "repeat", root, collections::IndexSet::new()));
    assert_scope_target(
        block_tail_target_through_joins(
            anf::Block { binds: body.binds, term: scope_test_jump("repeat").term },
            root,
            collections::IndexSet::new(),
        ),
        Option::None,
    );
}
