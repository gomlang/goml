package go_backend;

use module::repr;
pub use module::go_ir::{Type, UnaryOp, BinaryOp, Expr, Block, SwitchCase, TypeSwitchCase, SelectOperation, SelectCase, Stmt, StructDef, InterfaceMethod, InterfaceDef, TypeDef, ConstSpec, ConstGroup, Global, Function, Method, Item, File};

pub struct DynCoercion {
    pub trait_name: string,
    pub for_ty: repr::Type,
}

pub struct DynHelperNames {
    pub factories: Vec[(string, string, string)],
    pub wrappers: Vec[(string, string, string, string)],
}

pub enum EnumStorage {
    Singleton,
    TagOnly,
    Flat,
    PointerNiche,
    Packed,
    Node,
    Interface,
}

pub struct EnumInfo {
    pub owner_name: string,
    pub storage: EnumStorage,
    pub tag_ty: Type,
    pub fields: Vec[(string, repr::Type)],
    pub node_name: string,
    pub nil_tag: Option[isize],
    pub payload_tag: Option[isize],
    pub payload_ty: Option[repr::Type],
}

pub struct VariantInfo {
    pub owner_name: string,
    pub tag: isize,
    pub variant_name: string,
    pub field_types: Vec[repr::Type],
    pub field_names: Vec[Option[string]],
}

pub struct VariantInfos {
    pub by_owner: HashMap[string, Vec[VariantInfo]],
    pub owners: HashMap[string, EnumInfo],
}
