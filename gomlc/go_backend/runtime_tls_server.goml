package go_backend;

use module::repr;
use module::ast;

fn tls_server_decl(name: string, ty: Type) -> Stmt {
    Stmt::Var { name, ty, value: Option::None }
}

fn tls_server_assign(names: Vec[string], value: Expr) -> Stmt {
    Stmt::MultiAssign { names, value }
}

fn tls_server_fail(message: Expr) -> Stmt {
    network_result(repr::Type::Int64, false, network_int(0), message)
}

fn tls_server_invalid(message: Expr) -> Stmt {
    task_return(
        std_tuple_expr(
            network_result_type(repr::Type::Int64),
            Vec::from_array([Expr::Bool { value: false }, network_int(0), network_int(4), message]),
        ),
    )
}

fn tls_server_error() -> Stmt {
    network_if(std_error_condition(), Vec::from_array([tls_server_fail(std_error_string())]))
}

fn tls_server_function(key: string, params: Vec[(string, Type)], stmts: Vec[Stmt]) -> Item {
    std_function_item(key, params, network_result_type(repr::Type::Int64), stmts)
}

fn tls_server_registry_items() -> Vec[Item] {
    let state = network_global("listener_state");
    let pointer = network_pointer(state);
    let map = Type::Map { key: Type::Int64, value: pointer };
    Vec::from_array(
        [
            Item::TypeDef(
                TypeDef {
                    name: state,
                    ty: Type::Struct {
                        fields: Vec::from_array(
                            [
                                ("socket", network_pointer("_goml_net.TCPListener")),
                                ("config", network_pointer("_goml_tls.Config")),
                                ("context", network_named("_goml_context.Context")),
                                ("cancel", network_named("_goml_context.CancelFunc")),
                                ("timeout", Type::Int64),
                            ],
                        ),
                    },
                },
            ),
            Item::Global(
                Global {
                    name: network_global("listeners"),
                    ty: Option::Some(map),
                    value: Expr::Make { ty: map, args: Vec::new() },
                },
            ),
            Item::Function(
                Function {
                    name: network_global("listener_lookup"),
                    params: Vec::from_array([("id", Type::Int64)]),
                    ret_ty: Option::Some(pointer),
                    body: Block {
                        stmts: Vec::from_array(
                            [
                                task_expr(task_method(network_global("mu"), "Lock", Vec::new())),
                                Stmt::Defer {
                                    call: task_method(network_global("mu"), "Unlock", Vec::new()),
                                },
                                task_return(
                                    Expr::Index {
                                        base: task_var(network_global("listeners")),
                                        index: task_var("id"),
                                    },
                                ),
                            ],
                        ),
                    },
                },
            ),
        ],
    )
}

fn tls_server_listen_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        network_var(
            "ctx",
            network_named("_goml_context.Context"),
            task_call("_goml_context.Background", Vec::new()),
        ),
    );
    stmts.push(tls_server_decl("err", network_named("error")));
    stmts.push(tls_server_decl("pair", network_named("_goml_tls.Certificate")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["pair", "err"]),
            task_call(
                "_goml_tls.X509KeyPair",
                Vec::from_array([network_bytes("certificate"), network_bytes("private_key")]),
            ),
        ),
    );
    stmts.push(
        network_if(std_error_condition(), Vec::from_array([tls_server_invalid(std_error_string())])),
    );
    stmts.push(
        network_var(
            "config",
            network_pointer("_goml_tls.Config"),
            network_address(
                Expr::StructLiteral {
                    ty: network_named("_goml_tls.Config"),
                    fields: Vec::from_array(
                        [
                            (
                                "Certificates",
                                Expr::ArrayLiteral {
                                    ty: Type::Slice { elem: network_named("_goml_tls.Certificate") },
                                    items: Vec::from_array([task_var("pair")]),
                                },
                            ),
                            ("NextProtos", network_bytes("protocols")),
                            ("MinVersion", task_var("minimum")),
                            ("MaxVersion", task_var("maximum")),
                        ],
                    ),
                },
            ),
        ),
    );
    stmts.push(
        network_if(
            task_var("require_client"),
            Vec::from_array(
                [
                    network_var(
                        "roots",
                        network_pointer("_goml_x509.CertPool"),
                        task_call("_goml_x509.NewCertPool", Vec::new()),
                    ),
                    network_if(
                        Expr::Unary {
                            op: UnaryOp::Not,
                            expr: task_method(
                                "roots",
                                "AppendCertsFromPEM",
                                Vec::from_array([network_bytes("ca")]),
                            ),
                        },
                        Vec::from_array(
                            [
                                tls_server_invalid(
                                    network_text("client CA bundle contains no certificates"),
                                ),
                            ],
                        ),
                    ),
                    Stmt::FieldAssign {
                        target: task_var("config"),
                        field_name: "ClientCAs",
                        value: task_var("roots"),
                    },
                    Stmt::FieldAssign {
                        target: task_var("config"),
                        field_name: "ClientAuth",
                        value: task_var("_goml_tls.RequireAndVerifyClientCert"),
                    },
                ],
            ),
        ),
    );
    stmts.push(tls_server_decl("address_value", network_pointer("_goml_net.TCPAddr")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["address_value", "err"]),
            task_call(
                "_goml_net.ResolveTCPAddr",
                Vec::from_array([network_text("tcp"), task_var("address")]),
            ),
        ),
    );
    stmts.push(tls_server_error());
    stmts.push(tls_server_decl("socket", network_pointer("_goml_net.TCPListener")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["socket", "err"]),
            task_call(
                "_goml_net.ListenTCP",
                Vec::from_array([network_text("tcp"), task_var("address_value")]),
            ),
        ),
    );
    stmts.push(tls_server_error());
    stmts.push(tls_server_decl("cancel", network_named("_goml_context.CancelFunc")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["ctx", "cancel"]),
            task_call("_goml_context.WithCancel", Vec::from_array([task_var("ctx")])),
        ),
    );
    stmts.push(
        network_var(
            "state",
            network_pointer(network_global("listener_state")),
            network_address(
                Expr::StructLiteral {
                    ty: network_named(network_global("listener_state")),
                    fields: Vec::from_array(
                        [
                            ("socket", task_var("socket")),
                            ("config", task_var("config")),
                            ("context", task_var("ctx")),
                            ("cancel", task_var("cancel")),
                            ("timeout", task_var("timeout")),
                        ],
                    ),
                },
            ),
        ),
    );
    stmts.push(task_expr(task_method(network_global("mu"), "Lock", Vec::new())));
    stmts.push(Stmt::Defer { call: task_method(network_global("mu"), "Unlock", Vec::new()) });
    stmts.push(network_var("id", Type::Int64, task_var(network_global("next"))));
    stmts.push(
        Stmt::Assign {
            name: network_global("next"),
            value: network_binary(BinaryOp::Add, task_var("id"), network_int(1)),
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: task_var(network_global("listeners")),
            index: task_var("id"),
            value: task_var("state"),
        },
    );
    stmts.push(network_result(repr::Type::Int64, true, task_var("id"), network_text("")));
    tls_server_function(
        key,
        Vec::from_array(
            [
                ("address", Type::String),
                ("certificate", lower_type(std_vec_type(repr::Type::Uint8))),
                ("private_key", lower_type(std_vec_type(repr::Type::Uint8))),
                ("ca", lower_type(std_vec_type(repr::Type::Uint8))),
                ("require_client", Type::Bool),
                ("protocols", lower_type(std_vec_type(repr::Type::String))),
                ("minimum", Type::Uint16),
                ("maximum", Type::Uint16),
                ("timeout", Type::Int64),
            ],
        ),
        stmts,
    )
}

fn tls_server_accept_item(key: string) -> Item {
    let stmts: Vec[Stmt] = Vec::new();
    network_context(stmts);
    stmts.push(
        network_var(
            "state",
            network_pointer(network_global("listener_state")),
            task_call(network_global("listener_lookup"), Vec::from_array([task_var("id")])),
        ),
    );
    stmts.push(
        network_if(
            network_binary(BinaryOp::Eq, task_var("state"), Expr::Nil),
            Vec::from_array([tls_server_fail(network_text("TLS listener is closed"))]),
        ),
    );
    stmts.push(tls_server_decl("cancel", network_named("_goml_context.CancelFunc")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["ctx", "cancel"]),
            task_call("_goml_context.WithCancel", Vec::from_array([task_var("ctx")])),
        ),
    );
    stmts.push(Stmt::Defer { call: task_call("cancel", Vec::new()) });
    let stop_type = Type::Func { params: Vec::new(), ret_ty: Type::Bool };
    stmts.push(
        network_var(
            "stop_listener",
            stop_type,
            task_call(
                "_goml_context.AfterFunc",
                Vec::from_array([task_field("state", "context"), task_var("cancel")]),
            ),
        ),
    );
    stmts.push(Stmt::Defer { call: task_call("stop_listener", Vec::new()) });
    let signal = Type::Chan { elem: Type::Unit, direction: ast::ChannelDirection::Both };
    stmts.push(network_var("aborted", signal, Expr::Make { ty: signal, args: Vec::new() }));
    let interrupt = Expr::FuncLit {
        params: Vec::new(),
        ret_ty: Type::Void,
        body: Block {
            stmts: Vec::from_array(
                [
                    task_expr(
                        task_method(
                            "state.socket",
                            "SetDeadline",
                            Vec::from_array([task_call("_goml_time.Now", Vec::new())]),
                        ),
                    ),
                    task_expr(task_call("close", Vec::from_array([task_var("aborted")]))),
                ],
            ),
        },
    };
    stmts.push(
        network_var(
            "stop_accept",
            stop_type,
            task_call("_goml_context.AfterFunc", Vec::from_array([task_var("ctx"), interrupt])),
        ),
    );
    stmts.push(tls_server_decl("raw", network_pointer("_goml_net.TCPConn")));
    stmts.push(tls_server_decl("err", network_named("error")));
    stmts.push(
        tls_server_assign(
            Vec::from_array(["raw", "err"]),
            task_method("state.socket", "AcceptTCP", Vec::new()),
        ),
    );
    stmts.push(
        network_if(
            Expr::Unary { op: UnaryOp::Not, expr: task_call("stop_accept", Vec::new()) },
            Vec::from_array([task_expr(Expr::Receive { channel: task_var("aborted") })]),
        ),
    );
    stmts.push(
        task_expr(
            task_method(
                "state.socket",
                "SetDeadline",
                Vec::from_array([network_empty("_goml_time.Time")]),
            ),
        ),
    );
    stmts.push(tls_server_error());
    stmts.push(
        network_if(
            network_binary(BinaryOp::NotEq, task_method("ctx", "Err", Vec::new()), Expr::Nil),
            Vec::from_array(
                [
                    task_expr(task_method("raw", "Close", Vec::new())),
                    tls_server_fail(network_text("TLS accept cancelled")),
                ],
            ),
        ),
    );
    stmts.push(
        tls_server_assign(
            Vec::from_array(["ctx", "cancel"]),
            task_call(
                "_goml_context.WithTimeout",
                Vec::from_array(
                    [
                        task_var("ctx"),
                        Expr::Convert {
                            ty: network_named("_goml_time.Duration"),
                            expr: task_field("state", "timeout"),
                        },
                    ],
                ),
            ),
        ),
    );
    stmts.push(Stmt::Defer { call: task_call("cancel", Vec::new()) });
    stmts.push(
        network_var(
            "conn",
            network_pointer("_goml_tls.Conn"),
            task_call(
                "_goml_tls.Server",
                Vec::from_array([task_var("raw"), task_field("state", "config")]),
            ),
        ),
    );
    stmts.push(
        Stmt::Assign {
            name: "err",
            value: task_method("conn", "HandshakeContext", Vec::from_array([task_var("ctx")])),
        },
    );
    stmts.push(
        network_if(
            std_error_condition(),
            Vec::from_array(
                [
                    task_expr(task_method("raw", "Close", Vec::new())),
                    tls_server_fail(std_error_string()),
                ],
            ),
        ),
    );
    stmts.push(task_expr(task_method(network_global("mu"), "Lock", Vec::new())));
    stmts.push(Stmt::Defer { call: task_method(network_global("mu"), "Unlock", Vec::new()) });
    stmts.push(
        network_if(
            network_binary(
                BinaryOp::Eq,
                Expr::Index { base: task_var(network_global("listeners")), index: task_var("id") },
                Expr::Nil,
            ),
            Vec::from_array(
                [
                    task_expr(task_method("raw", "Close", Vec::new())),
                    tls_server_fail(network_text("TLS listener is closed")),
                ],
            ),
        ),
    );
    stmts.push(network_var("connection_id", Type::Int64, task_var(network_global("next"))));
    stmts.push(
        Stmt::Assign {
            name: network_global("next"),
            value: network_binary(BinaryOp::Add, task_var("connection_id"), network_int(1)),
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: task_var(network_global("connections")),
            index: task_var("connection_id"),
            value: task_var("conn"),
        },
    );
    stmts.push(network_result(repr::Type::Int64, true, task_var("connection_id"), network_text("")));
    tls_server_function(
        key,
        Vec::from_array([("id", Type::Int64), ("cancel_id", Type::Int64), ("timeout", Type::Int64)]),
        stmts,
    )
}

fn tls_server_close_item(key: string) -> Item {
    let stmts = Vec::from_array(
        [
            task_expr(task_method(network_global("mu"), "Lock", Vec::new())),
            network_var(
                "state",
                network_pointer(network_global("listener_state")),
                Expr::Index { base: task_var(network_global("listeners")), index: task_var("id") },
            ),
            task_expr(
                task_call(
                    "delete",
                    Vec::from_array([task_var(network_global("listeners")), task_var("id")]),
                ),
            ),
            task_expr(task_method(network_global("mu"), "Unlock", Vec::new())),
            network_if(
                network_binary(BinaryOp::Eq, task_var("state"), Expr::Nil),
                Vec::from_array([task_return(network_text(""))]),
            ),
            task_expr(task_method("state", "cancel", Vec::new())),
            network_var(
                "err",
                network_named("error"),
                task_method("state.socket", "Close", Vec::new()),
            ),
            network_if(std_error_condition(), Vec::from_array([task_return(std_error_string())])),
            task_return(network_text("")),
        ],
    );
    std_function_item(key, Vec::from_array([("id", Type::Int64)]), Type::String, stmts)
}

fn tls_server_address_item(key: string) -> Item {
    let stmts = Vec::from_array(
        [
            network_var(
                "state",
                network_pointer(network_global("listener_state")),
                task_call(network_global("listener_lookup"), Vec::from_array([task_var("id")])),
            ),
            network_if(
                network_binary(BinaryOp::Eq, task_var("state"), Expr::Nil),
                Vec::from_array([task_return(network_text(""))]),
            ),
            network_var(
                "address",
                network_named("_goml_net.Addr"),
                task_method("state.socket", "Addr", Vec::new()),
            ),
            task_return(task_method("address", "String", Vec::new())),
        ],
    );
    std_function_item(key, Vec::from_array([("id", Type::Int64)]), Type::String, stmts)
}
