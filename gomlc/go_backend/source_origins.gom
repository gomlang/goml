package go_backend;

use module::anf;

pub struct SourceLowering {
    pub file: File,
    pub source_names: Vec[(string, string)],
}

pub fn lower_with_source_names(value: anf::File) -> Result[SourceLowering, string] {
    let value = anf::canonicalize_names(value);
    source_lowering(value, lower(value)?)
}

pub fn lower_tests_with_source_names(
    value: anf::File,
    test_cases: Vec[(string, string, Vec[(string, string)])],
) -> Result[SourceLowering, string] {
    let value = anf::canonicalize_names(value);
    source_lowering(value, lower_tests(value, test_cases)?)
}

fn source_lowering(value: anf::File, file: File) -> Result[SourceLowering, string] {
    source_lowering_with_renames(value, file, Vec::new())
}

fn source_lowering_with_renames(value: anf::File, file: File, renamed: Vec[(string, string)]) -> Result[
    SourceLowering,
    string,
] {
    let replacements: HashMap[string, string] = HashMap::new();
    for entry in renamed {
        replacements[entry.0] = entry.1;
    }
    let names = build_function_names(
        value.functions,
        value.structs,
        value.enums,
        value.type_instances,
    );
    let requirements = RuntimeRequirements {
        runtime_hooks: Vec::new(),
        missing_types: new_collected_types(),
        intrinsics: Vec::new(),
        go_foreign: Vec::new(),
        callbacks: Vec::new(),
        interface_bridges: Vec::new(),
    };
    for function in value.functions {
        collect_runtime_block(requirements, function.body)
    }
    let by_generated: HashMap[string, string] = HashMap::new();
    for function in value.functions {
        if let Some(generated) = mapped_function_name(names, function.name) {
            by_generated[replacements[generated].unwrap_or(generated)] = function.name;
        }
    }
    let sources: Vec[(string, string)] = Vec::new();
    for item in file.items {
        if let Function(function) = item {
            let Some(source) = by_generated[function.name] else {
                continue
            };
            sources.push((function.name, source));
            let references = new_name_set();
            collect_block_names(references, function.body);
            for bridge in requirements.interface_bridges {
                let original_factory = interface_bridge_factory(bridge);
                let factory = replacements[original_factory].unwrap_or(original_factory);
                if references.contains(factory) {
                    sources.push((factory, source));
                    let original_owner = interface_bridge_owner(bridge);
                    let owner = replacements[original_owner].unwrap_or(original_owner);
                    for method in bridge.methods {
                        sources.push((owner + "." + method.name, source));
                    }
                }
            }
            for adapter in requirements.callbacks {
                let original_factory = callback_factory_name(adapter);
                let factory = replacements[original_factory].unwrap_or(original_factory);
                if references.contains(factory) {
                    sources.push((factory, source));
                    let owner = callback_type_name(adapter);
                    sources.push((replacements[owner].unwrap_or(owner) + ".Apply", source));
                }
            }
            for foreign in requirements.go_foreign {
                let original_wrapper = go_foreign_spec_name(foreign);
                let wrapper = replacements[original_wrapper].unwrap_or(original_wrapper);
                if references.contains(wrapper) {
                    sources.push((wrapper, source));
                    for binding in foreign.bindings {
                        if binding != "" {
                            sources.push((wrapper, binding))
                        }
                    }
                }
            }
        }
    }
    Result::Ok(SourceLowering { file, source_names: sources })
}

pub fn embed_source_origins(file: File, encoded: string) -> File {
    file.items.push(
        Item::ConstGroup(
            ConstGroup {
                specs: Vec::from_array(
                    [
                        ConstSpec {
                            name: go_generated_ident("_goml_source_origins"),
                            ty: Type::String,
                            value: Expr::String { value: encoded },
                        },
                    ],
                ),
            },
        ),
    );
    file
}

pub fn lower_library_with_source_names(value: anf::File, declarations: Vec[(string, string)]) -> Result[
    SourceLowering,
    string,
] {
    validate_anf(value)?;
    let value = anf::canonicalize_names(value);
    let renamed = Vec::new();
    let file = lower_with_target_and_names(
        value,
        false,
        Option::Some(declarations),
        Vec::new(),
        renamed,
    )?;
    let result = source_lowering_with_renames(value, file, renamed)?;
    for declaration in declarations {
        result.source_names.push((declaration.1, declaration.0))
    }
    Result::Ok(result)
}
