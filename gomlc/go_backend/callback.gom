package go_backend;

use module::repr;

fn callback_type_name(value: repr::CallbackAdapter) -> string {
    go_hashed_ident(
        if value.to_go {
            "callback_to_go"
        } else {
            "callback_to_closure"
        },
        encode_type(value.signature),
    )
}

fn callback_factory_name(value: repr::CallbackAdapter) -> string {
    go_hashed_ident(
        if value.to_go {
            "callback_make_go"
        } else {
            "callback_make_closure"
        },
        encode_type(value.signature),
    )
}

fn add_callback_adapter(values: Vec[repr::CallbackAdapter], value: repr::CallbackAdapter) -> () {
    for existing in values {
        if existing.to_go == value.to_go && repr::types_equal(existing.signature, value.signature) {
            return
        }
    }
    values.push(value)
}

fn emit_callback_adapter_items(items: Vec[Item], values: Vec[repr::CallbackAdapter]) -> () {
    for value in values {
        let Func { params: parameter_types, ret_ty } = value.signature else {
            continue
        };
        let native = lower_type(repr::Type::GoFunction { signature: value.signature });
        let closure = lower_type(value.signature);
        let stored = if value.to_go {
            closure
        } else {
            native
        };
        let returned = if value.to_go {
            native
        } else {
            closure
        };
        let owner = Type::Named { name: callback_type_name(value) };
        items.push(
            Item::Struct(
                StructDef {
                    name: callback_type_name(value),
                    fields: Vec::from_array([("value", stored)]),
                },
            ),
        );
        let params = Vec::new();
        let args = Vec::new();
        for index in 0..parameter_types.len() {
            let name = "p" + index.to_string();
            params.push((name, lower_type(parameter_types[index])));
            args.push(Expr::Var { name });
        }
        let call = Expr::Call {
            func: Expr::Field { expr: Expr::Var { name: "self" }, field_name: "value" },
            args,
        };
        let stmts = Vec::new();
        match ret_ty {
            Unit => {
                stmts.push(Stmt::Expr { expr: call });
                stmts.push(
                    Stmt::Return {
                        expr: if value.to_go {
                            Option::None
                        } else {
                            Option::Some(Expr::StructLiteral { ty: Type::Unit, fields: Vec::new() })
                        },
                    },
                );
            },
            Tuple { items: result_types } => if value.to_go {
                stmts.push(
                    Stmt::Var { name: "result", ty: lower_type(ret_ty), value: Option::Some(call) },
                );
                let results = Vec::new();
                for index in 0..result_types.len() {
                    results.push(
                        Expr::Field {
                            expr: Expr::Var { name: "result" },
                            field_name: "_" + index.to_string(),
                        },
                    );
                }
                stmts.push(Stmt::ReturnMulti { exprs: results });
            } else {
                let names = Vec::new();
                let fields = Vec::new();
                for index in 0..result_types.len() {
                    let name = "r" + index.to_string();
                    stmts.push(
                        Stmt::Var { name, ty: lower_type(result_types[index]), value: Option::None },
                    );
                    names.push(name);
                    fields.push(("_" + index.to_string(), Expr::Var { name }));
                }
                stmts.push(Stmt::MultiAssign { names, value: call });
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(Expr::StructLiteral { ty: lower_type(ret_ty), fields }),
                    },
                );
            },
            _ => stmts.push(Stmt::Return { expr: Option::Some(call) }),
        }
        let method_return = match returned {
            Func { ret_ty, .. } => ret_ty,
            _ => Type::Void,
        };
        items.push(
            Item::Method(
                Method {
                    receiver: ("self", owner),
                    name: "Apply",
                    params,
                    ret_ty: match method_return {
                        Void => Option::None,
                        value => Option::Some(value),
                    },
                    body: Block { stmts },
                },
            ),
        );
        let value_expr = Expr::StructLiteral {
            ty: owner,
            fields: Vec::from_array([("value", Expr::Var { name: "value" })]),
        };
        items.push(
            Item::Function(
                Function {
                    name: callback_factory_name(value),
                    params: Vec::from_array([("value", stored)]),
                    ret_ty: Option::Some(returned),
                    body: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Return {
                                    expr: Option::Some(
                                        Expr::Field { expr: value_expr, field_name: "Apply" },
                                    ),
                                },
                            ],
                        ),
                    },
                },
            ),
        );
    }
}
