package go_backend;

use std::text;

fn go_line_indent(value: string) -> isize {
    let mut result = 0;
    while result < value.byte_len() && value.byte_get(result) == b' ' {
        result += 1;
    }
    result
}

fn go_line_body(value: string, indent: isize) -> string {
    value.byte_slice(indent, value.byte_len())
}

pub fn yaegi_compatible(source: string) -> bool {
    let select_indent = Ref::new(-1);
    for line in text::lines(source) {
        let indent = go_line_indent(line);
        let body = go_line_body(line, indent);
        if select_indent.get() >= 0 {
            if indent == select_indent.get() && body == "}" {
                select_indent.set(-1)
            } else if indent > select_indent.get()
                && (body.starts_with("break ") || body.starts_with("continue ")) {
                return false
            }
        } else if body == "select {" {
            select_indent.set(indent)
        }
    }
    true
}
