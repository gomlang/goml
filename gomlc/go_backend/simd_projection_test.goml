package go_backend;

use module::go_ir::{Type, Expr, Block, Stmt, Function};
use module::simd;
use std::json;
use std::testing;

fn simd_projection_function(extra: Vec[Stmt]) -> Function {
    let lanes = Expr::Field { expr: simd_var("input"), field_name: "lanes" };
    let projected = Expr::Unary { op: Deref, expr: simd_var("borrowed") };
    let stmts = Vec::from_array(
        [
            simd_local(
                "borrowed",
                Type::Pointer { elem: Type::Array { len: 4, elem: Type::Uint32 } },
                Expr::Unary { op: Address, expr: lanes },
            ),
        ],
    );
    for statement in extra {
        stmts.push(statement);
    }
    stmts.push(
        simd_return(
            Expr::StructLiteral {
                ty: Type::Named { name: "Vector" },
                fields: Vec::from_array(
                    [("lanes", simd_call("add", Vec::from_array([projected, projected])))],
                ),
            },
        ),
    );
    Function {
        name: "projection_kernel",
        params: Vec::from_array([("input", Type::Named { name: "Vector" })]),
        ret_ty: Some(Type::Named { name: "Vector" }),
        body: Block { stmts },
    }
}

fn simd_projection_native(function: Function) -> Option[json::Value] {
    let ty = simd::VectorType { element: simd::Element::U32, lanes: 4 };
    let intrinsics = HashMap::new();
    intrinsics["add"] = SimdIntrinsic { ty, mask: false, operation: "add" };
    let types = HashMap::new();
    types["Vector"] = ("lanes", simd::ValueKind::Vector(ty));
    simd_native_function(HashMap::new(), intrinsics, types, function)
}

#[test]
fn simd_native_preserves_read_only_array_projections() -> () {
    let native = testing::expect_some(
        simd_projection_native(simd_projection_function(Vec::new())),
        "read-only field projection remains a native kernel",
    );
    testing::assert(json::encode(native).contains("TEXT ·projection_kernel(SB),"));
}

#[test]
fn simd_native_rejects_projection_root_and_pointer_mutation() -> () {
    for statement in[
        Stmt::Assign { name: "input", value: simd_var("input") },
        Stmt::Assign { name: "borrowed", value: simd_var("borrowed") },
        simd_local("input", Type::Named { name: "Vector" }, simd_var("input")),
        Stmt::IndexAssign {
            base: Expr::Unary { op: Deref, expr: simd_var("borrowed") },
            index: simd_int(0),
            value: simd_int(1),
        },
    ] {
        testing::assert(
            simd_projection_native(simd_projection_function(Vec::from_array([statement]))).is_none(),
        );
    }
}

#[test]
fn simd_native_rejects_uncontrolled_pointer_sources_and_escapes() -> () {
    let function = simd_projection_function(Vec::new());
    let stmts = function.body.stmts;
    for expression in[
        Expr::Unary { op: Address, expr: simd_var("input") },
        simd_var("external"),
        Expr::Nil,
    ] {
        stmts[0] = simd_local(
            "borrowed",
            Type::Pointer { elem: Type::Array { len: 4, elem: Type::Uint32 } },
            expression,
        );
        testing::assert(simd_projection_native(function).is_none());
    }
    let function = simd_projection_function(Vec::new());
    function.params[0] = ("input", Type::Pointer { elem: Type::Named { name: "Vector" } });
    testing::assert(simd_projection_native(function).is_none());
    let function = simd_projection_function(Vec::new());
    testing::assert(
        simd_projection_native(
            Function {
                name: function.name,
                params: function.params,
                ret_ty: Some(Type::Pointer { elem: Type::Array { len: 4, elem: Type::Uint32 } }),
                body: Block { stmts: Vec::from_array([simd_return(simd_var("input"))]) },
            },
        ).is_none(),
    );
}
