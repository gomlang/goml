package go_backend;

use module::ast;
use module::repr;
use module::pretty;
use module::tast;
use std::text;

fn backend_names_match(name: string, expected: string) -> bool {
    name == expected || name.ends_with("::" + expected)
}

fn backend_instance_matches(name: string, expected: string) -> bool {
    name == expected || name.starts_with(expected + "__")
}

pub fn compact_type(value: repr::Type) -> string {
    let source = pretty::compact(repr::type_doc(value));
    let builder = text::StringBuilder::new();
    for character in source.chars() {
        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn join_type_parts(values: Vec[repr::Type]) -> string {
    let builder = text::StringBuilder::new();
    for index in 0..values.len() {
        if index > 0 {
            builder.write_char('_')
        }
        let encoded = encode_type(values[index]);
        builder.write_string(encoded.byte_len().to_string());
        builder.write_string(encoded)
    }
    builder.finish()
}

pub fn encode_type(value: repr::Type) -> string {
    match repr::resolve_type(value) {
        Unit => "unit",
        Never => "never",
        Bool => "bool",
        Int => "int",
        Int8 => "int8",
        Int16 => "int16",
        Int32 => "int32",
        Int64 => "int64",
        Uint => "uint",
        Uint8 => "uint8",
        Uint16 => "uint16",
        Uint32 => "uint32",
        Uint64 => "uint64",
        Float32 => "float32",
        Float64 => "float64",
        String => "string",
        Char => "char",
        Tuple { items: values } => f"Tuple{values.len()}_" + join_type_parts(values),
        External { import_path, name, args } => "Go_" + import_path.byte_len().to_string()
            + import_path
            + name.byte_len().to_string()
            + name
            + "_"
            + args.len().to_string()
            + "_"
            + join_type_parts(args),
        Named { name } | ClosureEnvironment { name } => name,
        Dyn { trait_name: name, .. } => "Dyn_" + name,
        Array { len: length, elem } => {
            let encoded = encode_type(elem);
            f"Array_{length}_{encoded.byte_len()}{encoded}"
        },
        Slice { elem } => {
            let encoded = encode_type(elem);
            f"Slice_{encoded.byte_len()}{encoded}"
        },
        MutSlice { elem } => {
            let encoded = encode_type(elem);
            f"MutSlice_{encoded.byte_len()}{encoded}"
        },
        VecType { elem } => {
            let encoded = encode_type(elem);
            f"Vec_{encoded.byte_len()}{encoded}"
        },
        GoPointer { elem } => {
            let encoded = encode_type(elem);
            f"GoPointer_{encoded.byte_len()}{encoded}"
        },
        GoFunction { signature } => {
            let encoded = encode_type(signature);
            f"GoFunction_{encoded.byte_len()}{encoded}"
        },
        RefType { elem } => {
            let encoded = encode_type(elem);
            f"Ref_{encoded.byte_len()}{encoded}"
        },
        GoMap { key, value } => {
            let key_name = encode_type(key);
            let value_name = encode_type(value);
            f"GoMap_{key_name.byte_len()}{key_name}_{value_name.byte_len()}{value_name}"
        },
        HashMap { key, value } => {
            let key_name = encode_type(key);
            let value_name = encode_type(value);
            f"HashMap_{key_name.byte_len()}{key_name}_{value_name.byte_len()}{value_name}"
        },
        Channel { elem, direction } => {
            let encoded = encode_type(elem);
            let prefix = match direction {
                ast::ChannelDirection::Both => "Channel_",
                ast::ChannelDirection::Send => "Sender_",
                ast::ChannelDirection::Receive => "Receiver_",
            };
            f"{prefix}{encoded.byte_len()}{encoded}"
        },
        Func { params, ret_ty } => {
            let ret_name = encode_type(ret_ty);
            f"Fn{params.len()}_{join_type_parts(params)}_to_{ret_name.byte_len()}{ret_name}"
        },
    }
}

fn type_name_part(value: repr::Type) -> string {
    let name = type_name(value);
    f"{name.byte_len()}{name}"
}

pub fn type_name(value: repr::Type) -> string {
    match repr::resolve_type(value) {
        Unit => "unit",
        Never => "never",
        Bool => "bool",
        Int => "int",
        Int8 => "int8",
        Int16 => "int16",
        Int32 => "int32",
        Int64 => "int64",
        Uint => "uint",
        Uint8 => "uint8",
        Uint16 => "uint16",
        Uint32 => "uint32",
        Uint64 => "uint64",
        Float32 => "float32",
        Float64 => "float64",
        String => "string",
        Char => "char",
        Tuple { items: values } => {
            let builder = text::StringBuilder::new();
            builder.write_string("Tuple");
            builder.write_string(values.len().to_string());
            for value in values {
                builder.write_char('_');
                builder.write_string(type_name_part(value))
            }
            go_generated_ident(builder.finish())
        },
        External { .. } => go_hashed_ident("go_type", encode_type(value)),
        Named { name } | ClosureEnvironment { name } => go_user_type_name(name),
        Dyn { trait_name: name, .. } => go_dyn_struct_name(name),
        Array { len: length, elem } => {
            go_generated_ident(f"Array{length}_" + type_name_part(elem))
        },
        Slice { elem } => go_generated_ident("Slice_" + type_name_part(elem)),
        MutSlice { elem } => go_generated_ident("MutSlice_" + type_name_part(elem)),
        VecType { elem } => go_generated_ident("Vec_" + type_name_part(elem)),
        GoPointer { .. } => go_hashed_ident("go_pointer", encode_type(value)),
        GoFunction { .. } => go_hashed_ident("go_function", encode_type(value)),
        RefType { elem } => go_generated_ident("Ptr_" + type_name_part(elem)),
        GoMap { .. } => go_hashed_ident("go_map", encode_type(value)),
        HashMap { key, value } => {
            go_generated_ident("HashMap_" + type_name_part(key) + "_" + type_name_part(value))
        },
        Channel { elem, direction } => go_generated_ident(
            match direction {
                ast::ChannelDirection::Both => "Channel_",
                ast::ChannelDirection::Send => "Sender_",
                ast::ChannelDirection::Receive => "Receiver_",
            }
                + type_name_part(elem),
        ),
        Func { params, ret_ty } => {
            let builder = text::StringBuilder::new();
            builder.write_string("TFunc");
            builder.write_string(params.len().to_string());
            for value in params {
                builder.write_char('_');
                builder.write_string(type_name_part(value))
            }
            builder.write_string("_ret_");
            builder.write_string(type_name_part(ret_ty));
            go_generated_ident(builder.finish())
        },
    }
}

pub fn lower_type(value: repr::Type) -> Type {
    match tast::builtin_contract() {
        Ok(builtin) => lower_type_with_contract(builtin, value),
        Err(_) => Type::Unit,
    }
}

fn lower_type_with_contract(builtin: tast::BuiltinContract, value: repr::Type) -> Type {
    match repr::resolve_type(value) {
        Unit | Never => Type::Unit,
        Bool => Type::Bool,
        Int => Type::Int,
        Int8 => Type::Int8,
        Int16 => Type::Int16,
        Int32 => Type::Int32,
        Int64 => Type::Int64,
        Uint => Type::Uint,
        Uint8 => Type::Uint8,
        Uint16 => Type::Uint16,
        Uint32 => Type::Uint32,
        Uint64 => Type::Uint64,
        Float32 => Type::Float32,
        Float64 => Type::Float64,
        String => Type::String,
        Char => Type::Char,
        Tuple { items: _ } => Type::Named { name: type_name(value) },
        External { import_path, name, args } => {
            let base = Type::Named {
                name: if import_path == "" {
                    name
                } else {
                    go_foreign_import_alias(import_path) + "." + name
                },
            };
            if args.is_empty() {
                base
            } else {
                let arguments: Vec[Type] = Vec::new();
                for arg in args {
                    arguments.push(lower_type_with_contract(builtin, arg))
                }
                Type::Apply { base, args: arguments }
            }
        },
        Named { name } => if backend_instance_matches(name, builtin.static_cell.name) {
            Type::Pointer { elem: Type::Named { name: go_user_type_name(name) } }
        } else {
            Type::Named { name: go_user_type_name(name) }
        },
        ClosureEnvironment { name } => Type::Named { name: go_user_type_name(name) },
        Dyn { trait_name: name, .. } => Type::Named { name: go_dyn_struct_name(name) },
        Array { len: length, elem } => {
            Type::Array { len: length, elem: lower_type_with_contract(builtin, elem) }
        },
        Slice { elem } => Type::Slice { elem: lower_type_with_contract(builtin, elem) },
        MutSlice { elem } => Type::Slice { elem: lower_type_with_contract(builtin, elem) },
        VecType { elem } => {
            Type::Pointer {
                elem: Type::Named {
                    name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                },
            }
        },
        GoMap { key, value } => Type::Map {
            key: lower_type_with_contract(builtin, key),
            value: lower_type_with_contract(builtin, value),
        },
        GoPointer { elem } => Type::Pointer { elem: lower_type_with_contract(builtin, elem) },
        GoFunction { signature } => lower_go_function_type(builtin, signature),
        RefType { elem } => {
            Type::Pointer {
                elem: Type::Named {
                    name: go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x"),
                },
            }
        },
        HashMap { key, value } => {
            Type::Pointer {
                elem: Type::Named {
                    name: go_generated_ident(
                        "hashmap_" + go_ident(encode_type(key) + "_" + encode_type(value)) + "_x",
                    ),
                },
            }
        },
        Channel { elem, direction } => {
            Type::Chan { elem: lower_type_with_contract(builtin, elem), direction }
        },
        Func { params, ret_ty } => {
            let lowered: Vec[Type] = Vec::new();
            for value in params {
                lowered.push(lower_type_with_contract(builtin, value))
            }
            Type::Func { params: lowered, ret_ty: lower_type_with_contract(builtin, ret_ty) }
        },
    }
}

fn lower_go_function_type(builtin: tast::BuiltinContract, signature: repr::Type) -> Type {
    match repr::resolve_type(signature) {
        Func { params, ret_ty } => {
            let parameters = Vec::new();
            for value in params {
                parameters.push(lower_type_with_contract(builtin, value))
            }
            let result = match repr::resolve_type(ret_ty) {
                Unit => Type::Void,
                Tuple { items } => {
                    let results = Vec::new();
                    for value in items {
                        results.push(lower_type_with_contract(builtin, value))
                    }
                    Type::Multi { items: results }
                },
                value => lower_type_with_contract(builtin, value),
            };
            Type::Func { params: parameters, ret_ty: result }
        },
        _ => Type::Any,
    }
}
