package go_backend;

use std::testing;

#[test]
fn dce_preserves_effectful_builtin_arguments_with_blank_assignments() -> () {
    for name in Vec::from_array(["len", "cap", "string", "int", "max", "min"]) {
        let call = Expr::Call {
            func: Expr::Var { name },
            args: Vec::from_array(
                [Expr::Call { func: Expr::Var { name: "effect" }, args: Vec::new() }],
            ),
        };
        let result = eliminate_dead_vars(
            Block {
                stmts: Vec::from_array(
                    [Stmt::Var { name: "unused", ty: Type::Int, value: Option::Some(call) }],
                ),
            },
        );
        testing::assert_eq(result.stmts.len(), 1);
        match result.stmts[0] {
            Assign { name: target, value } => {
                testing::assert_eq(target, "_");
                testing::assert_eq(expr_doc(value).render(1000), name + "(effect())");
            },
            _ => testing::fail("discarded builtin call must consume its result"),
        }
    }
}

#[test]
fn dce_preserves_append_targets_when_discarding_results() -> () {
    let slice = Expr::Var { name: "values" };
    let calls = Vec::from_array(
        [
            Expr::Call {
                func: Expr::Var { name: "append" },
                args: Vec::from_array([slice, Expr::Int { value: "1" }]),
            },
            Expr::CallSpread {
                func: Expr::Var { name: "append" },
                args: Vec::from_array([slice]),
                spread: Expr::Var { name: "more" },
            },
        ],
    );
    for call in calls {
        let result = eliminate_dead_vars(
            Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Var {
                            name: "unused",
                            ty: Type::Slice { elem: Type::Int },
                            value: Option::Some(call),
                        },
                    ],
                ),
            },
        );
        testing::assert_eq(result.stmts.len(), 1);
        match result.stmts[0] {
            Assign { name, .. } => testing::assert_eq(name, "values"),
            _ => testing::fail("discarded append must preserve its destination"),
        }
    }
}
