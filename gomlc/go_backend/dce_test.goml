package go_backend;

use module::go_ir::{expr_doc, block_doc};
use module::go_ir::{Type, Expr, Block, Stmt};
use std::testing;

#[test]
fn dce_preserves_effectful_builtin_arguments_with_blank_assignments() -> () {
    for name in Vec::from_array(["len", "cap", "string", "int", "max", "min"]) {
        let call = Expr::Call {
            func: Expr::Var { name },
            args: Vec::from_array(
                [Expr::Call { func: Expr::Var { name: "effect" }, args: Vec::new() }],
            ),
        };
        let result = eliminate_dead_vars(
            Block {
                stmts: Vec::from_array(
                    [Stmt::Var { name: "unused", ty: Type::Int, value: Option::Some(call) }],
                ),
            },
        );
        testing::assert_eq(result.stmts.len(), 1);
        match result.stmts[0] {
            Assign { name: target, value } => {
                testing::assert_eq(target, "_");
                testing::assert_eq(expr_doc(value).render(1000), name + "(effect())");
            },
            _ => testing::fail("discarded builtin call must consume its result"),
        }
    }
}

#[test]
fn dce_preserves_append_targets_when_discarding_results() -> () {
    let slice = Expr::Var { name: "values" };
    let calls = Vec::from_array(
        [
            Expr::Call {
                func: Expr::Var { name: "append" },
                args: Vec::from_array([slice, Expr::Int { value: "1" }]),
            },
            CallSpread {
                func: Expr::Var { name: "append" },
                args: Vec::from_array([slice]),
                spread: Expr::Var { name: "more" },
            },
        ],
    );
    for call in calls {
        let result = eliminate_dead_vars(
            Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Var {
                            name: "unused",
                            ty: Type::Slice { elem: Type::Int },
                            value: Option::Some(call),
                        },
                    ],
                ),
            },
        );
        testing::assert_eq(result.stmts.len(), 1);
        match result.stmts[0] {
            Assign { name, .. } => testing::assert_eq(name, "values"),
            _ => testing::fail("discarded append must preserve its destination"),
        }
    }
}

fn dce_test_assignment(name: string, value: string) -> Stmt {
    Stmt::Assign { name, value: Expr::Int { value } }
}

fn dce_test_variable(name: string) -> Stmt {
    Stmt::Var { name, ty: Type::Int, value: None }
}

#[test]
fn dce_preserves_assignments_before_early_loop_breaks() -> () {
    for labeled in[false, true] {
        let exit = if labeled {
            Stmt::BreakLabel { label: "Shared" }
        } else {
            Stmt::Break
        };
        let body = Block {
            stmts: Vec::from_array(
                [
                    Stmt::If {
                        cond: Expr::Var { name: "condition" },
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    dce_test_assignment("result", "1"),
                                    dce_test_assignment("unused", "9"),
                                    exit,
                                ],
                            ),
                        },
                        else_: None,
                    },
                    dce_test_assignment("result", "2"),
                    exit,
                ],
            ),
        };
        let lowered = eliminate_dead_vars(
            Block {
                stmts: Vec::from_array(
                    [
                        dce_test_variable("result"),
                        dce_test_variable("unused"),
                        if labeled {
                            Stmt::LabeledLoop { label: "Shared", body }
                        } else {
                            Stmt::Loop { body }
                        },
                        Stmt::Return { expr: Some(Expr::Var { name: "result" }) },
                    ],
                ),
            },
        );
        let generated = block_doc(lowered).render(1000);
        testing::assert(generated.contains("result = 1"));
        testing::assert(generated.contains("result = 2"));
        testing::assert(!generated.contains("unused"));
    }
}

fn dce_test_nested_region(body: Block, kind: isize) -> Stmt {
    match kind {
        0 => Stmt::Loop { body },
        1 => Stmt::LabeledLoop { label: "Inner", body },
        2 => Stmt::Range {
            names: Vec::from_array(["index"]),
            expr: Expr::Var { name: "items" },
            body,
        },
        3 => Stmt::Switch {
            expr: Expr::Var { name: "item" },
            cases: Vec::new(),
            default: Some(body),
        },
        4 => Stmt::TypeSwitch {
            binding: None,
            expr: Expr::Var { name: "item" },
            cases: Vec::new(),
            default: Some(body),
        },
        _ => Stmt::Select { cases: Vec::new(), default: Some(body) },
    }
}

#[test]
fn dce_preserves_outer_jump_targets_across_nested_control_regions() -> () {
    for is_continue in[false, true] {
        for kind in 0..6 {
            let exit = if is_continue {
                Stmt::ContinueLabel { label: "Outer" }
            } else {
                Stmt::BreakLabel { label: "Outer" }
            };
            let inner = Block {
                stmts: Vec::from_array(
                    [
                        Stmt::If {
                            cond: Expr::Var { name: "condition" },
                            then_: Block {
                                stmts: Vec::from_array([dce_test_assignment("result", "1"), exit]),
                            },
                            else_: None,
                        },
                        dce_test_assignment("result", "2"),
                        Stmt::Break,
                    ],
                ),
            };
            let body: Vec[Stmt] = Vec::new();
            if is_continue {
                body.push(
                    Stmt::Expr {
                        expr: Expr::Call {
                            func: Expr::Var { name: "observe" },
                            args: Vec::from_array([Expr::Var { name: "result" }]),
                        },
                    },
                );
            }
            body.push(dce_test_nested_region(inner, kind));
            body.push(dce_test_assignment("result", "3"));
            body.push(exit);
            let stmts = Vec::from_array(
                [
                    dce_test_variable("result"),
                    Stmt::LabeledLoop { label: "Outer", body: Block { stmts: body } },
                ],
            );
            if !is_continue {
                stmts.push(Stmt::Return { expr: Some(Expr::Var { name: "result" }) });
            }
            let generated = block_doc(eliminate_dead_vars(Block { stmts })).render(1000);
            testing::assert(generated.contains("result = 1"));
            testing::assert(!generated.contains("result = 2"));
            testing::assert(generated.contains("result = 3"));
        }
    }
}

#[test]
fn dce_unlabeled_continue_keeps_the_loop_header_live_across_select() -> () {
    let selected = Stmt::Select {
        cases: Vec::new(),
        default: Some(
            Block {
                stmts: Vec::from_array(
                    [
                        Stmt::If {
                            cond: Expr::Var { name: "condition" },
                            then_: Block {
                                stmts: Vec::from_array(
                                    [dce_test_assignment("result", "1"), Stmt::Continue],
                                ),
                            },
                            else_: None,
                        },
                        dce_test_assignment("result", "2"),
                    ],
                ),
            },
        ),
    };
    let body = Block {
        stmts: Vec::from_array(
            [
                Stmt::Expr {
                    expr: Expr::Call {
                        func: Expr::Var { name: "observe" },
                        args: Vec::from_array([Expr::Var { name: "result" }]),
                    },
                },
                selected,
                dce_test_assignment("result", "3"),
                Stmt::Continue,
            ],
        ),
    };
    let generated = block_doc(
        eliminate_dead_vars(
            Block { stmts: Vec::from_array([dce_test_variable("result"), Stmt::Loop { body }]) },
        ),
    ).render(1000);
    testing::assert(generated.contains("result = 1"));
    testing::assert(!generated.contains("result = 2"));
    testing::assert(generated.contains("result = 3"));
}
