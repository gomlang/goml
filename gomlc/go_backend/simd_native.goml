package go_backend;

use module::simd;
use module::pretty;
use module::resources;
use std::json;
use std::num;

enum SimdValue {
    Vector(isize),
    Mask(isize),
    Scalar(isize),
    Literal(string),
    Bits {
        element: simd::Element,
        bits: u64,
    },
    Array {
        element: simd::Element,
        values: Vec[SimdValue],
    },
    Predicate(simd::Output),
    Record(Vec[(string, SimdValue)]),
    Projection(isize),
}

struct SimdEvaluation {
    functions: HashMap[string, Function],
    intrinsics: HashMap[string, SimdIntrinsic],
    types: HashMap[string, (string, simd::ValueKind)],
    nodes: Vec[simd::Node],
    kinds: Vec[simd::ValueKind],
    projections: Vec[SimdValue],
    budget: Ref[isize],
    operations: Ref[isize],
}

fn simd_push_node(context: SimdEvaluation, node: simd::Node, kind: simd::ValueKind) -> isize {
    let index = context.nodes.len();
    context.nodes.push(node);
    context.kinds.push(kind);
    index
}

fn simd_number_bits(value: string, element: simd::Element) -> Option[u64] {
    if element == simd::Element::F32 {
        return match num::parse_float32_structured(value) {
            Ok(value) => Some(value.to_bits().to_u64()),
            Err(_) => None,
        }
    }
    if element == simd::Element::F64 {
        return match num::parse_float64_structured(value) {
            Ok(value) => Some(value.to_bits()),
            Err(_) => None,
        }
    }
    let negative = value.starts_with("-");
    let digits = if negative {
        value.byte_slice(1, value.byte_len())
    } else {
        value
    };
    let mut bits = match num::parse_uint_structured(digits) {
        Ok(value) => value.to_u64(),
        Err(_) => return None,
    };
    if negative {
        bits = 0.to_u64() - bits;
    }
    let width = simd::element_bits(element);
    if width < 64 {
        bits = bits & ((1.to_u64() << width) - 1);
    }
    Some(bits)
}

fn simd_value_bits(value: SimdValue, element: simd::Element) -> Option[u64] {
    match value {
        Literal(value) => simd_number_bits(value, element),
        Bits { element: from, bits } => {
            if from == element {
                return Some(bits)
            }
            if simd::is_float(from) {
                if from == simd::Element::F32 && element == simd::Element::F64 {
                    return Some(float32_from_bits(bits.to_u32()).to_f64().to_bits())
                }
                if from == simd::Element::F64 && element == simd::Element::F32 {
                    return Some(float64_from_bits(bits).to_f32().to_bits().to_u64())
                }
                return None
            }
            let width = simd::element_bits(from);
            let signed = if simd::is_signed(from) && width < 64
                && bits & (1.to_u64() << (width - 1)) != 0 {
                (bits | (0xffffffffffffffff << width)).to_i64()
            } else {
                bits.to_i64()
            };
            simd_number_bits(
                if simd::is_signed(from) {
                    signed.to_string()
                } else {
                    bits.to_string()
                },
                element,
            )
        },
        _ => None,
    }
}

fn simd_scalar_node(context: SimdEvaluation, value: SimdValue, element: simd::Element) -> Option[
    isize,
] {
    if let Scalar(index) = value {
        if context.kinds[index] == simd::ValueKind::Scalar(element) {
            return Some(index)
        }
        return None
    }
    let bits = simd_value_bits(value, element)?;
    Some(
        simd_push_node(
            context,
            simd::Node::Scalar { element, bits },
            simd::ValueKind::Scalar(element),
        ),
    )
}

fn simd_vector_node(context: SimdEvaluation, value: SimdValue, ty: simd::VectorType) -> Option[
    isize,
] {
    if let Vector(index) = value {
        if context.kinds[index] == simd::ValueKind::Vector(ty) {
            return Some(index)
        }
        return None
    }
    let Array { element, values } = value else {
        return None
    };
    if element != ty.element || values.len() != ty.lanes {
        return None
    }
    let bits: Vec[u64] = Vec::new();
    for value in values {
        bits.push(simd_value_bits(value, element)?);
    }
    Some(simd_push_node(context, simd::Node::Constant { ty, bits }, simd::ValueKind::Vector(ty)))
}

fn simd_mask_node(context: SimdEvaluation, value: SimdValue, ty: simd::VectorType) -> Option[isize] {
    let ty = simd::mask_type(ty);
    if let Mask(index) = value {
        if context.kinds[index] == simd::ValueKind::Mask(ty) {
            return Some(index)
        }
        return None
    }
    let bits = simd_value_bits(value, simd::Element::U32)?;
    if bits >= (1.to_u64() << ty.lanes) {
        return None
    }
    Some(
        simd_push_node(context, MaskConstant { ty, bits: bits.to_u32() }, simd::ValueKind::Mask(ty)),
    )
}

fn simd_native_binary(operation: string) -> Option[simd::Operator] {
    match operation {
        "add" | "reduce_sum" => Some(simd::Operator::Add),
        "sub" => Some(simd::Operator::Sub),
        "mul" | "reduce_product" => Some(simd::Operator::Mul),
        "div" => Some(simd::Operator::Div),
        "eq" => Some(simd::Operator::Eq),
        "ne" => Some(simd::Operator::Ne),
        "lt" | "gt" => Some(simd::Operator::Lt),
        "le" | "ge" => Some(simd::Operator::Le),
        "bitand" | "reduce_and" => Some(simd::Operator::And),
        "bitor" | "reduce_or" => Some(simd::Operator::Or),
        "bitxor" | "reduce_xor" => Some(simd::Operator::Xor),
        "min" | "reduce_min" => Some(simd::Operator::Min),
        "max" | "reduce_max" => Some(simd::Operator::Max),
        "saturating_add" => Some(simd::Operator::SaturatingAdd),
        "saturating_sub" => Some(simd::Operator::SaturatingSub),
        _ => None,
    }
}

fn simd_native_unary(operation: string) -> Option[simd::UnaryOperator] {
    match operation {
        "bitnot" => Some(simd::UnaryOperator::Not),
        "neg" => Some(simd::UnaryOperator::Neg),
        "abs" => Some(simd::UnaryOperator::Abs),
        "sqrt" => Some(simd::UnaryOperator::Sqrt),
        "floor" => Some(simd::UnaryOperator::Floor),
        "ceil" => Some(simd::UnaryOperator::Ceil),
        "trunc" => Some(simd::UnaryOperator::Trunc),
        "round" => Some(simd::UnaryOperator::Round),
        "round_ties_even" => Some(simd::UnaryOperator::RoundTiesEven),
        _ => None,
    }
}

fn simd_evaluate_intrinsic(context: SimdEvaluation, spec: SimdIntrinsic, values: Vec[SimdValue]) -> Option[
    SimdValue,
] {
    context.operations.set(context.operations.get() + 1);
    let ty = spec.ty;
    let vector = simd::ValueKind::Vector(ty);
    let mask = simd::ValueKind::Mask(simd::mask_type(ty));
    if spec.operation.starts_with("reduce_") {
        if values.len() != 1 {
            return None
        }
        let value = simd_vector_node(context, values[0], ty)?;
        let op = simd_native_binary(spec.operation)?;
        return Some(
            Scalar(
                simd_push_node(context, Reduce { op, value }, simd::ValueKind::Scalar(ty.element)),
            ),
        )
    }
    if let Some(op) = simd_native_binary(spec.operation) {
        if values.len() != 2 {
            return None
        }
        let mut left = if spec.mask {
            simd_mask_node(context, values[0], ty)?
        } else {
            simd_vector_node(context, values[0], ty)?
        };
        let mut right = if spec.mask {
            simd_mask_node(context, values[1], ty)?
        } else {
            simd_vector_node(context, values[1], ty)?
        };
        if spec.operation == "gt" || spec.operation == "ge" {
            let swapped = left;
            left = right;
            right = swapped;
        }
        let masked = spec.mask || simd::is_comparison(op);
        let index = simd_push_node(
            context,
            simd::Node::Binary { op, left, right },
            if masked {
                mask
            } else {
                vector
            },
        );
        return Some(
            if masked {
                Mask(index)
            } else {
                Vector(index)
            },
        )
    }
    if let Some(op) = simd_native_unary(spec.operation) {
        if values.len() != 1 {
            return None
        }
        let value = if spec.mask {
            simd_mask_node(context, values[0], ty)?
        } else {
            simd_vector_node(context, values[0], ty)?
        };
        let index = simd_push_node(
            context,
            simd::Node::Unary { op, value },
            if spec.mask {
                mask
            } else {
                vector
            },
        );
        return Some(
            if spec.mask {
                Mask(index)
            } else {
                Vector(index)
            },
        )
    }
    if spec.operation == "select" || spec.operation == "mul_add" {
        if values.len() != 3 {
            return None
        }
        let left = simd_vector_node(
            context,
            values[if spec.operation == "select" {
                1
            } else {
                0
            }],
            ty,
        )?;
        let right = simd_vector_node(
            context,
            values[if spec.operation == "select" {
                2
            } else {
                1
            }],
            ty,
        )?;
        let node = if spec.operation == "select" {
            simd::Node::Select { mask: simd_mask_node(context, values[0], ty)?, left, right }
        } else {
            Fma { left, right, addend: simd_vector_node(context, values[2], ty)? }
        };
        return Some(SimdValue::Vector(simd_push_node(context, node, vector)))
    }
    if spec.operation == "shuffle" || spec.operation == "swizzle" {
        let swizzle = spec.operation == "swizzle";
        if values.len()
            != if swizzle {
                2
            } else {
                3
            } {
            return None
        }
        let left = simd_vector_node(context, values[0], ty)?;
        let right = if swizzle {
            left
        } else {
            simd_vector_node(context, values[1], ty)?
        };
        let SimdValue::Array { values: indices, .. } = values[values.len() - 1] else {
            return None
        };
        let order: Vec[isize] = Vec::new();
        for index in indices {
            let index = simd_value_bits(index, simd::Element::U32)?;
            order.push(
                if index
                    >= (ty.lanes
                        * if swizzle {
                            1
                        } else {
                            2
                        }).to_u64() {
                    -1
                } else {
                    index.to_isize()
                },
            );
        }
        return Some(
            Vector(
                simd_push_node(context, simd::Node::Shuffle { left, right, indices: order }, vector),
            ),
        )
    }
    if spec.operation == "shl" || spec.operation == "shr" {
        if values.len() != 2 {
            return None
        }
        let value = simd_vector_node(context, values[0], ty)?;
        let count = (simd_value_bits(values[1], simd::Element::U32)?
            % simd::element_bits(ty.element).to_u64()).to_isize();
        return Some(
            Vector(
                simd_push_node(
                    context,
                    Shift { value, count, left: spec.operation == "shl" },
                    vector,
                ),
            ),
        )
    }
    if values.len() != 1 {
        return None
    }
    if let Some(to) = simd_conversion_type(spec) {
        let bitcast = spec.operation == "to_bits" || spec.operation == "from_bits";
        let from = if spec.operation == "from_bits" {
            simd::mask_type(ty)
        } else {
            ty
        };
        let value = simd_vector_node(context, values[0], from)?;
        return Some(
            Vector(
                simd_push_node(
                    context,
                    simd::Node::Convert { value, to, bitcast },
                    simd::ValueKind::Vector(to),
                ),
            ),
        )
    }
    match spec.operation {
        "splat" => {
            let value = simd_scalar_node(context, values[0], ty.element)?;
            Some(Vector(simd_push_node(context, simd::Node::Splat { ty, value }, vector)))
        },
        "all" => Some(Predicate(simd::Output::All(simd_mask_node(context, values[0], ty)?))),
        "any" => Some(Predicate(simd::Output::Any(simd_mask_node(context, values[0], ty)?))),
        _ => None,
    }
}

fn simd_evaluation_type(context: SimdEvaluation, ty: Type) -> bool {
    if simd_type_element(ty).is_some() {
        return true
    }
    match ty {
        Bool => true,
        Array { len, elem } => len > 0 && len <= 32 && simd_type_element(elem).is_some(),
        Named { name } => context.types[name].is_some(),
        _ => false,
    }
}

fn simd_coerce_value(value: SimdValue, ty: Type) -> Option[SimdValue] {
    if let Some(element) = simd_type_element(ty) {
        match value {
            Literal(_) | Bits { .. } => return Some(
                Bits { element, bits: simd_value_bits(value, element)? },
            ),
            _ => (),
        }
    }
    Some(value)
}

fn simd_projection_root(value: Expr) -> Option[string] {
    match value {
        Var { name } => Some(name),
        Field { expr, .. } | Unary { op: Deref, expr } => simd_projection_root(expr),
        _ => None,
    }
}

fn simd_read_only_local(function: Function, name: string) -> bool {
    let mut declared = false;
    for (parameter, _) in function.params {
        if parameter == name {
            declared = true;
        }
    }
    for statement in function.body.stmts {
        match statement {
            Var { name: local, .. } if local == name => {
                if declared {
                    return false
                }
                declared = true;
            },
            Assign { name: local, .. } if local == name => return false,
            _ => (),
        }
    }
    declared
}

fn simd_evaluate_projection(
    context: SimdEvaluation,
    locals: HashMap[string, SimdValue],
    function: Function,
    expression: Expr,
    depth: isize,
) -> Option[SimdValue] {
    let Unary { op: Address, expr } = expression else {
        return None
    };
    let Field { .. } = expr else {
        return None
    };
    if !simd_read_only_local(function, simd_projection_root(expr)?) {
        return None
    }
    let value = simd_evaluate_expression(context, locals, expr, depth + 1)?;
    let index = context.projections.len();
    context.projections.push(value);
    Some(SimdValue::Projection(index))
}

fn simd_evaluate_expression(
    context: SimdEvaluation,
    locals: HashMap[string, SimdValue],
    expression: Expr,
    depth: isize,
) -> Option[SimdValue] {
    if depth > 64 || context.budget.get() <= 0 {
        return None
    }
    context.budget.set(context.budget.get() - 1);
    match expression {
        Var { name } => locals[name],
        Float { value } | Int { value } => Some(SimdValue::Literal(value)),
        Convert { ty, expr } | Cast { ty, expr } => {
            let value = simd_evaluate_expression(context, locals, expr, depth + 1)?;
            let element = simd_type_element(ty)?;
            match value {
                Scalar(index) if context.kinds[index] == simd::ValueKind::Scalar(element) => Some(
                    value,
                ),
                Mask(_) if !simd::is_float(element) => Some(value),
                _ => Some(SimdValue::Bits { element, bits: simd_value_bits(value, element)? }),
            }
        },
        Unary { op: Neg, expr } => {
            let value = simd_evaluate_expression(context, locals, expr, depth + 1)?;
            match value {
                Literal(value) => Some(SimdValue::Literal("-" + value)),
                Bits { element, bits } => {
                    let negative = if simd::is_float(element) {
                        bits ^ (1.to_u64() << (simd::element_bits(element) - 1))
                    } else {
                        0.to_u64() - bits
                    };
                    Some(SimdValue::Bits { element, bits: negative })
                },
                _ => None,
            }
        },
        Unary { op: Deref, expr } => {
            let Projection(index) = simd_evaluate_expression(context, locals, expr, depth + 1)? else {
                return None
            };
            Some(context.projections[index])
        },
        Binary { op: BitAnd, lhs, rhs } => {
            let left = simd_evaluate_expression(context, locals, lhs, depth + 1)?;
            let right = simd_value_bits(
                simd_evaluate_expression(context, locals, rhs, depth + 1)?,
                U64,
            )?;
            if let Mask(index) = left {
                let simd::ValueKind::Mask(ty) = context.kinds[index] else {
                    return None
                };
                if right == (1.to_u64() << ty.lanes) - 1 {
                    return Some(left)
                }
                return None
            }
            Some(
                Bits {
                    element: simd::Element::U64,
                    bits: simd_value_bits(left, simd::Element::U64)? & right,
                },
            )
        },
        Field { expr, field_name } => {
            let Record(fields) = simd_evaluate_expression(context, locals, expr, depth + 1)? else {
                return None
            };
            for (name, value) in fields {
                if name == field_name {
                    return Some(value)
                }
            }
            None
        },
        StructLiteral { fields, .. } => {
            let values: Vec[(string, SimdValue)] = Vec::new();
            for (name, expression) in fields {
                values.push(
                    (name, simd_evaluate_expression(context, locals, expression, depth + 1)?),
                );
            }
            Some(SimdValue::Record(values))
        },
        ArrayLiteral { ty: Type::Array { len, elem }, items } if len == items.len() => {
            let element = simd_type_element(elem)?;
            let values: Vec[SimdValue] = Vec::new();
            for item in items {
                values.push(
                    simd_coerce_value(
                        simd_evaluate_expression(context, locals, item, depth + 1)?,
                        elem,
                    )?,
                );
            }
            Some(SimdValue::Array { element, values })
        },
        Call { func: Expr::Var { name }, args } => {
            let values: Vec[SimdValue] = Vec::new();
            for arg in args {
                values.push(simd_evaluate_expression(context, locals, arg, depth + 1)?);
            }
            if let Some(spec) = context.intrinsics[name] {
                simd_evaluate_intrinsic(context, spec, values)
            } else {
                simd_evaluate_function(context, context.functions[name]?, values, depth + 1)
            }
        },
        _ => None,
    }
}

fn simd_evaluate_function(
    context: SimdEvaluation,
    function: Function,
    arguments: Vec[SimdValue],
    depth: isize,
) -> Option[SimdValue] {
    if depth > 64 || function.params.len() != arguments.len()
        || !simd_evaluation_type(context, function.ret_ty?) {
        return None
    }
    let locals: HashMap[string, SimdValue] = HashMap::new();
    let declared: HashMap[string, Type] = HashMap::new();
    for index in 0..arguments.len() {
        let (name, ty) = function.params[index];
        if !simd_evaluation_type(context, ty) {
            return None
        }
        locals[name] = simd_coerce_value(arguments[index], ty)?;
        declared[name] = ty;
    }
    for statement in function.body.stmts {
        match statement {
            Var { name, value, ty } => {
                if let Pointer { elem } = ty {
                    if !simd_evaluation_type(context, elem) {
                        return None
                    }
                    locals[name] = simd_evaluate_projection(
                        context,
                        locals,
                        function,
                        value?,
                        depth + 1,
                    )?;
                } else {
                    if !simd_evaluation_type(context, ty) {
                        return None
                    }
                    if let Some(expression) = value {
                        locals[name] = simd_coerce_value(
                            simd_evaluate_expression(context, locals, expression, depth + 1)?,
                            ty,
                        )?;
                    }
                }
                declared[name] = ty;
            },
            Assign { name, value } => {
                let ty = declared[name]?;
                if !simd_evaluation_type(context, ty) {
                    return None
                }
                locals[name] = simd_coerce_value(
                    simd_evaluate_expression(context, locals, value, depth + 1)?,
                    ty,
                )?;
            },
            Return { expr: Some(expression) } => return simd_coerce_value(
                simd_evaluate_expression(context, locals, expression, depth + 1)?,
                function.ret_ty?,
            ),
            _ => return None,
        }
    }
    None
}

fn simd_record_value(value: SimdValue, field: string) -> Option[SimdValue] {
    if let Record(fields) = value {
        if fields.len() == 1 && fields[0].0 == field {
            return Some(fields[0].1)
        }
    }
    None
}

fn simd_native_function(
    functions: HashMap[string, Function],
    intrinsics: HashMap[string, SimdIntrinsic],
    types: HashMap[string, (string, simd::ValueKind)],
    function: Function,
) -> Option[json::Value] {
    if function.params.len() > 8 {
        return None
    }
    let ret_ty = function.ret_ty?;
    let context = SimdEvaluation {
        functions,
        intrinsics,
        types,
        nodes: Vec::new(),
        kinds: Vec::new(),
        projections: Vec::new(),
        budget: Ref::new(4096),
        operations: Ref::new(0),
    };
    let args: Vec[SimdValue] = Vec::new();
    let parameters: Vec[simd::Parameter] = Vec::new();
    for (name, ty) in function.params {
        if let Named { name: type_name } = ty {
            let (field, kind) = types[type_name]?;
            let index = simd_push_node(context, simd::Node::Input(parameters.len()), kind);
            parameters.push(simd::Parameter { name, kind });
            let value = match kind {
                Vector(_) => Vector(index),
                Mask(_) => Mask(index),
                _ => return None,
            };
            args.push(SimdValue::Record(Vec::from_array([(field, value)])));
        } else {
            let element = simd_type_element(ty)?;
            let kind = simd::ValueKind::Scalar(element);
            let index = simd_push_node(context, simd::Node::Input(parameters.len()), kind);
            parameters.push(simd::Parameter { name, kind });
            args.push(SimdValue::Scalar(index));
        }
    }
    let value = simd_evaluate_function(context, function, args, 0)?;
    if context.operations.get() == 0 {
        return None
    }
    let output = if let Named { name } = ret_ty {
        let (field, kind) = types[name]?;
        let value = simd_record_value(value, field)?;
        match kind {
            Vector(ty) => simd::Output::Vector(simd_vector_node(context, value, ty)?),
            Mask(ty) => simd::Output::Mask(simd_mask_node(context, value, ty)?),
            _ => return None,
        }
    } else {
        match value {
            Scalar(index) => {
                if context.kinds[index] != simd::ValueKind::Scalar(simd_type_element(ret_ty)?) {
                    return None
                }
                simd::Output::Scalar(index)
            },
            Mask(index) => {
                let simd::ValueKind::Mask(ty) = context.kinds[index] else {
                    return None
                };
                if simd_type_element(ret_ty) != simd_type_element(simd_bitmask_type(ty)) {
                    return None
                }
                simd::Output::Mask(index)
            },
            Predicate(output) => {
                let Type::Bool = ret_ty else {
                    return None
                };
                output
            },
            _ => return None,
        }
    };
    let features = simd::kernel_features(parameters, context.nodes)?;
    let avx2 = features.0;
    let fma = features.1;
    let name = if avx2 || fma {
        go_generated_ident(
            "_goml_simd_"
                + if avx2 {
                    "avx2_"
                } else {
                    ""
                }
                + if fma {
                    "fma_"
                } else {
                    ""
                }
                + function.name,
        )
    } else {
        function.name
    };
    let assembly = simd::emit_amd64(name, parameters, context.nodes, output)?;
    let mut declaration = pretty::pretty(
        100,
        pretty::concat(
            Vec::from_array(
                [
                    pretty::text("func " + name),
                    named_params_doc(function.params),
                    optional_result_doc(function.ret_ty),
                ],
            ),
        ),
    );
    if avx2 || fma {
        let arguments: Vec[Expr] = Vec::new();
        for (name, _) in function.params {
            arguments.push(simd_var(name));
        }
        let condition = if avx2 && fma {
            simd_binary(And, simd_var("_goml_simd_has_avx2"), simd_var("_goml_simd_has_fma"))
        } else {
            simd_var(
                if avx2 {
                    "_goml_simd_has_avx2"
                } else {
                    "_goml_simd_has_fma"
                },
            )
        };
        let stmts = Vec::from_array(
            [
                Stmt::If {
                    cond: condition,
                    then_: Block {
                        stmts: Vec::from_array([simd_return(simd_call(name, arguments))]),
                    },
                    else_: Option::None,
                },
            ],
        );
        for statement in function.body.stmts {
            stmts.push(statement);
        }
        let wrapper = Function {
            name: function.name,
            params: function.params,
            ret_ty: function.ret_ty,
            body: Block { stmts },
        };
        declaration = declaration + "\n\n" + pretty::pretty(100, function_doc(wrapper));
    }
    Some(
        json::object(
            Vec::from_array(
                [
                    ("fallback", json::Value::String(pretty::pretty(100, function_doc(function)))),
                    ("declaration", json::Value::String(declaration)),
                    ("assembly", json::Value::String(assembly)),
                    ("avx2", json::Value::Bool(avx2)),
                    ("fma", json::Value::Bool(fma)),
                ],
            ),
        ),
    )
}

fn simd_native_metadata(file: File) -> string {
    let types: HashMap[string, (string, simd::ValueKind)] = HashMap::new();
    for ty in simd::vector_types() {
        for item in file.items {
            if let Struct(value) = item {
                if value.fields.len() != 1 {
                    continue
                }
                let (field, field_type) = value.fields[0];
                if value.name == go_user_type_name("std::simd::" + simd::vector_name(ty)) {
                    if let Type::Array { len, elem } = field_type {
                        if len == ty.lanes && simd_type_element(elem) == Option::Some(ty.element) {
                            types[value.name] = (field, simd::ValueKind::Vector(ty));
                        }
                    }
                } else if value.name == go_user_type_name("std::simd::" + simd::mask_name(ty))
                    && simd_type_element(field_type) == simd_type_element(simd_bitmask_type(ty)) {
                    types[value.name] = (field, simd::ValueKind::Mask(simd::mask_type(ty)));
                }
            }
        }
    }
    if types.len() == 0 {
        return ""
    }
    let functions: HashMap[string, Function] = HashMap::new();
    for item in file.items {
        if let Function(value) = item {
            functions[value.name] = value;
        }
    }
    let intrinsics: HashMap[string, SimdIntrinsic] = HashMap::new();
    for spec in resources::intrinsic_abi_specs() {
        if let Some(value) = simd_intrinsic(spec.key) {
            intrinsics[simd_intrinsic_name(spec.key)] = value;
        }
    }
    let kernels: Vec[json::Value] = Vec::new();
    for item in file.items {
        if let Function(value) = item {
            if let Some(kernel) = simd_native_function(functions, intrinsics, types, value) {
                kernels.push(kernel);
            }
        }
    }
    if kernels.is_empty() {
        ""
    } else {
        let payload = json::object(
            Vec::from_array(
                [("version", json::Value::Number("1")), ("kernels", json::Value::Array(kernels))],
            ),
        );
        "\nconst _goml_simd_native = " + json::encode(json::Value::String(json::encode(payload)))
            + "\n"
    }
}
