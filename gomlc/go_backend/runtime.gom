package go_backend;

use module::anf;
use module::resources;
use module::repr;
use module::tast;
use std::cmp;
use std::collections;
use std::text;

struct DynMethod {
    name: string,
    dispatch_trait: string,
    params: Vec[repr::Type],
    ret_ty: repr::Type,
}

fn hashmap_name(key: repr::Type, value: repr::Type) -> string {
    go_generated_ident("hashmap_" + go_ident(encode_type(key) + "_" + encode_type(value)) + "_x")
}

fn ref_struct_name(elem: repr::Type) -> string {
    go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x")
}

pub fn runtime_helper_name(prefix: string, ty: repr::Type) -> string {
    go_generated_ident(prefix + "__" + go_ident(encode_type(ty)))
}

pub fn runtime_hook_name(key: string) -> string {
    let builder = text::StringBuilder::with_capacity("_goml_runtime_".byte_len() + key.byte_len());
    builder.write_string("_goml_runtime_");
    for character in key.chars() {
        if character == '.' {
            builder.write_char('_')
        } else {
            builder.write_char(character)
        }
    }
    go_generated_ident(builder.finish())
}

fn missing_base_item() -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let print_args: Vec[Expr] = Vec::new();
    print_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::String { value: "missing: " },
            rhs: Expr::Var { name: "s" },
        },
    );
    let panic_args: Vec[Expr] = Vec::new();
    panic_args.push(Expr::String { value: "" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "println" }, args: print_args } },
    );
    stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "panic" }, args: panic_args } },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: go_generated_ident("_goml_intrinsic_missing"),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn missing_runtime_item(ty: repr::Type) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(Expr::Var { name: "s" });
    let ret_ty = lower_type(ty);
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Expr {
            expr: Expr::Call {
                func: Expr::Var { name: go_generated_ident("_goml_intrinsic_missing") },
                args,
            },
        },
    );
    stmts.push(Stmt::Var { name: "ret", ty: ret_ty, value: Option::None });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "ret" }) });
    Item::Function(
        Function {
            name: runtime_helper_name("missing", ty),
            params,
            ret_ty: Option::Some(ret_ty),
            body: Block { stmts },
        },
    )
}

fn once_cell_field(name: string) -> Expr {
    Expr::Field { expr: Expr::Var { name: "cell" }, field_name: name }
}

fn once_cell_method(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: Expr::Field { expr: Expr::Var { name: "cell" }, field_name: name }, args }
}

fn once_cell_lock_stmt(method: string) -> Stmt {
    Stmt::Expr { expr: once_cell_method("mutex." + method, Vec::new()) }
}

fn once_cell_new_item(instance: repr::TypeInstance) -> Item {
    let owner = repr::Type::Named { name: instance.name };
    let fields: Vec[(string, Expr)] = Vec::new();
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "cell",
            ty: lower_type(owner),
            value: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: go_user_type_name(instance.name) },
                        fields,
                    },
                },
            ),
        },
    );
    let cond_args: Vec[Expr] = Vec::new();
    cond_args.push(Expr::Unary { op: UnaryOp::Address, expr: once_cell_field("mutex") });
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "cond",
            value: Expr::Call { func: Expr::Var { name: "_goml_sync.NewCond" }, args: cond_args },
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "cell" }) });
    Item::Function(
        Function {
            name: runtime_helper_name("once_cell_new", owner),
            params: Vec::new(),
            ret_ty: Option::Some(lower_type(owner)),
            body: Block { stmts },
        },
    )
}

fn once_cell_get_or_init_item(instance: repr::TypeInstance) -> Item {
    let owner = repr::Type::Named { name: instance.name };
    let value_ty = instance.args[0];
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("cell", lower_type(owner)));
    params.push(("init", Type::Func { params: Vec::new(), ret_ty: lower_type(value_ty) }));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(once_cell_lock_stmt("Lock"));
    let loop_stmts: Vec[Stmt] = Vec::new();
    let ready_stmts: Vec[Stmt] = Vec::new();
    ready_stmts.push(once_cell_lock_stmt("Unlock"));
    ready_stmts.push(Stmt::Return { expr: Option::Some(once_cell_field("value")) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("state"),
                rhs: Expr::Int { value: "2" },
            },
            then_: Block { stmts: ready_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "goroutine",
            ty: Type::Uint64,
            value: Option::Some(
                Expr::Call {
                    func: Expr::Var { name: go_generated_ident("_goml_once_cell_goroutine_id") },
                    args: Vec::new(),
                },
            ),
        },
    );
    let initializing_stmts: Vec[Stmt] = Vec::new();
    let recursive_stmts: Vec[Stmt] = Vec::new();
    recursive_stmts.push(once_cell_lock_stmt("Unlock"));
    let panic_args: Vec[Expr] = Vec::new();
    panic_args.push(
        Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::String { value: "recursive OnceCell initialization: " },
            rhs: once_cell_field("name"),
        },
    );
    recursive_stmts.push(
        Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "panic" }, args: panic_args } },
    );
    initializing_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("owner"),
                rhs: Expr::Var { name: "goroutine" },
            },
            then_: Block { stmts: recursive_stmts },
            else_: Option::None,
        },
    );
    initializing_stmts.push(Stmt::Expr { expr: once_cell_method("cond.Wait", Vec::new()) });
    initializing_stmts.push(Stmt::Continue);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: once_cell_field("state"),
                rhs: Expr::Int { value: "1" },
            },
            then_: Block { stmts: initializing_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "state",
            value: Expr::Int { value: "1" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "owner",
            value: Expr::Var { name: "goroutine" },
        },
    );
    loop_stmts.push(once_cell_lock_stmt("Unlock"));
    loop_stmts.push(
        Stmt::Var {
            name: "completed",
            ty: Type::Bool,
            value: Option::Some(Expr::Bool { value: false }),
        },
    );
    loop_stmts.push(
        Stmt::Defer {
            call: Expr::Call {
                func: Expr::FuncLit {
                    params: Vec::new(),
                    ret_ty: Type::Void,
                    body: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::If {
                                    cond: Expr::Unary {
                                        op: UnaryOp::Not,
                                        expr: Expr::Var { name: "completed" },
                                    },
                                    then_: Block {
                                        stmts: Vec::from_array(
                                            [
                                                once_cell_lock_stmt("Lock"),
                                                Stmt::FieldAssign {
                                                    target: Expr::Var { name: "cell" },
                                                    field_name: "state",
                                                    value: Expr::Int { value: "0" },
                                                },
                                                Stmt::FieldAssign {
                                                    target: Expr::Var { name: "cell" },
                                                    field_name: "owner",
                                                    value: Expr::Int { value: "0" },
                                                },
                                                Stmt::Expr {
                                                    expr: once_cell_method(
                                                        "cond.Broadcast",
                                                        Vec::new(),
                                                    ),
                                                },
                                                once_cell_lock_stmt("Unlock"),
                                            ],
                                        ),
                                    },
                                    else_: Option::None,
                                },
                            ],
                        ),
                    },
                },
                args: Vec::new(),
            },
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "initialized",
            ty: lower_type(value_ty),
            value: Option::Some(Expr::Call { func: Expr::Var { name: "init" }, args: Vec::new() }),
        },
    );
    loop_stmts.push(once_cell_lock_stmt("Lock"));
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "value",
            value: Expr::Var { name: "initialized" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "state",
            value: Expr::Int { value: "2" },
        },
    );
    loop_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "cell" },
            field_name: "owner",
            value: Expr::Int { value: "0" },
        },
    );
    loop_stmts.push(Stmt::Expr { expr: once_cell_method("cond.Broadcast", Vec::new()) });
    loop_stmts.push(Stmt::Assign { name: "completed", value: Expr::Bool { value: true } });
    loop_stmts.push(once_cell_lock_stmt("Unlock"));
    loop_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "initialized" }) });
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    Item::Function(
        Function {
            name: runtime_helper_name("once_cell_get_or_init", owner),
            params,
            ret_ty: Option::Some(lower_type(value_ty)),
            body: Block { stmts },
        },
    )
}

pub fn emit_missing_base_item(items: Vec[Item], missing_types: Vec[repr::Type]) -> () {
    if !missing_types.is_empty() {
        items.push(missing_base_item())
    }
}

fn unit_to_string_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", Type::Unit));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "()" }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn bool_to_string_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", Type::Bool));
    let then_stmts: Vec[Stmt] = Vec::new();
    then_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "true" }) });
    let else_stmts: Vec[Stmt] = Vec::new();
    else_stmts.push(Stmt::Return { expr: Option::Some(Expr::String { value: "false" }) });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "x" },
            then_: Block { stmts: then_stmts },
            else_: Option::Some(Block { stmts: else_stmts }),
        },
    );
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn integer_to_string_hook_item(key: string, ty: Type, signed: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("x", ty));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "negative",
            ty: Type::Bool,
            value: Option::Some(
                if signed {
                    Expr::Binary {
                        op: BinaryOp::Less,
                        lhs: Expr::Var { name: "x" },
                        rhs: Expr::Int { value: "0" },
                    }
                } else {
                    Expr::Bool { value: false }
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "value",
            ty: Type::Uint64,
            value: Option::Some(Expr::Convert { ty: Type::Uint64, expr: Expr::Var { name: "x" } }),
        },
    );
    if signed {
        stmts.push(
            Stmt::If {
                cond: Expr::Var { name: "negative" },
                then_: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::Assign {
                                name: "value",
                                value: Expr::Binary {
                                    op: BinaryOp::Sub,
                                    lhs: Expr::Int { value: "0" },
                                    rhs: Expr::Var { name: "value" },
                                },
                            },
                        ],
                    ),
                },
                else_: Option::None,
            },
        )
    }
    stmts.push(
        Stmt::Var {
            name: "buffer",
            ty: Type::Slice { elem: Type::Uint8 },
            value: Option::Some(
                Expr::Make {
                    ty: Type::Slice { elem: Type::Uint8 },
                    args: Vec::from_array([Expr::Int { value: "21" }]),
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "index", ty: Type::Int, value: Option::Some(Expr::Int { value: "21" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    loop_stmts.push(
        Stmt::Assign {
            name: "index",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    loop_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "buffer" },
            index: Expr::Var { name: "index" },
            value: Expr::Convert {
                ty: Type::Uint8,
                expr: Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: Expr::Binary {
                        op: BinaryOp::Rem,
                        lhs: Expr::Var { name: "value" },
                        rhs: Expr::Int { value: "10" },
                    },
                    rhs: Expr::Int { value: "48" },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "value",
            value: Expr::Binary {
                op: BinaryOp::Div,
                lhs: Expr::Var { name: "value" },
                rhs: Expr::Int { value: "10" },
            },
        },
    );
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Var { name: "value" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: Vec::from_array([Stmt::Break]) },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    let negative_stmts: Vec[Stmt] = Vec::new();
    negative_stmts.push(
        Stmt::Assign {
            name: "index",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    negative_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "buffer" },
            index: Expr::Var { name: "index" },
            value: Expr::Int { value: "45" },
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "negative" },
            then_: Block { stmts: negative_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Convert {
                    ty: Type::String,
                    expr: Expr::Slice {
                        base: Expr::Var { name: "buffer" },
                        start: Expr::Var { name: "index" },
                        end: Expr::Int { value: "21" },
                    },
                },
            ),
        },
    );
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

fn string_output_hook_item(key: string, newline: bool) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("s", Type::String));
    let args: Vec[Expr] = Vec::new();
    args.push(
        if newline {
            Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "s" },
                rhs: Expr::String { value: "\n" },
            }
        } else {
            Expr::Var { name: "s" }
        },
    );
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Expr {
            expr: Expr::Call { func: Expr::Var { name: "_goml_os.Stdout.WriteString" }, args },
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn string_from_utf8_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    let byte_vec = repr::Type::VecType { elem: repr::Type::Uint8 };
    params.push(("bytes", lower_type(byte_vec)));
    let tuple_items: Vec[repr::Type] = Vec::new();
    tuple_items.push(repr::Type::Bool);
    tuple_items.push(repr::Type::String);
    let tuple_ty = lower_type(repr::Type::Tuple { items: tuple_items });
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("_0", Expr::Bool { value: true }));
    fields.push(
        (
            "_1",
            Expr::Convert {
                ty: Type::String,
                expr: Expr::Field { expr: Expr::Var { name: "bytes" }, field_name: "items" },
            },
        ),
    );
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Return { expr: Option::Some(Expr::StructLiteral { ty: tuple_ty, fields }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(tuple_ty),
            body: Block { stmts },
        },
    )
}

fn string_concat_hook_item(key: string) -> Item {
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("values", lower_type(repr::Type::VecType { elem: repr::Type::String })));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "result",
            ty: Type::String,
            value: Option::Some(Expr::String { value: "" }),
        },
    );
    stmts.push(
        Stmt::Range {
            names: Vec::from_array(["_", "value"]),
            expr: Expr::Field { expr: Expr::Var { name: "values" }, field_name: "items" },
            body: Block {
                stmts: Vec::from_array(
                    [
                        Stmt::Assign {
                            name: "result",
                            value: Expr::Binary {
                                op: BinaryOp::Add,
                                lhs: Expr::Var { name: "result" },
                                rhs: Expr::Var { name: "value" },
                            },
                        },
                    ],
                ),
            },
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "result" }) });
    Item::Function(
        Function {
            name: runtime_hook_name(key),
            params,
            ret_ty: Option::Some(Type::String),
            body: Block { stmts },
        },
    )
}

#[derive(PartialEq, Eq, Hash)]
enum RuntimeImport {
    Fmt,
    Debug,
    Bytes,
    Context,
    CryptoRand,
    Net,
    Tls,
    X509,
    Errors,
    Hash,
    Io,
    Math,
    Os,
    Exec,
    Filepath,
    Reflect,
    Sha256,
    Sync,
    Runtime,
    Syscall,
    Time,
    Unsafe,
}

fn require_runtime_import(imports: collections::IndexSet[RuntimeImport], value: RuntimeImport) -> () {
    let _ = imports.insert(value);
}

fn collect_core_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::CoreRuntimeHook,
) -> () {
    match hook {
        DeferPush | DeferPop => (),
        StringPrint | StringPrintln => require_runtime_import(imports, RuntimeImport::Os),
        Float32Hash | Float64Hash => require_runtime_import(imports, RuntimeImport::Math),
        UnitToString | BoolToString | StringLen | StringGet | StringByteGet | StringByteSlice | StringToBytes | StringFromUtf8 | StringConcat | CharToString | CharFromUint32 | IntToString | Int8ToString | Int16ToString | Int32ToString | Int64ToString | UintToString | Uint8ToString | Uint16ToString | Uint32ToString | Uint64ToString | IntHash | Int8Hash | Int16Hash | Int32Hash | Int64Hash | CharHash | UintHash | Uint8Hash | Uint16Hash | Uint32Hash | StringHash => (),
    }
}

fn collect_fs_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::FsRuntimeHook,
) -> () {
    match hook {
        Canonicalize => require_runtime_import(imports, RuntimeImport::Filepath),
        Sha256File => {
            require_runtime_import(imports, RuntimeImport::Hash);
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Sha256)
        },
        ReadBytesV2 | WriteBytesV2 | PathOperationV2 | MetadataV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
        AtomicWriteV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall);
            require_runtime_import(imports, RuntimeImport::Filepath)
        },
        ReadFile | WriteFile | ReadBytes | WriteBytes | CreateDirAll | RemoveFile | RemoveDirAll | FileExists | IsFile | IsDir | ReadDir | ReadDirV2 => {
            require_runtime_import(imports, RuntimeImport::Os)
        },
    }
}

fn collect_io_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::IoRuntimeHook,
) -> () {
    match hook {
        Print | Println | Eprint => require_runtime_import(imports, RuntimeImport::Os),
        ReadStdin | ReadStdinExact => {
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os)
        },
        ReadStdinV2 | ReadStdinExactV2 | ReadStdinChunkV2 => {
            require_runtime_import(imports, RuntimeImport::Io);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
        WriteStdout | WriteStderr => require_runtime_import(imports, RuntimeImport::Os),
        WriteStdoutV2 | WriteStderrV2 => {
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
    }
}

fn collect_path_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::PathRuntimeHook,
) -> () {
    require_runtime_import(imports, RuntimeImport::Filepath);
    match hook {
        Separator => require_runtime_import(imports, RuntimeImport::Os),
        Join | Clean | IsAbsolute | Parent | FileName | Extension | FileStem | WithExtension | Absolute | Relative => (),
    }
}

fn collect_process_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::ProcessRuntimeHook,
) -> () {
    match hook {
        Exit => require_runtime_import(imports, RuntimeImport::Os),
        LookPath => require_runtime_import(imports, RuntimeImport::Exec),
        Output | Status => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec)
        },
        OutputTimeout | StatusTimeout => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec);
            require_runtime_import(imports, RuntimeImport::Context);
            require_runtime_import(imports, RuntimeImport::Time)
        },
        OutputCancel | StatusCancel => {
            require_runtime_import(imports, RuntimeImport::Bytes);
            require_runtime_import(imports, RuntimeImport::Os);
            require_runtime_import(imports, RuntimeImport::Exec);
            require_runtime_import(imports, RuntimeImport::Context);
            require_runtime_import(imports, RuntimeImport::Sync);
            require_runtime_import(imports, RuntimeImport::Syscall)
        },
    }
}

fn collect_task_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::TaskRuntimeHook,
) -> () {
    require_runtime_import(imports, RuntimeImport::Context);
    require_runtime_import(imports, RuntimeImport::Sync);
    match hook {
        Sleep => require_runtime_import(imports, RuntimeImport::Time),
        ScopeNew | ScopeRun | ScopeSpawn | ScopeTrySpawn | ScopeCancel | ScopeFinish | ScopeCancelled | ScopeDone | ActiveScopeCount => (),
    }
}

fn collect_standard_runtime_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::StandardRuntimeHook,
) -> () {
    match hook {
        PanicRaise => (),
        PanicCatch => {
            require_runtime_import(imports, RuntimeImport::Fmt);
            require_runtime_import(imports, RuntimeImport::Debug)
        },
        LinuxSyscall6 | LinuxSyscall6Pointers => {
            require_runtime_import(imports, RuntimeImport::Runtime);
            require_runtime_import(imports, RuntimeImport::Syscall);
            require_runtime_import(imports, RuntimeImport::Unsafe)
        },
        LinuxProcessSpawn => {
            require_runtime_import(imports, RuntimeImport::Runtime);
            require_runtime_import(imports, RuntimeImport::Exec);
            require_runtime_import(imports, RuntimeImport::Syscall);
            require_runtime_import(imports, RuntimeImport::Errors)
        },
        Env(Args | CurrentDir | CurrentExe | Var | Vars) => {
            require_runtime_import(imports, RuntimeImport::Os)
        },
        Fs(hook) => collect_fs_runtime_imports(imports, hook),
        Io(hook) => collect_io_runtime_imports(imports, hook),
        Path(hook) => collect_path_runtime_imports(imports, hook),
        Process(hook) => collect_process_runtime_imports(imports, hook),
        TestingFail => {
            require_runtime_import(imports, RuntimeImport::Os)
        },
        Math(Float32Unary | Float32Pow) => {
            require_runtime_import(imports, RuntimeImport::Math)
        },
        Crypto(RandomBytes) => require_runtime_import(imports, RuntimeImport::CryptoRand),
        Time(MonotonicNanoseconds | UnixNanoseconds | SleepNanoseconds) => {
            require_runtime_import(imports, RuntimeImport::Time)
        },
        Time(TimerNew | TimerStop) => {
            require_runtime_import(imports, RuntimeImport::Time);
            require_runtime_import(imports, RuntimeImport::Sync)
        },
        Task(hook) => collect_task_runtime_imports(imports, hook),
        Network(_) => {
            require_runtime_import(imports, RuntimeImport::Context);
            require_runtime_import(imports, RuntimeImport::Sync);
            require_runtime_import(imports, RuntimeImport::Time);
            require_runtime_import(imports, RuntimeImport::Net);
            require_runtime_import(imports, RuntimeImport::Tls);
            require_runtime_import(imports, RuntimeImport::X509);
            require_runtime_import(imports, RuntimeImport::Io)
        },
    }
}

fn collect_runtime_hook_imports(
    imports: collections::IndexSet[RuntimeImport],
    hook: resources::RuntimeHook,
) -> () {
    match hook {
        Core(hook) => collect_core_runtime_imports(imports, hook),
        Standard(hook) => collect_standard_runtime_imports(imports, hook),
    }
}

fn runtime_hook_uses_structured_error(hook: resources::RuntimeHook) -> bool {
    match hook {
        Standard(Fs(ReadBytesV2 | WriteBytesV2 | PathOperationV2 | MetadataV2 | AtomicWriteV2)) | Standard(Io(ReadStdinV2 | ReadStdinExactV2 | ReadStdinChunkV2 | WriteStdoutV2 | WriteStderrV2)) => true,
        Core(_) | Standard(_) => false,
    }
}

fn needs_structured_runtime_error(hooks: Vec[resources::RuntimeHook]) -> bool {
    for hook in hooks {
        if runtime_hook_uses_structured_error(hook) {
            return true
        }
    }
    false
}

fn runtime_hook_needs_task_support(hook: resources::RuntimeHook) -> bool {
    match hook {
        Core(_) => false,
        Standard(Task(_) | Network(_)) => true,
        Standard(Process(process)) => match process {
            OutputCancel | StatusCancel => true,
            Exit | LookPath | Output | OutputTimeout | Status | StatusTimeout => false,
        },
        Standard(PanicRaise | PanicCatch | LinuxSyscall6 | LinuxSyscall6Pointers | LinuxProcessSpawn | Env(_) | Fs(_) | Io(_) | Path(_) | TestingFail | Math(_) | Crypto(_) | Time(_)) => false,
    }
}

fn emit_runtime_import_items(items: Vec[Item], required: collections::IndexSet[RuntimeImport]) -> () {
    if required.is_empty() {
        return
    }
    let imports: Vec[(string, string)] = Vec::new();
    if required.contains(RuntimeImport::Fmt) {
        imports.push(("_goml_fmt", "fmt"))
    }
    if required.contains(RuntimeImport::Debug) {
        imports.push(("_goml_debug", "runtime/debug"))
    }
    if required.contains(RuntimeImport::Net) {
        imports.push(("_goml_net", "net"))
    }
    if required.contains(RuntimeImport::Tls) {
        imports.push(("_goml_tls", "crypto/tls"))
    }
    if required.contains(RuntimeImport::X509) {
        imports.push(("_goml_x509", "crypto/x509"))
    }
    if required.contains(RuntimeImport::Bytes) {
        imports.push(("_goml_bytes", "bytes"))
    }
    if required.contains(RuntimeImport::Context) {
        imports.push(("_goml_context", "context"))
    }
    if required.contains(RuntimeImport::CryptoRand) {
        imports.push(("_goml_cryptorand", "crypto/rand"))
    }
    if required.contains(RuntimeImport::Errors) {
        imports.push(("_goml_errors", "errors"))
    }
    if required.contains(RuntimeImport::Hash) {
        imports.push(("_goml_hash", "hash"))
    }
    if required.contains(RuntimeImport::Io) {
        imports.push(("_goml_io", "io"))
    }
    if required.contains(RuntimeImport::Math) {
        imports.push(("_goml_math", "math"))
    }
    if required.contains(RuntimeImport::Os) {
        imports.push(("_goml_os", "os"))
    }
    if required.contains(RuntimeImport::Exec) {
        imports.push(("_goml_exec", "os/exec"))
    }
    if required.contains(RuntimeImport::Filepath) {
        imports.push(("_goml_filepath", "path/filepath"))
    }
    if required.contains(RuntimeImport::Reflect) {
        imports.push(("_goml_reflect", "reflect"))
    }
    if required.contains(RuntimeImport::Sha256) {
        imports.push(("_goml_sha256", "crypto/sha256"))
    }
    if required.contains(RuntimeImport::Sync) {
        imports.push(("_goml_sync", "sync"))
    }
    if required.contains(RuntimeImport::Runtime) {
        imports.push(("_goml_runtime_pkg", "runtime"))
    }
    if required.contains(RuntimeImport::Syscall) {
        imports.push(("_goml_syscall", "syscall"))
    }
    if required.contains(RuntimeImport::Time) {
        imports.push(("_goml_time", "time"))
    }
    if required.contains(RuntimeImport::Unsafe) {
        imports.push(("_goml_unsafe", "unsafe"))
    }
    items.push(Item::ImportGroup(imports))
}

fn once_cell_goroutine_id_item() -> Item {
    let bytes_ty = Type::Slice { elem: Type::Uint8 };
    let make_args: Vec[Expr] = Vec::new();
    make_args.push(Expr::Int { value: "64" });
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "buffer",
            ty: bytes_ty,
            value: Option::Some(Expr::Make { ty: bytes_ty, args: make_args }),
        },
    );
    let stack_args: Vec[Expr] = Vec::new();
    stack_args.push(Expr::Var { name: "buffer" });
    stack_args.push(Expr::Bool { value: false });
    stmts.push(
        Stmt::Var {
            name: "length",
            ty: Type::Int,
            value: Option::Some(
                Expr::Call { func: Expr::Var { name: "_goml_runtime_pkg.Stack" }, args: stack_args },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "index", ty: Type::Int, value: Option::Some(Expr::Int { value: "10" }) },
    );
    stmts.push(
        Stmt::Var {
            name: "result",
            ty: Type::Uint64,
            value: Option::Some(Expr::Int { value: "0" }),
        },
    );
    let digit = Expr::Index {
        base: Expr::Var { name: "buffer" },
        index: Expr::Var { name: "index" },
    };
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    let loop_stmts: Vec[Stmt] = Vec::new();
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Var { name: "length" },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    let invalid_stmts: Vec[Stmt] = Vec::new();
    invalid_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Or,
                lhs: Expr::Binary { op: BinaryOp::Less, lhs: digit, rhs: Expr::Int { value: "48" } },
                rhs: Expr::Binary {
                    op: BinaryOp::Greater,
                    lhs: digit,
                    rhs: Expr::Int { value: "57" },
                },
            },
            then_: Block { stmts: invalid_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "result",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Binary {
                    op: BinaryOp::Mul,
                    lhs: Expr::Var { name: "result" },
                    rhs: Expr::Int { value: "10" },
                },
                rhs: Expr::Convert {
                    ty: Type::Uint64,
                    expr: Expr::Binary {
                        op: BinaryOp::Sub,
                        lhs: digit,
                        rhs: Expr::Int { value: "48" },
                    },
                },
            },
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "index",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "index" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "result" }) });
    Item::Function(
        Function {
            name: go_generated_ident("_goml_once_cell_goroutine_id"),
            params: Vec::new(),
            ret_ty: Option::Some(Type::Uint64),
            body: Block { stmts },
        },
    )
}

pub fn emit_runtime_hook_items(
    items: Vec[Item],
    hooks: Vec[resources::RuntimeHook],
    intrinsics: Vec[string],
) -> () {
    let required_imports = collections::IndexSet::new();
    for hook in hooks {
        collect_runtime_hook_imports(required_imports, hook)
    }
    for intrinsic in intrinsics {
        if let Some(spec) = simd_intrinsic(intrinsic) {
            if simd_math_required(spec) {
                require_runtime_import(required_imports, RuntimeImport::Math);
            }
        }
        if intrinsic == "ref.ptr_hash" {
            require_runtime_import(required_imports, RuntimeImport::Reflect)
        } else if intrinsic == "channel.dynamic_select" || intrinsic == "channel.dynamic_try_select"
            || intrinsic == "channel.dynamic_try_select_priority" {
            require_runtime_import(required_imports, RuntimeImport::Reflect)
        } else if intrinsic == "channel.send_cancel" || intrinsic == "channel.recv_cancel" {
            require_runtime_import(required_imports, RuntimeImport::Context);
            require_runtime_import(required_imports, RuntimeImport::Sync)
        } else if intrinsic == "once_cell.new" || intrinsic == "once_cell.get_or_init" {
            require_runtime_import(required_imports, RuntimeImport::Sync);
            require_runtime_import(required_imports, RuntimeImport::Runtime)
        }
    }
    let uses_structured_error = needs_structured_runtime_error(hooks);
    if uses_structured_error {
        require_runtime_import(required_imports, RuntimeImport::Errors);
        require_runtime_import(required_imports, RuntimeImport::Io);
        require_runtime_import(required_imports, RuntimeImport::Os);
        require_runtime_import(required_imports, RuntimeImport::Syscall)
    }
    emit_runtime_import_items(items, required_imports);
    let mut needs_defer_support = false;
    let mut needs_panic_support = false;
    for hook in hooks {
        match hook {
            Core(DeferPush | DeferPop) => {
                needs_defer_support = true;
            },
            Standard(PanicCatch) => {
                needs_panic_support = true;
            },
            _ => (),
        }
    }
    if needs_defer_support {
        for item in defer_support_items() {
            items.push(item)
        }
    }
    if needs_panic_support {
        for item in panic_support_items() {
            items.push(item)
        }
    }
    for intrinsic in intrinsics {
        if let Some(spec) = simd_intrinsic(intrinsic) {
            for item in simd_intrinsic_items(intrinsic, spec) {
                items.push(item)
            }
        }
    }
    if intrinsics.contains("once_cell.new") || intrinsics.contains("once_cell.get_or_init") {
        items.push(once_cell_goroutine_id_item())
    }
    let mut needs_network_support = false;
    for hook in hooks {
        if let Standard(Network(_)) = hook {
            needs_network_support = true;
        }
    }
    if needs_network_support {
        for item in network_registry_items() {
            items.push(item)
        }
    }
    let mut needs_timer_support = false;
    for hook in hooks {
        if let Standard(Time(TimerNew | TimerStop)) = hook {
            needs_timer_support = true;
        }
    }
    if needs_timer_support {
        for item in std_time_timer_support_items() {
            items.push(item)
        }
    }
    let mut needs_task_support = false;
    for hook in hooks {
        if runtime_hook_needs_task_support(hook) {
            needs_task_support = true;
        }
    }
    for intrinsic in intrinsics {
        if intrinsic == "channel.send_cancel" || intrinsic == "channel.recv_cancel" {
            needs_task_support = true;
        }
    }
    if needs_task_support {
        for item in task_runtime_support_items() {
            items.push(item)
        }
    }
    if uses_structured_error {
        items.push(std_runtime_error_kind_item());
        items.push(std_runtime_error_raw_code_item())
    }
    for spec in resources::runtime_abi_specs() {
        if hooks.contains(spec.hook) {
            match spec.hook {
                Core(hook) => items.push(core_runtime_hook_item(hook, spec.key)),
                Standard(hook) => {
                    match hook {
                        Time(MonotonicNanoseconds) => {
                            items.push(std_time_monotonic_origin_item())
                        },
                        PanicRaise | PanicCatch | LinuxSyscall6 | LinuxSyscall6Pointers | LinuxProcessSpawn | Env(_) | Fs(_) | Io(_) | Path(_) | Process(_) | TestingFail | Math(_) | Crypto(_) | Time(UnixNanoseconds | SleepNanoseconds | TimerNew | TimerStop) | Task(_) | Network(_) => (),
                    }
                    items.push(standard_runtime_hook_item(hook, spec.key))
                },
            }
        }
    }
}

pub fn ref_helper_name(prefix: string, ref_ty: repr::Type) -> string {
    runtime_helper_name(prefix, ref_ty)
}

fn array_runtime_items(array_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    if let Array { len: _, elem } = repr::resolve_type(array_ty) {
        let lowered_array = lower_type(array_ty);
        let lowered_elem = lower_type(elem);
        let get_params: Vec[(string, Type)] = Vec::new();
        get_params.push(("arr", lowered_array));
        get_params.push(("index", Type::Int));
        let get_stmts: Vec[Stmt] = Vec::new();
        get_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Index {
                        base: Expr::Var { name: "arr" },
                        index: Expr::Var { name: "index" },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("array_get", array_ty),
                    params: get_params,
                    ret_ty: Option::Some(lowered_elem),
                    body: Block { stmts: get_stmts },
                },
            ),
        );
        let set_params: Vec[(string, Type)] = Vec::new();
        set_params.push(("arr", lowered_array));
        set_params.push(("index", Type::Int));
        set_params.push(("value", lowered_elem));
        let set_stmts: Vec[Stmt] = Vec::new();
        set_stmts.push(
            Stmt::IndexAssign {
                base: Expr::Var { name: "arr" },
                index: Expr::Var { name: "index" },
                value: Expr::Var { name: "value" },
            },
        );
        set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "arr" }) });
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("array_set", array_ty),
                    params: set_params,
                    ret_ty: Option::Some(lowered_array),
                    body: Block { stmts: set_stmts },
                },
            ),
        )
    }
    result
}

fn vec_runtime_items(vec_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    if let VecType { elem } = repr::resolve_type(vec_ty) {
        let lowered_vec = lower_type(vec_ty);
        let lowered_elem = lower_type(elem);
        let new_fields: Vec[(string, Expr)] = Vec::new();
        new_fields.push(("items", Expr::Nil));
        let new_stmts: Vec[Stmt] = Vec::new();
        new_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Unary {
                        op: UnaryOp::Address,
                        expr: Expr::StructLiteral {
                            ty: Type::Named {
                                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                            },
                            fields: new_fields,
                        },
                    },
                ),
            },
        );
        let new_params: Vec[(string, Type)] = Vec::new();
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_new", vec_ty),
                    params: new_params,
                    ret_ty: Option::Some(lowered_vec),
                    body: Block { stmts: new_stmts },
                },
            ),
        );
        let with_capacity_params: Vec[(string, Type)] = Vec::new();
        with_capacity_params.push(("capacity", Type::Int));
        let make_args: Vec[Expr] = Vec::new();
        make_args.push(Expr::Int { value: "0" });
        make_args.push(Expr::Var { name: "capacity" });
        let with_capacity_fields: Vec[(string, Expr)] = Vec::new();
        with_capacity_fields.push(
            ("items", Expr::Make { ty: Type::Slice { elem: lowered_elem }, args: make_args }),
        );
        let with_capacity_stmts: Vec[Stmt] = Vec::new();
        with_capacity_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Unary {
                        op: UnaryOp::Address,
                        expr: Expr::StructLiteral {
                            ty: Type::Named {
                                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                            },
                            fields: with_capacity_fields,
                        },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_with_capacity", vec_ty),
                    params: with_capacity_params,
                    ret_ty: Option::Some(lowered_vec),
                    body: Block { stmts: with_capacity_stmts },
                },
            ),
        );
        let push_params: Vec[(string, Type)] = Vec::new();
        push_params.push(("vec", lowered_vec));
        push_params.push(("elem", lowered_elem));
        let append_args: Vec[Expr] = Vec::new();
        append_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        append_args.push(Expr::Var { name: "elem" });
        let push_stmts: Vec[Stmt] = Vec::new();
        push_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "vec" },
                field_name: "items",
                value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
            },
        );
        push_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_push", vec_ty),
                    params: push_params,
                    ret_ty: Option::Some(Type::Unit),
                    body: Block { stmts: push_stmts },
                },
            ),
        );
        let get_params: Vec[(string, Type)] = Vec::new();
        get_params.push(("vec", lowered_vec));
        get_params.push(("index", Type::Int));
        let get_stmts: Vec[Stmt] = Vec::new();
        get_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Index {
                        base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                        index: Expr::Var { name: "index" },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_get", vec_ty),
                    params: get_params,
                    ret_ty: Option::Some(lowered_elem),
                    body: Block { stmts: get_stmts },
                },
            ),
        );
        let set_params: Vec[(string, Type)] = Vec::new();
        set_params.push(("vec", lowered_vec));
        set_params.push(("index", Type::Int));
        set_params.push(("value", lowered_elem));
        let set_stmts: Vec[Stmt] = Vec::new();
        set_stmts.push(
            Stmt::IndexAssign {
                base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                index: Expr::Var { name: "index" },
                value: Expr::Var { name: "value" },
            },
        );
        set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_set", vec_ty),
                    params: set_params,
                    ret_ty: Option::Some(Type::Unit),
                    body: Block { stmts: set_stmts },
                },
            ),
        );
        let len_params: Vec[(string, Type)] = Vec::new();
        len_params.push(("vec", lowered_vec));
        let len_args: Vec[Expr] = Vec::new();
        len_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        let len_stmts: Vec[Stmt] = Vec::new();
        len_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Convert {
                        ty: Type::Int,
                        expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_len", vec_ty),
                    params: len_params,
                    ret_ty: Option::Some(Type::Int),
                    body: Block { stmts: len_stmts },
                },
            ),
        );
        let capacity_params: Vec[(string, Type)] = Vec::new();
        capacity_params.push(("vec", lowered_vec));
        let capacity_args: Vec[Expr] = Vec::new();
        capacity_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        let capacity_stmts: Vec[Stmt] = Vec::new();
        capacity_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Convert {
                        ty: Type::Int,
                        expr: Expr::Call { func: Expr::Var { name: "cap" }, args: capacity_args },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_capacity", vec_ty),
                    params: capacity_params,
                    ret_ty: Option::Some(Type::Int),
                    body: Block { stmts: capacity_stmts },
                },
            ),
        );
        let reserve_params: Vec[(string, Type)] = Vec::new();
        reserve_params.push(("vec", lowered_vec));
        reserve_params.push(("additional", Type::Int));
        let reserve_stmts: Vec[Stmt] = Vec::new();
        let negative_capacity_stmts: Vec[Stmt] = Vec::new();
        negative_capacity_stmts.push(Stmt::Panic { message: "negative vector capacity" });
        reserve_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "additional" },
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block { stmts: negative_capacity_stmts },
                else_: Option::None,
            },
        );
        let length_args: Vec[Expr] = Vec::new();
        length_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        reserve_stmts.push(
            Stmt::Var {
                name: "length",
                ty: Type::Int,
                value: Option::Some(
                    Expr::Call { func: Expr::Var { name: "len" }, args: length_args },
                ),
            },
        );
        reserve_stmts.push(
            Stmt::Var {
                name: "required",
                ty: Type::Int,
                value: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "length" },
                        rhs: Expr::Var { name: "additional" },
                    },
                ),
            },
        );
        let overflow_stmts: Vec[Stmt] = Vec::new();
        overflow_stmts.push(Stmt::Panic { message: "vector capacity overflow" });
        reserve_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "required" },
                    rhs: Expr::Var { name: "length" },
                },
                then_: Block { stmts: overflow_stmts },
                else_: Option::None,
            },
        );
        let capacity_args: Vec[Expr] = Vec::new();
        capacity_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        let grow_stmts: Vec[Stmt] = Vec::new();
        let current_capacity_args: Vec[Expr] = Vec::new();
        current_capacity_args.push(
            Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
        );
        grow_stmts.push(
            Stmt::Var {
                name: "next_capacity",
                ty: Type::Int,
                value: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Mul,
                        lhs: Expr::Call {
                            func: Expr::Var { name: "cap" },
                            args: current_capacity_args,
                        },
                        rhs: Expr::Int { value: "2" },
                    },
                ),
            },
        );
        let use_required_stmts: Vec[Stmt] = Vec::new();
        use_required_stmts.push(
            Stmt::Assign { name: "next_capacity", value: Expr::Var { name: "required" } },
        );
        grow_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "next_capacity" },
                    rhs: Expr::Var { name: "required" },
                },
                then_: Block { stmts: use_required_stmts },
                else_: Option::None,
            },
        );
        let next_items_args: Vec[Expr] = Vec::new();
        next_items_args.push(Expr::Var { name: "length" });
        next_items_args.push(Expr::Var { name: "next_capacity" });
        grow_stmts.push(
            Stmt::Var {
                name: "next_items",
                ty: Type::Slice { elem: lowered_elem },
                value: Option::Some(
                    Expr::Make { ty: Type::Slice { elem: lowered_elem }, args: next_items_args },
                ),
            },
        );
        let copy_args: Vec[Expr] = Vec::new();
        copy_args.push(Expr::Var { name: "next_items" });
        copy_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        grow_stmts.push(
            Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "copy" }, args: copy_args } },
        );
        grow_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "vec" },
                field_name: "items",
                value: Expr::Var { name: "next_items" },
            },
        );
        reserve_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Greater,
                    lhs: Expr::Var { name: "required" },
                    rhs: Expr::Call { func: Expr::Var { name: "cap" }, args: capacity_args },
                },
                then_: Block { stmts: grow_stmts },
                else_: Option::None,
            },
        );
        reserve_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_reserve", vec_ty),
                    params: reserve_params,
                    ret_ty: Option::Some(Type::Unit),
                    body: Block { stmts: reserve_stmts },
                },
            ),
        );
        let truncate_params: Vec[(string, Type)] = Vec::new();
        truncate_params.push(("vec", lowered_vec));
        truncate_params.push(("new_len", Type::Int));
        let truncate_stmts: Vec[Stmt] = Vec::new();
        let negative_stmts: Vec[Stmt] = Vec::new();
        negative_stmts.push(Stmt::Panic { message: "negative vector length" });
        truncate_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "new_len" },
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block { stmts: negative_stmts },
                else_: Option::None,
            },
        );
        let current_len_args: Vec[Expr] = Vec::new();
        current_len_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        let current_len = Expr::Convert {
            ty: Type::Int,
            expr: Expr::Call { func: Expr::Var { name: "len" }, args: current_len_args },
        };
        let shorten_stmts: Vec[Stmt] = Vec::new();
        let clear_len_args: Vec[Expr] = Vec::new();
        clear_len_args.push(Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" });
        let clear_args: Vec[Expr] = Vec::new();
        clear_args.push(
            Expr::Slice {
                base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                start: Expr::Var { name: "new_len" },
                end: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: clear_len_args },
                },
            },
        );
        shorten_stmts.push(
            Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "clear" }, args: clear_args } },
        );
        shorten_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "vec" },
                field_name: "items",
                value: Expr::Slice {
                    base: Expr::Field { expr: Expr::Var { name: "vec" }, field_name: "items" },
                    start: Expr::Int { value: "0" },
                    end: Expr::Var { name: "new_len" },
                },
            },
        );
        truncate_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "new_len" },
                    rhs: current_len,
                },
                then_: Block { stmts: shorten_stmts },
                else_: Option::None,
            },
        );
        truncate_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
        result.push(
            Item::Function(
                Function {
                    name: runtime_helper_name("vec_truncate", vec_ty),
                    params: truncate_params,
                    ret_ty: Option::Some(Type::Unit),
                    body: Block { stmts: truncate_stmts },
                },
            ),
        )
    }
    result
}

fn ref_runtime_items(ref_ty: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    if let RefType { elem } = repr::resolve_type(ref_ty) {
        let elem_ty = lower_type(elem);
        let lowered_ref_ty = lower_type(ref_ty);
        let struct_ty = Type::Named { name: ref_struct_name(elem) };
        let new_fields: Vec[(string, Expr)] = Vec::new();
        new_fields.push(("value", Expr::Var { name: "value" }));
        let new_stmts: Vec[Stmt] = Vec::new();
        new_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Unary {
                        op: UnaryOp::Address,
                        expr: Expr::StructLiteral { ty: struct_ty, fields: new_fields },
                    },
                ),
            },
        );
        let new_params: Vec[(string, Type)] = Vec::new();
        new_params.push(("value", elem_ty));
        result.push(
            Item::Function(
                Function {
                    name: ref_helper_name("ref", ref_ty),
                    params: new_params,
                    ret_ty: Option::Some(lowered_ref_ty),
                    body: Block { stmts: new_stmts },
                },
            ),
        );
        let get_params: Vec[(string, Type)] = Vec::new();
        get_params.push(("reference", lowered_ref_ty));
        let get_stmts: Vec[Stmt] = Vec::new();
        get_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Field { expr: Expr::Var { name: "reference" }, field_name: "value" },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: ref_helper_name("ref_get", ref_ty),
                    params: get_params,
                    ret_ty: Option::Some(elem_ty),
                    body: Block { stmts: get_stmts },
                },
            ),
        );
        let set_params: Vec[(string, Type)] = Vec::new();
        set_params.push(("reference", lowered_ref_ty));
        set_params.push(("value", elem_ty));
        let set_stmts: Vec[Stmt] = Vec::new();
        set_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "reference" },
                field_name: "value",
                value: Expr::Var { name: "value" },
            },
        );
        set_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
        result.push(
            Item::Function(
                Function {
                    name: ref_helper_name("ref_set", ref_ty),
                    params: set_params,
                    ret_ty: Option::Some(Type::Unit),
                    body: Block { stmts: set_stmts },
                },
            ),
        );
        let ptr_eq_params: Vec[(string, Type)] = Vec::new();
        ptr_eq_params.push(("a", lowered_ref_ty));
        ptr_eq_params.push(("b", lowered_ref_ty));
        let ptr_eq_stmts: Vec[Stmt] = Vec::new();
        ptr_eq_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: Expr::Var { name: "a" },
                        rhs: Expr::Var { name: "b" },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: ref_helper_name("ptr_eq", ref_ty),
                    params: ptr_eq_params,
                    ret_ty: Option::Some(Type::Bool),
                    body: Block { stmts: ptr_eq_stmts },
                },
            ),
        );
        let ptr_hash_params: Vec[(string, Type)] = Vec::new();
        ptr_hash_params.push(("reference", lowered_ref_ty));
        let value_of_args: Vec[Expr] = Vec::new();
        value_of_args.push(Expr::Var { name: "reference" });
        let pointer_args: Vec[Expr] = Vec::new();
        let ptr_hash_stmts: Vec[Stmt] = Vec::new();
        ptr_hash_stmts.push(
            Stmt::Return {
                expr: Option::Some(
                    Expr::Convert {
                        ty: Type::Uint64,
                        expr: Expr::Call {
                            func: Expr::Field {
                                expr: Expr::Call {
                                    func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                    args: value_of_args,
                                },
                                field_name: "Pointer",
                            },
                            args: pointer_args,
                        },
                    },
                ),
            },
        );
        result.push(
            Item::Function(
                Function {
                    name: ref_helper_name("ptr_hash", ref_ty),
                    params: ptr_hash_params,
                    ret_ty: Option::Some(Type::Uint64),
                    body: Block { stmts: ptr_hash_stmts },
                },
            ),
        )
    }
    result
}

fn synthetic_option_base(value: repr::Type) -> string {
    "_goml_option__" + compact_type(value)
}

fn synthetic_option_items(value: repr::Type) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let option_name = go_generated_ident("_goml_synthetic_" + synthetic_option_base(value));
    let method_name = go_generated_ident("is" + option_name);
    let some_name = go_generated_ident(option_name + "_Some");
    let none_name = go_generated_ident(option_name + "_None");
    let methods: Vec[InterfaceMethod] = Vec::new();
    methods.push(InterfaceMethod { name: method_name, params: Vec::new(), ret_ty: Option::None });
    result.push(Item::Interface(InterfaceDef { name: option_name, methods }));
    let some_fields: Vec[(string, Type)] = Vec::new();
    some_fields.push(("_0", lower_type(value)));
    result.push(Item::Struct(StructDef { name: some_name, fields: some_fields }));
    result.push(
        Item::Method(
            Method {
                receiver: ("_", Type::Named { name: some_name }),
                name: method_name,
                params: Vec::new(),
                ret_ty: Option::None,
                body: Block { stmts: Vec::new() },
            },
        ),
    );
    result.push(Item::Struct(StructDef { name: none_name, fields: Vec::new() }));
    result.push(
        Item::Method(
            Method {
                receiver: ("_", Type::Named { name: none_name }),
                name: method_name,
                params: Vec::new(),
                ret_ty: Option::None,
                body: Block { stmts: Vec::new() },
            },
        ),
    );
    result
}

struct HashmapOptionInfo {
    owner_ty: repr::Type,
    option_ty: Type,
    some_ty: Type,
    none_ty: Type,
    synthetic: bool,
    owner: Option[EnumInfo],
    some: Option[VariantInfo],
    none: Option[VariantInfo],
}

fn hashmap_option_info(
    builtin: tast::BuiltinContract,
    value: repr::Type,
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
    planned: VariantInfos,
) -> HashmapOptionInfo {
    let args: Vec[repr::Type] = Vec::new();
    args.push(value);
    match find_instance(instances, builtin.option.name, args) {
        Some(instance) => {
            let definition = find_enum(enums, instance.name);
            let variants = definition.and_then(|value| value.option_variants);
            let variants = variants.unwrap_or_else(
                || (builtin.option.some.name, builtin.option.none.name),
            );
            let mut some_tag = 0;
            let mut none_tag = 1;
            match definition {
                Some(value) => {
                    for index in 0..value.variants.len() {
                        let variant = value.variants[index];
                        if variant.name == variants.0 {
                            some_tag = index;
                        } else if variant.name == variants.1 {
                            none_tag = index;
                        }
                    }
                },
                None => (),
            }
            let owner_ty = repr::Type::Named { name: instance.name };
            let option_ty = Type::Named { name: go_user_type_name(instance.name) };
            let owner = find_enum_info(planned, owner_ty);
            let direct = match owner {
                Some(value) => enum_storage_is_direct(value.storage),
                None => false,
            };
            HashmapOptionInfo {
                owner_ty,
                option_ty,
                some_ty: if direct {
                    option_ty
                } else {
                    Type::Named {
                        name: variant_go_name(
                            instance.name,
                            variants.0,
                            enums,
                            structs,
                            instances,
                            function_names,
                        ),
                    }
                },
                none_ty: if direct {
                    option_ty
                } else {
                    Type::Named {
                        name: variant_go_name(
                            instance.name,
                            variants.1,
                            enums,
                            structs,
                            instances,
                            function_names,
                        ),
                    }
                },
                synthetic: false,
                owner,
                some: find_variant_info(planned, owner_ty, some_tag),
                none: find_variant_info(planned, owner_ty, none_tag),
            }
        },
        None => {
            let option_name = go_generated_ident("_goml_synthetic_" + synthetic_option_base(value));
            HashmapOptionInfo {
                owner_ty: repr::Type::Unit,
                option_ty: Type::Named { name: option_name },
                some_ty: Type::Named { name: go_generated_ident(option_name + "_Some") },
                none_ty: Type::Named { name: go_generated_ident(option_name + "_None") },
                synthetic: true,
                owner: Option::None,
                some: Option::None,
                none: Option::None,
            }
        },
    }
}

fn hashmap_trait_impl_name(trait_name: string, key: repr::Type, method: string) -> string {
    go_ident("trait_impl#" + trait_name + "#" + compact_type(key) + "#" + method)
}

fn hashmap_hash_expr(builtin: tast::BuiltinContract, key: repr::Type, value: Expr) -> Expr {
    let hash_trait = builtin.hash.name;
    let hash_method = builtin.hash.method;
    match repr::resolve_type(key) {
        Dyn { trait_name: name, .. } => if backend_names_match(name, builtin.hash.name) {
            Expr::Call {
                func: Expr::Field {
                    expr: Expr::Field { expr: value, field_name: "vtable" },
                    field_name: hash_method,
                },
                args: Vec::from_array([Expr::Field { expr: value, field_name: "data" }]),
            }
        } else {
            Expr::Call {
                func: Expr::Var { name: hashmap_trait_impl_name(hash_trait, key, hash_method) },
                args: Vec::from_array([value]),
            }
        },
        _ => Expr::Call {
            func: Expr::Var { name: hashmap_trait_impl_name(hash_trait, key, hash_method) },
            args: Vec::from_array([value]),
        },
    }
}

fn hashmap_native_key(key: repr::Type) -> bool {
    match repr::resolve_type(key) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | String | Char => true,
        _ => false,
    }
}

fn hashmap_native_index_stmts() -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "index", ty: Type::Int, value: Option::None });
    stmts.push(Stmt::Var { name: "found", ty: Type::Bool, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("index");
    names.push("found");
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: Expr::Index {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "indices" },
                index: Expr::Var { name: "key" },
            },
        },
    );
    stmts
}

fn hashmap_native_new_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let name = hashmap_name(key, value);
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(
        (
            "indices",
            Expr::Make {
                ty: Type::Map { key: lower_type(key), value: Type::Int },
                args: Vec::new(),
            },
        ),
    );
    fields.push(("entries", Expr::Nil));
    fields.push(("len", Expr::Int { value: "0" }));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: Type::Named { name }, fields },
                },
            ),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_new", map_ty),
            params: Vec::new(),
            ret_ty: Option::Some(lower_type(map_ty)),
            body: Block { stmts },
        },
    )
}

fn hashmap_native_lookup_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    let stmts: Vec[Stmt] = Vec::new();
    let missing_stmts: Vec[Stmt] = Vec::new();
    missing_stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let missing_values: Vec[Expr] = Vec::new();
    missing_values.push(Expr::Var { name: "zero" });
    missing_values.push(Expr::Bool { value: false });
    missing_values.push(Expr::Int { value: "-1" });
    missing_values.push(Expr::Int { value: "0" });
    missing_stmts.push(Stmt::ReturnMulti { exprs: missing_values });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: missing_stmts },
            else_: Option::None,
        },
    );
    for stmt in hashmap_native_index_stmts() {
        stmts.push(stmt)
    }
    let not_found_stmts: Vec[Stmt] = Vec::new();
    not_found_stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let not_found_values: Vec[Expr] = Vec::new();
    not_found_values.push(Expr::Var { name: "zero" });
    not_found_values.push(Expr::Bool { value: false });
    not_found_values.push(Expr::Int { value: "-1" });
    not_found_values.push(Expr::Int { value: "0" });
    not_found_stmts.push(Stmt::ReturnMulti { exprs: not_found_values });
    stmts.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: Expr::Var { name: "found" } },
            then_: Block { stmts: not_found_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                    index: Expr::Var { name: "index" },
                },
            ),
        },
    );
    let found_stmts: Vec[Stmt] = Vec::new();
    let found_values: Vec[Expr] = Vec::new();
    found_values.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "value" });
    found_values.push(Expr::Bool { value: true });
    found_values.push(Expr::Var { name: "index" });
    found_values.push(Expr::Int { value: "0" });
    found_stmts.push(Stmt::ReturnMulti { exprs: found_values });
    stmts.push(
        Stmt::If {
            cond: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let inactive_values: Vec[Expr] = Vec::new();
    inactive_values.push(Expr::Var { name: "zero" });
    inactive_values.push(Expr::Bool { value: false });
    inactive_values.push(Expr::Var { name: "index" });
    inactive_values.push(Expr::Int { value: "0" });
    stmts.push(Stmt::ReturnMulti { exprs: inactive_values });
    let returns: Vec[Type] = Vec::new();
    returns.push(lowered_value);
    returns.push(Type::Bool);
    returns.push(Type::Int);
    returns.push(Type::Uint64);
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_lookup", map_ty),
            params,
            ret_ty: Option::Some(Type::Multi { items: returns }),
            body: Block { stmts },
        },
    )
}

fn hashmap_native_set_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    params.push(("value", lower_type(value)));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    for stmt in hashmap_native_index_stmts() {
        stmts.push(stmt)
    }
    let existing_stmts: Vec[Stmt] = Vec::new();
    existing_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                    index: Expr::Var { name: "index" },
                },
            ),
        },
    );
    let active_stmts: Vec[Stmt] = Vec::new();
    active_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Index {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                index: Expr::Var { name: "index" },
            },
            field_name: "value",
            value: Expr::Var { name: "value" },
        },
    );
    active_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    existing_stmts.push(
        Stmt::If {
            cond: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
            then_: Block { stmts: active_stmts },
            else_: Option::None,
        },
    );
    existing_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
            index: Expr::Var { name: "index" },
            value: hashmap_entry_expr(entry_ty),
        },
    );
    existing_stmts.push(hashmap_increment_len());
    existing_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "found" },
            then_: Block { stmts: existing_stmts },
            else_: Option::None,
        },
    );
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" });
    stmts.push(
        Stmt::Assign {
            name: "index",
            value: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "indices" },
            index: Expr::Var { name: "key" },
            value: Expr::Var { name: "index" },
        },
    );
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" });
    append_args.push(hashmap_entry_expr(entry_ty));
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "entries",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
        },
    );
    stmts.push(hashmap_increment_len());
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_set", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn hashmap_native_remove_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    for stmt in hashmap_native_index_stmts() {
        stmts.push(stmt)
    }
    let missing_stmts: Vec[Stmt] = Vec::new();
    missing_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: Expr::Var { name: "found" } },
            then_: Block { stmts: missing_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                    index: Expr::Var { name: "index" },
                },
            ),
        },
    );
    let inactive_stmts: Vec[Stmt] = Vec::new();
    inactive_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Unary {
                op: UnaryOp::Not,
                expr: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
            },
            then_: Block { stmts: inactive_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Var { name: "zero", ty: entry_ty, value: Option::None });
    stmts.push(
        Stmt::IndexAssign {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
            index: Expr::Var { name: "index" },
            value: Expr::Var { name: "zero" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "len",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_remove", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

