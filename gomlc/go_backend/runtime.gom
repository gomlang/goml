fn hashmap_lookup_item(builtin: tast::BuiltinContract, key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let nil_values: Vec[Expr] = Vec::new();
    nil_values.push(Expr::Var { name: "zero" });
    nil_values.push(Expr::Bool { value: false });
    nil_values.push(Expr::Int { value: "-1" });
    nil_values.push(Expr::Int { value: "0" });
    nil_stmts.push(Stmt::ReturnMulti { exprs: nil_values });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(builtin, key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    stmts.push(
        Stmt::Var {
            name: "reuse_index",
            ty: Type::Int,
            value: Option::Some(Expr::Int { value: "-1" }),
        },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::new();
    let found_values: Vec[Expr] = Vec::new();
    found_values.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "value" });
    found_values.push(Expr::Bool { value: true });
    found_values.push(Expr::Var { name: "i" });
    found_values.push(Expr::Var { name: "h" });
    found_stmts.push(Stmt::ReturnMulti { exprs: found_values });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var {
                        name: hashmap_trait_impl_name(
                            builtin.partial_eq.name,
                            key,
                            builtin.partial_eq.method,
                        ),
                    },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    let reuse_stmts = Vec::from_array(
        [Stmt::Assign { name: "reuse_index", value: Expr::Var { name: "i" } }],
    );
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Unary {
                    op: UnaryOp::Not,
                    expr: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "reuse_index" },
                    rhs: Expr::Int { value: "0" },
                },
            },
            then_: Block { stmts: reuse_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Var { name: "zero", ty: lowered_value, value: Option::None });
    let missing_values: Vec[Expr] = Vec::new();
    missing_values.push(Expr::Var { name: "zero" });
    missing_values.push(Expr::Bool { value: false });
    missing_values.push(Expr::Var { name: "reuse_index" });
    missing_values.push(Expr::Var { name: "h" });
    stmts.push(Stmt::ReturnMulti { exprs: missing_values });
    let returns: Vec[Type] = Vec::new();
    returns.push(lowered_value);
    returns.push(Type::Bool);
    returns.push(Type::Int);
    returns.push(Type::Uint64);
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_lookup", map_ty),
            params,
            ret_ty: Option::Some(Type::Multi { items: returns }),
            body: Block { stmts },
        },
    )
}

fn hashmap_get_item(key: repr::Type, value: repr::Type, option: HashmapOptionInfo) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    params.push(("key", lower_type(key)));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "value", ty: lower_type(value), value: Option::None });
    stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
    let names: Vec[string] = Vec::new();
    names.push("value");
    names.push("ok");
    names.push("_");
    names.push("_");
    let lookup_args: Vec[Expr] = Vec::new();
    lookup_args.push(Expr::Var { name: "m" });
    lookup_args.push(Expr::Var { name: "key" });
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: Expr::Call {
                func: Expr::Var { name: runtime_helper_name("hashmap_lookup", map_ty) },
                args: lookup_args,
            },
        },
    );
    let some_stmts: Vec[Stmt] = Vec::new();
    some_stmts.push(
        Stmt::Return {
            expr: Option::Some(hashmap_option_some_expr(option, Expr::Var { name: "value" })),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "ok" },
            then_: Block { stmts: some_stmts },
            else_: Option::None,
        },
    );
    stmts.push(Stmt::Return { expr: Option::Some(hashmap_option_none_expr(option)) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_get", map_ty),
            params,
            ret_ty: Option::Some(option.option_ty),
            body: Block { stmts },
        },
    )
}

fn hashmap_entry_expr(entry_ty: Type) -> Expr {
    let fields: Vec[(string, Expr)] = Vec::new();
    fields.push(("active", Expr::Bool { value: true }));
    fields.push(("key", Expr::Var { name: "key" }));
    fields.push(("value", Expr::Var { name: "value" }));
    Expr::StructLiteral { ty: entry_ty, fields }
}

fn hashmap_increment_len() -> Stmt {
    Stmt::FieldAssign {
        target: Expr::Var { name: "m" },
        field_name: "len",
        value: Expr::Binary {
            op: BinaryOp::Add,
            lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
            rhs: Expr::Int { value: "1" },
        },
    }
}

fn hashmap_option_some_expr(option: HashmapOptionInfo, value: Expr) -> Expr {
    match option.owner {
        Some(owner) => {
            let variant = option.some;
            let tag = match variant {
                Some(value) => value.tag,
                None => 0,
            };
            match owner.storage {
                Singleton => Expr::StructLiteral { ty: option.option_ty, fields: Vec::new() },
                TagOnly => Expr::Convert {
                    ty: option.option_ty,
                    expr: Expr::Int { value: tag.to_string() },
                },
                Flat => {
                    let fields = Vec::from_array([("_tag", Expr::Int { value: tag.to_string() })]);
                    if let Some(info) = variant {
                        if !info.field_names.is_empty() {
                            if let Some(name) = info.field_names[0] {
                                fields.push((name, value))
                            }
                        }
                    }
                    Expr::StructLiteral { ty: option.option_ty, fields }
                },
                PointerNiche => Expr::StructLiteral {
                    ty: option.option_ty,
                    fields: Vec::from_array([("_value", value)]),
                },
                Packed => enum_packed_value_expr(
                    owner,
                    option.owner_ty,
                    owner.payload_ty.unwrap_or(repr::Type::Unit),
                    value,
                ),
                Node => {
                    let fields = Vec::from_array([("_tag", Expr::Int { value: tag.to_string() })]);
                    if let Some(info) = variant {
                        if !info.field_names.is_empty() {
                            if let Some(name) = info.field_names[0] {
                                fields.push((name, value))
                            }
                        }
                    }
                    Expr::StructLiteral {
                        ty: option.option_ty,
                        fields: Vec::from_array(
                            [
                                (
                                    "_node",
                                    Expr::Unary {
                                        op: UnaryOp::Address,
                                        expr: Expr::StructLiteral {
                                            ty: Type::Named { name: owner.node_name },
                                            fields,
                                        },
                                    },
                                ),
                            ],
                        ),
                    }
                },
                Interface => Expr::StructLiteral {
                    ty: option.some_ty,
                    fields: Vec::from_array([("_0", value)]),
                },
            }
        },
        None => Expr::StructLiteral { ty: option.some_ty, fields: Vec::from_array([("_0", value)]) },
    }
}

fn hashmap_option_none_expr(option: HashmapOptionInfo) -> Expr {
    match option.owner {
        Some(owner) => {
            let tag = match option.none {
                Some(value) => value.tag,
                None => 1,
            };
            match owner.storage {
                Singleton => Expr::StructLiteral { ty: option.option_ty, fields: Vec::new() },
                TagOnly => Expr::Convert {
                    ty: option.option_ty,
                    expr: Expr::Int { value: tag.to_string() },
                },
                Flat => Expr::StructLiteral {
                    ty: option.option_ty,
                    fields: Vec::from_array([("_tag", Expr::Int { value: tag.to_string() })]),
                },
                PointerNiche => Expr::StructLiteral { ty: option.option_ty, fields: Vec::new() },
                Packed => Expr::Convert { ty: option.option_ty, expr: Expr::Int { value: "0" } },
                Node => if owner.nil_tag == Option::Some(tag) {
                    Expr::StructLiteral { ty: option.option_ty, fields: Vec::new() }
                } else {
                    Expr::StructLiteral {
                        ty: option.option_ty,
                        fields: Vec::from_array(
                            [
                                (
                                    "_node",
                                    Expr::Unary {
                                        op: UnaryOp::Address,
                                        expr: Expr::StructLiteral {
                                            ty: Type::Named { name: owner.node_name },
                                            fields: Vec::from_array(
                                                [("_tag", Expr::Int { value: tag.to_string() })],
                                            ),
                                        },
                                    },
                                ),
                            ],
                        ),
                    }
                },
                Interface => Expr::StructLiteral { ty: option.none_ty, fields: Vec::new() },
            }
        },
        None => Expr::StructLiteral { ty: option.none_ty, fields: Vec::new() },
    }
}

fn hashmap_fused_lookup_stmts(map_ty: repr::Type, value: repr::Type) -> Vec[Stmt] {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "previous", ty: lower_type(value), value: Option::None });
    stmts.push(Stmt::Var { name: "found", ty: Type::Bool, value: Option::None });
    stmts.push(Stmt::Var { name: "index", ty: Type::Int, value: Option::None });
    stmts.push(Stmt::Var { name: "hash", ty: Type::Uint64, value: Option::None });
    let names = Vec::from_array(["previous", "found", "index", "hash"]);
    let args = Vec::from_array([Expr::Var { name: "m" }, Expr::Var { name: "key" }]);
    stmts.push(
        Stmt::MultiAssign {
            names,
            value: Expr::Call {
                func: Expr::Var { name: runtime_helper_name("hashmap_lookup", map_ty) },
                args,
            },
        },
    );
    stmts.push(Stmt::Assign { name: "_", value: Expr::Var { name: "previous" } });
    stmts.push(Stmt::Assign { name: "_", value: Expr::Var { name: "index" } });
    stmts.push(Stmt::Assign { name: "_", value: Expr::Var { name: "hash" } });
    stmts
}

fn hashmap_runtime_entry_target(native_key: bool) -> Expr {
    if native_key {
        Expr::Index {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
            index: Expr::Var { name: "index" },
        }
    } else {
        Expr::Index {
            base: Expr::Index {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                index: Expr::Var { name: "hash" },
            },
            index: Expr::Var { name: "index" },
        }
    }
}

fn hashmap_insert_missing_stmts(key: repr::Type, value: repr::Type, native_key: bool) -> Vec[Stmt] {
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let stmts: Vec[Stmt] = Vec::new();
    if native_key {
        let reuse_stmts: Vec[Stmt] = Vec::new();
        reuse_stmts.push(
            Stmt::IndexAssign {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                index: Expr::Var { name: "index" },
                value: hashmap_entry_expr(entry_ty),
            },
        );
        let append_stmts: Vec[Stmt] = Vec::new();
        let len_args: Vec[Expr] = Vec::new();
        len_args.push(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" });
        append_stmts.push(
            Stmt::Assign {
                name: "index",
                value: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
            },
        );
        append_stmts.push(
            Stmt::IndexAssign {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "indices" },
                index: Expr::Var { name: "key" },
                value: Expr::Var { name: "index" },
            },
        );
        let append_args = Vec::from_array(
            [
                Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" },
                hashmap_entry_expr(entry_ty),
            ],
        );
        append_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "m" },
                field_name: "entries",
                value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
            },
        );
        stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::GreaterEq,
                    lhs: Expr::Var { name: "index" },
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block { stmts: reuse_stmts },
                else_: Option::Some(Block { stmts: append_stmts }),
            },
        )
    } else {
        let bucket_ty = Type::Slice { elem: entry_ty };
        stmts.push(
            Stmt::Var {
                name: "bucket",
                ty: bucket_ty,
                value: Option::Some(
                    Expr::Index {
                        base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                        index: Expr::Var { name: "hash" },
                    },
                ),
            },
        );
        let len_args = Vec::from_array([Expr::Var { name: "bucket" }]);
        let empty_stmts: Vec[Stmt] = Vec::new();
        let append_hash_args = Vec::from_array(
            [
                Expr::Field { expr: Expr::Var { name: "m" }, field_name: "hashes" },
                Expr::Var { name: "hash" },
            ],
        );
        empty_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "m" },
                field_name: "hashes",
                value: Expr::Call { func: Expr::Var { name: "append" }, args: append_hash_args },
            },
        );
        let append_stmts: Vec[Stmt] = Vec::new();
        append_stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::Eq,
                    lhs: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block { stmts: empty_stmts },
                else_: Option::None,
            },
        );
        let append_args = Vec::from_array(
            [Expr::Var { name: "bucket" }, hashmap_entry_expr(entry_ty)],
        );
        append_stmts.push(
            Stmt::Assign {
                name: "bucket",
                value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
            },
        );
        let reuse_stmts = Vec::from_array(
            [
                Stmt::IndexAssign {
                    base: Expr::Var { name: "bucket" },
                    index: Expr::Var { name: "index" },
                    value: hashmap_entry_expr(entry_ty),
                },
            ],
        );
        stmts.push(
            Stmt::If {
                cond: Expr::Binary {
                    op: BinaryOp::GreaterEq,
                    lhs: Expr::Var { name: "index" },
                    rhs: Expr::Int { value: "0" },
                },
                then_: Block { stmts: reuse_stmts },
                else_: Option::Some(Block { stmts: append_stmts }),
            },
        );
        stmts.push(
            Stmt::IndexAssign {
                base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                index: Expr::Var { name: "hash" },
                value: Expr::Var { name: "bucket" },
            },
        )
    }
    stmts.push(hashmap_increment_len());
    stmts
}

fn hashmap_insert_item(key: repr::Type, value: repr::Type, option: HashmapOptionInfo) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let params = Vec::from_array(
        [("m", lower_type(map_ty)), ("key", lower_type(key)), ("value", lower_type(value))],
    );
    let stmts = hashmap_fused_lookup_stmts(map_ty, value);
    let found_stmts: Vec[Stmt] = Vec::new();
    found_stmts.push(
        Stmt::FieldAssign {
            target: hashmap_runtime_entry_target(hashmap_native_key(key)),
            field_name: "value",
            value: Expr::Var { name: "value" },
        },
    );
    found_stmts.push(
        Stmt::Return {
            expr: Option::Some(hashmap_option_some_expr(option, Expr::Var { name: "previous" })),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "found" },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    let nil_stmts = Vec::from_array(
        [Stmt::Return { expr: Option::Some(hashmap_option_none_expr(option)) }],
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    for stmt in hashmap_insert_missing_stmts(key, value, hashmap_native_key(key)) {
        stmts.push(stmt)
    }
    stmts.push(Stmt::Return { expr: Option::Some(hashmap_option_none_expr(option)) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_insert", map_ty),
            params,
            ret_ty: Option::Some(option.option_ty),
            body: Block { stmts },
        },
    )
}

fn hashmap_get_or_insert_with_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let create_ty = Type::Func { params: Vec::new(), ret_ty: lower_type(value) };
    let params = Vec::from_array(
        [("m", lower_type(map_ty)), ("key", lower_type(key)), ("create", create_ty)],
    );
    let stmts = hashmap_fused_lookup_stmts(map_ty, value);
    let found_stmts = Vec::from_array(
        [Stmt::Return { expr: Option::Some(Expr::Var { name: "previous" }) }],
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Var { name: "found" },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "value",
            ty: lower_type(value),
            value: Option::Some(Expr::Call { func: Expr::Var { name: "create" }, args: Vec::new() }),
        },
    );
    let nil_stmts = Vec::from_array(
        [Stmt::Return { expr: Option::Some(Expr::Var { name: "value" }) }],
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    for stmt in hashmap_insert_missing_stmts(key, value, hashmap_native_key(key)) {
        stmts.push(stmt)
    }
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "value" }) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_get_or_insert_with", map_ty),
            params,
            ret_ty: Option::Some(lower_type(value)),
            body: Block { stmts },
        },
    )
}

fn hashmap_update_item(key: repr::Type, value: repr::Type, option: HashmapOptionInfo) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let update_ty = Type::Func {
        params: Vec::from_array([lower_type(value)]),
        ret_ty: lower_type(value),
    };
    let params = Vec::from_array(
        [("m", lower_type(map_ty)), ("key", lower_type(key)), ("update", update_ty)],
    );
    let stmts = hashmap_fused_lookup_stmts(map_ty, value);
    let missing_stmts = Vec::from_array(
        [Stmt::Return { expr: Option::Some(hashmap_option_none_expr(option)) }],
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: Expr::Var { name: "found" } },
            then_: Block { stmts: missing_stmts },
            else_: Option::None,
        },
    );
    let update_args = Vec::from_array([Expr::Var { name: "previous" }]);
    stmts.push(
        Stmt::Var {
            name: "value",
            ty: lower_type(value),
            value: Option::Some(
                Expr::Call { func: Expr::Var { name: "update" }, args: update_args },
            ),
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: hashmap_runtime_entry_target(hashmap_native_key(key)),
            field_name: "value",
            value: Expr::Var { name: "value" },
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(hashmap_option_some_expr(option, Expr::Var { name: "value" })),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_update", map_ty),
            params,
            ret_ty: Option::Some(option.option_ty),
            body: Block { stmts },
        },
    )
}

fn hashmap_remove_value_item(key: repr::Type, value: repr::Type, option: HashmapOptionInfo) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let params = Vec::from_array([("m", lower_type(map_ty)), ("key", lower_type(key))]);
    let stmts = hashmap_fused_lookup_stmts(map_ty, value);
    let missing_stmts = Vec::from_array(
        [Stmt::Return { expr: Option::Some(hashmap_option_none_expr(option)) }],
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Unary { op: UnaryOp::Not, expr: Expr::Var { name: "found" } },
            then_: Block { stmts: missing_stmts },
            else_: Option::None,
        },
    );
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    stmts.push(Stmt::Var { name: "zero", ty: entry_ty, value: Option::None });
    stmts.push(
        Stmt::IndexAssign {
            base: if hashmap_native_key(key) {
                Expr::Field { expr: Expr::Var { name: "m" }, field_name: "entries" }
            } else {
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "hash" },
                }
            },
            index: Expr::Var { name: "index" },
            value: Expr::Var { name: "zero" },
        },
    );
    stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "len",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(
        Stmt::Return {
            expr: Option::Some(hashmap_option_some_expr(option, Expr::Var { name: "previous" })),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_remove_value", map_ty),
            params,
            ret_ty: Option::Some(option.option_ty),
            body: Block { stmts },
        },
    )
}

fn hashmap_set_item(builtin: tast::BuiltinContract, key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let lowered_value = lower_type(value);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    params.push(("value", lowered_value));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Var {
            name: "reuse_index",
            ty: Type::Int,
            value: Option::Some(Expr::Int { value: "-1" }),
        },
    );
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(builtin, key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "bucket" });
    let empty_stmts: Vec[Stmt] = Vec::new();
    let append_hash_args: Vec[Expr] = Vec::new();
    append_hash_args.push(Expr::Field { expr: Expr::Var { name: "m" }, field_name: "hashes" });
    append_hash_args.push(Expr::Var { name: "h" });
    empty_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "hashes",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_hash_args },
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::Eq,
                lhs: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: empty_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let loop_len_args: Vec[Expr] = Vec::new();
    loop_len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: loop_len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let update_stmts: Vec[Stmt] = Vec::new();
    update_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Index {
                base: Expr::Var { name: "bucket" },
                index: Expr::Var { name: "i" },
            },
            field_name: "value",
            value: Expr::Var { name: "value" },
        },
    );
    update_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var {
                        name: hashmap_trait_impl_name(
                            builtin.partial_eq.name,
                            key,
                            builtin.partial_eq.method,
                        ),
                    },
                    args: eq_args,
                },
            },
            then_: Block { stmts: update_stmts },
            else_: Option::None,
        },
    );
    let reuse_stmts: Vec[Stmt] = Vec::new();
    reuse_stmts.push(Stmt::Assign { name: "reuse_index", value: Expr::Var { name: "i" } });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Unary {
                    op: UnaryOp::Not,
                    expr: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                },
                rhs: Expr::Binary {
                    op: BinaryOp::Less,
                    lhs: Expr::Var { name: "reuse_index" },
                    rhs: Expr::Int { value: "0" },
                },
            },
            then_: Block { stmts: reuse_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    let replace_stmts: Vec[Stmt] = Vec::new();
    replace_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "bucket" },
            index: Expr::Var { name: "reuse_index" },
            value: hashmap_entry_expr(entry_ty),
        },
    );
    replace_stmts.push(hashmap_increment_len());
    replace_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "reuse_index" },
                rhs: Expr::Int { value: "0" },
            },
            then_: Block { stmts: replace_stmts },
            else_: Option::None,
        },
    );
    let append_entry_args: Vec[Expr] = Vec::new();
    append_entry_args.push(Expr::Var { name: "bucket" });
    append_entry_args.push(hashmap_entry_expr(entry_ty));
    stmts.push(
        Stmt::Assign {
            name: "bucket",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_entry_args },
        },
    );
    stmts.push(
        Stmt::IndexAssign {
            base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
            index: Expr::Var { name: "h" },
            value: Expr::Var { name: "bucket" },
        },
    );
    stmts.push(hashmap_increment_len());
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_set", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn hashmap_remove_item(builtin: tast::BuiltinContract, key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(builtin, key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::new();
    found_stmts.push(Stmt::Var { name: "zero", ty: entry_ty, value: Option::None });
    found_stmts.push(
        Stmt::IndexAssign {
            base: Expr::Var { name: "bucket" },
            index: Expr::Var { name: "i" },
            value: Expr::Var { name: "zero" },
        },
    );
    found_stmts.push(
        Stmt::FieldAssign {
            target: Expr::Var { name: "m" },
            field_name: "len",
            value: Expr::Binary {
                op: BinaryOp::Sub,
                lhs: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "len" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    found_stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var {
                        name: hashmap_trait_impl_name(
                            builtin.partial_eq.name,
                            key,
                            builtin.partial_eq.method,
                        ),
                    },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_remove", map_ty),
            params,
            ret_ty: Option::Some(Type::Unit),
            body: Block { stmts },
        },
    )
}

fn hashmap_contains_item(builtin: tast::BuiltinContract, key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let lowered_map = lower_type(map_ty);
    let lowered_key = lower_type(key);
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lowered_map));
    params.push(("key", lowered_key));
    let stmts: Vec[Stmt] = Vec::new();
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    stmts.push(
        Stmt::Var {
            name: "h",
            ty: Type::Uint64,
            value: Option::Some(hashmap_hash_expr(builtin, key, Expr::Var { name: "key" })),
        },
    );
    stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let eq_args: Vec[Expr] = Vec::new();
    eq_args.push(Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" });
    eq_args.push(Expr::Var { name: "key" });
    let found_stmts: Vec[Stmt] = Vec::new();
    found_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: true }) });
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::And,
                lhs: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
                rhs: Expr::Call {
                    func: Expr::Var {
                        name: hashmap_trait_impl_name(
                            builtin.partial_eq.name,
                            key,
                            builtin.partial_eq.method,
                        ),
                    },
                    args: eq_args,
                },
            },
            then_: Block { stmts: found_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_contains", map_ty),
            params,
            ret_ty: Option::Some(Type::Bool),
            body: Block { stmts },
        },
    )
}

fn hashmap_entries_item(key: repr::Type, value: repr::Type) -> Item {
    let map_ty = repr::Type::HashMap { key, value };
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let bucket_ty = Type::Slice { elem: entry_ty };
    let pair_types: Vec[repr::Type] = Vec::new();
    pair_types.push(key);
    pair_types.push(value);
    let pair_ty = repr::Type::Tuple { items: pair_types };
    let lowered_pair = lower_type(pair_ty);
    let result_slice_ty = Type::Slice { elem: lowered_pair };
    let result_vec_ty = repr::Type::VecType { elem: pair_ty };
    let result_vec_struct = Type::Named {
        name: go_generated_ident("_goml_vec_" + go_ident(encode_type(pair_ty))),
    };
    let params: Vec[(string, Type)] = Vec::new();
    params.push(("m", lower_type(map_ty)));
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Var { name: "result", ty: result_slice_ty, value: Option::None });
    let nil_fields: Vec[(string, Expr)] = Vec::new();
    nil_fields.push(("items", Expr::Var { name: "result" }));
    let nil_stmts: Vec[Stmt] = Vec::new();
    nil_stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: result_vec_struct, fields: nil_fields },
                },
            ),
        },
    );
    stmts.push(
        Stmt::If {
            cond: Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "m" }, rhs: Expr::Nil },
            then_: Block { stmts: nil_stmts },
            else_: Option::None,
        },
    );
    let range_stmts: Vec[Stmt] = Vec::new();
    range_stmts.push(
        Stmt::Var {
            name: "bucket",
            ty: bucket_ty,
            value: Option::Some(
                Expr::Index {
                    base: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "buckets" },
                    index: Expr::Var { name: "h" },
                },
            ),
        },
    );
    range_stmts.push(
        Stmt::Var { name: "i", ty: Type::Int, value: Option::Some(Expr::Int { value: "0" }) },
    );
    let loop_stmts: Vec[Stmt] = Vec::new();
    let len_args: Vec[Expr] = Vec::new();
    len_args.push(Expr::Var { name: "bucket" });
    let break_stmts: Vec[Stmt] = Vec::new();
    break_stmts.push(Stmt::Break);
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Binary {
                op: BinaryOp::GreaterEq,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Convert {
                    ty: Type::Int,
                    expr: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                },
            },
            then_: Block { stmts: break_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Var {
            name: "entry",
            ty: entry_ty,
            value: Option::Some(
                Expr::Index { base: Expr::Var { name: "bucket" }, index: Expr::Var { name: "i" } },
            ),
        },
    );
    let pair_fields: Vec[(string, Expr)] = Vec::new();
    pair_fields.push(("_0", Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "key" }));
    pair_fields.push(("_1", Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "value" }));
    let append_args: Vec[Expr] = Vec::new();
    append_args.push(Expr::Var { name: "result" });
    append_args.push(Expr::StructLiteral { ty: lowered_pair, fields: pair_fields });
    let active_stmts: Vec[Stmt] = Vec::new();
    active_stmts.push(
        Stmt::Assign {
            name: "result",
            value: Expr::Call { func: Expr::Var { name: "append" }, args: append_args },
        },
    );
    loop_stmts.push(
        Stmt::If {
            cond: Expr::Field { expr: Expr::Var { name: "entry" }, field_name: "active" },
            then_: Block { stmts: active_stmts },
            else_: Option::None,
        },
    );
    loop_stmts.push(
        Stmt::Assign {
            name: "i",
            value: Expr::Binary {
                op: BinaryOp::Add,
                lhs: Expr::Var { name: "i" },
                rhs: Expr::Int { value: "1" },
            },
        },
    );
    range_stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
    let range_names: Vec[string] = Vec::new();
    range_names.push("_");
    range_names.push("h");
    stmts.push(
        Stmt::Range {
            names: range_names,
            expr: Expr::Field { expr: Expr::Var { name: "m" }, field_name: "hashes" },
            body: Block { stmts: range_stmts },
        },
    );
    let result_fields: Vec[(string, Expr)] = Vec::new();
    result_fields.push(("items", Expr::Var { name: "result" }));
    stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral { ty: result_vec_struct, fields: result_fields },
                },
            ),
        },
    );
    Item::Function(
        Function {
            name: runtime_helper_name("hashmap_entries", map_ty),
            params,
            ret_ty: Option::Some(lower_type(result_vec_ty)),
            body: Block { stmts },
        },
    )
}

fn hashmap_items(
    builtin: tast::BuiltinContract,
    key: repr::Type,
    value: repr::Type,
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
    planned: VariantInfos,
    include_option: bool,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let name = hashmap_name(key, value);
    let entry_name = go_generated_ident(name + "_entry");
    let native_key = hashmap_native_key(key);
    let entry_fields: Vec[(string, Type)] = Vec::new();
    entry_fields.push(("active", Type::Bool));
    entry_fields.push(("key", lower_type(key)));
    entry_fields.push(("value", lower_type(value)));
    result.push(Item::Struct(StructDef { name: entry_name, fields: entry_fields }));
    let fields: Vec[(string, Type)] = Vec::new();
    if native_key {
        fields.push(("indices", Type::Map { key: lower_type(key), value: Type::Int }));
        fields.push(("entries", Type::Slice { elem: Type::Named { name: entry_name } }))
    } else {
        fields.push(
            (
                "buckets",
                Type::Map {
                    key: Type::Uint64,
                    value: Type::Slice { elem: Type::Named { name: entry_name } },
                },
            ),
        );
        fields.push(("hashes", Type::Slice { elem: Type::Uint64 }))
    }
    fields.push(("len", Type::Int));
    result.push(Item::Struct(StructDef { name, fields }));
    let option = hashmap_option_info(
        builtin,
        value,
        instances,
        enums,
        structs,
        function_names,
        planned,
    );
    if include_option && option.synthetic {
        for item in synthetic_option_items(value) {
            result.push(item)
        }
    }
    result.push(
        if native_key {
            hashmap_native_new_item(key, value)
        } else {
            hashmap_new_item(key, value)
        },
    );
    result.push(hashmap_len_item(key, value));
    result.push(
        if native_key {
            hashmap_native_lookup_item(key, value)
        } else {
            hashmap_lookup_item(builtin, key, value)
        },
    );
    result.push(hashmap_get_item(key, value, option));
    result.push(hashmap_insert_item(key, value, option));
    result.push(hashmap_get_or_insert_with_item(key, value));
    result.push(hashmap_update_item(key, value, option));
    result.push(hashmap_remove_value_item(key, value, option));
    if native_key {
        result.push(hashmap_native_set_item(key, value));
        result.push(hashmap_native_remove_item(key, value));
        result.push(hashmap_native_contains_item(key, value));
        result.push(hashmap_native_entries_item(key, value))
    } else {
        result.push(hashmap_set_item(builtin, key, value));
        result.push(hashmap_remove_item(builtin, key, value));
        result.push(hashmap_contains_item(builtin, key, value));
        result.push(hashmap_entries_item(key, value))
    }
    result
}

fn option_available(
    builtin: tast::BuiltinContract,
    instances: Vec[repr::TypeInstance],
    value: repr::Type,
) -> bool {
    let args: Vec[repr::Type] = Vec::new();
    args.push(value);
    find_instance(instances, builtin.option.name, args).is_some()
}

fn dyn_vtable_name(trait_name: string) -> string {
    go_generated_ident("dyn__" + trait_name + "_vtable")
}

fn dyn_object_name(trait_name: string) -> string {
    go_dyn_struct_name(trait_name)
}

fn raw_dyn_wrapper_name(trait_name: string, for_ty: repr::Type, method: string) -> string {
    go_generated_ident("dyn__" + trait_name + "__wrap__" + encode_type(for_ty) + "__" + method)
}

fn dyn_wrapper_name(names: DynHelperNames, trait_name: string, for_ty: repr::Type, method: string) -> string {
    let key = compact_type(for_ty);
    let mut result = raw_dyn_wrapper_name(trait_name, for_ty, method);
    for entry in names.wrappers {
        if entry.0 == trait_name && entry.1 == key && entry.2 == method {
            result = entry.3;
        }
    }
    result
}

fn raw_dyn_factory_name(trait_name: string, for_ty: repr::Type) -> string {
    go_generated_ident("dyn__" + trait_name + "__vtable__" + encode_type(for_ty))
}

pub fn dyn_factory_name(names: DynHelperNames, trait_name: string, for_ty: repr::Type) -> string {
    let key = compact_type(for_ty);
    let mut result = raw_dyn_factory_name(trait_name, for_ty);
    for entry in names.factories {
        if entry.0 == trait_name && entry.1 == key {
            result = entry.2;
        }
    }
    result
}

fn trait_impl_method_name(value: anf::Function) -> Option[string] {
    match value.origin {
        anf::FunctionOrigin::TraitImplementation { method_name } => Option::Some(method_name),
        _ => Option::None,
    }
}

fn contains_method(values: Vec[DynMethod], expected: string) -> bool {
    for value in values {
        if value.name == expected {
            return true
        }
    }
    false
}

fn dyn_method_parts(value: string, fallback: string) -> (string, string) {
    let mut separator = -1;
    for index in 0..value.byte_len() {
        if separator < 0 && value.byte_get(index) == b'#' {
            separator = index;
        }
    }
    if separator < 0 {
        (fallback, value)
    } else {
        (value.byte_slice(0, separator), value.byte_slice(separator + 1, value.byte_len()))
    }
}

fn collect_dyn_call_method(result: Vec[DynMethod], trait_name: string, value: anf::Value) -> () {
    if let DynCall { trait_name: owner, method_name: encoded, receiver: _, args, ty: ret_ty } = value {
        if owner == trait_name {
            let parts = dyn_method_parts(encoded, owner);
            if !contains_method(result, parts.1) {
                let params: Vec[repr::Type] = Vec::new();
                for arg in args {
                    params.push(anf::imm_type(arg))
                }
                result.push(DynMethod { name: parts.1, dispatch_trait: parts.0, params, ret_ty })
            }
        }
    }
}

fn collect_dyn_call_methods(result: Vec[DynMethod], trait_name: string, block: anf::Block) -> () {
    for bind in block.binds {
        match bind {
            Let(value) => {
                collect_dyn_call_method(result, trait_name, value.value)
            },
            Join(value) => {
                collect_dyn_call_methods(result, trait_name, value.body)
            },
            JoinRec(values) => for value in values {
                collect_dyn_call_methods(result, trait_name, value.body)
            },
        }
    }
    match block.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_dyn_call_methods(result, trait_name, then_);
            collect_dyn_call_methods(result, trait_name, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_dyn_call_methods(result, trait_name, arm.body)
            }
            if let Some(body) = default {
                collect_dyn_call_methods(result, trait_name, body)
            }
        },
        _ => (),
    }
}

fn dyn_methods(builtin: tast::BuiltinContract, functions: Vec[anf::Function], trait_name: string) -> Vec[
    DynMethod,
] {
    let result: Vec[DynMethod] = Vec::new();
    for function in functions {
        if let (Some(metadata), Some(method_name)) = (
            function.trait_impl,
            trait_impl_method_name(function),
        ) {
            if metadata.trait_ref.name == trait_name && !contains_method(result, method_name) {
                let params: Vec[repr::Type] = Vec::new();
                for index in 1..function.params.len() {
                    params.push(function.params[index].1)
                }
                result.push(
                    DynMethod {
                        name: method_name,
                        dispatch_trait: trait_name,
                        params,
                        ret_ty: function.ret_ty,
                    },
                )
            }
        }
    }
    for function in functions {
        collect_dyn_call_methods(result, trait_name, function.body)
    }
    let hash_method = builtin.hash.method;
    let to_string_method = builtin.to_string.method;
    let debug_method = builtin.debug.method;
    if backend_names_match(trait_name, builtin.hash.name) && !contains_method(result, hash_method) {
        result.push(
            DynMethod {
                name: hash_method,
                dispatch_trait: trait_name,
                params: Vec::new(),
                ret_ty: repr::Type::Uint64,
            },
        )
    } else if backend_names_match(trait_name, builtin.to_string.name)
        && !contains_method(result, to_string_method) {
        result.push(
            DynMethod {
                name: to_string_method,
                dispatch_trait: trait_name,
                params: Vec::new(),
                ret_ty: repr::Type::String,
            },
        )
    } else if backend_names_match(trait_name, builtin.debug.name)
        && !contains_method(result, debug_method) {
        result.push(
            DynMethod {
                name: debug_method,
                dispatch_trait: trait_name,
                params: Vec::new(),
                ret_ty: repr::Type::String,
            },
        )
    }
    result
}

fn dyn_factory_name_count(coercions: Vec[DynCoercion], expected: string) -> isize {
    let mut count = 0;
    for coercion in coercions {
        if raw_dyn_factory_name(coercion.trait_name, coercion.for_ty) == expected {
            count += 1;
        }
    }
    count
}

fn dyn_wrapper_name_count(
    builtin: tast::BuiltinContract,
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
    expected: string,
) -> isize {
    let mut count = 0;
    for coercion in coercions {
        for method in dyn_methods(builtin, functions, coercion.trait_name) {
            if raw_dyn_wrapper_name(coercion.trait_name, coercion.for_ty, method.name) == expected {
                count += 1;
            }
        }
    }
    count
}

pub fn build_dyn_helper_names(
    builtin: tast::BuiltinContract,
    coercions: Vec[DynCoercion],
    functions: Vec[anf::Function],
) -> DynHelperNames {
    let factories: Vec[(string, string, string)] = Vec::new();
    let wrappers: Vec[(string, string, string, string)] = Vec::new();
    for coercion in coercions {
        let key = compact_type(coercion.for_ty);
        let raw_factory = raw_dyn_factory_name(coercion.trait_name, coercion.for_ty);
        if dyn_factory_name_count(coercions, raw_factory) > 1 {
            factories.push(
                (
                    coercion.trait_name,
                    key,
                    go_hashed_ident("fn", "dyn_vtable#" + coercion.trait_name + "#" + key),
                ),
            )
        }
        for method in dyn_methods(builtin, functions, coercion.trait_name) {
            let raw_wrapper = raw_dyn_wrapper_name(
                coercion.trait_name,
                coercion.for_ty,
                method.name,
            );
            if dyn_wrapper_name_count(builtin, coercions, functions, raw_wrapper) > 1 {
                wrappers.push(
                    (
                        coercion.trait_name,
                        key,
                        method.name,
                        go_hashed_ident(
                            "fn",
                            "dyn_wrap#" + coercion.trait_name + "#" + key + "#" + method.name,
                        ),
                    ),
                )
            }
        }
    }
    DynHelperNames { factories, wrappers }
}

fn dyn_type_items(trait_name: string, methods: Vec[DynMethod]) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let fields: Vec[(string, Type)] = Vec::new();
    for method in methods {
        let params: Vec[Type] = Vec::new();
        params.push(Type::Any);
        for param in method.params {
            params.push(lower_type(param))
        }
        fields.push(
            (go_ident(method.name), Type::Func { params, ret_ty: lower_type(method.ret_ty) }),
        )
    }
    result.push(Item::Struct(StructDef { name: dyn_vtable_name(trait_name), fields }));
    let object_fields: Vec[(string, Type)] = Vec::new();
    object_fields.push(("data", Type::Any));
    object_fields.push(
        ("vtable", Type::Pointer { elem: Type::Named { name: dyn_vtable_name(trait_name) } }),
    );
    result.push(
        Item::Struct(StructDef { name: dyn_object_name(trait_name), fields: object_fields }),
    );
    result
}

fn find_dyn_impl_name(
    functions: Vec[anf::Function],
    trait_name: string,
    for_ty: repr::Type,
    method_name: string,
) -> string {
    let mut index = functions.len() - 1;
    while index >= 0 {
        let function = functions[index];
        match (function.trait_impl, trait_impl_method_name(function)) {
            (Some(metadata), Some(candidate_method)) => {
                if metadata.trait_ref.name == trait_name
                    && encode_type(metadata.for_ty) == encode_type(for_ty)
                    && candidate_method == method_name {
                    return go_ident(function.name)
                } else {
                    index -= 1;
                }
            },
            _ => {
                index -= 1;
            },
        }
    }
    go_ident("trait_impl#" + trait_name + "#" + compact_type(for_ty) + "#" + method_name)
}

fn dyn_coercion_compare(left: DynCoercion, right: DynCoercion) -> cmp::Ordering {
    if left.trait_name == right.trait_name {
        cmp::compare(encode_type(left.for_ty), encode_type(right.for_ty))
    } else {
        cmp::compare(left.trait_name, right.trait_name)
    }
}

fn sorted_dyn_coercions(values: Vec[DynCoercion]) -> Vec[DynCoercion] {
    collections::sort_by_ordering(values, dyn_coercion_compare);
    values
}

fn is_enum_dyn_receiver(
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    value: repr::Type,
) -> bool {
    match repr::resolve_type(value) {
        Named { name } => find_enum(enums, name).is_some(),
        _ => false,
    }
}

fn dyn_coercion_items(
    functions: Vec[anf::Function],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    coercion: DynCoercion,
    methods: Vec[DynMethod],
    names: DynHelperNames,
) -> Vec[Item] {
    let result: Vec[Item] = Vec::new();
    let enum_receiver = is_enum_dyn_receiver(enums, instances, coercion.for_ty);
    for method in methods {
        let wrapper = dyn_wrapper_name(names, coercion.trait_name, coercion.for_ty, method.name);
        let wrapper_params: Vec[(string, Type)] = Vec::new();
        wrapper_params.push(("self", Type::Any));
        let wrapper_args: Vec[Expr] = Vec::new();
        wrapper_args.push(
            if enum_receiver {
                Expr::Var { name: "v" }
            } else {
                Expr::Cast { expr: Expr::Var { name: "self" }, ty: lower_type(coercion.for_ty) }
            },
        );
        for index in 0..method.params.len() {
            let name = f"p{index}";
            wrapper_params.push((name, lower_type(method.params[index])));
            wrapper_args.push(Expr::Var { name })
        }
        let wrapper_stmts: Vec[Stmt] = Vec::new();
        let wrapper_call = Expr::Call {
            func: Expr::Var {
                name: find_dyn_impl_name(
                    functions,
                    method.dispatch_trait,
                    coercion.for_ty,
                    method.name,
                ),
            },
            args: wrapper_args,
        };
        if enum_receiver {
            let cases: Vec[TypeSwitchCase] = Vec::new();
            let case_stmts: Vec[Stmt] = Vec::new();
            case_stmts.push(Stmt::Return { expr: Option::Some(wrapper_call) });
            cases.push(
                TypeSwitchCase {
                    ty: lower_type(coercion.for_ty),
                    body: Block { stmts: case_stmts },
                },
            );
            let default_stmts: Vec[Stmt] = Vec::new();
            default_stmts.push(Stmt::Panic { message: "unexpected type" });
            wrapper_stmts.push(
                Stmt::TypeSwitch {
                    binding: Option::Some("v"),
                    expr: Expr::Var { name: "self" },
                    cases,
                    default: Option::Some(Block { stmts: default_stmts }),
                },
            )
        } else {
            wrapper_stmts.push(Stmt::Return { expr: Option::Some(wrapper_call) })
        }
        result.push(
            Item::Function(
                Function {
                    name: wrapper,
                    params: wrapper_params,
                    ret_ty: Option::Some(lower_type(method.ret_ty)),
                    body: Block { stmts: wrapper_stmts },
                },
            ),
        )
    }
    let factory_stmts: Vec[Stmt] = Vec::new();
    let factory_fields: Vec[(string, Expr)] = Vec::new();
    for method in methods {
        factory_fields.push(
            (
                go_ident(method.name),
                Expr::Var {
                    name: dyn_wrapper_name(names, coercion.trait_name, coercion.for_ty, method.name),
                },
            ),
        )
    }
    factory_stmts.push(
        Stmt::Return {
            expr: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: dyn_vtable_name(coercion.trait_name) },
                        fields: factory_fields,
                    },
                },
            ),
        },
    );
    result.push(
        Item::Function(
            Function {
                name: dyn_factory_name(names, coercion.trait_name, coercion.for_ty),
                params: Vec::new(),
                ret_ty: Option::Some(
                    Type::Pointer {
                        elem: Type::Named { name: dyn_vtable_name(coercion.trait_name) },
                    },
                ),
                body: Block { stmts: factory_stmts },
            },
        ),
    );
    result
}

pub fn emit_builtin_runtime_items(
    builtin: tast::BuiltinContract,
    items: Vec[Item],
    types: Vec[repr::Type],
    missing_types: Vec[repr::Type],
    instances: Vec[repr::TypeInstance],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    function_names: FunctionNames,
    planned: VariantInfos,
) -> () {
    for instance in instances {
        if backend_names_match(instance.base_name, builtin.static_cell.name)
            && instance.args.len() == 1 {
            items.push(once_cell_new_item(instance));
            items.push(once_cell_get_or_init_item(instance))
        }
    }
    for ty in types {
        if let Array { len: _, elem: _ } = repr::resolve_type(ty) {
            for item in array_runtime_items(ty) {
                items.push(item)
            }
        }
    }
    for ty in types {
        if let VecType { elem: _ } = repr::resolve_type(ty) {
            items.push(Item::Struct(runtime_struct(ty)));
            for item in vec_runtime_items(ty) {
                items.push(item)
            }
        }
    }
    for ty in types {
        if let RefType { elem } = repr::resolve_type(ty) {
            let definition = runtime_struct(ty);
            let layout = enum_type_layout(elem, structs, planned, 0);
            if !layout.known || layout.size == 0 {
                definition.fields.push(("identity", Type::Uint8))
            }
            items.push(Item::Struct(definition));
            for item in ref_runtime_items(ty) {
                items.push(item)
            }
        }
    }
    let options: collections::HashSet[string] = collections::HashSet::new();
    for ty in types {
        if let HashMap { key, value } = repr::resolve_type(ty) {
            let option = synthetic_option_base(value);
            let include_option = !options.contains(option)
                && !option_available(builtin, instances, value);
            for item in hashmap_items(
                builtin,
                key,
                value,
                instances,
                enums,
                structs,
                function_names,
                planned,
                include_option,
            ) {
                items.push(item)
            }
            if include_option {
                let _ = options.insert(option);
            }
        }
    }
    for ty in missing_types {
        items.push(missing_runtime_item(ty))
    }
    for ty in types {
        if let Tuple { items: _ } = repr::resolve_type(ty) {
            items.push(Item::Struct(runtime_struct(ty)))
        }
    }
}

pub fn emit_dyn_runtime_items(
    builtin: tast::BuiltinContract,
    items: Vec[Item],
    types: Vec[repr::Type],
    coercions: Vec[DynCoercion],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    names: DynHelperNames,
) -> () {
    let dyn_traits: collections::HashSet[string] = collections::HashSet::new();
    for ty in types {
        if let Dyn { trait_name: name, .. } = repr::resolve_type(ty) {
            if dyn_traits.insert(name) {
                for item in dyn_type_items(name, dyn_methods(builtin, functions, name)) {
                    items.push(item)
                }
            }
        }
    }
    for coercion in sorted_dyn_coercions(coercions) {
        for item in dyn_coercion_items(
            functions,
            enums,
            instances,
            coercion,
            dyn_methods(builtin, functions, coercion.trait_name),
            names,
        ) {
            items.push(item)
        }
    }
}
