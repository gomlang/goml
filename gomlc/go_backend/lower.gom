package go_backend;

use module::anf;
use module::ast;
use module::resources;
use module::repr;
use module::tast;
use std::collections;
use std::num;
use std::task;

pub struct FunctionNames {
    pub by_source: HashMap[string, string],
    pub reserved: collections::HashSet[string],
    pub variant_names: HashMap[string, string],
}

struct LowerEnv {
    builtin: tast::BuiltinContract,
    joins: Vec[anf::JoinBind],
    constant_names: collections::HashSet[string],
    static_names: collections::HashSet[string],
    top_level_names: collections::HashSet[string],
    local_names: collections::HashSet[string],
    collection_array_consumers: HashMap[string, anf::Value],
    emitted_loop_labels: collections::IndexSet[string],
    active_loop_labels: Vec[(string, string)],
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
    pointer_params: Vec[PointerParamInfo],
    pointer_vars: collections::HashSet[string],
    select_counter: Ref[isize],
}

struct PointerParamInfo {
    function: string,
    values: Vec[bool],
    copies: Vec[bool],
}

struct CompiledValue {
    stmts: Vec[Stmt],
    expr: Expr,
}

struct RuntimeRequirements {
    runtime_hooks: Vec[string],
    missing_types: CollectedTypes,
    intrinsics: Vec[string],
    go_foreign: Vec[GoForeignSpec],
    callbacks: Vec[repr::CallbackAdapter],
    interface_bridges: Vec[repr::GoInterfaceBridge],
}

struct GoForeignSpec {
    bindings: Vec[string],
    is_method: bool,
    import_path: string,
    symbol: string,
    ty: repr::Type,
}

struct JoinRecResult {
    stmts: Vec[Stmt],
    loop_names: Vec[string],
}

fn append_stmts(target: Vec[Stmt], values: Vec[Stmt]) -> () {
    for value in values {
        target.push(value)
    }
}

fn function_name(value: string) -> string {
    if value == "main" {
        "main0"
    } else if value == "init" {
        go_generated_ident("_goml_user_init")
    } else {
        go_ident(value)
    }
}

fn new_function_names() -> FunctionNames {
    FunctionNames {
        by_source: HashMap::new(),
        reserved: collections::HashSet::new(),
        variant_names: HashMap::new(),
    }
}

fn add_function_name(values: FunctionNames, source: string, generated: string) -> () {
    values.by_source[source] = generated;
    let _ = values.reserved.insert(generated);
}

fn mapped_function_name(values: FunctionNames, value: string) -> Option[string] {
    values.by_source[value]
}

fn env_function_name(env: LowerEnv, value: string) -> string {
    mapped_function_name(env.function_names, value).unwrap_or_else(|| function_name(value))
}

fn function_type_names(
    function_names: FunctionNames,
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    for definition in structs {
        let name = go_user_type_name(definition.name);
        let _ = result.insert(name);
        let _ = function_names.reserved.insert(name);
    }
    for definition in enums {
        let name = go_user_type_name(definition.name);
        let _ = result.insert(name);
        let _ = function_names.reserved.insert(name);
    }
    for instance in instances {
        let name = go_user_type_name(instance.name);
        let _ = result.insert(name);
        let _ = function_names.reserved.insert(name);
    }
    result
}

fn resolve_function_name(value: string, type_names: collections::HashSet[string]) -> string {
    if value == "main" {
        "main"
    } else {
        let candidate = go_ident(value);
        if candidate == "init" || is_generated_tuple_type_name(candidate)
            || type_names.contains(candidate) {
            go_generated_ident("_goml_user_" + candidate)
        } else {
            candidate
        }
    }
}

fn add_entry_variant_names(
    used: NameSet,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> () {
    for definition in enums {
        for variant in definition.variants {
            let name = variant_go_name(
                definition.name,
                variant.name,
                enums,
                structs,
                instances,
                function_names,
            );
            add_reachable(used, name)
        }
    }
}

fn entry_wrapper_name(
    functions: Vec[anf::Function],
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> string {
    let used = new_name_set();
    for function in functions {
        if function.name != "main" {
            add_reachable(used, go_ident(function.name))
        }
    }
    for definition in structs {
        add_reachable(used, go_user_type_name(definition.name))
    }
    for definition in enums {
        add_reachable(used, go_user_type_name(definition.name))
    }
    for instance in instances {
        add_reachable(used, go_user_type_name(instance.name))
    }
    add_entry_variant_names(used, enums, structs, instances, function_names);
    if !name_present(used, "main0") {
        "main0"
    } else {
        let mut index = 1;
        let mut result = f"main0__{index}";
        while name_present(used, result) {
            index += 1;
            result = f"main0__{index}";
        }
        result
    }
}

fn build_function_names(
    functions: Vec[anf::Function],
    structs: Vec[repr::StructDef],
    enums: Vec[repr::EnumDef],
    instances: Vec[repr::TypeInstance],
) -> FunctionNames {
    let resolved = new_function_names();
    let type_names = function_type_names(resolved, structs, enums, instances);
    for function in functions {
        add_function_name(resolved, function.name, resolve_function_name(function.name, type_names))
    }
    let entry_name = entry_wrapper_name(functions, structs, enums, instances, resolved);
    let result = FunctionNames {
        by_source: HashMap::new(),
        reserved: resolved.reserved,
        variant_names: resolved.variant_names,
    };
    for function in functions {
        let name = if function.name == "main" {
            entry_name
        } else {
            mapped_function_name(resolved, function.name).unwrap_or_else(
                || function_name(function.name),
            )
        };
        add_function_name(result, function.name, name)
    }
    result
}

fn build_static_names(values: Vec[repr::Static]) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    for value in values {
        let _ = result.insert(value.name);
    }
    result
}

fn build_top_level_names(
    functions: Vec[anf::Function],
    constants: Vec[repr::Constant],
    statics: Vec[repr::Static],
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    let _ = result.insert("main");
    for function in functions {
        let _ = result.insert(
            mapped_function_name(function_names, function.name).unwrap_or_else(
                || function_name(function.name),
            ),
        );
    }
    for value in constants {
        let _ = result.insert(go_local_ident(value.name));
    }
    for value in statics {
        let _ = result.insert(go_local_ident(value.name));
    }
    for definition in structs {
        let _ = result.insert(go_user_type_name(definition.name));
    }
    for definition in enums {
        let _ = result.insert(go_user_type_name(definition.name));
        for variant in definition.variants {
            let _ = result.insert(
                variant_go_name(
                    definition.name,
                    variant.name,
                    enums,
                    structs,
                    instances,
                    function_names,
                ),
            );
        }
    }
    for instance in instances {
        let _ = result.insert(go_user_type_name(instance.name));
    }
    result
}

fn protect_local_ident(top_level_names: collections::HashSet[string], candidate: string) -> string {
    if top_level_names.contains(candidate) {
        go_generated_ident("_goml_local_" + candidate)
    } else {
        candidate
    }
}

fn local_ident(top_level_names: collections::HashSet[string], value: string) -> string {
    protect_local_ident(top_level_names, go_local_ident(value))
}

fn local_ident_with_suffix(
    top_level_names: collections::HashSet[string],
    value: string,
    suffix: string,
) -> string {
    protect_local_ident(top_level_names, go_local_ident(value) + suffix)
}

fn env_local_ident(env: LowerEnv, value: string) -> string {
    local_ident(env.top_level_names, value)
}

fn env_local_ident_with_suffix(env: LowerEnv, value: string, suffix: string) -> string {
    local_ident_with_suffix(env.top_level_names, value, suffix)
}

fn collect_local_term(names: collections::HashSet[string], value: anf::Term) -> () {
    match value {
        If { then_, else_, .. } => {
            collect_local_block(names, then_);
            collect_local_block(names, else_)
        },
        Match { arms, default, .. } => {
            for arm in arms {
                collect_local_block(names, arm.body)
            }
            if let Some(body) = default {
                collect_local_block(names, body)
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { binding, body, .. } => {
                        let _ = names.insert(binding);
                        collect_local_block(names, body)
                    },
                    Send { body, .. } => collect_local_block(names, body),
                }
            }
            if let Some(body) = default {
                collect_local_block(names, body)
            }
        },
        Return(_) | Jump { .. } | Unreachable { .. } => (),
    }
}

fn collect_local_block(names: collections::HashSet[string], value: anf::Block) -> () {
    for bind in value.binds {
        match bind {
            Let(value) => {
                let _ = names.insert(value.name);
            },
            Join(value) => {
                for param in value.params {
                    let _ = names.insert(param.0);
                }
                collect_local_block(names, value.body)
            },
            JoinRec(values) => for value in values {
                for param in value.params {
                    let _ = names.insert(param.0);
                }
                collect_local_block(names, value.body)
            },
        }
    }
    collect_local_term(names, value.term)
}

fn function_local_names(value: anf::Function) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    for param in value.params {
        let _ = result.insert(param.0);
    }
    collect_local_block(result, value.body);
    result
}

fn go_foreign_import_alias(import_path: string) -> string {
    go_hashed_ident("ffi_import", import_path)
}

fn go_foreign_wrapper_name(import_path: string, symbol: string, ty: repr::Type) -> string {
    go_hashed_ident("ffi", import_path + "\u0000" + symbol + "\u0000" + compact_type(ty))
}

fn go_method_wrapper_name(symbol: string, ty: repr::Type) -> string {
    go_hashed_ident("ffi_method", symbol + "\u0000" + compact_type(ty))
}

fn go_foreign_spec_name(spec: GoForeignSpec) -> string {
    if spec.is_method {
        go_method_wrapper_name(spec.symbol, spec.ty)
    } else {
        go_foreign_wrapper_name(spec.import_path, spec.symbol, spec.ty)
    }
}

fn go_foreign_call(spec: GoForeignSpec, args: Vec[Expr]) -> Expr {
    if spec.is_method {
        if let Func { params, ret_ty: _ } = repr::resolve_type(spec.ty) {
            if !params.is_empty() {
                return Expr::Call {
                    func: Expr::MethodExpression {
                        receiver: lower_type(params[0]),
                        name: spec.symbol,
                    },
                    args,
                }
            }
        }
    }
    Expr::Call {
        func: Expr::Field {
            expr: Expr::Var { name: go_foreign_import_alias(spec.import_path) },
            field_name: spec.symbol,
        },
        args,
    }
}

fn go_foreign_opaque_dyn(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Dyn { trait_name: _, args, associated_types, additional_bounds } => args.is_empty()
            && associated_types.is_empty()
            && additional_bounds.is_empty(),
        _ => false,
    }
}

fn go_foreign_argument(name: string, ty: repr::Type) -> Expr {
    let value = Expr::Var { name };
    if go_foreign_opaque_dyn(ty) {
        Expr::Field { expr: value, field_name: "data" }
    } else {
        value
    }
}

fn go_foreign_result(value: Expr, ty: repr::Type) -> Expr {
    if go_foreign_opaque_dyn(ty) {
        Expr::StructLiteral { ty: lower_type(ty), fields: Vec::from_array([("data", value)]) }
    } else {
        value
    }
}

fn go_foreign_wrapper(spec: GoForeignSpec) -> Function {
    match repr::resolve_type(spec.ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            for index in 0..param_types.len() {
                let name = f"arg{index}";
                params.push((name, lower_type(param_types[index])));
                args.push(go_foreign_argument(name, param_types[index]))
            }
            let call = go_foreign_call(spec, args);
            let stmts: Vec[Stmt] = Vec::new();
            match repr::resolve_type(ret_ty) {
                Unit => {
                    stmts.push(Stmt::Expr { expr: call });
                    stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
                },
                Tuple { items: values } => {
                    let names: Vec[string] = Vec::new();
                    let fields: Vec[(string, Expr)] = Vec::new();
                    for index in 0..values.len() {
                        let name = f"result{index}";
                        stmts.push(
                            Stmt::Var { name, ty: lower_type(values[index]), value: Option::None },
                        );
                        names.push(name);
                        fields.push((f"_{index}", Expr::Var { name }))
                    }
                    stmts.push(Stmt::MultiAssign { names, value: call });
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::StructLiteral { ty: lower_type(ret_ty), fields },
                            ),
                        },
                    )
                },
                _ => stmts.push(
                    Stmt::Return { expr: Option::Some(go_foreign_result(call, ret_ty)) },
                ),
            }
            Function {
                name: go_foreign_spec_name(spec),
                params,
                ret_ty: Option::Some(lower_type(ret_ty)),
                body: Block { stmts },
            }
        },
        _ => Function {
            name: go_foreign_spec_name(spec),
            params: Vec::new(),
            ret_ty: Option::Some(Type::Unit),
            body: Block {
                stmts: Vec::from_array([Stmt::Return { expr: Option::Some(Expr::Unit) }]),
            },
        },
    }
}

fn emit_go_foreign_import_items(
    items: Vec[Item],
    values: Vec[GoForeignSpec],
    types: Vec[repr::Type],
) -> () {
    let imports: Vec[(string, string)] = Vec::new();
    for value in values {
        if value.is_method {
            continue
        }
        let mut found = false;
        for present in imports {
            if present.1 == value.import_path {
                found = true;
                break
            }
        }
        if !found {
            imports.push((go_foreign_import_alias(value.import_path), value.import_path))
        }
    }
    for ty in types {
        if let repr::Type::External { import_path, .. } = ty {
            if import_path != "" {
                let mut found = false;
                for present in imports {
                    if present.1 == import_path {
                        found = true;
                    }
                }
                if !found {
                    imports.push((go_foreign_import_alias(import_path), import_path))
                }
            }
        }
    }
    if !imports.is_empty() {
        items.push(Item::ImportGroup(imports))
    }
}

fn emit_go_foreign_wrapper_items(items: Vec[Item], values: Vec[GoForeignSpec]) -> () {
    for value in values {
        items.push(Item::Function(go_foreign_wrapper(value)))
    }
}

fn callable_name(env: LowerEnv, value: repr::Callable, ty: repr::Type) -> string {
    match value {
        Function(name) => env_function_name(env, name),
        LangItem { item: _, function_name } => env_function_name(env, function_name),
        Runtime(name) => runtime_hook_name(name),
        CallbackAdapter(value) => callback_factory_name(value),
        InterfaceBridge(value) => interface_bridge_factory(value),
        Intrinsic(name) => go_ident(name),
        GoMethod { symbol, binding } => go_method_wrapper_name(symbol, ty),
        GoForeign { import_path, symbol, binding } => go_foreign_wrapper_name(
            import_path,
            symbol,
            ty,
        ),
        TraitMethod { trait_ref: reference, method_name: name, .. } => {
            go_ident(reference.name + "#" + name)
        },
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            go_ident("dyn#" + owner + "#" + dispatch + "#" + name)
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            env_function_name(env, repr::inherent_method_name(owner, name))
        },
    }
}

fn compact_go_float_literal(value: string) -> string {
    if value.byte_len() <= 64 || value.contains(".") || value.contains("e") || value.contains("E") {
        return value
    }
    let start = if value.byte_get(0) == b'-' {
        1
    } else {
        0
    };
    let mut end = value.byte_len();
    while end > start && value.byte_get(end - 1) == b'0' {
        end -= 1;
    }
    if end == start || end == value.byte_len() {
        value
    } else {
        f"{value.byte_slice(0, end)}e{value.byte_len() - end}"
    }
}

fn go_float_literal(value: string, ty: repr::Type) -> string {
    match repr::resolve_type(ty) {
        Float32 => value,
        Float64 => match num::parse_float64_structured(value) {
            Ok(parsed) => compact_go_float_literal(parsed.to_string()),
            Err(_) => value,
        },
        _ => value,
    }
}

fn compile_primitive(value: repr::Primitive, ty: repr::Type) -> Expr {
    match value {
        Unit => Expr::Unit,
        Bool { value } => Expr::Bool { value },
        Int { value } | Int8 { value } | Int16 { value } | Int32 { value } | Int64 { value } | Uint {
            value,
        } | Uint8 { value } | Uint16 { value } | Uint32 { value } | Uint64 { value } => Expr::Int {
            value,
        },
        Float { value } | Float32 { value } | Float64 { value } => Expr::Float {
            value: go_float_literal(value, ty),
        },
        String { value } => Expr::String { value },
        Char { value } => Expr::Int { value: (value.to_u32()).to_string() },
        Bytes { values } => {
            let items: Vec[Expr] = Vec::with_capacity(values.len());
            for value in values {
                items.push(Expr::Int { value })
            }
            let fields: Vec[(string, Expr)] = Vec::new();
            fields.push(
                ("items", Expr::ArrayLiteral { ty: Type::Slice { elem: Type::Uint8 }, items }),
            );
            Expr::Unary {
                op: UnaryOp::Address,
                expr: Expr::StructLiteral {
                    ty: Type::Named {
                        name: go_generated_ident(
                            "_goml_vec_" + go_ident(encode_type(repr::Type::Uint8)),
                        ),
                    },
                    fields,
                },
            }
        },
    }
}

fn compile_constant_expr(variants: VariantInfos, value: repr::ConstExpr) -> Expr {
    match value {
        Prim { value, ty } => compile_primitive(value, ty),
        Ref { name, ty: _ } => Expr::Var { name: go_local_ident(name) },
        Unary { op, expr, ty: _ } => Expr::Unary {
            op: compile_unary(op),
            expr: compile_constant_expr(variants, expr),
        },
        Cast { expr, ty } => Expr::Convert {
            ty: lower_type(ty),
            expr: compile_constant_expr(variants, expr),
        },
        Binary { op, lhs, rhs, ty: _ } => Expr::Binary {
            op: compile_binary(op),
            lhs: compile_constant_expr(variants, lhs),
            rhs: compile_constant_expr(variants, rhs),
        },
        Tuple { items, ty } => {
            let fields: Vec[(string, Expr)] = Vec::with_capacity(items.len());
            for index in 0..items.len() {
                fields.push((f"_{index}", compile_constant_expr(variants, items[index])))
            }
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        Array { items, ty } => {
            let values: Vec[Expr] = Vec::with_capacity(items.len());
            for item in items {
                values.push(compile_constant_expr(variants, item))
            }
            Expr::ArrayLiteral { ty: lower_type(ty), items: values }
        },
        Constr { constructor, args, ty } => {
            let info = constructor.tag.and_then(|tag| find_variant_info(variants, ty, tag));
            let values: Vec[Expr] = Vec::with_capacity(args.len());
            for index in 0..args.len() {
                values.push(compile_constant_expr(variants, args[index]))
            }
            if constructor.is_struct {
                let fields: Vec[(string, Expr)] = Vec::with_capacity(values.len());
                for index in 0..values.len() {
                    fields.push(
                        (
                            if index < constructor.fields.len() {
                                go_ident(constructor.fields[index])
                            } else {
                                f"_{index}"
                            },
                            values[index],
                        ),
                    )
                }
                return Expr::StructLiteral { ty: lower_type(ty), fields }
            }
            let variant = match info {
                Some(value) => value,
                None => {
                    let fields: Vec[(string, Expr)] = Vec::with_capacity(values.len());
                    for index in 0..values.len() {
                        fields.push((f"_{index}", values[index]))
                    }
                    return Expr::StructLiteral { ty: constructor_type(constructor), fields }
                },
            };
            match find_enum_info(variants, ty) {
                Some(owner) => match owner.storage {
                    Singleton => Expr::StructLiteral { ty: lower_type(ty), fields: Vec::new() },
                    TagOnly => enum_named_expr(ty, Expr::Int { value: variant.tag.to_string() }),
                    Flat | PointerNiche | Node => {
                        let fields: Vec[(string, Expr)] = Vec::new();
                        for index in 0..values.len() {
                            if index < variant.field_names.len() {
                                if let Some(name) = variant.field_names[index] {
                                    fields.push((name, values[index]))
                                }
                            }
                        }
                        match owner.storage {
                            Flat => {
                                fields.push(("_tag", Expr::Int { value: variant.tag.to_string() }));
                                Expr::StructLiteral { ty: lower_type(ty), fields }
                            },
                            PointerNiche => Expr::StructLiteral { ty: lower_type(ty), fields },
                            Node => if owner.nil_tag == Option::Some(variant.tag) {
                                Expr::StructLiteral { ty: lower_type(ty), fields: Vec::new() }
                            } else {
                                fields.push(("_tag", Expr::Int { value: variant.tag.to_string() }));
                                Expr::StructLiteral {
                                    ty: lower_type(ty),
                                    fields: Vec::from_array(
                                        [
                                            (
                                                "_node",
                                                Expr::Unary {
                                                    op: UnaryOp::Address,
                                                    expr: Expr::StructLiteral {
                                                        ty: Type::Named { name: owner.node_name },
                                                        fields,
                                                    },
                                                },
                                            ),
                                        ],
                                    ),
                                }
                            },
                            _ => Expr::StructLiteral { ty: lower_type(ty), fields },
                        }
                    },
                    Packed => if values.is_empty() {
                        enum_named_expr(ty, Expr::Int { value: "0" })
                    } else {
                        enum_packed_value_expr(
                            owner,
                            ty,
                            owner.payload_ty.unwrap_or(repr::Type::Unit),
                            values[0],
                        )
                    },
                    Interface => {
                        let fields: Vec[(string, Expr)] = Vec::with_capacity(values.len());
                        for index in 0..values.len() {
                            fields.push((f"_{index}", values[index]))
                        }
                        Expr::StructLiteral {
                            ty: Type::Named { name: variant.variant_name },
                            fields,
                        }
                    },
                },
                None => {
                    let fields: Vec[(string, Expr)] = Vec::with_capacity(values.len());
                    for index in 0..values.len() {
                        fields.push((f"_{index}", values[index]))
                    }
                    Expr::StructLiteral { ty: constructor_type(constructor), fields }
                },
            }
        },
    }
}

fn scalar_constant_type(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        _ => false,
    }
}

fn build_constant_names(values: Vec[repr::Constant]) -> collections::HashSet[string] {
    let result: collections::HashSet[string] = collections::HashSet::new();
    for value in values {
        let _ = result.insert(value.name);
    }
    result
}

fn emit_constants(items: Vec[Item], values: Vec[repr::Constant], variants: VariantInfos) -> () {
    let specs: Vec[ConstSpec] = Vec::new();
    for value in values {
        if scalar_constant_type(value.ty) {
            specs.push(
                ConstSpec {
                    name: go_local_ident(value.name),
                    ty: lower_type(value.ty),
                    value: compile_constant_expr(variants, value.value),
                },
            )
        } else {
            items.push(
                Item::Global(
                    Global {
                        name: go_local_ident(value.name),
                        ty: Option::Some(lower_type(value.ty)),
                        value: compile_constant_expr(variants, value.value),
                    },
                ),
            )
        }
    }
    if specs.is_empty() {} else {
        items.push(Item::ConstGroup(ConstGroup { specs }))
    }
}

fn emit_statics(items: Vec[Item], values: Vec[repr::Static]) -> () {
    for value in values {
        let cell_ty = lower_type(value.ty);
        let body_stmts: Vec[Stmt] = Vec::new();
        body_stmts.push(
            Stmt::Var {
                name: "cell",
                ty: cell_ty,
                value: Option::Some(
                    Expr::Call {
                        func: Expr::Var { name: runtime_helper_name("once_cell_new", value.ty) },
                        args: Vec::new(),
                    },
                ),
            },
        );
        body_stmts.push(
            Stmt::FieldAssign {
                target: Expr::Var { name: "cell" },
                field_name: "name",
                value: Expr::String { value: value.name },
            },
        );
        body_stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "cell" }) });
        items.push(
            Item::Global(
                Global {
                    name: go_local_ident(value.name),
                    ty: Option::Some(cell_ty),
                    value: Expr::Call {
                        func: Expr::FuncLit {
                            params: Vec::new(),
                            ret_ty: cell_ty,
                            body: Block { stmts: body_stmts },
                        },
                        args: Vec::new(),
                    },
                },
            ),
        )
    }
}

fn compile_imm(env: LowerEnv, value: anf::Imm) -> Expr {
    match value {
        Var { name, ty: _ } => {
            let local = env.local_names.contains(name);
            let result = if local {
                Expr::Var { name: env_local_ident(env, name) }
            } else {
                match mapped_function_name(env.function_names, name) {
                    Some(value) => Expr::Var { name: value },
                    None => {
                        Expr::Var {
                            name: if env.constant_names.contains(name)
                                || env.static_names.contains(name) {
                                go_local_ident(name)
                            } else {
                                env_local_ident(env, name)
                            },
                        }
                    },
                }
            };
            if local && env.pointer_vars.contains(name) {
                Expr::Unary { op: UnaryOp::Deref, expr: result }
            } else {
                result
            }
        },
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            compile_intrinsic_callable(key, function_ty)
        },
        Callable { callable: value, ty } => Expr::Var { name: callable_name(env, value, ty) },
        Prim { value, ty } => compile_primitive(value, ty),
        Tag { index, ty: owner_ty } => {
            match find_enum_info(env.variants, owner_ty) {
                Some(owner) => match owner.storage {
                    Singleton => Expr::StructLiteral {
                        ty: lower_type(owner_ty),
                        fields: Vec::new(),
                    },
                    TagOnly => match find_variant_info(env.variants, owner_ty, index) {
                        Some(info) => Expr::Var { name: info.variant_name },
                        None => Expr::Int { value: index.to_string() },
                    },
                    PointerNiche | Packed => Expr::Bool {
                        value: owner.payload_tag == Option::Some(index),
                    },
                    Flat | Node | Interface => Expr::Int { value: index.to_string() },
                },
                None => Expr::Int { value: index.to_string() },
            }
        },
    }
}

fn enum_node_expr(value: Expr) -> Expr {
    Expr::Field { expr: value, field_name: "_node" }
}

fn enum_named_expr(owner_ty: repr::Type, value: Expr) -> Expr {
    Expr::Convert { ty: lower_type(owner_ty), expr: value }
}

fn compile_packed_constructor(env: LowerEnv, owner: EnumInfo, owner_ty: repr::Type, value: anf::Imm) -> Expr {
    let payload_ty = owner.payload_ty.unwrap_or(anf::imm_type(value));
    enum_packed_value_expr(owner, owner_ty, payload_ty, compile_imm(env, value))
}

fn compile_packed_projection(env: LowerEnv, owner: EnumInfo, value: anf::Imm) -> Expr {
    enum_packed_payload_expr(owner, compile_imm(env, value))
}

fn imm_is_go_constant(env: LowerEnv, value: anf::Imm) -> bool {
    match value {
        Prim { .. } => true,
        Var { name, ty: _ } => env.constant_names.contains(name),
        Callable { .. } | Tag { .. } => false,
    }
}

fn compile_runtime_imm(env: LowerEnv, value: anf::Imm, name: string) -> CompiledValue {
    let expr = compile_imm(env, value);
    if imm_is_go_constant(env, value) {
        let stmts: Vec[Stmt] = Vec::new();
        stmts.push(
            Stmt::Var { name, ty: lower_type(anf::imm_type(value)), value: Option::Some(expr) },
        );
        CompiledValue { stmts, expr: Expr::Var { name } }
    } else {
        CompiledValue { stmts: Vec::new(), expr }
    }
}

fn compile_closure_function(
    env: LowerEnv,
    environment: anf::Imm,
    apply: string,
    target_ty: repr::Type,
) -> Expr {
    match repr::resolve_type(target_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            args.push(compile_imm(env, environment));
            for index in 0..param_types.len() {
                let name = f"p{index}";
                params.push((name, lower_type(param_types[index])));
                args.push(Expr::Var { name })
            }
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(
                Stmt::Return {
                    expr: Option::Some(
                        Expr::Call { func: Expr::Var { name: env_function_name(env, apply) }, args },
                    ),
                },
            );
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => compile_imm(env, environment),
    }
}

fn compile_imm_expected(env: LowerEnv, value: anf::Imm, expected_ty: repr::Type) -> Expr {
    match value {
        Tag { index: tag, ty: owner_ty } => {
            match find_enum_info(env.variants, owner_ty) {
                Some(owner) => match owner.storage {
                    Singleton | TagOnly => compile_imm(env, value),
                    Flat => Expr::StructLiteral {
                        ty: lower_type(owner_ty),
                        fields: Vec::from_array([("_tag", Expr::Int { value: tag.to_string() })]),
                    },
                    PointerNiche => Expr::StructLiteral {
                        ty: lower_type(owner_ty),
                        fields: Vec::new(),
                    },
                    Packed => enum_named_expr(owner_ty, Expr::Int { value: "0" }),
                    Node => if owner.nil_tag == Option::Some(tag) {
                        Expr::StructLiteral { ty: lower_type(owner_ty), fields: Vec::new() }
                    } else {
                        Expr::StructLiteral {
                            ty: lower_type(owner_ty),
                            fields: Vec::from_array(
                                [
                                    (
                                        "_node",
                                        Expr::Unary {
                                            op: UnaryOp::Address,
                                            expr: Expr::StructLiteral {
                                                ty: Type::Named { name: owner.node_name },
                                                fields: Vec::from_array(
                                                    [("_tag", Expr::Int { value: tag.to_string() })],
                                                ),
                                            },
                                        },
                                    ),
                                ],
                            ),
                        }
                    },
                    Interface => match variant_type(env.variants, owner_ty, tag) {
                        Some(ty) => Expr::StructLiteral { ty, fields: Vec::new() },
                        None => compile_imm(env, value),
                    },
                },
                None => compile_imm(env, value),
            }
        },
        _ => compile_imm(env, value),
    }
}

fn compile_imms_expected(env: LowerEnv, values: Vec[anf::Imm], expected: Vec[repr::Type]) -> Vec[
    Expr,
] {
    let result: Vec[Expr] = Vec::new();
    for index in 0..values.len() {
        if index < expected.len() {
            result.push(compile_imm_expected(env, values[index], expected[index]))
        } else {
            result.push(compile_imm(env, values[index]))
        }
    }
    result
}

fn find_dyn_method(
    builtin: tast::BuiltinContract,
    functions: Vec[anf::Function],
    trait_name: string,
    method_name: string,
) -> Option[DynMethod] {
    let methods = dyn_methods(builtin, functions, trait_name);
    let mut index = methods.len() - 1;
    while index >= 0 {
        let method = methods[index];
        if method.name == method_name {
            return Option::Some(method)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn intrinsic_source_name(key: string) -> string {
    if key == "array.get" {
        "array_get"
    } else if key == "array.set" {
        "array_set"
    } else if key == "ref.new" {
        "ref"
    } else if key == "ref.get" {
        "ref_get"
    } else if key == "ref.set" {
        "ref_set"
    } else if key == "ref.ptr_eq" {
        "ptr_eq"
    } else if key == "ref.ptr_hash" {
        "ptr_hash"
    } else if key == "vec.new" {
        "vec_new"
    } else if key == "vec.with_capacity" {
        "vec_with_capacity"
    } else if key == "vec.push" {
        "vec_push"
    } else if key == "vec.get" {
        "vec_get"
    } else if key == "vec.set" {
        "vec_set"
    } else if key == "vec.len" {
        "vec_len"
    } else if key == "vec.capacity" {
        "vec_capacity"
    } else if key == "vec.reserve" {
        "vec_reserve"
    } else if key == "vec.truncate" {
        "vec_truncate"
    } else if key == "once_cell.new" {
        "once_cell_new"
    } else if key == "once_cell.get_or_init" {
        "once_cell_get_or_init"
    } else if key == "hashmap.new" {
        "hashmap_new"
    } else if key == "hashmap.get" {
        "hashmap_get"
    } else if key == "hashmap.set" {
        "hashmap_set"
    } else if key == "hashmap.insert" {
        "hashmap_insert"
    } else if key == "hashmap.get_or_insert_with" {
        "hashmap_get_or_insert_with"
    } else if key == "hashmap.update" {
        "hashmap_update"
    } else if key == "hashmap.remove_value" {
        "hashmap_remove_value"
    } else if key == "hashmap.remove" {
        "hashmap_remove"
    } else if key == "hashmap.len" {
        "hashmap_len"
    } else if key == "hashmap.contains" {
        "hashmap_contains"
    } else if key == "hashmap.entries" {
        "hashmap_entries"
    } else if key == "channel.new" {
        "channel_new"
    } else if key == "channel.send" {
        "channel_send"
    } else if key == "channel.recv" {
        "channel_recv"
    } else if key == "channel.send_cancel" {
        "channel_send_cancel"
    } else if key == "channel.recv_cancel" {
        "channel_recv_cancel"
    } else if key == "channel.close" {
        "channel_close"
    } else if key == "compiler.missing" {
        "missing"
    } else {
        key
    }
}

fn intrinsic_owner_type(key: string, function_ty: repr::Type, args: Vec[anf::Imm]) -> Option[
    repr::Type,
] {
    if key == "ref.new" || key == "vec.new" || key == "vec.with_capacity" || key == "hashmap.new"
        || key == "once_cell.new"
        || key == "compiler.missing" {
        match repr::resolve_type(function_ty) {
            Func { params: _, ret_ty } => Option::Some(ret_ty),
            _ => Option::None,
        }
    } else if !args.is_empty() {
        Option::Some(anf::imm_type(args[0]))
    } else {
        match repr::resolve_type(function_ty) {
            Func { params, ret_ty: _ } => {
                if !params.is_empty() {
                    Option::Some(params[0])
                } else {
                    Option::None
                }
            },
            _ => Option::None,
        }
    }
}

fn intrinsic_helper_call_name(key: string, function_ty: repr::Type, args: Vec[anf::Imm]) -> Option[
    string,
] {
    let supported = key == "array.get" || key == "array.set" || key == "ref.new" || key == "ref.get"
        || key == "ref.set"
        || key == "ref.ptr_eq"
        || key == "ref.ptr_hash"
        || key == "vec.new"
        || key == "vec.with_capacity"
        || key == "vec.push"
        || key == "vec.get"
        || key == "vec.set"
        || key == "vec.len"
        || key == "vec.capacity"
        || key == "vec.reserve"
        || key == "vec.truncate"
        || key == "once_cell.new"
        || key == "once_cell.get_or_init"
        || key == "hashmap.new"
        || key == "hashmap.get"
        || key == "hashmap.set"
        || key == "hashmap.insert"
        || key == "hashmap.get_or_insert_with"
        || key == "hashmap.update"
        || key == "hashmap.remove_value"
        || key == "hashmap.remove"
        || key == "hashmap.len"
        || key == "hashmap.contains"
        || key == "hashmap.entries"
        || key == "compiler.missing";
    if supported {
        intrinsic_owner_type(key, function_ty, args).map(
            |owner| runtime_helper_name(intrinsic_source_name(key), owner),
        )
    } else {
        Option::None
    }
}

fn compile_slice_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let vars: Vec[Expr] = Vec::new();
            for index in 0..param_types.len() {
                let name = f"p{index}";
                params.push((name, lower_type(param_types[index])));
                vars.push(Expr::Var { name })
            }
            if key == "mut_slice.set" {
                let stmts: Vec[Stmt] = Vec::new();
                stmts.push(Stmt::IndexAssign { base: vars[0], index: vars[1], value: vars[2] });
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) });
                return Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
            }
            if key == "mut_slice.copy_from" {
                let source_len_args: Vec[Expr] = Vec::new();
                source_len_args.push(vars[2]);
                let source_len = Expr::Call {
                    func: Expr::Var { name: "len" },
                    args: source_len_args,
                };
                let target_len_args: Vec[Expr] = Vec::new();
                target_len_args.push(vars[0]);
                let target_len = Expr::Call {
                    func: Expr::Var { name: "len" },
                    args: target_len_args,
                };
                let invalid = Expr::Binary {
                    op: BinaryOp::Or,
                    lhs: Expr::Binary {
                        op: BinaryOp::Less,
                        lhs: vars[1],
                        rhs: Expr::Int { value: "0" },
                    },
                    rhs: Expr::Binary {
                        op: BinaryOp::Greater,
                        lhs: source_len,
                        rhs: Expr::Binary { op: BinaryOp::Sub, lhs: target_len, rhs: vars[1] },
                    },
                };
                let invalid_stmts: Vec[Stmt] = Vec::new();
                invalid_stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: false }) });
                let stmts: Vec[Stmt] = Vec::new();
                stmts.push(
                    Stmt::If {
                        cond: invalid,
                        then_: Block { stmts: invalid_stmts },
                        else_: Option::None,
                    },
                );
                let copied_len_args: Vec[Expr] = Vec::new();
                copied_len_args.push(vars[2]);
                let copy_args: Vec[Expr] = Vec::new();
                copy_args.push(
                    Expr::Slice {
                        base: vars[0],
                        start: vars[1],
                        end: Expr::Binary {
                            op: BinaryOp::Add,
                            lhs: vars[1],
                            rhs: Expr::Call {
                                func: Expr::Var { name: "len" },
                                args: copied_len_args,
                            },
                        },
                    },
                );
                copy_args.push(vars[2]);
                stmts.push(
                    Stmt::Expr {
                        expr: Expr::Call { func: Expr::Var { name: "copy" }, args: copy_args },
                    },
                );
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Bool { value: true }) });
                return Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
            }
            let value = if key == "slice.new" || key == "mut_slice.new" {
                Expr::Slice {
                    base: Expr::Field { expr: vars[0], field_name: "items" },
                    start: vars[1],
                    end: vars[2],
                }
            } else if key == "slice.get" || key == "mut_slice.get" {
                Expr::Index { base: vars[0], index: vars[1] }
            } else if key == "slice.len" || key == "mut_slice.len" {
                let args: Vec[Expr] = Vec::new();
                args.push(vars[0]);
                Expr::Call { func: Expr::Var { name: "len" }, args }
            } else if key == "mut_slice.as_slice" {
                vars[0]
            } else {
                Expr::Slice { base: vars[0], start: vars[1], end: vars[2] }
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(Stmt::Return { expr: Option::Some(value) });
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_channel_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let vars: Vec[Expr] = Vec::new();
            for index in 0..param_types.len() {
                let name = f"p{index}";
                params.push((name, lower_type(param_types[index])));
                vars.push(Expr::Var { name })
            }
            let stmts: Vec[Stmt] = Vec::new();
            if key == "channel.new" {
                let args: Vec[Expr] = Vec::new();
                args.push(vars[0]);
                stmts.push(
                    Stmt::Return { expr: Option::Some(Expr::Make { ty: lower_type(ret_ty), args }) },
                )
            } else if key == "channel.sender" || key == "channel.receiver" {
                stmts.push(Stmt::Return { expr: Option::Some(vars[0]) })
            } else if key == "channel.split" {
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(
                            Expr::StructLiteral {
                                ty: lower_type(ret_ty),
                                fields: Vec::from_array([("_0", vars[0]), ("_1", vars[0])]),
                            },
                        ),
                    },
                )
            } else if key == "channel.send" {
                stmts.push(Stmt::Expr { expr: Expr::Send { channel: vars[0], value: vars[1] } });
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
            } else if key == "channel.recv" {
                let elem = match repr::resolve_type(param_types[0]) {
                    Channel { elem, direction: _ } => elem,
                    _ => repr::Type::Unit,
                };
                stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
                stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::MultiAssign {
                        names: Vec::from_array(["value", "ok"]),
                        value: Expr::Receive { channel: vars[0] },
                    },
                );
                let fields: Vec[(string, Expr)] = Vec::new();
                fields.push(("_0", Expr::Var { name: "value" }));
                fields.push(("_1", Expr::Var { name: "ok" }));
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(Expr::StructLiteral { ty: lower_type(ret_ty), fields }),
                    },
                )
            } else if key == "channel.send_cancel" {
                stmts.push(Stmt::Var { name: "completed", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::Select {
                        cases: Vec::from_array(
                            [
                                SelectCase {
                                    operation: SelectOperation::Send {
                                        channel: vars[0],
                                        value: vars[1],
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: true },
                                                },
                                            ],
                                        ),
                                    },
                                },
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::new(),
                                        channel: task_context_done_expr(vars[2]),
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: false },
                                                },
                                            ],
                                        ),
                                    },
                                },
                            ],
                        ),
                        default: Option::None,
                    },
                );
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Var { name: "completed" }) })
            } else if key == "channel.recv_cancel" {
                let elem = match repr::resolve_type(param_types[0]) {
                    Channel { elem, direction: _ } => elem,
                    _ => repr::Type::Unit,
                };
                stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
                stmts.push(Stmt::Var { name: "ok", ty: Type::Bool, value: Option::None });
                stmts.push(Stmt::Var { name: "completed", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::Select {
                        cases: Vec::from_array(
                            [
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::from_array(["value", "ok"]),
                                        channel: vars[0],
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: true },
                                                },
                                            ],
                                        ),
                                    },
                                },
                                SelectCase {
                                    operation: SelectOperation::Receive {
                                        names: Vec::new(),
                                        channel: task_context_done_expr(vars[1]),
                                    },
                                    body: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "completed",
                                                    value: Expr::Bool { value: false },
                                                },
                                            ],
                                        ),
                                    },
                                },
                            ],
                        ),
                        default: Option::None,
                    },
                );
                let fields: Vec[(string, Expr)] = Vec::new();
                fields.push(("_0", Expr::Var { name: "value" }));
                fields.push(("_1", Expr::Var { name: "ok" }));
                fields.push(("_2", Expr::Var { name: "completed" }));
                stmts.push(
                    Stmt::Return {
                        expr: Option::Some(Expr::StructLiteral { ty: lower_type(ret_ty), fields }),
                    },
                )
            } else {
                let args: Vec[Expr] = Vec::new();
                args.push(vars[0]);
                stmts.push(
                    Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "close" }, args } },
                );
                stmts.push(Stmt::Return { expr: Option::Some(Expr::Unit) })
            }
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn dynamic_select_len(value: Expr) -> Expr {
    Expr::Call { func: Expr::Var { name: "len" }, args: Vec::from_array([value]) }
}

fn dynamic_select_index(value: Expr, index: Expr) -> Expr {
    Expr::Index { base: value, index }
}

fn dynamic_select_return(
    ret_ty: Type,
    index: Expr,
    kind: Expr,
    value: Expr,
    open: Expr,
    selected: Expr,
) -> Stmt {
    Stmt::Return {
        expr: Option::Some(
            Expr::StructLiteral {
                ty: ret_ty,
                fields: Vec::from_array(
                    [("_0", index), ("_1", kind), ("_2", value), ("_3", open), ("_4", selected)],
                ),
            },
        ),
    }
}

fn compile_dynamic_priority_select_callable(function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            for index in 0..param_types.len() {
                params.push((f"p{index}", lower_type(param_types[index])))
            }
            let elem = match repr::resolve_type(ret_ty) {
                Tuple { items } => items[2],
                _ => repr::Type::Unit,
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(
                Stmt::Var {
                    name: "index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            stmts.push(
                Stmt::Var {
                    name: "receive_index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            stmts.push(
                Stmt::Var {
                    name: "send_index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
            stmts.push(Stmt::Var { name: "open", ty: Type::Bool, value: Option::None });
            stmts.push(Stmt::Var { name: "selected", ty: Type::Bool, value: Option::None });
            let case_type = Type::Named { name: "_goml_reflect.SelectCase" };
            stmts.push(
                Stmt::Var {
                    name: "cases",
                    ty: Type::Slice { elem: case_type },
                    value: Option::Some(
                        Expr::Make {
                            ty: Type::Slice { elem: case_type },
                            args: Vec::from_array([Expr::Int { value: "2" }]),
                        },
                    ),
                },
            );
            stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "cases" },
                    index: Expr::Int { value: "1" },
                    value: Expr::StructLiteral {
                        ty: case_type,
                        fields: Vec::from_array(
                            [("Dir", Expr::Var { name: "_goml_reflect.SelectDefault" })],
                        ),
                    },
                },
            );
            stmts.push(Stmt::Var { name: "chosen", ty: Type::Int, value: Option::None });
            stmts.push(
                Stmt::Var {
                    name: "received",
                    ty: Type::Named { name: "_goml_reflect.Value" },
                    value: Option::None,
                },
            );
            let loop_stmts: Vec[Stmt] = Vec::new();
            loop_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::GreaterEq,
                        lhs: Expr::Var { name: "index" },
                        rhs: dynamic_select_len(Expr::Var { name: "p0" }),
                    },
                    then_: Block { stmts: Vec::from_array([Stmt::Break]) },
                    else_: Option::None,
                },
            );
            let receive_stmts: Vec[Stmt] = Vec::new();
            receive_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "cases" },
                    index: Expr::Int { value: "0" },
                    value: Expr::StructLiteral {
                        ty: case_type,
                        fields: Vec::from_array(
                            [
                                ("Dir", Expr::Var { name: "_goml_reflect.SelectRecv" }),
                                (
                                    "Chan",
                                    Expr::Call {
                                        func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                        args: Vec::from_array(
                                            [
                                                dynamic_select_index(
                                                    Expr::Var { name: "p1" },
                                                    Expr::Var { name: "receive_index" },
                                                ),
                                            ],
                                        ),
                                    },
                                ),
                            ],
                        ),
                    },
                },
            );
            receive_stmts.push(
                Stmt::MultiAssign {
                    names: Vec::from_array(["chosen", "received", "open"]),
                    value: Expr::Call {
                        func: Expr::Var { name: "_goml_reflect.Select" },
                        args: Vec::from_array([Expr::Var { name: "cases" }]),
                    },
                },
            );
            receive_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: Expr::Var { name: "chosen" },
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Assign {
                                    name: "value",
                                    value: Expr::Cast {
                                        expr: Expr::Call {
                                            func: Expr::Field {
                                                expr: Expr::Var { name: "received" },
                                                field_name: "Interface",
                                            },
                                            args: Vec::new(),
                                        },
                                        ty: lower_type(elem),
                                    },
                                },
                                Stmt::Assign { name: "selected", value: Expr::Bool { value: true } },
                            ],
                        ),
                    },
                    else_: Option::None,
                },
            );
            receive_stmts.push(
                Stmt::Assign {
                    name: "receive_index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "receive_index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            let send_stmts: Vec[Stmt] = Vec::new();
            send_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "cases" },
                    index: Expr::Int { value: "0" },
                    value: Expr::StructLiteral {
                        ty: case_type,
                        fields: Vec::from_array(
                            [
                                ("Dir", Expr::Var { name: "_goml_reflect.SelectSend" }),
                                (
                                    "Chan",
                                    Expr::Call {
                                        func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                        args: Vec::from_array(
                                            [
                                                dynamic_select_index(
                                                    Expr::Var { name: "p2" },
                                                    Expr::Var { name: "send_index" },
                                                ),
                                            ],
                                        ),
                                    },
                                ),
                                (
                                    "Send",
                                    Expr::Call {
                                        func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                        args: Vec::from_array(
                                            [
                                                dynamic_select_index(
                                                    Expr::Var { name: "p3" },
                                                    Expr::Var { name: "send_index" },
                                                ),
                                            ],
                                        ),
                                    },
                                ),
                            ],
                        ),
                    },
                },
            );
            send_stmts.push(
                Stmt::MultiAssign {
                    names: Vec::from_array(["chosen", "received", "open"]),
                    value: Expr::Call {
                        func: Expr::Var { name: "_goml_reflect.Select" },
                        args: Vec::from_array([Expr::Var { name: "cases" }]),
                    },
                },
            );
            send_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: Expr::Var { name: "chosen" },
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block {
                        stmts: Vec::from_array(
                            [Stmt::Assign { name: "selected", value: Expr::Bool { value: true } }],
                        ),
                    },
                    else_: Option::None,
                },
            );
            send_stmts.push(
                Stmt::Assign {
                    name: "send_index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "send_index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            loop_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: dynamic_select_index(
                            Expr::Var { name: "p0" },
                            Expr::Var { name: "index" },
                        ),
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block { stmts: receive_stmts },
                    else_: Option::Some(Block { stmts: send_stmts }),
                },
            );
            loop_stmts.push(
                Stmt::If {
                    cond: Expr::Var { name: "selected" },
                    then_: Block {
                        stmts: Vec::from_array(
                            [
                                dynamic_select_return(
                                    lower_type(ret_ty),
                                    Expr::Var { name: "index" },
                                    dynamic_select_index(
                                        Expr::Var { name: "p0" },
                                        Expr::Var { name: "index" },
                                    ),
                                    Expr::Var { name: "value" },
                                    Expr::Var { name: "open" },
                                    Expr::Bool { value: true },
                                ),
                            ],
                        ),
                    },
                    else_: Option::None,
                },
            );
            loop_stmts.push(
                Stmt::Assign {
                    name: "index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
            stmts.push(
                dynamic_select_return(
                    lower_type(ret_ty),
                    Expr::Int { value: "-1" },
                    Expr::Int { value: "-1" },
                    Expr::Var { name: "value" },
                    Expr::Bool { value: false },
                    Expr::Bool { value: false },
                ),
            );
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: "channel_dynamic_try_select_priority" },
    }
}

fn compile_dynamic_reflect_select_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            for index in 0..param_types.len() {
                params.push((f"p{index}", lower_type(param_types[index])))
            }
            let elem = match repr::resolve_type(ret_ty) {
                Tuple { items } => items[2],
                _ => repr::Type::Unit,
            };
            let try_select = key == "channel.dynamic_try_select";
            let case_type = Type::Named { name: "_goml_reflect.SelectCase" };
            let case_count = if try_select {
                Expr::Binary {
                    op: BinaryOp::Add,
                    lhs: dynamic_select_len(Expr::Var { name: "p0" }),
                    rhs: Expr::Int { value: "1" },
                }
            } else {
                dynamic_select_len(Expr::Var { name: "p0" })
            };
            let stmts: Vec[Stmt] = Vec::new();
            stmts.push(
                Stmt::Var {
                    name: "cases",
                    ty: Type::Slice { elem: case_type },
                    value: Option::Some(
                        Expr::Make {
                            ty: Type::Slice { elem: case_type },
                            args: Vec::from_array([case_count]),
                        },
                    ),
                },
            );
            stmts.push(
                Stmt::Var {
                    name: "index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            stmts.push(
                Stmt::Var {
                    name: "receive_index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            stmts.push(
                Stmt::Var {
                    name: "send_index",
                    ty: Type::Int,
                    value: Option::Some(Expr::Int { value: "0" }),
                },
            );
            let loop_stmts: Vec[Stmt] = Vec::new();
            loop_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::GreaterEq,
                        lhs: Expr::Var { name: "index" },
                        rhs: dynamic_select_len(Expr::Var { name: "p0" }),
                    },
                    then_: Block { stmts: Vec::from_array([Stmt::Break]) },
                    else_: Option::None,
                },
            );
            let receive_case = Expr::StructLiteral {
                ty: case_type,
                fields: Vec::from_array(
                    [
                        ("Dir", Expr::Var { name: "_goml_reflect.SelectRecv" }),
                        (
                            "Chan",
                            Expr::Call {
                                func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                args: Vec::from_array(
                                    [
                                        dynamic_select_index(
                                            Expr::Var { name: "p1" },
                                            Expr::Var { name: "receive_index" },
                                        ),
                                    ],
                                ),
                            },
                        ),
                    ],
                ),
            };
            let send_case = Expr::StructLiteral {
                ty: case_type,
                fields: Vec::from_array(
                    [
                        ("Dir", Expr::Var { name: "_goml_reflect.SelectSend" }),
                        (
                            "Chan",
                            Expr::Call {
                                func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                args: Vec::from_array(
                                    [
                                        dynamic_select_index(
                                            Expr::Var { name: "p2" },
                                            Expr::Var { name: "send_index" },
                                        ),
                                    ],
                                ),
                            },
                        ),
                        (
                            "Send",
                            Expr::Call {
                                func: Expr::Var { name: "_goml_reflect.ValueOf" },
                                args: Vec::from_array(
                                    [
                                        dynamic_select_index(
                                            Expr::Var { name: "p3" },
                                            Expr::Var { name: "send_index" },
                                        ),
                                    ],
                                ),
                            },
                        ),
                    ],
                ),
            };
            let receive_stmts: Vec[Stmt] = Vec::new();
            receive_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "cases" },
                    index: Expr::Var { name: "index" },
                    value: receive_case,
                },
            );
            receive_stmts.push(
                Stmt::Assign {
                    name: "receive_index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "receive_index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            let send_stmts: Vec[Stmt] = Vec::new();
            send_stmts.push(
                Stmt::IndexAssign {
                    base: Expr::Var { name: "cases" },
                    index: Expr::Var { name: "index" },
                    value: send_case,
                },
            );
            send_stmts.push(
                Stmt::Assign {
                    name: "send_index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "send_index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            loop_stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: dynamic_select_index(
                            Expr::Var { name: "p0" },
                            Expr::Var { name: "index" },
                        ),
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block { stmts: receive_stmts },
                    else_: Option::Some(Block { stmts: send_stmts }),
                },
            );
            loop_stmts.push(
                Stmt::Assign {
                    name: "index",
                    value: Expr::Binary {
                        op: BinaryOp::Add,
                        lhs: Expr::Var { name: "index" },
                        rhs: Expr::Int { value: "1" },
                    },
                },
            );
            stmts.push(Stmt::Loop { body: Block { stmts: loop_stmts } });
            if try_select {
                stmts.push(
                    Stmt::IndexAssign {
                        base: Expr::Var { name: "cases" },
                        index: dynamic_select_len(Expr::Var { name: "p0" }),
                        value: Expr::StructLiteral {
                            ty: case_type,
                            fields: Vec::from_array(
                                [("Dir", Expr::Var { name: "_goml_reflect.SelectDefault" })],
                            ),
                        },
                    },
                )
            }
            stmts.push(Stmt::Var { name: "chosen", ty: Type::Int, value: Option::None });
            stmts.push(
                Stmt::Var {
                    name: "received",
                    ty: Type::Named { name: "_goml_reflect.Value" },
                    value: Option::None,
                },
            );
            stmts.push(Stmt::Var { name: "open", ty: Type::Bool, value: Option::None });
            stmts.push(
                Stmt::MultiAssign {
                    names: Vec::from_array(["chosen", "received", "open"]),
                    value: Expr::Call {
                        func: Expr::Var { name: "_goml_reflect.Select" },
                        args: Vec::from_array([Expr::Var { name: "cases" }]),
                    },
                },
            );
            stmts.push(Stmt::Var { name: "value", ty: lower_type(elem), value: Option::None });
            if try_select {
                stmts.push(
                    Stmt::If {
                        cond: Expr::Binary {
                            op: BinaryOp::Eq,
                            lhs: Expr::Var { name: "chosen" },
                            rhs: dynamic_select_len(Expr::Var { name: "p0" }),
                        },
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    dynamic_select_return(
                                        lower_type(ret_ty),
                                        Expr::Int { value: "-1" },
                                        Expr::Int { value: "-1" },
                                        Expr::Var { name: "value" },
                                        Expr::Bool { value: false },
                                        Expr::Bool { value: false },
                                    ),
                                ],
                            ),
                        },
                        else_: Option::None,
                    },
                )
            }
            let receive_value = Expr::Call {
                func: Expr::Field { expr: Expr::Var { name: "received" }, field_name: "Interface" },
                args: Vec::new(),
            };
            stmts.push(
                Stmt::If {
                    cond: Expr::Binary {
                        op: BinaryOp::Eq,
                        lhs: dynamic_select_index(
                            Expr::Var { name: "p0" },
                            Expr::Var { name: "chosen" },
                        ),
                        rhs: Expr::Int { value: "0" },
                    },
                    then_: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Assign {
                                    name: "value",
                                    value: Expr::Cast { expr: receive_value, ty: lower_type(elem) },
                                },
                            ],
                        ),
                    },
                    else_: Option::None,
                },
            );
            stmts.push(
                dynamic_select_return(
                    lower_type(ret_ty),
                    Expr::Var { name: "chosen" },
                    dynamic_select_index(Expr::Var { name: "p0" }, Expr::Var { name: "chosen" }),
                    Expr::Var { name: "value" },
                    Expr::Var { name: "open" },
                    Expr::Bool { value: true },
                ),
            );
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: "channel_dynamic_select" },
    }
}

fn compile_collection_from_array_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } if param_types.len() == 1 => {
            let params = Vec::from_array([("values", lower_type(param_types[0]))]);
            let values = Expr::Var { name: "values" };
            let stmts: Vec[Stmt] = Vec::new();
            if key == "vec.from_array" {
                let result_ty = match lower_type(ret_ty) {
                    Type::Pointer { elem } => elem,
                    other => other,
                };
                let empty = match repr::resolve_type(param_types[0]) {
                    Array { len, elem: _ } => len == 0,
                    _ => false,
                };
                if empty {
                    let len_args = Vec::from_array([values]);
                    let items = Expr::Slice {
                        base: values,
                        start: Expr::Int { value: "0" },
                        end: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    };
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::Unary {
                                    op: UnaryOp::Address,
                                    expr: Expr::StructLiteral {
                                        ty: result_ty,
                                        fields: Vec::from_array([("items", items)]),
                                    },
                                },
                            ),
                        },
                    )
                } else {
                    let storage = Expr::Var { name: "storage" };
                    let storage_ty = Type::Struct {
                        fields: Vec::from_array(
                            [("vector", result_ty), ("values", lower_type(param_types[0]))],
                        ),
                    };
                    stmts.push(Stmt::Var { name: "storage", ty: storage_ty, value: Option::None });
                    stmts.push(
                        Stmt::FieldAssign { target: storage, field_name: "values", value: values },
                    );
                    let stored_values = Expr::Field { expr: storage, field_name: "values" };
                    let len_args = Vec::from_array([stored_values]);
                    let items = Expr::Slice {
                        base: stored_values,
                        start: Expr::Int { value: "0" },
                        end: Expr::Call { func: Expr::Var { name: "len" }, args: len_args },
                    };
                    stmts.push(
                        Stmt::FieldAssign {
                            target: Expr::Field { expr: storage, field_name: "vector" },
                            field_name: "items",
                            value: items,
                        },
                    );
                    stmts.push(
                        Stmt::Return {
                            expr: Option::Some(
                                Expr::Unary {
                                    op: UnaryOp::Address,
                                    expr: Expr::Field { expr: storage, field_name: "vector" },
                                },
                            ),
                        },
                    )
                }
            } else {
                let result = Expr::Var { name: "result" };
                stmts.push(
                    Stmt::Var {
                        name: "result",
                        ty: lower_type(ret_ty),
                        value: Option::Some(
                            Expr::Call {
                                func: Expr::Var { name: runtime_helper_name("hashmap_new", ret_ty) },
                                args: Vec::new(),
                            },
                        ),
                    },
                );
                let entry = Expr::Var { name: "entry" };
                let set_args = Vec::from_array(
                    [
                        result,
                        Expr::Field { expr: entry, field_name: "_0" },
                        Expr::Field { expr: entry, field_name: "_1" },
                    ],
                );
                stmts.push(
                    Stmt::Range {
                        names: Vec::from_array(["_", "entry"]),
                        expr: values,
                        body: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Expr {
                                        expr: Expr::Call {
                                            func: Expr::Var {
                                                name: runtime_helper_name("hashmap_set", ret_ty),
                                            },
                                            args: set_args,
                                        },
                                    },
                                ],
                            ),
                        },
                    },
                );
                stmts.push(Stmt::Return { expr: Option::Some(result) })
            }
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_go_nil_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            for index in 0..param_types.len() {
                params.push((f"p{index}", lower_type(param_types[index])))
            }
            let value = if key == "go_ptr.null" || key == "go_error.nil" || key == "go_slice.nil"
                || key == "go_map.nil"
                || key == "go_func.nil" {
                Expr::Nil
            } else {
                Expr::Binary { op: BinaryOp::Eq, lhs: Expr::Var { name: "p0" }, rhs: Expr::Nil }
            };
            Expr::FuncLit {
                params,
                ret_ty: lower_type(ret_ty),
                body: Block { stmts: Vec::from_array([Stmt::Return { expr: Option::Some(value) }]) },
            }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_go_bytes_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params, ret_ty } if params.len() == 1 => {
            let storage_type = match lower_type(ret_ty) {
                Pointer { elem } => elem,
                value => value,
            };
            let message = if key == "go_string.bytes" {
                Expr::Var { name: "p0" }
            } else {
                Expr::Call {
                    func: Expr::MethodExpression {
                        receiver: Type::Named { name: "error" },
                        name: "Error",
                    },
                    args: Vec::from_array([Expr::Var { name: "p0" }]),
                }
            };
            let value = Expr::Unary {
                op: UnaryOp::Address,
                expr: Expr::StructLiteral {
                    ty: storage_type,
                    fields: Vec::from_array(
                        [
                            (
                                "items",
                                Expr::Convert {
                                    ty: Type::Slice { elem: Type::Uint8 },
                                    expr: message,
                                },
                            ),
                        ],
                    ),
                },
            };
            Expr::FuncLit {
                params: Vec::from_array([("p0", lower_type(params[0]))]),
                ret_ty: lower_type(ret_ty),
                body: Block { stmts: Vec::from_array([Stmt::Return { expr: Option::Some(value) }]) },
            }
        },
        _ => Expr::Var { name: "invalid_go_bytes_callable" },
    }
}

fn compile_intrinsic_callable(key: string, function_ty: repr::Type) -> Expr {
    if simd_intrinsic(key).is_some() {
        Expr::Var { name: simd_intrinsic_name(key) }
    } else if key == "go_map.new" || key == "go_map.len" || key == "go_map.lookup"
        || key == "go_map.set"
        || key == "go_map.delete"
        || key == "go_map.copy" {
        compile_go_map_callable(key, function_ty)
    } else if key == "go_slice.capacity" || key == "go_slice.append" {
        compile_go_slice_callable(key, function_ty)
    } else if key == "go_error.is" {
        Expr::Var { name: go_foreign_wrapper_name("errors", "Is", function_ty) }
    } else if key == "go_error.message_bytes" || key == "go_string.bytes" {
        compile_go_bytes_callable(key, function_ty)
    } else if key == "go_string.from_text" || key == "go_string.from_bytes" {
        compile_go_string_callable(key, function_ty)
    } else if key == "go_ptr.null" || key == "go_ptr.is_nil" || key == "go_error.nil"
        || key == "go_error.is_nil"
        || key == "go_slice.nil"
        || key == "go_slice.is_nil"
        || key == "go_map.nil"
        || key == "go_map.is_nil"
        || key == "go_func.nil"
        || key == "go_func.is_nil" {
        compile_go_nil_callable(key, function_ty)
    } else if key == "vec.from_array" || key == "hashmap.from_array" {
        compile_collection_from_array_callable(key, function_ty)
    } else if key == "slice.new" || key == "slice.get" || key == "slice.len" || key == "slice.sub"
        || key == "mut_slice.new"
        || key == "mut_slice.get"
        || key == "mut_slice.set"
        || key == "mut_slice.len"
        || key == "mut_slice.sub"
        || key == "mut_slice.as_slice"
        || key == "mut_slice.copy_from" {
        compile_slice_callable(key, function_ty)
    } else if key == "channel.dynamic_try_select_priority" {
        compile_dynamic_priority_select_callable(function_ty)
    } else if key == "channel.dynamic_select" || key == "channel.dynamic_try_select" {
        compile_dynamic_reflect_select_callable(key, function_ty)
    } else if key == "channel.new" || key == "channel.send" || key == "channel.recv"
        || key == "channel.sender"
        || key == "channel.receiver"
        || key == "channel.split"
        || key == "channel.send_cancel"
        || key == "channel.recv_cancel"
        || key == "channel.close" {
        compile_channel_callable(key, function_ty)
    } else {
        match intrinsic_helper_call_name(key, function_ty, Vec::new()) {
            Some(name) => Expr::Var { name },
            None => Expr::Var { name: go_ident(key) },
        }
    }
}

fn compile_callable(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    match func {
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            match intrinsic_helper_call_name(key, function_ty, args) {
                Some(name) => Expr::Var { name },
                None => compile_imm(env, func),
            }
        },
        _ => compile_imm(env, func),
    }
}

fn compile_call(env: LowerEnv, func: anf::Imm, args: Vec[anf::Imm]) -> Expr {
    let expected = match repr::resolve_type(anf::imm_type(func)) {
        Func { params, ret_ty: _ } => params,
        _ => Vec::new(),
    };
    let compiled = compile_imms_expected(env, args, expected);
    if let Some(name) = direct_function_name(func) {
        for index in 0..compiled.len() {
            if pointer_param_enabled(env.pointer_params, name, index) {
                compiled[index] = match args[index] {
                    Var { name, ty: _ } if env.pointer_vars.contains(name) => {
                        Expr::Var { name: env_local_ident(env, name) }
                    },
                    _ => Expr::Unary { op: UnaryOp::Address, expr: compiled[index] },
                };
            }
        }
    }
    match func {
        Callable { callable: Intrinsic(key), ty: _ } => {
            if key == "go_ptr.null" || key == "go_error.nil" || key == "go_slice.nil"
                || key == "go_map.nil" {
                Expr::Nil
            } else if key == "go_ptr.is_nil" || key == "go_error.is_nil" {
                Expr::Binary { op: BinaryOp::Eq, lhs: compiled[0], rhs: Expr::Nil }
            } else if key == "slice.new" || key == "mut_slice.new" {
                Expr::Slice {
                    base: Expr::Field { expr: compiled[0], field_name: "items" },
                    start: compiled[1],
                    end: compiled[2],
                }
            } else if key == "slice.get" || key == "mut_slice.get" {
                Expr::Index { base: compiled[0], index: compiled[1] }
            } else if key == "slice.len" || key == "mut_slice.len" {
                let len_args: Vec[Expr] = Vec::new();
                len_args.push(compiled[0]);
                Expr::Call { func: Expr::Var { name: "len" }, args: len_args }
            } else if key == "slice.sub" || key == "mut_slice.sub" {
                Expr::Slice { base: compiled[0], start: compiled[1], end: compiled[2] }
            } else if key == "mut_slice.as_slice" {
                compiled[0]
            } else {
                Expr::Call { func: compile_callable(env, func, args), args: compiled }
            }
        },
        _ => Expr::Call { func: compile_callable(env, func, args), args: compiled },
    }
}

fn compile_unary(value: ast::UnaryOp) -> UnaryOp {
    match value {
        Neg => UnaryOp::Neg,
        Not => UnaryOp::Not,
        BitNot => UnaryOp::BitNot,
    }
}

fn compile_binary(value: ast::BinaryOp) -> BinaryOp {
    match value {
        Add => BinaryOp::Add,
        Sub => BinaryOp::Sub,
        Mul => BinaryOp::Mul,
        Div => BinaryOp::Div,
        Rem => BinaryOp::Rem,
        BitAnd => BinaryOp::BitAnd,
        BitOr => BinaryOp::BitOr,
        BitXor => BinaryOp::BitXor,
        Shl => BinaryOp::Shl,
        Shr => BinaryOp::Shr,
        And => BinaryOp::And,
        Or => BinaryOp::Or,
        Less => BinaryOp::Less,
        Greater => BinaryOp::Greater,
        LessEq => BinaryOp::LessEq,
        GreaterEq => BinaryOp::GreaterEq,
        Eq => BinaryOp::Eq,
        NotEq => BinaryOp::NotEq,
    }
}

fn fixed_width_numeric_type(value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 => true,
        _ => false,
    }
}

fn materializes_binary_operands(env: LowerEnv, op: ast::BinaryOp, lhs: anf::Imm, rhs: anf::Imm) -> bool {
    if !imm_is_go_constant(env, lhs) || !imm_is_go_constant(env, rhs)
        || !fixed_width_numeric_type(anf::imm_type(lhs)) {
        false
    } else {
        match op {
            Add | Sub | Mul | Div | Rem | BitAnd | BitOr | BitXor | Shl | Shr => true,
            And | Or | Less | Greater | LessEq | GreaterEq | Eq | NotEq => false,
        }
    }
}

fn append_struct_field_types(result: Vec[repr::Type], definition: repr::StructDef) -> () {
    for field in definition.fields {
        result.push(field.1)
    }
}

fn struct_field_types(env: LowerEnv, value: repr::Type) -> Vec[repr::Type] {
    let result: Vec[repr::Type] = Vec::new();
    if let Named { name } | ClosureEnvironment { name } = repr::resolve_type(value) {
        if let Some(definition) = find_struct(env.structs, name) {
            append_struct_field_types(result, definition)
        }
    }
    result
}

fn compile_constructor(
    env: LowerEnv,
    constructor: repr::Constructor,
    args: Vec[anf::Imm],
    ty: repr::Type,
) -> Expr {
    let expected: Vec[repr::Type] = Vec::new();
    let info = if constructor.is_struct {
        Option::None
    } else {
        constructor.tag.and_then(|tag| find_variant_info(env.variants, ty, tag))
    };
    if constructor.is_struct {
        for field_ty in struct_field_types(env, ty) {
            expected.push(field_ty)
        }
    } else {
        if let Some(tag) = constructor.tag {
            if let Some(info) = find_variant_info(env.variants, ty, tag) {
                for field_ty in info.field_types {
                    expected.push(field_ty)
                }
            }
        }
    }
    if constructor.is_struct {
        let fields: Vec[(string, Expr)] = Vec::new();
        for index in 0..args.len() {
            let name = if index < constructor.fields.len() {
                go_ident(constructor.fields[index])
            } else {
                f"_{index}"
            };
            let compiled = if index < expected.len() {
                compile_imm_expected(env, args[index], expected[index])
            } else {
                compile_imm(env, args[index])
            };
            fields.push((name, compiled))
        }
        return Expr::StructLiteral { ty: lower_type(ty), fields }
    }
    let variant = match info {
        Some(value) => value,
        None => {
            let fields: Vec[(string, Expr)] = Vec::new();
            for index in 0..args.len() {
                fields.push((f"_{index}", compile_imm(env, args[index])))
            }
            return Expr::StructLiteral { ty: constructor_type(constructor), fields }
        },
    };
    let owner = match find_enum_info(env.variants, ty) {
        Some(value) => value,
        None => {
            let fields: Vec[(string, Expr)] = Vec::new();
            for index in 0..args.len() {
                fields.push((f"_{index}", compile_imm(env, args[index])))
            }
            return Expr::StructLiteral { ty: Type::Named { name: variant.variant_name }, fields }
        },
    };
    if let Packed = owner.storage {
        if !args.is_empty() {
            return compile_packed_constructor(env, owner, ty, args[0])
        }
        return enum_named_expr(ty, Expr::Int { value: "0" })
    }
    let payload_fields: Vec[(string, Expr)] = Vec::new();
    for index in 0..args.len() {
        let compiled = if index < expected.len() {
            compile_imm_expected(env, args[index], expected[index])
        } else {
            compile_imm(env, args[index])
        };
        match owner.storage {
            Flat | Node | PointerNiche => if index < variant.field_names.len() {
                if let Some(name) = variant.field_names[index] {
                    payload_fields.push((name, compiled))
                }
            },
            Interface => payload_fields.push((f"_{index}", compiled)),
            Singleton | TagOnly | Packed => (),
        }
    }
    match owner.storage {
        Singleton | TagOnly => compile_imm_expected(
            env,
            anf::Imm::Tag { index: variant.tag, ty },
            ty,
        ),
        Flat => {
            payload_fields.push(("_tag", Expr::Int { value: variant.tag.to_string() }));
            Expr::StructLiteral { ty: lower_type(ty), fields: payload_fields }
        },
        PointerNiche => Expr::StructLiteral { ty: lower_type(ty), fields: payload_fields },
        Packed => enum_named_expr(ty, Expr::Int { value: "0" }),
        Node => if owner.nil_tag == Option::Some(variant.tag) {
            Expr::StructLiteral { ty: lower_type(ty), fields: Vec::new() }
        } else {
            payload_fields.push(("_tag", Expr::Int { value: variant.tag.to_string() }));
            Expr::StructLiteral {
                ty: lower_type(ty),
                fields: Vec::from_array(
                    [
                        (
                            "_node",
                            Expr::Unary {
                                op: UnaryOp::Address,
                                expr: Expr::StructLiteral {
                                    ty: Type::Named { name: owner.node_name },
                                    fields: payload_fields,
                                },
                            },
                        ),
                    ],
                ),
            }
        },
        Interface => Expr::StructLiteral {
            ty: Type::Named { name: variant.variant_name },
            fields: payload_fields,
        },
    }
}

fn compile_value(env: LowerEnv, bind_name: string, value: anf::Value, expected_ty: repr::Type) -> CompiledValue {
    let stmts: Vec[Stmt] = Vec::new();
    let expr = match value {
        Imm(value) => compile_imm_expected(env, value, expected_ty),
        Constr { constructor, args, ty } => compile_constructor(env, constructor, args, ty),
        Tuple { items, ty } => {
            let fields: Vec[(string, Expr)] = Vec::new();
            match repr::resolve_type(ty) {
                Tuple { items: item_types } => {
                    for index in 0..items.len() {
                        fields.push(
                            (
                                f"_{index}",
                                compile_imm_expected(env, items[index], item_types[index]),
                            ),
                        )
                    }
                },
                _ => {
                    for index in 0..items.len() {
                        fields.push((f"_{index}", compile_imm(env, items[index])))
                    }
                },
            }
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        Array { items, ty } => {
            let expected = match repr::resolve_type(ty) {
                Array { len: _, elem } => {
                    let values: Vec[repr::Type] = Vec::new();
                    for _ in items {
                        values.push(elem)
                    }
                    values
                },
                _ => Vec::new(),
            };
            Expr::ArrayLiteral {
                ty: lower_type(ty),
                items: compile_imms_expected(env, items, expected),
            }
        },
        ConstrGet { expr, constructor, field_index: index, ty: field_ty } => {
            let owner_ty = anf::imm_type(expr);
            if constructor.is_struct {
                let field = if index < constructor.fields.len() {
                    go_ident(constructor.fields[index])
                } else {
                    f"_{index}"
                };
                Expr::Field { expr: compile_imm(env, expr), field_name: field }
            } else {
                let variant = constructor.tag.and_then(
                    |tag| find_variant_info(env.variants, owner_ty, tag),
                );
                match find_enum_info(env.variants, owner_ty) {
                    Some(owner) => match owner.storage {
                        Packed => compile_packed_projection(env, owner, expr),
                        Flat | PointerNiche | Node => match variant {
                            Some(variant) => if index < variant.field_names.len() {
                                match variant.field_names[index] {
                                    Some(field) => Expr::Field {
                                        expr: if let Node = owner.storage {
                                            enum_node_expr(compile_imm(env, expr))
                                        } else {
                                            compile_imm(env, expr)
                                        },
                                        field_name: field,
                                    },
                                    None => enum_zero_expr(field_ty),
                                }
                            } else {
                                enum_zero_expr(field_ty)
                            },
                            None => enum_zero_expr(field_ty),
                        },
                        Interface => match variant {
                            Some(variant) => Expr::Field {
                                expr: Expr::Cast {
                                    expr: compile_imm(env, expr),
                                    ty: Type::Named { name: variant.variant_name },
                                },
                                field_name: f"_{index}",
                            },
                            None => enum_zero_expr(field_ty),
                        },
                        Singleton | TagOnly => enum_zero_expr(field_ty),
                    },
                    None => Expr::Field {
                        expr: Expr::Cast {
                            expr: compile_imm(env, expr),
                            ty: constructor_type(constructor),
                        },
                        field_name: f"_{index}",
                    },
                }
            }
        },
        Unary { op, expr: operand, ty: _ } => {
            let compiled = match op {
                Neg | BitNot => compile_runtime_imm(
                    env,
                    operand,
                    env_local_ident_with_suffix(env, bind_name, "_operand"),
                ),
                _ => CompiledValue { stmts: Vec::new(), expr: compile_imm(env, operand) },
            };
            append_stmts(stmts, compiled.stmts);
            Expr::Unary { op: compile_unary(op), expr: compiled.expr }
        },
        Cast { expr: source, ty } => {
            let source_ty = lower_type(anf::imm_type(source));
            let compiled = compile_runtime_imm(
                env,
                source,
                env_local_ident_with_suffix(env, bind_name, "_source"),
            );
            append_stmts(stmts, compiled.stmts);
            Expr::Convert {
                ty: lower_type(ty),
                expr: Expr::Convert { ty: source_ty, expr: compiled.expr },
            }
        },
        Binary { op, lhs, rhs, ty: _ } => {
            let materializes = materializes_binary_operands(env, op, lhs, rhs);
            let compiled_lhs = if materializes {
                compile_runtime_imm(env, lhs, env_local_ident_with_suffix(env, bind_name, "_lhs"))
            } else {
                CompiledValue { stmts: Vec::new(), expr: compile_imm(env, lhs) }
            };
            let compiled_rhs = if materializes {
                compile_runtime_imm(env, rhs, env_local_ident_with_suffix(env, bind_name, "_rhs"))
            } else {
                CompiledValue { stmts: Vec::new(), expr: compile_imm(env, rhs) }
            };
            append_stmts(stmts, compiled_lhs.stmts);
            append_stmts(stmts, compiled_rhs.stmts);
            Expr::Binary { op: compile_binary(op), lhs: compiled_lhs.expr, rhs: compiled_rhs.expr }
        },
        Assign { name, value, target_ty, ty: _ } => {
            stmts.push(
                Stmt::Assign {
                    name: env_local_ident(env, name),
                    value: compile_imm_expected(env, value, target_ty),
                },
            );
            Expr::Unit
        },
        Call { func, args, ty: _ } => compile_call(env, func, args),
        ToDyn { trait_name, for_ty, expr, ty } => {
            let fields: Vec[(string, Expr)] = Vec::new();
            let compiled = compile_imm_expected(env, expr, for_ty);
            let data = match repr::resolve_type(for_ty) {
                Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | Char => Expr::Convert {
                    ty: lower_type(for_ty),
                    expr: compiled,
                },
                _ => compiled,
            };
            fields.push(("data", data));
            fields.push(
                (
                    "vtable",
                    Expr::Call {
                        func: Expr::Var {
                            name: dyn_factory_name(env.dyn_helper_names, trait_name, for_ty),
                        },
                        args: Vec::new(),
                    },
                ),
            );
            Expr::StructLiteral { ty: lower_type(ty), fields }
        },
        DynCall { trait_name, method_name: method, receiver, args, ty: _ } => {
            let method_name = dyn_method_parts(method, trait_name).1;
            let receiver = compile_imm(env, receiver);
            let values: Vec[Expr] = Vec::new();
            values.push(Expr::Field { expr: receiver, field_name: "data" });
            let expected = match find_dyn_method(
                env.builtin,
                env.functions,
                trait_name,
                method_name,
            ) {
                Some(info) => info.params,
                None => Vec::new(),
            };
            for arg in compile_imms_expected(env, args, expected) {
                values.push(arg)
            }
            Expr::Call {
                func: Expr::Field {
                    expr: Expr::Field { expr: receiver, field_name: "vtable" },
                    field_name: go_ident(method_name),
                },
                args: values,
            }
        },
        Go { closure: value, ty: _ } => {
            let call = compile_call(env, value, Vec::new());
            stmts.push(Stmt::Go { call });
            Expr::Unit
        },
        PackClosure { environment, apply, ty } => {
            compile_closure_function(env, environment, apply, ty)
        },
        Proj { tuple, index, ty: _ } => {
            Expr::Field { expr: compile_imm(env, tuple), field_name: f"_{index}" }
        },
    };
    CompiledValue { stmts, expr }
}

fn compile_let(env: LowerEnv, value: anf::LetBind) -> Vec[Stmt] {
    if let Some(result) = compile_hashmap_array_literal_let(env, value) {
        return result
    }
    let result: Vec[Stmt] = Vec::new();
    let compiled = compile_value(env, value.name, value.value, value.ty);
    append_stmts(result, compiled.stmts);
    result.push(
        Stmt::Var {
            name: env_local_ident(env, value.name),
            ty: lower_type(value.ty),
            value: Option::Some(compiled.expr),
        },
    );
    result
}

fn hashmap_array_literal_fields(key: repr::Type, value: repr::Type, capacity: Expr) -> Vec[
    (string, Expr),
] {
    let entry_ty = Type::Named { name: go_generated_ident(hashmap_name(key, value) + "_entry") };
    let fields: Vec[(string, Expr)] = Vec::new();
    if hashmap_native_key(key) {
        fields.push(
            (
                "indices",
                Expr::Make {
                    ty: Type::Map { key: lower_type(key), value: Type::Int },
                    args: Vec::from_array([capacity]),
                },
            ),
        );
        fields.push(
            (
                "entries",
                Expr::Make {
                    ty: Type::Slice { elem: entry_ty },
                    args: Vec::from_array([Expr::Int { value: "0" }, capacity]),
                },
            ),
        )
    } else {
        fields.push(
            (
                "buckets",
                Expr::Make {
                    ty: Type::Map { key: Type::Uint64, value: Type::Slice { elem: entry_ty } },
                    args: Vec::from_array([capacity]),
                },
            ),
        );
        fields.push(
            (
                "hashes",
                Expr::Make {
                    ty: Type::Slice { elem: Type::Uint64 },
                    args: Vec::from_array([Expr::Int { value: "0" }, capacity]),
                },
            ),
        )
    }
    fields.push(("len", Expr::Int { value: "0" }));
    fields
}

fn compile_hashmap_array_literal(env: LowerEnv, value: anf::LetBind, items: Vec[anf::Imm]) -> Vec[
    Stmt,
] {
    let (key, map_value) = match repr::resolve_type(value.ty) {
        HashMap { key, value } => (key, value),
        _ => return Vec::new(),
    };
    let result: Vec[Stmt] = Vec::new();
    result.push(
        Stmt::Var {
            name: env_local_ident(env, value.name),
            ty: lower_type(value.ty),
            value: Option::Some(
                Expr::Unary {
                    op: UnaryOp::Address,
                    expr: Expr::StructLiteral {
                        ty: Type::Named { name: hashmap_name(key, map_value) },
                        fields: hashmap_array_literal_fields(
                            key,
                            map_value,
                            Expr::Int { value: items.len().to_string() },
                        ),
                    },
                },
            ),
        },
    );
    for item in items {
        let entry = compile_imm(env, item);
        result.push(
            Stmt::Expr {
                expr: Expr::Call {
                    func: Expr::Var { name: runtime_helper_name("hashmap_set", value.ty) },
                    args: Vec::from_array(
                        [
                            Expr::Var { name: env_local_ident(env, value.name) },
                            Expr::Field { expr: entry, field_name: "_0" },
                            Expr::Field { expr: entry, field_name: "_1" },
                        ],
                    ),
                },
            },
        )
    }
    result
}

fn compile_hashmap_array_literal_let(env: LowerEnv, value: anf::LetBind) -> Option[Vec[Stmt]] {
    match value.value {
        Call { func: Callable { callable: Intrinsic(key), ty: _ }, args, ty: _ } if key
            == "hashmap.from_array"
            && args.len() == 1 => match args[0] {
            Var { name: _, ty: _ } => match env.collection_array_consumers[value.name] {
                Some(Array { items, ty: _ }) => {
                    Option::Some(compile_hashmap_array_literal(env, value, items))
                },
                _ => Option::None,
            },
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn collection_array_consumer(value: anf::Bind) -> Option[(string, string)] {
    match value {
        Let(anf::LetBind {
            name: consumer,
            value: Call { func: Callable { callable: Intrinsic(key), ty: _ }, args, ty: _ },
            ty: _,
        }) if key == "hashmap.from_array" && args.len() == 1 => match args[0] {
            Var { name, ty: _ } => Option::Some((consumer, name)),
            _ => Option::None,
        },
        _ => Option::None,
    }
}

fn collect_collection_arrays_term(result: HashMap[string, anf::Value], value: anf::Term) -> () {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_collection_arrays(result, then_);
            collect_collection_arrays(result, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_collection_arrays(result, arm.body)
            }
            if let Some(body) = default {
                collect_collection_arrays(result, body)
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                collect_collection_arrays(
                    result,
                    match arm {
                        Receive { body, .. } | Send { body, .. } => body,
                    },
                )
            }
            if let Some(body) = default {
                collect_collection_arrays(result, body)
            }
        },
        Return(_) | Jump { target: _, args: _, ret_ty: _ } | Unreachable { ty: _ } => (),
    }
}

fn collect_collection_arrays(result: HashMap[string, anf::Value], value: anf::Block) -> () {
    let mut index = 0;
    while index < value.binds.len() {
        match value.binds[index] {
            Let(bind) => match bind.value {
                Array { items, ty } if index + 1 < value.binds.len() => {
                    if let Some(consumer) = collection_array_consumer(value.binds[index + 1]) {
                        if consumer.1 == bind.name {
                            result[consumer.0] = anf::Value::Array { items, ty };
                        }
                    }
                },
                _ => (),
            },
            Join(join) => collect_collection_arrays(result, join.body),
            JoinRec(joins) => for join in joins {
                collect_collection_arrays(result, join.body)
            },
        }
        index += 1;
    }
    collect_collection_arrays_term(result, value.term)
}

fn collect_joins_term(result: Vec[anf::JoinBind], value: anf::Term) -> () {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_joins_block(result, then_);
            collect_joins_block(result, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_joins_block(result, arm.body)
            }
            if let Some(body) = default {
                collect_joins_block(result, body)
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                collect_joins_block(
                    result,
                    match arm {
                        Receive { body, .. } | Send { body, .. } => body,
                    },
                )
            }
            if let Some(body) = default {
                collect_joins_block(result, body)
            }
        },
        Return(_) | Jump { target: _, args: _, ret_ty: _ } | Unreachable { ty: _ } => (),
    }
}

fn collect_joins_block(result: Vec[anf::JoinBind], value: anf::Block) -> () {
    for bind in value.binds {
        match bind {
            Let(_) => (),
            Join(join) => {
                result.push(join);
                collect_joins_block(result, join.body)
            },
            JoinRec(joins) => {
                for join in joins {
                    collect_joins_block(result, join.body)
                }
            },
        }
    }
    collect_joins_term(result, value.term)
}

fn find_join(values: Vec[anf::JoinBind], name: string) -> Option[anf::JoinBind] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn same_target(lhs: Option[string], rhs: Option[string]) -> Option[string] {
    match lhs {
        Some(left) => match rhs {
            Some(right) => {
                if left == right {
                    Option::Some(left)
                } else {
                    Option::None
                }
            },
            None => Option::None,
        },
        None => Option::None,
    }
}

fn match_block_target(arms: Vec[anf::Arm], default: Option[anf::Block]) -> Option[string] {
    if arms.is_empty() {
        return default.and_then(|body| block_target(body))
    }
    let expected = block_target(arms[0].body)?;
    for index in 1..arms.len() {
        if block_target(arms[index].body)? != expected {
            return Option::None
        }
    }
    if let Some(body) = default {
        if block_target(body)? != expected {
            return Option::None
        }
    }
    Option::Some(expected)
}

fn select_block_target(arms: Vec[anf::SelectArm], default: Option[anf::Block]) -> Option[string] {
    if arms.is_empty() {
        return default.and_then(|body| block_target(body))
    }
    let first = match arms[0] {
        Receive { body, .. } | Send { body, .. } => body,
    };
    let expected = block_target(first)?;
    for index in 1..arms.len() {
        let body = match arms[index] {
            Receive { body, .. } | Send { body, .. } => body,
        };
        if block_target(body)? != expected {
            return Option::None
        }
    }
    if let Some(body) = default {
        if block_target(body)? != expected {
            return Option::None
        }
    }
    Option::Some(expected)
}

fn term_target(value: anf::Term) -> Option[string] {
    match value {
        Jump { target, args: _, ret_ty: _ } => Option::Some(target),
        If { cond: _, then_, else_, ret_ty: _ } => {
            same_target(block_target(then_), block_target(else_))
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => match_block_target(arms, default),
        Select { arms, default, .. } => select_block_target(arms, default),
        Return(_) | Unreachable { ty: _ } => Option::None,
    }
}

fn find_block_join(value: anf::Block, name: string) -> Option[anf::JoinBind] {
    let mut index = value.binds.len() - 1;
    while index >= 0 {
        let bind = value.binds[index];
        match bind {
            Join(join) => {
                if join.name == name {
                    return Option::Some(join)
                } else {
                    index -= 1;
                }
            },
            Let(_) | JoinRec(_) => {
                index -= 1;
            },
        }
    }
    Option::None
}

fn block_target_with_visited(value: anf::Block, visited: collections::IndexSet[string]) -> Option[
    string,
] {
    match term_target(value.term) {
        Some(target) => {
            if visited.contains(target) {
                Option::None
            } else {
                match find_block_join(value, target) {
                    Some(join) => {
                        let _ = visited.insert(target);
                        block_target_with_visited(join.body, visited)
                    },
                    None => Option::Some(target),
                }
            }
        },
        None => Option::None,
    }
}

fn block_target(value: anf::Block) -> Option[string] {
    block_target_with_visited(value, collections::IndexSet::new())
}

fn blocks_reach_target(
    values: Vec[anf::Arm],
    target: string,
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> bool {
    for arm in values {
        if block_reaches_target(arm.body, target, joins, visited) {
            return true
        }
    }
    false
}

fn compile_jump_args(env: LowerEnv, value: anf::JoinBind, args: Vec[anf::Imm]) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    for index in 0..args.len() {
        if index < value.params.len() && value.params[index].0 != "_" {
            result.push(
                Stmt::Assign {
                    name: env_local_ident(env, value.params[index].0),
                    value: compile_imm_expected(env, args[index], value.params[index].1),
                },
            )
        }
    }
    result
}

fn compile_branch_to_join(env: LowerEnv, value: anf::Block, target: string, join: anf::JoinBind) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: env_local_ident(env, param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    }
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Some(inner_target) => {
                if inner_target == target {
                    append_stmts(stmts, compile_term_to_join(env, value.term, target, join))
                } else {
                    match find_join(pending, inner_target) {
                        Some(inner_join) => {
                            append_stmts(
                                stmts,
                                compile_term_to_join(env, value.term, inner_target, inner_join),
                            );
                            append_stmts(
                                stmts,
                                compile_branch_to_join(env, inner_join.body, target, join).stmts,
                            )
                        },
                        None => append_stmts(
                            stmts,
                            compile_term_with_pending(env, value.term, pending),
                        ),
                    }
                }
            },
            None => append_stmts(stmts, compile_term_with_pending(env, value.term, pending)),
        }
    }
    Block { stmts }
}

fn match_scrutinee_is_unit(value: anf::Imm) -> bool {
    match repr::resolve_type(anf::imm_type(value)) {
        Unit => true,
        _ => false,
    }
}

fn first_match_body(arms: Vec[anf::Arm], default: Option[anf::Block]) -> Option[anf::Block] {
    if !arms.is_empty() {
        Option::Some(arms[0].body)
    } else {
        default
    }
}

fn compile_match_leaf(
    env: LowerEnv,
    scrut: anf::Imm,
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    if match_scrutinee_is_unit(scrut) {
        match first_match_body(arms, default) {
            Some(body) => append_stmts(result, compile_block(env, body).stmts),
            None => append_stmts(result, non_exhaustive_block().stmts),
        }
    } else if match_uses_types(env, arms) {
        let cases: Vec[TypeSwitchCase] = Vec::new();
        for arm in arms {
            if let Some(ty) = arm_type(env, arm.lhs) {
                cases.push(TypeSwitchCase { ty, body: compile_block(env, arm.body) })
            }
        }
        let lowered_default = match default {
            Some(body) => Option::Some(compile_block(env, body)),
            None => Option::Some(non_exhaustive_block()),
        };
        result.push(
            Stmt::TypeSwitch {
                binding: Option::None,
                expr: compile_imm(env, scrut),
                cases,
                default: lowered_default,
            },
        )
    } else {
        let cases: Vec[SwitchCase] = Vec::new();
        for arm in arms {
            cases.push(
                SwitchCase { value: compile_imm(env, arm.lhs), body: compile_block(env, arm.body) },
            )
        }
        let lowered_default = match default {
            Some(body) => Option::Some(compile_block(env, body)),
            None => Option::Some(non_exhaustive_block()),
        };
        result.push(
            Stmt::Switch {
                expr: compile_match_scrutinee(env, scrut),
                cases,
                default: lowered_default,
            },
        )
    }
    result
}

fn arm_type(env: LowerEnv, value: anf::Imm) -> Option[Type] {
    match value {
        Tag { index: tag, ty: owner_ty } => variant_type(env.variants, owner_ty, tag),
        _ => Option::None,
    }
}

fn match_uses_types(env: LowerEnv, values: Vec[anf::Arm]) -> bool {
    for value in values {
        if let Some(_) = arm_type(env, value.lhs) {
            return true
        }
    }
    false
}

fn compile_match_scrutinee(env: LowerEnv, value: anf::Imm) -> Expr {
    match find_enum_info(env.variants, anf::imm_type(value)) {
        Some(info) => match info.storage {
            Flat => Expr::Field { expr: compile_imm(env, value), field_name: "_tag" },
            PointerNiche => Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: Expr::Field { expr: compile_imm(env, value), field_name: "_value" },
                rhs: Expr::Nil,
            },
            Packed => Expr::Binary {
                op: BinaryOp::NotEq,
                lhs: compile_imm(env, value),
                rhs: enum_named_expr(anf::imm_type(value), Expr::Int { value: "0" }),
            },
            Node => Expr::Call {
                func: Expr::Var { name: enum_node_tag_helper_name(info.owner_name) },
                args: Vec::from_array([compile_imm(env, value)]),
            },
            Singleton | TagOnly | Interface => compile_imm(env, value),
        },
        None => compile_imm(env, value),
    }
}

fn non_exhaustive_block() -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(Stmt::Panic { message: "non-exhaustive match" });
    Block { stmts }
}

fn select_channel_elem(value: anf::Imm) -> repr::Type {
    match repr::resolve_type(anf::imm_type(value)) {
        Channel { elem, direction: _ } => elem,
        _ => repr::Type::Unit,
    }
}

fn select_option_expr(env: LowerEnv, ty: repr::Type, value: Option[anf::Imm]) -> Expr {
    let owner = match repr::resolve_type(ty) {
        Named { name } => name,
        _ => env.builtin.option.name,
    };
    let args: Vec[anf::Imm] = Vec::new();
    let variant = match value {
        Some(value) => {
            args.push(value);
            env.builtin.option.some
        },
        None => env.builtin.option.none,
    };
    compile_constructor(
        env,
        repr::Constructor {
            name: owner + "::" + variant.name,
            fields: Vec::new(),
            is_struct: false,
            tag: Option::Some(variant.tag),
        },
        args,
        ty,
    )
}

fn compile_select(
    env: LowerEnv,
    mode: ast::SelectMode,
    arms: Vec[anf::SelectArm],
    default: Option[anf::Block],
    compile_body: (anf::Block) -> Block,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    let cases: Vec[SelectCase] = Vec::with_capacity(arms.len());
    let select_index = env.select_counter.get();
    env.select_counter.set(select_index + 1);
    let mut arm_index = 0;
    for arm in arms {
        match arm {
            Receive { channel, guard, binding, binding_ty, body } => {
                let elem_ty = select_channel_elem(channel);
                let value_name = binding + "#select_value";
                let open_name = binding + "#select_open";
                result.push(
                    Stmt::Var {
                        name: env_local_ident(env, value_name),
                        ty: lower_type(elem_ty),
                        value: Option::None,
                    },
                );
                result.push(
                    Stmt::Var {
                        name: env_local_ident(env, open_name),
                        ty: Type::Bool,
                        value: Option::None,
                    },
                );
                result.push(
                    Stmt::Var {
                        name: env_local_ident(env, binding),
                        ty: lower_type(binding_ty),
                        value: Option::Some(select_option_expr(env, binding_ty, Option::None)),
                    },
                );
                let case_stmts: Vec[Stmt] = Vec::new();
                case_stmts.push(
                    Stmt::If {
                        cond: Expr::Var { name: env_local_ident(env, open_name) },
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Assign {
                                        name: env_local_ident(env, binding),
                                        value: select_option_expr(
                                            env,
                                            binding_ty,
                                            Option::Some(
                                                anf::Imm::Var { name: value_name, ty: elem_ty },
                                            ),
                                        ),
                                    },
                                ],
                            ),
                        },
                        else_: Option::None,
                    },
                );
                append_stmts(case_stmts, compile_body(body).stmts);
                let selected_channel = match guard {
                    Some(value) => {
                        let name = protect_local_ident(
                            env.top_level_names,
                            go_generated_ident(f"select_channel_{select_index}_{arm_index}"),
                        );
                        result.push(
                            Stmt::Var {
                                name,
                                ty: lower_type(anf::imm_type(channel)),
                                value: Option::None,
                            },
                        );
                        result.push(
                            Stmt::If {
                                cond: compile_imm(env, value),
                                then_: Block {
                                    stmts: Vec::from_array(
                                        [Stmt::Assign { name, value: compile_imm(env, channel) }],
                                    ),
                                },
                                else_: Option::None,
                            },
                        );
                        Expr::Var { name }
                    },
                    None => compile_imm(env, channel),
                };
                cases.push(
                    SelectCase {
                        operation: SelectOperation::Receive {
                            names: Vec::from_array(
                                [env_local_ident(env, value_name), env_local_ident(env, open_name)],
                            ),
                            channel: selected_channel,
                        },
                        body: Block { stmts: case_stmts },
                    },
                )
            },
            Send { channel, value, guard, body } => {
                let selected_channel = match guard {
                    Some(guard_value) => {
                        let name = protect_local_ident(
                            env.top_level_names,
                            go_generated_ident(f"select_channel_{select_index}_{arm_index}"),
                        );
                        result.push(
                            Stmt::Var {
                                name,
                                ty: lower_type(anf::imm_type(channel)),
                                value: Option::None,
                            },
                        );
                        result.push(
                            Stmt::If {
                                cond: compile_imm(env, guard_value),
                                then_: Block {
                                    stmts: Vec::from_array(
                                        [Stmt::Assign { name, value: compile_imm(env, channel) }],
                                    ),
                                },
                                else_: Option::None,
                            },
                        );
                        Expr::Var { name }
                    },
                    None => compile_imm(env, channel),
                };
                cases.push(
                    SelectCase {
                        operation: SelectOperation::Send {
                            channel: selected_channel,
                            value: compile_imm_expected(env, value, select_channel_elem(channel)),
                        },
                        body: compile_body(body),
                    },
                )
            },
        }
        arm_index += 1;
    }
    let lowered_default = default.map(|body| compile_body(body));
    match mode {
        ast::SelectMode::Normal => result.push(Stmt::Select { cases, default: lowered_default }),
        ast::SelectMode::Priority => {
            let nested: Ref[Block] = Ref::new(
                lowered_default.unwrap_or_else(|| Block { stmts: Vec::new() }),
            );
            let mut index = cases.len() - 1;
            while index >= 0 {
                nested.set(
                    Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::Select {
                                    cases: Vec::from_array([cases[index]]),
                                    default: Option::Some(nested.get()),
                                },
                            ],
                        ),
                    },
                );
                index -= 1;
            }
            append_stmts(result, nested.get().stmts)
        },
    }
    result
}

fn compile_term_leaf(env: LowerEnv, value: anf::Term) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        Return(value) => result.push(
            Stmt::Return {
                expr: Option::Some(compile_imm_expected(env, value, anf::imm_type(value))),
            },
        ),
        Jump { target, args, ret_ty: _ } => match find_join(env.joins, target) {
            Some(join) => {
                append_stmts(result, compile_jump_args(env, join, args));
                append_stmts(result, compile_block(env, join.body).stmts)
            },
            None => result.push(Stmt::Unreachable),
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_block(env, then_),
                else_: Option::Some(compile_block(env, else_)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            append_stmts(result, compile_match_leaf(env, scrut, arms, default))
        },
        Select { mode, arms, default, ret_ty: _ } => append_stmts(
            result,
            compile_select(env, mode, arms, default, |body| compile_block(env, body)),
        ),
        Unreachable { ty: _ } => result.push(Stmt::Unreachable),
    }
    result
}

fn compile_term_to_join(env: LowerEnv, value: anf::Term, target: string, join: anf::JoinBind) -> Vec[
    Stmt,
] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        Jump { target: _, args, ret_ty: _ } => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_branch_to_join(env, then_, target, join),
                else_: Option::Some(compile_branch_to_join(env, else_, target, join)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_branch_to_join(env, body, target, join).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    if let Some(ty) = arm_type(env, arm.lhs) {
                        cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_branch_to_join(env, arm.body, target, join),
                            },
                        )
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(compile_branch_to_join(env, body, target, join)),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_branch_to_join(env, arm.body, target, join),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(compile_branch_to_join(env, body, target, join)),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        Select { mode, arms, default, ret_ty: _ } => append_stmts(
            result,
            compile_select(
                env,
                mode,
                arms,
                default,
                |body| compile_branch_to_join(env, body, target, join),
            ),
        ),
        _ => append_stmts(result, compile_term_leaf(env, value)),
    }
    result
}

fn compile_term_with_pending(env: LowerEnv, value: anf::Term, pending: Vec[anf::JoinBind]) -> Vec[
    Stmt,
] {
    match term_target(value) {
        Some(target) => match find_join(pending, target) {
            Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                append_stmts(result, compile_term_to_join(env, value, target, join));
                append_stmts(result, compile_block(env, join.body).stmts);
                result
            },
            None => compile_term_leaf(env, value),
        },
        None => compile_term_leaf(env, value),
    }
}

fn loop_label(value: string) -> string {
    "Loop_" + go_local_ident(value)
}

fn fresh_loop_label_with_suffix(emitted: collections::IndexSet[string], base: string, suffix: isize) -> string {
    let candidate = if suffix == 1 {
        base
    } else {
        f"{base}__{suffix}"
    };
    if emitted.contains(candidate) {
        fresh_loop_label_with_suffix(emitted, base, suffix + 1)
    } else {
        let _ = emitted.insert(candidate);
        candidate
    }
}

fn fresh_loop_label(env: LowerEnv, value: string) -> string {
    fresh_loop_label_with_suffix(env.emitted_loop_labels, loop_label(value), 1)
}

fn active_loop_label(env: LowerEnv, target: string) -> Option[string] {
    for offset in 0..env.active_loop_labels.len() {
        let value = env.active_loop_labels[env.active_loop_labels.len() - 1 - offset];
        if value.0 == target {
            return Option::Some(value.1)
        }
    }
    Option::None
}

fn block_reaches_target(
    value: anf::Block,
    target: string,
    parent: JoinScope,
    visited: collections::IndexSet[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_reaches_target(value.term, target, joins, visited)
}

fn term_reaches_target(
    value: anf::Term,
    target: string,
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> bool {
    match value {
        Jump { target: name, args, ret_ty: _ } => {
            if name == target && args.is_empty() {
                true
            } else if visited.contains(name) {
                false
            } else {
                match find_scoped_join(joins, name) {
                    Some(join) => {
                        let _ = visited.insert(name);
                        block_reaches_target(join.body, target, joins, visited)
                    },
                    None => false,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            block_reaches_target(then_, target, joins, visited)
                || block_reaches_target(else_, target, joins, visited)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            blocks_reach_target(arms, target, joins, visited)
                || match default {
                    Some(body) => block_reaches_target(body, target, joins, visited),
                    None => false,
                }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                if block_reaches_target(
                    match arm {
                        Receive { body, .. } | Send { body, .. } => body,
                    },
                    target,
                    joins,
                    visited,
                ) {
                    return true
                }
            }
            match default {
                Some(body) => block_reaches_target(body, target, joins, visited),
                None => false,
            }
        },
        Return(_) | Unreachable { ty: _ } => false,
    }
}

fn block_tail_target_through_joins(
    value: anf::Block,
    parent: JoinScope,
    visited: collections::IndexSet[string],
) -> Option[string] {
    let joins = scoped_joins(parent, value);
    term_tail_target_through_joins(value.term, joins, visited)
}

fn match_tail_target_through_joins(
    arms: Vec[anf::Arm],
    default: Option[anf::Block],
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> Option[string] {
    if arms.is_empty() {
        return default.and_then(|body| block_tail_target_through_joins(body, joins, visited))
    }
    let expected = block_tail_target_through_joins(arms[0].body, joins, visited)?;
    for index in 1..arms.len() {
        if block_tail_target_through_joins(arms[index].body, joins, visited)? != expected {
            return Option::None
        }
    }
    if let Some(body) = default {
        if block_tail_target_through_joins(body, joins, visited)? != expected {
            return Option::None
        }
    }
    Option::Some(expected)
}

fn select_tail_target_through_joins(
    arms: Vec[anf::SelectArm],
    default: Option[anf::Block],
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> Option[string] {
    if arms.is_empty() {
        return default.and_then(|body| block_tail_target_through_joins(body, joins, visited))
    }
    let first = match arms[0] {
        Receive { body, .. } | Send { body, .. } => body,
    };
    let expected = block_tail_target_through_joins(first, joins, visited)?;
    for index in 1..arms.len() {
        let body = match arms[index] {
            Receive { body, .. } | Send { body, .. } => body,
        };
        if block_tail_target_through_joins(body, joins, visited)? != expected {
            return Option::None
        }
    }
    if let Some(body) = default {
        if block_tail_target_through_joins(body, joins, visited)? != expected {
            return Option::None
        }
    }
    Option::Some(expected)
}

fn term_tail_target_through_joins(
    value: anf::Term,
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> Option[string] {
    match value {
        Jump { target, args: _, ret_ty: _ } => {
            if visited.contains(target) {
                Option::None
            } else {
                match find_scoped_join(joins, target) {
                    Some(join) => match join.role {
                        anf::JoinRole::LoopExit => Option::Some(target),
                        anf::JoinRole::Return => Option::None,
                        anf::JoinRole::Continuation => {
                            let _ = visited.insert(target);
                            let result = block_tail_target_through_joins(join.body, joins, visited);
                            let _ = visited.remove(target);
                            result
                        },
                    },
                    None => Option::None,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            same_target(
                block_tail_target_through_joins(then_, joins, visited),
                block_tail_target_through_joins(else_, joins, visited),
            )
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            match_tail_target_through_joins(arms, default, joins, visited)
        },
        Select { arms, default, .. } => {
            select_tail_target_through_joins(arms, default, joins, visited)
        },
        Return(_) | Unreachable { ty: _ } => Option::None,
    }
}

fn block_all_paths_reach_or_terminate(
    value: anf::Block,
    target: string,
    parent: JoinScope,
    visited: collections::IndexSet[string],
) -> bool {
    let joins = scoped_joins(parent, value);
    term_all_paths_reach_or_terminate(value.term, target, joins, visited)
}

fn term_all_paths_reach_or_terminate(
    value: anf::Term,
    target: string,
    joins: JoinScope,
    visited: collections::IndexSet[string],
) -> bool {
    match value {
        Jump { target: name, args: _, ret_ty: _ } => {
            if name == target {
                true
            } else if visited.contains(name) {
                false
            } else {
                match find_scoped_join(joins, name) {
                    Some(join) => {
                        let _ = visited.insert(name);
                        let result = block_all_paths_reach_or_terminate(
                            join.body,
                            target,
                            joins,
                            visited,
                        );
                        let _ = visited.remove(name);
                        result
                    },
                    None => true,
                }
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            block_all_paths_reach_or_terminate(then_, target, joins, visited)
                && block_all_paths_reach_or_terminate(else_, target, joins, visited)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                if !block_all_paths_reach_or_terminate(arm.body, target, joins, visited) {
                    return false
                }
            }
            match default {
                Some(body) => {
                    block_all_paths_reach_or_terminate(body, target, joins, visited)
                },
                None => true,
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                if !block_all_paths_reach_or_terminate(
                    match arm {
                        Receive { body, .. } | Send { body, .. } => body,
                    },
                    target,
                    joins,
                    visited,
                ) {
                    return false
                }
            }
            match default {
                Some(body) => block_all_paths_reach_or_terminate(body, target, joins, visited),
                None => true,
            }
        },
        Return(_) | Unreachable { ty: _ } => true,
    }
}

fn all_paths_reach_or_terminate(value: anf::Block, target: string) -> bool {
    block_all_paths_reach_or_terminate(
        value,
        target,
        JoinScope::Root(Vec::new()),
        collections::IndexSet::new(),
    )
}

enum LoopBranchTarget {
    Continue,
    Exit(string),
    Invalid,
}

fn loop_branch_target(body: anf::Block, loop_name: string, joins: JoinScope) -> LoopBranchTarget {
    if block_reaches_target(body, loop_name, joins, collections::IndexSet::new()) {
        LoopBranchTarget::Continue
    } else {
        match block_tail_target_through_joins(body, joins, collections::IndexSet::new()) {
            Some(target) => LoopBranchTarget::Exit(target),
            None => LoopBranchTarget::Invalid,
        }
    }
}

fn simple_loop_exit_target(value: anf::Block, loop_name: string, parent: JoinScope) -> Option[
    string,
] {
    let joins = scoped_joins(parent, value);
    match value.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            let then_reaches = block_reaches_target(
                then_,
                loop_name,
                joins,
                collections::IndexSet::new(),
            );
            let else_reaches = block_reaches_target(
                else_,
                loop_name,
                joins,
                collections::IndexSet::new(),
            );
            if then_reaches && !else_reaches {
                block_tail_target_through_joins(else_, joins, collections::IndexSet::new())
            } else if else_reaches && !then_reaches {
                block_tail_target_through_joins(then_, joins, collections::IndexSet::new())
            } else {
                Option::None
            }
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            let targets: Vec[LoopBranchTarget] = Vec::new();
            for arm in arms {
                targets.push(loop_branch_target(arm.body, loop_name, joins))
            }
            if let Some(body) = default {
                targets.push(loop_branch_target(body, loop_name, joins))
            }
            let exits: Vec[string] = Vec::new();
            let continues: Vec[()] = Vec::new();
            for target in targets {
                match target {
                    Continue => continues.push(()),
                    Exit(target) => exits.push(target),
                    Invalid => return Option::None,
                }
            }
            if continues.is_empty() || exits.is_empty() {
                return Option::None
            }
            let target = exits[0];
            for value in exits {
                if value != target {
                    return Option::None
                }
            }
            Option::Some(target)
        },
        Select { arms, default, .. } => {
            let targets: Vec[LoopBranchTarget] = Vec::new();
            for arm in arms {
                targets.push(
                    loop_branch_target(
                        match arm {
                            Receive { body, .. } | Send { body, .. } => body,
                        },
                        loop_name,
                        joins,
                    ),
                )
            }
            if let Some(body) = default {
                targets.push(loop_branch_target(body, loop_name, joins))
            }
            let exits: Vec[string] = Vec::new();
            let continues: Vec[()] = Vec::new();
            for target in targets {
                match target {
                    Continue => continues.push(()),
                    Exit(target) => exits.push(target),
                    Invalid => return Option::None,
                }
            }
            if continues.is_empty() || exits.is_empty() {
                return Option::None
            }
            let target = exits[0];
            for value in exits {
                if value != target {
                    return Option::None
                }
            }
            Option::Some(target)
        },
        _ => Option::None,
    }
}

struct LoopOutcomes {
    has_continue: bool,
    exits: Vec[string],
    valid: bool,
}

fn new_loop_outcomes() -> LoopOutcomes {
    LoopOutcomes { has_continue: false, exits: Vec::new(), valid: true }
}

fn invalid_loop_outcomes() -> LoopOutcomes {
    LoopOutcomes { has_continue: false, exits: Vec::new(), valid: false }
}

fn neutral_loop_outcomes() -> LoopOutcomes {
    LoopOutcomes { has_continue: false, exits: Vec::new(), valid: true }
}

fn merge_loop_outcomes(target: LoopOutcomes, value: LoopOutcomes) -> LoopOutcomes {
    for exit in value.exits {
        target.exits.push(exit)
    }
    LoopOutcomes {
        has_continue: target.has_continue || value.has_continue,
        exits: target.exits,
        valid: target.valid && value.valid,
    }
}

fn block_loop_outcomes(
    value: anf::Block,
    loop_name: string,
    external_exit: string,
    parent: JoinScope,
    internal_joins: Vec[anf::JoinBind],
    visited: collections::IndexSet[string],
) -> LoopOutcomes {
    let joins = scoped_joins(parent, value);
    term_loop_outcomes(value.term, loop_name, external_exit, joins, internal_joins, visited)
}

fn term_loop_outcomes(
    value: anf::Term,
    loop_name: string,
    external_exit: string,
    joins: JoinScope,
    internal_joins: Vec[anf::JoinBind],
    visited: collections::IndexSet[string],
) -> LoopOutcomes {
    match value {
        Jump { target, args, ret_ty: _ } => if target == loop_name {
            if args.is_empty() {
                LoopOutcomes { has_continue: true, exits: Vec::new(), valid: true }
            } else {
                invalid_loop_outcomes()
            }
        } else if external_exit != "" && target == external_exit {
            if args.is_empty() {
                LoopOutcomes { has_continue: false, exits: Vec::from_array([target]), valid: true }
            } else {
                invalid_loop_outcomes()
            }
        } else if visited.contains(target) {
            neutral_loop_outcomes()
        } else {
            match find_scoped_join(joins, target) {
                Some(join) => match join.role {
                    anf::JoinRole::LoopExit => if find_join(internal_joins, target).is_some() {
                        let _ = visited.insert(target);
                        let result = block_loop_outcomes(
                            join.body,
                            loop_name,
                            external_exit,
                            joins,
                            internal_joins,
                            visited,
                        );
                        let _ = visited.remove(target);
                        result
                    } else {
                        LoopOutcomes {
                            has_continue: false,
                            exits: Vec::from_array([target]),
                            valid: true,
                        }
                    },
                    anf::JoinRole::Continuation => {
                        let _ = visited.insert(target);
                        let result = block_loop_outcomes(
                            join.body,
                            loop_name,
                            external_exit,
                            joins,
                            internal_joins,
                            visited,
                        );
                        let _ = visited.remove(target);
                        result
                    },
                    anf::JoinRole::Return => neutral_loop_outcomes(),
                },
                None => invalid_loop_outcomes(),
            }
        },
        If { cond: _, then_, else_, ret_ty: _ } => {
            let mut result = new_loop_outcomes();
            result = merge_loop_outcomes(
                result,
                block_loop_outcomes(then_, loop_name, external_exit, joins, internal_joins, visited),
            );
            result = merge_loop_outcomes(
                result,
                block_loop_outcomes(else_, loop_name, external_exit, joins, internal_joins, visited),
            );
            result
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            let mut result = new_loop_outcomes();
            let mut branches = 0;
            for arm in arms {
                result = merge_loop_outcomes(
                    result,
                    block_loop_outcomes(
                        arm.body,
                        loop_name,
                        external_exit,
                        joins,
                        internal_joins,
                        visited,
                    ),
                );
                branches += 1;
            }
            if let Some(body) = default {
                result = merge_loop_outcomes(
                    result,
                    block_loop_outcomes(
                        body,
                        loop_name,
                        external_exit,
                        joins,
                        internal_joins,
                        visited,
                    ),
                );
                branches += 1;
            }
            if branches == 0 {
                result.valid = false;
            }
            result
        },
        Select { arms, default, .. } => {
            let mut result = new_loop_outcomes();
            let mut branches = 0;
            for arm in arms {
                result = merge_loop_outcomes(
                    result,
                    block_loop_outcomes(
                        match arm {
                            Receive { body, .. } | Send { body, .. } => body,
                        },
                        loop_name,
                        external_exit,
                        joins,
                        internal_joins,
                        visited,
                    ),
                );
                branches += 1;
            }
            if let Some(body) = default {
                result = merge_loop_outcomes(
                    result,
                    block_loop_outcomes(
                        body,
                        loop_name,
                        external_exit,
                        joins,
                        internal_joins,
                        visited,
                    ),
                );
                branches += 1;
            }
            if branches == 0 {
                result.valid = false;
            }
            result
        },
        Return(_) | Unreachable { ty: _ } => neutral_loop_outcomes(),
    }
}

fn loop_exit_target(value: anf::Block, loop_name: string, parent: JoinScope) -> Option[string] {
    if let Some(target) = simple_loop_exit_target(value, loop_name, parent) {
        return Option::Some(target)
    }
    let internal_joins: Vec[anf::JoinBind] = Vec::new();
    collect_joins_block(internal_joins, value);
    let outcomes = block_loop_outcomes(
        value,
        loop_name,
        "",
        parent,
        internal_joins,
        collections::IndexSet::new(),
    );
    if !outcomes.valid || !outcomes.has_continue || outcomes.exits.is_empty() {
        return Option::None
    }
    let target = outcomes.exits[0];
    for value in outcomes.exits {
        if value != target {
            return Option::None
        }
    }
    Option::Some(target)
}

fn find_loop_exit(value: anf::Block, loop_name: string, parent: JoinScope) -> Option[string] {
    let joins = scoped_joins(parent, value);
    match loop_exit_target(value, loop_name, joins) {
        Some(target) => Option::Some(target),
        None => {
            for bind in value.binds {
                if let Join(dispatch) = bind {
                    if all_paths_reach_or_terminate(value, dispatch.name) {
                        if let Some(target) = find_loop_exit(dispatch.body, loop_name, joins) {
                            return Option::Some(target)
                        }
                    }
                }
            }
            Option::None
        },
    }
}

fn compile_loop_branch_to_join(
    env: LowerEnv,
    value: anf::Block,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: env_local_ident(env, param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    }
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(env, values, loop_name, exit_name, label);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        match term_target(value.term) {
            Some(inner_target) => {
                if inner_target == target {
                    append_stmts(
                        stmts,
                        compile_loop_term_to_join(
                            env,
                            value.term,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    )
                } else {
                    match find_join(pending, inner_target) {
                        Some(inner_join) => {
                            append_stmts(
                                stmts,
                                compile_loop_term_to_join(
                                    env,
                                    value.term,
                                    inner_target,
                                    inner_join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ),
                            );
                            append_stmts(
                                stmts,
                                compile_loop_branch_to_join(
                                    env,
                                    inner_join.body,
                                    target,
                                    join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ).stmts,
                            )
                        },
                        None => append_stmts(
                            stmts,
                            compile_loop_term_with_pending(
                                env,
                                value.term,
                                pending,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        ),
                    }
                }
            },
            None => append_stmts(
                stmts,
                compile_loop_term_with_pending(
                    env,
                    value.term,
                    pending,
                    loop_name,
                    exit_name,
                    label,
                ),
            ),
        }
    }
    Block { stmts }
}

fn compile_loop_term_leaf(
    env: LowerEnv,
    value: anf::Term,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        Jump { target, args, ret_ty: _ } => {
            if target == loop_name {
                result.push(Stmt::Continue)
            } else if active_loop_label(env, target).is_some() && args.is_empty() {
                result.push(
                    Stmt::ContinueLabel { label: active_loop_label(env, target).unwrap_or("") },
                )
            } else if target == exit_name {
                if let Some(join) = find_join(env.joins, target) {
                    append_stmts(result, compile_jump_args(env, join, args))
                }
                result.push(Stmt::BreakLabel { label })
            } else {
                match find_join(env.joins, target) {
                    Some(join) => {
                        if let Jump { target: _, args, ret_ty: _ } = value {
                            append_stmts(result, compile_jump_args(env, join, args))
                        }
                        append_stmts(
                            result,
                            compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                        )
                    },
                    None => append_stmts(result, compile_term_leaf(env, value)),
                }
            }
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_loop_block(env, then_, loop_name, exit_name, label),
                else_: Option::Some(compile_loop_block(env, else_, loop_name, exit_name, label)),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_loop_block(env, body, loop_name, exit_name, label).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    if let Some(ty) = arm_type(env, arm.lhs) {
                        cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_loop_block(env, arm.body, loop_name, exit_name, label),
                            },
                        )
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_block(env, body, loop_name, exit_name, label),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_loop_block(env, arm.body, loop_name, exit_name, label),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_block(env, body, loop_name, exit_name, label),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        Select { mode, arms, default, ret_ty: _ } => {
            append_stmts(
                result,
                compile_select(
                    env,
                    mode,
                    arms,
                    default,
                    |body| compile_loop_block(env, body, loop_name, exit_name, label),
                ),
            )
        },
        _ => append_stmts(result, compile_term_leaf(env, value)),
    }
    result
}

fn compile_loop_term_to_join(
    env: LowerEnv,
    value: anf::Term,
    target: string,
    join: anf::JoinBind,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    let result: Vec[Stmt] = Vec::new();
    match value {
        Jump { target: _, args, ret_ty: _ } => {
            append_stmts(result, compile_jump_args(env, join, args))
        },
        If { cond, then_, else_, ret_ty: _ } => result.push(
            Stmt::If {
                cond: compile_imm(env, cond),
                then_: compile_loop_branch_to_join(
                    env,
                    then_,
                    target,
                    join,
                    loop_name,
                    exit_name,
                    label,
                ),
                else_: Option::Some(
                    compile_loop_branch_to_join(
                        env,
                        else_,
                        target,
                        join,
                        loop_name,
                        exit_name,
                        label,
                    ),
                ),
            },
        ),
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            if match_scrutinee_is_unit(scrut) {
                match first_match_body(arms, default) {
                    Some(body) => append_stmts(
                        result,
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ).stmts,
                    ),
                    None => append_stmts(result, non_exhaustive_block().stmts),
                }
            } else if match_uses_types(env, arms) {
                let cases: Vec[TypeSwitchCase] = Vec::new();
                for arm in arms {
                    if let Some(ty) = arm_type(env, arm.lhs) {
                        cases.push(
                            TypeSwitchCase {
                                ty,
                                body: compile_loop_branch_to_join(
                                    env,
                                    arm.body,
                                    target,
                                    join,
                                    loop_name,
                                    exit_name,
                                    label,
                                ),
                            },
                        )
                    }
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::TypeSwitch {
                        binding: Option::None,
                        expr: compile_imm(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            } else {
                let cases: Vec[SwitchCase] = Vec::new();
                for arm in arms {
                    cases.push(
                        SwitchCase {
                            value: compile_imm(env, arm.lhs),
                            body: compile_loop_branch_to_join(
                                env,
                                arm.body,
                                target,
                                join,
                                loop_name,
                                exit_name,
                                label,
                            ),
                        },
                    )
                }
                let lowered_default = match default {
                    Some(body) => Option::Some(
                        compile_loop_branch_to_join(
                            env,
                            body,
                            target,
                            join,
                            loop_name,
                            exit_name,
                            label,
                        ),
                    ),
                    None => Option::Some(non_exhaustive_block()),
                };
                result.push(
                    Stmt::Switch {
                        expr: compile_match_scrutinee(env, scrut),
                        cases,
                        default: lowered_default,
                    },
                )
            }
        },
        Select { mode, arms, default, ret_ty: _ } => append_stmts(
            result,
            compile_select(
                env,
                mode,
                arms,
                default,
                |body| compile_loop_branch_to_join(
                    env,
                    body,
                    target,
                    join,
                    loop_name,
                    exit_name,
                    label,
                ),
            ),
        ),
        _ => append_stmts(result, compile_loop_term_leaf(env, value, loop_name, exit_name, label)),
    }
    result
}

fn compile_loop_term_with_pending(
    env: LowerEnv,
    value: anf::Term,
    pending: Vec[anf::JoinBind],
    loop_name: string,
    exit_name: string,
    label: string,
) -> Vec[Stmt] {
    match term_target(value) {
        Some(target) => match find_join(pending, target) {
            Some(join) => {
                let result: Vec[Stmt] = Vec::new();
                append_stmts(
                    result,
                    compile_loop_term_to_join(env, value, target, join, loop_name, exit_name, label),
                );
                append_stmts(
                    result,
                    compile_loop_block(env, join.body, loop_name, exit_name, label).stmts,
                );
                result
            },
            None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
        },
        None => compile_loop_term_leaf(env, value, loop_name, exit_name, label),
    }
}

fn compile_loop_block(
    env: LowerEnv,
    value: anf::Block,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: env_local_ident(env, param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    }
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec_in_loop(env, values, loop_name, exit_name, label);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(
            stmts,
            compile_loop_term_with_pending(env, value.term, pending, loop_name, exit_name, label),
        )
    }
    Block { stmts }
}

fn compile_active_loop_block(
    env: LowerEnv,
    value: anf::Block,
    loop_name: string,
    exit_name: string,
    label: string,
) -> Block {
    env.active_loop_labels.push((loop_name, label));
    let result = compile_loop_block(env, value, loop_name, exit_name, label);
    let _ = env.active_loop_labels.remove(env.active_loop_labels.len() - 1);
    result
}

fn compile_joinrec_in_loop(
    env: LowerEnv,
    values: Vec[anf::JoinBind],
    outer_loop_name: string,
    outer_exit_name: string,
    outer_label: string,
) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name, JoinScope::Root(env.joins)) {
            Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_active_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                if let Some(exit) = find_join(env.joins, exit_name) {
                    append_stmts(
                        stmts,
                        compile_loop_block(
                            env,
                            exit.body,
                            outer_loop_name,
                            outer_exit_name,
                            outer_label,
                        ).stmts,
                    )
                }
                loop_names.push(value.name)
            },
            None => if single
                && block_reaches_target(
                    value.body,
                    value.name,
                    JoinScope::Root(Vec::new()),
                    collections::IndexSet::new(),
                ) {
                let label = fresh_loop_label(env, value.name);
                let body = compile_active_loop_block(env, value.body, value.name, "", label);
                stmts.push(loop_stmt(label, body));
                loop_names.push(value.name)
            } else if single
                && !block_reaches_target(
                    value.body,
                    value.name,
                    JoinScope::Root(Vec::new()),
                    collections::IndexSet::new(),
                ) {
                append_stmts(
                    stmts,
                    compile_loop_block(
                        env,
                        value.body,
                        outer_loop_name,
                        outer_exit_name,
                        outer_label,
                    ).stmts,
                );
                loop_names.push(value.name)
            },
        }
    }
    JoinRecResult { stmts, loop_names }
}

fn block_contains_loop_label(value: Block, label: string) -> bool {
    for stmt in value.stmts {
        if stmt_contains_loop_label(stmt, label) {
            return true
        }
    }
    false
}

fn stmt_contains_loop_label(value: Stmt, label: string) -> bool {
    match value {
        BreakLabel { label: actual } | ContinueLabel { label: actual } => actual == label,
        If { cond: _, then_, else_ } => {
            block_contains_loop_label(then_, label)
                || match else_ {
                    Some(body) => block_contains_loop_label(body, label),
                    None => false,
                }
        },
        Loop { body } | LabeledLoop { label: _, body } => {
            block_contains_loop_label(body, label)
        },
        Switch { expr: _, cases, default } => {
            for case in cases {
                if block_contains_loop_label(case.body, label) {
                    return true
                }
            }
            match default {
                Some(body) => block_contains_loop_label(body, label),
                None => false,
            }
        },
        TypeSwitch { binding: _, expr: _, cases, default } => {
            for case in cases {
                if block_contains_loop_label(case.body, label) {
                    return true
                }
            }
            match default {
                Some(body) => block_contains_loop_label(body, label),
                None => false,
            }
        },
        Select { cases, default } => {
            for case in cases {
                if block_contains_loop_label(case.body, label) {
                    return true
                }
            }
            match default {
                Some(body) => block_contains_loop_label(body, label),
                None => false,
            }
        },
        _ => false,
    }
}

fn loop_stmt(label: string, body: Block) -> Stmt {
    if block_contains_loop_label(body, label) {
        Stmt::LabeledLoop { label, body }
    } else {
        Stmt::Loop { body }
    }
}

fn compile_joinrec(env: LowerEnv, values: Vec[anf::JoinBind]) -> JoinRecResult {
    let stmts: Vec[Stmt] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    let single = values.len() == 1;
    for value in values {
        match find_loop_exit(value.body, value.name, JoinScope::Root(env.joins)) {
            Some(exit_name) => {
                let label = fresh_loop_label(env, value.name);
                let body = compile_active_loop_block(env, value.body, value.name, exit_name, label);
                stmts.push(loop_stmt(label, body));
                if let Some(exit) = find_join(env.joins, exit_name) {
                    append_stmts(stmts, compile_block(env, exit.body).stmts)
                }
                loop_names.push(value.name)
            },
            None => if single
                && block_reaches_target(
                    value.body,
                    value.name,
                    JoinScope::Root(Vec::new()),
                    collections::IndexSet::new(),
                ) {
                let label = fresh_loop_label(env, value.name);
                let body = compile_active_loop_block(env, value.body, value.name, "", label);
                stmts.push(loop_stmt(label, body));
                loop_names.push(value.name)
            } else if single
                && !block_reaches_target(
                    value.body,
                    value.name,
                    JoinScope::Root(Vec::new()),
                    collections::IndexSet::new(),
                ) {
                append_stmts(stmts, compile_block(env, value.body).stmts);
                loop_names.push(value.name)
            },
        }
    }
    JoinRecResult { stmts, loop_names }
}

fn compile_block(env: LowerEnv, value: anf::Block) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    let pending: Vec[anf::JoinBind] = Vec::new();
    let loop_names: Vec[string] = Vec::new();
    for bind in value.binds {
        match bind {
            Let(value) => append_stmts(stmts, compile_let(env, value)),
            Join(value) => {
                for param in value.params {
                    if param.0 != "_" {
                        stmts.push(
                            Stmt::Var {
                                name: env_local_ident(env, param.0),
                                ty: lower_type(param.1),
                                value: Option::None,
                            },
                        )
                    }
                }
                pending.push(value)
            },
            JoinRec(values) => {
                let compiled = compile_joinrec(env, values);
                append_stmts(stmts, compiled.stmts);
                for name in compiled.loop_names {
                    loop_names.push(name)
                }
            },
        }
    }
    let suppress = match value.term {
        Jump { target, args, ret_ty: _ } => {
            args.is_empty() && loop_names.contains(target)
        },
        _ => false,
    };
    if !suppress {
        append_stmts(stmts, compile_term_with_pending(env, value.term, pending))
    }
    Block { stmts }
}

struct CollectedTypes {
    values: Vec[repr::Type],
    buckets: HashMap[string, Vec[repr::Type]],
}

fn new_collected_types() -> CollectedTypes {
    CollectedTypes { values: Vec::new(), buckets: HashMap::new() }
}

fn add_collected_type(result: CollectedTypes, value: repr::Type) -> () {
    let key = encode_type(value);
    match result.buckets[key] {
        Some(values) => {
            for present in values {
                if repr::types_equal(present, value) {
                    return ()
                }
            }
            values.push(value)
        },
        None => {
            result.buckets[key] = Vec::from_array([value]);
        },
    }
    result.values.push(value)
}

fn collect_type(result: CollectedTypes, value: repr::Type) -> () {
    match repr::resolve_type(value) {
        External { args, .. } => {
            add_collected_type(result, value);
            for arg in args {
                collect_type(result, arg)
            }
        },
        Tuple { items: values } => {
            add_collected_type(result, value);
            for inner in values {
                collect_type(result, inner)
            }
        },
        Named { name: _ } | ClosureEnvironment { name: _ } => add_collected_type(result, value),
        Dyn { trait_name: _, .. } => add_collected_type(result, value),
        Array { len: _, elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        GoPointer { elem } | GoFunction { signature: elem } | Slice { elem } | MutSlice { elem } => collect_type(
            result,
            elem,
        ),
        VecType { elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        RefType { elem } => {
            add_collected_type(result, value);
            collect_type(result, elem);
        },
        Channel { elem, direction: _ } => collect_type(result, elem),
        GoMap { key, value } => {
            collect_type(result, key);
            collect_type(result, value);
        },
        HashMap { key, value } => {
            add_collected_type(result, repr::Type::HashMap { key, value });
            collect_type(result, key);
            collect_type(result, value);
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_type(result, param)
            }
            collect_type(result, ret_ty)
        },
        _ => (),
    }
}

fn collect_imm_type(result: CollectedTypes, value: anf::Imm) -> () {
    collect_type(result, anf::imm_type(value))
}

fn collect_runtime_imm(requirements: RuntimeRequirements, value: anf::Imm) -> () {
    match value {
        Callable { callable: InterfaceBridge(value), ty: _ } => add_interface_bridge(
            requirements.interface_bridges,
            value,
        ),
        Callable { callable: CallbackAdapter(value), ty: _ } => add_callback_adapter(
            requirements.callbacks,
            value,
        ),
        Callable { callable: Runtime(key), ty: _ } => {
            if !requirements.runtime_hooks.contains(key) {
                requirements.runtime_hooks.push(key)
            }
        },
        Callable { callable: Intrinsic(key), ty: function_ty } => {
            if !requirements.intrinsics.contains(key) {
                requirements.intrinsics.push(key)
            }
            if key == "go_error.is" {
                add_go_foreign_spec(
                    requirements.go_foreign,
                    GoForeignSpec {
                        bindings: Vec::new(),
                        is_method: false,
                        import_path: "errors",
                        symbol: "Is",
                        ty: function_ty,
                    },
                )
            }
            if key == "compiler.missing" {
                if let Func { params: _, ret_ty } = repr::resolve_type(function_ty) {
                    add_collected_type(requirements.missing_types, ret_ty)
                }
            }
        },
        Callable { callable: GoForeign { import_path, symbol, binding }, ty } => {
            add_go_foreign_spec(
                requirements.go_foreign,
                GoForeignSpec {
                    bindings: Vec::from_array([binding]),
                    is_method: false,
                    import_path,
                    symbol,
                    ty,
                },
            )
        },
        Callable { callable: GoMethod { symbol, binding }, ty } => {
            add_go_foreign_spec(
                requirements.go_foreign,
                GoForeignSpec {
                    bindings: Vec::from_array([binding]),
                    is_method: true,
                    import_path: "",
                    symbol,
                    ty,
                },
            )
        },
        _ => (),
    }
}

fn collect_runtime_value(requirements: RuntimeRequirements, value: anf::Value) -> () {
    match value {
        Imm(value) => {
            collect_runtime_imm(requirements, value)
        },
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => {
            for arg in args {
                collect_runtime_imm(requirements, arg)
            }
        },
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Go { closure: expr, ty: _ } | PackClosure { environment: expr, apply: _, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => {
            collect_runtime_imm(requirements, expr)
        },
        Binary { op: _, lhs, rhs, ty: _ } => {
            collect_runtime_imm(requirements, lhs);
            collect_runtime_imm(requirements, rhs)
        },
        Assign { name: _, value: expr, target_ty: _, ty: _ } => {
            collect_runtime_imm(requirements, expr)
        },
        Call { func, args, ty: _ } => {
            collect_runtime_imm(requirements, func);
            for arg in args {
                collect_runtime_imm(requirements, arg)
            }
        },
        ToDyn { trait_name: _, for_ty: _, expr, ty: _ } => {
            collect_runtime_imm(requirements, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_runtime_imm(requirements, receiver);
            for arg in args {
                collect_runtime_imm(requirements, arg)
            }
        },
    }
}

fn collect_runtime_block(requirements: RuntimeRequirements, value: anf::Block) -> () {
    for bind in value.binds {
        match bind {
            Let(value) => {
                collect_runtime_value(requirements, value.value)
            },
            Join(value) => {
                collect_runtime_block(requirements, value.body)
            },
            JoinRec(values) => {
                for value in values {
                    collect_runtime_block(requirements, value.body)
                }
            },
        }
    }
    match value.term {
        Return(value) => {
            collect_runtime_imm(requirements, value)
        },
        Jump { target: _, args, ret_ty: _ } => {
            for arg in args {
                collect_runtime_imm(requirements, arg)
            }
        },
        If { cond, then_, else_, ret_ty: _ } => {
            collect_runtime_imm(requirements, cond);
            collect_runtime_block(requirements, then_);
            collect_runtime_block(requirements, else_)
        },
        Match { scrutinee: scrut, arms, default, ret_ty: _ } => {
            collect_runtime_imm(requirements, scrut);
            for arm in arms {
                collect_runtime_imm(requirements, arm.lhs);
                collect_runtime_block(requirements, arm.body)
            }
            if let Some(body) = default {
                collect_runtime_block(requirements, body)
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty: _, body } => {
                        collect_runtime_imm(requirements, channel);
                        if let Some(value) = guard {
                            collect_runtime_imm(requirements, value)
                        }
                        collect_runtime_block(requirements, body)
                    },
                    Send { channel, value, guard, body } => {
                        collect_runtime_imm(requirements, channel);
                        collect_runtime_imm(requirements, value);
                        if let Some(value) = guard {
                            collect_runtime_imm(requirements, value)
                        }
                        collect_runtime_block(requirements, body)
                    },
                }
            }
            if let Some(body) = default {
                collect_runtime_block(requirements, body)
            }
        },
        Unreachable { ty: _ } => (),
    }
}

fn collect_value_type(result: CollectedTypes, value: anf::Value) -> () {
    collect_type(result, anf::value_type(value));
    match value {
        Imm(value) => collect_imm_type(result, value),
        Constr { constructor: _, args, ty: _ } | Tuple { items: args, ty: _ } | Array {
            items: args,
            ty: _,
        } => {
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Go { closure: expr, ty: _ } | PackClosure { environment: expr, apply: _, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => collect_imm_type(result, expr),
        Binary { op: _, lhs, rhs, ty: _ } => {
            collect_imm_type(result, lhs);
            collect_imm_type(result, rhs)
        },
        Assign { name: _, value: expr, target_ty, ty: _ } => {
            collect_imm_type(result, expr);
            collect_type(result, target_ty)
        },
        Call { func, args, ty: _ } => {
            collect_imm_type(result, func);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            collect_type(result, for_ty);
            collect_imm_type(result, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_imm_type(result, receiver);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
    }
}

fn collect_block_types(result: CollectedTypes, value: anf::Block) -> () {
    for bind in value.binds {
        match bind {
            Let(value) => {
                collect_type(result, value.ty);
                collect_value_type(result, value.value)
            },
            Join(value) => {
                for param in value.params {
                    collect_type(result, param.1)
                }
                collect_type(result, value.ret_ty);
                collect_block_types(result, value.body)
            },
            JoinRec(values) => {
                for value in values {
                    for param in value.params {
                        collect_type(result, param.1)
                    }
                    collect_type(result, value.ret_ty);
                    collect_block_types(result, value.body)
                }
            },
        }
    }
    match value.term {
        Return(value) => collect_imm_type(result, value),
        Jump { target: _, args, ret_ty: ty } => {
            collect_type(result, ty);
            for arg in args {
                collect_imm_type(result, arg)
            }
        },
        If { cond, then_, else_, ret_ty: ty } => {
            collect_imm_type(result, cond);
            collect_type(result, ty);
            collect_block_types(result, then_);
            collect_block_types(result, else_)
        },
        Match { scrutinee: scrut, arms, default, ret_ty: ty } => {
            collect_imm_type(result, scrut);
            collect_type(result, ty);
            for arm in arms {
                collect_imm_type(result, arm.lhs);
                collect_block_types(result, arm.body)
            }
            if let Some(body) = default {
                collect_block_types(result, body)
            }
        },
        Select { arms, default, ret_ty: ty, .. } => {
            collect_type(result, ty);
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty, body } => {
                        collect_imm_type(result, channel);
                        if let Some(value) = guard {
                            collect_imm_type(result, value)
                        }
                        collect_type(result, binding_ty);
                        collect_block_types(result, body)
                    },
                    Send { channel, value, guard, body } => {
                        collect_imm_type(result, channel);
                        collect_imm_type(result, value);
                        if let Some(value) = guard {
                            collect_imm_type(result, value)
                        }
                        collect_block_types(result, body)
                    },
                }
            }
            if let Some(body) = default {
                collect_block_types(result, body)
            }
        },
        Unreachable { ty } => collect_type(result, ty),
    }
}

fn collect_type_definition_fields(
    result: CollectedTypes,
    enums: Vec[repr::EnumDef],
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
) -> () {
    let _ = instances;
    for definition in structs {
        for field in definition.fields {
            collect_type(result, field.1)
        }
    }
    for definition in enums {
        for variant in definition.variants {
            for field in enum_field_types(variant.fields) {
                collect_type(result, field)
            }
        }
    }
}

fn runtime_struct(value: repr::Type) -> StructDef {
    match repr::resolve_type(value) {
        Tuple { items: values } => {
            let fields: Vec[(string, Type)] = Vec::new();
            for index in 0..values.len() {
                fields.push((f"_{index}", lower_type(values[index])))
            }
            StructDef { name: type_name(value), fields }
        },
        RefType { elem } => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("value", lower_type(elem)));
            StructDef {
                name: go_generated_ident("ref_" + go_ident(encode_type(elem)) + "_x"),
                fields,
            }
        },
        VecType { elem } => {
            let fields: Vec[(string, Type)] = Vec::new();
            fields.push(("items", Type::Slice { elem: lower_type(elem) }));
            StructDef {
                name: go_generated_ident("_goml_vec_" + go_ident(encode_type(elem))),
                fields,
            }
        },
        _ => StructDef { name: "Error", fields: Vec::new() },
    }
}

fn add_dyn_coercion(result: Vec[DynCoercion], trait_name: string, for_ty: repr::Type) -> () {
    for value in result {
        if value.trait_name == trait_name && encode_type(value.for_ty) == encode_type(for_ty) {
            return
        }
    }
    result.push(DynCoercion { trait_name, for_ty })
}

fn collect_dyn_value(result: Vec[DynCoercion], value: anf::Value) -> () {
    if let ToDyn { trait_name, for_ty, expr: _, ty: _ } = value {
        add_dyn_coercion(result, trait_name, for_ty)
    }
}

fn collect_dyn_block(result: Vec[DynCoercion], value: anf::Block) -> () {
    for bind in value.binds {
        match bind {
            Let(value) => collect_dyn_value(result, value.value),
            Join(value) => collect_dyn_block(result, value.body),
            JoinRec(values) => {
                for value in values {
                    collect_dyn_block(result, value.body)
                }
            },
        }
    }
    match value.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            collect_dyn_block(result, then_);
            collect_dyn_block(result, else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                collect_dyn_block(result, arm.body)
            }
            if let Some(body) = default {
                collect_dyn_block(result, body)
            }
        },
        _ => (),
    }
}

fn block_assigns_name(value: anf::Block, name: string) -> bool {
    for bind in value.binds {
        match bind {
            Let(value) => match value.value {
                Assign { name: target, .. } if target == name => return true,
                _ => (),
            },
            Join(value) => if block_assigns_name(value.body, name) {
                return true
            },
            JoinRec(values) => for value in values {
                if block_assigns_name(value.body, name) {
                    return true
                }
            },
        }
    }
    match value.term {
        If { cond: _, then_, else_, ret_ty: _ } => {
            block_assigns_name(then_, name) || block_assigns_name(else_, name)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                if block_assigns_name(arm.body, name) {
                    return true
                }
            }
            match default {
                Some(body) => block_assigns_name(body, name),
                None => false,
            }
        },
        _ => false,
    }
}

struct GoSize {
    size: isize,
    alignment: isize,
    known: bool,
}

fn known_go_size(size: isize, alignment: isize) -> GoSize {
    GoSize { size, alignment, known: true }
}

fn unknown_go_size() -> GoSize {
    GoSize { size: 0, alignment: 1, known: false }
}

fn aligned_go_size(size: isize, alignment: isize) -> isize {
    (size + alignment - 1) / alignment * alignment
}

fn go_type_list_size(values: Vec[repr::Type], structs: Vec[repr::StructDef], depth: isize) -> GoSize {
    let mut size = 0;
    let mut alignment = 1;
    for value in values {
        let field = go_type_size(value, structs, depth + 1);
        if !field.known {
            return unknown_go_size()
        }
        size = aligned_go_size(size, field.alignment) + field.size;
        if field.alignment > alignment {
            alignment = field.alignment;
        }
    }
    known_go_size(aligned_go_size(size, alignment), alignment)
}

fn go_type_size(value: repr::Type, structs: Vec[repr::StructDef], depth: isize) -> GoSize {
    if depth >= 16 {
        unknown_go_size()
    } else {
        match repr::resolve_type(value) {
            Unit | Never => known_go_size(0, 1),
            Bool | Int8 | Uint8 => known_go_size(1, 1),
            Int16 | Uint16 => known_go_size(2, 2),
            Int32 | Uint32 | Float32 | Char => known_go_size(4, 4),
            Int | Int64 | Uint | Uint64 | Float64 => known_go_size(8, 8),
            External { .. } => unknown_go_size(),
            String => known_go_size(16, 8),
            Tuple { items } => go_type_list_size(items, structs, depth),
            Named { name } | ClosureEnvironment { name } => match find_struct(structs, name) {
                Some(definition) => {
                    let fields: Vec[repr::Type] = Vec::with_capacity(definition.fields.len());
                    for field in definition.fields {
                        fields.push(field.1)
                    }
                    go_type_list_size(fields, structs, depth)
                },
                None => known_go_size(16, 8),
            },
            Dyn { .. } => known_go_size(16, 8),
            Array { len, elem } => {
                let item = go_type_size(elem, structs, depth + 1);
                if item.known {
                    known_go_size(aligned_go_size(item.size, item.alignment) * len, item.alignment)
                } else {
                    item
                }
            },
            Slice { elem: _ } | MutSlice { elem: _ } => known_go_size(24, 8),
            VecType { elem: _ } | GoPointer { elem: _ } | GoFunction { signature: _ } | RefType {
                elem: _,
            } | HashMap { .. } | GoMap { .. } | Channel { elem: _, direction: _ } | Func { .. } => known_go_size(
                8,
                8,
            ),
        }
    }
}

fn large_named_struct(structs: Vec[repr::StructDef], value: repr::Type) -> bool {
    match repr::resolve_type(value) {
        Named { name } => match find_struct(structs, name) {
            Some(_) => {
                let size = go_type_size(value, structs, 0);
                size.known && size.size > 72
            },
            None => false,
        },
        _ => false,
    }
}

fn direct_function_name(value: anf::Imm) -> Option[string] {
    match value {
        Var { name, ty: _ } => Option::Some(name),
        Callable { callable: Function(name), ty: _ } => Option::Some(name),
        Callable { callable: LangItem { item: _, function_name }, ty: _ } => {
            Option::Some(function_name)
        },
        _ => Option::None,
    }
}

fn pointer_param_enabled(values: Vec[PointerParamInfo], function: string, index: isize) -> bool {
    for value in values {
        if value.function == function {
            return index >= 0 && index < value.values.len() && value.values[index]
        }
    }
    false
}

fn pointer_param_copied(values: Vec[PointerParamInfo], function: string, index: isize) -> bool {
    for value in values {
        if value.function == function {
            return index >= 0 && index < value.copies.len() && value.copies[index]
        }
    }
    false
}

fn compile_function(
    builtin: tast::BuiltinContract,
    value: anf::Function,
    constant_names: collections::HashSet[string],
    static_names: collections::HashSet[string],
    top_level_names: collections::HashSet[string],
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    functions: Vec[anf::Function],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
    pointer_params: Vec[PointerParamInfo],
) -> Function {
    let joins: Vec[anf::JoinBind] = Vec::new();
    collect_joins_block(joins, value.body);
    let local_names = function_local_names(value);
    let collection_array_consumers: HashMap[string, anf::Value] = HashMap::new();
    collect_collection_arrays(collection_array_consumers, value.body);
    let params: Vec[(string, Type)] = Vec::new();
    let pointer_vars: collections::HashSet[string] = collections::HashSet::new();
    let copied_params: Vec[(string, string, Type)] = Vec::new();
    for index in 0..value.params.len() {
        let param = value.params[index];
        let name = local_ident(top_level_names, param.0);
        let pointer_name = local_ident_with_suffix(top_level_names, param.0, "_pointer");
        let mut ty = lower_type(param.1);
        if pointer_param_enabled(pointer_params, value.name, index) {
            if pointer_param_copied(pointer_params, value.name, index) {
                copied_params.push((name, pointer_name, ty))
            } else {
                let _ = pointer_vars.insert(param.0);
            }
            ty = Type::Pointer { elem: ty };
        }
        params.push(
            (
                if pointer_param_copied(pointer_params, value.name, index) {
                    pointer_name
                } else {
                    name
                },
                ty,
            ),
        )
    }
    let env = LowerEnv {
        builtin,
        joins,
        constant_names,
        static_names,
        top_level_names,
        local_names,
        collection_array_consumers,
        emitted_loop_labels: collections::IndexSet::new(),
        active_loop_labels: Vec::new(),
        variants,
        structs,
        instances,
        functions,
        function_names,
        dyn_helper_names,
        pointer_params,
        pointer_vars,
        select_counter: Ref::new(0),
    };
    let compiled_body = eliminate_dead_vars(compile_block(env, value.body));
    let stmts: Vec[Stmt] = Vec::with_capacity(copied_params.len() + compiled_body.stmts.len());
    for copied in copied_params {
        stmts.push(
            Stmt::Var {
                name: copied.0,
                ty: copied.2,
                value: Option::Some(
                    Expr::Unary { op: UnaryOp::Deref, expr: Expr::Var { name: copied.1 } },
                ),
            },
        )
    }
    for stmt in compiled_body.stmts {
        stmts.push(stmt)
    }
    Function {
        name: env_function_name(env, value.name),
        params,
        ret_ty: Option::Some(lower_type(value.ret_ty)),
        body: enum_compare_body(Block { stmts }, params, value, variants).unwrap_or(Block { stmts }),
    }
}

fn compile_functions(
    builtin: tast::BuiltinContract,
    values: Vec[anf::Function],
    constant_names: collections::HashSet[string],
    static_names: collections::HashSet[string],
    top_level_names: collections::HashSet[string],
    variants: VariantInfos,
    structs: Vec[repr::StructDef],
    instances: Vec[repr::TypeInstance],
    function_names: FunctionNames,
    dyn_helper_names: DynHelperNames,
    pointer_params: Vec[PointerParamInfo],
) -> Vec[Function] {
    let work: Vec[(isize, anf::Function)] = Vec::with_capacity(values.len());
    let compiled: Vec[Option[Function]] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        work.push((index, values[index]));
        compiled.push(Option::None)
    }
    let completed: Result[(), Vec[task::IndexedError[()]]] = task::for_each_concurrent(
        8,
        work,
        |_: task::CancelToken, item: (isize, anf::Function)| {
            compiled[item.0] = Option::Some(
                compile_function(
                    builtin,
                    item.1,
                    constant_names,
                    static_names,
                    top_level_names,
                    variants,
                    structs,
                    instances,
                    values,
                    function_names,
                    dyn_helper_names,
                    pointer_params,
                ),
            );
            Result::Ok(())
        },
    );
    match completed {
        Ok(()) => (),
        Err(_) => (),
    }
    let result: Vec[Function] = Vec::with_capacity(values.len());
    for index in 0..values.len() {
        match compiled[index] {
            Some(value) => result.push(value),
            None => result.push(
                compile_function(
                    builtin,
                    values[index],
                    constant_names,
                    static_names,
                    top_level_names,
                    variants,
                    structs,
                    instances,
                    values,
                    function_names,
                    dyn_helper_names,
                    pointer_params,
                ),
            ),
        }
    }
    result
}

fn test_main_function(
    function_names: FunctionNames,
    test_cases: Vec[(string, string, Vec[(string, string)])],
    test_fail_key: string,
) -> Function {
    let cases: Vec[SwitchCase] = Vec::new();
    for test_case in test_cases {
        let function_name = mapped_function_name(function_names, test_case.1).unwrap_or_else(
            || function_name(test_case.1),
        );
        let body_stmts: Vec[Stmt] = Vec::new();
        let arguments: Vec[Expr] = Vec::new();
        for argument in test_case.2 {
            arguments.push(
                if argument.0 == "string" {
                    Expr::String { value: argument.1 }
                } else {
                    Expr::Bool { value: argument.1 == "true" }
                },
            )
        }
        body_stmts.push(
            Stmt::Expr {
                expr: Expr::Call { func: Expr::Var { name: function_name }, args: arguments },
            },
        );
        cases.push(
            SwitchCase {
                value: Expr::String { value: test_case.0 },
                body: Block { stmts: body_stmts },
            },
        )
    }
    let default_stmts: Vec[Stmt] = Vec::new();
    let fail_args: Vec[Expr] = Vec::new();
    fail_args.push(Expr::String { value: "unknown test id" });
    default_stmts.push(
        Stmt::Expr {
            expr: Expr::Call {
                func: Expr::Var { name: runtime_hook_name(test_fail_key) },
                args: fail_args,
            },
        },
    );
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(
        Stmt::Switch {
            expr: Expr::Index {
                base: Expr::Var { name: "_goml_os.Args" },
                index: Expr::Int { value: "1" },
            },
            cases,
            default: Option::Some(Block { stmts: default_stmts }),
        },
    );
    Function { name: "main", params: Vec::new(), ret_ty: Option::None, body: Block { stmts } }
}

fn lower_with_target(
    value: anf::File,
    testing: bool,
    exports: Option[Vec[(string, string)]],
    test_cases: Vec[(string, string, Vec[(string, string)])],
) -> Result[File, string] {
    lower_with_target_and_names(value, testing, exports, test_cases, Vec::new())
}

fn lower_with_target_and_names(
    value: anf::File,
    testing: bool,
    exports: Option[Vec[(string, string)]],
    test_cases: Vec[(string, string, Vec[(string, string)])],
    renamed: Vec[(string, string)],
) -> Result[File, string] {
    let builtin = tast::builtin_contract()?;
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let constants = value.constants;
    let constant_names = build_constant_names(constants);
    let statics = value.statics;
    let static_names = build_static_names(statics);
    let function_names = build_function_names(value.functions, structs, enums, type_instances);
    let top_level_names = build_top_level_names(
        value.functions,
        constants,
        statics,
        enums,
        structs,
        type_instances,
        function_names,
    );
    let pointer_params = build_pointer_param_infos(value.functions, structs);
    let variants = plan_variant_infos(builtin, enums, structs, type_instances, function_names);
    let items: Vec[Item] = Vec::new();
    let types = new_collected_types();
    let runtime_hook_keys: Vec[string] = Vec::new();
    let intrinsics: Vec[string] = Vec::new();
    let go_foreign: Vec[GoForeignSpec] = Vec::new();
    let missing_types = new_collected_types();
    let callbacks: Vec[repr::CallbackAdapter] = Vec::new();
    let requirements = RuntimeRequirements {
        runtime_hooks: runtime_hook_keys,
        missing_types,
        intrinsics,
        go_foreign,
        callbacks,
        interface_bridges: Vec::new(),
    };
    let coercions: Vec[DynCoercion] = Vec::new();
    for function in value.functions {
        for param in function.params {
            collect_type(types, param.1)
        }
        collect_type(types, function.ret_ty);
        collect_block_types(types, function.body);
        collect_runtime_block(requirements, function.body);
        collect_dyn_block(coercions, function.body)
    }
    for value in statics {
        collect_type(types, value.ty)
    }
    let runtime_hooks = resolve_runtime_hooks(runtime_hook_keys)?;
    for instance in type_instances {
        if backend_names_match(instance.base_name, builtin.static_cell.name)
            && instance.args.len() == 1 {
            if !intrinsics.contains("once_cell.new") {
                intrinsics.push("once_cell.new")
            }
            if !intrinsics.contains("once_cell.get_or_init") {
                intrinsics.push("once_cell.get_or_init")
            }
        }
    }
    if testing {
        runtime_hooks.push(
            resources::RuntimeHook::Standard(resources::StandardRuntimeHook::TestingFail),
        )
    }
    let dyn_helper_names = build_dyn_helper_names(builtin, coercions, value.functions);
    collect_type_definition_fields(types, enums, structs, type_instances);
    emit_go_foreign_import_items(items, go_foreign, types.values);
    emit_runtime_hook_items(items, runtime_hooks, intrinsics);
    emit_go_foreign_wrapper_items(items, go_foreign);
    emit_callback_adapter_items(items, callbacks);
    for bridge in requirements.interface_bridges {
        for item in emit_interface_bridge(bridge)? {
            items.push(item);
        }
    }
    emit_missing_base_item(items, missing_types.values);
    emit_builtin_runtime_items(
        builtin,
        items,
        types.values,
        missing_types.values,
        type_instances,
        enums,
        structs,
        function_names,
        variants,
    );
    emit_user_type_items(builtin, items, variants, enums, structs, type_instances, function_names);
    emit_constants(items, constants, variants);
    emit_statics(items, statics);
    emit_dyn_runtime_items(
        builtin,
        items,
        types.values,
        coercions,
        enums,
        type_instances,
        value.functions,
        dyn_helper_names,
    );
    for function in compile_functions(
        builtin,
        value.functions,
        constant_names,
        static_names,
        top_level_names,
        variants,
        structs,
        type_instances,
        function_names,
        dyn_helper_names,
        pointer_params,
    ) {
        items.push(Item::Function(function))
    }
    if let Some(declarations) = exports {
        emit_library_exports(items, value.functions, function_names, declarations)?;
    } else if testing {
        let test_fail = resources::runtime_abi_by_hook(
            resources::RuntimeHook::Standard(resources::StandardRuntimeHook::TestingFail),
        );
        match test_fail {
            Some(spec) => {
                items.push(Item::Function(test_main_function(function_names, test_cases, spec.key)))
            },
            None => return Result::Err("missing testing runtime hook ABI"),
        }
    } else {
        let stmts: Vec[Stmt] = Vec::new();
        let entry_name = mapped_function_name(function_names, "main").unwrap_or("main0");
        stmts.push(
            Stmt::Expr {
                expr: Expr::Call { func: Expr::Var { name: entry_name }, args: Vec::new() },
            },
        );
        items.push(
            Item::Function(
                Function {
                    name: "main",
                    params: Vec::new(),
                    ret_ty: Option::None,
                    body: Block { stmts },
                },
            ),
        )
    }
    let file = simplify_record_updates(File { items });
    match exports {
        Some(declarations) => {
            let roots: Vec[string] = Vec::new();
            for declaration in declarations {
                roots.push(declaration.1)
            }
            Result::Ok(
                privatize_library_with_names(
                    prune_functions_with_roots(file, roots),
                    roots,
                    renamed,
                ),
            )
        },
        None => Result::Ok(prune_functions(file)),
    }
}

fn validate_anf_term(value: anf::Term) -> Result[(), string] {
    match value {
        If { cond: _, then_, else_, ret_ty: _ } => {
            validate_anf_block(then_)?;
            validate_anf_block(else_)
        },
        Match { scrutinee: _, arms, default, ret_ty: _ } => {
            for arm in arms {
                validate_anf_block(arm.body)?
            }
            match default {
                Some(body) => validate_anf_block(body),
                None => Result::Ok(()),
            }
        },
        Select { arms, default, .. } => {
            for arm in arms {
                validate_anf_block(
                    match arm {
                        Receive { body, .. } | Send { body, .. } => body,
                    },
                )?
            }
            match default {
                Some(body) => validate_anf_block(body),
                None => Result::Ok(()),
            }
        },
        Return(_) | Jump { target: _, args: _, ret_ty: _ } | Unreachable { ty: _ } => {
            Result::Ok(())
        },
    }
}

fn validate_anf_block(value: anf::Block) -> Result[(), string] {
    for bind in value.binds {
        match bind {
            Let(_) => (),
            Join(join) => validate_anf_block(join.body)?,
            JoinRec(joins) => {
                if joins.len() != 1 {
                    return Result::Err(
                        "Go backend requires each recursive join group to contain exactly one join",
                    )
                }
                validate_anf_block(joins[0].body)?
            },
        }
    }
    validate_anf_term(value.term)
}

fn resolve_runtime_hooks(keys: Vec[string]) -> Result[Vec[resources::RuntimeHook], string] {
    let hooks: Vec[resources::RuntimeHook] = Vec::new();
    for key in keys {
        match resources::runtime_abi_by_key(key) {
            Some(spec) => hooks.push(spec.hook),
            None => return Result::Err("unknown runtime hook " + key),
        }
    }
    Result::Ok(hooks)
}

fn validate_anf_with_external_functions(value: anf::File, external_functions: Vec[string]) -> Result[
    (),
    string,
] {
    anf::verify_with_external_functions(value, external_functions)?;
    let runtime_hooks: Vec[string] = Vec::new();
    let intrinsics: Vec[string] = Vec::new();
    let go_foreign: Vec[GoForeignSpec] = Vec::new();
    let missing_types = new_collected_types();
    let requirements = RuntimeRequirements {
        runtime_hooks,
        missing_types,
        intrinsics,
        go_foreign,
        callbacks: Vec::new(),
        interface_bridges: Vec::new(),
    };
    for function in value.functions {
        if let Err(error) = validate_anf_block(function.body) {
            return Result::Err("in function " + function.name + ": " + error)
        }
        collect_runtime_block(requirements, function.body)
    }
    for bridge in requirements.interface_bridges {
        repr::validate_go_interface_bridge(bridge, repr::go_interface_bridge_type(bridge))?;
    }
    for value in requirements.callbacks {
        repr::validate_callback_signature(value.signature)?;
    }
    resolve_runtime_hooks(runtime_hooks)?;
    for key in intrinsics {
        if resources::intrinsic_abi_by_key(key).is_none() {
            return Result::Err("unknown intrinsic " + key)
        }
    }
    Result::Ok(())
}

fn validate_anf(value: anf::File) -> Result[(), string] {
    validate_anf_with_external_functions(value, Vec::new())
}

pub fn lower(value: anf::File) -> Result[File, string] {
    validate_anf(value)?;
    lower_with_target(anf::canonicalize_names(value), false, Option::None, Vec::new())
}

pub fn lower_tests(value: anf::File, test_cases: Vec[(string, string, Vec[(string, string)])]) -> Result[
    File,
    string,
] {
    validate_anf(value)?;
    lower_with_target(anf::canonicalize_names(value), true, Option::None, test_cases)
}

fn add_go_foreign_spec(values: Vec[GoForeignSpec], spec: GoForeignSpec) -> () {
    let name = go_foreign_spec_name(spec);
    for value in values {
        if go_foreign_spec_name(value) == name {
            for binding in spec.bindings {
                if binding != "" && !value.bindings.contains(binding) {
                    value.bindings.push(binding)
                }
            }
            return
        }
    }
    values.push(spec)
}

fn compile_go_string_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params, ret_ty } if params.len() == 1 => {
            let value = if key == "go_string.from_text" {
                Expr::Var { name: "p0" }
            } else {
                Expr::Convert {
                    ty: Type::String,
                    expr: Expr::Field { expr: Expr::Var { name: "p0" }, field_name: "items" },
                }
            };
            Expr::FuncLit {
                params: Vec::from_array([("p0", lower_type(params[0]))]),
                ret_ty: lower_type(ret_ty),
                body: Block { stmts: Vec::from_array([Stmt::Return { expr: Option::Some(value) }]) },
            }
        },
        _ => Expr::Var { name: "invalid_go_string_callable" },
    }
}

fn compile_go_slice_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            for index in 0..param_types.len() {
                let name = f"p{index}";
                params.push((name, lower_type(param_types[index])));
                args.push(Expr::Var { name });
            }
            let name = if key == "go_slice.capacity" {
                "cap"
            } else {
                "append"
            };
            let value = Expr::Call { func: Expr::Var { name }, args };
            Expr::FuncLit {
                params,
                ret_ty: lower_type(ret_ty),
                body: Block { stmts: Vec::from_array([Stmt::Return { expr: Option::Some(value) }]) },
            }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}

fn compile_go_map_callable(key: string, function_ty: repr::Type) -> Expr {
    match repr::resolve_type(function_ty) {
        Func { params: param_types, ret_ty } => {
            let params: Vec[(string, Type)] = Vec::new();
            let args: Vec[Expr] = Vec::new();
            for index in 0..param_types.len() {
                let name = f"p{index}";
                params.push((name, lower_type(param_types[index])));
                args.push(Expr::Var { name });
            }
            let stmts: Vec[Stmt] = Vec::new();
            let value = if key == "go_map.new" {
                Expr::Make { ty: lower_type(ret_ty), args: Vec::new() }
            } else if key == "go_map.len" {
                Expr::Call { func: Expr::Var { name: "len" }, args }
            } else if key == "go_map.lookup" {
                let element = match repr::resolve_type(param_types[0]) {
                    GoMap { key: _, value } => value,
                    _ => repr::Type::Unit,
                };
                stmts.push(Stmt::Var { name: "item", ty: lower_type(element), value: Option::None });
                stmts.push(Stmt::Var { name: "present", ty: Type::Bool, value: Option::None });
                stmts.push(
                    Stmt::MultiAssign {
                        names: Vec::from_array(["item", "present"]),
                        value: Expr::Index { base: args[0], index: args[1] },
                    },
                );
                Expr::StructLiteral {
                    ty: lower_type(ret_ty),
                    fields: Vec::from_array(
                        [("_0", Expr::Var { name: "item" }), ("_1", Expr::Var { name: "present" })],
                    ),
                }
            } else if key == "go_map.set" {
                stmts.push(Stmt::IndexAssign { base: args[0], index: args[1], value: args[2] });
                Expr::Unit
            } else if key == "go_map.delete" {
                stmts.push(
                    Stmt::Expr { expr: Expr::Call { func: Expr::Var { name: "delete" }, args } },
                );
                Expr::Unit
            } else {
                stmts.push(
                    Stmt::If {
                        cond: Expr::Binary { op: BinaryOp::Eq, lhs: args[0], rhs: Expr::Nil },
                        then_: Block {
                            stmts: Vec::from_array([Stmt::Return { expr: Option::Some(Expr::Nil) }]),
                        },
                        else_: Option::None,
                    },
                );
                stmts.push(
                    Stmt::Var {
                        name: "result",
                        ty: lower_type(ret_ty),
                        value: Option::Some(
                            Expr::Make {
                                ty: lower_type(ret_ty),
                                args: Vec::from_array(
                                    [Expr::Call { func: Expr::Var { name: "len" }, args }],
                                ),
                            },
                        ),
                    },
                );
                stmts.push(
                    Stmt::Range {
                        names: Vec::from_array(["entry_key", "entry_value"]),
                        expr: args[0],
                        body: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::IndexAssign {
                                        base: Expr::Var { name: "result" },
                                        index: Expr::Var { name: "entry_key" },
                                        value: Expr::Var { name: "entry_value" },
                                    },
                                ],
                            ),
                        },
                    },
                );
                Expr::Var { name: "result" }
            };
            stmts.push(Stmt::Return { expr: Option::Some(value) });
            Expr::FuncLit { params, ret_ty: lower_type(ret_ty), body: Block { stmts } }
        },
        _ => Expr::Var { name: go_ident(key) },
    }
}
