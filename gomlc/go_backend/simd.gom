package go_backend;

use module::simd;

struct SimdIntrinsic {
    ty: simd::VectorType,
    mask: bool,
    operation: string,
}

fn simd_intrinsic(key: string) -> Option[SimdIntrinsic] {
    let parts = key.split(".");
    if parts.len() != 3 || parts[0] != "simd" {
        return Option::None
    }
    for ty in simd::vector_types() {
        if parts[1] == simd::vector_name(ty) {
            return Option::Some(SimdIntrinsic { ty, mask: false, operation: parts[2] })
        }
        if parts[1] == simd::mask_name(ty) {
            return Option::Some(
                SimdIntrinsic { ty: simd::mask_type(ty), mask: true, operation: parts[2] },
            )
        }
    }
    Option::None
}

fn simd_element_type(element: simd::Element) -> Type {
    match element {
        F32 => Type::Float32,
        F64 => Type::Float64,
        I8 => Type::Int8,
        U8 => Type::Uint8,
        I16 => Type::Int16,
        U16 => Type::Uint16,
        I32 => Type::Int32,
        U32 => Type::Uint32,
        I64 => Type::Int64,
        U64 => Type::Uint64,
    }
}

fn simd_type_element(ty: Type) -> Option[simd::Element] {
    match ty {
        Float32 => Option::Some(simd::Element::F32),
        Float64 => Option::Some(simd::Element::F64),
        Int8 => Option::Some(simd::Element::I8),
        Uint8 => Option::Some(simd::Element::U8),
        Int16 => Option::Some(simd::Element::I16),
        Uint16 => Option::Some(simd::Element::U16),
        Int32 => Option::Some(simd::Element::I32),
        Uint32 => Option::Some(simd::Element::U32),
        Int64 => Option::Some(simd::Element::I64),
        Uint64 => Option::Some(simd::Element::U64),
        _ => Option::None,
    }
}

fn simd_array_type(ty: simd::VectorType) -> Type {
    Type::Array { len: ty.lanes, elem: simd_element_type(ty.element) }
}

fn simd_bitmask_type(ty: simd::VectorType) -> Type {
    match simd::mask_bytes(ty) {
        1 => Type::Uint8,
        2 => Type::Uint16,
        _ => Type::Uint32,
    }
}

fn simd_conversion_type(spec: SimdIntrinsic) -> Option[simd::VectorType] {
    if spec.operation == "to_bits" {
        return Option::Some(simd::mask_type(spec.ty))
    }
    if spec.operation == "from_bits" {
        return Option::Some(spec.ty)
    }
    for ty in simd::vector_types() {
        if ty.lanes == spec.ty.lanes && spec.operation == "to_" + simd::element_name(ty.element) {
            return Option::Some(ty)
        }
    }
    Option::None
}

fn simd_binary_operation(operation: string) -> Option[BinaryOp] {
    match operation {
        "add" | "reduce_sum" => Option::Some(BinaryOp::Add),
        "sub" => Option::Some(BinaryOp::Sub),
        "mul" | "reduce_product" => Option::Some(BinaryOp::Mul),
        "div" => Option::Some(BinaryOp::Div),
        "eq" => Option::Some(BinaryOp::Eq),
        "ne" => Option::Some(BinaryOp::NotEq),
        "lt" => Option::Some(BinaryOp::Less),
        "le" => Option::Some(BinaryOp::LessEq),
        "gt" => Option::Some(BinaryOp::Greater),
        "ge" => Option::Some(BinaryOp::GreaterEq),
        "bitand" | "reduce_and" => Option::Some(BinaryOp::BitAnd),
        "bitor" | "reduce_or" => Option::Some(BinaryOp::BitOr),
        "bitxor" | "reduce_xor" => Option::Some(BinaryOp::BitXor),
        _ => Option::None,
    }
}

fn simd_is_comparison(operation: string) -> bool {
    Vec::from_array(["eq", "ne", "lt", "le", "gt", "ge"]).contains(operation)
}

fn simd_intrinsic_name(key: string) -> string {
    go_generated_ident("_goml_" + key.replace(".", "_"))
}

fn simd_var(name: string) -> Expr {
    Expr::Var { name }
}

fn simd_int(value: isize) -> Expr {
    Expr::Int { value: value.to_string() }
}

fn simd_binary(op: BinaryOp, lhs: Expr, rhs: Expr) -> Expr {
    Expr::Binary { op, lhs, rhs }
}

fn simd_convert(ty: Type, expr: Expr) -> Expr {
    Expr::Convert { ty, expr }
}

fn simd_call(name: string, args: Vec[Expr]) -> Expr {
    Expr::Call { func: simd_var(name), args }
}

fn simd_return(expr: Expr) -> Stmt {
    Stmt::Return { expr: Option::Some(expr) }
}

fn simd_local(name: string, ty: Type, value: Expr) -> Stmt {
    Stmt::Var { name, ty, value: Option::Some(value) }
}

fn simd_if_return(cond: Expr, value: Expr) -> Stmt {
    Stmt::If {
        cond,
        then_: Block { stmts: Vec::from_array([simd_return(value)]) },
        else_: Option::None,
    }
}

fn simd_lane(name: string, lane: isize) -> Expr {
    Expr::Index { base: simd_var(name), index: simd_int(lane) }
}

fn simd_math_required(spec: SimdIntrinsic) -> bool {
    !spec.mask && simd::is_float(spec.ty.element)
        && Vec::from_array(
            [
                "min",
                "max",
                "reduce_min",
                "reduce_max",
                "abs",
                "sqrt",
                "floor",
                "ceil",
                "trunc",
                "round",
                "round_ties_even",
                "mul_add",
                "to_bits",
                "from_bits",
            ],
        ).contains(spec.operation)
}

fn simd_integer_limit(element: simd::Element, maximum: bool) -> Expr {
    let bits = simd::element_bits(element);
    let value: u64 = if simd::is_signed(element) {
        (1.to_u64() << (bits - 1)) - 1
    } else if bits == 64 {
        0xffffffffffffffff
    } else {
        (1.to_u64() << bits) - 1
    };
    if maximum {
        Expr::Int { value: value.to_string() }
    } else if simd::is_signed(element) {
        Expr::Int { value: "-" + (value + 1).to_string() }
    } else {
        simd_int(0)
    }
}

fn simd_fma32_body() -> Block {
    let statements = Vec::from_array(
        [
            simd_local(
                "product",
                Type::Float64,
                simd_convert(
                    Type::Float64,
                    simd_binary(
                        BinaryOp::Mul,
                        simd_convert(Type::Float64, simd_var("left")),
                        simd_convert(Type::Float64, simd_var("right")),
                    ),
                ),
            ),
            simd_local("z", Type::Float64, simd_convert(Type::Float64, simd_var("addend"))),
            simd_local(
                "sum",
                Type::Float64,
                simd_convert(
                    Type::Float64,
                    simd_binary(BinaryOp::Add, simd_var("product"), simd_var("z")),
                ),
            ),
            simd_if_return(
                simd_binary(
                    BinaryOp::Or,
                    simd_call("_goml_math.IsNaN", Vec::from_array([simd_var("sum")])),
                    simd_call("_goml_math.IsInf", Vec::from_array([simd_var("sum"), simd_int(0)])),
                ),
                simd_convert(Type::Float32, simd_var("sum")),
            ),
            simd_local(
                "part",
                Type::Float64,
                simd_binary(BinaryOp::Sub, simd_var("sum"), simd_var("product")),
            ),
            simd_local(
                "error",
                Type::Float64,
                simd_binary(
                    BinaryOp::Add,
                    simd_binary(
                        BinaryOp::Sub,
                        simd_var("product"),
                        simd_binary(BinaryOp::Sub, simd_var("sum"), simd_var("part")),
                    ),
                    simd_binary(BinaryOp::Sub, simd_var("z"), simd_var("part")),
                ),
            ),
            simd_local(
                "bits",
                Type::Uint64,
                simd_call("_goml_math.Float64bits", Vec::from_array([simd_var("sum")])),
            ),
            Stmt::If {
                cond: simd_binary(
                    BinaryOp::And,
                    simd_binary(BinaryOp::NotEq, simd_var("error"), simd_int(0)),
                    simd_binary(
                        BinaryOp::Eq,
                        simd_binary(BinaryOp::BitAnd, simd_var("bits"), simd_int(1)),
                        simd_int(0),
                    ),
                ),
                then_: Block {
                    stmts: Vec::from_array(
                        [
                            Stmt::If {
                                cond: simd_binary(
                                    BinaryOp::Eq,
                                    simd_binary(BinaryOp::Greater, simd_var("sum"), simd_int(0)),
                                    simd_binary(BinaryOp::Greater, simd_var("error"), simd_int(0)),
                                ),
                                then_: Block {
                                    stmts: Vec::from_array(
                                        [
                                            Stmt::Assign {
                                                name: "bits",
                                                value: simd_binary(
                                                    BinaryOp::Add,
                                                    simd_var("bits"),
                                                    simd_int(1),
                                                ),
                                            },
                                        ],
                                    ),
                                },
                                else_: Option::Some(
                                    Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::Assign {
                                                    name: "bits",
                                                    value: simd_binary(
                                                        BinaryOp::Sub,
                                                        simd_var("bits"),
                                                        simd_int(1),
                                                    ),
                                                },
                                            ],
                                        ),
                                    },
                                ),
                            },
                        ],
                    ),
                },
                else_: Option::None,
            },
            simd_return(
                simd_convert(
                    Type::Float32,
                    simd_call("_goml_math.Float64frombits", Vec::from_array([simd_var("bits")])),
                ),
            ),
        ],
    );
    Block { stmts: statements }
}

fn simd_scalar_helper(name: string, spec: SimdIntrinsic) -> Function {
    let element = spec.ty.element;
    let scalar = simd_element_type(element);
    let left = simd_var("left");
    let right = simd_var("right");
    let params = Vec::from_array([("left", scalar), ("right", scalar)]);
    let stmts: Vec[Stmt] = Vec::new();
    let mut result_type = scalar;
    if spec.operation == "mul_add" {
        params.push(("addend", scalar));
        if element == simd::Element::F32 {
            return Function { name, params, ret_ty: Option::Some(scalar), body: simd_fma32_body() }
        }
        stmts.push(
            simd_return(
                simd_call("_goml_math.FMA", Vec::from_array([left, right, simd_var("addend")])),
            ),
        );
    } else if spec.operation == "saturating_add" || spec.operation == "saturating_sub" {
        let add = spec.operation == "saturating_add";
        stmts.push(
            simd_local(
                "result",
                scalar,
                simd_convert(
                    scalar,
                    simd_binary(
                        if add {
                            BinaryOp::Add
                        } else {
                            BinaryOp::Sub
                        },
                        left,
                        right,
                    ),
                ),
            ),
        );
        if simd::is_signed(element) {
            stmts.push(
                simd_if_return(
                    simd_binary(
                        BinaryOp::And,
                        simd_binary(BinaryOp::Greater, right, simd_int(0)),
                        simd_binary(
                            if add {
                                BinaryOp::Less
                            } else {
                                BinaryOp::Greater
                            },
                            simd_var("result"),
                            left,
                        ),
                    ),
                    simd_integer_limit(element, add),
                ),
            );
            stmts.push(
                simd_if_return(
                    simd_binary(
                        BinaryOp::And,
                        simd_binary(BinaryOp::Less, right, simd_int(0)),
                        simd_binary(
                            if add {
                                BinaryOp::Greater
                            } else {
                                BinaryOp::Less
                            },
                            simd_var("result"),
                            left,
                        ),
                    ),
                    simd_integer_limit(element, !add),
                ),
            );
        } else {
            stmts.push(
                simd_if_return(
                    simd_binary(
                        BinaryOp::Less,
                        if add {
                            simd_var("result")
                        } else {
                            left
                        },
                        if add {
                            left
                        } else {
                            right
                        },
                    ),
                    simd_integer_limit(element, add),
                ),
            );
        }
        stmts.push(simd_return(simd_var("result")));
    } else if let Some(to) = simd_conversion_type(spec) {
        result_type = simd_element_type(to.element);
        params.truncate(1);
        stmts.push(simd_if_return(simd_binary(BinaryOp::NotEq, left, left), simd_int(0)));
        for maximum in Vec::from_array([false, true]) {
            let limit = simd_integer_limit(to.element, maximum);
            stmts.push(
                simd_if_return(
                    simd_binary(
                        if maximum {
                            BinaryOp::GreaterEq
                        } else {
                            BinaryOp::LessEq
                        },
                        simd_convert(Type::Float64, left),
                        simd_convert(Type::Float64, limit),
                    ),
                    limit,
                ),
            );
        }
        stmts.push(simd_return(simd_convert(result_type, left)));
    } else {
        stmts.push(simd_if_return(simd_binary(BinaryOp::NotEq, left, left), right));
        stmts.push(simd_if_return(simd_binary(BinaryOp::NotEq, right, right), left));
        let operation = if spec.operation == "min" || spec.operation == "reduce_min" {
            "Min"
        } else {
            "Max"
        };
        stmts.push(
            simd_return(
                simd_convert(
                    scalar,
                    simd_call(
                        "_goml_math." + operation,
                        Vec::from_array(
                            [simd_convert(Type::Float64, left), simd_convert(Type::Float64, right)],
                        ),
                    ),
                ),
            ),
        );
    }
    Function { name, params, ret_ty: Option::Some(result_type), body: Block { stmts } }
}

fn simd_needs_scalar_helper(spec: SimdIntrinsic) -> bool {
    if spec.mask {
        return false
    }
    if spec.operation == "mul_add" || spec.operation == "saturating_add"
        || spec.operation == "saturating_sub" {
        return true
    }
    if !simd::is_float(spec.ty.element) {
        return false
    }
    if Vec::from_array(["min", "max", "reduce_min", "reduce_max"]).contains(spec.operation) {
        return true
    }
    if let Some(to) = simd_conversion_type(spec) {
        return !simd::is_float(to.element) && spec.operation != "to_bits"
    }
    false
}

fn simd_scalar_binary(spec: SimdIntrinsic, helper: string, left: Expr, right: Expr) -> Expr {
    if simd_needs_scalar_helper(spec) {
        return simd_call(helper, Vec::from_array([left, right]))
    }
    if let Some(op) = simd_binary_operation(spec.operation) {
        return simd_convert(simd_element_type(spec.ty.element), simd_binary(op, left, right))
    }
    let op = if spec.operation == "min" || spec.operation == "reduce_min" {
        "min"
    } else {
        "max"
    };
    simd_call(op, Vec::from_array([left, right]))
}

fn simd_intrinsic_items(key: string, spec: SimdIntrinsic) -> Vec[Item] {
    let vector = simd_array_type(spec.ty);
    let scalar = simd_element_type(spec.ty.element);
    let bitmask = simd_bitmask_type(spec.ty);
    let full = Expr::Int { value: ((1.to_u64() << spec.ty.lanes) - 1).to_string() };
    let name = simd_intrinsic_name(key);
    let helper = name + "_lane";
    let params: Vec[(string, Type)] = Vec::new();
    let stmts: Vec[Stmt] = Vec::new();
    let mut ret_ty = vector;
    let mut values: Vec[Expr] = Vec::new();
    let result = if spec.mask {
        ret_ty = bitmask;
        if let Some(op) = simd_binary_operation(spec.operation) {
            params.push(("left", bitmask));
            params.push(("right", bitmask));
            simd_binary(op, simd_var("left"), simd_var("right"))
        } else {
            params.push(("value", bitmask));
            match spec.operation {
                "bitnot" => simd_binary(
                    BinaryOp::BitAnd,
                    Expr::Unary { op: UnaryOp::BitNot, expr: simd_var("value") },
                    full,
                ),
                "all" => {
                    ret_ty = Type::Bool;
                    simd_binary(BinaryOp::Eq, simd_var("value"), full)
                },
                _ => {
                    ret_ty = Type::Bool;
                    simd_binary(BinaryOp::NotEq, simd_var("value"), simd_int(0))
                },
            }
        }
    } else if spec.operation == "splat" {
        params.push(("value", scalar));
        for _ in 0..spec.ty.lanes {
            values.push(simd_var("value"))
        }
        Expr::ArrayLiteral { ty: vector, items: values }
    } else if spec.operation.starts_with("reduce_") {
        params.push(("value", vector));
        ret_ty = scalar;
        for lane in 0..spec.ty.lanes {
            values.push(simd_lane("value", lane))
        }
        while values.len() > 1 {
            let next: Vec[Expr] = Vec::new();
            for index in 0..values.len() / 2 {
                next.push(
                    simd_scalar_binary(spec, helper, values[index * 2], values[index * 2 + 1]),
                )
            }
            values = next;
        }
        values[0]
    } else if spec.operation == "select" || spec.operation == "shuffle"
        || spec.operation == "swizzle" {
        if spec.operation == "select" {
            params.push(("mask", bitmask));
        }
        params.push(("left", vector));
        if spec.operation != "swizzle" {
            params.push(("right", vector));
        }
        if spec.operation != "select" {
            params.push(("indices", Type::Array { len: spec.ty.lanes, elem: Type::Uint32 }));
        }
        stmts.push(
            Stmt::Var {
                name: "result",
                ty: vector,
                value: if spec.operation == "select" {
                    Option::Some(simd_var("right"))
                } else {
                    Option::None
                },
            },
        );
        for lane in 0..spec.ty.lanes {
            let index = simd_lane("indices", lane);
            let cond = if spec.operation == "select" {
                simd_binary(
                    BinaryOp::NotEq,
                    simd_binary(BinaryOp::BitAnd, simd_var("mask"), simd_int(1 << lane)),
                    simd_int(0),
                )
            } else {
                simd_binary(BinaryOp::Less, index, simd_int(spec.ty.lanes))
            };
            let value = if spec.operation == "select" {
                simd_lane("left", lane)
            } else {
                Expr::Index { base: simd_var("left"), index }
            };
            let otherwise = if spec.operation == "shuffle" {
                Option::Some(
                    Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::If {
                                    cond: simd_binary(
                                        BinaryOp::Less,
                                        index,
                                        simd_int(spec.ty.lanes * 2),
                                    ),
                                    then_: Block {
                                        stmts: Vec::from_array(
                                            [
                                                Stmt::IndexAssign {
                                                    base: simd_var("result"),
                                                    index: simd_int(lane),
                                                    value: Expr::Index {
                                                        base: simd_var("right"),
                                                        index: simd_binary(
                                                            BinaryOp::Sub,
                                                            index,
                                                            simd_int(spec.ty.lanes),
                                                        ),
                                                    },
                                                },
                                            ],
                                        ),
                                    },
                                    else_: Option::None,
                                },
                            ],
                        ),
                    },
                )
            } else {
                Option::None
            };
            stmts.push(
                Stmt::If {
                    cond,
                    then_: Block {
                        stmts: Vec::from_array(
                            [
                                Stmt::IndexAssign {
                                    base: simd_var("result"),
                                    index: simd_int(lane),
                                    value,
                                },
                            ],
                        ),
                    },
                    else_: otherwise,
                },
            );
        }
        simd_var("result")
    } else if let Some(to) = simd_conversion_type(spec) {
        let input = if spec.operation == "from_bits" {
            simd_array_type(simd::mask_type(spec.ty))
        } else {
            vector
        };
        params.push(("value", input));
        ret_ty = simd_array_type(to);
        for lane in 0..spec.ty.lanes {
            let value = simd_lane("value", lane);
            values.push(
                if spec.operation == "to_bits" || spec.operation == "from_bits" {
                    simd_call(
                        f"_goml_math.Float{simd::element_bits(spec.ty.element)}"
                            + if spec.operation == "to_bits" {
                                "bits"
                            } else {
                                "frombits"
                            },
                        Vec::from_array([value]),
                    )
                } else if simd_needs_scalar_helper(spec) {
                    simd_call(helper, Vec::from_array([value]))
                } else {
                    simd_convert(simd_element_type(to.element), value)
                },
            );
        }
        Expr::ArrayLiteral { ty: ret_ty, items: values }
    } else if Vec::from_array(
        [
            "neg",
            "abs",
            "bitnot",
            "sqrt",
            "floor",
            "ceil",
            "trunc",
            "round",
            "round_ties_even",
            "shl",
            "shr",
        ],
    ).contains(spec.operation) {
        params.push(("value", vector));
        let shift = spec.operation == "shl" || spec.operation == "shr";
        if shift {
            params.push(("count", Type::Uint32));
        }
        for lane in 0..spec.ty.lanes {
            let value = simd_lane("value", lane);
            let expression = match spec.operation {
                "neg" => Expr::Unary { op: UnaryOp::Neg, expr: value },
                "bitnot" => Expr::Unary { op: UnaryOp::BitNot, expr: value },
                "shl" | "shr" => simd_binary(
                    if spec.operation == "shl" {
                        BinaryOp::Shl
                    } else {
                        BinaryOp::Shr
                    },
                    value,
                    simd_binary(
                        BinaryOp::BitAnd,
                        simd_var("count"),
                        simd_int(simd::element_bits(spec.ty.element) - 1),
                    ),
                ),
                "abs" if !simd::is_float(spec.ty.element) => {
                    let lane_name = f"lane{lane}";
                    stmts.push(simd_local(lane_name, scalar, value));
                    if simd::is_signed(spec.ty.element) {
                        stmts.push(
                            Stmt::If {
                                cond: simd_binary(BinaryOp::Less, value, simd_int(0)),
                                then_: Block {
                                    stmts: Vec::from_array(
                                        [
                                            Stmt::Assign {
                                                name: lane_name,
                                                value: Expr::Unary { op: UnaryOp::Neg, expr: value },
                                            },
                                        ],
                                    ),
                                },
                                else_: Option::None,
                            },
                        );
                    }
                    simd_var(lane_name)
                },
                _ => {
                    let method = match spec.operation {
                        "abs" => "Abs",
                        "sqrt" => "Sqrt",
                        "floor" => "Floor",
                        "ceil" => "Ceil",
                        "trunc" => "Trunc",
                        "round" => "Round",
                        _ => "RoundToEven",
                    };
                    simd_call(
                        "_goml_math." + method,
                        Vec::from_array([simd_convert(Type::Float64, value)]),
                    )
                },
            };
            values.push(simd_convert(scalar, expression));
        }
        Expr::ArrayLiteral { ty: vector, items: values }
    } else {
        params.push(("left", vector));
        params.push(("right", vector));
        if spec.operation == "mul_add" {
            params.push(("addend", vector));
        }
        let comparison = simd_is_comparison(spec.operation);
        if comparison {
            ret_ty = bitmask;
            stmts.push(simd_local("result", bitmask, simd_int(0)));
        }
        for lane in 0..spec.ty.lanes {
            let left = simd_lane("left", lane);
            let right = simd_lane("right", lane);
            if comparison {
                stmts.push(
                    Stmt::If {
                        cond: simd_binary(
                            simd_binary_operation(spec.operation).unwrap_or(BinaryOp::Eq),
                            left,
                            right,
                        ),
                        then_: Block {
                            stmts: Vec::from_array(
                                [
                                    Stmt::Assign {
                                        name: "result",
                                        value: simd_binary(
                                            BinaryOp::BitOr,
                                            simd_var("result"),
                                            simd_int(1 << lane),
                                        ),
                                    },
                                ],
                            ),
                        },
                        else_: Option::None,
                    },
                );
            } else if spec.operation == "mul_add" {
                values.push(
                    simd_call(helper, Vec::from_array([left, right, simd_lane("addend", lane)])),
                )
            } else {
                values.push(simd_scalar_binary(spec, helper, left, right));
            }
        }
        if comparison {
            simd_var("result")
        } else {
            Expr::ArrayLiteral { ty: vector, items: values }
        }
    };
    stmts.push(simd_return(result));
    let result = Vec::from_array(
        [
            Item::Function(
                Function { name, params, ret_ty: Option::Some(ret_ty), body: Block { stmts } },
            ),
        ],
    );
    if simd_needs_scalar_helper(spec) {
        result.push(Item::Function(simd_scalar_helper(helper, spec)));
    }
    result
}
