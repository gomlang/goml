package go_backend;

fn simd_f32x4_operation(key: string) -> Option[BinaryOp] {
    match key {
        "simd.f32x4.add" => Option::Some(BinaryOp::Add),
        "simd.f32x4.sub" => Option::Some(BinaryOp::Sub),
        "simd.f32x4.mul" => Option::Some(BinaryOp::Mul),
        "simd.f32x4.div" => Option::Some(BinaryOp::Div),
        _ => Option::None,
    }
}

fn simd_intrinsic_name(key: string) -> string {
    go_generated_ident("_goml_" + key.replace(".", "_"))
}

fn simd_intrinsic_item(key: string, op: BinaryOp) -> Item {
    let ty = Type::Array { len: 4, elem: Type::Float32 };
    let values: Vec[Expr] = Vec::new();
    for lane in 0..4 {
        let index = Expr::Int { value: lane.to_string() };
        values.push(
            Expr::Convert {
                ty: Type::Float32,
                expr: Expr::Binary {
                    op,
                    lhs: Expr::Index { base: Expr::Var { name: "left" }, index },
                    rhs: Expr::Index { base: Expr::Var { name: "right" }, index },
                },
            },
        )
    }
    Item::Function(
        Function {
            name: simd_intrinsic_name(key),
            params: Vec::from_array([("left", ty), ("right", ty)]),
            ret_ty: Option::Some(ty),
            body: Block {
                stmts: Vec::from_array(
                    [Stmt::Return { expr: Option::Some(Expr::ArrayLiteral { ty, items: values }) }],
                ),
            },
        },
    )
}
