package go_backend;

use std::testing;

fn record_test_var(name: string) -> Expr {
    Expr::Var { name }
}

fn record_test_binding(name: string, ty: Type, value: Expr) -> Stmt {
    Stmt::Var { name, ty, value: Option::Some(value) }
}

fn record_test_file(extra: Vec[Stmt], value: Expr, result_ty: Type, direct: bool) -> File {
    let ty = Type::Named { name: "Record" };
    let integer = Type::Named { name: "int" };
    let stmts: Vec[Stmt] = Vec::new();
    stmts.push(record_test_binding("snapshot", ty, record_test_var("state")));
    stmts.push(
        record_test_binding(
            "a",
            integer,
            Expr::Field { expr: record_test_var("snapshot"), field_name: "A" },
        ),
    );
    stmts.push(
        record_test_binding(
            "b",
            integer,
            Expr::Field { expr: record_test_var("snapshot"), field_name: "B" },
        ),
    );
    for stmt in extra {
        stmts.push(stmt)
    }
    stmts.push(
        record_test_binding(
            "result",
            result_ty,
            Expr::StructLiteral {
                ty,
                fields: Vec::from_array(
                    [("A", record_test_var("a")), ("B", record_test_var("b")), ("C", value)],
                ),
            },
        ),
    );
    if direct {
        stmts.push(Stmt::Assign { name: "state", value: record_test_var("result") })
    }
    stmts.push(
        Stmt::ReturnMulti {
            exprs: Vec::from_array(
                [record_test_var("snapshot"), record_test_var("result"), record_test_var("state")],
            ),
        },
    );
    File {
        items: Vec::from_array(
            [
                Item::Struct(
                    StructDef {
                        name: "Record",
                        fields: Vec::from_array([("A", integer), ("B", integer), ("C", integer)]),
                    },
                ),
                Item::Function(
                    Function {
                        name: "update",
                        params: Vec::from_array([("state", ty), ("result", integer)]),
                        ret_ty: Option::None,
                        body: Block { stmts },
                    },
                ),
            ],
        ),
    }
}

#[test]
fn record_update_preserves_retained_snapshot_and_result() -> () {
    let file = record_test_file(
        Vec::new(),
        Expr::Int { value: "9" },
        Type::Named { name: "Record" },
        true,
    );
    let output = encode(simplify_record_updates(file));
    testing::assert(output.contains("state.C = 9"));
    testing::assert(output.contains("var snapshot Record = state"));
    testing::assert(output.contains("return snapshot, result, state"));
    testing::assert(!output.contains("state = result"));
}

#[test]
fn record_update_copies_when_result_is_independent() -> () {
    let file = record_test_file(
        Vec::new(),
        Expr::Int { value: "9" },
        Type::Named { name: "Record" },
        false,
    );
    let output = encode(simplify_record_updates(file));
    testing::assert(output.contains("var result Record = snapshot"));
    testing::assert(output.contains("result.C = 9"));
    testing::assert(!output.contains("state.C = 9"));
}

#[test]
fn record_update_rejects_effects_and_shadowed_result() -> () {
    let ty = Type::Named { name: "Record" };
    let effects = Vec::from_array(
        [
            Stmt::Assign { name: "state", value: record_test_var("snapshot") },
            record_test_binding(
                "effect",
                ty,
                Expr::Call { func: record_test_var("mutate"), args: Vec::new() },
            ),
            record_test_binding(
                "pointer",
                Type::Pointer { elem: ty },
                Expr::Unary { op: UnaryOp::Address, expr: record_test_var("snapshot") },
            ),
        ],
    );
    for effect in effects {
        let file = record_test_file(Vec::from_array([effect]), Expr::Int { value: "9" }, ty, true);
        testing::assert_eq(encode(simplify_record_updates(file)), encode(file));
    }
    let file = record_test_file(Vec::new(), record_test_var("result"), ty, true);
    testing::assert_eq(encode(simplify_record_updates(file)), encode(file));
    let file = record_test_file(
        Vec::new(),
        Expr::Int { value: "9" },
        Type::Named { name: "any" },
        false,
    );
    testing::assert_eq(encode(simplify_record_updates(file)), encode(file));
}

#[test]
fn record_update_keeps_method_value_receiver_snapshot() -> () {
    let ty = Type::Named { name: "Record" };
    let file = record_test_file(
        Vec::from_array(
            [
                record_test_binding(
                    "method",
                    Type::Named { name: "any" },
                    Expr::Field { expr: record_test_var("snapshot"), field_name: "Method" },
                ),
            ],
        ),
        Expr::Int { value: "9" },
        ty,
        true,
    );
    for item in file.items {
        if let Item::Function(function) = item {
            function.body.stmts[function.body.stmts.len() - 1] = Stmt::ReturnMulti {
                exprs: Vec::from_array(
                    [
                        record_test_var("snapshot"),
                        record_test_var("result"),
                        record_test_var("state"),
                        record_test_var("method"),
                    ],
                ),
            };
        }
    }
    let lowered = simplify_record_updates(file);
    let found = Ref::new(false);
    for item in lowered.items {
        if let Item::Function(function) = item {
            for stmt in function.body.stmts {
                if let Stmt::Var {
                    name,
                    value: Some(Expr::Field { expr: Expr::Var { name: root }, field_name }),
                    ..,
                } = stmt {
                    if name == "method" {
                        found.set(true);
                        testing::assert_eq(root, "snapshot");
                        testing::assert_eq(field_name, "Method")
                    }
                }
            }
        }
    }
    testing::assert(found.get());
}
