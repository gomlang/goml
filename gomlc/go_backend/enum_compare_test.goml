package go_backend;

use std::testing;

#[test]
fn simplifies_tag_only_enum_equality_with_invalid_tag_guard() -> () {
    let source = "enum E { A, B, C } fn same(a: E, b: E) -> bool { match a { A => match b { A => true, _ => false }, B => match b { B => true, _ => false }, C => match b { C => true, _ => false } } } fn main() -> () { let functions = Vec::from_array([same]); let f = functions[0]; println(f(E::A, E::B)); }";
    let file = lower_source(source);
    for item in file.items {
        if let Item::Function(function) = item {
            if function.name == "same" {
                let output = encode(File { items: Vec::from_array([item]) });
                testing::assert(output.contains("if " + function.params[0].0 + " <= C"));
                testing::assert(
                    output.contains(
                        "return " + function.params[1].0 + " == " + function.params[0].0,
                    ),
                );
                testing::assert(output.contains("panic(\"non-exhaustive match\")"));
                return
            }
        }
    }
    testing::fail("missing same function")
}

#[test]
fn preserves_tag_only_enum_comparisons_with_different_results() -> () {
    let source = "enum E { A, B, C } fn same(a: E, b: E) -> bool { match a { A => match b { A => true, _ => false }, B => match b { B => false, _ => true }, C => match b { C => true, _ => false } } } fn main() -> () { let functions = Vec::from_array([same]); let f = functions[0]; println(f(E::A, E::B)); }";
    let output = encode(lower_source(source));
    testing::assert(output.contains("switch a__0"));
    testing::assert(!output.contains("if a__0 <= C"));
}

#[test]
fn preserves_comparisons_between_different_enum_types() -> () {
    let source = "enum E { A, B } enum F { C, D } fn same(a: E, b: F) -> bool { match a { A => match b { C => true, _ => false }, B => match b { D => true, _ => false } } } fn main() -> () { let functions = Vec::from_array([same]); let f = functions[0]; println(f(E::A, F::C)); }";
    let output = encode(lower_source(source));
    testing::assert(output.contains("switch a__0"));
}
