package mono;

use module::core;
use std::testing;

#[test]
fn dyn_projection_bindings_preserve_declaring_trait_and_arguments() -> () {
    let value = core::Type::Dyn {
        trait_name: "first::Source",
        args: Vec::from_array([core::Type::Bool]),
        associated_types: Vec::from_array([("Item", core::Type::Int32)]),
        additional_bounds: Vec::from_array(
            [
                core::DynTraitBound {
                    trait_name: "second::Source",
                    args: Vec::new(),
                    associated_types: Vec::from_array([("Item", core::Type::String)]),
                },
            ],
        ),
    };
    let first = Option::Some(
        core::TraitRef { name: "first::Source", args: Vec::from_array([core::Type::Bool]) },
    );
    let second = Option::Some(core::TraitRef { name: "second::Source", args: Vec::new() });
    testing::assert(
        mono_types_equal(
            dyn_projection_binding(value, "Item", first).unwrap_or(core::Type::Error),
            core::Type::Int32,
        ),
    );
    testing::assert(
        mono_types_equal(
            dyn_projection_binding(value, "Item", second).unwrap_or(core::Type::Error),
            core::Type::String,
        ),
    );
    for reference in[
        Option::None,
        Option::Some(
            core::TraitRef { name: "first::Source", args: Vec::from_array([core::Type::String]) },
        ),
        Option::Some(core::TraitRef { name: "hidden::Source", args: Vec::new() }),
    ] {
        testing::assert(dyn_projection_binding(value, "Item", reference).is_none());
    }
    testing::assert(dyn_projection_binding(value, "Missing", first).is_none());
    testing::assert(dyn_projection_binding(core::Type::Bool, "Item", first).is_none());
}
