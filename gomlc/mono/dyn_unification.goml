package mono;

use module::core;

fn collect_named_dyn_unification_types(
    templates: Vec[(string, core::Type)],
    actuals: Vec[(string, core::Type)],
    template_types: Vec[core::Type],
    actual_types: Vec[core::Type],
) -> bool {
    if templates.len() != actuals.len() {
        return false
    }
    for template in templates {
        let mut found = false;
        for actual in actuals {
            if template.0 == actual.0 {
                template_types.push(template.1);
                actual_types.push(actual.1);
                found = true;
                break
            }
        }
        if !found {
            return false
        }
    }
    true
}

fn unification_dyn_bounds(value: core::Type) -> Vec[core::DynTraitBound] {
    let result = Vec::new();
    if let Dyn { trait_name, args, associated_types, additional_bounds } = value {
        result.push(core::DynTraitBound { trait_name, args, associated_types });
        for bound in additional_bounds {
            result.push(bound)
        }
    }
    result
}

fn unify_dyn_types(template: core::Type, actual: core::Type, bindings: Vec[TypeBinding]) -> bool {
    let templates = unification_dyn_bounds(template);
    let actuals = unification_dyn_bounds(actual);
    if templates.len() != actuals.len() {
        return false
    }
    let template_types = Vec::new();
    let actual_types = Vec::new();
    for template in templates {
        let mut found = false;
        for actual in actuals {
            if template.trait_name == actual.trait_name {
                if template.args.len() != actual.args.len() {
                    return false
                }
                for arg in template.args {
                    template_types.push(arg)
                }
                for arg in actual.args {
                    actual_types.push(arg)
                }
                if !collect_named_dyn_unification_types(
                    template.associated_types,
                    actual.associated_types,
                    template_types,
                    actual_types,
                ) {
                    return false
                }
                found = true;
                break
            }
        }
        if !found {
            return false
        }
    }
    unify_types(template_types, actual_types, bindings)
}
