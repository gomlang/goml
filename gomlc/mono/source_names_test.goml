package mono;

use module::ast;
use module::core;
use module::hir;
use module::parser;
use module::checker;
use std::testing;

#[test]
fn specialized_functions_retain_source_names_and_deduplicate_instances() -> () {
    let program = core::lower(
        checker::check(
            hir::lower(
                ast::lower(
                    parser::parse(
                        "fn ignore[T](value: T) -> i64 { 0 } fn main() -> () { let first: i64 = ignore(1); let second: i64 = ignore(true); let third: i64 = ignore(false); }",
                    ),
                ),
                "source_names.goml",
            ),
        ).tast,
    );
    let source_names = Vec::new();
    let result = lower_checked_with_source_names(program, source_names);
    if let Some(error) = result.error {
        testing::fail(error);
        return
    }
    if let Err(error) = validate(result.file) {
        testing::fail(error);
        return
    }
    let mut integers = 0;
    let mut booleans = 0;
    for function in result.file.functions {
        let mut source_name = "";
        for source in source_names {
            if source.0 == function.name {
                source_name = source.1;
            }
        }
        testing::assert(source_name != "");
        if source_name == "ignore" {
            testing::assert_eq(function.params.len(), 1);
            match function.params[0].1 {
                Int => {
                    integers += 1;
                },
                Bool => {
                    booleans += 1;
                },
                _ => testing::fail("unexpected specialization parameter"),
            }
        }
    }
    testing::assert_eq(integers, 1);
    testing::assert_eq(booleans, 1);
}
