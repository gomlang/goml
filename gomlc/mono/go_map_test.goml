package mono;

use module::ffi;
use std::collections;
use std::testing;

#[test]
fn validates_map_keys_through_materialized_struct_fields() -> () {
    let bad = StructDef {
        name: "Bad",
        fields: Vec::from_array([("field", Type::MutSlice { elem: Type::Int64 })]),
        public_fields: Vec::new(),
        has_hidden_fields: true,
    };
    let outer = StructDef {
        name: "Outer",
        fields: Vec::from_array([("nested", Type::Named { name: "Bad" })]),
        public_fields: Vec::new(),
        has_hidden_fields: false,
    };
    let safe = StructDef {
        name: "Safe",
        fields: Vec::from_array(
            [("pointer", Type::GoPointer { elem: Type::Named { name: "Bad" } })],
        ),
        public_fields: Vec::new(),
        has_hidden_fields: false,
    };
    let names: collections::HashSet[string] = collections::HashSet::new();
    for name in Vec::from_array(["Bad", "Outer", "Safe"]) {
        let _ = names.insert(name);
    }
    let ctx = ValidateContext {
        external_keys: Option::None,
        types: names,
        structs: Vec::from_array([bad, outer, safe]),
    };
    for key in Vec::from_array(
        [
            Type::Named { name: "Bad" },
            Type::Named { name: "Outer" },
            Type::Array { len: 0, elem: Type::Named { name: "Outer" } },
            Type::Tuple { items: Vec::from_array([Type::Int64, Type::Named { name: "Outer" }]) },
        ],
    ) {
        match validate_type(ctx, Type::GoMap { key, value: Type::Int64 }, "test") {
            Err(error) => testing::assert(error.contains("Go map key is not comparable")),
            Ok(_) => testing::fail("accepted non-comparable materialized key"),
        }
    }
    testing::assert(
        validate_type(
            ctx,
            Type::GoMap { key: Type::Named { name: "Safe" }, value: Type::Int64 },
            "test",
        ).is_ok(),
    );
}

#[test]
fn external_map_key_rules_reject_missing_and_unresolved_metadata() -> () {
    let key = Type::External { import_path: "example.com/host", name: "Key", args: Vec::new() };
    let template = ffi::GoTypeIdentity::Named {
        import_path: "example.com/host",
        name: "Key",
        arguments: Vec::new(),
    };
    let validate = |rules| {
        let ctx = ValidateContext {
            external_keys: Option::Some(rules),
            types: collections::HashSet::new(),
            structs: Vec::new(),
        };
        validate_type(ctx, Type::GoMap { key, value: Type::Int64 }, "fixture")
    };
    testing::assert(validate(Vec::new()).is_err());
    for rule in Vec::from_array([ffi::GoComparability::Unknown, ffi::GoComparability::Parameter(0)]) {
        testing::assert(validate(Vec::from_array([ExternalKeyRule { template, rule }])).is_err());
    }
    testing::assert(
        validate(
            Vec::from_array(
                [
                    ExternalKeyRule {
                        template: ffi::GoTypeIdentity::Parameter(0),
                        rule: ffi::GoComparability::Parameter(0),
                    },
                    ExternalKeyRule { template, rule: ffi::GoComparability::Always },
                ],
            ),
        ).is_ok(),
    );
    testing::assert(
        validate(Vec::from_array([ExternalKeyRule { template, rule: ffi::GoComparability::Never }])).is_err(),
    );
}
