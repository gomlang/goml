package mono;

use std::collections;
use std::testing;

#[test]
fn validates_map_keys_through_materialized_struct_fields() -> () {
    let bad = StructDef {
        name: "Bad",
        fields: Vec::from_array([("field", Type::MutSlice { elem: Type::Int64 })]),
        public_fields: Vec::new(),
        has_hidden_fields: true,
    };
    let outer = StructDef {
        name: "Outer",
        fields: Vec::from_array([("nested", Type::Named { name: "Bad" })]),
        public_fields: Vec::new(),
        has_hidden_fields: false,
    };
    let safe = StructDef {
        name: "Safe",
        fields: Vec::from_array(
            [("pointer", Type::GoPointer { elem: Type::Named { name: "Bad" } })],
        ),
        public_fields: Vec::new(),
        has_hidden_fields: false,
    };
    let names: collections::HashSet[string] = collections::HashSet::new();
    for name in Vec::from_array(["Bad", "Outer", "Safe"]) {
        let _ = names.insert(name);
    }
    let ctx = ValidateContext { types: names, structs: Vec::from_array([bad, outer, safe]) };
    for key in Vec::from_array(
        [
            Type::Named { name: "Bad" },
            Type::Named { name: "Outer" },
            Type::Array { len: 0, elem: Type::Named { name: "Outer" } },
            Type::Tuple { items: Vec::from_array([Type::Int64, Type::Named { name: "Outer" }]) },
        ],
    ) {
        match validate_type(ctx, Type::GoMap { key, value: Type::Int64 }, "test") {
            Err(error) => testing::assert(error.contains("Go map key is not comparable")),
            Ok(_) => testing::fail("accepted non-comparable materialized key"),
        }
    }
    testing::assert(
        validate_type(ctx, GoMap { key: Type::Named { name: "Safe" }, value: Type::Int64 }, "test").is_ok(),
    );
}

#[test]
fn opaque_external_map_keys_defer_native_comparability() -> () {
    let external = Type::External {
        import_path: "example.com/host",
        name: "Key",
        args: Vec::from_array([Type::MutSlice { elem: Type::Int64 }]),
    };
    let wrapper = StructDef {
        name: "Wrapper",
        fields: Vec::from_array([("value", external)]),
        public_fields: Vec::new(),
        has_hidden_fields: false,
    };
    let names: collections::HashSet[string] = collections::HashSet::new();
    let _ = names.insert(wrapper.name);
    let ctx = ValidateContext { types: names, structs: Vec::from_array([wrapper]) };
    for key in Vec::from_array(
        [
            external,
            Type::Array { len: 2, elem: external },
            Type::Tuple { items: Vec::from_array([Type::Int64, external]) },
            Named { name: wrapper.name },
        ],
    ) {
        if let Err(error) = validate_type(ctx, Type::GoMap { key, value: Type::Int64 }, "fixture") {
            testing::fail(error)
        }
    }
}
