package mono;

use module::core;
use module::consts;
use module::tast;

fn specialized_const_integer(value: core::Type) -> Result[isize, string] {
    if let Some(number) = core::const_type_value(value) {
        return Ok(number)
    }
    if let App { ty: core::Type::Con { name }, args } = value {
        if name.starts_with("$const_op:") && args.len() == 2 {
            let left = specialized_const_integer(args[0])?;
            let right = specialized_const_integer(args[1])?;
            return consts::binary(name.byte_slice(10, name.byte_len()), left, right)
        }
    }
    Err("integer constant remained unresolved after generic specialization")
}

fn specialized_array_length(value: core::Type) -> Result[isize, string] {
    let length = specialized_const_integer(value)?;
    if length < 0 {
        Err("array length must be nonnegative after generic specialization")
    } else {
        Ok(length)
    }
}

fn specialized_const_type_error(value: core::Type) -> Option[string] {
    if let Some(parts) = core::symbolic_array(value) {
        match specialized_const_integer(parts.0) {
            Ok(number) if number < 0 => return Some("const usize argument must be nonnegative"),
            Err(error) => return Some(error),
            _ => (),
        }
    }
    if let core::Type::Array { len, .. } = value {
        if len < 0 {
            return Some("const usize argument must be nonnegative")
        }
    }
    let children = Vec::new();
    tast::for_each_child_type(core::type_to_tast(value), |child| children.push(child));
    for child in children {
        if let Some(error) = specialized_const_type_error(core::lower_type(child)) {
            return Some(error)
        }
    }
    None
}
