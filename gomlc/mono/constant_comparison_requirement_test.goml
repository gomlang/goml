package mono;

use module::ast;
use module::checker;
use module::core;
use module::hir;
use module::parser;
use std::testing;

fn specialize_constant_comparison(value: string, ordering: bool) -> LowerResult {
    let source = "struct Value {} fn constrained[T](value: T) -> bool { true } fn main() -> () { let _ = constrained("
        + value
        + "); }";
    let file = core::lower(
        checker::check(hir::lower(ast::lower(parser::parse(source)), "main.goml")).tast,
    );
    for function in file.functions {
        if function.name == "constrained" {
            function.predicates.push(
                core::TypePredicate::ConstComparison {
                    ty: core::Type::Param { name: function.generics[0] },
                    ordering,
                },
            );
        }
    }
    lower_checked(file)
}

#[test]
fn specialization_checks_constant_comparison_requirements_before_unused_arguments_disappear() -> () {
    for value in["Value {}", "(Value {},)", "[Value {}]"] {
        let result = specialize_constant_comparison(value, false);
        match result.error {
            Some(message) => testing::assert(
                message.contains("associated constant comparison requires builtin operands"),
            ),
            None => testing::fail("expected constant comparison rejection for " + value),
        }
    }
    for value in["3", "true", "(true, 3)", "[3, 4]"] {
        if let Some(message) = specialize_constant_comparison(value, false).error {
            testing::fail(value + ": " + message);
        }
    }
    testing::assert(specialize_constant_comparison("true", true).error.is_some());
    testing::assert(specialize_constant_comparison("3", true).error.is_none());
}
