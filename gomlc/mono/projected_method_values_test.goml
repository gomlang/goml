package mono;

use module::ast;
use module::parser;
use module::hir;
use module::checker;
use module::core;
use std::testing;

#[test]
fn specializes_projected_inherent_method_values() -> () {
    let source = "trait Value { type Item; } impl Value for bool { type Item = i32; } struct Reader {} impl Reader { fn read[T: Value](self: Reader, value: T::Item) -> T::Item { value } } fn main() -> () { let method = Reader::read::[bool]; let _: i32 = method(Reader {}, 4); }";
    let checked = checker::check(hir::lower(ast::lower(parser::parse(source)), "main.goml"));
    let lowered = core::lower(checked.tast);
    if let Some(error) = lower_checked(lowered).error {
        testing::fail(error + "\n" + core::encode(lowered));
    }
}
