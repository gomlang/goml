package mono;

use module::core;
use std::testing;

#[test]
fn specialized_function_bodies_reject_invalid_array_lengths() -> () {
    for source in[
        "fn make[const N: usize]() -> () { let values = [0; N - 1]; let _ = values; } fn main() -> () { make::[0](); }",
        "fn make[const N: usize]() -> () { let values = [0; N - 1]; let _ = values; } fn forward[const N: usize]() -> () { make::[N](); } fn main() -> () { forward::[0](); }",
        "fn make[const N: usize]() -> () { let callback = || { let values = [0; N - 1]; let _ = values; }; callback(); } fn main() -> () { make::[0](); }",
    ] {
        let result = lower_checked_source(source);
        match result.error {
            Some(error) => testing::assert(error.contains("array length must be nonnegative")),
            None => testing::fail("expected invalid specialized array length"),
        }
    }
    for expression in["1 / N", "1 % N", "(1 / N) + 1"] {
        let source = "fn make[const N: usize]() -> () { let values = [0; " + expression
            + "]; let _ = values; } fn main() -> () { make::[0](); }";
        match lower_checked_source(source).error {
            Some(error) => testing::assert(
                error.contains("division by zero in constant expression"),
            ),
            None => testing::fail("expected invalid specialized constant arithmetic"),
        }
    }
    match lower_checked_source(
        "fn make[const N: usize]() -> () { let values = [0; N + 1]; let _ = values; } fn main() -> () { make::[9223372036854775807](); }",
    ).error {
        Some(error) => testing::assert(error.contains("integer overflow in constant expression")),
        None => testing::fail("expected specialized constant overflow"),
    }
}

#[test]
fn specialization_accepts_valid_and_unused_generic_array_bodies() -> () {
    for source in[
        "fn make[const N: usize]() -> () { let values = [0; N - 1]; let _ = values; } fn main() -> () { make::[2](); }",
        "fn make[const N: usize]() -> () { let values = [0; (N - 3) + 4]; let _ = values; } fn forward[const N: usize]() -> () { make::[N](); } fn main() -> () { forward::[1](); }",
        "fn unused[const N: usize]() -> () { let values = [0; 1 / N]; let _ = values; } fn main() -> () {}",
    ] {
        if let Some(error) = lower_checked_source(source).error {
            testing::fail(error)
        }
    }
}

#[test]
fn specialization_checks_concrete_negative_array_types() -> () {
    let result = lower_checked(
        core_file_with_residual_type(core::Type::Array { len: -1, elem: core::Type::Int }),
    );
    testing::assert(result.error.is_some());
}
