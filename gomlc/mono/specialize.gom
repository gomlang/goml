package mono;

use module::ast;
use module::core;
use module::tast;
use std::cmp;
use std::collections;
use std::text;

type FunctionIndex = HashMap[string, Vec[core::Function]];

struct TypeBinding {
    name: string,
    ty: core::Type,
}

struct Instance {
    original_name: string,
    name: string,
    bindings: Vec[TypeBinding],
    parent: Option[string],
}

struct TraitSelection {
    reference: core::TraitRef,
    associated_types: Vec[(string, core::Type)],
}

struct SpecializeCtx {
    external_applications: Vec[core::ExternalTypeApplication],
    resolved_external_applications: Vec[core::ExternalTypeApplication],
    builtin: tast::BuiltinContract,
    functions: Vec[core::Function],
    function_index: HashMap[string, core::Function],
    inherent_method_index: FunctionIndex,
    trait_function_index: FunctionIndex,
    trait_method_index: FunctionIndex,
    trait_method_names: HashMap[string, string],
    instances: Vec[Instance],
    instance_index: HashMap[string, Instance],
    work: Vec[Instance],
    used_names: collections::HashSet[string],
    active: Ref[Option[Instance]],
    error: Ref[Option[string]],
}

fn find_binding(values: Vec[TypeBinding], name: string) -> Option[core::Type] {
    let mut index = values.len() - 1;
    while index >= 0 {
        let value = values[index];
        if value.name == name {
            return Option::Some(value.ty)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn bind_type(values: Vec[TypeBinding], name: string, ty: core::Type) -> bool {
    match find_binding(values, name) {
        Some(previous) => compact_type(previous) == compact_type(ty),
        None => {
            values.push(TypeBinding { name, ty });
            true
        },
    }
}

fn unify_types(templates: Vec[core::Type], actuals: Vec[core::Type], bindings: Vec[TypeBinding]) -> bool {
    if templates.len() != actuals.len() {
        false
    } else {
        for index in 0..templates.len() {
            if unify_type(templates[index], actuals[index], bindings) {} else {
                return false
            }
        }
        true
    }
}

fn unify_optional_trait_refs(
    templates: Option[core::TraitRef],
    actuals: Option[core::TraitRef],
    bindings: Vec[TypeBinding],
) -> bool {
    match (templates, actuals) {
        (Some(template), Some(actual)) => {
            template.name == actual.name && unify_types(template.args, actual.args, bindings)
        },
        (None, None) => true,
        _ => false,
    }
}

fn projection_binding_name(base: core::Type, name: string, reference: Option[core::TraitRef]) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string("projection#");
    builder.write_string(compact_type(base));
    builder.write_char('#');
    if let Some(reference) = reference {
        builder.write_string(reference.name);
        for arg in reference.args {
            builder.write_char('#');
            builder.write_string(compact_type(arg))
        }
    }
    builder.write_char('#');
    builder.write_string(name);
    builder.finish()
}

fn has_projection_binding(values: Vec[TypeBinding]) -> bool {
    for value in values {
        if value.name.starts_with("projection#") {
            return true
        }
    }
    false
}

fn unify_type(template: core::Type, actual: core::Type, bindings: Vec[TypeBinding]) -> bool {
    match (core::resolve_type(template), core::resolve_type(actual)) {
        (Param { name }, value) => bind_type(bindings, name, value),
        (Unit, Unit) | (Never, Never) | (Bool, Bool) | (Int, Int) | (Int8, Int8) | (Int16, Int16) | (
            Int32,
            Int32,
        ) | (Int64, Int64) | (Uint, Uint) | (Uint8, Uint8) | (Uint16, Uint16) | (Uint32, Uint32) | (
            Uint64,
            Uint64,
        ) | (Float32, Float32) | (Float64, Float64) | (String, String) | (Char, Char) | (
            Error,
            Error,
        ) => true,
        (Tuple { items: templates }, Tuple { items: actuals }) => {
            unify_types(templates, actuals, bindings)
        },
        (
            External { import_path: a, name: n, args: x },
            External { import_path: b, name: m, args: y },
        ) => a == b && n == m && unify_types(x, y, bindings),
        (Con { name: template }, Con { name: actual }) => template == actual,
        (Dyn { trait_name: template, .. }, Dyn { trait_name: actual, .. }) => {
            template == actual
        },
        (
            Projection { for_ty: template_base, name: template_name, trait_ref: template_ref },
            Projection { for_ty: actual_base, name: actual_name, trait_ref: actual_ref },
        ) => {
            template_name == actual_name && unify_type(template_base, actual_base, bindings)
                && unify_optional_trait_refs(template_ref, actual_ref, bindings)
        },
        (Projection { for_ty: base, name, trait_ref: reference }, actual) => {
            let base = substitute_type(base, bindings);
            let reference = substitute_optional_trait_ref(reference, bindings);
            if type_is_concrete(base) && type_is_concrete(actual) {
                bind_type(bindings, projection_binding_name(base, name, reference), actual)
            } else {
                false
            }
        },
        (App { ty: template_base, args: template_args }, App { ty: actual_base, args: actual_args }) => {
            unify_type(template_base, actual_base, bindings)
                && unify_types(template_args, actual_args, bindings)
        },
        (
            Array { len: template_length, elem: template_elem },
            Array { len: actual_length, elem: actual_elem },
        ) => {
            template_length == actual_length && unify_type(template_elem, actual_elem, bindings)
        },
        (Slice { elem: template }, Slice { elem: actual }) | (
            MutSlice { elem: template },
            MutSlice { elem: actual },
        ) | (VecType { elem: template }, VecType { elem: actual }) | (
            RefType { elem: template },
            RefType { elem: actual },
        ) | (GoPointer { elem: template }, GoPointer { elem: actual }) | (
            GoFunction { signature: template },
            GoFunction { signature: actual },
        ) => {
            unify_type(template, actual, bindings)
        },
        (
            Channel { elem: template, direction: template_direction },
            Channel { elem: actual, direction: actual_direction },
        ) => {
            ast::channel_directions_equal(template_direction, actual_direction)
                && unify_type(template, actual, bindings)
        },
        (
            HashMap { key: template_key, value: template_value },
            HashMap { key: actual_key, value: actual_value },
        ) => {
            unify_type(template_key, actual_key, bindings)
                && unify_type(template_value, actual_value, bindings)
        },
        (
            GoMap { key: template_key, value: template_value },
            GoMap { key: actual_key, value: actual_value },
        ) => {
            unify_type(template_key, actual_key, bindings)
                && unify_type(template_value, actual_value, bindings)
        },
        (
            Func { params: template_params, ret_ty: template_ret },
            Func { params: actual_params, ret_ty: actual_ret },
        ) => {
            unify_types(template_params, actual_params, bindings)
                && unify_type(template_ret, actual_ret, bindings)
        },
        _ => false,
    }
}

fn substitute_types(values: Vec[core::Type], bindings: Vec[TypeBinding]) -> Vec[core::Type] {
    let result: Vec[core::Type] = Vec::new();
    for value in values {
        result.push(substitute_type(value, bindings))
    }
    result
}

fn substitute_named_types(values: Vec[(string, core::Type)], bindings: Vec[TypeBinding]) -> Vec[
    (string, core::Type),
] {
    let result: Vec[(string, core::Type)] = Vec::new();
    for value in values {
        result.push((value.0, substitute_type(value.1, bindings)))
    }
    result
}

fn substitute_optional_trait_ref(value: Option[core::TraitRef], bindings: Vec[TypeBinding]) -> Option[
    core::TraitRef,
] {
    value.map(|reference| substitute_trait_ref(reference, bindings))
}

fn substitute_trait_ref(value: core::TraitRef, bindings: Vec[TypeBinding]) -> core::TraitRef {
    core::TraitRef { name: value.name, args: substitute_types(value.args, bindings) }
}

fn substitute_type(value: core::Type, bindings: Vec[TypeBinding]) -> core::Type {
    match core::resolve_type(value) {
        Unit => core::Type::Unit,
        Never => core::Type::Never,
        Bool => core::Type::Bool,
        Int => core::Type::Int,
        Int8 => core::Type::Int8,
        Int16 => core::Type::Int16,
        Int32 => core::Type::Int32,
        Int64 => core::Type::Int64,
        Uint => core::Type::Uint,
        Uint8 => core::Type::Uint8,
        Uint16 => core::Type::Uint16,
        Uint32 => core::Type::Uint32,
        Uint64 => core::Type::Uint64,
        Float32 => core::Type::Float32,
        Float64 => core::Type::Float64,
        String => core::Type::String,
        Char => core::Type::Char,
        Tuple { items } => {
            core::Type::Tuple { items: substitute_types(items, bindings) }
        },
        External { import_path, name, args } => core::Type::External {
            import_path,
            name,
            args: substitute_types(args, bindings),
        },
        Con { name } => core::Type::Con { name },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let substituted_associated: Vec[(string, core::Type)] = Vec::new();
            for binding in associated_types {
                substituted_associated.push((binding.0, substitute_type(binding.1, bindings)))
            }
            let substituted_additional: Vec[core::DynTraitBound] = Vec::new();
            for bound in additional_bounds {
                let bound_associated: Vec[(string, core::Type)] = Vec::new();
                for binding in bound.associated_types {
                    bound_associated.push((binding.0, substitute_type(binding.1, bindings)))
                }
                substituted_additional.push(
                    core::DynTraitBound {
                        trait_name: bound.trait_name,
                        args: substitute_types(bound.args, bindings),
                        associated_types: bound_associated,
                    },
                )
            }
            core::Type::Dyn {
                trait_name,
                args: substitute_types(args, bindings),
                associated_types: substituted_associated,
                additional_bounds: substituted_additional,
            }
        },
        Projection { for_ty: base, name, trait_ref: reference } => {
            let base = substitute_type(base, bindings);
            let reference = substitute_optional_trait_ref(reference, bindings);
            match find_binding(bindings, projection_binding_name(base, name, reference)) {
                Some(ty) => ty,
                None => match core::builtin_projection(base, name, reference) {
                    Some(ty) => substitute_type(ty, bindings),
                    None => core::Type::Projection { for_ty: base, name, trait_ref: reference },
                },
            }
        },
        App { ty: base, args } => core::Type::App {
            ty: substitute_type(base, bindings),
            args: substitute_types(args, bindings),
        },
        Array { len: length, elem } => {
            core::Type::Array { len: length, elem: substitute_type(elem, bindings) }
        },
        Slice { elem } => {
            core::Type::Slice { elem: substitute_type(elem, bindings) }
        },
        MutSlice { elem } => {
            core::Type::MutSlice { elem: substitute_type(elem, bindings) }
        },
        VecType { elem } => {
            core::Type::VecType { elem: substitute_type(elem, bindings) }
        },
        GoPointer { elem } => {
            core::Type::GoPointer { elem: substitute_type(elem, bindings) }
        },
        GoFunction { signature } => {
            core::Type::GoFunction { signature: substitute_type(signature, bindings) }
        },
        RefType { elem } => {
            core::Type::RefType { elem: substitute_type(elem, bindings) }
        },
        Channel { elem, direction } => {
            core::Type::Channel { elem: substitute_type(elem, bindings), direction }
        },
        HashMap { key, value } => core::Type::HashMap {
            key: substitute_type(key, bindings),
            value: substitute_type(value, bindings),
        },
        GoMap { key, value } => core::Type::GoMap {
            key: substitute_type(key, bindings),
            value: substitute_type(value, bindings),
        },
        Param { name } => match find_binding(bindings, name) {
            Some(ty) => ty,
            None => core::Type::Param { name },
        },
        Func { params, ret_ty } => core::Type::Func {
            params: substitute_types(params, bindings),
            ret_ty: substitute_type(ret_ty, bindings),
        },
        Error => core::Type::Error,
    }
}

fn function_type(value: core::Function) -> core::Type {
    let params: Vec[core::Type] = Vec::new();
    for param in value.params {
        params.push(param.1)
    }
    core::Type::Func { params, ret_ty: value.ret_ty }
}

fn function_is_generic(value: core::Function) -> bool {
    if !value.generics.is_empty() {
        true
    } else {
        let mut generic = !type_is_concrete(value.ret_ty);
        for param in value.params {
            if type_is_concrete(param.1) {} else {
                generic = true;
            }
        }
        generic
    }
}

fn find_function(ctx: SpecializeCtx, name: string) -> Option[core::Function] {
    ctx.function_index[name]
}

fn inherent_function_method(value: core::Function) -> Option[string] {
    match value.origin {
        core::FunctionOrigin::Inherent { owner: _, method_name } => Option::Some(method_name),
        _ => Option::None,
    }
}

fn canonical_inherent_owner_type(builtin: tast::BuiltinContract, value: core::Type) -> core::Type {
    match core::resolve_type(value) {
        Con { name } => if name.starts_with("builtin::") {
            core::Type::Con { name: name.byte_slice(9, name.byte_len()) }
        } else {
            core::Type::Con { name }
        },
        App { ty, args } => {
            let base = canonical_inherent_owner_type(builtin, ty);
            let values: Vec[core::Type] = Vec::new();
            for arg in args {
                values.push(canonical_inherent_owner_type(builtin, arg))
            }
            match base {
                Con { name } if mono_names_match(name, builtin.vec.name) && values.len() == 1 => {
                    core::Type::VecType { elem: values[0] }
                },
                Con { name } if mono_names_match(name, builtin.slice.name) && values.len() == 1 => {
                    core::Type::Slice { elem: values[0] }
                },
                Con { name } if mono_names_match(name, builtin.mut_slice.name) && values.len() == 1 => core::Type::MutSlice {
                    elem: values[0],
                },
                Con { name } if mono_names_match(name, builtin.ref_type.name) && values.len() == 1 => {
                    core::Type::RefType { elem: values[0] }
                },
                Con { name } if mono_names_match(name, builtin.go_map.name) && values.len() == 2 => {
                    core::Type::GoMap { key: values[0], value: values[1] }
                },
                Con { name } if mono_names_match(name, builtin.hashmap.name) && values.len() == 2 => {
                    core::Type::HashMap { key: values[0], value: values[1] }
                },
                Con { name } if mono_names_match(name, builtin.channel.name) && values.len() == 1 => {
                    core::Type::Channel { elem: values[0], direction: ast::ChannelDirection::Both }
                },
                Con { name } if mono_names_match(name, builtin.sender.name) && values.len() == 1 => {
                    core::Type::Channel { elem: values[0], direction: ast::ChannelDirection::Send }
                },
                Con { name } if mono_names_match(name, builtin.receiver.name) && values.len() == 1 => {
                    core::Type::Channel {
                        elem: values[0],
                        direction: ast::ChannelDirection::Receive,
                    }
                },
                other => core::Type::App { ty: other, args: values },
            }
        },
        other => other,
    }
}

fn lookup_pair_key(left: string, right: string) -> string {
    f"{left.byte_len()}:{left}{right}"
}

fn add_indexed_function(index: FunctionIndex, key: string, function: core::Function) -> () {
    index.entry(key).or_insert_with(|| Vec::new()).push(function)
}

fn indexed_functions(index: FunctionIndex, key: string) -> Vec[core::Function] {
    index[key].unwrap_or_else(|| Vec::new())
}

fn mono_short_name(value: string) -> string {
    match text::rfind(value, "::") {
        Some(index) => value.byte_slice(index + 2, value.byte_len()),
        None => value,
    }
}

fn mono_names_match(name: string, expected: string) -> bool {
    name == expected || (!name.contains("::") && mono_short_name(name) == mono_short_name(expected))
}

fn structural_trait_type(value: core::Type) -> bool {
    match core::resolve_type(value) {
        Tuple { items: _ } | Array { len: _, elem: _ } => true,
        _ => false,
    }
}

fn core_var(name: string, ty: core::Type) -> core::Expr {
    core::Expr::Var { name, ty }
}

fn core_uint64(value: string) -> core::Expr {
    core::Expr::Prim { value: core::Primitive::Int { value }, ty: core::Type::Uint64 }
}

fn core_trait_call(
    reference: core::TraitRef,
    method_name: string,
    for_ty: core::Type,
    receiver: Option[core::Expr],
    args: Vec[core::Expr],
    ty: core::Type,
) -> core::Expr {
    core::Expr::TraitCall {
        trait_ref: reference,
        method_name,
        instance_name: Option::None,
        for_ty,
        receiver,
        args,
        ty,
    }
}

fn structural_array_item(value: core::Expr, owner: core::Type, elem: core::Type, index: isize) -> core::Expr {
    let params = Vec::from_array([owner, core::Type::Int]);
    core::Expr::Call {
        func: core::Expr::Callable {
            callable: core::Callable::Intrinsic("array.get"),
            ty: core::Type::Func { params, ret_ty: elem },
        },
        args: Vec::from_array(
            [
                value,
                core::Expr::Prim {
                    value: core::Primitive::Int { value: index.to_string() },
                    ty: core::Type::Int,
                },
            ],
        ),
        ty: elem,
    }
}

fn structural_items(value: core::Expr, ty: core::Type) -> Vec[(core::Expr, core::Type)] {
    let result: Vec[(core::Expr, core::Type)] = Vec::new();
    match core::resolve_type(ty) {
        Tuple { items } => for index in 0..items.len() {
            result.push((core::Expr::Proj { tuple: value, index, ty: items[index] }, items[index]))
        },
        Array { len, elem } => for index in 0..len {
            result.push((structural_array_item(value, ty, elem, index), elem))
        },
        _ => (),
    }
    result
}

fn core_bool(value: bool) -> core::Expr {
    core::Expr::Prim { value: core::Primitive::Bool { value }, ty: core::Type::Bool }
}

fn core_bool_conjunction(values: Vec[core::Expr]) -> core::Expr {
    let mut result = core_bool(true);
    let mut index = values.len();
    while index > 0 {
        index -= 1;
        result = core::Expr::If {
            cond: values[index],
            then_branch: result,
            else_branch: core_bool(false),
            ty: core::Type::Bool,
        };
    }
    result
}

fn structural_partial_eq_body(builtin: tast::BuiltinContract, ty: core::Type) -> core::Expr {
    let left = structural_items(core_var("self", ty), ty);
    let right = structural_items(core_var("other", ty), ty);
    let comparisons: Vec[core::Expr] = Vec::new();
    for index in 0..left.len() {
        comparisons.push(
            core_trait_call(
                core::TraitRef { name: builtin.partial_eq.name, args: Vec::new() },
                builtin.partial_eq.method,
                left[index].1,
                Option::Some(left[index].0),
                Vec::from_array([right[index].0]),
                core::Type::Bool,
            ),
        )
    }
    core_bool_conjunction(comparisons)
}

fn structural_hash_body(builtin: tast::BuiltinContract, ty: core::Type) -> core::Expr {
    let stmts: Vec[core::LetStmt] = Vec::new();
    let mut previous = "_structural_hash_0";
    stmts.push(
        core::LetStmt {
            name: previous,
            value: core_uint64("14695981039346656037"),
            ty: core::Type::Uint64,
        },
    );
    let mut index = 0;
    for item in structural_items(core_var("self", ty), ty) {
        let hash = core_trait_call(
            core::TraitRef { name: builtin.hash.name, args: Vec::new() },
            builtin.hash.method,
            item.1,
            Option::Some(item.0),
            Vec::new(),
            core::Type::Uint64,
        );
        let next = f"_structural_hash_{index + 1}";
        stmts.push(
            core::LetStmt {
                name: next,
                value: core::Expr::Binary {
                    op: ast::BinaryOp::Add,
                    lhs: core::Expr::Binary {
                        op: ast::BinaryOp::Mul,
                        lhs: core_var(previous, core::Type::Uint64),
                        rhs: core_uint64("1099511628211"),
                        ty: core::Type::Uint64,
                    },
                    rhs: hash,
                    ty: core::Type::Uint64,
                },
                ty: core::Type::Uint64,
            },
        );
        previous = next;
        index += 1;
    }
    core::Expr::Block {
        block: core::Block { stmts, tail: Option::Some(core_var(previous, core::Type::Uint64)) },
        ty: core::Type::Uint64,
    }
}

fn structural_default_body(builtin: tast::BuiltinContract, ty: core::Type) -> core::Expr {
    match core::resolve_type(ty) {
        Tuple { items } => {
            let values: Vec[core::Expr] = Vec::new();
            for item in items {
                values.push(
                    core_trait_call(
                        core::TraitRef { name: builtin.default.name, args: Vec::new() },
                        builtin.default.method,
                        item,
                        Option::None,
                        Vec::new(),
                        item,
                    ),
                )
            }
            core::Expr::Tuple { items: values, ty }
        },
        Array { len, elem } => {
            let values: Vec[core::Expr] = Vec::new();
            for _ in 0..len {
                values.push(
                    core_trait_call(
                        core::TraitRef { name: builtin.default.name, args: Vec::new() },
                        builtin.default.method,
                        elem,
                        Option::None,
                        Vec::new(),
                        elem,
                    ),
                )
            }
            core::Expr::Array { items: values, ty }
        },
        _ => core::Expr::Prim { value: core::Primitive::Unit, ty: core::Type::Unit },
    }
}

fn nominal_type_name(value: core::Type) -> string {
    match core::resolve_type(value) {
        Con { name } => name,
        App { ty: Con { name }, args: _ } => name,
        _ => "",
    }
}

fn ordering_constructor(ordering_ty: core::Type, name: string, tag: isize) -> core::Expr {
    core::Expr::Constr {
        constructor: core::Constructor {
            name: nominal_type_name(ordering_ty) + "::" + name,
            fields: Vec::new(),
            is_struct: false,
            tag: Option::Some(tag),
        },
        args: Vec::new(),
        ty: ordering_ty,
    }
}

fn option_constructor(option_ty: core::Type, name: string, tag: isize, args: Vec[core::Expr]) -> core::Expr {
    core::Expr::Constr {
        constructor: core::Constructor {
            name: nominal_type_name(option_ty) + "::" + name,
            fields: Vec::new(),
            is_struct: false,
            tag: Option::Some(tag),
        },
        args,
        ty: option_ty,
    }
}

fn option_item_type(value: core::Type) -> core::Type {
    match core::resolve_type(value) {
        App { ty: Con { name: _ }, args } if args.len() == 1 => args[0],
        _ => core::Type::Error,
    }
}

fn ordering_is_equal(builtin: tast::BuiltinContract, value: core::Expr, ordering_ty: core::Type) -> core::Expr {
    core_trait_call(
        core::TraitRef { name: builtin.partial_eq.name, args: Vec::new() },
        builtin.partial_eq.method,
        ordering_ty,
        Option::Some(value),
        Vec::from_array(
            [
                ordering_constructor(
                    ordering_ty,
                    builtin.ordering.equal.name,
                    builtin.ordering.equal.tag,
                ),
            ],
        ),
        core::Type::Bool,
    )
}

fn structural_partial_ord_bool_body(
    builtin: tast::BuiltinContract,
    reference: core::TraitRef,
    method_name: string,
    ty: core::Type,
) -> core::Expr {
    let left = structural_items(core_var("self", ty), ty);
    let right = structural_items(core_var("other", ty), ty);
    let mut result = core_bool(
        method_name == builtin.ordering.le || method_name == builtin.ordering.ge,
    );
    let mut index = left.len();
    while index > 0 {
        index -= 1;
        let equals = core_trait_call(
            core::TraitRef { name: builtin.partial_eq.name, args: Vec::new() },
            builtin.partial_eq.method,
            left[index].1,
            Option::Some(left[index].0),
            Vec::from_array([right[index].0]),
            core::Type::Bool,
        );
        let ordered = core_trait_call(
            reference,
            if method_name == builtin.ordering.le {
                builtin.ordering.lt
            } else if method_name == builtin.ordering.ge {
                builtin.ordering.gt
            } else {
                method_name
            },
            left[index].1,
            Option::Some(left[index].0),
            Vec::from_array([right[index].0]),
            core::Type::Bool,
        );
        result = core::Expr::If {
            cond: equals,
            then_branch: result,
            else_branch: ordered,
            ty: core::Type::Bool,
        };
    }
    result
}

fn structural_ord_body(
    builtin: tast::BuiltinContract,
    reference: core::TraitRef,
    ty: core::Type,
    ordering_ty: core::Type,
) -> core::Expr {
    let left = structural_items(core_var("self", ty), ty);
    let right = structural_items(core_var("other", ty), ty);
    let mut result = ordering_constructor(
        ordering_ty,
        builtin.ordering.equal.name,
        builtin.ordering.equal.tag,
    );
    let mut index = left.len();
    while index > 0 {
        index -= 1;
        let name = f"_structural_ordering_{index}";
        let comparison = core_trait_call(
            reference,
            builtin.ordering.cmp,
            left[index].1,
            Option::Some(left[index].0),
            Vec::from_array([right[index].0]),
            ordering_ty,
        );
        result = core::Expr::Block {
            block: core::Block {
                stmts: Vec::from_array([core::LetStmt { name, value: comparison, ty: ordering_ty }]),
                tail: Option::Some(
                    core::Expr::If {
                        cond: ordering_is_equal(builtin, core_var(name, ordering_ty), ordering_ty),
                        then_branch: result,
                        else_branch: core_var(name, ordering_ty),
                        ty: ordering_ty,
                    },
                ),
            },
            ty: ordering_ty,
        };
    }
    result
}

fn structural_partial_ord_body(
    builtin: tast::BuiltinContract,
    reference: core::TraitRef,
    ty: core::Type,
    option_ty: core::Type,
) -> core::Expr {
    let ordering_ty = option_item_type(option_ty);
    let left = structural_items(core_var("self", ty), ty);
    let right = structural_items(core_var("other", ty), ty);
    let mut result = option_constructor(
        option_ty,
        builtin.option.some.name,
        builtin.option.some.tag,
        Vec::from_array(
            [
                ordering_constructor(
                    ordering_ty,
                    builtin.ordering.equal.name,
                    builtin.ordering.equal.tag,
                ),
            ],
        ),
    );
    let some = core::Constructor {
        name: nominal_type_name(option_ty) + "::" + builtin.option.some.name,
        fields: Vec::new(),
        is_struct: false,
        tag: Option::Some(builtin.option.some.tag),
    };
    let none = core::Constructor {
        name: nominal_type_name(option_ty) + "::" + builtin.option.none.name,
        fields: Vec::new(),
        is_struct: false,
        tag: Option::Some(builtin.option.none.tag),
    };
    let mut index = left.len();
    while index > 0 {
        index -= 1;
        let comparison_name = f"_structural_partial_ordering_{index}";
        let ordering_name = comparison_name + "_value";
        let comparison = core_trait_call(
            reference,
            builtin.ordering.partial_cmp,
            left[index].1,
            Option::Some(left[index].0),
            Vec::from_array([right[index].0]),
            option_ty,
        );
        let ordering = core::Expr::ConstrGet {
            expr: core_var(comparison_name, option_ty),
            constructor: some,
            field_index: 0,
            ty: ordering_ty,
        };
        let some_body = core::Expr::Block {
            block: core::Block {
                stmts: Vec::from_array(
                    [core::LetStmt { name: ordering_name, value: ordering, ty: ordering_ty }],
                ),
                tail: Option::Some(
                    core::Expr::If {
                        cond: ordering_is_equal(
                            builtin,
                            core_var(ordering_name, ordering_ty),
                            ordering_ty,
                        ),
                        then_branch: result,
                        else_branch: core_var(comparison_name, option_ty),
                        ty: option_ty,
                    },
                ),
            },
            ty: option_ty,
        };
        result = core::Expr::Block {
            block: core::Block {
                stmts: Vec::from_array(
                    [core::LetStmt { name: comparison_name, value: comparison, ty: option_ty }],
                ),
                tail: Option::Some(
                    core::Expr::Match {
                        expr: core_var(comparison_name, option_ty),
                        arms: Vec::from_array(
                            [
                                core::Arm {
                                    lhs: core::Expr::Constr {
                                        constructor: none,
                                        args: Vec::new(),
                                        ty: option_ty,
                                    },
                                    body: core_var(comparison_name, option_ty),
                                },
                                core::Arm {
                                    lhs: core::Expr::Constr {
                                        constructor: some,
                                        args: Vec::from_array(
                                            [core_var(ordering_name, ordering_ty)],
                                        ),
                                        ty: option_ty,
                                    },
                                    body: some_body,
                                },
                            ],
                        ),
                        default: Option::None,
                        ty: option_ty,
                    },
                ),
            },
            ty: option_ty,
        };
    }
    result
}

fn synthetic_structural_trait_function(
    builtin: tast::BuiltinContract,
    reference: core::TraitRef,
    method_name: string,
    for_ty: core::Type,
    ret_ty: core::Type,
) -> Option[core::Function] {
    if !structural_trait_type(for_ty) {
        Option::None
    } else {
        let body = if mono_names_match(reference.name, builtin.partial_eq.name)
            && method_name == builtin.partial_eq.method {
            structural_partial_eq_body(builtin, for_ty)
        } else if mono_names_match(reference.name, builtin.hash.name)
            && method_name == builtin.hash.method {
            structural_hash_body(builtin, for_ty)
        } else if mono_names_match(reference.name, builtin.default.name)
            && method_name == builtin.default.method {
            structural_default_body(builtin, for_ty)
        } else if mono_names_match(reference.name, builtin.ordering.partial_ord)
            && method_name == builtin.ordering.partial_cmp {
            structural_partial_ord_body(builtin, reference, for_ty, ret_ty)
        } else if mono_names_match(reference.name, builtin.ordering.partial_ord)
            && (method_name == builtin.ordering.lt || method_name == builtin.ordering.le
                || method_name == builtin.ordering.gt
                || method_name == builtin.ordering.ge) {
            structural_partial_ord_bool_body(builtin, reference, method_name, for_ty)
        } else if mono_names_match(reference.name, builtin.ordering.ord)
            && method_name == builtin.ordering.cmp {
            structural_ord_body(builtin, reference, for_ty, ret_ty)
        } else {
            return Option::None
        };
        let params = if method_name == builtin.default.method {
            Vec::new()
        } else if method_name == builtin.hash.method {
            Vec::from_array([("self", for_ty)])
        } else {
            Vec::from_array([("self", for_ty), ("other", for_ty)])
        };
        Option::Some(
            core::Function {
                name: core_trait_impl_name(reference, for_ty, method_name),
                origin: core::FunctionOrigin::TraitImplementation { method_name },
                root: false,
                generics: Vec::new(),
                predicates: Vec::new(),
                trait_impl: Option::Some(
                    core::TraitImpl {
                        trait_ref: reference,
                        for_ty,
                        associated_types: Vec::new(),
                        generic_count: 0,
                        predicate_count: 0,
                    },
                ),
                params,
                ret_ty,
                body: core::Block { stmts: Vec::new(), tail: Option::Some(body) },
            },
        )
    }
}

fn register_structural_trait_function(
    ctx: SpecializeCtx,
    reference: core::TraitRef,
    method_name: string,
    for_ty: core::Type,
    ret_ty: core::Type,
) -> () {
    if let Some(function) = synthetic_structural_trait_function(
        ctx.builtin,
        reference,
        method_name,
        for_ty,
        ret_ty,
    ) {
        if ctx.function_index.contains(function.name) {} else {
            ctx.functions.push(function);
            ctx.function_index[function.name] = function;
            add_indexed_function(ctx.trait_function_index, reference.name, function);
            ctx.trait_method_names[function.name] = method_name;
            add_indexed_function(
                ctx.trait_method_index,
                lookup_pair_key(reference.name, method_name),
                function,
            );
            let _ = ctx.used_names.insert(function.name);
        }
    }
}

fn find_inherent_function(
    ctx: SpecializeCtx,
    owner: core::Type,
    method_name: string,
    callable_ty: core::Type,
) -> Option[core::Function] {
    for function in indexed_functions(ctx.inherent_method_index, method_name) {
        if let core::FunctionOrigin::Inherent { owner: template, method_name: _ } = function.origin {
            let bindings: Vec[TypeBinding] = Vec::new();
            let owner_matches = unify_type(
                canonical_inherent_owner_type(ctx.builtin, template),
                canonical_inherent_owner_type(ctx.builtin, owner),
                bindings,
            );
            let callable_matches = unify_type(function_type(function), callable_ty, Vec::new());
            if owner_matches || callable_matches {
                return Option::Some(function)
            }
        }
    }
    Option::None
}

fn find_callee_function(ctx: SpecializeCtx, name: string) -> Option[core::Function] {
    find_function(ctx, name)
}

fn trait_impl_method(value: core::Function) -> Option[string] {
    match value.origin {
        core::FunctionOrigin::TraitImplementation { method_name } => Option::Some(method_name),
        _ => Option::None,
    }
}

fn trait_instance_name(ctx: SpecializeCtx, function: core::Function, bindings: Vec[TypeBinding]) -> Option[
    string,
] {
    match (function.trait_impl, ctx.trait_method_names[function.name]) {
        (Some(metadata), Some(method_name)) => Option::Some(
            core_trait_impl_name(
                substitute_trait_ref(metadata.trait_ref, bindings),
                substitute_type(metadata.for_ty, bindings),
                method_name,
            ),
        ),
        _ => Option::None,
    }
}

fn find_instance(ctx: SpecializeCtx, original_name: string, bindings: Vec[TypeBinding]) -> Option[
    Instance,
] {
    ctx.instance_index[instance_lookup_key(original_name, bindings)]
}

fn name_is_used(ctx: SpecializeCtx, name: string) -> bool {
    ctx.used_names.contains(name)
}

fn type_binding_compare(left: TypeBinding, right: TypeBinding) -> cmp::Ordering {
    cmp::compare(left.name, right.name)
}

fn sorted_bindings(values: Vec[TypeBinding]) -> Vec[TypeBinding] {
    collections::sort_by_ordering(values, type_binding_compare);
    values
}

fn instance_lookup_key(original_name: string, bindings: Vec[TypeBinding]) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(original_name.byte_len().to_string());
    builder.write_char(':');
    builder.write_string(original_name);
    for binding in sorted_bindings(bindings) {
        let ty = compact_type(binding.ty);
        builder.write_string(binding.name.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(binding.name);
        builder.write_string(ty.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(ty)
    }
    builder.finish()
}

fn instance_base_name(ctx: SpecializeCtx, original_name: string, bindings: Vec[TypeBinding]) -> string {
    if bindings.is_empty() {
        original_name
    } else {
        match find_function(ctx, original_name) {
            Some(function) => match trait_instance_name(ctx, function, bindings) {
                Some(name) => name,
                None => {
                    let builder = std::text::StringBuilder::new();
                    builder.write_string(original_name);
                    for binding in sorted_bindings(bindings) {
                        if binding.name.starts_with("projection#") {} else {
                            builder.write_string("__");
                            builder.write_string(binding.name);
                            builder.write_char('_');
                            builder.write_string(compact_type(binding.ty))
                        }
                    }
                    builder.finish()
                },
            },
            None => original_name,
        }
    }
}

fn unique_instance_name(ctx: SpecializeCtx, base: string) -> string {
    if ctx.used_names.insert(base) {
        base
    } else {
        let mut index = 1;
        let mut candidate = base + "__mono1";
        while name_is_used(ctx, candidate) {
            index += 1;
            candidate = f"{base}__mono{index}";
        }
        let _ = ctx.used_names.insert(candidate);
        candidate
    }
}

fn ensure_instance(ctx: SpecializeCtx, original_name: string, bindings: Vec[TypeBinding]) -> string {
    match find_instance(ctx, original_name, bindings) {
        Some(instance) => instance.name,
        None => {
            if let Some(message) = recursive_specialization_message(ctx, original_name, bindings) {
                ctx.error.set(Option::Some(message));
                return original_name
            }
            let base = instance_base_name(ctx, original_name, bindings);
            let name = if bindings.is_empty() {
                base
            } else {
                unique_instance_name(ctx, base)
            };
            let instance = Instance {
                original_name,
                name,
                bindings,
                parent: ctx.active.get().map(
                    |active| instance_lookup_key(active.original_name, active.bindings),
                ),
            };
            ctx.instances.push(instance);
            ctx.instance_index.set(
                instance_lookup_key(instance.original_name, instance.bindings),
                instance,
            );
            ctx.work.push(instance);
            instance.name
        },
    }
}

fn mono_type_text(value: core::Type) -> string {
    let builder = std::text::StringBuilder::new();
    core::write_type(builder, value);
    builder.finish()
}

fn mono_types_equal(left: core::Type, right: core::Type) -> bool {
    compact_type(left) == compact_type(right)
}

fn mono_type_contains_proper_subterm(value: core::Type, expected: core::Type) -> bool {
    match core::resolve_type(value) {
        External { import_path: _, name: _, args: values } => {
            for value in values {
                if mono_types_equal(value, expected)
                    || mono_type_contains_proper_subterm(value, expected) {
                    return true
                }
            }
            false
        },
        Tuple { items: values } => {
            for value in values {
                if mono_types_equal(value, expected)
                    || mono_type_contains_proper_subterm(value, expected) {
                    return true
                }
            }
            false
        },
        App { ty: base, args } => {
            if mono_types_equal(base, expected) || mono_type_contains_proper_subterm(base, expected) {
                return true
            }
            for arg in args {
                if mono_types_equal(arg, expected)
                    || mono_type_contains_proper_subterm(arg, expected) {
                    return true
                }
            }
            false
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => {
            mono_types_equal(elem, expected) || mono_type_contains_proper_subterm(elem, expected)
        },
        HashMap { key, value } => {
            mono_types_equal(key, expected) || mono_type_contains_proper_subterm(key, expected)
                || mono_types_equal(value, expected)
                || mono_type_contains_proper_subterm(value, expected)
        },
        GoMap { key, value } => {
            mono_types_equal(key, expected) || mono_type_contains_proper_subterm(key, expected)
                || mono_types_equal(value, expected)
                || mono_type_contains_proper_subterm(value, expected)
        },
        Func { params, ret_ty } => {
            if mono_types_equal(ret_ty, expected)
                || mono_type_contains_proper_subterm(ret_ty, expected) {
                return true
            }
            for param in params {
                if mono_types_equal(param, expected)
                    || mono_type_contains_proper_subterm(param, expected) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn mono_type_outer_constructor_matches(left: core::Type, right: core::Type) -> bool {
    match (core::resolve_type(left), core::resolve_type(right)) {
        (
            External { import_path: a, name: n, args: _ },
            External { import_path: b, name: m, args: _ },
        ) => a == b && n == m,
        (Tuple { items: _ }, Tuple { items: _ }) | (
            Array { len: _, elem: _ },
            Array { len: _, elem: _ },
        ) | (Slice { elem: _ }, Slice { elem: _ }) | (MutSlice { elem: _ }, MutSlice { elem: _ }) | (
            VecType { elem: _ },
            VecType { elem: _ },
        ) | (RefType { elem: _ }, RefType { elem: _ }) | (
            GoPointer { elem: _ },
            GoPointer { elem: _ },
        ) | (GoFunction { signature: _ }, GoFunction { signature: _ }) | (
            Channel { elem: _, direction: _ },
            Channel { elem: _, direction: _ },
        ) | (HashMap { key: _, value: _ }, HashMap { key: _, value: _ }) | (
            Func { params: _, ret_ty: _ },
            Func { params: _, ret_ty: _ },
        ) => true,
        (Tuple { items: _ }, Tuple { items: _ }) | (
            Array { len: _, elem: _ },
            Array { len: _, elem: _ },
        ) | (Slice { elem: _ }, Slice { elem: _ }) | (MutSlice { elem: _ }, MutSlice { elem: _ }) | (
            VecType { elem: _ },
            VecType { elem: _ },
        ) | (RefType { elem: _ }, RefType { elem: _ }) | (
            GoPointer { elem: _ },
            GoPointer { elem: _ },
        ) | (GoFunction { signature: _ }, GoFunction { signature: _ }) | (
            Channel { elem: _, direction: _ },
            Channel { elem: _, direction: _ },
        ) | (GoMap { key: _, value: _ }, GoMap { key: _, value: _ }) | (
            Func { params: _, ret_ty: _ },
            Func { params: _, ret_ty: _ },
        ) => true,
        (App { ty: left, args: _ }, App { ty: right, args: _ }) => {
            mono_types_equal(left, right)
        },
        _ => false,
    }
}

fn mono_type_contains_recursive_growth(value: core::Type, previous: core::Type) -> bool {
    mono_type_outer_constructor_matches(value, previous)
        && mono_type_contains_proper_subterm(value, previous)
}

fn projection_binding(value: TypeBinding) -> bool {
    value.name.starts_with("projection#")
}

fn specialization_growth_message(
    ctx: SpecializeCtx,
    name: string,
    previous: Vec[TypeBinding],
    next: Vec[TypeBinding],
) -> Option[string] {
    match find_function(ctx, name) {
        Some(function) => {
            for generic in function.generics {
                if let (Some(old_ty), Some(new_ty)) = (
                    find_binding(previous, generic),
                    find_binding(next, generic),
                ) {
                    if mono_type_contains_recursive_growth(new_ty, old_ty) {
                        return Option::Some(
                            "Infinite monomorphization detected for generic function " + name
                                + ": recursive specialization grows type parameter "
                                + generic
                                + " from "
                                + mono_type_text(old_ty)
                                + " to "
                                + mono_type_text(new_ty),
                        )
                    }
                }
            }
            for new_binding in next {
                if projection_binding(new_binding) {} else {
                    for old_binding in previous {
                        if !projection_binding(old_binding)
                            && mono_type_contains_recursive_growth(new_binding.ty, old_binding.ty) {
                            return Option::Some(
                                "Infinite monomorphization detected for generic function " + name
                                    + ": recursive specialization grows type parameter "
                                    + new_binding.name
                                    + " from "
                                    + mono_type_text(old_binding.ty)
                                    + " to "
                                    + mono_type_text(new_binding.ty),
                            )
                        }
                    }
                }
            }
            Option::None
        },
        None => Option::None,
    }
}

fn recursive_specialization_message(ctx: SpecializeCtx, name: string, bindings: Vec[TypeBinding]) -> Option[
    string,
] {
    recursive_specialization_from(ctx, name, bindings, ctx.active.get())
}

fn recursive_specialization_from(
    ctx: SpecializeCtx,
    name: string,
    bindings: Vec[TypeBinding],
    cursor: Option[Instance],
) -> Option[string] {
    match cursor {
        Some(instance) => {
            let current = if instance.original_name == name {
                specialization_growth_message(ctx, name, instance.bindings, bindings)
            } else {
                Option::None
            };
            match current {
                Some(message) => Option::Some(message),
                None => match instance.parent {
                    Some(parent) => recursive_specialization_from(
                        ctx,
                        name,
                        bindings,
                        ctx.instance_index[parent],
                    ),
                    None => Option::None,
                },
            }
        },
        None => Option::None,
    }
}

fn copy_bindings(values: Vec[TypeBinding]) -> Vec[TypeBinding] {
    let result: Vec[TypeBinding] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn trait_ref_key(value: core::TraitRef) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(value.name);
    for arg in value.args {
        builder.write_char('#');
        builder.write_string(compact_type(arg))
    }
    builder.finish()
}

fn trait_selection_key(value: TraitSelection) -> string {
    let builder = std::text::StringBuilder::new();
    builder.write_string(trait_ref_key(value.reference));
    for associated in value.associated_types {
        builder.write_char('#');
        builder.write_string(associated.0);
        builder.write_char('=');
        builder.write_string(compact_type(associated.1))
    }
    builder.finish()
}

fn matching_trait_selections(
    ctx: SpecializeCtx,
    for_ty: core::Type,
    reference: core::TraitRef,
    bindings: Vec[TypeBinding],
) -> Vec[TraitSelection] {
    let selections: Vec[TraitSelection] = Vec::new();
    let keys: collections::HashSet[string] = collections::HashSet::new();
    for function in indexed_functions(ctx.trait_function_index, reference.name) {
        if let Some(metadata) = function.trait_impl {
            if metadata.trait_ref.name == reference.name
                && metadata.trait_ref.args.len() == reference.args.len() {
                let impl_bindings: Vec[TypeBinding] = Vec::new();
                if unify_type(metadata.for_ty, for_ty, impl_bindings) {
                    let candidate = substitute_trait_ref(metadata.trait_ref, impl_bindings);
                    let candidate_matches = if types_are_concrete(reference.args) {
                        unify_types(candidate.args, reference.args, impl_bindings)
                    } else {
                        true
                    };
                    if candidate_matches
                        && complete_bindings_up_to(
                            ctx,
                            function,
                            impl_bindings,
                            metadata.generic_count,
                            metadata.predicate_count,
                        ) {
                        let application = substitute_trait_ref(metadata.trait_ref, impl_bindings);
                        let trial = copy_bindings(bindings);
                        if unify_types(reference.args, application.args, trial) {
                            let selection = TraitSelection {
                                reference: application,
                                associated_types: substitute_named_types(
                                    metadata.associated_types,
                                    impl_bindings,
                                ),
                            };
                            let key = trait_selection_key(selection);
                            if !keys.insert(key) {} else {
                                selections.push(selection)
                            }
                        }
                    }
                }
            }
        }
    }
    selections
}

fn active_types_with(values: Vec[string], value: string) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for item in values {
        result.push(item)
    }
    result.push(value);
    result
}

fn normalize_types(ctx: SpecializeCtx, values: Vec[core::Type], active: Vec[string]) -> Vec[
    core::Type,
] {
    let result: Vec[core::Type] = Vec::new();
    for value in values {
        result.push(normalize_type(ctx, value, active))
    }
    result
}

fn normalize_trait_ref(ctx: SpecializeCtx, value: core::TraitRef, active: Vec[string]) -> core::TraitRef {
    core::TraitRef { name: value.name, args: normalize_types(ctx, value.args, active) }
}

fn normalize_optional_trait_ref(
    ctx: SpecializeCtx,
    value: Option[core::TraitRef],
    active: Vec[string],
) -> Option[core::TraitRef] {
    match value {
        Some(reference) => {
            Option::Some(normalize_trait_ref(ctx, reference, active))
        },
        None => Option::None,
    }
}

fn matching_projection_types(
    ctx: SpecializeCtx,
    base: core::Type,
    name: string,
    reference: core::TraitRef,
) -> Vec[core::Type] {
    let result: Vec[core::Type] = Vec::new();
    let keys: collections::HashSet[string] = collections::HashSet::new();
    for function in indexed_functions(ctx.trait_function_index, reference.name) {
        if let Some(metadata) = function.trait_impl {
            if metadata.trait_ref.name == reference.name
                && metadata.trait_ref.args.len() == reference.args.len() {
                let bindings: Vec[TypeBinding] = Vec::new();
                if unify_type(metadata.for_ty, base, bindings)
                    && unify_types(metadata.trait_ref.args, reference.args, bindings)
                    && complete_bindings_up_to(
                        ctx,
                        function,
                        bindings,
                        metadata.generic_count,
                        metadata.predicate_count,
                    ) {
                    for associated in metadata.associated_types {
                        if associated.0 == name {
                            let value = substitute_type(associated.1, bindings);
                            let key = compact_type(value);
                            if !keys.insert(key) {} else {
                                result.push(value)
                            }
                        }
                    }
                }
            }
        }
    }
    result
}

fn normalize_projection(
    ctx: SpecializeCtx,
    base: core::Type,
    name: string,
    reference: Option[core::TraitRef],
    active: Vec[string],
) -> core::Type {
    let projection = core::Type::Projection { for_ty: base, name, trait_ref: reference };
    let key = projection_binding_name(base, name, reference);
    if active.contains(key) {
        projection
    } else {
        let normalized = match core::builtin_projection(base, name, reference) {
            Some(value) => Option::Some(value),
            None => match reference {
                Some(reference) => {
                    if type_is_concrete(base) && types_are_concrete(reference.args) {
                        let values = matching_projection_types(ctx, base, name, reference);
                        if values.len() == 1 {
                            Option::Some(values[0])
                        } else {
                            Option::None
                        }
                    } else {
                        Option::None
                    }
                },
                None => Option::None,
            },
        };
        match normalized {
            Some(value) => {
                normalize_type(ctx, value, active_types_with(active, key))
            },
            None => projection,
        }
    }
}

fn normalize_type(ctx: SpecializeCtx, value: core::Type, active: Vec[string]) -> core::Type {
    match core::resolve_type(value) {
        Unit => core::Type::Unit,
        Never => core::Type::Never,
        Bool => core::Type::Bool,
        Int => core::Type::Int,
        Int8 => core::Type::Int8,
        Int16 => core::Type::Int16,
        Int32 => core::Type::Int32,
        Int64 => core::Type::Int64,
        Uint => core::Type::Uint,
        Uint8 => core::Type::Uint8,
        Uint16 => core::Type::Uint16,
        Uint32 => core::Type::Uint32,
        Uint64 => core::Type::Uint64,
        Float32 => core::Type::Float32,
        Float64 => core::Type::Float64,
        String => core::Type::String,
        Char => core::Type::Char,
        Tuple { items } => {
            core::Type::Tuple { items: normalize_types(ctx, items, active) }
        },
        External { import_path, name, args } => core::Type::External {
            import_path,
            name,
            args: normalize_types(ctx, args, active),
        },
        Con { name } => core::Type::Con { name },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let normalized_associated: Vec[(string, core::Type)] = Vec::new();
            for binding in associated_types {
                normalized_associated.push((binding.0, normalize_type(ctx, binding.1, active)))
            }
            let normalized_additional: Vec[core::DynTraitBound] = Vec::new();
            for bound in additional_bounds {
                let bound_associated: Vec[(string, core::Type)] = Vec::new();
                for binding in bound.associated_types {
                    bound_associated.push((binding.0, normalize_type(ctx, binding.1, active)))
                }
                normalized_additional.push(
                    core::DynTraitBound {
                        trait_name: bound.trait_name,
                        args: normalize_types(ctx, bound.args, active),
                        associated_types: bound_associated,
                    },
                )
            }
            core::Type::Dyn {
                trait_name,
                args: normalize_types(ctx, args, active),
                associated_types: normalized_associated,
                additional_bounds: normalized_additional,
            }
        },
        Projection { for_ty: base, name, trait_ref: reference } => {
            let base = normalize_type(ctx, base, active);
            let reference = normalize_optional_trait_ref(ctx, reference, active);
            normalize_projection(ctx, base, name, reference, active)
        },
        App { ty: base, args } => core::Type::App {
            ty: normalize_type(ctx, base, active),
            args: normalize_types(ctx, args, active),
        },
        Array { len: length, elem } => {
            core::Type::Array { len: length, elem: normalize_type(ctx, elem, active) }
        },
        Slice { elem } => {
            core::Type::Slice { elem: normalize_type(ctx, elem, active) }
        },
        MutSlice { elem } => {
            core::Type::MutSlice { elem: normalize_type(ctx, elem, active) }
        },
        VecType { elem } => {
            core::Type::VecType { elem: normalize_type(ctx, elem, active) }
        },
        GoPointer { elem } => {
            core::Type::GoPointer { elem: normalize_type(ctx, elem, active) }
        },
        GoFunction { signature } => {
            core::Type::GoFunction { signature: normalize_type(ctx, signature, active) }
        },
        RefType { elem } => {
            core::Type::RefType { elem: normalize_type(ctx, elem, active) }
        },
        Channel { elem, direction } => {
            core::Type::Channel { elem: normalize_type(ctx, elem, active), direction }
        },
        HashMap { key, value } => core::Type::HashMap {
            key: normalize_type(ctx, key, active),
            value: normalize_type(ctx, value, active),
        },
        GoMap { key, value } => core::Type::GoMap {
            key: normalize_type(ctx, key, active),
            value: normalize_type(ctx, value, active),
        },
        Param { name } => core::Type::Param { name },
        Func { params, ret_ty } => core::Type::Func {
            params: normalize_types(ctx, params, active),
            ret_ty: normalize_type(ctx, ret_ty, active),
        },
        Error => core::Type::Error,
    }
}

fn types_contain_associated_projection(values: Vec[core::Type]) -> bool {
    for value in values {
        if type_contains_associated_projection(value) {
            return true
        }
    }
    false
}

fn type_contains_associated_projection(value: core::Type) -> bool {
    match value {
        Projection { for_ty: _, name: _, trait_ref: _ } => true,
        External { import_path: _, name: _, args } => types_contain_associated_projection(args),
        Tuple { items } => types_contain_associated_projection(items),
        App { ty: base, args } => {
            type_contains_associated_projection(base) || types_contain_associated_projection(args)
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => type_contains_associated_projection(
            elem,
        ),
        HashMap { key, value } => {
            type_contains_associated_projection(key) || type_contains_associated_projection(value)
        },
        GoMap { key, value } => {
            type_contains_associated_projection(key) || type_contains_associated_projection(value)
        },
        Func { params, ret_ty } => {
            types_contain_associated_projection(params)
                || type_contains_associated_projection(ret_ty)
        },
        Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Con {
            name: _,
        } | Dyn { trait_name: _, .. } | Param { name: _ } | Error => false,
    }
}

fn specialize_type(ctx: SpecializeCtx, value: core::Type, bindings: Vec[TypeBinding]) -> core::Type {
    let specialized = substitute_type(value, bindings);
    if type_contains_associated_projection(specialized) {
        normalize_type(ctx, specialized, Vec::new())
    } else {
        specialized
    }
}

fn specialize_trait_ref(ctx: SpecializeCtx, value: core::TraitRef, bindings: Vec[TypeBinding]) -> core::TraitRef {
    normalize_trait_ref(ctx, substitute_trait_ref(value, bindings), Vec::new())
}

fn specialize_named_types(
    ctx: SpecializeCtx,
    values: Vec[(string, core::Type)],
    bindings: Vec[TypeBinding],
) -> Vec[(string, core::Type)] {
    let result: Vec[(string, core::Type)] = Vec::new();
    for value in values {
        result.push((value.0, specialize_type(ctx, value.1, bindings)))
    }
    result
}

fn complete_function_bindings_up_to(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
    generic_count: isize,
    predicate_count: isize,
) -> () {
    for _ in 0..generic_count + 1 {
        let previous_len = bindings.len();
        for index in 0..predicate_count {
            let predicate = value.predicates[index];
            match predicate {
                Trait { for_ty, trait_ref: reference } => {
                    let for_ty = substitute_type(for_ty, bindings);
                    if type_is_concrete(for_ty) {
                        let reference = substitute_trait_ref(reference, bindings);
                        let selections = matching_trait_selections(ctx, for_ty, reference, bindings);
                        if selections.len() == 1 {
                            let selection = selections[0];
                            unify_types(reference.args, selection.reference.args, bindings);
                            for associated in selection.associated_types {
                                bind_type(
                                    bindings,
                                    projection_binding_name(
                                        for_ty,
                                        associated.0,
                                        Option::Some(selection.reference),
                                    ),
                                    associated.1,
                                );
                                bind_type(
                                    bindings,
                                    projection_binding_name(for_ty, associated.0, Option::None),
                                    associated.1,
                                );
                            }
                        }
                    }
                },
                GoComparable(_) => (),
                Equality { lhs, rhs } => {
                    let lhs = substitute_type(lhs, bindings);
                    let rhs = substitute_type(rhs, bindings);
                    if unify_type(lhs, rhs, bindings) {} else {
                        unify_type(rhs, lhs, bindings);
                    }
                },
            }
        }
        if bindings.len() == previous_len {
            break
        }
    }
}

fn predicates_are_satisfied_up_to(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
    predicate_count: isize,
) -> bool {
    for index in 0..predicate_count {
        let predicate = value.predicates[index];
        match predicate {
            GoComparable(ty) => {
                let ty = substitute_type(ty, bindings);
                if !type_is_concrete(ty)
                    || tast::go_map_key_definitely_uncomparable(core::type_to_tast(ty)) {
                    return false
                }
            },
            Trait { for_ty, trait_ref: reference } => {
                let for_ty = substitute_type(for_ty, bindings);
                let reference = substitute_trait_ref(reference, bindings);
                if type_is_concrete(for_ty)
                    && (builtin_trait_satisfied(ctx.builtin, for_ty, reference)
                        || matching_trait_selections(ctx, for_ty, reference, bindings).len() == 1) {} else {
                    return false
                }
            },
            Equality { lhs, rhs } => {
                let lhs = substitute_type(lhs, bindings);
                let rhs = substitute_type(rhs, bindings);
                if compact_type(lhs) == compact_type(rhs) {} else {
                    return false
                }
            },
        }
    }
    true
}

fn builtin_scalar_type(value: core::Type) -> bool {
    match core::resolve_type(value) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        _ => false,
    }
}

fn builtin_total_scalar_type(value: core::Type) -> bool {
    match core::resolve_type(value) {
        Unit | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | String | Char => true,
        _ => false,
    }
}

fn builtin_structural_trait_satisfied(
    builtin: tast::BuiltinContract,
    for_ty: core::Type,
    reference: core::TraitRef,
) -> bool {
    match core::resolve_type(for_ty) {
        GoPointer { elem: _ } => false,
        GoFunction { signature: _ } => false,
        RefType { elem: _ } => true,
        Tuple { items } => {
            for item in items {
                if !builtin_trait_satisfied(builtin, item, reference) {
                    return false
                }
            }
            true
        },
        Array { len: _, elem } => builtin_trait_satisfied(builtin, elem, reference),
        _ => false,
    }
}

fn builtin_trait_satisfied(
    builtin: tast::BuiltinContract,
    for_ty: core::Type,
    reference: core::TraitRef,
) -> bool {
    reference.args.is_empty()
        && match core::resolve_type(for_ty) {
            Dyn { trait_name: name, .. } => reference.name == name,
            other => if core::builtin_trait_satisfied(other, reference) {
                true
            } else if mono_names_match(reference.name, builtin.to_string.name)
                || mono_names_match(reference.name, builtin.debug.name) {
                builtin_scalar_type(other)
            } else if mono_names_match(reference.name, builtin.partial_eq.name) {
                builtin_scalar_type(other)
                    || builtin_structural_trait_satisfied(builtin, other, reference)
            } else if mono_names_match(reference.name, builtin.eq.name)
                || mono_names_match(reference.name, builtin.hash.name)
                || mono_names_match(reference.name, builtin.ordering.ord) {
                builtin_total_scalar_type(other)
                    || builtin_structural_trait_satisfied(builtin, other, reference)
            } else if mono_names_match(reference.name, builtin.ordering.partial_ord) {
                builtin_scalar_type(other)
                    || builtin_structural_trait_satisfied(builtin, other, reference)
            } else if mono_names_match(reference.name, builtin.default.name) {
                builtin_scalar_type(other)
                    || builtin_structural_trait_satisfied(builtin, other, reference)
            } else {
                false
            },
        }
}

fn complete_bindings_up_to(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
    generic_count: isize,
    predicate_count: isize,
) -> bool {
    complete_function_bindings_up_to(ctx, value, bindings, generic_count, predicate_count);
    for index in 0..generic_count {
        let generic = value.generics[index];
        match find_binding(bindings, generic) {
            Some(ty) => if type_is_concrete(ty) {} else {
                return false
            },
            None => return false,
        }
    }
    predicates_are_satisfied_up_to(ctx, value, bindings, predicate_count)
}

fn complete_bindings(ctx: SpecializeCtx, value: core::Function, bindings: Vec[TypeBinding]) -> bool {
    complete_bindings_up_to(ctx, value, bindings, value.generics.len(), value.predicates.len())
}

fn incomplete_function_message(
    ctx: SpecializeCtx,
    value: core::Function,
    bindings: Vec[TypeBinding],
) -> string {
    for predicate in value.predicates {
        match predicate {
            GoComparable(ty) => {
                let ty = substitute_type(ty, bindings);
                if !type_is_concrete(ty)
                    || tast::go_map_key_definitely_uncomparable(core::type_to_tast(ty)) {
                    return "cannot specialize " + value.name + ": Go map key is not comparable: "
                        + compact_type(ty)
                }
            },
            Trait { for_ty, trait_ref: reference } => {
                let for_ty = substitute_type(for_ty, bindings);
                let reference = substitute_trait_ref(reference, bindings);
                if type_is_concrete(for_ty)
                    && (builtin_trait_satisfied(ctx.builtin, for_ty, reference)
                        || matching_trait_selections(ctx, for_ty, reference, bindings).len() == 1) {} else {
                    return "cannot specialize " + value.name + ": " + compact_type(for_ty)
                        + " does not satisfy "
                        + trait_ref_key(reference)
                }
            },
            Equality { lhs, rhs } => {
                let lhs = substitute_type(lhs, bindings);
                let rhs = substitute_type(rhs, bindings);
                if compact_type(lhs) == compact_type(rhs) {} else {
                    return "cannot specialize " + value.name + ": " + compact_type(lhs)
                        + " does not equal "
                        + compact_type(rhs)
                }
            },
        }
    }
    "cannot specialize " + value.name + ": incomplete generic bindings"
}

fn specialize_callable(ctx: SpecializeCtx, value: core::Callable, bindings: Vec[TypeBinding]) -> core::Callable {
    match value {
        Function(name) => core::Callable::Function(name),
        LangItem { item, function_name } => core::Callable::LangItem { item, function_name },
        Runtime(name) => core::Callable::Runtime(name),
        Intrinsic(name) => core::Callable::Intrinsic(name),
        GoInterfaceBridge { binding, methods } => core::Callable::GoInterfaceBridge {
            binding,
            methods,
        },
        GoMethod { symbol, binding } => core::Callable::GoMethod { symbol, binding },
        GoForeign { import_path, symbol, binding } => {
            core::Callable::GoForeign { import_path, symbol, binding }
        },
        TraitMethod { trait_ref: reference, method_name: name, for_ty, has_receiver } => {
            core::Callable::TraitMethod {
                trait_ref: specialize_trait_ref(ctx, reference, bindings),
                method_name: name,
                for_ty: specialize_type(ctx, for_ty, bindings),
                has_receiver,
            }
        },
        DynTraitMethod { trait_name: owner, dispatch_name: dispatch, method_name: name } => {
            core::Callable::DynTraitMethod {
                trait_name: owner,
                dispatch_name: dispatch,
                method_name: name,
            }
        },
        InherentMethod { receiver_ty: owner, method_name: name } => {
            core::Callable::InherentMethod {
                receiver_ty: specialize_type(ctx, owner, bindings),
                method_name: name,
            }
        },
    }
}

fn specialize_function_callable(
    ctx: SpecializeCtx,
    function: core::Function,
    name: string,
    ty: core::Type,
    allow_projection_bindings: bool,
) -> core::Expr {
    if function_is_generic(function) {
        if type_is_concrete(ty) {
            let call_bindings: Vec[TypeBinding] = Vec::new();
            if unify_type(function_type(function), ty, call_bindings)
                && (allow_projection_bindings || !has_projection_binding(call_bindings))
                && complete_bindings(ctx, function, call_bindings) {
                core::Expr::Callable {
                    callable: core::Callable::Function(
                        ensure_instance(ctx, function.name, call_bindings),
                    ),
                    ty,
                }
            } else {
                if allow_projection_bindings && unify_type(function_type(function), ty, Vec::new()) {
                    ctx.error.set(
                        Option::Some(incomplete_function_message(ctx, function, call_bindings)),
                    )
                }
                core::Expr::Callable { callable: core::Callable::Function(name), ty }
            }
        } else {
            core::Expr::Callable { callable: core::Callable::Function(name), ty }
        }
    } else {
        core::Expr::Callable {
            callable: core::Callable::Function(ensure_instance(ctx, function.name, Vec::new())),
            ty,
        }
    }
}

fn specialize_closure_params(
    ctx: SpecializeCtx,
    values: Vec[core::ClosureParam],
    bindings: Vec[TypeBinding],
) -> Vec[core::ClosureParam] {
    let result: Vec[core::ClosureParam] = Vec::new();
    for value in values {
        result.push(
            core::ClosureParam { name: value.name, ty: specialize_type(ctx, value.ty, bindings) },
        )
    }
    result
}

fn specialize_exprs(ctx: SpecializeCtx, bindings: Vec[TypeBinding], values: Vec[core::Expr]) -> Vec[
    core::Expr,
] {
    let result: Vec[core::Expr] = Vec::new();
    for value in values {
        result.push(specialize_expr(ctx, bindings, value))
    }
    result
}

fn specialize_optional_expr(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    value: Option[core::Expr],
) -> Option[core::Expr] {
    value.map(|expr| specialize_expr(ctx, bindings, expr))
}

fn specialize_arms(ctx: SpecializeCtx, bindings: Vec[TypeBinding], values: Vec[core::Arm]) -> Vec[
    core::Arm,
] {
    let result: Vec[core::Arm] = Vec::new();
    for value in values {
        result.push(
            core::Arm {
                lhs: specialize_expr(ctx, bindings, value.lhs),
                body: specialize_expr(ctx, bindings, value.body),
            },
        )
    }
    result
}

fn specialize_select_arms(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    values: Vec[core::SelectArm],
) -> Vec[core::SelectArm] {
    let result: Vec[core::SelectArm] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            match value {
                Receive { channel, guard, binding, binding_ty, body } => core::SelectArm::Receive {
                    channel: specialize_expr(ctx, bindings, channel),
                    guard: specialize_optional_expr(ctx, bindings, guard),
                    binding,
                    binding_ty: specialize_type(ctx, binding_ty, bindings),
                    body: specialize_expr(ctx, bindings, body),
                },
                Send { channel, value, guard, body } => core::SelectArm::Send {
                    channel: specialize_expr(ctx, bindings, channel),
                    value: specialize_expr(ctx, bindings, value),
                    guard: specialize_optional_expr(ctx, bindings, guard),
                    body: specialize_expr(ctx, bindings, body),
                },
            },
        )
    }
    result
}

fn specialize_block(ctx: SpecializeCtx, bindings: Vec[TypeBinding], value: core::Block) -> core::Block {
    let stmts: Vec[core::LetStmt] = Vec::new();
    for stmt in value.stmts {
        stmts.push(
            core::LetStmt {
                name: stmt.name,
                value: specialize_expr(ctx, bindings, stmt.value),
                ty: specialize_type(ctx, stmt.ty, bindings),
            },
        )
    }
    core::Block { stmts, tail: specialize_optional_expr(ctx, bindings, value.tail) }
}

fn trait_method_bindings(
    function: core::Function,
    reference: core::TraitRef,
    for_ty: core::Type,
    actual_types: Vec[core::Type],
    ret_ty: core::Type,
) -> Option[Vec[TypeBinding]] {
    let bindings: Vec[TypeBinding] = Vec::new();
    let metadata = function.trait_impl?;
    if metadata.trait_ref.args.len() != reference.args.len()
        || !unify_type(metadata.for_ty, for_ty, bindings)
        || !unify_types(metadata.trait_ref.args, reference.args, bindings) {
        return Option::None
    }
    let param_types: Vec[core::Type] = Vec::new();
    for param in function.params {
        param_types.push(param.1)
    }
    if unify_types(param_types, actual_types, bindings)
        && unify_type(function.ret_ty, ret_ty, bindings) {
        Option::Some(bindings)
    } else {
        Option::None
    }
}

fn ensure_trait_method_instance(
    ctx: SpecializeCtx,
    reference: core::TraitRef,
    method_name: string,
    for_ty: core::Type,
    actual_types: Vec[core::Type],
    ret_ty: core::Type,
) -> (core::TraitRef, Option[string]) {
    register_structural_trait_function(ctx, reference, method_name, for_ty, ret_ty);
    let mut resolved = reference;
    let mut instance_name: Option[string] = Option::None;
    for function in indexed_functions(
        ctx.trait_method_index,
        lookup_pair_key(reference.name, method_name),
    ) {
        if let Some(bindings) = trait_method_bindings(
            function,
            reference,
            for_ty,
            actual_types,
            ret_ty,
        ) {
            if complete_bindings(ctx, function, bindings) {
                let base_name = trait_instance_name(ctx, function, bindings);
                let name = ensure_instance(ctx, function.name, bindings);
                if let Some(base) = base_name {
                    if base != name {
                        instance_name = Option::Some(name);
                    }
                }
                resolved = specialize_trait_ref(ctx, reference, bindings);
            }
        }
    };
    (resolved, instance_name)
}

fn ensure_trait_call_instance(
    ctx: SpecializeCtx,
    reference: core::TraitRef,
    method_name: string,
    for_ty: core::Type,
    actual_types: Vec[core::Type],
    ret_ty: core::Type,
) -> (core::TraitRef, Option[string]) {
    ensure_trait_method_instance(ctx, reference, method_name, for_ty, actual_types, ret_ty)
}

fn ensure_dyn_trait_impls(ctx: SpecializeCtx, trait_name: string, for_ty: core::Type) -> () {
    for function in indexed_functions(ctx.trait_function_index, trait_name) {
        if let Some(metadata) = function.trait_impl {
            let bindings: Vec[TypeBinding] = Vec::new();
            if unify_type(metadata.for_ty, for_ty, bindings)
                && complete_bindings(ctx, function, bindings) {
                ensure_instance(ctx, function.name, bindings);
            }
        }
    }
}

fn specialize_found_var_with_projection_bindings(
    ctx: SpecializeCtx,
    function: core::Function,
    name: string,
    ty: core::Type,
    allow_projection_bindings: bool,
) -> core::Expr {
    if function_is_generic(function) {
        if type_is_concrete(ty) {
            let call_bindings: Vec[TypeBinding] = Vec::new();
            if unify_type(function_type(function), ty, call_bindings)
                && (allow_projection_bindings || !has_projection_binding(call_bindings))
                && complete_bindings(ctx, function, call_bindings) {
                core::Expr::Var { name: ensure_instance(ctx, function.name, call_bindings), ty }
            } else {
                if allow_projection_bindings && unify_type(function_type(function), ty, Vec::new()) {
                    ctx.error.set(
                        Option::Some(incomplete_function_message(ctx, function, call_bindings)),
                    )
                }
                core::Expr::Var { name, ty }
            }
        } else {
            core::Expr::Var { name, ty }
        }
    } else {
        core::Expr::Var { name: ensure_instance(ctx, function.name, Vec::new()), ty }
    }
}

fn specialize_found_var(ctx: SpecializeCtx, function: core::Function, name: string, ty: core::Type) -> core::Expr {
    specialize_found_var_with_projection_bindings(ctx, function, name, ty, false)
}

fn specialize_call_var(ctx: SpecializeCtx, function: core::Function, name: string, ty: core::Type) -> core::Expr {
    specialize_found_var_with_projection_bindings(ctx, function, name, ty, true)
}

fn specialize_var(ctx: SpecializeCtx, bindings: Vec[TypeBinding], name: string, ty: core::Type) -> core::Expr {
    let ty = specialize_type(ctx, ty, bindings);
    match find_function(ctx, name) {
        Some(function) => specialize_found_var(ctx, function, name, ty),
        None => core::Expr::Var { name, ty },
    }
}

fn specialize_call(
    ctx: SpecializeCtx,
    bindings: Vec[TypeBinding],
    func: core::Expr,
    args: Vec[core::Expr],
    ty: core::Type,
) -> core::Expr {
    let func = specialize_expr(ctx, bindings, func);
    let args = specialize_exprs(ctx, bindings, args);
    let ty = specialize_type(ctx, ty, bindings);
    let func = match func {
        Var { name, ty: func_ty } => match find_callee_function(ctx, name) {
            Some(function) => if function_is_generic(function) {
                specialize_call_var(ctx, function, name, func_ty)
            } else {
                core::Expr::Var {
                    name: ensure_instance(ctx, function.name, Vec::new()),
                    ty: func_ty,
                }
            },
            None => core::Expr::Var { name, ty: func_ty },
        },
        Callable {
            callable: core::Callable::InherentMethod { receiver_ty: owner, method_name },
            ty: func_ty,
        } => match find_inherent_function(ctx, owner, method_name, func_ty) {
            Some(function) => if function_is_generic(function) {
                specialize_call_var(ctx, function, function.name, func_ty)
            } else {
                core::Expr::Var {
                    name: ensure_instance(ctx, function.name, Vec::new()),
                    ty: func_ty,
                }
            },
            None => core::Expr::Callable {
                callable: core::Callable::InherentMethod { receiver_ty: owner, method_name },
                ty: func_ty,
            },
        },
        Callable { callable: core::Callable::Function(name), ty: func_ty } => {
            match find_callee_function(ctx, name) {
                Some(function) => {
                    specialize_function_callable(ctx, function, name, func_ty, true)
                },
                None => core::Expr::Callable {
                    callable: core::Callable::Function(name),
                    ty: func_ty,
                },
            }
        },
        other => other,
    };
    core::Expr::Call { func, args, ty }
}

fn specialize_expr(ctx: SpecializeCtx, bindings: Vec[TypeBinding], value: core::Expr) -> core::Expr {
    match value {
        Var { name, ty } => specialize_var(ctx, bindings, name, ty),
        Callable { callable, ty } => {
            let ty = specialize_type(ctx, ty, bindings);
            match callable {
                core::Callable::Function(name) => match find_function(ctx, name) {
                    Some(function) => {
                        specialize_function_callable(ctx, function, name, ty, false)
                    },
                    None => core::Expr::Callable { callable: core::Callable::Function(name), ty },
                },
                other => core::Expr::Callable {
                    callable: specialize_callable(ctx, other, bindings),
                    ty,
                },
            }
        },
        Prim { value, ty } => {
            core::Expr::Prim { value, ty: specialize_type(ctx, ty, bindings) }
        },
        Constr { constructor, args, ty } => core::Expr::Constr {
            constructor,
            args: specialize_exprs(ctx, bindings, args),
            ty: specialize_type(ctx, ty, bindings),
        },
        Tuple { items, ty } => core::Expr::Tuple {
            items: specialize_exprs(ctx, bindings, items),
            ty: specialize_type(ctx, ty, bindings),
        },
        Array { items, ty } => core::Expr::Array {
            items: specialize_exprs(ctx, bindings, items),
            ty: specialize_type(ctx, ty, bindings),
        },
        Closure { params, body, ty } => core::Expr::Closure {
            params: specialize_closure_params(ctx, params, bindings),
            body: specialize_expr(ctx, bindings, body),
            ty: specialize_type(ctx, ty, bindings),
        },
        Block { block, ty } => core::Expr::Block {
            block: specialize_block(ctx, bindings, block),
            ty: specialize_type(ctx, ty, bindings),
        },
        Match { expr, arms, default, ty } => core::Expr::Match {
            expr: specialize_expr(ctx, bindings, expr),
            arms: specialize_arms(ctx, bindings, arms),
            default: specialize_optional_expr(ctx, bindings, default),
            ty: specialize_type(ctx, ty, bindings),
        },
        Select { mode, arms, default, ty } => core::Expr::Select {
            mode,
            arms: specialize_select_arms(ctx, bindings, arms),
            default: specialize_optional_expr(ctx, bindings, default),
            ty: specialize_type(ctx, ty, bindings),
        },
        If { cond, then_branch, else_branch, ty } => core::Expr::If {
            cond: specialize_expr(ctx, bindings, cond),
            then_branch: specialize_expr(ctx, bindings, then_branch),
            else_branch: specialize_expr(ctx, bindings, else_branch),
            ty: specialize_type(ctx, ty, bindings),
        },
        While { cond, body, ty } => core::Expr::While {
            cond: specialize_expr(ctx, bindings, cond),
            body: specialize_expr(ctx, bindings, body),
            ty: specialize_type(ctx, ty, bindings),
        },
        Loop { body, ty } => core::Expr::Loop {
            body: specialize_expr(ctx, bindings, body),
            ty: specialize_type(ctx, ty, bindings),
        },
        Break { target, value, ty } => core::Expr::Break {
            target,
            value: specialize_optional_expr(ctx, bindings, value),
            ty: specialize_type(ctx, ty, bindings),
        },
        Continue { target, ty } => {
            core::Expr::Continue { target, ty: specialize_type(ctx, ty, bindings) }
        },
        Return { expr, ty } => core::Expr::Return {
            expr: specialize_optional_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        Go { expr, ty } => core::Expr::Go {
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        ConstrGet { expr, constructor, field_index, ty } => {
            core::Expr::ConstrGet {
                expr: specialize_expr(ctx, bindings, expr),
                constructor,
                field_index,
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        Unary { op, expr, ty } => core::Expr::Unary {
            op,
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        Cast { expr, ty } => core::Expr::Cast {
            expr: specialize_expr(ctx, bindings, expr),
            ty: specialize_type(ctx, ty, bindings),
        },
        Binary { op, lhs, rhs, ty } => core::Expr::Binary {
            op,
            lhs: specialize_expr(ctx, bindings, lhs),
            rhs: specialize_expr(ctx, bindings, rhs),
            ty: specialize_type(ctx, ty, bindings),
        },
        Assign { name, value, target_ty, ty } => core::Expr::Assign {
            name,
            value: specialize_expr(ctx, bindings, value),
            target_ty: specialize_type(ctx, target_ty, bindings),
            ty: specialize_type(ctx, ty, bindings),
        },
        Call { func, args, ty } => {
            specialize_call(ctx, bindings, func, args, ty)
        },
        ToDyn { trait_name, for_ty, expr, ty } => {
            let for_ty = specialize_type(ctx, for_ty, bindings);
            ensure_dyn_trait_impls(ctx, trait_name, for_ty);
            core::Expr::ToDyn {
                trait_name,
                for_ty,
                expr: specialize_expr(ctx, bindings, expr),
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            core::Expr::DynCall {
                trait_name,
                method_name,
                receiver: specialize_expr(ctx, bindings, receiver),
                args: specialize_exprs(ctx, bindings, args),
                ty: specialize_type(ctx, ty, bindings),
            }
        },
        TraitCall {
            trait_ref: reference,
            method_name,
            instance_name: _,
            for_ty,
            receiver,
            args,
            ty,
        } => {
            let reference = specialize_trait_ref(ctx, reference, bindings);
            let for_ty = specialize_type(ctx, for_ty, bindings);
            let receiver = specialize_optional_expr(ctx, bindings, receiver);
            let args = specialize_exprs(ctx, bindings, args);
            let ty = specialize_type(ctx, ty, bindings);
            let actual_types: Vec[core::Type] = Vec::new();
            if let Some(value) = receiver {
                actual_types.push(core::expr_type(value))
            }
            for arg in args {
                actual_types.push(core::expr_type(arg))
            }
            let resolved = ensure_trait_call_instance(
                ctx,
                reference,
                method_name,
                for_ty,
                actual_types,
                ty,
            );
            core::Expr::TraitCall {
                trait_ref: resolved.0,
                method_name,
                instance_name: resolved.1,
                for_ty,
                receiver,
                args,
                ty,
            }
        },
        Proj { tuple, index, ty } => core::Expr::Proj {
            tuple: specialize_expr(ctx, bindings, tuple),
            index,
            ty: specialize_type(ctx, ty, bindings),
        },
    }
}

fn ensure_runtime_trait_impl(
    ctx: SpecializeCtx,
    trait_name: string,
    method_name: string,
    params: Vec[core::Type],
    ret_ty: core::Type,
) -> () {
    let _ = ensure_trait_method_instance(
        ctx,
        core::TraitRef { name: trait_name, args: Vec::new() },
        method_name,
        params[0],
        params,
        ret_ty,
    );
}

fn ensure_eq_hash_impls(ctx: SpecializeCtx, ty: core::Type) -> () {
    ensure_runtime_trait_impl(
        ctx,
        ctx.builtin.partial_eq.name,
        ctx.builtin.partial_eq.method,
        Vec::from_array([ty, ty]),
        core::Type::Bool,
    );
    ensure_runtime_trait_impl(
        ctx,
        ctx.builtin.hash.name,
        ctx.builtin.hash.method,
        Vec::from_array([ty]),
        core::Type::Uint64,
    )
}

fn ensure_runtime_trait_impls_for_types(ctx: SpecializeCtx, values: Vec[core::Type]) -> () {
    for value in values {
        ensure_runtime_trait_impls_for_type(ctx, value)
    }
}

fn ensure_runtime_trait_impls_for_type(ctx: SpecializeCtx, value: core::Type) -> () {
    match core::resolve_type(value) {
        External { import_path: _, name: _, args: items } => ensure_runtime_trait_impls_for_types(
            ctx,
            items,
        ),
        Tuple { items } => ensure_runtime_trait_impls_for_types(ctx, items),
        Projection { for_ty: base, name: _, trait_ref: reference } => {
            ensure_runtime_trait_impls_for_type(ctx, base);
            if let Some(reference) = reference {
                ensure_runtime_trait_impls_for_types(ctx, reference.args)
            }
        },
        App { ty: base, args } => {
            ensure_runtime_trait_impls_for_type(ctx, base);
            ensure_runtime_trait_impls_for_types(ctx, args)
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | Channel {
            elem,
            direction: _,
        } => ensure_runtime_trait_impls_for_type(ctx, elem),
        GoPointer { elem } => ensure_runtime_trait_impls_for_type(ctx, elem),
        GoFunction { signature } => ensure_runtime_trait_impls_for_type(ctx, signature),
        RefType { elem } => {
            ensure_eq_hash_impls(ctx, elem);
            ensure_runtime_trait_impls_for_type(ctx, elem)
        },
        HashMap { key, value } => {
            ensure_eq_hash_impls(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, value)
        },
        GoMap { key, value } => {
            ensure_eq_hash_impls(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, key);
            ensure_runtime_trait_impls_for_type(ctx, value)
        },
        Func { params, ret_ty } => {
            ensure_runtime_trait_impls_for_types(ctx, params);
            ensure_runtime_trait_impls_for_type(ctx, ret_ty)
        },
        _ => (),
    }
}

fn ensure_runtime_trait_impls_for_optional_expr(ctx: SpecializeCtx, value: Option[core::Expr]) -> () {
    if let Some(value) = value {
        ensure_runtime_trait_impls_for_expr(ctx, value)
    }
}

fn ensure_runtime_trait_impls_for_exprs(ctx: SpecializeCtx, values: Vec[core::Expr]) -> () {
    for value in values {
        ensure_runtime_trait_impls_for_expr(ctx, value)
    }
}

fn ensure_runtime_trait_impls_for_block(ctx: SpecializeCtx, value: core::Block) -> () {
    for stmt in value.stmts {
        ensure_runtime_trait_impls_for_type(ctx, stmt.ty);
        ensure_runtime_trait_impls_for_expr(ctx, stmt.value)
    }
    ensure_runtime_trait_impls_for_optional_expr(ctx, value.tail)
}

fn ensure_runtime_trait_impls_for_expr(ctx: SpecializeCtx, value: core::Expr) -> () {
    ensure_runtime_trait_impls_for_type(ctx, core::expr_type(value));
    match value {
        Constr { constructor: _, args, ty: _ } => ensure_runtime_trait_impls_for_exprs(ctx, args),
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            ensure_runtime_trait_impls_for_exprs(ctx, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                ensure_runtime_trait_impls_for_type(ctx, param.ty)
            }
            ensure_runtime_trait_impls_for_expr(ctx, body)
        },
        Block { block, ty: _ } => ensure_runtime_trait_impls_for_block(ctx, block),
        Match { expr, arms, default, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, expr);
            for arm in arms {
                ensure_runtime_trait_impls_for_expr(ctx, arm.lhs);
                ensure_runtime_trait_impls_for_expr(ctx, arm.body)
            }
            ensure_runtime_trait_impls_for_optional_expr(ctx, default)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty, body } => {
                        ensure_runtime_trait_impls_for_type(ctx, binding_ty);
                        ensure_runtime_trait_impls_for_expr(ctx, channel);
                        ensure_runtime_trait_impls_for_optional_expr(ctx, guard);
                        ensure_runtime_trait_impls_for_expr(ctx, body)
                    },
                    Send { channel, value, guard, body } => {
                        ensure_runtime_trait_impls_for_expr(ctx, channel);
                        ensure_runtime_trait_impls_for_expr(ctx, value);
                        ensure_runtime_trait_impls_for_optional_expr(ctx, guard);
                        ensure_runtime_trait_impls_for_expr(ctx, body)
                    },
                }
            }
            ensure_runtime_trait_impls_for_optional_expr(ctx, default)
        },
        If { cond, then_branch: then_, else_branch: else_, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, cond);
            ensure_runtime_trait_impls_for_expr(ctx, then_);
            ensure_runtime_trait_impls_for_expr(ctx, else_)
        },
        While { cond, body, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, cond);
            ensure_runtime_trait_impls_for_expr(ctx, body)
        },
        Loop { body, ty: _ } => ensure_runtime_trait_impls_for_expr(ctx, body),
        Return { expr, ty: _ } => ensure_runtime_trait_impls_for_optional_expr(ctx, expr),
        Go { expr, ty: _ } | ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary {
            op: _,
            expr,
            ty: _,
        } | Cast { expr, ty: _ } | Proj { tuple: expr, index: _, ty: _ } => ensure_runtime_trait_impls_for_expr(
            ctx,
            expr,
        ),
        Binary { op: _, lhs, rhs, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, lhs);
            ensure_runtime_trait_impls_for_expr(ctx, rhs)
        },
        Assign { name: _, value: expr, target_ty, ty: _ } => {
            ensure_runtime_trait_impls_for_type(ctx, target_ty);
            ensure_runtime_trait_impls_for_expr(ctx, expr)
        },
        Call { func, args, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, func);
            ensure_runtime_trait_impls_for_exprs(ctx, args)
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            ensure_runtime_trait_impls_for_type(ctx, for_ty);
            ensure_runtime_trait_impls_for_expr(ctx, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            ensure_runtime_trait_impls_for_expr(ctx, receiver);
            ensure_runtime_trait_impls_for_exprs(ctx, args)
        },
        TraitCall { receiver, args, .. } => {
            if let Some(value) = receiver {
                ensure_runtime_trait_impls_for_expr(ctx, value)
            }
            ensure_runtime_trait_impls_for_exprs(ctx, args)
        },
        Break { value, ty: _, .. } => if let Some(expr) = value {
            ensure_runtime_trait_impls_for_expr(ctx, expr)
        },
        Var { name: _, ty: _ } | Callable { callable: _, ty: _ } | Prim { value: _, ty: _ } | Continue {
            ty: _,
            ..,
        } => (),
    }
}

fn ensure_runtime_trait_impls(ctx: SpecializeCtx, functions: Vec[core::Function]) -> () {
    for function in functions {
        for param in function.params {
            ensure_runtime_trait_impls_for_type(ctx, param.1)
        }
        ensure_runtime_trait_impls_for_type(ctx, function.ret_ty);
        ensure_runtime_trait_impls_for_block(ctx, function.body)
    }
}

fn specialize_function(ctx: SpecializeCtx, instance: Instance, value: core::Function) -> core::Function {
    specialize_external_applications_for_function(ctx, instance);
    let params: Vec[(string, core::Type)] = Vec::new();
    for param in value.params {
        params.push((param.0, specialize_type(ctx, param.1, instance.bindings)))
    }
    core::Function {
        name: instance.name,
        origin: match value.origin {
            core::FunctionOrigin::Source => core::FunctionOrigin::Source,
            core::FunctionOrigin::Inherent { owner, method_name } => {
                core::FunctionOrigin::Inherent {
                    owner: specialize_type(ctx, owner, instance.bindings),
                    method_name,
                }
            },
            core::FunctionOrigin::TraitImplementation { method_name } => {
                core::FunctionOrigin::TraitImplementation { method_name }
            },
        },
        root: true,
        generics: Vec::new(),
        predicates: Vec::new(),
        trait_impl: value.trait_impl.map(
            |metadata| core::TraitImpl {
                trait_ref: specialize_trait_ref(ctx, metadata.trait_ref, instance.bindings),
                for_ty: specialize_type(ctx, metadata.for_ty, instance.bindings),
                associated_types: specialize_named_types(
                    ctx,
                    metadata.associated_types,
                    instance.bindings,
                ),
                generic_count: 0,
                predicate_count: 0,
            },
        ),
        params,
        ret_ty: specialize_type(ctx, value.ret_ty, instance.bindings),
        body: specialize_block(ctx, instance.bindings, value.body),
    }
}

fn specialize_with_application_records(
    value: core::File,
    error: Ref[Option[string]],
    external_applications: Vec[core::ExternalTypeApplication],
    resolved_external_applications: Vec[core::ExternalTypeApplication],
    source_names: Vec[(string, string)],
) -> core::File {
    let builtin = match tast::builtin_contract() {
        Ok(value) => value,
        Err(message) => {
            error.set(Option::Some("invalid builtin contract: " + message));
            return value
        },
    };
    let enums = value.enums;
    let structs = value.structs;
    let type_instances = value.type_instances;
    let constants = value.constants;
    let input_statics = value.statics;
    let function_index: HashMap[string, core::Function] = HashMap::new();
    let inherent_method_index: FunctionIndex = HashMap::new();
    let trait_function_index: FunctionIndex = HashMap::new();
    let trait_method_index: FunctionIndex = HashMap::new();
    let trait_method_names: HashMap[string, string] = HashMap::new();
    let used_names: collections::HashSet[string] = collections::HashSet::new();
    for function in value.functions {
        function_index[function.name] = function;
        let _ = used_names.insert(function.name);
        if let Some(method_name) = inherent_function_method(function) {
            add_indexed_function(inherent_method_index, method_name, function)
        }
        if let Some(metadata) = function.trait_impl {
            add_indexed_function(trait_function_index, metadata.trait_ref.name, function);
            if let Some(method_name) = trait_impl_method(function) {
                trait_method_names[function.name] = method_name;
                add_indexed_function(
                    trait_method_index,
                    lookup_pair_key(metadata.trait_ref.name, method_name),
                    function,
                )
            }
        }
    }
    let ctx = SpecializeCtx {
        external_applications,
        resolved_external_applications,
        builtin,
        functions: value.functions,
        function_index,
        inherent_method_index,
        trait_function_index,
        trait_method_index,
        trait_method_names,
        instances: Vec::new(),
        instance_index: HashMap::new(),
        work: Vec::new(),
        used_names,
        active: Ref::new(Option::None),
        error,
    };
    let statics: Vec[core::Static] = Vec::with_capacity(input_statics.len());
    for value in input_statics {
        statics.push(
            core::Static { name: value.name, ty: specialize_type(ctx, value.ty, Vec::new()) },
        )
    }
    for function in ctx.functions {
        if function.root && !function_is_generic(function) {
            ensure_instance(ctx, function.name, Vec::new());
        }
    }
    let output: Vec[core::Function] = Vec::new();
    let mut index = 0;
    loop {
        while index < ctx.work.len() {
            let instance = ctx.work[index];
            index += 1;
            match find_function(ctx, instance.original_name) {
                Some(function) => {
                    ctx.active.set(Option::Some(instance));
                    source_names.push((instance.name, instance.original_name));
                    output.push(specialize_function(ctx, instance, function));
                    ctx.active.set(Option::None)
                },
                None => ctx.error.set(
                    Option::Some("missing monomorphization function " + instance.original_name),
                ),
            }
        }
        let previous_len = ctx.work.len();
        ensure_runtime_trait_impls(ctx, output);
        if ctx.work.len() == previous_len {
            break
        }
    }
    core::File { functions: output, enums, structs, type_instances, constants, statics }
}
