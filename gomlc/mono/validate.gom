package mono;

use std::collections;
use module::core;
use module::tast;

struct ValidateContext {
    external_keys: Option[Vec[ExternalKeyRule]],
    structs: Vec[StructDef],
    types: collections::HashSet[string],
}

fn validate_type(ctx: ValidateContext, value: Type, context: string) -> Result[(), string] {
    match value {
        Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => Result::Ok(
            (),
        ),
        Tuple { items } => validate_types(ctx, items, context + " tuple item"),
        External { import_path, name, args } => {
            if name == ""
                || (import_path == "" && ((name != "error" && name != "string") || !args.is_empty())) {
                return Result::Err(context + " has an invalid external Go type identity")
            }
            validate_types(ctx, args, context + " external argument")
        },
        Named { name } => if name.byte_len() == 0 {
            Result::Err(context + " has an empty nominal type name")
        } else if !ctx.types.contains(name) {
            Result::Err(context + " references unknown nominal type " + name)
        } else {
            Result::Ok(())
        },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            if trait_name.byte_len() == 0 {
                return Result::Err(context + " has an empty dynamic trait name")
            }
            validate_types(ctx, args, context + " dynamic argument")?;
            validate_named_types(ctx, associated_types, context + " dynamic associated type")?;
            for bound in additional_bounds {
                if bound.trait_name.byte_len() == 0 {
                    return Result::Err(context + " has an empty dynamic bound name")
                }
                validate_types(ctx, bound.args, context + " dynamic bound argument")?;
                validate_named_types(
                    ctx,
                    bound.associated_types,
                    context + " dynamic bound associated type",
                )?
            }
            Result::Ok(())
        },
        Array { len, elem } => {
            if len < 0 {
                Result::Err(context + " has a negative array length")
            } else {
                validate_type(ctx, elem, context + " array element")
            }
        },
        Slice { elem } => validate_type(ctx, elem, context + " slice element"),
        MutSlice { elem } => validate_type(ctx, elem, context + " mutable slice element"),
        VecType { elem } => validate_type(ctx, elem, context + " vector element"),
        GoPointer { elem } => validate_type(ctx, elem, context + " pointer element"),
        GoFunction { signature } => match signature {
            Func { .. } => {
                let _ = tast::foreign_bridge_type(
                    core::type_to_tast(mono_type_to_core(Type::GoFunction { signature })),
                    Vec::new(),
                    false,
                )?;
                validate_type(ctx, signature, context + " Go function signature")
            },
            _ => Result::Err(context + ": Go function requires a concrete function signature"),
        },
        RefType { elem } => validate_type(ctx, elem, context + " reference element"),
        HashMap { key, value } => {
            validate_type(ctx, key, context + " map key")?;
            validate_type(ctx, value, context + " map value")
        },
        GoMap { key, value } => {
            if go_map_key_uncomparable(ctx, key, Vec::new())? {
                return Result::Err(context + " Go map key is not comparable")
            }
            validate_type(ctx, key, context + " map key")?;
            validate_type(ctx, value, context + " map value")
        },
        Channel { elem, direction: _ } => validate_type(ctx, elem, context + " channel element"),
        Func { params, ret_ty } => {
            validate_types(ctx, params, context + " function parameter")?;
            validate_type(ctx, ret_ty, context + " function return")
        },
    }
}

fn validate_types(ctx: ValidateContext, values: Vec[Type], context: string) -> Result[(), string] {
    for value in values {
        validate_type(ctx, value, context)?
    }
    Result::Ok(())
}

fn validate_named_types(ctx: ValidateContext, values: Vec[(string, Type)], context: string) -> Result[
    (),
    string,
] {
    for value in values {
        validate_type(ctx, value.1, context + " " + value.0)?
    }
    Result::Ok(())
}

fn validate_exprs(ctx: ValidateContext, values: Vec[Expr], context: string) -> Result[(), string] {
    for value in values {
        validate_expr(ctx, value, context)?
    }
    Result::Ok(())
}

fn validate_optional_expr(ctx: ValidateContext, value: Option[Expr], context: string) -> Result[
    (),
    string,
] {
    match value {
        Some(value) => validate_expr(ctx, value, context),
        None => Result::Ok(()),
    }
}

fn validate_arm(ctx: ValidateContext, value: Arm, context: string) -> Result[(), string] {
    validate_expr(ctx, value.lhs, context + " pattern")?;
    validate_expr(ctx, value.body, context + " body")
}

fn validate_block(ctx: ValidateContext, value: Block, context: string) -> Result[(), string] {
    for statement in value.stmts {
        let binding_context = context + " let " + statement.name;
        validate_type(ctx, statement.ty, binding_context)?;
        validate_expr(ctx, statement.value, binding_context)?;
        if types_equal(statement.ty, expr_type(statement.value)) {} else {
            return Result::Err(binding_context + " type does not match its value")
        }
    }
    validate_optional_expr(ctx, value.tail, context + " tail")
}

fn validate_callable(ctx: ValidateContext, value: Callable, context: string) -> Result[(), string] {
    match value {
        TraitMethod { .. } => Result::Err(context + " contains an unresolved static trait callable"),
        InherentMethod { receiver_ty, method_name: _ } => {
            validate_type(ctx, receiver_ty, context + " inherent receiver")
        },
        Function(_) | LangItem { .. } | Runtime(_) | Intrinsic(_) | GoInterfaceBridge { .. } | GoForeign {
            ..,
        } | GoMethod { .. } | DynTraitMethod { .. } => Result::Ok(()),
    }
}

fn validate_expr(ctx: ValidateContext, value: Expr, context: string) -> Result[(), string] {
    validate_type(ctx, expr_type(value), context)?;
    match value {
        Var { name: _, ty: _ } | Prim { value: _, ty: _ } | Continue { target: _, ty: _ } => Result::Ok(
            (),
        ),
        Callable { callable, ty } => {
            if let GoMethod { .. } = callable {
                match ty {
                    Func { params, ret_ty: _ } if !params.is_empty() => (),
                    _ => return Result::Err(
                        context + " foreign method requires a receiver parameter",
                    ),
                }
            }
            validate_callable(ctx, callable, context)
        },
        Constr { constructor: _, args, ty: _ } => validate_exprs(ctx, args, context),
        Tuple { items, ty: _ } | Array { items, ty: _ } => validate_exprs(ctx, items, context),
        Closure { params, body, ty: _ } => {
            for param in params {
                validate_type(ctx, param.ty, context + " closure parameter " + param.name)?
            }
            validate_expr(ctx, body, context + " closure body")
        },
        Block { block, ty: _ } => validate_block(ctx, block, context),
        Match { expr, arms, default, ty: _ } => {
            validate_expr(ctx, expr, context + " match scrutinee")?;
            for arm in arms {
                validate_arm(ctx, arm, context + " match arm")?
            }
            validate_optional_expr(ctx, default, context + " match default")
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty, body } => {
                        validate_type(ctx, binding_ty, context + " select receive binding")?;
                        validate_expr(ctx, channel, context + " select receive channel")?;
                        validate_optional_expr(ctx, guard, context + " select receive guard")?;
                        validate_expr(ctx, body, context + " select receive body")?
                    },
                    Send { channel, value, guard, body } => {
                        validate_expr(ctx, channel, context + " select send channel")?;
                        validate_expr(ctx, value, context + " select send value")?;
                        validate_optional_expr(ctx, guard, context + " select send guard")?;
                        validate_expr(ctx, body, context + " select send body")?
                    },
                }
            }
            validate_optional_expr(ctx, default, context + " select default")
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            validate_expr(ctx, cond, context + " if condition")?;
            validate_expr(ctx, then_branch, context + " if branch")?;
            validate_expr(ctx, else_branch, context + " else branch")
        },
        While { cond, body, ty: _ } => {
            validate_expr(ctx, cond, context + " while condition")?;
            validate_expr(ctx, body, context + " while body")
        },
        Loop { body, ty: _ } => validate_expr(ctx, body, context + " loop body"),
        Break { target: _, value, ty: _ } => validate_optional_expr(ctx, value, context + " break"),
        Return { expr, ty: _ } => validate_optional_expr(ctx, expr, context + " return"),
        Go { expr, ty: _ } => validate_expr(ctx, expr, context + " go"),
        ConstrGet { expr, constructor: _, field_index: _, ty: _ } | Unary { op: _, expr, ty: _ } | Cast {
            expr,
            ty: _,
        } | Proj { tuple: expr, index: _, ty: _ } => validate_expr(ctx, expr, context),
        Binary { op: _, lhs, rhs, ty: _ } => {
            validate_expr(ctx, lhs, context)?;
            validate_expr(ctx, rhs, context)
        },
        Assign { name: _, value, target_ty, ty: _ } => {
            validate_type(ctx, target_ty, context + " assignment target")?;
            validate_expr(ctx, value, context + " assignment value")
        },
        Call { func, args, ty: _ } => {
            validate_expr(ctx, func, context + " call target")?;
            validate_exprs(ctx, args, context + " call argument")
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            validate_type(ctx, for_ty, context + " dynamic conversion")?;
            validate_expr(ctx, expr, context + " dynamic conversion")
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            validate_expr(ctx, receiver, context + " dynamic receiver")?;
            validate_exprs(ctx, args, context + " dynamic argument")
        },
    }
}

fn validate_origin(ctx: ValidateContext, value: FunctionOrigin, context: string) -> Result[
    (),
    string,
] {
    match value {
        Source | TraitImplementation { method_name: _ } => Result::Ok(()),
        Inherent { owner, method_name: _ } => validate_type(ctx, owner, context + " owner"),
    }
}

fn validate_trait_impl(ctx: ValidateContext, value: Option[TraitImpl], context: string) -> Result[
    (),
    string,
] {
    match value {
        Some(value) => {
            validate_types(ctx, value.trait_ref.args, context + " trait arguments")?;
            validate_type(ctx, value.for_ty, context + " implementation type")?;
            validate_named_types(ctx, value.associated_types, context + " associated type")
        },
        None => Result::Ok(()),
    }
}

fn validate_function(ctx: ValidateContext, value: Function) -> Result[(), string] {
    let context = "function " + value.name;
    validate_origin(ctx, value.origin, context)?;
    validate_trait_impl(ctx, value.trait_impl, context)?;
    validate_named_types(ctx, value.params, context + " parameter")?;
    validate_type(ctx, value.ret_ty, context + " return")?;
    validate_block(ctx, value.body, context)
}

pub fn validate(value: File) -> Result[(), string] {
    validate_with_external_keys(value, Option::None)
}

pub fn validate_with_external_keys(value: File, external_keys: Option[Vec[ExternalKeyRule]]) -> Result[
    (),
    string,
] {
    let type_names: collections::HashSet[string] = collections::HashSet::new();
    for definition in value.enums {
        if !type_names.insert(definition.name) {
            return Result::Err("duplicate Mono type definition " + definition.name)
        }
    }
    for definition in value.structs {
        if !type_names.insert(definition.name) {
            return Result::Err("duplicate Mono type definition " + definition.name)
        }
    }
    let instance_names: collections::HashSet[string] = collections::HashSet::new();
    for instance in value.type_instances {
        if !instance_names.insert(instance.name) {
            return Result::Err("duplicate Mono type instance " + instance.name)
        } else {
            let _ = type_names.insert(instance.name);
        }
    }
    let ctx = ValidateContext { external_keys, types: type_names, structs: value.structs };
    for definition in value.enums {
        for variant in definition.variants {
            match variant.fields {
                Unit => (),
                Tuple(values) => {
                    validate_types(
                        ctx,
                        values,
                        "enum " + definition.name + " variant " + variant.name,
                    )?
                },
                Struct(values) => validate_named_types(
                    ctx,
                    values,
                    "enum " + definition.name + " variant " + variant.name,
                )?,
            }
        }
    }
    for definition in value.structs {
        validate_named_types(ctx, definition.fields, "struct " + definition.name + " field")?
    }
    for instance in value.type_instances {
        validate_types(ctx, instance.args, "type instance " + instance.name)?
    }
    for function in value.functions {
        validate_function(ctx, function)?
    }
    Result::Ok(())
}

fn go_map_key_definitely_uncomparable(value: Type) -> bool {
    match value {
        Slice { .. } | MutSlice { .. } | GoMap { .. } | GoFunction { .. } => true,
        Array { elem, .. } => go_map_key_definitely_uncomparable(elem),
        Tuple { items } => {
            for item in items {
                if go_map_key_definitely_uncomparable(item) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn go_map_key_uncomparable(ctx: ValidateContext, value: Type, active: Vec[string]) -> Result[
    bool,
    string,
] {
    if go_map_key_definitely_uncomparable(value) {
        return Result::Ok(true)
    }
    match value {
        Named { name } => {
            if active.contains(name) {
                return Result::Ok(false)
            }
            active.push(name);
            let mut invalid = false;
            for definition in ctx.structs {
                if definition.name == name {
                    for field in definition.fields {
                        if go_map_key_uncomparable(ctx, field.1, active)? {
                            invalid = true;
                        }
                    }
                }
            }
            active.truncate(active.len() - 1);
            Result::Ok(invalid)
        },
        Array { elem, .. } => go_map_key_uncomparable(ctx, elem, active),
        Tuple { items } => {
            for item in items {
                if go_map_key_uncomparable(ctx, item, active)? {
                    return Result::Ok(true)
                }
            }
            Result::Ok(false)
        },
        External { .. } => external_key_uncomparable(ctx, value, active),
        _ => Result::Ok(false),
    }
}
