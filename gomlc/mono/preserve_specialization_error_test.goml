package mono;

use std::testing;

#[test]
fn specialization_retains_the_first_const_failure_through_call_rebinding() -> () {
    for calls in[
        "let _ = inner::[{N - 1}](); let _ = inner::[{1 / N}]();",
        "let callback = inner::[{N - 1}]; let _ = callback(); let _ = inner::[{1 / N}]();",
    ] {
        let source = "fn inner[const M: usize]() -> i32 { 42 } fn outer[const N: usize]() -> () { "
            + calls
            + " } fn main() -> () { outer::[0](); }";
        match lower_checked_source(source).error {
            Some(error) => {
                testing::assert(error.contains("const usize argument must be nonnegative"));
                testing::assert(!error.contains("incomplete generic bindings"));
            },
            None => testing::fail("expected the original const argument failure"),
        }
    }
    let source = "fn inner[const M: usize]() -> i32 { 42 } fn outer[const N: usize]() -> () { let _ = inner::[{1 / N}](); let _ = inner::[{N - 1}](); } fn main() -> () { outer::[0](); }";
    match lower_checked_source(source).error {
        Some(error) => testing::assert(error.contains("division by zero")),
        None => testing::fail("expected the first arithmetic failure"),
    }
}
