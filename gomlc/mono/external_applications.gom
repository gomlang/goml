package mono;

use module::core;

pub struct ExternalSpecialization {
    pub file: core::File,
    pub applications: Vec[core::ExternalTypeApplication],
}

fn specialize_external_applications_for_function(ctx: SpecializeCtx, instance: Instance) -> () {
    for application in ctx.external_applications {
        if application.function_name == instance.original_name {
            let arguments = Vec::new();
            for argument in application.arguments {
                let resolved = specialize_type(ctx, argument, instance.bindings);
                if !core::type_is_concrete(resolved) || core::type_contains_error(resolved) {
                    ctx.error.set(
                        Option::Some(
                            "external type application remains symbolic in " + instance.name,
                        ),
                    );
                }
                arguments.push(resolved)
            }
            ctx.resolved_external_applications.push(
                core::ExternalTypeApplication {
                    function_name: instance.name,
                    declaration: application.declaration,
                    arguments,
                },
            )
        }
    }
}

pub fn specialize_with_external_applications(
    value: core::File,
    applications: Vec[core::ExternalTypeApplication],
) -> Result[ExternalSpecialization, string] {
    core::validate(value)?;
    core::validate_external_applications(value, applications)?;
    let error = Ref::new(Option::None);
    let resolved = Vec::new();
    let file = specialize_with_application_records(value, error, applications, resolved, Vec::new());
    if let Some(message) = error.get() {
        return Result::Err(message)
    }
    Result::Ok(ExternalSpecialization { file, applications: resolved })
}

pub struct ExternalLowering {
    pub source_names: Vec[(string, string)],
    pub file: File,
    pub applications: Vec[core::ExternalTypeApplication],
}

pub fn lower_with_external_applications(
    value: core::File,
    applications: Vec[core::ExternalTypeApplication],
) -> Result[ExternalLowering, string] {
    let resolved = Vec::new();
    let source_names = Vec::new();
    let result = lower_with_application_records(value, applications, resolved, source_names);
    if let Some(error) = result.error {
        return Result::Err(error)
    }
    Result::Ok(ExternalLowering { source_names, file: result.file, applications: resolved })
}
