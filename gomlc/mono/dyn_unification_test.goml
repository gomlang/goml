package mono;

use module::core;
use std::testing;

fn dyn_unification_type(name: string, argument: core::Type) -> core::Type {
    core::Type::Dyn {
        trait_name: name,
        args: Vec::from_array([argument]),
        associated_types: Vec::new(),
        additional_bounds: Vec::new(),
    }
}

#[test]
fn dyn_unification_preserves_arguments_and_rejects_incompatible_bounds() -> () {
    let bindings = Vec::new();
    testing::assert(
        unify_type(
            dyn_unification_type("Read", core::Type::Param { name: "T" }),
            dyn_unification_type("Read", core::Type::Int32),
            bindings,
        ),
    );
    testing::assert(
        core::types_equal(
            find_binding(bindings, "T").unwrap_or(core::Type::Error),
            core::Type::Int32,
        ),
    );
    testing::assert(
        !unify_type(
            dyn_unification_type("Read", core::Type::Bool),
            dyn_unification_type("Read", core::Type::Int32),
            Vec::new(),
        ),
    );
    testing::assert(
        !unify_type(
            dyn_unification_type("Read", core::Type::Int32),
            dyn_unification_type("Write", core::Type::Int32),
            Vec::new(),
        ),
    );
}
