package mono;

use module::core;

fn dyn_projection_binding(base: core::Type, name: string, reference: Option[core::TraitRef]) -> Option[
    core::Type,
] {
    let Dyn { trait_name, args, associated_types, additional_bounds } = core::resolve_type(base) else {
        return None
    };
    let bounds = Vec::from_array([core::DynTraitBound { trait_name, args, associated_types }]);
    for bound in additional_bounds {
        bounds.push(bound)
    }
    let mut selected: Option[core::Type] = None;
    for bound in bounds {
        if let Some(reference) = reference {
            if bound.trait_name != reference.name || bound.args.len() != reference.args.len() {
                continue
            }
            let mut matches = true;
            for index in 0..bound.args.len() {
                if !mono_types_equal(bound.args[index], reference.args[index]) {
                    matches = false;
                }
            }
            if !matches {
                continue
            }
        }
        for binding in bound.associated_types {
            if binding.0 == name {
                if selected.is_some() {
                    return None
                }
                selected = Some(binding.1);
            }
        }
    }
    selected
}
