package mono;

use module::core;
use std::testing;

#[test]
fn dynamic_bound_satisfaction_compares_all_trait_arguments() -> () {
    let primary = core::Type::Dyn {
        trait_name: "Read",
        args: Vec::from_array([core::Type::Int32]),
        associated_types: Vec::new(),
        additional_bounds: Vec::from_array(
            [
                core::DynTraitBound {
                    trait_name: "Mark",
                    args: Vec::from_array([core::Type::Bool]),
                    associated_types: Vec::new(),
                },
            ],
        ),
    };
    testing::assert(
        dyn_trait_satisfied(
            primary,
            core::TraitRef { name: "Read", args: Vec::from_array([core::Type::Int32]) },
        ),
    );
    testing::assert(
        dyn_trait_satisfied(
            primary,
            core::TraitRef { name: "Mark", args: Vec::from_array([core::Type::Bool]) },
        ),
    );
    testing::assert(
        !dyn_trait_satisfied(
            primary,
            core::TraitRef { name: "Read", args: Vec::from_array([core::Type::Bool]) },
        ),
    );
    testing::assert(
        !dyn_trait_satisfied(
            primary,
            core::TraitRef { name: "Mark", args: Vec::from_array([core::Type::Int32]) },
        ),
    );
    testing::assert(
        !dyn_trait_satisfied(primary, core::TraitRef { name: "Read", args: Vec::new() }),
    );
    testing::assert(
        !dyn_trait_satisfied(
            primary,
            core::TraitRef { name: "Other", args: Vec::from_array([core::Type::Int32]) },
        ),
    );
}
