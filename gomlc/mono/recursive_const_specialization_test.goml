package mono;

use std::testing;

#[test]
fn growing_const_specialization_reports_a_recoverable_limit() -> () {
    for source in[
        "fn recurse[const N: usize]() -> () { recurse::[{N + 1}](); } fn main() -> () { recurse::[0](); }",
        "fn first[const N: usize]() -> () { second::[{N + 1}](); } fn second[const N: usize]() -> () { first::[N](); } fn main() -> () { first::[0](); }",
    ] {
        match lower_checked_source(source).error {
            Some(error) => testing::assert(
                error.contains("256-level recursive specialization limit"),
            ),
            None => testing::fail("expected bounded recursive specialization"),
        }
    }
}

#[test]
fn branching_const_specialization_has_an_instance_budget() -> () {
    let source = "fn branch[const N: usize]() -> () { branch::[{N * 2 + 1}](); branch::[{N * 2 + 2}](); } fn main() -> () { branch::[0](); }";
    match lower_checked_source(source).error {
        Some(error) => testing::assert(error.contains("4096-instance specialization limit")),
        None => testing::fail("expected bounded branching specialization"),
    }
}

#[test]
fn finite_const_specialization_cycles_reuse_instances() -> () {
    for source in[
        "fn recurse[const N: usize]() -> () { recurse::[N](); } fn main() -> () { recurse::[0](); }",
        "fn cycle[const N: usize]() -> () { cycle::[{(N + 1) % 3}](); } fn main() -> () { cycle::[0](); }",
        "fn settle[const N: usize]() -> () { settle::[0](); } fn main() -> () { settle::[3](); }",
        "fn unused[const N: usize]() -> () { unused::[{N + 1}](); } fn main() -> () {}",
    ] {
        if let Some(error) = lower_checked_source(source).error {
            testing::fail(error)
        }
    }
}
