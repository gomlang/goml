package mono;

use module::ast;
use module::core;
use module::ffi;
use module::hir;
use module::parser;
use module::tast;
use std::testing;

fn external_application_program() -> core::File {
    core::lower(
        tast::check(
            hir::lower(
                ast::lower(
                    parser::parse(
                        "fn ignore[T](value: T) -> i64 { 0 } fn main() -> () { let first: i64 = ignore(1); let second: i64 = ignore(true); let third: i64 = ignore(false); }",
                    ),
                ),
                "external.gom",
            ),
        ),
    )
}

fn external_symbolic_application(owner: string, argument: core::Type) -> core::ExternalTypeApplication {
    core::ExternalTypeApplication {
        function_name: owner,
        declaration: ffi::TypeDeclarationQuery {
            type_id: "api::Erased",
            import_path: "example.com/host",
            name: "Erased",
        },
        arguments: Vec::from_array([argument]),
    }
}

fn exercise_external_specialization() -> Result[(), string] {
    let program = external_application_program();
    let result = specialize_with_external_applications(
        program,
        Vec::from_array([external_symbolic_application("ignore", core::Type::Param { name: "T" })]),
    )?;
    testing::assert_eq(result.applications.len(), 2);
    let mut integers = 0;
    let mut booleans = 0;
    for application in result.applications {
        testing::assert_eq(application.declaration.name, "Erased");
        testing::assert(application.function_name != "ignore");
        let argument = application.arguments[0];
        testing::assert(core::type_is_concrete(argument));
        if core::types_equal(argument, core::Type::Int) {
            integers += 1;
        }
        if core::types_equal(argument, core::Type::Bool) {
            booleans += 1;
        }
    }
    let lowered = lower_with_external_applications(
        program,
        Vec::from_array([external_symbolic_application("ignore", core::Type::Param { name: "T" })]),
    )?;
    validate(lowered.file)?;
    testing::assert_eq(lowered.applications.len(), 2);
    testing::assert_eq(integers, 1);
    testing::assert_eq(booleans, 1);
    testing::assert(
        specialize_with_external_applications(
            program,
            Vec::from_array([external_symbolic_application("missing", core::Type::Int64)]),
        ).is_err(),
    );
    testing::assert(
        specialize_with_external_applications(
            program,
            Vec::from_array(
                [external_symbolic_application("ignore", core::Type::Param { name: "Unknown" })],
            ),
        ).is_err(),
    );
    testing::assert(
        specialize_with_external_applications(
            program,
            Vec::from_array([external_symbolic_application("ignore", core::Type::Error)]),
        ).is_err(),
    );
    Result::Ok(())
}

#[test]
fn external_applications_follow_function_specialization_and_deduplicate_instances() -> () {
    if let Err(error) = exercise_external_specialization() {
        testing::fail(error)
    }
}
