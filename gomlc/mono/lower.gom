package mono;

use module::core;
use std::collections;
use std::text;

struct PendingTypeInstance {
    base_name: string,
    args: Vec[core::Type],
    name: string,
}

struct TypeCtx {
    instances: Vec[PendingTypeInstance],
    instance_index: HashMap[string, PendingTypeInstance],
    used_names: collections::HashSet[string],
    enums: Vec[core::EnumDef],
    structs: Vec[core::StructDef],
    active_instances: Vec[PendingTypeInstance],
    error: Ref[Option[string]],
}

pub struct LowerResult {
    pub file: File,
    pub error: Option[string],
}

fn types_are_concrete(values: Vec[core::Type]) -> bool {
    for value in values {
        if type_is_concrete(value) {} else {
            return false
        }
    }
    true
}

fn type_is_concrete(value: core::Type) -> bool {
    core::type_is_concrete(value)
}

fn compact_type(value: core::Type) -> string {
    let type_builder = text::StringBuilder::new();
    core::write_type(type_builder, value);
    let builder = text::StringBuilder::new();
    for character in type_builder.finish().chars() {
        if character == ' ' || character == '\n' || character == '\r' || character == '\t' {} else {
            builder.write_char(character)
        }
    }
    builder.finish()
}

fn type_instance_lookup_key(base_name: string, args: Vec[core::Type]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(base_name.byte_len().to_string());
    builder.write_char(':');
    builder.write_string(base_name);
    for arg in args {
        let ty = compact_type(arg);
        builder.write_string(ty.byte_len().to_string());
        builder.write_char(':');
        builder.write_string(ty)
    }
    builder.finish()
}

fn find_type_instance(ctx: TypeCtx, base_name: string, args: Vec[core::Type]) -> Option[
    PendingTypeInstance,
] {
    ctx.instance_index[type_instance_lookup_key(base_name, args)]
}

fn find_type_instance_by_name(ctx: TypeCtx, name: string) -> Option[PendingTypeInstance] {
    let mut index = ctx.instances.len() - 1;
    while index >= 0 {
        let instance = ctx.instances[index];
        if instance.name == name {
            return Option::Some(instance)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn type_name_is_used(ctx: TypeCtx, name: string) -> bool {
    ctx.used_names.contains(name)
}

fn add_used_type_name(ctx: TypeCtx, name: string) -> () {
    let _ = ctx.used_names.insert(name);
}

fn type_instance_base_name(name: string, args: Vec[Type]) -> string {
    let builder = text::StringBuilder::new();
    builder.write_string(name);
    for arg in args {
        builder.write_string("__");
        builder.write_string(compact_mono_type(arg))
    }
    builder.finish()
}

fn unique_type_name(ctx: TypeCtx, base: string) -> string {
    if ctx.used_names.insert(base) {
        base
    } else {
        let mut index = 1;
        let mut candidate = base + "__mono1";
        while type_name_is_used(ctx, candidate) {
            index += 1;
            candidate = f"{base}__mono{index}";
        }
        let _ = ctx.used_names.insert(candidate);
        candidate
    }
}

fn ensure_type_instance(
    ctx: TypeCtx,
    base_name: string,
    args: Vec[core::Type],
    name_args: Vec[Type],
) -> string {
    if let Some(_) = ctx.error.get() {
        return base_name
    }
    match find_type_instance(ctx, base_name, args) {
        Some(instance) => instance.name,
        None => {
            if let Some(message) = recursive_type_specialization_message(ctx, base_name, args) {
                ctx.error.set(Option::Some(message));
                return base_name
            }
            let name = unique_type_name(ctx, type_instance_base_name(base_name, name_args));
            let instance = PendingTypeInstance { base_name, args, name };
            ctx.instances.push(instance);
            ctx.instance_index.set(
                type_instance_lookup_key(instance.base_name, instance.args),
                instance,
            );
            ctx.active_instances.push(instance);
            discover_type_instance_dependencies(ctx, instance);
            let _ = ctx.active_instances.pop();
            name
        },
    }
}

fn expand_specialized_type_aliases_list(ctx: TypeCtx, values: Vec[core::Type], path: Vec[string]) -> Vec[
    core::Type,
] {
    let result: Vec[core::Type] = Vec::new();
    for value in values {
        result.push(expand_specialized_type_aliases_from(ctx, value, path))
    }
    result
}

fn expand_specialized_trait_ref(ctx: TypeCtx, value: core::TraitRef, path: Vec[string]) -> core::TraitRef {
    core::TraitRef {
        name: value.name,
        args: expand_specialized_type_aliases_list(ctx, value.args, path),
    }
}

fn expand_specialized_optional_trait_ref(
    ctx: TypeCtx,
    value: Option[core::TraitRef],
    path: Vec[string],
) -> Option[core::TraitRef] {
    value.map(|reference| expand_specialized_trait_ref(ctx, reference, path))
}

fn expand_specialized_type_aliases_from(ctx: TypeCtx, value: core::Type, path: Vec[string]) -> core::Type {
    match core::resolve_type(value) {
        Con { name } => if path.contains(name) {
            core::Type::Con { name }
        } else {
            match find_type_instance_by_name(ctx, name) {
                Some(instance) => {
                    path.push(name);
                    let args = expand_specialized_type_aliases_list(ctx, instance.args, path);
                    let _ = path.pop();
                    core::Type::App { ty: core::Type::Con { name: instance.base_name }, args }
                },
                None => core::Type::Con { name },
            }
        },
        External { import_path, name, args: values } => core::Type::External {
            import_path,
            name,
            args: expand_specialized_type_aliases_list(ctx, values, path),
        },
        Tuple { items: values } => core::Type::Tuple {
            items: expand_specialized_type_aliases_list(ctx, values, path),
        },
        Projection { for_ty: base, name, trait_ref: reference } => core::Type::Projection {
            for_ty: expand_specialized_type_aliases_from(ctx, base, path),
            name,
            trait_ref: expand_specialized_optional_trait_ref(ctx, reference, path),
        },
        App { ty: base, args } => core::Type::App {
            ty: expand_specialized_type_aliases_from(ctx, base, path),
            args: expand_specialized_type_aliases_list(ctx, args, path),
        },
        Array { len: length, elem } => core::Type::Array {
            len: length,
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        Slice { elem } => core::Type::Slice {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        MutSlice { elem } => core::Type::MutSlice {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        VecType { elem } => core::Type::VecType {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        GoPointer { elem } => core::Type::GoPointer {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        GoFunction { signature } => core::Type::GoFunction {
            signature: expand_specialized_type_aliases_from(ctx, signature, path),
        },
        RefType { elem } => core::Type::RefType {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
        },
        Channel { elem, direction } => core::Type::Channel {
            elem: expand_specialized_type_aliases_from(ctx, elem, path),
            direction,
        },
        HashMap { key, value } => core::Type::HashMap {
            key: expand_specialized_type_aliases_from(ctx, key, path),
            value: expand_specialized_type_aliases_from(ctx, value, path),
        },
        GoMap { key, value } => core::Type::GoMap {
            key: expand_specialized_type_aliases_from(ctx, key, path),
            value: expand_specialized_type_aliases_from(ctx, value, path),
        },
        Func { params, ret_ty } => core::Type::Func {
            params: expand_specialized_type_aliases_list(ctx, params, path),
            ret_ty: expand_specialized_type_aliases_from(ctx, ret_ty, path),
        },
        other => other,
    }
}

fn expand_specialized_type_aliases(ctx: TypeCtx, value: core::Type) -> core::Type {
    expand_specialized_type_aliases_from(ctx, value, Vec::new())
}

fn find_generic_enum(ctx: TypeCtx, name: string) -> Option[core::EnumDef] {
    let mut index = ctx.enums.len() - 1;
    while index >= 0 {
        let value = ctx.enums[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn find_generic_struct(ctx: TypeCtx, name: string) -> Option[core::StructDef] {
    let mut index = ctx.structs.len() - 1;
    while index >= 0 {
        let value = ctx.structs[index];
        if value.name == name {
            return Option::Some(value)
        } else {
            index -= 1;
        }
    }
    Option::None
}

fn type_instance_parameters(ctx: TypeCtx, name: string) -> Vec[string] {
    match find_generic_enum(ctx, name) {
        Some(value) => value.generics,
        None => match find_generic_struct(ctx, name) {
            Some(value) => value.generics,
            None => Vec::new(),
        },
    }
}

fn type_instance_bindings(ctx: TypeCtx, name: string, args: Vec[core::Type]) -> Vec[TypeBinding] {
    let result: Vec[TypeBinding] = Vec::new();
    let params = type_instance_parameters(ctx, name);
    for index in 0..params.len() {
        if index < args.len() {
            result.push(TypeBinding { name: params[index], ty: args[index] })
        }
    }
    result
}

fn discover_type_instance_dependencies(ctx: TypeCtx, instance: PendingTypeInstance) -> () {
    let bindings = type_instance_bindings(ctx, instance.base_name, instance.args);
    match find_generic_enum(ctx, instance.base_name) {
        Some(value) => for variant in value.variants {
            for field in core::enum_variant_field_types(variant.fields) {
                let _ = collapse_type(ctx, substitute_type(field, bindings));
            }
        },
        None => match find_generic_struct(ctx, instance.base_name) {
            Some(value) => for field in value.fields {
                let _ = collapse_type(ctx, substitute_type(field.1, bindings));
            },
            None => (),
        },
    }
}

fn recursive_type_specialization_message(ctx: TypeCtx, name: string, args: Vec[core::Type]) -> Option[
    string,
] {
    let params = type_instance_parameters(ctx, name);
    for offset in 0..ctx.active_instances.len() {
        let active = ctx.active_instances[ctx.active_instances.len() - offset - 1];
        if active.base_name == name {
            let common = if active.args.len() < args.len() {
                active.args.len()
            } else {
                args.len()
            };
            for index in 0..common {
                let previous = expand_specialized_type_aliases(ctx, active.args[index]);
                let next = expand_specialized_type_aliases(ctx, args[index]);
                if mono_type_contains_recursive_growth(next, previous) {
                    let parameter = if index < params.len() {
                        params[index]
                    } else {
                        f"#{index}"
                    };
                    return Option::Some(
                        "Infinite monomorphization detected for generic type " + name
                            + ": recursive specialization grows type parameter "
                            + parameter
                            + " from "
                            + mono_type_text(previous)
                            + " to "
                            + mono_type_text(next),
                    )
                }
            }
        }
    }
    Option::None
}

fn collapse_types(ctx: TypeCtx, values: Vec[core::Type]) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for value in values {
        result.push(collapse_type(ctx, value))
    }
    result
}

fn collapse_named_types(ctx: TypeCtx, values: Vec[(string, core::Type)]) -> Vec[(string, Type)] {
    let result: Vec[(string, Type)] = Vec::new();
    for value in values {
        result.push((value.0, collapse_type(ctx, value.1)))
    }
    result
}

fn collapse_trait_ref(ctx: TypeCtx, value: core::TraitRef) -> TraitRef {
    TraitRef { name: value.name, args: collapse_types(ctx, value.args) }
}

fn invalid_type(ctx: TypeCtx, message: string) -> Type {
    if let None = ctx.error.get() {
        ctx.error.set(Option::Some(message))
    }
    Type::Unit
}

fn collapse_type(ctx: TypeCtx, value: core::Type) -> Type {
    match core::resolve_type(value) {
        Unit => Type::Unit,
        Never => Type::Never,
        Bool => Type::Bool,
        Int => Type::Int,
        Int8 => Type::Int8,
        Int16 => Type::Int16,
        Int32 => Type::Int32,
        Int64 => Type::Int64,
        Uint => Type::Uint,
        Uint8 => Type::Uint8,
        Uint16 => Type::Uint16,
        Uint32 => Type::Uint32,
        Uint64 => Type::Uint64,
        Float32 => Type::Float32,
        Float64 => Type::Float64,
        String => Type::String,
        Char => Type::Char,
        Tuple { items } => Type::Tuple { items: collapse_types(ctx, items) },
        External { import_path, name, args } => Type::External {
            import_path,
            name,
            args: collapse_types(ctx, args),
        },
        Con { name } => Type::Named { name },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let collapsed_associated: Vec[(string, Type)] = Vec::new();
            for binding in associated_types {
                collapsed_associated.push((binding.0, collapse_type(ctx, binding.1)))
            }
            let collapsed_additional: Vec[DynTraitBound] = Vec::new();
            for bound in additional_bounds {
                let bound_associated: Vec[(string, Type)] = Vec::new();
                for binding in bound.associated_types {
                    bound_associated.push((binding.0, collapse_type(ctx, binding.1)))
                }
                collapsed_additional.push(
                    DynTraitBound {
                        trait_name: bound.trait_name,
                        args: collapse_types(ctx, bound.args),
                        associated_types: bound_associated,
                    },
                )
            }
            Type::Dyn {
                trait_name,
                args: collapse_types(ctx, args),
                associated_types: collapsed_associated,
                additional_bounds: collapsed_additional,
            }
        },
        Projection { .. } => invalid_type(
            ctx,
            "associated type projection remained after specialization",
        ),
        App { ty: base, args } => {
            match core::resolve_type(base) {
                Con { name } => {
                    if !args.is_empty() && types_are_concrete(args) {
                        let name_args = collapse_types(ctx, args);
                        let instance_name = ensure_type_instance(ctx, name, args, name_args);
                        Type::Named { name: instance_name }
                    } else {
                        invalid_type(ctx, "generic type " + name + " has non-concrete arguments")
                    }
                },
                _ => invalid_type(ctx, "type application does not have a nominal constructor"),
            }
        },
        Array { len: length, elem } => Type::Array { len: length, elem: collapse_type(ctx, elem) },
        Slice { elem } => Type::Slice { elem: collapse_type(ctx, elem) },
        MutSlice { elem } => Type::MutSlice { elem: collapse_type(ctx, elem) },
        VecType { elem } => Type::VecType { elem: collapse_type(ctx, elem) },
        GoPointer { elem } => Type::GoPointer { elem: collapse_type(ctx, elem) },
        GoFunction { signature } => Type::GoFunction { signature: collapse_type(ctx, signature) },
        RefType { elem } => Type::RefType { elem: collapse_type(ctx, elem) },
        Channel { elem, direction } => Type::Channel { elem: collapse_type(ctx, elem), direction },
        HashMap { key, value } => {
            Type::HashMap { key: collapse_type(ctx, key), value: collapse_type(ctx, value) }
        },
        GoMap { key, value } => {
            Type::GoMap { key: collapse_type(ctx, key), value: collapse_type(ctx, value) }
        },
        Param { name } => invalid_type(
            ctx,
            "generic parameter " + name + " remained after specialization",
        ),
        Func { params, ret_ty } => Type::Func {
            params: collapse_types(ctx, params),
            ret_ty: collapse_type(ctx, ret_ty),
        },
        Error => invalid_type(ctx, "error type cannot enter Mono IR"),
    }
}

fn constructor_variant(name: string) -> string {
    let mut separator = -1;
    if name.byte_len() > 1 {
        for index in 0..name.byte_len() - 1 {
            if text::starts_with_at(name, index, "::") {
                separator = index;
            }
        }
    }
    if separator < 0 {
        ""
    } else {
        name.byte_slice(separator, name.byte_len())
    }
}

fn update_constructor(value: core::Constructor, owner_type: Type) -> Constructor {
    match owner_type {
        Named { name } => {
            let constructor_name = if value.is_struct {
                name
            } else {
                let variant = constructor_variant(value.name);
                if variant.byte_len() == 0 {
                    value.name
                } else {
                    name + variant
                }
            };
            Constructor {
                name: constructor_name,
                fields: value.fields,
                is_struct: value.is_struct,
                tag: value.tag,
            }
        },
        _ => Constructor {
            name: value.name,
            fields: value.fields,
            is_struct: value.is_struct,
            tag: value.tag,
        },
    }
}

fn collapse_primitive(value: core::Primitive) -> Primitive {
    match value {
        Unit => Primitive::Unit,
        Bool { value } => Primitive::Bool { value },
        Int { value } => Primitive::Int { value },
        Int8 { value } => Primitive::Int8 { value },
        Int16 { value } => Primitive::Int16 { value },
        Int32 { value } => Primitive::Int32 { value },
        Int64 { value } => Primitive::Int64 { value },
        Uint { value } => Primitive::Uint { value },
        Uint8 { value } => Primitive::Uint8 { value },
        Uint16 { value } => Primitive::Uint16 { value },
        Uint32 { value } => Primitive::Uint32 { value },
        Uint64 { value } => Primitive::Uint64 { value },
        Float { value } => Primitive::Float { value },
        Float32 { value } => Primitive::Float32 { value },
        Float64 { value } => Primitive::Float64 { value },
        String { value } => Primitive::String { value },
        Char { value } => Primitive::Char { value },
        Bytes { values } => Primitive::Bytes { values },
    }
}

fn collapse_callable(ctx: TypeCtx, value: core::Callable) -> Callable {
    match value {
        Function(name) => Callable::Function(name),
        FunctionInstance { name, bindings: _ } => {
            invalid_type(ctx, "unspecialized generic function: " + name);
            Callable::Function(name)
        },
        LangItem { item, function_name } => Callable::LangItem { item, function_name },
        Runtime(name) => Callable::Runtime(name),
        Intrinsic(name) => Callable::Intrinsic(name),
        GoInterfaceBridge { binding, methods } => Callable::GoInterfaceBridge { binding, methods },
        GoMethod { symbol, binding } => Callable::GoMethod { symbol, binding },
        GoForeign { import_path, symbol, binding } => Callable::GoForeign {
            import_path,
            symbol,
            binding,
        },
        TraitMethod { trait_ref, method_name, for_ty, has_receiver } => Callable::TraitMethod {
            trait_ref: collapse_trait_ref(ctx, trait_ref),
            method_name,
            for_ty: collapse_type(ctx, for_ty),
            has_receiver,
        },
        DynTraitMethod { trait_name, dispatch_name, method_name } => {
            Callable::DynTraitMethod { trait_name, dispatch_name, method_name }
        },
        InherentMethod { receiver_ty, method_name } => {
            Callable::InherentMethod { receiver_ty: collapse_type(ctx, receiver_ty), method_name }
        },
    }
}

fn collapse_closure_params(ctx: TypeCtx, values: Vec[core::ClosureParam]) -> Vec[ClosureParam] {
    let result: Vec[ClosureParam] = Vec::new();
    for value in values {
        result.push(ClosureParam { name: value.name, ty: collapse_type(ctx, value.ty) })
    }
    result
}

fn collapse_function_params(ctx: TypeCtx, values: Vec[(string, core::Type)]) -> Vec[(string, Type)] {
    let result: Vec[(string, Type)] = Vec::new();
    for value in values {
        result.push((value.0, collapse_type(ctx, value.1)))
    }
    result
}

fn mono_types_to_core(values: Vec[Type]) -> Vec[core::Type] {
    let result: Vec[core::Type] = Vec::with_capacity(values.len());
    for value in values {
        result.push(mono_type_to_core(value))
    }
    result
}

fn mono_named_types_to_core(values: Vec[(string, Type)]) -> Vec[(string, core::Type)] {
    let result: Vec[(string, core::Type)] = Vec::with_capacity(values.len());
    for value in values {
        result.push((value.0, mono_type_to_core(value.1)))
    }
    result
}

fn mono_type_to_core(value: Type) -> core::Type {
    match value {
        Unit => core::Type::Unit,
        Never => core::Type::Never,
        Bool => core::Type::Bool,
        Int => core::Type::Int,
        Int8 => core::Type::Int8,
        Int16 => core::Type::Int16,
        Int32 => core::Type::Int32,
        Int64 => core::Type::Int64,
        Uint => core::Type::Uint,
        Uint8 => core::Type::Uint8,
        Uint16 => core::Type::Uint16,
        Uint32 => core::Type::Uint32,
        Uint64 => core::Type::Uint64,
        Float32 => core::Type::Float32,
        Float64 => core::Type::Float64,
        String => core::Type::String,
        Char => core::Type::Char,
        Tuple { items } => core::Type::Tuple { items: mono_types_to_core(items) },
        External { import_path, name, args } => core::Type::External {
            import_path,
            name,
            args: mono_types_to_core(args),
        },
        Named { name } => core::Type::Con { name },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let bounds: Vec[core::DynTraitBound] = Vec::with_capacity(additional_bounds.len());
            for bound in additional_bounds {
                bounds.push(
                    core::DynTraitBound {
                        trait_name: bound.trait_name,
                        args: mono_types_to_core(bound.args),
                        associated_types: mono_named_types_to_core(bound.associated_types),
                    },
                )
            }
            core::Type::Dyn {
                trait_name,
                args: mono_types_to_core(args),
                associated_types: mono_named_types_to_core(associated_types),
                additional_bounds: bounds,
            }
        },
        Array { len, elem } => core::Type::Array { len, elem: mono_type_to_core(elem) },
        Slice { elem } => core::Type::Slice { elem: mono_type_to_core(elem) },
        MutSlice { elem } => core::Type::MutSlice { elem: mono_type_to_core(elem) },
        VecType { elem } => core::Type::VecType { elem: mono_type_to_core(elem) },
        GoPointer { elem } => core::Type::GoPointer { elem: mono_type_to_core(elem) },
        GoFunction { signature } => core::Type::GoFunction {
            signature: mono_type_to_core(signature),
        },
        RefType { elem } => core::Type::RefType { elem: mono_type_to_core(elem) },
        HashMap { key, value } => core::Type::HashMap {
            key: mono_type_to_core(key),
            value: mono_type_to_core(value),
        },
        GoMap { key, value } => core::Type::GoMap {
            key: mono_type_to_core(key),
            value: mono_type_to_core(value),
        },
        Channel { elem, direction } => {
            core::Type::Channel { elem: mono_type_to_core(elem), direction }
        },
        Func { params, ret_ty } => core::Type::Func {
            params: mono_types_to_core(params),
            ret_ty: mono_type_to_core(ret_ty),
        },
    }
}

fn mono_trait_ref_to_core(value: TraitRef) -> core::TraitRef {
    core::TraitRef { name: value.name, args: mono_types_to_core(value.args) }
}

fn core_trait_impl_name(reference: core::TraitRef, for_type: core::Type, method_name: string) -> string {
    let dispatch = if reference.args.is_empty() {
        compact_type(for_type)
    } else {
        let builder = text::StringBuilder::new();
        builder.write_char('[');
        for index in 0..reference.args.len() {
            if index > 0 {
                builder.write_char(',')
            }
            builder.write_string(compact_type(reference.args[index]))
        }
        builder.write_string("]@");
        builder.write_string(compact_type(for_type));
        builder.finish()
    };
    "trait_impl#" + reference.name + "#" + dispatch + "#" + method_name
}

fn lowered_trait_impl_name(reference: TraitRef, for_type: Type, method_name: string) -> string {
    core_trait_impl_name(
        mono_trait_ref_to_core(reference),
        mono_type_to_core(for_type),
        method_name,
    )
}

fn lower_exprs(ctx: TypeCtx, values: Vec[core::Expr]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::new();
    for value in values {
        result.push(lower_expr(ctx, value))
    }
    result
}

fn lower_optional_expr(ctx: TypeCtx, value: Option[core::Expr]) -> Option[Expr] {
    value.map(|expr| lower_expr(ctx, expr))
}

fn lower_arms(ctx: TypeCtx, values: Vec[core::Arm]) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::new();
    for value in values {
        result.push(Arm { lhs: lower_expr(ctx, value.lhs), body: lower_expr(ctx, value.body) })
    }
    result
}

fn lower_block(ctx: TypeCtx, value: core::Block) -> Block {
    let stmts: Vec[LetStmt] = Vec::new();
    for stmt in value.stmts {
        stmts.push(
            LetStmt {
                name: stmt.name,
                value: lower_expr(ctx, stmt.value),
                ty: collapse_type(ctx, stmt.ty),
            },
        )
    }
    Block { stmts, tail: lower_optional_expr(ctx, value.tail) }
}

fn lower_trait_call(
    ctx: TypeCtx,
    reference: core::TraitRef,
    method_name: string,
    instance_name: Option[string],
    for_ty: core::Type,
    receiver: Option[core::Expr],
    args: Vec[core::Expr],
    ty: core::Type,
) -> Expr {
    let reference = collapse_trait_ref(ctx, reference);
    let for_ty = collapse_type(ctx, for_ty);
    let ty = collapse_type(ctx, ty);
    let receiver = lower_optional_expr(ctx, receiver);
    let args = lower_exprs(ctx, args);
    match receiver {
        Some(value) => match expr_type(value) {
            Dyn { trait_name: name, .. } => {
                if reference.args.is_empty() && reference.name == name {
                    Expr::DynCall { trait_name: name, method_name, receiver: value, args, ty }
                } else {
                    lower_static_trait_call(
                        reference,
                        method_name,
                        instance_name,
                        for_ty,
                        Option::Some(value),
                        args,
                        ty,
                    )
                }
            },
            _ => lower_static_trait_call(
                reference,
                method_name,
                instance_name,
                for_ty,
                Option::Some(value),
                args,
                ty,
            ),
        },
        None => lower_static_trait_call(
            reference,
            method_name,
            instance_name,
            for_ty,
            Option::None,
            args,
            ty,
        ),
    }
}

fn lower_static_trait_call(
    reference: TraitRef,
    method_name: string,
    instance_name: Option[string],
    for_ty: Type,
    receiver: Option[Expr],
    args: Vec[Expr],
    ty: Type,
) -> Expr {
    let params: Vec[Type] = Vec::new();
    let call_args: Vec[Expr] = Vec::new();
    if let Some(value) = receiver {
        params.push(expr_type(value));
        call_args.push(value)
    }
    for arg in args {
        params.push(expr_type(arg));
        call_args.push(arg)
    }
    let name = instance_name.unwrap_or_else(
        || lowered_trait_impl_name(reference, for_ty, method_name),
    );
    Expr::Call {
        func: Expr::Var { name, ty: Type::Func { params, ret_ty: ty } },
        args: call_args,
        ty,
    }
}

fn lower_expr(ctx: TypeCtx, value: core::Expr) -> Expr {
    match value {
        Var { name, ty } => Expr::Var { name, ty: collapse_type(ctx, ty) },
        Callable { callable, ty } => {
            Expr::Callable {
                callable: collapse_callable(ctx, callable),
                ty: collapse_type(ctx, ty),
            }
        },
        Prim { value: primitive, ty } => {
            Expr::Prim { value: collapse_primitive(primitive), ty: collapse_type(ctx, ty) }
        },
        Constr { constructor, args, ty } => {
            let ty = collapse_type(ctx, ty);
            Expr::Constr {
                constructor: update_constructor(constructor, ty),
                args: lower_exprs(ctx, args),
                ty,
            }
        },
        Tuple { items, ty } => {
            Expr::Tuple { items: lower_exprs(ctx, items), ty: collapse_type(ctx, ty) }
        },
        Array { items, ty } => {
            Expr::Array { items: lower_exprs(ctx, items), ty: collapse_type(ctx, ty) }
        },
        Closure { params, body, ty } => {
            Expr::Closure {
                params: collapse_closure_params(ctx, params),
                body: lower_expr(ctx, body),
                ty: collapse_type(ctx, ty),
            }
        },
        Block { block, ty } => {
            Expr::Block { block: lower_block(ctx, block), ty: collapse_type(ctx, ty) }
        },
        Match { expr, arms, default, ty } => Expr::Match {
            expr: lower_expr(ctx, expr),
            arms: lower_arms(ctx, arms),
            default: lower_optional_expr(ctx, default),
            ty: collapse_type(ctx, ty),
        },
        Select { mode, arms, default, ty } => {
            let lowered: Vec[SelectArm] = Vec::with_capacity(arms.len());
            for arm in arms {
                lowered.push(
                    match arm {
                        Receive { channel, guard, binding, binding_ty, body } => SelectArm::Receive {
                            channel: lower_expr(ctx, channel),
                            guard: lower_optional_expr(ctx, guard),
                            binding,
                            binding_ty: collapse_type(ctx, binding_ty),
                            body: lower_expr(ctx, body),
                        },
                        Send { channel, value, guard, body } => SelectArm::Send {
                            channel: lower_expr(ctx, channel),
                            value: lower_expr(ctx, value),
                            guard: lower_optional_expr(ctx, guard),
                            body: lower_expr(ctx, body),
                        },
                    },
                )
            }
            Expr::Select {
                mode,
                arms: lowered,
                default: lower_optional_expr(ctx, default),
                ty: collapse_type(ctx, ty),
            }
        },
        If { cond, then_branch, else_branch, ty } => Expr::If {
            cond: lower_expr(ctx, cond),
            then_branch: lower_expr(ctx, then_branch),
            else_branch: lower_expr(ctx, else_branch),
            ty: collapse_type(ctx, ty),
        },
        While { cond, body, ty } => {
            Expr::While {
                cond: lower_expr(ctx, cond),
                body: lower_expr(ctx, body),
                ty: collapse_type(ctx, ty),
            }
        },
        Loop { body, ty } => Expr::Loop { body: lower_expr(ctx, body), ty: collapse_type(ctx, ty) },
        Break { target, value, ty } => Expr::Break {
            target,
            value: lower_optional_expr(ctx, value),
            ty: collapse_type(ctx, ty),
        },
        Continue { target, ty } => Expr::Continue { target, ty: collapse_type(ctx, ty) },
        Return { expr, ty } => {
            Expr::Return { expr: lower_optional_expr(ctx, expr), ty: collapse_type(ctx, ty) }
        },
        Go { expr, ty } => {
            Expr::Go { expr: lower_expr(ctx, expr), ty: collapse_type(ctx, ty) }
        },
        ConstrGet { expr, constructor, field_index, ty } => {
            let expr = lower_expr(ctx, expr);
            let constructor = update_constructor(constructor, expr_type(expr));
            Expr::ConstrGet { expr, constructor, field_index, ty: collapse_type(ctx, ty) }
        },
        Unary { op, expr, ty } => {
            Expr::Unary { op, expr: lower_expr(ctx, expr), ty: collapse_type(ctx, ty) }
        },
        Cast { expr, ty } => {
            Expr::Cast { expr: lower_expr(ctx, expr), ty: collapse_type(ctx, ty) }
        },
        Binary { op, lhs, rhs, ty } => {
            Expr::Binary {
                op,
                lhs: lower_expr(ctx, lhs),
                rhs: lower_expr(ctx, rhs),
                ty: collapse_type(ctx, ty),
            }
        },
        Assign { name, value, target_ty, ty } => {
            Expr::Assign {
                name,
                value: lower_expr(ctx, value),
                target_ty: collapse_type(ctx, target_ty),
                ty: collapse_type(ctx, ty),
            }
        },
        Call { func, args, ty } => {
            Expr::Call {
                func: lower_expr(ctx, func),
                args: lower_exprs(ctx, args),
                ty: collapse_type(ctx, ty),
            }
        },
        ToDyn { trait_name, for_ty, expr, ty } => {
            Expr::ToDyn {
                trait_name,
                for_ty: collapse_type(ctx, for_ty),
                expr: lower_expr(ctx, expr),
                ty: collapse_type(ctx, ty),
            }
        },
        DynCall { trait_name, method_name, receiver, args, ty } => {
            Expr::DynCall {
                trait_name,
                method_name,
                receiver: lower_expr(ctx, receiver),
                args: lower_exprs(ctx, args),
                ty: collapse_type(ctx, ty),
            }
        },
        TraitCall { trait_ref: reference, method_name, instance_name, for_ty, receiver, args, ty } => {
            lower_trait_call(ctx, reference, method_name, instance_name, for_ty, receiver, args, ty)
        },
        Proj { tuple, index, ty } => {
            Expr::Proj { tuple: lower_expr(ctx, tuple), index, ty: collapse_type(ctx, ty) }
        },
    }
}

fn collect_trait_ref_type_names(ctx: TypeCtx, value: core::TraitRef) -> () {
    for arg in value.args {
        collect_type_names(ctx, arg)
    }
}

fn collect_optional_trait_ref_type_names(ctx: TypeCtx, value: Option[core::TraitRef]) -> () {
    if let Some(reference) = value {
        collect_trait_ref_type_names(ctx, reference)
    }
}

fn collect_type_names(ctx: TypeCtx, value: core::Type) -> () {
    match core::resolve_type(value) {
        External { import_path: _, name: _, args: items } => for item in items {
            collect_type_names(ctx, item)
        },
        Tuple { items } => for item in items {
            collect_type_names(ctx, item)
        },
        Con { name } => add_used_type_name(ctx, name),
        Projection { for_ty: base, name: _, trait_ref: reference } => {
            collect_type_names(ctx, base);
            collect_optional_trait_ref_type_names(ctx, reference)
        },
        App { ty: base, args } => {
            collect_type_names(ctx, base);
            for arg in args {
                collect_type_names(ctx, arg)
            }
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => collect_type_names(
            ctx,
            elem,
        ),
        HashMap { key, value } => {
            collect_type_names(ctx, key);
            collect_type_names(ctx, value)
        },
        GoMap { key, value } => {
            collect_type_names(ctx, key);
            collect_type_names(ctx, value)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_type_names(ctx, param)
            }
            collect_type_names(ctx, ret_ty)
        },
        _ => (),
    }
}

fn constructor_owner(name: string) -> string {
    let mut separator = -1;
    if name.byte_len() > 1 {
        for index in 0..name.byte_len() - 1 {
            if text::starts_with_at(name, index, "::") {
                separator = index;
            }
        }
    }
    if separator < 0 {
        name
    } else {
        name.byte_slice(0, separator)
    }
}

fn collect_callable_type_names(ctx: TypeCtx, value: core::Callable) -> () {
    match value {
        TraitMethod { trait_ref: reference, for_ty, .. } => {
            collect_trait_ref_type_names(ctx, reference);
            collect_type_names(ctx, for_ty)
        },
        InherentMethod { receiver_ty: owner, method_name: _ } => collect_type_names(ctx, owner),
        _ => (),
    }
}

fn collect_exprs_type_names(ctx: TypeCtx, values: Vec[core::Expr]) -> () {
    for value in values {
        collect_expr_type_names(ctx, value)
    }
}

fn collect_optional_expr_type_names(ctx: TypeCtx, value: Option[core::Expr]) -> () {
    if let Some(expr) = value {
        collect_expr_type_names(ctx, expr)
    }
}

fn collect_block_type_names(ctx: TypeCtx, value: core::Block) -> () {
    for stmt in value.stmts {
        collect_type_names(ctx, stmt.ty);
        collect_expr_type_names(ctx, stmt.value)
    }
    collect_optional_expr_type_names(ctx, value.tail)
}

fn collect_expr_type_names(ctx: TypeCtx, value: core::Expr) -> () {
    collect_type_names(ctx, core::expr_type(value));
    match value {
        Var { name: _, ty: _ } | Prim { value: _, ty: _ } => (),
        Callable { callable, ty: _ } => collect_callable_type_names(ctx, callable),
        Constr { constructor, args, ty: _ } => {
            add_used_type_name(ctx, constructor_owner(constructor.name));
            collect_exprs_type_names(ctx, args)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } => {
            collect_exprs_type_names(ctx, items)
        },
        Closure { params, body, ty: _ } => {
            for param in params {
                collect_type_names(ctx, param.ty)
            }
            collect_expr_type_names(ctx, body)
        },
        Block { block, ty: _ } => collect_block_type_names(ctx, block),
        Match { expr, arms, default, ty: _ } => {
            collect_expr_type_names(ctx, expr);
            for arm in arms {
                collect_expr_type_names(ctx, arm.lhs);
                collect_expr_type_names(ctx, arm.body)
            }
            collect_optional_expr_type_names(ctx, default)
        },
        Select { arms, default, .. } => {
            for arm in arms {
                match arm {
                    Receive { channel, guard, binding: _, binding_ty, body } => {
                        collect_type_names(ctx, binding_ty);
                        collect_expr_type_names(ctx, channel);
                        collect_optional_expr_type_names(ctx, guard);
                        collect_expr_type_names(ctx, body)
                    },
                    Send { channel, value, guard, body } => {
                        collect_expr_type_names(ctx, channel);
                        collect_expr_type_names(ctx, value);
                        collect_optional_expr_type_names(ctx, guard);
                        collect_expr_type_names(ctx, body)
                    },
                }
            }
            collect_optional_expr_type_names(ctx, default)
        },
        If { cond, then_branch, else_branch, ty: _ } => {
            collect_expr_type_names(ctx, cond);
            collect_expr_type_names(ctx, then_branch);
            collect_expr_type_names(ctx, else_branch)
        },
        While { cond, body, ty: _ } | Binary { op: _, lhs: cond, rhs: body, ty: _ } => {
            collect_expr_type_names(ctx, cond);
            collect_expr_type_names(ctx, body)
        },
        Loop { body, ty: _ } => collect_expr_type_names(ctx, body),
        Break { value, ty: _, .. } => collect_optional_expr_type_names(ctx, value),
        Continue { ty: _, .. } => (),
        Return { expr, ty: _ } => collect_optional_expr_type_names(ctx, expr),
        Go { expr, ty: _ } | Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } | Proj {
            tuple: expr,
            index: _,
            ty: _,
        } => collect_expr_type_names(ctx, expr),
        ConstrGet { expr, constructor, field_index: _, ty: _ } => {
            add_used_type_name(ctx, constructor_owner(constructor.name));
            collect_expr_type_names(ctx, expr)
        },
        Assign { name: _, value, target_ty, ty: _ } => {
            collect_type_names(ctx, target_ty);
            collect_expr_type_names(ctx, value)
        },
        Call { func, args, ty: _ } => {
            collect_expr_type_names(ctx, func);
            collect_exprs_type_names(ctx, args)
        },
        ToDyn { trait_name: _, for_ty, expr, ty: _ } => {
            collect_type_names(ctx, for_ty);
            collect_expr_type_names(ctx, expr)
        },
        DynCall { trait_name: _, method_name: _, receiver, args, ty: _ } => {
            collect_expr_type_names(ctx, receiver);
            collect_exprs_type_names(ctx, args)
        },
        TraitCall { trait_ref: reference, for_ty, receiver, args, .. } => {
            collect_trait_ref_type_names(ctx, reference);
            collect_type_names(ctx, for_ty);
            collect_optional_expr_type_names(ctx, receiver);
            collect_exprs_type_names(ctx, args)
        },
    }
}

fn type_ctx(value: core::File, error: Ref[Option[string]]) -> TypeCtx {
    let ctx = TypeCtx {
        instances: Vec::new(),
        instance_index: HashMap::new(),
        used_names: collections::HashSet::new(),
        enums: value.enums,
        structs: value.structs,
        active_instances: Vec::new(),
        error,
    };
    for function in value.functions {
        add_used_type_name(ctx, function.name);
        for param in function.params {
            collect_type_names(ctx, param.1)
        }
        collect_type_names(ctx, function.ret_ty);
        if let Some(metadata) = function.trait_impl {
            collect_trait_ref_type_names(ctx, metadata.trait_ref);
            collect_type_names(ctx, metadata.for_ty);
            for associated in metadata.associated_types {
                collect_type_names(ctx, associated.1)
            }
        }
        collect_block_type_names(ctx, function.body)
    }
    ctx
}

fn lower_trait_impl(ctx: TypeCtx, value: Option[core::TraitImpl]) -> Option[TraitImpl] {
    value.map(
        |metadata| TraitImpl {
            trait_ref: collapse_trait_ref(ctx, metadata.trait_ref),
            for_ty: collapse_type(ctx, metadata.for_ty),
            associated_types: collapse_named_types(ctx, metadata.associated_types),
        },
    )
}

fn lower_function_origin(ctx: TypeCtx, value: core::FunctionOrigin) -> FunctionOrigin {
    match value {
        Source => FunctionOrigin::Source,
        Inherent { owner, method_name } => FunctionOrigin::Inherent {
            owner: collapse_type(ctx, owner),
            method_name,
        },
        TraitImplementation { method_name } => {
            FunctionOrigin::TraitImplementation { method_name }
        },
    }
}

fn lower_function(ctx: TypeCtx, function: core::Function) -> Function {
    let original_trait_impl = function.trait_impl;
    let trait_impl = lower_trait_impl(ctx, function.trait_impl);
    let origin = lower_function_origin(ctx, function.origin);
    let name = match (original_trait_impl, trait_impl, origin) {
        (Some(original), Some(lowered), FunctionOrigin::TraitImplementation { method_name }) => if function.name
            == core_trait_impl_name(original.trait_ref, original.for_ty, method_name) {
            lowered_trait_impl_name(lowered.trait_ref, lowered.for_ty, method_name)
        } else {
            function.name
        },
        _ => function.name,
    };
    Function {
        name,
        origin,
        root: function.root,
        trait_impl,
        params: collapse_function_params(ctx, function.params),
        ret_ty: collapse_type(ctx, function.ret_ty),
        body: lower_block(ctx, function.body),
    }
}

fn collapse_const_expr(ctx: TypeCtx, value: core::ConstExpr) -> ConstExpr {
    match value {
        Prim { value, ty } => {
            ConstExpr::Prim { value: collapse_primitive(value), ty: collapse_type(ctx, ty) }
        },
        Ref { name, ty } => ConstExpr::Ref { name, ty: collapse_type(ctx, ty) },
        Unary { op, expr, ty } => ConstExpr::Unary {
            op,
            expr: collapse_const_expr(ctx, expr),
            ty: collapse_type(ctx, ty),
        },
        Cast { expr, ty } => {
            ConstExpr::Cast { expr: collapse_const_expr(ctx, expr), ty: collapse_type(ctx, ty) }
        },
        Binary { op, lhs, rhs, ty } => ConstExpr::Binary {
            op,
            lhs: collapse_const_expr(ctx, lhs),
            rhs: collapse_const_expr(ctx, rhs),
            ty: collapse_type(ctx, ty),
        },
        Tuple { items, ty } => ConstExpr::Tuple {
            items: collapse_const_exprs(ctx, items),
            ty: collapse_type(ctx, ty),
        },
        Array { items, ty } => ConstExpr::Array {
            items: collapse_const_exprs(ctx, items),
            ty: collapse_type(ctx, ty),
        },
        Constr { constructor, args, ty } => ConstExpr::Constr {
            constructor: Constructor {
                name: constructor.name,
                fields: constructor.fields,
                is_struct: constructor.is_struct,
                tag: constructor.tag,
            },
            args: collapse_const_exprs(ctx, args),
            ty: collapse_type(ctx, ty),
        },
        Error { ty: _ } => {
            invalid_type(ctx, "error constant cannot enter Mono IR");
            ConstExpr::Prim { value: Primitive::Unit, ty: Type::Unit }
        },
    }
}

fn collapse_const_exprs(ctx: TypeCtx, values: Vec[core::ConstExpr]) -> Vec[ConstExpr] {
    let result: Vec[ConstExpr] = Vec::with_capacity(values.len());
    for value in values {
        result.push(collapse_const_expr(ctx, value))
    }
    result
}

fn collapse_constants(ctx: TypeCtx, values: Vec[core::Constant]) -> Vec[Constant] {
    let result: Vec[Constant] = Vec::with_capacity(values.len());
    for value in values {
        result.push(
            Constant {
                name: value.name,
                ty: collapse_type(ctx, value.ty),
                value: collapse_const_expr(ctx, value.value),
            },
        )
    }
    result
}

fn collapse_statics(ctx: TypeCtx, values: Vec[core::Static]) -> Vec[Static] {
    let result: Vec[Static] = Vec::with_capacity(values.len());
    for value in values {
        result.push(Static { name: value.name, ty: collapse_type(ctx, value.ty) })
    }
    result
}

fn materialize_enum_fields(ctx: TypeCtx, value: core::EnumVariantFields, bindings: Vec[TypeBinding]) -> EnumVariantFields {
    match value {
        Unit => EnumVariantFields::Unit,
        Tuple(values) => {
            let fields: Vec[Type] = Vec::with_capacity(values.len());
            for value in values {
                fields.push(collapse_type(ctx, substitute_type(value, bindings)))
            }
            EnumVariantFields::Tuple(fields)
        },
        Struct(values) => {
            let fields: Vec[(string, Type)] = Vec::with_capacity(values.len());
            for value in values {
                fields.push((value.0, collapse_type(ctx, substitute_type(value.1, bindings))))
            }
            EnumVariantFields::Struct(fields)
        },
    }
}

fn materialize_enum(ctx: TypeCtx, value: core::EnumDef, name: string, bindings: Vec[TypeBinding]) -> EnumDef {
    let variants: Vec[EnumVariantDef] = Vec::with_capacity(value.variants.len());
    for variant in value.variants {
        variants.push(
            EnumVariantDef {
                name: variant.name,
                fields: materialize_enum_fields(ctx, variant.fields, bindings),
            },
        )
    }
    EnumDef { name, variants, option_variants: value.option_variants }
}

fn materialize_struct(
    ctx: TypeCtx,
    value: core::StructDef,
    name: string,
    bindings: Vec[TypeBinding],
) -> StructDef {
    let fields: Vec[(string, Type)] = Vec::with_capacity(value.fields.len());
    for field in value.fields {
        fields.push((field.0, collapse_type(ctx, substitute_type(field.1, bindings))))
    }
    StructDef {
        name,
        fields,
        public_fields: value.public_fields,
        has_hidden_fields: value.has_hidden_fields,
    }
}

fn materialize_definitions(ctx: TypeCtx) -> (Vec[EnumDef], Vec[StructDef]) {
    let enums: Vec[EnumDef] = Vec::new();
    let structs: Vec[StructDef] = Vec::new();
    for value in ctx.enums {
        if value.generics.is_empty() {
            enums.push(materialize_enum(ctx, value, value.name, Vec::new()))
        }
    }
    for value in ctx.structs {
        if value.generics.is_empty() {
            structs.push(materialize_struct(ctx, value, value.name, Vec::new()))
        }
    }
    let mut index = 0;
    while index < ctx.instances.len() {
        let instance = ctx.instances[index];
        let bindings = type_instance_bindings(ctx, instance.base_name, instance.args);
        match find_generic_enum(ctx, instance.base_name) {
            Some(value) => {
                if value.generics.is_empty() {} else {
                    enums.push(materialize_enum(ctx, value, instance.name, bindings))
                }
            },
            None => match find_generic_struct(ctx, instance.base_name) {
                Some(value) => {
                    if value.generics.is_empty() {} else {
                        structs.push(materialize_struct(ctx, value, instance.name, bindings))
                    }
                },
                None => (),
            },
        }
        index += 1;
    };
    (enums, structs)
}

pub fn lower_checked(value: core::File) -> LowerResult {
    lower_with_application_records(value, Vec::new(), Vec::new(), Vec::new())
}

fn lower_with_application_records(
    value: core::File,
    applications: Vec[core::ExternalTypeApplication],
    resolved: Vec[core::ExternalTypeApplication],
    source_names: Vec[(string, string)],
) -> LowerResult {
    let validation = core::validate(value).and_then(
        |_| core::validate_external_applications(value, applications),
    );
    if let Err(message) = validation {
        return LowerResult {
            file: File {
                functions: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                type_instances: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            },
            error: Option::Some("invalid Core IR: " + message),
        }
    }
    let constants = value.constants;
    let statics = value.statics;
    let error = Ref::new(Option::None);
    let value = specialize_with_application_records(
        value,
        error,
        applications,
        resolved,
        source_names,
    );
    let ctx = type_ctx(value, error);
    let source_by_instance: HashMap[string, string] = HashMap::new();
    for source in source_names {
        source_by_instance[source.0] = source.1;
    }
    let functions: Vec[Function] = Vec::new();
    for function in value.functions {
        let lowered = lower_function(ctx, function);
        if lowered.name != function.name {
            source_names.push(
                (lowered.name, source_by_instance[function.name].unwrap_or(function.name)),
            )
        }
        functions.push(lowered)
    }
    let definitions = materialize_definitions(ctx);
    let enums = definitions.0;
    let structs = definitions.1;
    let constants = collapse_constants(ctx, constants);
    let statics = collapse_statics(ctx, statics);
    let type_instances: Vec[TypeInstance] = Vec::new();
    for instance in ctx.instances {
        type_instances.push(
            TypeInstance {
                base_name: instance.base_name,
                args: collapse_types(ctx, instance.args),
                name: instance.name,
            },
        )
    }
    let file = File { functions, enums, structs, type_instances, constants, statics };
    let validation_error = match error.get() {
        Some(message) => Option::Some(message),
        None => match validate(file) {
            Ok(_) => Option::None,
            Err(message) => Option::Some("invalid Mono IR: " + message),
        },
    };
    LowerResult { file, error: validation_error }
}

pub fn lower(value: core::File) -> File {
    lower_checked(value).file
}
