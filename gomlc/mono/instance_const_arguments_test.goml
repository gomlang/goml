package mono;

use std::testing;

#[test]
fn rejects_invalid_forwarded_const_arguments_even_when_unused() -> () {
    for body in["M", "42"] {
        let source = "fn inner[const M: usize]() -> usize { " + body
            + " } fn outer[const N: usize]() -> usize { inner::[{N - 1}]() } fn main() -> () { let _ = outer::[0](); }";
        match lower_checked_source(source).error {
            Some(error) => testing::assert(
                error.contains("const usize argument must be nonnegative"),
            ),
            None => testing::fail("expected invalid forwarded const argument"),
        }
    }
    for expression in["1 / N", "1 % N", "(1 / N) + 1"] {
        let source = "fn inner[const M: usize]() -> i32 { 42 } fn outer[const N: usize]() -> i32 { inner::[{"
            + expression
            + "}]() } fn main() -> () { let _ = outer::[0](); }";
        match lower_checked_source(source).error {
            Some(error) => testing::assert(error.contains("division by zero")),
            None => testing::fail("expected forwarded constant arithmetic error"),
        }
    }
}

#[test]
fn checks_const_arguments_through_nested_forwarding_and_method_values() -> () {
    for source in[
        "fn inner[const M: usize]() -> i32 { 42 } fn middle[const N: usize]() -> i32 { inner::[{N - 1}]() } fn outer[const N: usize]() -> i32 { middle::[N]() } fn main() -> () { let _ = outer::[0](); }",
        "struct Reader {} impl Reader { fn get[const M: usize](self: Reader) -> i32 { 42 } } fn outer[const N: usize]() -> i32 { Reader {}.get::[{N - 1}]() } fn main() -> () { let _ = outer::[0](); }",
        "fn inner[const M: usize]() -> i32 { 42 } fn outer[const N: usize]() -> i32 { let callback = inner::[{N - 1}]; callback() } fn main() -> () { let _ = outer::[0](); }",
    ] {
        match lower_checked_source(source).error {
            Some(error) => testing::assert(
                error.contains("const usize argument must be nonnegative"),
            ),
            None => testing::fail("expected forwarded const argument error"),
        }
    }
}

#[test]
fn accepts_valid_and_uninstantiated_const_argument_forwarding() -> () {
    for source in[
        "fn inner[const M: usize]() -> usize { M } fn outer[const N: usize]() -> usize { inner::[{N - 1}]() } fn main() -> () { let _ = outer::[1](); }",
        "fn inner[const M: usize]() -> usize { M } fn unused[const N: usize]() -> usize { inner::[{N - 1}]() } fn main() -> () {}",
    ] {
        if let Some(error) = lower_checked_source(source).error {
            testing::fail(error)
        }
    }
}
