package mono;

use module::core;

fn projection_layout(ctx: TypeCtx, constructor: core::Constructor, index: isize) -> (
    core::Constructor,
    isize,
) {
    if !constructor.is_struct {
        return (constructor, index)
    }
    let Some(definition) = find_generic_struct(ctx, constructor.name) else {
        return (constructor, index)
    };
    if index < 0 || index >= constructor.fields.len() {
        let _ = invalid_type(ctx, "invalid struct projection for " + constructor.name);
        return (constructor, index)
    }
    let name = constructor.fields[index];
    let fields = Vec::new();
    let mut resolved = Option::None;
    for offset in 0..definition.fields.len() {
        let field = definition.fields[offset];
        fields.push(field.0);
        if field.0 == name {
            resolved = Option::Some(offset);
        }
    }
    match resolved {
        Some(offset) => (core::Constructor { fields, ..constructor }, offset),
        None => {
            let _ = invalid_type(ctx, "unknown struct field " + constructor.name + "::" + name);
            (constructor, index)
        },
    }
}
