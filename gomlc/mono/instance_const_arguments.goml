package mono;

use module::consts;

fn instance_const_argument_error(bindings: Vec[TypeBinding]) -> Option[string] {
    for binding in bindings {
        if consts::parameter_name(binding.name).is_some() {
            match specialized_const_integer(binding.ty) {
                Ok(value) => if value < 0 {
                    return Some(
                        "const usize argument must be nonnegative after generic specialization",
                    )
                },
                Err(message) => return Some(message),
            }
        }
    }
    None
}
