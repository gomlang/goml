package go_ir;

use std::testing;

#[test]
fn file_printing_preserves_empty_files_and_item_separators() -> () {
    testing::assert_eq(encode_package(File { items: Vec::new() }, "empty"), "package empty\n");
    let items = Vec::from_array(
        [
            Item::ImportGroup(Vec::from_array([("fmt", "fmt")])),
            Item::ConstGroup(ConstGroup { specs: Vec::new() }),
            Item::Global(
                Global {
                    name: "message",
                    ty: Some(Type::String),
                    value: Expr::String { value: "中\nword" },
                },
            ),
        ],
    );
    testing::assert_eq(
        encode_package(File { items }, "example"),
        "package example\n\nimport (\n    fmt \"fmt\"\n)\n\nconst (\n\n)\n\nvar message string = \"中\\nword\"\n",
    );
}
