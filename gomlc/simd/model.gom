package simd;

#[derive(PartialEq, Eq)]
pub enum Element {
    F32,
    F64,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
}

#[derive(PartialEq, Eq)]
pub struct VectorType {
    pub element: Element,
    pub lanes: isize,
}

pub fn element_bits(element: Element) -> isize {
    match element {
        I8 | U8 => 8,
        I16 | U16 => 16,
        F32 | I32 | U32 => 32,
        F64 | I64 | U64 => 64,
    }
}

pub fn is_float(element: Element) -> bool {
    element == Element::F32 || element == Element::F64
}

pub fn is_signed(element: Element) -> bool {
    match element {
        I8 | I16 | I32 | I64 => true,
        _ => false,
    }
}

pub fn element_name(element: Element) -> string {
    match element {
        F32 => "f32",
        F64 => "f64",
        I8 => "i8",
        U8 => "u8",
        I16 => "i16",
        U16 => "u16",
        I32 => "i32",
        U32 => "u32",
        I64 => "i64",
        U64 => "u64",
    }
}

pub fn vector_types() -> Vec[VectorType] {
    let result: Vec[VectorType] = Vec::new();
    for element in Vec::from_array(
        [
            Element::F32,
            Element::F64,
            Element::I8,
            Element::U8,
            Element::I16,
            Element::U16,
            Element::I32,
            Element::U32,
            Element::I64,
            Element::U64,
        ],
    ) {
        for width in Vec::from_array([128, 256]) {
            result.push(VectorType { element, lanes: width / element_bits(element) })
        }
    }
    result
}

pub fn vector_name(ty: VectorType) -> string {
    element_name(ty.element) + "x" + ty.lanes.to_string()
}

pub fn mask_name(ty: VectorType) -> string {
    f"mask{element_bits(ty.element)}x{ty.lanes}"
}

pub fn vector_bytes(ty: VectorType) -> isize {
    element_bits(ty.element) * ty.lanes / 8
}

pub fn mask_type(ty: VectorType) -> VectorType {
    let element = match element_bits(ty.element) {
        8 => Element::U8,
        16 => Element::U16,
        32 => Element::U32,
        _ => Element::U64,
    };
    VectorType { element, lanes: ty.lanes }
}

pub fn mask_bytes(ty: VectorType) -> isize {
    if ty.lanes <= 8 {
        1
    } else if ty.lanes <= 16 {
        2
    } else {
        4
    }
}

fn valid_vector(ty: VectorType) -> bool {
    ty.lanes > 0 && (vector_bytes(ty) == 16 || vector_bytes(ty) == 32)
}

#[derive(PartialEq, Eq)]
pub enum ValueKind {
    Vector(VectorType),
    Mask(VectorType),
    Scalar(Element),
}

pub struct Parameter {
    pub name: string,
    pub kind: ValueKind,
}

#[derive(PartialEq, Eq)]
pub enum Operator {
    Add,
    Sub,
    Mul,
    Div,
    Eq,
    Ne,
    Lt,
    Le,
    And,
    Or,
    Xor,
    Min,
    Max,
    SaturatingAdd,
    SaturatingSub,
}

#[derive(PartialEq, Eq)]
pub enum UnaryOperator {
    Not,
    Neg,
    Abs,
    Sqrt,
    Floor,
    Ceil,
    Trunc,
    Round,
    RoundTiesEven,
}

pub enum Node {
    Input(isize),
    Constant {
        ty: VectorType,
        bits: Vec[u64],
    },
    Scalar {
        element: Element,
        bits: u64,
    },
    MaskConstant {
        ty: VectorType,
        bits: u32,
    },
    Binary {
        op: Operator,
        left: isize,
        right: isize,
    },
    Unary {
        op: UnaryOperator,
        value: isize,
    },
    Splat {
        ty: VectorType,
        value: isize,
    },
    Reduce {
        op: Operator,
        value: isize,
    },
    Select {
        mask: isize,
        left: isize,
        right: isize,
    },
    Shuffle {
        left: isize,
        right: isize,
        indices: Vec[isize],
    },
    Convert {
        value: isize,
        to: VectorType,
        bitcast: bool,
    },
    Shift {
        value: isize,
        count: isize,
        left: bool,
    },
    Fma {
        left: isize,
        right: isize,
        addend: isize,
    },
}

pub enum Output {
    Vector(isize),
    Mask(isize),
    Scalar(isize),
    All(isize),
    Any(isize),
}

pub fn operands(node: Node) -> Vec[isize] {
    match node {
        Input(_) | Constant { .. } | Scalar { .. } | MaskConstant { .. } => Vec::new(),
        Binary { left, right, .. } | Shuffle { left, right, .. } => Vec::from_array([left, right]),
        Unary { value, .. } | Splat { value, .. } | Reduce { value, .. } | Convert { value, .. } | Shift {
            value,
            ..,
        } => Vec::from_array([value]),
        Select { mask, left, right } => Vec::from_array([mask, left, right]),
        Fma { left, right, addend } => Vec::from_array([left, right, addend]),
    }
}

pub fn output_node(output: Output) -> isize {
    match output {
        Vector(value) | Mask(value) | Scalar(value) | All(value) | Any(value) => value,
    }
}

pub fn is_comparison(op: Operator) -> bool {
    match op {
        Eq | Ne | Lt | Le => true,
        _ => false,
    }
}

pub fn node_kinds(parameters: Vec[Parameter], nodes: Vec[Node]) -> Option[Vec[ValueKind]] {
    let kinds: Vec[ValueKind] = Vec::new();
    for index in 0..nodes.len() {
        for operand in operands(nodes[index]) {
            if operand < 0 || operand >= index {
                return Option::None
            }
        }
        let kind = match nodes[index] {
            Input(parameter) => {
                if parameter < 0 || parameter >= parameters.len() {
                    return Option::None
                }
                parameters[parameter].kind
            },
            Constant { ty, bits } => {
                if !valid_vector(ty) || bits.len() != ty.lanes {
                    return Option::None
                }
                ValueKind::Vector(ty)
            },
            Scalar { element, .. } => ValueKind::Scalar(element),
            MaskConstant { ty, bits } => {
                if !valid_vector(ty) || ty != mask_type(ty)
                    || bits.to_u64() >= (1.to_u64() << ty.lanes) {
                    return Option::None
                }
                ValueKind::Mask(ty)
            },
            Binary { op, left, right } => {
                if kinds[left] != kinds[right] {
                    return Option::None
                }
                match kinds[left] {
                    Mask(_) if op == Operator::And || op == Operator::Or || op == Operator::Xor => kinds[left],
                    Vector(ty) => {
                        if is_comparison(op) {
                            ValueKind::Mask(mask_type(ty))
                        } else if (op == Operator::Div && !is_float(ty.element))
                            || (is_float(ty.element)
                                && (op == Operator::SaturatingAdd || op == Operator::SaturatingSub)) {
                            return Option::None
                        } else {
                            kinds[left]
                        }
                    },
                    _ => return Option::None,
                }
            },
            Unary { op, value } => match kinds[value] {
                Mask(_) if op == UnaryOperator::Not => kinds[value],
                Vector(ty) if is_float(ty.element) || op == UnaryOperator::Not
                    || op == UnaryOperator::Neg
                    || op == UnaryOperator::Abs => kinds[value],
                _ => return Option::None,
            },
            Splat { ty, value } => {
                if !valid_vector(ty) || kinds[value] != ValueKind::Scalar(ty.element) {
                    return Option::None
                }
                ValueKind::Vector(ty)
            },
            Reduce { op, value } => {
                let ValueKind::Vector(ty) = kinds[value] else {
                    return Option::None
                };
                if op != Operator::Add && op != Operator::Mul && op != Operator::Min
                    && op != Operator::Max
                    && op != Operator::And
                    && op != Operator::Or
                    && op != Operator::Xor {
                    return Option::None
                }
                if is_float(ty.element)
                    && (op == Operator::And || op == Operator::Or || op == Operator::Xor) {
                    return Option::None
                }
                ValueKind::Scalar(ty.element)
            },
            Select { mask, left, right } => {
                let ValueKind::Vector(ty) = kinds[left] else {
                    return Option::None
                };
                if kinds[right] != kinds[left] || kinds[mask] != ValueKind::Mask(mask_type(ty)) {
                    return Option::None
                }
                kinds[left]
            },
            Shuffle { left, right, indices } => {
                let ValueKind::Vector(ty) = kinds[left] else {
                    return Option::None
                };
                if kinds[right] != kinds[left] || indices.len() != ty.lanes {
                    return Option::None
                }
                kinds[left]
            },
            Convert { value, to, bitcast } => {
                let ValueKind::Vector(from) = kinds[value] else {
                    return Option::None
                };
                if !valid_vector(to) || (bitcast && vector_bytes(from) != vector_bytes(to))
                    || (!bitcast && from.lanes != to.lanes) {
                    return Option::None
                }
                ValueKind::Vector(to)
            },
            Shift { value, count, .. } => {
                let ValueKind::Vector(ty) = kinds[value] else {
                    return Option::None
                };
                if is_float(ty.element) || count < 0 {
                    return Option::None
                }
                kinds[value]
            },
            Fma { left, right, addend } => {
                let ValueKind::Vector(ty) = kinds[left] else {
                    return Option::None
                };
                if !is_float(ty.element) || kinds[left] != kinds[right]
                    || kinds[left] != kinds[addend] {
                    return Option::None
                }
                kinds[left]
            },
        };
        match kind {
            Vector(ty) | Mask(ty) if !valid_vector(ty) => return Option::None,
            _ => (),
        }
        kinds.push(kind)
    }
    Option::Some(kinds)
}
