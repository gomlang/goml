package simd;

use std::text;

pub enum Operator {
    Add,
    Sub,
    Mul,
    Div,
}

pub enum Node {
    Input(isize),
    Binary {
        op: Operator,
        left: isize,
        right: isize,
    },
}

fn instruction(op: Operator) -> string {
    match op {
        Add => "ADDPS",
        Sub => "SUBPS",
        Mul => "MULPS",
        Div => "DIVPS",
    }
}

pub fn emit_sse2(name: string, parameters: Vec[string], nodes: Vec[Node], result: isize) -> Option[
    string,
] {
    if result < 0 || result >= nodes.len() || parameters.len() > 8 {
        return Option::None
    }
    let live: Vec[bool] = Vec::new();
    let uses: Vec[isize] = Vec::new();
    let registers: Vec[isize] = Vec::new();
    for _ in nodes {
        live.push(false);
        uses.push(0);
        registers.push(-1);
    }
    live[result] = true;
    uses[result] = 1;
    let mut cursor = nodes.len() - 1;
    while cursor >= 0 {
        if live[cursor] {
            if let Binary { left, right, .. } = nodes[cursor] {
                if left < 0 || right < 0 || left >= cursor || right >= cursor {
                    return Option::None
                }
                live[left] = true;
                live[right] = true;
                uses[left] += 1;
                uses[right] += 1;
            }
        }
        cursor -= 1;
    }
    let occupied: Vec[bool] = Vec::new();
    for _ in 0..16 {
        occupied.push(false)
    }
    let builder = text::StringBuilder::new();
    builder.write_string(f"TEXT ·{name}(SB), 4, $0-{(parameters.len() + 1) * 16}\n");
    for index in 0..nodes.len() {
        if !live[index] {
            continue
        }
        let mut target = -1;
        if let Binary { left, right, .. } = nodes[index] {
            if uses[left] == 1 || (left == right && uses[left] == 2) {
                target = registers[left];
            }
        }
        if target < 0 {
            for register in 0..16 {
                if !occupied[register] {
                    target = register;
                    break
                }
            }
        }
        if target < 0 {
            return Option::None
        }
        occupied[target] = true;
        registers[index] = target;
        match nodes[index] {
            Input(parameter) => {
                if parameter < 0 || parameter >= parameters.len() {
                    return Option::None
                }
                builder.write_string(
                    f"    MOVUPS {parameters[parameter]}+{parameter * 16}(FP), X{target}\n",
                );
            },
            Binary { op, left, right } => {
                let lhs = registers[left];
                let rhs = registers[right];
                if lhs < 0 || rhs < 0 {
                    return Option::None
                }
                if lhs != target {
                    builder.write_string(f"    MOVUPS X{lhs}, X{target}\n");
                }
                builder.write_string(f"    {instruction(op)} X{rhs}, X{target}\n");
                uses[left] -= 1;
                uses[right] -= 1;
                if uses[left] == 0 && lhs != target {
                    occupied[lhs] = false;
                }
                if uses[right] == 0 && rhs != target {
                    occupied[rhs] = false;
                }
            },
        }
    }
    builder.write_string(
        f"    MOVUPS X{registers[result]}, ret+{parameters.len() * 16}(FP)\n    RET\n",
    );
    Option::Some(builder.finish())
}
