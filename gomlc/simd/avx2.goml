package simd;

fn feature_detection_assembly(avx2: bool) -> string {
    let name = if avx2 {
        "avx2"
    } else {
        "fma"
    };
    let minimum = if avx2 {
        7
    } else {
        1
    };
    let flags = if avx2 {
        "0x1c000000"
    } else {
        "0x1c001000"
    };
    let mut assembly = f"TEXT ·_goml_simd_{name}_supported(SB), 4, $0-1\n"
        + "    MOVB $0, ret+0(FP)\n    XORL AX, AX\n    CPUID\n"
        + f"    CMPL AX, ${minimum}\n    JCS unsupported\n"
        + "    MOVL $1, AX\n    CPUID\n"
        + f"    ANDL ${flags}, CX\n    CMPL CX, ${flags}\n    JNE unsupported\n"
        + "    XORL CX, CX\n    XGETBV\n    ANDL $6, AX\n    CMPL AX, $6\n    JNE unsupported\n";
    if avx2 {
        assembly = assembly
            + "    MOVL $7, AX\n    XORL CX, CX\n    CPUID\n    TESTL $0x20, BX\n    JE unsupported\n";
    }
    assembly + "    MOVB $1, ret+0(FP)\nunsupported:\n    RET\n"
}
