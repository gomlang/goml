package simd;

use std::testing;

#[test]
fn rejects_invalid_simd_graphs_and_metadata() -> () {
    testing::assert(
        emit_sse2(
            "invalid",
            Vec::from_array(["a"]),
            Vec::from_array([Node::Input(0), Node::Binary { op: Operator::Add, left: 0, right: 2 }]),
            1,
        ).is_none(),
    );
    testing::assert(
        emit_sse2("invalid", Vec::from_array(["a"]), Vec::from_array([Node::Input(1)]), 0).is_none(),
    );
    testing::assert(
        testing::expect_ok(native_source("package main\n"), "valid scalar source").is_none(),
    );
    testing::assert(native_source("package main" + NATIVE_MARKER + "not_json").is_err());
    testing::assert(native_source("package main" + NATIVE_MARKER + "\"{}\"").is_err());
}

#[test]
fn sse2_register_allocation_preserves_shared_inputs() -> () {
    let output = testing::expect_some(
        emit_sse2(
            "kernel",
            Vec::from_array(["a", "b"]),
            Vec::from_array(
                [
                    Node::Input(0),
                    Node::Input(1),
                    Node::Binary { op: Operator::Add, left: 0, right: 1 },
                    Node::Binary { op: Operator::Mul, left: 2, right: 2 },
                    Node::Binary { op: Operator::Sub, left: 3, right: 0 },
                ],
            ),
            4,
        ),
        "valid SIMD graph",
    );
    testing::assert(output.contains("MOVUPS X0, X2\n"));
    testing::assert(output.contains("ADDPS X1, X2\n"));
    testing::assert(output.contains("MULPS X2, X2\n"));
    testing::assert(output.contains("SUBPS X0, X2\n"));
}
