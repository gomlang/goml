package simd;

use std::json;

pub const NATIVE_MARKER: string = "\nconst _goml_simd_native = ";

pub struct NativeSource {
    pub source: string,
    pub assembly: string,
}

fn native_string(value: json::Value, name: string) -> Result[string, string] {
    json::field(value, name).and_then(|field| json::as_string(field)).ok_or(
        "invalid SIMD metadata field " + name,
    )
}

pub fn native_source(source: string) -> Result[Option[NativeSource], string] {
    let parts = source.split(NATIVE_MARKER);
    if parts.len() == 1 {
        return Result::Ok(Option::None)
    }
    if parts.len() != 2 {
        return Result::Err("duplicate SIMD metadata")
    }
    let encoded = json::parse(parts[1].trim())?;
    let payload = json::as_string(encoded).ok_or("invalid SIMD metadata string")?;
    let metadata = json::parse(payload)?;
    let version = json::field(metadata, "version").and_then(|value| json::as_int(value));
    if version != Option::Some(1) {
        return Result::Err("unsupported SIMD metadata version")
    }
    let kernels = json::field(metadata, "kernels").and_then(|value| json::as_array(value)).ok_or(
        "invalid SIMD kernels",
    )?;
    let mut result = parts[0];
    let mut assembly = "";
    for kernel in kernels {
        let fallback = native_string(kernel, "fallback")?;
        let declaration = native_string(kernel, "declaration")?;
        let body = native_string(kernel, "assembly")?;
        if !fallback.starts_with("func ") || !declaration.starts_with("func ")
            || !body.starts_with("TEXT ·")
            || result.split(fallback).len() != 2 {
            return Result::Err("SIMD kernel does not match generated source")
        }
        result = result.replace(fallback, declaration);
        assembly = assembly + body + "\n";
    }
    if kernels.is_empty() {
        return Result::Err("empty SIMD metadata")
    }
    Result::Ok(Option::Some(NativeSource { source: result + "\n", assembly }))
}
