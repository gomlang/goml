package source;

use std::env;
use std::fs;
use std::path;
use std::process;
use std::testing;

#[test]
fn development_sources_preserve_relative_and_symlink_boundaries() -> () {
    let root = "/tmp/gomlc-source-development";
    let _ = fs::remove_dir_all(root);
    testing::expect_ok(fs::create_dir_all(root + "/module/examples/demo"), "create example");
    let linked = testing::expect_ok(
        process::Command::new("ln").args(
            Vec::from_array(["-s", root + "/module", root + "/linked"]),
        ).output_structured(),
        "link module",
    );
    testing::assert(linked.status().success());
    let cwd = testing::expect_ok(env::current_dir_structured(), "current directory");
    let relative = testing::expect_ok(
        path::relative(cwd, root + "/module/examples/demo/main.goml"),
        "relative source",
    );
    testing::assert(development_source(root + "/module", relative));
    testing::assert(development_source(root + "/module", root + "/linked/examples/demo/main.goml"));
    testing::assert(!development_source(root + "/module", root + "/outside_test.goml"));
    testing::assert(!development_source(root + "/module", root + "/module/main.goml"));
    testing::expect_ok(fs::remove_dir_all(root), "remove source fixture");
}
