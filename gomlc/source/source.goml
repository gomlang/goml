package source;

use std::path;
use std::fs;

pub fn is_source_file(value: string) -> bool {
    value.ends_with(".goml")
}

pub fn is_test_source(value: string) -> bool {
    value.ends_with("_test.goml")
}

pub fn development_source(module_root: string, source_path: string) -> bool {
    let source_path = path::absolute_structured(source_path).unwrap_or(source_path);
    let source_path = match fs::canonicalize(path::parent(source_path).unwrap_or(".")) {
        Ok(parent) => path::join(parent, path::file_name(source_path).unwrap_or("")),
        Err(_) => source_path,
    };
    let module_root = fs::canonicalize(module_root).unwrap_or(module_root);
    let relative = path::relative(module_root, source_path).unwrap_or(source_path);
    if relative.starts_with("../") || path::is_absolute(relative) {
        return false
    }
    is_test_source(relative) || relative.starts_with("tests/") || relative.contains("/tests/")
        || relative.starts_with("examples/")
}
