package project_info;

use std::fs;
use std::testing;

fn write_description_fixture(filename: string, source: string) -> () {
    testing::expect_ok(fs::write_file_structured(filename, source), "write project fixture");
}

#[test]
fn description_cache_tracks_config_changes_and_ignores_source_edits() -> () {
    let root = "/tmp/gomlc-project-info-cache";
    let _ = fs::remove_dir_all(root);
    testing::expect_ok(fs::create_dir_all(root + "/app"), "create app");
    testing::expect_ok(fs::create_dir_all(root + "/leaf"), "create dependency");
    testing::expect_ok(fs::create_dir_all(root + "/other"), "create replacement");
    write_description_fixture(
        root + "/app/goml.toml",
        "[module]\npath = \"demo::app\"\n[dependencies]\n\"demo::leaf\" = { path = \"../leaf\" }\n",
    );
    write_description_fixture(root + "/leaf/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    write_description_fixture(root + "/other/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    let source = root + "/app/main.goml";
    let client = new_client();
    let initial = testing::expect_some(
        testing::expect_ok(load(client, source), "load project"),
        "project",
    );
    testing::assert(initial.error.is_none());
    testing::assert_eq(initial.modules[1].root, root + "/leaf");
    testing::assert(watches_path(client, root + "/app/goml.toml"));
    testing::assert(watches_path(client, root + "/leaf/goml.toml"));
    testing::assert(watches_path(client, root + "/goml.work"));
    testing::assert(!watches_path(client, root + "/app/_artifact/goml.toml"));
    testing::assert(!watches_path(client, source));
    write_description_fixture(source, "package main; fn main() -> () {}");
    let _ = testing::expect_ok(load(client, source), "cached project");
    testing::assert_eq(request_count(client), 1);
    write_description_fixture(
        root + "/goml.work",
        "[workspace]\nmembers = [\"app\", \"leaf\"]\n[replace]\n\"demo::leaf\" = \"other\"\n",
    );
    let replaced = testing::expect_some(
        testing::expect_ok(load(client, source), "reload project"),
        "project",
    );
    testing::assert(replaced.error.is_none());
    testing::assert_eq(replaced.modules[1].root, root + "/other");
    testing::assert_eq(request_count(client), 2);
    write_description_fixture(root + "/other/goml.toml", "[module]\npath = \"demo::wrong\"\n");
    let invalid = testing::expect_some(
        testing::expect_ok(load(client, source), "invalid dependency"),
        "project",
    );
    testing::assert(invalid.error.is_some());
    write_description_fixture(root + "/other/goml.toml", "[module]\npath = \"demo::leaf\"\n");
    let recovered = testing::expect_some(
        testing::expect_ok(load(client, source), "recovered dependency"),
        "project",
    );
    testing::assert(recovered.error.is_none());
    testing::assert_eq(request_count(client), 4);
    testing::expect_ok(fs::remove_dir_all(root), "remove fixture");
}

#[test]
fn malformed_or_incompatible_descriptions_are_recoverable() -> () {
    for source in Vec::from_array(
        [
            "not json",
            "{}",
            "{\"protocol\":2,\"project\":null,\"watched\":[]}",
            "{\"protocol\":1,\"project\":null,\"watched\":[\"relative\"]}",
            "{\"protocol\":1,\"project\":{},\"watched\":[]}",
        ],
    ) {
        testing::assert(decode(source).is_err());
    }
}

#[test]
fn description_cache_keys_preserve_component_boundaries() -> () {
    testing::assert(
        cache_key("/source\n/driver", "/tool", None) != cache_key("/source", "/driver\n/tool", None),
    );
    testing::assert(
        cache_key("/source", "/driver", None) != cache_key("/source", "/driver", Some("")),
    );
    testing::assert_eq(
        cache_key("/source", "/driver", Some("/registry")),
        cache_key("/source", "/driver", Some("/registry")),
    );
}

#[test]
fn descriptions_require_unique_modules_and_matching_root_identity() -> () {
    let module = "{\"name\":\"demo::app\",\"root\":\"/app\",\"dependencies\":[],\"dev_dependencies\":[]}";
    let prefix = "{\"protocol\":1,\"watched\":[],\"project\":{\"root\":\"/app\",\"module\":\"demo::app\",\"target\":\"/app/_artifact\",\"development\":true,\"error\":null,\"modules\":[";
    let source = prefix + module + "]}}";
    testing::assert(decode(source).is_ok());
    testing::assert_eq(
        testing::expect_err(decode(prefix + module + "," + module + "]}}"), "duplicate module"),
        "duplicate project module demo::app",
    );
    testing::assert_eq(
        testing::expect_err(
            decode(source.replace("\"module\":\"demo::app\"", "\"module\":\"demo::missing\"")),
            "missing root module",
        ),
        "project description is missing its root module",
    );
    testing::assert_eq(
        testing::expect_err(
            decode(prefix + module.replace("/app", "/other") + "]}}"),
            "wrong root path",
        ),
        "project description is missing its root module",
    );
}
