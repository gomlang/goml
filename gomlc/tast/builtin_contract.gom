package tast;

use module::hir;

static builtin_contract_cache: OnceCell[Result[BuiltinContract, string]] = OnceCell::new();

pub struct NamedLangItem {
    pub name: string,
}

pub struct FunctionLangItem {
    pub item: string,
    pub name: string,
    pub public_name: Option[string],
}

pub struct MethodLangItem {
    pub name: string,
    pub method: string,
}

pub struct IteratorLangItem {
    pub name: string,
    pub item: string,
    pub next: string,
}

pub struct IntoIteratorLangItem {
    pub name: string,
    pub item: string,
    pub into_iter_type: string,
    pub method: string,
}

pub struct LangVariant {
    pub name: string,
    pub tag: isize,
}

pub struct OptionLangItem {
    pub name: string,
    pub none: LangVariant,
    pub some: LangVariant,
}

pub struct ResultLangItem {
    pub name: string,
    pub ok: LangVariant,
    pub err: LangVariant,
}

pub struct StaticCellLangItem {
    pub name: string,
    pub constructor: string,
}

pub struct CollectionLangItem {
    pub name: string,
    pub from_array: string,
}

pub struct OrderingLangItem {
    pub name: string,
    pub less: LangVariant,
    pub equal: LangVariant,
    pub greater: LangVariant,
    pub partial_ord: string,
    pub partial_cmp: string,
    pub lt: string,
    pub le: string,
    pub gt: string,
    pub ge: string,
    pub ord: string,
    pub cmp: string,
}

pub struct BuiltinContract {
    pub iterator: IteratorLangItem,
    pub into_iterator: IntoIteratorLangItem,
    pub partial_eq: MethodLangItem,
    pub eq: NamedLangItem,
    pub hash: MethodLangItem,
    pub default: MethodLangItem,
    pub to_string: MethodLangItem,
    pub debug: MethodLangItem,
    pub option: OptionLangItem,
    pub result: ResultLangItem,
    pub fn_iterator: NamedLangItem,
    pub static_cell: StaticCellLangItem,
    pub frozen_vec: NamedLangItem,
    pub ordering: OrderingLangItem,
    pub vec: CollectionLangItem,
    pub slice: NamedLangItem,
    pub mut_slice: NamedLangItem,
    pub hashmap: CollectionLangItem,
    pub ref_type: NamedLangItem,
    pub go_function: NamedLangItem,
    pub go_pointer: NamedLangItem,
    pub go_error: NamedLangItem,
    pub go_string: NamedLangItem,
    pub go_map: NamedLangItem,
    pub channel: NamedLangItem,
    pub sender: NamedLangItem,
    pub receiver: NamedLangItem,
    pub range: FunctionLangItem,
    pub range_inclusive: FunctionLangItem,
}

fn required_lang_item(item: string) -> Result[BuiltinLangItem, string] {
    let found: Ref[Option[BuiltinLangItem]] = Ref::new(Option::None);
    let values = builtin_source_lang_items.get_or_init(|| load_builtin_source_lang_items())?;
    for value in values.to_vec() {
        if value.item == item {
            if found.get().is_some() {
                return Result::Err("duplicate builtin lang item " + item)
            } else {
                found.set(Option::Some(value))
            }
        }
    }
    found.get().ok_or("missing builtin lang item " + item)
}

fn required_lang_property(value: BuiltinLangItem, property: string) -> Result[string, string] {
    let found: Ref[Option[string]] = Ref::new(Option::None);
    for entry in value.properties {
        if entry.0 == property {
            if found.get().is_some() {
                return Result::Err(
                    "duplicate property " + property + " on builtin lang item " + value.item,
                )
            } else if entry.1.byte_len() == 0 {
                return Result::Err(
                    "empty property " + property + " on builtin lang item " + value.item,
                )
            } else {
                found.set(Option::Some(entry.1))
            }
        }
    }
    found.get().ok_or("missing property " + property + " on builtin lang item " + value.item)
}

fn optional_lang_property(value: BuiltinLangItem, property: string) -> Result[
    Option[string],
    string,
] {
    for entry in value.properties {
        if entry.0 == property {
            if entry.1.byte_len() == 0 {
                return Result::Err(
                    "empty property " + property + " on builtin lang item " + value.item,
                )
            } else {
                return Result::Ok(Option::Some(entry.1))
            }
        }
    }
    Result::Ok(Option::None)
}

fn validate_lang_properties(value: BuiltinLangItem, allowed: Vec[string]) -> Result[(), string] {
    for property in value.properties {
        if !allowed.contains(property.0) {
            return Result::Err(
                "unknown property " + property.0 + " on builtin lang item " + value.item,
            )
        }
    }
    Result::Ok(())
}

fn required_trait_lang_item(item: string) -> Result[BuiltinLangItem, string] {
    let value = required_lang_item(item)?;
    if value.kind == BuiltinLangItemKind::Trait {
        Result::Ok(value)
    } else {
        Result::Err("builtin lang item " + item + " must name a trait")
    }
}

fn required_trait_method(value: BuiltinLangItem, property: string) -> Result[string, string] {
    let name = required_lang_property(value, property)?;
    for method in value.methods {
        if method == name {
            return Result::Ok(name)
        }
    }
    Result::Err(
        "property " + property + " on builtin lang item " + value.item
            + " names missing trait method "
            + name,
    )
}

fn required_associated_type(value: BuiltinLangItem, property: string) -> Result[string, string] {
    let name = required_lang_property(value, property)?;
    for associated in value.associated_types {
        if associated == name {
            return Result::Ok(name)
        }
    }
    Result::Err(
        "property " + property + " on builtin lang item " + value.item
            + " names missing associated type "
            + name,
    )
}

fn required_enum_lang_item(item: string) -> Result[BuiltinLangItem, string] {
    let value = required_lang_item(item)?;
    if value.kind == BuiltinLangItemKind::Enum {
        Result::Ok(value)
    } else {
        Result::Err("builtin lang item " + item + " must name an enum")
    }
}

fn required_lang_variant(value: BuiltinLangItem, property: string, arity: isize) -> Result[
    LangVariant,
    string,
] {
    let name = required_lang_property(value, property)?;
    for index in 0..value.variants.len() {
        if value.variants[index] == name {
            if value.variant_arities[index] == arity {
                return Result::Ok(LangVariant { name, tag: index })
            } else {
                return Result::Err(
                    "variant " + name + " on builtin lang item " + value.item + " has invalid arity",
                )
            }
        }
    }
    Result::Err(
        "property " + property + " on builtin lang item " + value.item
            + " names missing enum variant "
            + name,
    )
}

fn required_named_lang_item(item: string, kind: BuiltinLangItemKind) -> Result[
    NamedLangItem,
    string,
] {
    let value = required_lang_item(item)?;
    validate_lang_properties(value, Vec::new())?;
    if value.kind == kind {
        Result::Ok(NamedLangItem { name: value.name })
    } else {
        Result::Err(
            "builtin lang item " + item + " must be declared on a "
                + builtin_lang_item_kind_name(kind),
        )
    }
}

fn required_function_lang_item(item: string) -> Result[FunctionLangItem, string] {
    let value = required_lang_item(item)?;
    validate_lang_properties(value, Vec::from_array(["public_name"]))?;
    if value.kind == BuiltinLangItemKind::Function {
        Result::Ok(
            FunctionLangItem {
                item: value.item,
                name: value.name,
                public_name: optional_lang_property(value, "public_name")?,
            },
        )
    } else {
        Result::Err("builtin lang item " + item + " must be declared on a function")
    }
}

fn required_collection_lang_item(item: string) -> Result[CollectionLangItem, string] {
    let value = required_lang_item(item)?;
    validate_lang_properties(value, Vec::from_array(["from_array"]))?;
    if value.kind == BuiltinLangItemKind::Impl {
        Result::Ok(
            CollectionLangItem {
                name: value.name,
                from_array: required_lang_property(value, "from_array")?,
            },
        )
    } else {
        Result::Err("builtin lang item " + item + " must be declared on a impl")
    }
}

fn required_method_lang_item(item: string) -> Result[MethodLangItem, string] {
    let value = required_trait_lang_item(item)?;
    validate_lang_properties(value, Vec::from_array(["method"]))?;
    Result::Ok(MethodLangItem { name: value.name, method: required_trait_method(value, "method")? })
}

fn builtin_inherent_method_exists(owner: string, method: string) -> Result[bool, string] {
    for file in implicit_builtin_hir_files()? {
        for item in file.items {
            if let hir::Item::ImplBlock(value) = item {
                if let Some(name) = builtin_lang_item_type_name(value.for_type) {
                    if short_name(name) == owner {
                        for candidate in value.methods {
                            if candidate.name == method {
                                return Result::Ok(true)
                            }
                        }
                    }
                }
            }
        }
    }
    Result::Ok(false)
}

fn load_builtin_contract() -> Result[BuiltinContract, string] {
    let iterator_value = required_trait_lang_item("iterator")?;
    validate_lang_properties(iterator_value, Vec::from_array(["item", "next"]))?;
    let iterator = IteratorLangItem {
        name: iterator_value.name,
        item: required_associated_type(iterator_value, "item")?,
        next: required_trait_method(iterator_value, "next")?,
    };
    let into_iterator_value = required_trait_lang_item("into_iterator")?;
    validate_lang_properties(
        into_iterator_value,
        Vec::from_array(["item", "into_iter_type", "method"]),
    )?;
    let into_iterator = IntoIteratorLangItem {
        name: into_iterator_value.name,
        item: required_associated_type(into_iterator_value, "item")?,
        into_iter_type: required_associated_type(into_iterator_value, "into_iter_type")?,
        method: required_trait_method(into_iterator_value, "method")?,
    };
    let option_value = required_enum_lang_item("option")?;
    validate_lang_properties(option_value, Vec::from_array(["none", "some"]))?;
    let option = OptionLangItem {
        name: option_value.name,
        none: required_lang_variant(option_value, "none", 0)?,
        some: required_lang_variant(option_value, "some", 1)?,
    };
    let result_value = required_enum_lang_item("result")?;
    validate_lang_properties(result_value, Vec::from_array(["ok", "err"]))?;
    let result = ResultLangItem {
        name: result_value.name,
        ok: required_lang_variant(result_value, "ok", 1)?,
        err: required_lang_variant(result_value, "err", 1)?,
    };
    let static_cell_value = required_lang_item("static_cell")?;
    validate_lang_properties(static_cell_value, Vec::from_array(["constructor"]))?;
    if static_cell_value.kind != BuiltinLangItemKind::Struct {
        return Result::Err("builtin lang item static_cell must be declared on a struct")
    }
    let static_cell_constructor = required_lang_property(static_cell_value, "constructor")?;
    if !builtin_inherent_method_exists(static_cell_value.name, static_cell_constructor)? {
        return Result::Err(
            "property constructor on builtin lang item static_cell names missing inherent method "
                + static_cell_constructor,
        )
    }
    let ordering_value = required_enum_lang_item("ordering")?;
    validate_lang_properties(
        ordering_value,
        Vec::from_array(
            [
                "less",
                "equal",
                "greater",
                "partial_ord",
                "partial_cmp",
                "lt",
                "le",
                "gt",
                "ge",
                "ord",
                "cmp",
            ],
        ),
    )?;
    let ordering = OrderingLangItem {
        name: ordering_value.name,
        less: required_lang_variant(ordering_value, "less", 0)?,
        equal: required_lang_variant(ordering_value, "equal", 0)?,
        greater: required_lang_variant(ordering_value, "greater", 0)?,
        partial_ord: required_lang_property(ordering_value, "partial_ord")?,
        partial_cmp: required_lang_property(ordering_value, "partial_cmp")?,
        lt: required_lang_property(ordering_value, "lt")?,
        le: required_lang_property(ordering_value, "le")?,
        gt: required_lang_property(ordering_value, "gt")?,
        ge: required_lang_property(ordering_value, "ge")?,
        ord: required_lang_property(ordering_value, "ord")?,
        cmp: required_lang_property(ordering_value, "cmp")?,
    };
    Result::Ok(
        BuiltinContract {
            iterator,
            into_iterator,
            partial_eq: required_method_lang_item("partial_eq")?,
            eq: required_named_lang_item("eq", BuiltinLangItemKind::Trait)?,
            hash: required_method_lang_item("hash")?,
            default: required_method_lang_item("default")?,
            to_string: required_method_lang_item("to_string")?,
            debug: required_method_lang_item("debug")?,
            option,
            result,
            fn_iterator: required_named_lang_item("fn_iterator", BuiltinLangItemKind::Struct)?,
            static_cell: StaticCellLangItem {
                name: static_cell_value.name,
                constructor: static_cell_constructor,
            },
            frozen_vec: required_named_lang_item("frozen_vec", BuiltinLangItemKind::Struct)?,
            ordering,
            vec: required_collection_lang_item("vec")?,
            slice: required_named_lang_item("slice", BuiltinLangItemKind::Impl)?,
            mut_slice: required_named_lang_item("mut_slice", BuiltinLangItemKind::Impl)?,
            hashmap: required_collection_lang_item("hashmap")?,
            ref_type: required_named_lang_item("ref", BuiltinLangItemKind::Impl)?,
            go_function: required_named_lang_item("go_func", BuiltinLangItemKind::TypeAlias)?,
            go_pointer: required_named_lang_item("go_ptr", BuiltinLangItemKind::Struct)?,
            go_error: required_named_lang_item("go_error", BuiltinLangItemKind::TypeAlias)?,
            go_map: required_named_lang_item("go_map", BuiltinLangItemKind::TypeAlias)?,
            go_string: required_named_lang_item("go_string", BuiltinLangItemKind::TypeAlias)?,
            channel: required_named_lang_item("channel", BuiltinLangItemKind::Impl)?,
            sender: required_named_lang_item("sender", BuiltinLangItemKind::Impl)?,
            receiver: required_named_lang_item("receiver", BuiltinLangItemKind::Impl)?,
            range: required_function_lang_item("range")?,
            range_inclusive: required_function_lang_item("range_inclusive")?,
        },
    )
}

pub fn builtin_contract() -> Result[BuiltinContract, string] {
    builtin_contract_cache.get_or_init(|| load_builtin_contract())
}
