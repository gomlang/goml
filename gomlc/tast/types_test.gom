package tast;

use module::ast;
use module::hir;
use std::testing;

fn collect_environment(file: hir::File, allow_externs: bool, builtin: BuiltinContract) -> Checker {
    collect_environment_with_external_aliases(file, allow_externs, builtin, Vec::new())
}

fn occurs_test_dyn_types(value: Type) -> Vec[Type] {
    Vec::from_array(
        [
            Type::Dyn {
                trait_name: "Consumer",
                args: Vec::from_array([Type::Int, value]),
                associated_types: Vec::new(),
                additional_bounds: Vec::new(),
            },
            Type::Dyn {
                trait_name: "Source",
                args: Vec::new(),
                associated_types: Vec::from_array([("First", Type::Int), ("Item", value)]),
                additional_bounds: Vec::new(),
            },
            Type::Dyn {
                trait_name: "Display",
                args: Vec::new(),
                associated_types: Vec::new(),
                additional_bounds: Vec::from_array(
                    [
                        DynTraitBound {
                            trait_name: "Consumer",
                            args: Vec::from_array([Type::Int, value]),
                            associated_types: Vec::new(),
                        },
                    ],
                ),
            },
            Type::Dyn {
                trait_name: "Display",
                args: Vec::new(),
                associated_types: Vec::new(),
                additional_bounds: Vec::from_array(
                    [
                        DynTraitBound {
                            trait_name: "Source",
                            args: Vec::new(),
                            associated_types: Vec::from_array(
                                [("First", Type::Int), ("Item", value)],
                            ),
                        },
                    ],
                ),
            },
        ],
    )
}

#[test]
fn occurs_check_rejects_recursive_dyn_types_without_binding() -> () {
    let counter = Ref::new(0);
    let variable = fresh_type(counter, VarKind::Any);
    for value in occurs_test_dyn_types(variable) {
        testing::assert_eq(
            first_unification_error(variable, value).unwrap_or("missing diagnostic"),
            "Type inference failed: recursive type",
        );
        testing::assert(!unify(variable, value));
        testing::assert(!unify(value, variable));
        testing::assert(
            match prune(variable) {
                Var(reference) => match reference.get() {
                    Unbound { id: _, kind: _ } => true,
                    Link(_) => false,
                },
                _ => false,
            },
        );
    }
    testing::assert(unify(variable, Type::Int));
}

#[test]
fn occurs_check_follows_links_inside_nested_dyn_types() -> () {
    let counter = Ref::new(0);
    let variable = fresh_type(counter, VarKind::Any);
    let alias = fresh_type(counter, VarKind::Any);
    testing::assert(unify(alias, variable));
    let nested = Type::Func { params: Vec::new(), ret_ty: Type::RefType { elem: alias } };
    for value in occurs_test_dyn_types(nested) {
        let outer = Type::Tuple { items: Vec::from_array([Type::Int, value]) };
        testing::assert(!unify(variable, outer));
    }
    testing::assert(unify(variable, Type::String));
    testing::assert(types_equal(resolve_type(alias), Type::String));
}

#[test]
fn occurs_check_accepts_dyn_types_with_independent_variables() -> () {
    let counter = Ref::new(0);
    let inner = fresh_type(counter, VarKind::Any);
    for value in occurs_test_dyn_types(inner) {
        let variable = fresh_type(counter, VarKind::Any);
        testing::assert(first_unification_error(variable, value).is_none());
        testing::assert(unify(variable, value));
        testing::assert(types_equal(prune(variable), value));
    }
    testing::assert(unify(inner, Type::Bool));
}

fn traversal_test_types(value: Type) -> Vec[Type] {
    let values = occurs_test_dyn_types(value);
    values.push(Type::Tuple { items: Vec::from_array([Type::Int, value]) });
    values.push(Type::External { import_path: "test", name: "Box", args: Vec::from_array([value]) });
    values.push(Type::App { ty: value, args: Vec::new() });
    values.push(Type::App { ty: Type::Con { name: "Box" }, args: Vec::from_array([value]) });
    values.push(Type::Projection { for_ty: value, name: "Item", trait_ref: Option::None });
    values.push(
        Type::Projection {
            for_ty: Type::Int,
            name: "Item",
            trait_ref: Option::Some(TraitRef { name: "Source", args: Vec::from_array([value]) }),
        },
    );
    values.push(Type::Array { len: 1, elem: value });
    values.push(Type::Slice { elem: value });
    values.push(Type::MutSlice { elem: value });
    values.push(Type::VecType { elem: value });
    values.push(Type::GoPointer { elem: value });
    values.push(Type::GoFunction { signature: value });
    values.push(Type::RefType { elem: value });
    values.push(Type::Channel { elem: value, direction: ast::ChannelDirection::Both });
    values.push(Type::HashMap { key: value, value: Type::Int });
    values.push(Type::HashMap { key: Type::Int, value });
    values.push(Type::GoMap { key: value, value: Type::Int });
    values.push(Type::GoMap { key: Type::Int, value });
    values.push(Type::Func { params: Vec::from_array([value]), ret_ty: Type::Int });
    values.push(Type::Func { params: Vec::new(), ret_ty: value });
    values
}

#[test]
fn type_traversal_finds_nested_inference_variables_and_parameters() -> () {
    let counter = Ref::new(0);
    let variable = fresh_type(counter, VarKind::Any);
    for value in traversal_test_types(variable) {
        testing::assert(contains_unbound_type_variable(value));
        testing::assert(!type_is_concrete(value));
        testing::assert(!unify(variable, value));
        testing::assert(!type_contains_parameter(value, "T"));
        testing::assert(!type_contains_error(value));
    }
    testing::assert(unify(variable, Type::Int));
    for value in traversal_test_types(variable) {
        testing::assert(!contains_unbound_type_variable(value));
        testing::assert(type_is_concrete(value));
    }
    for value in traversal_test_types(Type::Param { name: "T" }) {
        testing::assert(type_contains_parameter(value, "T"));
        testing::assert(!type_contains_parameter(value, "U"));
        testing::assert(!type_is_concrete(value));
        testing::assert(!contains_unbound_type_variable(value));
    }
}

#[test]
fn type_traversal_finds_nested_errors_including_qualified_projections() -> () {
    let nested = Type::RefType { elem: Type::Error };
    for value in traversal_test_types(nested) {
        testing::assert(type_contains_error(value));
    }
    for value in traversal_test_types(Type::Int) {
        testing::assert(!type_contains_error(value));
    }
}

#[test]
fn parameter_aliases_reject_cycles_through_dyn_types() -> () {
    let parameter = Type::Param { name: "T" };
    let alias = Type::Param { name: "U" };
    for value in occurs_test_dyn_types(alias) {
        let substitutions: Vec[TypeSubst] = Vec::new();
        testing::assert(bind_parameter_alias("U", parameter, substitutions));
        testing::assert(contains_parameter(value, "T", substitutions));
        testing::assert(!bind_parameter_alias("T", value, substitutions));
        testing::assert_eq(substitutions.len(), 1);
        testing::assert(bind_parameter_alias("T", Type::Int, substitutions));
        testing::assert(types_equal(resolve_parameter_alias(alias, substitutions), Type::Int));
    }
    for value in occurs_test_dyn_types(Type::Param { name: "V" }) {
        let substitutions: Vec[TypeSubst] = Vec::new();
        testing::assert(bind_parameter_alias("T", value, substitutions));
        testing::assert_eq(substitutions.len(), 1);
    }
}

#[test]
fn unresolved_projections_are_found_inside_dyn_bindings() -> () {
    let variable = fresh_type(Ref::new(0), VarKind::Any);
    let projections = Vec::from_array(
        [
            Type::Projection { for_ty: variable, name: "Item", trait_ref: Option::None },
            Type::Projection {
                for_ty: Type::Int,
                name: "Item",
                trait_ref: Option::Some(
                    TraitRef { name: "Source", args: Vec::from_array([variable]) },
                ),
            },
        ],
    );
    for projection in projections {
        for value in traversal_test_types(projection) {
            testing::assert(has_unresolved_projection(value));
        }
    }
    testing::assert(unify(variable, Type::Int));
    for projection in projections {
        for value in traversal_test_types(projection) {
            testing::assert(!has_unresolved_projection(value));
        }
    }
}

#[test]
fn unresolved_inference_marks_all_nested_variables_once() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let file = dependency_hir("package api;", "test::api");
    let ctx = collect_environment(file, false, builtin);
    let first = fresh_type(ctx.counter, VarKind::Any);
    let second = fresh_type(ctx.counter, VarKind::Any);
    let numeric = fresh_type(ctx.counter, VarKind::Integer);
    let pair = Type::Tuple { items: Vec::from_array([first, numeric, second]) };
    for value in traversal_test_types(pair) {
        testing::assert(!contains_unresolved_inference(ctx, value));
        mark_unresolved_inference_type(ctx, value);
        testing::assert(contains_unresolved_inference(ctx, first));
        testing::assert(contains_unresolved_inference(ctx, second));
        testing::assert(!contains_unresolved_inference(ctx, numeric));
        testing::assert(contains_unresolved_inference(ctx, value));
        testing::assert_eq(ctx.unresolved_inference_vars.len(), 2);
        mark_unresolved_inference_type(ctx, value);
        testing::assert_eq(ctx.unresolved_inference_vars.len(), 2);
        ctx.unresolved_inference_vars.truncate(0);
    }
}

#[test]
fn unresolved_inference_preserves_markers_through_variable_links() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let file = dependency_hir("package api;", "test::api");
    let ctx = collect_environment(file, false, builtin);
    let variable = fresh_type(ctx.counter, VarKind::Any);
    let alias = fresh_type(ctx.counter, VarKind::Any);
    testing::assert(unify(alias, variable));
    mark_unresolved_inference_type(ctx, alias);
    testing::assert(unify(variable, Type::Int));
    for value in traversal_test_types(alias) {
        testing::assert(contains_unresolved_inference(ctx, value));
    }
    testing::assert(!contains_unresolved_inference(ctx, Type::Int));
}

#[test]
fn bounded_type_combinations_preserve_substitution_and_recover_from_occurs_failures() -> () {
    let count = traversal_test_types(Type::Int).len();
    for outer in 0..count {
        for inner in 0..count {
            let parameter = traversal_test_types(Type::Param { name: "T" })[inner];
            let parameter = traversal_test_types(parameter)[outer];
            let concrete = traversal_test_types(Type::Int)[inner];
            let concrete = traversal_test_types(concrete)[outer];
            let substituted = substitute_params(
                parameter,
                Vec::from_array(["T"]),
                Vec::from_array([Type::Int]),
            );
            if !types_equal(substituted, concrete) {
                testing::fail(
                    "substitution mismatch: " + outer.to_string() + ":" + inner.to_string(),
                )
            }
            testing::assert(!type_contains_parameter(substituted, "T"));
            testing::assert(type_is_concrete(substituted));
            let variable = fresh_type(Ref::new(0), VarKind::Any);
            let nested = traversal_test_types(variable)[inner];
            let nested = traversal_test_types(nested)[outer];
            testing::assert(type_contains_error(resolve_type(nested)));
            testing::assert(!unify(variable, nested));
            testing::assert(contains_unbound_type_variable(variable));
            testing::assert(unify(variable, Type::Int));
            testing::assert(types_equal(resolve_type(nested), concrete));
            let numeric = fresh_type(Ref::new(0), VarKind::Integer);
            let numeric_nested = traversal_test_types(numeric)[inner];
            let numeric_nested = traversal_test_types(numeric_nested)[outer];
            testing::assert(types_equal(default_numeric_type(numeric_nested), concrete));
            testing::assert(types_equal(prune(numeric), Type::Int));
            let error = traversal_test_types(Type::Error)[inner];
            testing::assert(type_contains_error(traversal_test_types(error)[outer]));
        }
    }
}
