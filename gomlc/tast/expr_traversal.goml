package tast;

fn map_exprs(values: Vec[Expr], transform: (Expr) -> Expr) -> Vec[Expr] {
    let result = Vec::new();
    for value in values {
        result.push(transform(value))
    }
    result
}

pub fn map_block_exprs(value: Block, transform: (Expr) -> Expr) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in value.stmts {
        stmts.push(
            match stmt {
                Defer { expr } => Defer { expr: transform(expr) },
                Let { is_mut, pat, value } => Let { is_mut, pat, value: transform(value) },
                LetElse { is_mut, pat, value, else_branch } => LetElse {
                    is_mut,
                    pat,
                    value: transform(value),
                    else_branch: transform(else_branch),
                },
                Assign { target, op, value } => Assign {
                    target: transform(target),
                    op,
                    value: transform(value),
                },
                Expr { expr } => Stmt::Expr { expr: transform(expr) },
            },
        )
    }
    Block { stmts, tail: value.tail.map(transform) }
}

pub fn map_child_exprs(value: Expr, transform: (Expr) -> Expr) -> Expr {
    match value {
        Var { .. } | Callable { .. } | Prim { .. } | Continue { .. } => value,
        Constr { constructor, args, ty } => Constr {
            constructor,
            args: map_exprs(args, transform),
            ty,
        },
        Tuple { items, ty } => Tuple { items: map_exprs(items, transform), ty },
        Array { items, ty } => Array { items: map_exprs(items, transform), ty },
        Closure { params, body, ty } => Closure { params, body: transform(body), ty },
        Block { block, ty } => Expr::Block { block: map_block_exprs(block, transform), ty },
        Comptime { site_id, source_path, start, end, origins, body, ty } => Comptime {
            site_id,
            source_path,
            start,
            end,
            origins,
            body: transform(body),
            ty,
        },
        Match { expr, arms, coverage, ty } => {
            let expr = transform(expr);
            let mapped: Vec[Arm] = Vec::new();
            for arm in arms {
                mapped.push(
                    Arm { pat: arm.pat, guard: arm.guard.map(transform), body: transform(arm.body) },
                )
            }
            Match { expr, arms: mapped, coverage, ty }
        },
        Select { mode, arms, ty } => {
            let mapped: Vec[SelectArm] = Vec::new();
            for arm in arms {
                mapped.push(
                    match arm {
                        Receive { channel, guard, binding, binding_ty, body } => Receive {
                            channel: transform(channel),
                            guard: guard.map(transform),
                            binding,
                            binding_ty,
                            body: transform(body),
                        },
                        Send { channel, value, guard, body } => Send {
                            channel: transform(channel),
                            value: transform(value),
                            guard: guard.map(transform),
                            body: transform(body),
                        },
                        Default { body } => Default { body: transform(body) },
                    },
                )
            }
            Select { mode, arms: mapped, ty }
        },
        If { cond, then_branch, else_branch, ty } => If {
            cond: transform(cond),
            then_branch: transform(then_branch),
            else_branch: transform(else_branch),
            ty,
        },
        While { cond, body, ty } => While { cond: transform(cond), body: transform(body), ty },
        Loop { body, ty } => Loop { body: transform(body), ty },
        For { pat, iterator, into_iter_trait_ref, iterator_trait_ref, iterator_ty, body, ty } => For {
            pat,
            iterator: transform(iterator),
            into_iter_trait_ref,
            iterator_trait_ref,
            iterator_ty,
            body: transform(body),
            ty,
        },
        Break { target, value, ty } => Break { target, value: value.map(transform), ty },
        Return { expr, ty } => Return { expr: expr.map(transform), ty },
        Go { expr, ty } => Go { expr: transform(expr), ty },
        Call { func, args, ty } => {
            let args = map_exprs(args, transform);
            Call { func: transform(func), args, ty }
        },
        Unary { op, expr, ty } => Unary { op, expr: transform(expr), ty },
        Cast { expr, ty } => Cast { expr: transform(expr), ty },
        Proj { tuple, index, ty } => Proj { tuple: transform(tuple), index, ty },
        Field { expr, field_name, ty } => Field { expr: transform(expr), field_name, ty },
        Index { base, index, ty } => Expr::Index {
            base: transform(base),
            index: transform(index),
            ty,
        },
        Binary { op, lhs, rhs, ty, resolution } => Binary {
            op,
            lhs: transform(lhs),
            rhs: transform(rhs),
            ty,
            resolution,
        },
        ToDyn { trait_name, for_ty, expr, ty } => ToDyn {
            trait_name,
            for_ty,
            expr: transform(expr),
            ty,
        },
    }
}
