package tast;

use std::testing;

#[test]
fn syntax_extensions_while_conditions_reject_direct_loop_control() -> () {
    for source in Vec::from_array(
        [
            "fn f() -> () { while let Some(x) = (if true { break; } else { Option::Some(1) }) {} }",
            "fn f() -> () { while let Some(x) = (if true { break; } else { Option::Some(1) }) && x > 0 {} }",
            "fn f() -> () { while let Some(x) = Option::Some(1) && (if true { break; } else { true }) {} }",
        ],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(source),
                "`break` is not allowed in a while condition",
            ),
        )
    }
    for source in Vec::from_array(
        [
            "fn f() -> () { while let Some(x) = (if true { continue; } else { Option::Some(1) }) {} }",
            "fn f() -> () { while let Some(x) = (if true { continue; } else { Option::Some(1) }) && x > 0 {} }",
            "fn f() -> () { while let Some(x) = Option::Some(1) && (if true { continue; } else { true }) {} }",
        ],
    ) {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(source),
                "`continue` is not allowed in a while condition",
            ),
        )
    }
}

#[test]
fn syntax_extensions_while_conditions_allow_nested_loop_control() -> () {
    syntax_extensions_valid(
        "fn f(again: bool) -> () { while let Some(x) = (loop { if again { continue; } break Option::Some(1); }) { if x > 0 { break; } continue; } }",
    );
    syntax_extensions_valid(
        "fn f(again: bool) -> () { while let Some(x) = (loop { if again { continue; } break Option::Some(1); }) && (loop { if x < 0 { continue; } break x > 0; }) { if x > 0 { break; } continue; } }",
    );
    syntax_extensions_valid(
        "fn f(value: Option[isize]) -> () { while true { if let Some(x) = value && (if x > 0 { break; } else { true }) {} } }",
    )
}
