package tast;

fn invalid_go_function_signature(ctx: Checker, value: Type) -> Option[string] {
    let children: Vec[Type] = Vec::new();
    match prune(normalize_type(ctx, value)) {
        GoFunction { signature } => {
            if type_is_concrete(signature) {
                if let Err(error) = foreign_function_bridge(signature, ctx.traits) {
                    return Option::Some(error)
                }
            }
            children.push(signature);
        },
        GoMap { key, value } => {
            children.push(key);
            children.push(value);
        },
        HashMap { key, value } => {
            children.push(key);
            children.push(value);
        },
        Array { elem, .. } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | RefType { elem } | Channel { elem, .. } => children.push(elem),
        Tuple { items } => for item in items {
            children.push(item)
        },
        External { args, .. } | App { args, .. } | Dyn { args, .. } => for item in args {
            children.push(item)
        },
        Func { params, ret_ty } => {
            for param in params {
                children.push(param)
            }
            children.push(ret_ty);
        },
        _ => (),
    }
    for child in children {
        if let Some(key) = invalid_go_function_signature(ctx, child) {
            return Option::Some(key)
        }
    }
    Option::None
}
