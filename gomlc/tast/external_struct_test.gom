package tast;

use std::testing;

fn external_box(argument: Type) -> Type {
    Type::External {
        import_path: "example.com/host",
        name: "Box",
        args: Vec::from_array([argument]),
    }
}

#[test]
fn external_struct_fields_preserve_symbolic_arguments_without_refining_the_receiver() -> () {
    let parameter = Type::Param { name: "T" };
    testing::assert(
        external_struct_substitutions(
            external_box(Type::Int64),
            Vec::new(),
            external_box(parameter),
        ).is_none(),
    );
    let substitutions = external_struct_substitutions(
        external_box(Type::Param { name: "A" }),
        Vec::from_array(["A"]),
        external_box(parameter),
    ).unwrap_or_else(
        || {
            testing::fail("generic external struct did not match");
            Vec::new()
        },
    );
    testing::assert(
        types_equal(substitute_type(Type::Param { name: "A" }, substitutions), parameter),
    );
}
