package tast;

pub struct AssociatedConstantDependencies {
    pub name: string,
    pub owner: Option[Type],
    pub trait_ref: Option[TraitRef],
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub calls: Vec[Callable],
}

fn associated_constant_call(value: Callable) -> Option[Callable] {
    match value {
        MethodInstance { callable, .. } => associated_constant_call(callable),
        Function(name) | FunctionInstance { name, .. } if name.contains("$associated_const:") => Some(
            value,
        ),
        InherentMethod { method_name, .. } | TraitMethod { method_name, .. } if method_name.starts_with(
            "$associated_const:",
        ) => Some(value),
        _ => None,
    }
}

fn collect_associated_constant_calls(value: Expr, calls: Vec[Callable]) -> Expr {
    if let Callable { callable, .. } = value {
        if let Some(callable) = associated_constant_call(callable) {
            calls.push(callable)
        }
    }
    map_child_exprs(value, |child| collect_associated_constant_calls(child, calls))
}

pub fn associated_constant_dependencies(file: File) -> Vec[AssociatedConstantDependencies] {
    let result = Vec::new();
    for item in file.items {
        let (functions, owner, trait_ref, generics, predicates) = match item {
            Function(function) => (
                Vec::from_array([function]),
                Option::None,
                Option::None,
                function.generics,
                function.predicates,
            ),
            ImplBlock(block) => (
                block.methods,
                Option::Some(block.for_type),
                block.trait_ref,
                block.generics,
                block.predicates,
            ),
        };
        for function in functions {
            if !function.name.contains("$associated_const:") {
                continue
            }
            let calls = Vec::new();
            let _ = map_block_exprs(
                function.body,
                |expr| collect_associated_constant_calls(expr, calls),
            );
            result.push(
                AssociatedConstantDependencies {
                    name: function.name,
                    owner,
                    trait_ref,
                    generics,
                    predicates,
                    calls,
                },
            )
        }
    }
    result
}
