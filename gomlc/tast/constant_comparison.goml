package tast;

pub fn constant_comparison_supported(value: Type, ordering: bool) -> bool {
    if !ordering {
        if let Some(parts) = symbolic_array(value) {
            return constant_comparison_supported(parts.1, false)
        }
    }
    match prune(value) {
        Error | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        Unit | Bool => !ordering,
        Tuple { items } if !ordering => {
            for item in items {
                if !constant_comparison_supported(item, false) {
                    return false
                }
            }
            true
        },
        Array { elem, .. } if !ordering => constant_comparison_supported(elem, false),
        _ => false,
    }
}
