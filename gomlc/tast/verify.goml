package tast;

fn verify_resolved_expr(value: Expr, error: Ref[Option[string]]) -> Expr {
    if let Callable { callable: DeferredMethod(_), .. } = value {
        error.set(Some("unresolved method call in checked expression"))
    }
    map_child_exprs(value, |child| verify_resolved_expr(child, error))
}

pub fn verify(value: File) -> Result[(), string] {
    let error: Ref[Option[string]] = Ref::new(None);
    for item in value.items {
        let functions = match item {
            Function(value) => Vec::from_array([value]),
            ImplBlock(value) => value.methods,
        };
        for function in functions {
            let _ = map_block_exprs(function.body, |expr| verify_resolved_expr(expr, error));
        }
    }
    match error.get() {
        Some(message) => Err(message),
        None => Ok(()),
    }
}

fn verify_typeck_results(ctx: Checker) -> () {
    for fact in ctx.typeck_results.calls {
        if let ReferenceTarget::Callable(DeferredMethod(_)) = fact.target {
            push_diagnostic_at(
                ctx,
                "unresolved method call in type checking results",
                Some(fact.span),
            )
        }
    }
}
