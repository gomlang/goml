package tast;

pub fn strict_expr_inputs(value: Expr) -> Vec[Expr] {
    match value {
        Constr { args, .. } | Tuple { items: args, .. } | Array { items: args, .. } => args,
        Call { func, args, .. } => {
            let result = Vec::from_array([func]);
            for arg in args {
                result.push(arg)
            }
            result
        },
        Go { expr, .. } => Vec::from_array([expr]),
        Unary { expr, .. } | Cast { expr, .. } | ToDyn { expr, .. } | Field { expr, .. } => Vec::from_array(
            [expr],
        ),
        Proj { tuple, .. } => Vec::from_array([tuple]),
        Index { base, index, .. } => Vec::from_array([base, index]),
        Binary { op, lhs, rhs, .. } => match op {
            And | Or => Vec::from_array([lhs]),
            _ => Vec::from_array([lhs, rhs]),
        },
        If { cond, .. } | While { cond, .. } => Vec::from_array([cond]),
        For { iterator, .. } => Vec::from_array([iterator]),
        Match { expr, .. } => Vec::from_array([expr]),
        _ => Vec::new(),
    }
}
