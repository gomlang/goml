package tast;

use std::testing;

fn assert_unused_result_warnings(source: string, expected: Vec[string]) -> () {
    let diagnostics = checked_diagnostics(source);
    testing::assert_eq(diagnostics.len(), expected.len());
    for index in 0..diagnostics.len() {
        let diagnostic = diagnostics[index];
        testing::assert(diagnostic.code == Option::Some("unused_result"));
        testing::assert(diagnostic.help[0].contains("let _ = ..."));
        match diagnostic.severity {
            Warning => (),
            Error => testing::fail(diagnostic.message),
        }
        let span = testing::expect_some(diagnostic.span, "expected unused Result span");
        testing::assert_eq(source.byte_slice(span.start, span.end), expected[index]);
        testing::assert_eq(diagnostic.source_path, "main.goml");
    }
}

#[test]
fn unused_result_warns_for_calls_aliases_and_generic_results() -> () {
    assert_unused_result_warnings(
        "type Outcome[T] = Result[T, string]; fn produce[T](value: T) -> Outcome[T] { Ok(value) } fn identity[T](value: T) -> T { value } fn main() -> () { produce(1); identity(produce(())); }",
        Vec::from_array(["produce(1)", "identity(produce(()))"]),
    )
}

#[test]
fn unused_result_waits_for_closure_parameter_inference() -> () {
    assert_unused_result_warnings(
        "fn main() -> () { let discard = |value| { value; }; let value: Result[(), string] = Err(\"failed\"); discard(value); }",
        Vec::from_array(["value"]),
    )
}

#[test]
fn unused_result_warns_once_for_discarded_control_flow_values() -> () {
    assert_unused_result_warnings(
        "fn inspect(value: Result[(), string], flag: bool) -> () { { value }; if flag { value } else { value }; match flag { true => value, false => value }; let run = || { value; }; run(); }",
        Vec::from_array(
            [
                "{ value }",
                "if flag { value } else { value }",
                "match flag { true => value, false => value }",
                "value",
            ],
        ),
    )
}

#[test]
fn unused_result_warns_for_methods_and_in_method_bodies() -> () {
    assert_unused_result_warnings(
        "struct Worker {} impl Worker { fn run(self: Worker) -> Result[(), string] { Ok(()) } fn discard(self: Worker) -> () { self.run(); } } fn main() -> () { Worker {}.run(); }",
        Vec::from_array(["self.run()", "Worker {}.run()"]),
    )
}

#[test]
fn unused_result_allows_explicit_ignores_and_handled_values() -> () {
    assert_unused_result_warnings(
        "fn inspect(value: Result[(), string]) -> Result[(), string] { let _ = value; let saved = value; value?; match saved { Ok(_) => (), Err(_) => () }; value } fn forward(value: Result[(), string]) -> Result[(), string] { return value; } fn closure(value: Result[(), string]) -> Result[(), string] { let run = || value; run() }",
        Vec::new(),
    )
}

#[test]
fn unused_result_only_checks_direct_result_values() -> () {
    assert_unused_result_warnings(
        "fn inspect[T](value: Result[(), string], generic: T) -> () { 1; true; (); Option::Some(1); (value, 1); [value]; generic; let saved = value; }",
        Vec::new(),
    )
}

#[test]
fn unused_result_honors_function_and_impl_allow_in_closures() -> () {
    assert_unused_result_warnings(
        "#[allow(unused_result)] fn inspect(value: Result[(), string]) -> () { value; let run = || { value; }; run(); } struct Worker {} #[allow(unused_result)] impl Worker { fn discard(self: Worker, value: Result[(), string]) -> () { value; let run = || { value; }; run(); } } fn warn(value: Result[(), string]) -> () { value; }",
        Vec::from_array(["value"]),
    )
}

#[test]
fn unused_result_does_not_match_user_types_named_result() -> () {
    for source in Vec::from_array(
        [
            "enum Result[T, E] { Ok(T), Err(E) } fn inspect(value: Result[(), string]) -> () { value; }",
            "struct Result[T, E] { value: T, error: E } fn inspect(value: Result[(), string]) -> () { value; }",
            "type Result[T, E] = (T, E); fn inspect(value: Result[(), string]) -> () { value; }",
        ],
    ) {
        assert_unused_result_warnings(source, Vec::new())
    }
}

#[test]
fn unused_result_recognizes_cross_package_aliases_and_generic_calls() -> () {
    let dependency = dependency_hir(
        "package operations; pub type Outcome[T] = Result[T, string]; pub fn run[T](value: T) -> Outcome[T] { Ok(value) }",
        "example::operations",
    );
    let source = "package client; use example::operations; pub fn main() -> () { operations::run(1); let _ = operations::run(()); }";
    let file = dependency_hir(source, "example::client");
    let environments = testing::expect_ok(
        dependency_environments(Vec::from_array([dependency])),
        "expected operations environment",
    );
    let checked = check_package_files_for_link_with_environments(
        Vec::from_array([file]),
        environments,
    );
    testing::assert(!diagnostics_have_errors(checked.diagnostics));
    testing::assert(checked.tast.is_some());
    testing::assert_eq(checked.diagnostics.len(), 1);
    let diagnostic = checked.diagnostics[0];
    testing::assert(diagnostic.code == Option::Some("unused_result"));
    let span = testing::expect_some(diagnostic.span, "expected cross-package Result span");
    testing::assert_eq(source.byte_slice(span.start, span.end), "operations::run(1)");
}

#[test]
fn unused_result_does_not_match_cross_package_types_named_result() -> () {
    let dependency = dependency_hir(
        "package operations; pub enum Result[T, E] { Ok(T), Err(E) } pub fn run() -> Result[(), string] { Ok(()) }",
        "example::operations",
    );
    let file = dependency_hir(
        "package client; use example::operations; pub fn main() -> () { operations::run(); }",
        "example::client",
    );
    let environments = testing::expect_ok(
        dependency_environments(Vec::from_array([dependency])),
        "expected operations environment",
    );
    let checked = check_package_files_for_link_with_environments(
        Vec::from_array([file]),
        environments,
    );
    testing::assert_eq(checked.diagnostics.len(), 0);
}
