package tast;

use module::ast;
use module::parser;
use std::testing;

fn structured_diagnostic(source: string, code: string) -> Diagnostic {
    let values: Vec[Diagnostic] = Vec::new();
    for value in checked_diagnostics(source) {
        if value.code == Option::Some(code) {
            values.push(value)
        }
    }
    testing::assert_eq(values.len(), 1);
    let value = values[0];
    testing::assert(value.code == Option::Some(code));
    let span = testing::expect_some(value.span, "expected primary location");
    testing::assert_eq(source.byte_slice(span.start, span.end), "?");
    testing::assert(!value.help.is_empty());
    testing::assert(value.fixes.is_empty());
    value
}

#[test]
fn structured_diagnostic_try_error_types_and_return_annotation() -> () {
    let source = "enum LibraryError { Failed } enum AppError { Failed } type Outcome[T] = Result[T, AppError]; fn run(value: Result[i32, LibraryError]) -> Outcome[i32] { let number: i32 = value?; Ok(number) }";
    let value = structured_diagnostic(source, "try_error_mismatch");
    testing::assert(value.message.contains("LibraryError"));
    testing::assert(value.message.contains("AppError"));
    testing::assert_eq(value.secondary_labels.len(), 1);
    let label = value.secondary_labels[0];
    testing::assert_eq(source.byte_slice(label.span.start, label.span.end), "Outcome");
    testing::assert(value.help[0].contains("map_err"));
    testing::assert(!value.notes.is_empty())
}

#[test]
fn structured_diagnostic_try_incompatible_return_types() -> () {
    for operand in Vec::from_array(["Option[i32]", "Result[i32, string]"]) {
        let source = "fn run(value: " + operand + ") -> i32 { value? }";
        let value = structured_diagnostic(source, "try_invalid_return");
        testing::assert_eq(value.secondary_labels.len(), 1);
        let label = value.secondary_labels[0];
        testing::assert_eq(source.byte_slice(label.span.start, label.span.end), "i32");
        testing::assert(label.message.contains("this function returns i32"));
    }
}

#[test]
fn structured_diagnostic_try_invalid_operand() -> () {
    for source in Vec::from_array(
        [
            "fn run() -> Result[i32, string] { Ok(1?) }",
            "fn run(value: bool) -> Option[bool] { Some(value?) }",
        ],
    ) {
        let value = structured_diagnostic(source, "try_invalid_operand");
        testing::assert(value.secondary_labels.is_empty());
    }
}

#[test]
fn structured_diagnostic_try_points_to_nearest_closure() -> () {
    let source = "fn run(value: Result[i32, string]) -> () { let callback: () -> i32 = || value?; let _ = callback; }";
    let value = structured_diagnostic(source, "try_invalid_return");
    let label = value.secondary_labels[0];
    testing::assert_eq(source.byte_slice(label.span.start, label.span.end), "|| value?");
    testing::assert(label.message.contains("this closure returns i32"));
}

#[test]
fn structured_diagnostic_try_preserves_contextual_inference() -> () {
    for source in Vec::from_array(
        [
            "fn run() -> Result[i32, string] { let number: i32 = Ok(1)?; Ok(number) }",
            "fn run(value: Result[i32, string]) -> Result[i32, string] { let callback = || { Result::Ok(value?) }; callback() }",
            "fn run(value: Result[i32, string]) -> Result[i32, i32] { Ok(value.map_err(|_| 1)?) }",
        ],
    ) {
        testing::assert_eq(checked_diagnostics(source).len(), 0);
    }
}

#[test]
fn structured_diagnostic_unused_result_fixes_recheck() -> () {
    for statement in Vec::from_array(
        [
            "value;",
            "(value);",
            "((value));",
            "{ value };",
            "if true { value } else { value }",
            "match true { true => value, false => value }",
        ],
    ) {
        let source = "fn run(value: Result[(), string]) -> () { " + statement + " let _ = (); }";
        let diagnostics = checked_diagnostics(source);
        testing::assert_eq(diagnostics.len(), 1);
        let fix = diagnostics[0].fixes[0];
        match fix.applicability {
            RequiresReview => (),
            MachineApplicable => testing::fail("ignoring errors requires review"),
        }
        let mut fixed = source;
        let mut index = fix.edits.len() - 1;
        while index >= 0 {
            let edit = fix.edits[index];
            fixed = fixed.byte_slice(0, edit.span.start) + edit.replacement
                + fixed.byte_slice(edit.span.end, fixed.byte_len());
            index -= 1;
        }
        testing::assert(ast::lower(parser::parse(fixed)).diagnostics.is_empty());
        testing::assert_eq(checked_diagnostics(fixed).len(), 0);
    }
}
