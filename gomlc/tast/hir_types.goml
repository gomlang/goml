package tast;

use module::consts;
use module::hir;

pub fn const_expr_from_hir(value: hir::ConstExpr) -> Type {
    match value.kind {
        Value(value) => const_type(value),
        Param(name) => Param { name: consts::parameter(name) },
        Reference(name) => Con { name: "$const_name:" + name },
        Unary { op, value } => {
            let value = const_expr_from_hir(value);
            if let Type::Error = value {
                Type::Error
            } else if op == "+" {
                value
            } else if op == "-" {
                const_application(
                    Con { name: "$const_op:-" },
                    Vec::from_array([const_type(0), value]),
                )
            } else if op == "~" {
                const_application(
                    Con { name: "$const_op:^" },
                    Vec::from_array([value, const_type(-1)]),
                )
            } else {
                Type::Error
            }
        },
        Binary { op, left, right } => {
            let left = const_expr_from_hir(left);
            let right = const_expr_from_hir(right);
            match (left, right) {
                (Type::Error, _) | (_, Type::Error) => Type::Error,
                _ => const_application(
                    Con { name: "$const_op:" + op },
                    Vec::from_array([left, right]),
                ),
            }
        },
        Error => Type::Error,
    }
}

pub fn generic_arg_from_hir(
    builtin: BuiltinContract,
    value: hir::GenericArg,
    params: Vec[string],
    self_ty: Option[Type],
) -> Type {
    match value {
        Type(value) => type_from_hir(builtin, value, params, self_ty),
        Const(value) => const_expr_from_hir(value),
        hir::GenericArg::Unresolved { name, .. } => nominal_type(builtin, name, Vec::new()),
    }
}

pub fn type_from_hir(
    builtin: BuiltinContract,
    value: hir::TypeExpr,
    params: Vec[string],
    self_ty: Option[Type],
) -> Type {
    match value.kind {
        Unit => Type::Unit,
        Bool => Type::Bool,
        Int => Type::Int,
        Int8 => Type::Int8,
        Int16 => Type::Int16,
        Int32 => Type::Int32,
        Int64 => Type::Int64,
        Uint => Type::Uint,
        Uint8 => Type::Uint8,
        Uint16 => Type::Uint16,
        Uint32 => Type::Uint32,
        Uint64 => Type::Uint64,
        Float32 => Type::Float32,
        Float64 => Type::Float64,
        String => Type::String,
        Char => Type::Char,
        Tuple { items: values } => {
            let result: Vec[Type] = Vec::new();
            for item in values {
                result.push(type_from_hir(builtin, item, params, self_ty))
            }
            Type::Tuple { items: result }
        },
        Named { reference } => {
            let name = hir::type_reference_name(reference);
            if name == "byte" {
                Type::Uint8
            } else if name == "never" {
                Never
            } else {
                nominal_type(builtin, name, Vec::new())
            }
        },
        Param { name } => Param { name },
        SelfType => self_ty.unwrap_or(Type::Param { name: "Self" }),
        Error => Type::Error,
        Projection { base, associated: name } => {
            Projection {
                for_ty: type_from_hir(builtin, base, params, self_ty),
                name,
                trait_ref: Option::None,
            }
        },
        Dyn { bounds } => {
            let result: Vec[DynTraitBound] = Vec::new();
            for bound in bounds {
                let args: Vec[Type] = Vec::new();
                for arg in bound.args {
                    args.push(generic_arg_from_hir(builtin, arg, params, self_ty))
                }
                let associated_types: Vec[(string, Type)] = Vec::new();
                for binding in bound.associated_types {
                    associated_types.push(
                        (binding.0, type_from_hir(builtin, binding.1, params, self_ty)),
                    )
                }
                result.push(
                    DynTraitBound {
                        trait_name: hir::type_reference_name(bound.reference),
                        args,
                        associated_types,
                    },
                )
            }
            if result.is_empty() {
                Type::Error
            } else {
                let additional_bounds: Vec[DynTraitBound] = Vec::new();
                for index in 1..result.len() {
                    additional_bounds.push(result[index])
                }
                Dyn {
                    trait_name: result[0].trait_name,
                    args: result[0].args,
                    associated_types: result[0].associated_types,
                    additional_bounds,
                }
            }
        },
        App { ty: base, args } => {
            let base = type_from_hir(builtin, base, params, self_ty);
            let result: Vec[Type] = Vec::new();
            for arg in args {
                result.push(generic_arg_from_hir(builtin, arg, params, self_ty))
            }
            match prune(base) {
                Con { name } => nominal_type(builtin, name, result),
                _ => App { ty: base, args: result },
            }
        },
        Array { len, elem } => {
            let len = const_expr_from_hir(len);
            match len {
                Type::Error => Type::Error,
                _ => const_application(
                    Con { name: "$array" },
                    Vec::from_array([len, type_from_hir(builtin, elem, params, self_ty)]),
                ),
            }
        },
        Func { params: values, ret_ty } => {
            let result: Vec[Type] = Vec::new();
            for param in values {
                result.push(type_from_hir(builtin, param, params, self_ty))
            }
            Func { params: result, ret_ty: type_from_hir(builtin, ret_ty, params, self_ty) }
        },
    }
}

pub fn trait_ref_from_hir(
    builtin: BuiltinContract,
    value: hir::TraitRef,
    params: Vec[string],
    self_ty: Option[Type],
) -> TraitRef {
    let args: Vec[Type] = Vec::new();
    for arg in value.args {
        args.push(generic_arg_from_hir(builtin, arg, params, self_ty))
    }
    TraitRef { name: hir::type_reference_name(value.reference), args }
}

fn predicate_from_hir(
    builtin: BuiltinContract,
    value: hir::Predicate,
    params: Vec[string],
    self_ty: Option[Type],
) -> TypePredicate {
    match value {
        Trait { ty, trait_ref: reference } => TypePredicate::Trait {
            for_ty: type_from_hir(builtin, ty, params, self_ty),
            trait_ref: trait_ref_from_hir(builtin, reference, params, self_ty),
        },
        Equality { lhs: left, rhs: right } => Equality {
            lhs: type_from_hir(builtin, left, params, self_ty),
            rhs: type_from_hir(builtin, right, params, self_ty),
        },
    }
}

pub fn predicates_from_hir(
    builtin: BuiltinContract,
    generic_bounds: Vec[(string, Vec[hir::TraitRef])],
    predicates: Vec[hir::Predicate],
    params: Vec[string],
    self_ty: Option[Type],
) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for generic_bound in generic_bounds {
        for bound in generic_bound.1 {
            result.push(
                TypePredicate::Trait {
                    for_ty: if generic_bound.0 == "Self" {
                        self_ty.unwrap_or(Type::Param { name: "Self" })
                    } else {
                        Param { name: generic_bound.0 }
                    },
                    trait_ref: trait_ref_from_hir(builtin, bound, params, self_ty),
                },
            )
        }
    }
    for predicate in predicates {
        result.push(predicate_from_hir(builtin, predicate, params, self_ty))
    }
    result
}
