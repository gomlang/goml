package tast;

use std::testing;

#[test]
fn generic_constructor_owners_do_not_fall_back_to_package_enums() -> () {
    for source in Vec::from_array(
        [
            "enum T { Item } fn invalid[T]() -> () { let _ = T::Item; }",
            "enum T { Item(isize) } fn invalid[T]() -> () { let _ = T::Item(1); }",
            "enum T { Item { value: isize } } fn invalid[T]() -> () { let _ = T::Item { value: 1 }; }",
            "enum T { Item } fn existing() -> T { T::Item } fn invalid[T]() -> bool { match existing() { T::Item => true } }",
            "enum T { Item { value: isize } } fn existing() -> T { T::Item { value: 1 } } fn invalid[T]() -> isize { match existing() { T::Item { value } => value } }",
        ],
    ) {
        testing::assert(!checked_diagnostics(source).is_empty())
    }
}

#[test]
fn unshadowed_constructor_owners_still_resolve() -> () {
    let _ = checked_file(
        "enum T { Item(isize) } fn existing() -> T { T::Item(1) } fn valid[U](input: U) -> isize { let _ = input; let make = T::Item; let _ = make(2); match existing() { T::Item(value) => value } }",
    );
}
