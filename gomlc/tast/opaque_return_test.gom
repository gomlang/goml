package tast;

use std::testing;

fn opaque_return_accepts(source: string) -> () {
    let diagnostics = checked_diagnostics(source);
    for diagnostic in diagnostics {
        println(diagnostic.message)
    }
    testing::assert(diagnostics.is_empty())
}

#[test]
fn opaque_return_rejects_recursive_hidden_types() -> () {
    for source in Vec::from_array(
        [
            "trait Label { fn label(self) -> string; } fn first() -> impl Label { first() }",
            "trait Label { fn label(self) -> string; } fn first() -> impl Label { second() } fn second() -> impl Label { first() }",
            "trait Label { fn label(self) -> string; } struct Box[T] { value: T } impl[T] Label for Box[T] { fn label(self) -> string { \"box\" } } fn first() -> impl Label { Box { value: first() } }",
        ],
    ) {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), "recursive type"))
    }
}

#[test]
fn opaque_return_requires_one_hidden_type() -> () {
    let prefix = "trait Label { fn label(self) -> string; } struct A {} struct B {} impl Label for A { fn label(self) -> string { \"a\" } } impl Label for B { fn label(self) -> string { \"b\" } } ";
    opaque_return_accepts(
        prefix
            + "fn make(flag: bool) -> impl Label { if flag { return A {}; } A {} } fn later() -> impl Label { make(true) }",
    );
    for source in Vec::from_array(
        [
            "fn make(flag: bool) -> impl Label { if flag { A {} } else { B {} } }",
            "fn first() -> impl Label { A {} } fn second() -> impl Label { A {} } fn invalid() -> () { let mut value = first(); value = second(); }",
            "impl A { fn extra(self) -> isize { 1 } } fn make() -> impl Label { A {} } fn invalid() -> isize { make().extra() }",
        ],
    ) {
        testing::assert(!checked_diagnostics(prefix + source).is_empty())
    }
}

#[test]
fn opaque_return_is_allowed_only_as_complete_function_return() -> () {
    let prefix = "trait Label { fn label(self) -> string; } ";
    for source in Vec::from_array(
        [
            "fn invalid(value: impl Label) -> () {}",
            "fn invalid() -> Option[impl Label] { Option::None }",
            "fn invalid() -> () { let value: impl Label = 1; }",
            "type Invalid = impl Label;",
            "struct Invalid { value: impl Label }",
            "trait Invalid { fn make(self) -> impl Label; }",
        ],
    ) {
        if checked_diagnostics(prefix + source).is_empty() {
            testing::fail("accepted unsupported opaque type: " + source)
        }
    }
}

#[test]
fn opaque_return_methods_keep_definition_identity_and_generics() -> () {
    opaque_return_accepts(
        "trait Source { type Item; fn get(self) -> Self::Item; } struct A[T] { value: T } struct B {} impl[T] Source for A[T] { type Item = T; fn get(self) -> T { self.value } } impl[T] A[T] { fn make(self) -> impl Source[Item = T] { self } } impl B { fn make(self) -> impl Source[Item = isize] { A { value: 7 } } } fn f() -> (isize, string, isize) { (A { value: 1 }.make().get(), A { value: \"text\" }.make().get(), B {}.make().get()) }",
    )
}

#[test]
fn opaque_return_supports_later_generic_functions() -> () {
    opaque_return_accepts(
        "trait Source[T] { fn get(self) -> T; } struct Value[T] { value: T } impl[T] Source[T] for Value[T] { fn get(self) -> T { self.value } } fn first[T](value: T) -> impl Source[T] { second(value) } fn second[T](value: T) -> impl Source[T] { Value { value } } fn f() -> isize { first(7).get() }",
    )
}

#[test]
fn opaque_return_reports_missing_hidden_type_for_diverging_body() -> () {
    testing::assert(
        !checked_diagnostics(
            "trait Label { fn label(self) -> string; } fn make() -> impl Label { loop {} }",
        ).is_empty(),
    )
}

#[test]
fn opaque_return_resolves_iterator_projections_before_checking_hidden_type() -> () {
    opaque_return_accepts(
        "fn numbers() -> impl Iterator[Item = isize] { Vec::from_array([1, 2, 3]).into_iter() } fn first() -> isize { numbers().next().unwrap_or(0) }",
    )
}
