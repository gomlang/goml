                ),
                _ => testing::fail("expected intrinsic call"),
            },
            _ => testing::fail("expected main function"),
        },
        None => testing::fail("expected allowed extern TAST"),
    }
}

#[test]
fn permits_typed_go_ffi_externs_in_user_sources() -> () {
    let source = "type Text = string; #[go_ffi(\"strings\", \"ToUpper\")] extern fn to_upper(value: Text) -> Text; fn main() -> Text { to_upper(\"goml\") }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: GoForeign { import_path, symbol, binding }, ty: _ },
                args: _,
                ty: String,
            },) => {
                testing::assert_eq(import_path, "strings");
                testing::assert_eq(symbol, "ToUpper")
            },
            _ => testing::fail("expected Go FFI call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn permits_empty_marker_dyn_go_ffi_values() -> () {
    let diagnostics = checked_diagnostics(
        "trait NativeValue {} #[go_ffi(\"example.com/ffi\", \"Echo\")] extern fn echo(value: dyn NativeValue) -> dyn NativeValue;",
    );
    if !diagnostics.is_empty() {
        testing::fail(diagnostics[0].message)
    }
}

#[test]
fn rejects_nonempty_and_nested_marker_dyn_go_ffi_values() -> () {
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "trait NativeValue { fn inspect(self: Self) -> (); } #[go_ffi(\"example.com/ffi\", \"Echo\")] extern fn echo(value: dyn NativeValue) -> dyn NativeValue;",
            ),
            "Go FFI parameter value has unsupported type dyn NativeValue",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "trait NativeValue {} #[go_ffi(\"example.com/ffi\", \"Use\")] extern fn use_value(values: Slice[dyn NativeValue]) -> ();",
            ),
            "Go FFI parameter values has unsupported type Slice[dyn NativeValue]",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "trait NativeValue {} #[go_ffi(\"example.com/ffi\", \"Pair\")] extern fn pair() -> (dyn NativeValue, bool);",
            ),
            "Go FFI return type (dyn NativeValue, bool) is unsupported",
        ),
    )
}

#[test]
fn diagnoses_invalid_go_ffi_declarations() -> () {
    testing::assert(
        has_diagnostic(
            checked_diagnostics("#[go_ffi(\"strings\")] extern fn probe() -> ();"),
            "go_ffi attribute expects import path and symbol string arguments",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"strings\", \"toUpper\")] extern fn probe(value: string) -> string;",
            ),
            "go_ffi symbol must be an exported ASCII Go identifier",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"example.com/ffi\", \"Use\")] extern fn probe(values: Vec[i32]) -> ();",
            ),
            "Go FFI parameter values has unsupported type Vec[i32]",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[go_ffi(\"example.com/ffi\", \"Use\")] extern fn probe[T](value: T) -> ();",
            ),
            "Go FFI functions cannot declare generic parameters or predicates",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "#[runtime(\"std.io.println\")] #[go_ffi(\"fmt\", \"Println\")] extern fn probe(value: string) -> ();",
            ),
            "Extern declarations require exactly one ABI attribute",
        ),
    )
}

