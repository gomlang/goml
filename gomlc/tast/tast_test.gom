#[test]
fn validates_trait_impl_contracts() -> () {
    let duplicate = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for i32 { fn show(self: i32) -> string { \"a\" } fn show(self: i32) -> string { \"b\" } }",
    );
    testing::assert(
        has_diagnostic(duplicate, "Method show implemented multiple times in impl of trait Display"),
    );
    let extra = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for i32 { fn show(self: i32) -> string { \"a\" } fn extra(self: i32) -> string { \"b\" } }",
    );
    testing::assert(has_diagnostic(extra, "Method extra is not declared in trait Display"));
    let missing = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; fn debug(self: Self) -> string; } impl Display for i32 { fn show(self: i32) -> string { \"a\" } }",
    );
    testing::assert(
        has_diagnostic(missing, "Trait Display implementation for i32 is missing method debug"),
    );
    let arity = checked_diagnostics(
        "trait Format { fn format(self: Self, arg1: string) -> string; } impl Format for i32 { fn format(self: i32) -> string { \"a\" } }",
    );
    testing::assert(
        has_diagnostic(arity, "Trait Format::format expects 2 parameters but impl has 1"),
    );
    let parameter = checked_diagnostics(
        "trait Format { fn format(self: Self, arg1: string) -> string; } impl Format for i32 { fn format(self: i32, value: i32) -> string { value.to_string() } }",
    );
    testing::assert(
        has_diagnostic(
            parameter,
            "Trait Format::format parameter 1 expected type string but found i32",
        ),
    );
    let result = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } impl Display for i32 { fn show(self: i32) -> bool { true } }",
    );
    testing::assert(
        has_diagnostic(result, "Trait Display::show expected return type string but found bool"),
    )
}

#[test]
fn validates_declared_types_and_tostring_requirements() -> () {
    let declarations = checked_diagnostics(
        "enum Maybe[T] { Just(T), Nothing } struct UseMaybe { value: Maybe, missing: Unknown[i32] } struct Generic[T] { field: V }",
    );
    testing::assert(has_diagnostic(declarations, "Type Maybe expects 1 type arguments, but got 0"));
    testing::assert(has_diagnostic(declarations, "Unknown type constructor Unknown"));
    testing::assert(has_diagnostic(declarations, "Unknown type constructor V"));
    let println_error = checked_diagnostics("struct Value {} fn main() -> () { println(Value {}) }");
    testing::assert(has_diagnostic(println_error, "No instance found for trait ToString<Value>"));
    let method_error = checked_diagnostics(
        "struct Value {} fn main() -> () { let _ = (Value {}).to_string(); }",
    );
    testing::assert(has_diagnostic(method_error, "Method to_string not found for type Value"))
}

#[test]
fn rejects_removed_numeric_conversion_methods() -> () {
    let diagnostics = checked_diagnostics(
        "fn main() -> () { let value: i32 = 1; let _: i64 = value.to_int64(); }",
    );
