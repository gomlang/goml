#[test]
fn rejects_missing_dyn_impls_and_noncomparable_equality() -> () {
    let dyn_result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "trait Display { fn display(self: Self) -> string; } fn convert(value: i32) -> dyn Display { value as dyn Display }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(dyn_result.diagnostics.len(), 1);
    testing::assert_eq(
        dyn_result.diagnostics.get(0).message,
        "Type i32 does not implement trait Display",
    );
    let equality_result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn main() -> () { let left: (i32) -> i32 = |value| value; let right: (i32) -> i32 = |value| value; let _ = left == right; }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(equality_result.diagnostics.len(), 1);
    testing::assert_eq(
        equality_result.diagnostics.get(0).message,
        "No instance found for trait PartialEq<(i32) -> i32>",
    )
}

#[test]
fn rejects_non_function_go_operands() -> () {
    let result = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> () { while true { go break; } }")),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert(
        result.diagnostics.get(0).message.starts_with("unstructured_go: `go` starts detached work"),
    );
    match result.diagnostics.get(0).severity {
        Warning => (),
        Error => testing::fail("expected unstructured go warning"),
    }
    testing::assert_eq(
        result.diagnostics.get(1).message,
        "`go` expects a value of type () -> (), found never",
    );
    match result.diagnostics.get(1).severity {
        Error => (),
        Warning => testing::fail("expected go operand error"),
    }
}

#[test]
fn rejects_invalid_signature_names_and_integer_literals() -> () {
    let unknown_trait = check(
        hir::lower(
            ast::lower(parser::parse("fn use_value[T: Missing](value: T) -> () { () }")),
            "main.gom",
        ),
    );
    testing::assert_eq(unknown_trait.diagnostics.len(), 1);
    testing::assert_eq(unknown_trait.diagnostics.get(0).message, "Unknown trait Missing");
    let bad_application = check(
        hir::lower(
            ast::lower(parser::parse("fn use_value[T](value: T[i32]) -> () { () }")),
            "main.gom",
        ),
    );
    testing::assert(!bad_application.diagnostics.is_empty());
    testing::assert_eq(
        bad_application.diagnostics.get(0).message,
        "Expected a type constructor, got T",
    );
    let overflow = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> () { let value: i8 = 999; }")),
            "main.gom",
        ),
    );
    testing::assert_eq(overflow.diagnostics.len(), 1);
    testing::assert_eq(
        overflow.diagnostics.get(0).message,
        "Integer literal 999 does not fit in i8",
    );
    let negative_unsigned = check(
        hir::lower(ast::lower(parser::parse("fn main() -> () { let value: u8 = -1; }")), "main.gom"),
    );
    testing::assert_eq(negative_unsigned.diagnostics.len(), 1);
    testing::assert_eq(
        negative_unsigned.diagnostics.get(0).message,
        "Integer literal -1 does not fit in u8",
    );
    let uint_overflow = check(
        hir::lower(
            ast::lower(
                parser::parse("fn main() -> () { let value: usize = 18446744073709551616; }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(uint_overflow.diagnostics.len(), 1);
    testing::assert_eq(
        uint_overflow.diagnostics.get(0).message,
        "Integer literal 18446744073709551616 does not fit in usize",
    )
}

#[test]
fn rejects_out_of_range_integer_patterns() -> () {
    let scalar = checked_diagnostics(
        "fn unsigned(value: u8) -> isize { match value { 999 => 1, -1 => 2, _ => 3 } } fn signed(value: i8) -> isize { match value { 128 => 1, _ => 0 } }",
    );
    testing::assert(has_diagnostic(scalar, "Integer literal 999 does not fit in u8"));
    testing::assert(has_diagnostic(scalar, "Integer literal -1 does not fit in u8"));
    testing::assert(has_diagnostic(scalar, "Integer literal 128 does not fit in i8"));
    let ranges = checked_diagnostics(
        "fn lower(value: u8) -> isize { match value { -2..=10 => 1, _ => 0 } } fn upper(value: u8) -> isize { match value { 10..=998 => 1, _ => 0 } }",
    );
    testing::assert(has_diagnostic(ranges, "Integer literal -2 does not fit in u8"));
    testing::assert(has_diagnostic(ranges, "Integer literal 998 does not fit in u8"));
    testing::assert_eq(
        checked_diagnostics(
            "fn unsigned(value: u8) -> bool { match value { 255 => true, _ => false } } fn signed(value: i8) -> bool { match value { -128 => true, _ => false } }",
        ).len(),
        0,
    )
}

#[test]
fn rejects_generic_and_parameterized_main_functions() -> () {
    let result = check(
        hir::lower(ast::lower(parser::parse("fn main[T](value: T) -> () { () }")), "main.gom"),
    );
    testing::assert_eq(result.diagnostics.len(), 2);
    testing::assert(has_diagnostic(result.diagnostics, "main function must not have parameters"));
    testing::assert(
        has_diagnostic(result.diagnostics, "main function must not have type parameters"),
    )
}

#[test]
fn rejects_self_types_outside_impl_methods() -> () {
    let diagnostics = checked_diagnostics(
        "struct Direct { value: Self } struct Nested { value: Vec[Self] } struct Repeated { value: (Self, Self) } fn takes(value: Self) -> Self { value } fn main() -> () {}",
    );
    testing::assert_eq(diagnostics.len(), 6);
    for diagnostic in diagnostics {
        testing::assert_eq(diagnostic.message, "Self type is only valid in impl methods");
        testing::assert(diagnostic.span.is_some())
    }
}

#[test]
fn checks_match_exhaustiveness_and_irrefutable_bindings() -> () {
    let exhaustive = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: bool) -> i32 { match value { true => 1, false => 0 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(exhaustive.diagnostics.len(), 0);
    let tuple_gap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: (bool, bool)) -> i32 { match value { (true, true) => 1, (true, false) => 2, (false, true) => 3 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(tuple_gap.diagnostics.len(), 1);
    testing::assert_eq(
        tuple_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern (false, false)",
    );
    let symbolic_constant = checked_diagnostics(
        "const classified: isize = classify(42); const answer: isize = make_answer(); #[comptime] fn make_answer() -> isize { 42 } #[comptime] fn classify(value: isize) -> isize { match value { answer => 1, _ => 0 } }",
    );
    testing::assert_eq(symbolic_constant.len(), 0);
    let symbolic_bool = checked_diagnostics(
        "const enabled: bool = make_enabled(); #[comptime] fn make_enabled() -> bool { true } fn choose(value: bool) -> isize { match value { enabled => 1, false => 0 } }",
    );
    testing::assert_eq(symbolic_bool.len(), 0);
    let symbolic_scalar = checked_diagnostics(
        "const answer: u8 = make_answer(); #[comptime] fn make_answer() -> u8 { 42 } fn choose(value: u8) -> isize { match value { 0..=41 => 0, answer => 1, 43..=255 => 2 } }",
    );
    testing::assert_eq(symbolic_scalar.len(), 0);
    let symbolic_duplicate = checked_diagnostics(
        "const enabled: bool = make_enabled(); #[comptime] fn make_enabled() -> bool { true } fn choose(value: bool) -> isize { match value { true => 1, enabled => 2, false => 0 } }",
    );
    testing::assert_eq(symbolic_duplicate.len(), 1);
    testing::assert_eq(symbolic_duplicate.get(0).message, "Unreachable match arm");
    let comptime_guard = checked_diagnostics(
        "fn choose(value: bool) -> isize { let selected = match value { true if comptime { true } => 1, false => 0 }; selected }",
    );
    testing::assert_eq(comptime_guard.len(), 0);
    let refutable = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "enum Choice { None, Some(i32) } fn make() -> Choice { Choice::None } fn main() -> () { let Choice::Some(value) = make(); }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(refutable.diagnostics.len(), 1);
    testing::assert_eq(
        refutable.diagnostics.get(0).message,
        "Refutable pattern is not allowed in let binding; use match instead",
    )
}

#[test]
fn checks_dynamic_guarded_arm_usefulness() -> () {
    let dynamic = checked_diagnostics(
        "fn choose(value: bool, enabled: bool) -> isize { match value { true if enabled => 1, true if !enabled => 2, true => 3, false => 0 } }",
    );
    testing::assert_eq(dynamic.len(), 0);
    let covered = checked_diagnostics(
        "fn choose(value: bool, enabled: bool) -> isize { match value { true => 1, true if enabled => 2, false => 0 } }",
    );
    testing::assert_eq(covered.len(), 1);
    testing::assert_eq(covered[0].message, "Unreachable match arm");
    let constant_false = checked_diagnostics(
        "fn choose(value: bool) -> isize { match value { true if false => 1, true => 2, false => 0 } }",
    );
    testing::assert_eq(constant_false.len(), 1);
    testing::assert_eq(constant_false[0].message, "Unreachable match arm")
}

#[test]
fn suppresses_match_coverage_after_pattern_errors() -> () {
    let diagnostics = checked_diagnostics(
        "struct Pair { left: bool, right: bool } fn choose(value: Pair) -> i32 { match value { Pair { left: true } => 1, Pair { left: true, right: false } => 2, _ => 3 } }",
    );
    testing::assert_eq(diagnostics.len(), 1);
    testing::assert_eq(diagnostics[0].message, "Struct pattern Pair missing field right")
}

#[test]
fn suppresses_secondary_diagnostics_after_pattern_and_guard_errors() -> () {
    let let_else = checked_diagnostics(
        "enum Choice { A } fn inspect(value: Choice) -> () { let Missing = value else { return; }; }",
    );
    testing::assert_eq(let_else.len(), 1);
    testing::assert_eq(let_else[0].message, "Enum Choice has no variant Missing");
    let let_binding = checked_diagnostics("fn inspect() -> () { let true = 1; }");
    testing::assert_eq(let_binding.len(), 1);
    let guard = checked_diagnostics("fn choose(value: bool) -> i32 { match value { _ if 1 => 0 } }");
    testing::assert_eq(guard.len(), 1);
    testing::assert_eq(guard[0].message, "Numeric literal cannot be used as bool")
}

#[test]
fn validates_or_pattern_binding_consistency() -> () {
    let types = checked_diagnostics(
        "enum Value { Number(i32), Text(string) } fn inspect(value: Value) -> () { match value { Value::Number(item) | Value::Text(item) => () } }",
    );
    testing::assert(
        has_diagnostic(
            types,
            "Or-pattern binding `item` has inconsistent types: expected i32, found string",
        ),
    );
    let mutability = checked_diagnostics(
        "enum Value { Left(i32), Right(i32) } fn inspect(value: Value) -> i32 { match value { Value::Left(mut item) | Value::Right(item) => item } }",
    );
    testing::assert(
        has_diagnostic(mutability, "Or-pattern binding `item` has inconsistent mutability"),
    );
    testing::assert_eq(
        checked_diagnostics(
            "enum Value { Left(i32), Right(i32) } fn inspect(value: Value) -> i32 { match value { Value::Left(item) | Value::Right(item) => item } }",
        ).len(),
        0,
    )
}

#[test]
fn validates_fixed_array_pattern_lengths() -> () {
    let too_short = checked_diagnostics(
        "fn choose(value: [i32; 2]) -> i32 { match value { [first] => first, _ => 0 } }",
    );
    testing::assert(
        has_diagnostic(too_short, "Array length mismatch: expected [i32; 1], found [i32; 2]"),
    );
    let too_long = checked_diagnostics(
        "fn choose(value: [i32; 1]) -> i32 { match value { [first, second] => first + second, _ => 0 } }",
    );
    testing::assert(
        has_diagnostic(too_long, "Array length mismatch: expected [i32; 2], found [i32; 1]"),
    );
    let rest_too_long = checked_diagnostics(
        "fn choose(value: [i32; 1]) -> i32 { match value { [first, .., last] => first + last, _ => 0 } }",
    );
    testing::assert(
        has_diagnostic(rest_too_long, "Array length mismatch: expected [i32; 2], found [i32; 1]"),
    );
    testing::assert_eq(
        checked_diagnostics(
            "fn exact(value: [i32; 2]) -> i32 { match value { [first, last] => first + last } } fn with_rest(value: [i32; 2]) -> i32 { match value { [first, ..] => first } }",
        ).len(),
        0,
    )
}

#[test]
fn checks_sequence_range_and_uninhabited_exhaustiveness() -> () {
    testing::assert_eq(
        coverage_decrement_magnitude("100000000000000000000"),
        "99999999999999999999",
    );
    let sequence_gap = check(
        hir::lower(
            ast::lower(
                parser::parse("fn choose(values: Vec[bool]) -> i32 { match values { [] => 0 } }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(sequence_gap.diagnostics.len(), 1);
    testing::assert_eq(
        sequence_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern _",
    );
    let sequence_complete = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(values: Vec[bool]) -> i32 { match values { [] => 0, [true, ..] => 1, [false, ..] => 2 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(sequence_complete.diagnostics.len(), 0);
    let range_complete = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: u8) -> i32 { match value { 0..=127 => 0, 128..=255 => 1 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(range_complete.diagnostics.len(), 0);
    let range_gap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn choose(value: u8) -> i32 { match value { 0..=126 => 0, 128..=255 => 1 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(range_gap.diagnostics.len(), 1);
    testing::assert_eq(
        range_gap.diagnostics.get(0).message,
        "non-exhaustive match: missing pattern 127",
    );
    testing::assert_eq(checked_diagnostics("fn diverge() -> i32 { match loop {} {} }").len(), 0);
    let uninhabited = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "enum Never {} enum MaybeNever { Empty, Filled(Never) } fn absurd(value: Never) -> i32 { match value {} } fn maybe(value: MaybeNever) -> i32 { match value { MaybeNever::Empty => 0 } } fn empty_vec(value: Vec[Never]) -> i32 { match value { [] => 0 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(uninhabited.diagnostics.len(), 0)
}

#[test]
fn rejects_invalid_range_pattern_endpoint_types() -> () {
    let expected = "Range pattern endpoints must be integer or character literals";
    let boolean = checked_diagnostics(
        "fn classify(value: bool) -> bool { match value { false..=true => true, _ => false } }",
    );
    testing::assert(has_diagnostic(boolean, expected));
    let string_result = checked_diagnostics(
        "fn classify(value: string) -> bool { match value { \"a\"..=\"z\" => true, _ => false } }",
    );
    testing::assert(has_diagnostic(string_result, expected));
    let float_result = checked_diagnostics(
        "fn classify(value: f64) -> bool { match value { 1.0..=2.0 => true, _ => false } }",
    );
    testing::assert(has_diagnostic(float_result, expected));
    testing::assert_eq(
        checked_diagnostics(
            "fn integer(value: i16) -> bool { match value { -2..=2 => true, _ => false } } fn byte(value: u8) -> bool { match value { b'a'..=b'z' => true, _ => false } } fn character(value: char) -> bool { match value { 'a'..='z' => true, _ => false } }",
        ).len(),
        0,
    )
}

#[test]
fn rejects_invalid_range_pattern_ordering() -> () {
    let expected = "Range pattern lower bound must be less than its upper bound";
    let signed = checked_diagnostics(
        "fn classify(value: i16) -> bool { match value { 2..=-2 => true, _ => false } }",
    );
    testing::assert(has_diagnostic(signed, expected));
    let unsigned = checked_diagnostics(
        "fn classify(value: u16) -> bool { match value { 200..=100 => true, _ => false } }",
    );
    testing::assert(has_diagnostic(unsigned, expected));
    let character = checked_diagnostics(
        "fn classify(value: char) -> bool { match value { 'z'..='a' => true, _ => false } }",
    );
    testing::assert(has_diagnostic(character, expected));
    let empty = checked_diagnostics(
        "fn classify(value: u8) -> bool { match value { 10..10 => true, _ => false } }",
    );
    testing::assert(has_diagnostic(empty, expected));
    testing::assert_eq(
        checked_diagnostics(
            "fn signed(value: i8) -> bool { match value { -128..=-128 => true, _ => false } } fn unsigned(value: u8) -> bool { match value { 255..=255 => true, _ => false } } fn character(value: char) -> bool { match value { 'a'..='a' => true, _ => false } }",
        ).len(),
        0,
    );
    testing::assert(
        decimal_range_pattern_order_valid(
            "99999999999999999999999999999999999999",
            "100000000000000000000000000000000000000",
            false,
        ),
    );
    testing::assert(
        decimal_range_pattern_order_valid(
            "-100000000000000000000000000000000000000",
            "-99999999999999999999999999999999999999",
            false,
        ),
    )
}

#[test]
fn checks_loop_control_contexts_and_impl_overlap() -> () {
    let condition = check(
        hir::lower(
            ast::lower(
                parser::parse("fn main() -> () { while if true { break } else { false } {} }"),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(condition.diagnostics.len(), 1);
    testing::assert_eq(
        condition.diagnostics.get(0).message,
        "`break` is not allowed in a while condition",
    );
    let nested = check(
        hir::lower(
            ast::lower(parser::parse("fn main() -> () { while true { break; } }")),
            "main.gom",
        ),
    );
    testing::assert_eq(nested.diagnostics.len(), 0);
    let overlap = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "trait Pick { fn pick(self: Self) -> i32; } impl Pick for i32 { fn pick(self: i32) -> i32 { 1 } } impl[T] Pick for T { fn pick(self: T) -> i32 { 2 } }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert(!overlap.diagnostics.is_empty());
    testing::assert_eq(
        overlap.diagnostics.get(0).message,
        "Trait Pick implementation for T overlaps with implementation main#0",
    )
}

#[test]
fn rejects_impls_overlapping_builtin_ref_blankets() -> () {
    let diagnostics = checked_diagnostics(
        "impl PartialEq for Ref[i32] { fn eq(self: Ref[i32], other: Ref[i32]) -> bool { true } } impl Eq for Ref[i32] {} impl Hash for Ref[i32] { fn hash(self: Ref[i32]) -> u64 { 0 } }",
    );
    testing::assert_eq(diagnostics.len(), 3);
    testing::assert_eq(
        diagnostics.get(0).message,
        "Trait PartialEq implementation for Ref[i32] overlaps with builtin implementation",
    );
    testing::assert_eq(
        diagnostics.get(1).message,
        "Trait Eq implementation for Ref[i32] overlaps with builtin implementation",
    );
    testing::assert_eq(
        diagnostics.get(2).message,
        "Trait Hash implementation for Ref[i32] overlaps with builtin implementation",
    );
    for diagnostic in diagnostics {
        testing::assert(diagnostic.span.is_some())
    }
}

#[test]
fn distinguishes_fully_qualified_trait_names() -> () {
    testing::assert(!names_match("first::Flag", "second::Flag"));
    testing::assert(names_match("Flag", "first::Flag"));
    testing::assert(names_match("second::Flag", "Flag"))
}

#[test]
fn solves_trait_chains_without_an_arbitrary_depth_cutoff() -> () {
    let ty = Ref::new("i32");
    let value = Ref::new("0");
    for _ in 0..24 {
        ty.set("Wrap[" + ty.get() + "]");
        value.set("Wrap { value: " + value.get() + " }")
    }
    let source = "trait Mark {} struct Wrap[T] { value: T } impl Mark for i32 {} impl[T: Mark] Mark for Wrap[T] {} fn require[T: Mark](value: T) -> () {} fn main() -> () { let value: "
        + ty.get()
        + " = "
        + value.get()
        + "; require(value) }";
    let diagnostics = checked_diagnostics(source);
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn rejects_invalid_for_sources_and_patterns() -> () {
    let non_iterator = checked_diagnostics("fn main() -> () { for _ in 1 {} }");
    testing::assert(
        has_diagnostic(non_iterator, "for loop expects a type implementing IntoIterator, got isize"),
    );
    let refutable = checked_diagnostics("fn main() -> () { for 1 in range(0, 3) {} }");
    testing::assert(
        has_diagnostic(refutable, "Refutable pattern is not allowed in for loop; use match instead"),
    )
}

#[test]
fn checks_indexed_assignment_roots() -> () {
    let temporary = checked_diagnostics(
        "fn make() -> [i32; 2] { [1, 2] } fn main() -> () { make()[0] = 3; }",
    );
    testing::assert(
        has_diagnostic(
            temporary,
            "array indexed assignment requires a writable root such as a mutable local or `ref.get()`",
        ),
    );
    testing::assert(temporary.get(0).span.is_some());
    let readonly = checked_diagnostics(
        "fn main() -> () { let values = Vec::new().pushed(1); let view = values.slice(0, 1); view[0] = 2; }",
    );
    testing::assert(
        has_diagnostic(readonly, "cannot assign through Slice indexing; Slice is read-only"),
    );
    let writable = checked_diagnostics(
        "fn main() -> () { let mut values = [1, 2]; values[0] = 3; let cell = Ref::new([1, 2]); cell.get()[0] = 4; }",
    );
    testing::assert_eq(writable.len(), 0)
}

#[test]
fn checks_practical_expression_syntax() -> () {
    let valid = checked_diagnostics(
        "struct Point { x: isize, y: isize } fn main() -> () { let mut point = Point { x: 1, y: 2 }; point.x += 3; let base = Point { x: 4, y: 5 }; let _ = Point { x: 6, ..base }; let values: Vec[isize] = Vec::new(); let table: HashMap[string, isize] = HashMap::from_array([(\"x\", 1)]); let _ = f\"{point.x}:{values.len()}:{table.len()}\"; }",
    );
    testing::assert_eq(valid.len(), 0)
}

#[test]
fn checks_collection_from_array_inference_and_constraints() -> () {
    let valid = checked_diagnostics(
        "fn main() -> () { let values: Vec[isize] = Vec::new(); let entries = HashMap::[string, isize]::new(); let make: ([isize; 2]) -> Vec[isize] = Vec::from_array; let _ = make([1, 2]); let _ = values; let _ = entries; }",
    );
    testing::assert_eq(valid.len(), 0);
    let uninferred = checked_diagnostics(
        "fn main() -> () { let _ = Vec::new(); let _ = HashMap::new(); }",
    );
    testing::assert(has_diagnostic_containing(uninferred, "Could not infer"));
    let wrong_element = checked_diagnostics(
        "fn main() -> Vec[isize] { Vec::from_array([1, \"wrong\"]) }",
    );
    testing::assert(has_diagnostic(wrong_element, "Type mismatch: expected isize, found string"));
    let missing_key_traits = checked_diagnostics(
        "struct Key {} fn main() -> HashMap[Key, isize] { HashMap::from_array([(Key {}, 1)]) }",
    );
    testing::assert(has_diagnostic_containing(missing_key_traits, "Hash"));
    testing::assert(has_diagnostic_containing(missing_key_traits, "Eq"));
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(dependency_hir("package shadow; pub struct Vec[T] {}", "vendor::shadow"));
    let shadowed = check_for_link_with_dependencies(
        hir::lower(
            ast::lower(
                parser::parse(
                    "use vendor::shadow; fn main() -> () { let _ = shadow::Vec::from_array([1]); }",
                ),
            ),
            "main.gom",
        ),
        dependencies,
    );
    testing::assert(has_diagnostic_containing(shadowed.diagnostics, "Method from_array not found"))
}

#[test]
fn lowers_collection_from_array_to_specialized_intrinsic() -> () {
    let file = checked_file("fn main() -> Vec[isize] { Vec::from_array([1, 2]) }");
    match file.items[0] {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Intrinsic(name), ty: Func { params, ret_ty: _ } },
                args,
                ty: _,
            }) => {
                testing::assert_eq(name, "vec.from_array");
                testing::assert_eq(params.len(), 1);
                match params[0] {
                    Array { len, elem: _ } => testing::assert_eq(len, 2),
                    _ => testing::fail("expected specialized array parameter"),
                }
                match args[0] {
                    Array { items, ty: _ } => testing::assert_eq(items.len(), 2),
                    _ => testing::fail("expected array argument"),
                }
            },
            _ => testing::fail("expected from_array intrinsic call"),
        },
        _ => testing::fail("expected main function"),
    }
}

