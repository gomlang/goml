#[test]
fn derives_builtin_protocols_from_language_item_metadata() -> () {
    match builtin_contract() {
        Ok(value) => {
            testing::assert_eq(value.option.name, "Option");
            testing::assert_eq(value.option.none.name, "None");
            testing::assert_eq(value.option.none.tag, 0);
            testing::assert_eq(value.option.some.name, "Some");
            testing::assert_eq(value.option.some.tag, 1);
            testing::assert_eq(value.into_iterator.name, "IntoIterator");
            testing::assert_eq(value.into_iterator.into_iter_type, "IntoIter");
            testing::assert_eq(value.hashmap.name, "HashMap");
            testing::assert_eq(value.hashmap.from_array, "from_array");
            testing::assert_eq(value.vec.from_array, "from_array");
            testing::assert_eq(value.ordering.partial_ord, "std::cmp::PartialOrd");
            testing::assert_eq(value.ordering.equal.name, "Equal");
            testing::assert_eq(value.ordering.equal.tag, 1)
        },
        Err(message) => testing::fail(message),
    }
}

#[test]
fn rejects_parameterized_language_items_outside_builtin_sources() -> () {
