#[test]
fn reports_call_return_mismatches_once_per_constraint_phase() -> () {
    let local = checked_diagnostics("fn value() -> i32 { 1 } fn main() -> string { value() }");
    testing::assert_eq(local.len(), 2);
    for diagnostic in local {
        testing::assert_eq(diagnostic.message, "Type mismatch: expected string, found i32")
    }
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(dependency_hir("package api; pub fn value() -> i32 { 1 }", "vendor::api"));
    let external = check_for_link_with_dependencies(
        hir::lower(
            ast::lower(parser::parse("use vendor::api; fn main() -> string { api::value() }")),
            "main.gom",
        ),
        dependencies,
    );
    testing::assert_eq(external.diagnostics.len(), 2);
    for diagnostic in external.diagnostics {
        testing::assert_eq(diagnostic.message, "Type mismatch: expected string, found i32")
    }
}

