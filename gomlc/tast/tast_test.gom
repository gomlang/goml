}

#[test]
fn rejects_dyn_patterns_without_coverage_cascades() -> () {
    let diagnostics = checked_diagnostics(
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn main() -> () { let concrete: i32 = 1; let value: dyn Label = concrete as dyn Label; let _ = match value { 1 => 2, _ => 3 }; }",
    );
    testing::assert_eq(diagnostics.len(), 1);
    testing::assert_eq(diagnostics.get(0).message, "Pattern matching on dyn Label is not supported");
    match diagnostics.get(0).severity {
        Error => (),
        Warning => testing::fail("expected dyn pattern error"),
    }
}

#[test]
fn warns_for_unstructured_go_and_honors_allow_attribute() -> () {
    let diagnostics = checked_diagnostics("fn main() -> () { go || {}; }");
    testing::assert_eq(diagnostics.len(), 1);
    testing::assert(
        diagnostics.get(0).message.starts_with("unstructured_go: `go` starts detached work"),
    );
    match diagnostics.get(0).severity {
        Warning => (),
        Error => testing::fail("expected unstructured go warning"),
    }
    let allowed = checked_diagnostics("#[allow(unstructured_go)] fn main() -> () { go || {}; }");
    testing::assert_eq(allowed.len(), 0)
}

#[test]
fn warns_for_unreachable_code_and_honors_allow_attribute() -> () {
    let direct = checked_diagnostics("fn value() -> i32 { return 1; let dead = 2; dead }");
    assert_single_unreachable_code_warning("direct", direct);
    match direct[0].severity {
        Warning => (),
        Error => testing::fail("expected unreachable code warning"),
    }
    testing::assert_eq(direct[0].secondary_labels.len(), 1);
    testing::assert_eq(direct[0].secondary_labels[0].message, "control flow exits here");
    let branches = checked_diagnostics(
        "fn value(flag: bool) -> i32 { if flag { return 1 } else { return 2 }; 3 }",
    );
    assert_single_unreachable_code_warning("branches", branches);
    let infinite_loop = checked_diagnostics("fn value() -> i32 { loop {}; 1 }");
    assert_single_unreachable_code_warning("infinite loop", infinite_loop);
    let exhaustive_match = checked_diagnostics(
        "fn value(flag: bool) -> i32 { match flag { true => return 1, false => return 2, }; 3 }",
    );
    assert_single_unreachable_code_warning("exhaustive match", exhaustive_match);
    let loop_control = checked_diagnostics("fn main() -> () { loop { break; println(\"dead\") }; }");
    assert_single_unreachable_code_warning("loop control", loop_control);
    let conditional = checked_diagnostics(
        "fn value(flag: bool) -> i32 { if flag { return 1 } else { () }; 2 }",
    );
    testing::assert_eq(conditional.len(), 0);
    let closure = checked_diagnostics(
        "fn main() -> () { let work = || { return; println(\"dead\") }; work() }",
    );
    assert_single_unreachable_code_warning("closure", closure);
    let allowed = checked_diagnostics(
        "#[allow(unreachable_code)] fn value() -> i32 { return 1; let dead = 2; dead }",
    );
    testing::assert_eq(allowed.len(), 0);
    let allowed_closure = checked_diagnostics(
        "#[allow(unreachable_code)] fn main() -> () { let work = || { return; println(\"dead\") }; work() }",
    );
    testing::assert_eq(allowed_closure.len(), 0);
    let invalid = checked_diagnostics("fn value() -> i32 { return 1; true + false }");
    testing::assert(has_diagnostic(invalid, "unreachable_code: unreachable code"));
    testing::assert(has_diagnostic(invalid, "Operator + is not defined for type bool"))
}

#[test]
fn warns_for_unused_private_functions_across_package_files() -> () {
    let first = "package values; fn live_helper() -> i32 { 1 } fn method_helper() -> i32 { 2 } fn dead_leaf() -> i32 { 3 } fn dead_parent() -> i32 { dead_leaf() } fn dead_recursive(value: i32) -> i32 { if value == 0 { 0 } else { dead_recursive(value - 1) } } #[allow(unused_function)] fn allowed() -> () {}";
    let second = "package values; struct Value {} impl Value { fn value(self: Value) -> i32 { method_helper() } } pub fn api() -> i32 { live_helper() } #[test] fn api_works() -> () { let _ = api(); () }";
    let ast_files = ast::lower_package(
        Vec::from_array([parser::parse(first), parser::parse(second)]),
    );
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array(
        [(ast_files[0], "helpers.gom"), (ast_files[1], "api.gom")],
    );
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected package HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert_eq(checked.diagnostics.len(), 3);
    let names: Vec[string] = Vec::new();
    for diagnostic in checked.diagnostics {
        match diagnostic.severity {
            DiagnosticSeverity::Warning => (),
            DiagnosticSeverity::Error => testing::fail(diagnostic.message),
        }
        testing::assert(diagnostic.message.starts_with("unused_function: function "));
        testing::assert_eq(diagnostic.source_path, "helpers.gom");
        match diagnostic.span {
            Some(span) => names.push(first.byte_slice(span.start, span.end)),
            None => testing::fail("expected unused function name span"),
        }
    }
    testing::assert_eq(names[0], "dead_leaf");
    testing::assert_eq(names[1], "dead_parent");
    testing::assert_eq(names[2], "dead_recursive")
}

#[test]
fn rejects_recursive_struct_layouts() -> () {
    let direct = checked_diagnostics("struct Tree { left: Tree } fn main() -> () {}");
    testing::assert(
        has_diagnostic(
            direct,
            "Struct Tree has infinite size due to recursive field; use Ref[Tree] for indirection",
        ),
    );
    let generic = checked_diagnostics(
        "struct Wrap[T] { value: T } struct Loop { value: Wrap[Loop] } fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic(
            generic,
            "Struct Loop has infinite size due to recursive field; use Ref[Loop] for indirection",
        ),
    )
}

#[test]
fn propagates_generic_result_constraints_to_literals() -> () {
    let diagnostics = checked_diagnostics("fn main() -> () { let value: Ref[u8] = Ref::new(10); }");
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn prefers_user_nominal_arities() -> () {
    let diagnostics = checked_diagnostics(
        "enum Result { Ok(string), Err(string) } fn parse(value: bool) -> Result { if value { Result::Ok(\"ok\") } else { Result::Err(\"error\") } }",
    );
    testing::assert_eq(diagnostics.len(), 0)
}

#[test]
fn infers_nested_builtin_method_receivers() -> () {
    let _ = checked_file(
        "fn main() -> () { let log = Ref::new(Vec::new()); log.set(log.get().pushed(\"x\")); }",
    );
}

#[test]
fn checks_contextual_numeric_expressions_and_inherent_arguments() -> () {
    let _ = checked_file(
        "struct Counter { value: u8 } impl Counter { fn add(self: Counter, value: u8) -> Counter { Counter { value: self.value + value } } } fn main() -> () { let negative: i8 = -128; let total: u8 = 10 + 20; let counter = Counter { value: total }.add(5); println(counter.value.to_string()) }",
    );
}

#[test]
fn qualified_struct_variants_win_over_same_named_structs() -> () {
    let _ = checked_file(
        "struct Path { segment: string } struct Block { value: isize } enum Expr { Path { path: Path, span: isize }, Block { block: Block, span: isize } } fn span(value: Expr) -> isize { match value { Expr::Path { path: _, span } => span, Expr::Block { block: _, span } => span } } fn main() -> () { let path = Path { segment: \"x\" }; let block = Block { value: 1 }; let _ = span(Expr::Path { path, span: 2 }); let _ = span(Expr::Block { block, span: 3 }); }",
    );
}

#[test]
fn accepts_transparent_aliases_bytes_and_forward_constants() -> () {
    let source = "type Pair[T] = (T, T); type Marker = byte; type Label = string; struct Entry { marker: Marker, label: Label } enum Event { Mark(Marker), Pair(Pair[i32]) } trait Read { fn read(self: Self) -> Marker; } impl Read for Entry { fn read(self: Entry) -> Marker { self.marker } } const next: i32 = base + 2; const base: i32 = 0x28; const marker: Marker = b'\\xFF'; fn sum(value: Pair[i32]) -> i32 { value.0 + value.1 } fn main() -> () { let entry = Entry { marker, label: \"ok\" }; let raw: u8 = entry.read(); let pair: Pair[i32] = (next, 0b10); let _ = Event::Mark(raw); let _ = Event::Pair(pair); let _ = sum(pair) + raw.to_i32(); }";
    let file = checked_file(source);
    testing::assert_eq(file.constants.len(), 3)
}

#[test]
fn accepts_recursively_immutable_composite_constants() -> () {
    let source = "struct Pair { left: isize, bytes: [byte; 2] } enum Choice { None, Some(Pair) } const BYTES: [byte; 3] = b\"ABC\"; const PAIR: Pair = Pair { left: 7, bytes: [8, 9] }; const CHOICE: Choice = Choice::Some(PAIR); fn main() -> () { let _ = BYTES[0]; let _ = PAIR.left; match CHOICE { Choice::None => (), Choice::Some(_) => () } }";
    let file = checked_file(source);
    testing::assert_eq(file.constants.len(), 3)
}

#[test]
fn rejects_mutable_constant_types_and_composite_patterns() -> () {
    let mutable = checked_diagnostics(
        "const BAD: Vec[isize] = Vec::from_array([1]); fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic(
            mutable,
            "constant type must be recursively immutable and cannot contain Vec, HashMap, Ref, Channel, closures, or dynamic values",
        ),
    );
    let pattern = checked_diagnostics(
        "const VALUES: [isize; 2] = [1, 2]; fn check(value: [isize; 2]) -> bool { match value { VALUES => true, _ => false } }",
    );
    testing::assert(has_diagnostic(pattern, "non-scalar constants cannot be used as patterns"));
    let reassignment = checked_diagnostics(
        "const VALUES: [isize; 2] = [1, 2]; fn main() -> () { VALUES = [3, 4]; }",
    );
    testing::assert(has_diagnostic(reassignment, "cannot assign to constant `VALUES`"))
}

#[test]
fn checks_once_cell_statics() -> () {
    let file = checked_file(
        "static VALUE: OnceCell[FrozenVec[isize]] = OnceCell::new(); fn value() -> FrozenVec[isize] { VALUE.get_or_init(|| Vec::from_array([1, 2]).freeze()) } fn main() -> () { let _ = value(); }",
    );
    testing::assert_eq(file.statics.len(), 1);
    let invalid_type = checked_diagnostics(
        "static VALUE: isize = OnceCell::new(); fn main() -> () {}",
    );
    testing::assert(has_diagnostic(invalid_type, "static initializer must be `OnceCell::new()`"));
    let invalid_initializer = checked_diagnostics(
        "static VALUE: OnceCell[isize] = Option::None; fn main() -> () {}",
    );
    testing::assert(
        has_diagnostic(invalid_initializer, "static initializer must be `OnceCell::new()`"),
    );
    let reassignment = checked_diagnostics(
        "static VALUE: OnceCell[isize] = OnceCell::new(); fn main() -> () { VALUE = OnceCell::new(); }",
    );
    testing::assert(has_diagnostic(reassignment, "cannot assign to static binding `VALUE`"))
}

#[test]
fn diagnoses_type_alias_cycles_and_wrong_arity() -> () {
    let cycle = checked_diagnostics("type First = Second; type Second = First; fn main() -> () {}");
    testing::assert(has_diagnostic(cycle, "Cyclic type alias First"));
    let arity = checked_diagnostics(
        "type Pair[T] = (T, T); fn identity(value: Pair) -> Pair { value }",
    );
    testing::assert(has_diagnostic(arity, "Type alias Pair expects 1 type arguments, got 0"))
}

#[test]
fn diagnoses_constant_cycles_and_non_constant_expressions() -> () {
    let cycle = checked_diagnostics(
        "const first: isize = second; const second: isize = first; fn main() -> () {}",
    );
    testing::assert(has_diagnostic(cycle, "Cyclic constant first"));
    testing::assert(has_diagnostic(cycle, "Cyclic constant second"));
    let call = checked_diagnostics(
        "fn value() -> isize { 1 } const answer: isize = value(); fn main() -> () {}",
    );
    testing::assert(has_diagnostic(call, "comptime function calls runtime-only function `value`"))
}

#[test]
fn direct_type_writer_matches_compact_document_rendering() -> () {
    let values = Vec::from_array(
        [
            Type::Unit,
            Type::Never,
            Type::Bool,
            Type::Int,
            Type::Int8,
            Type::Int16,
            Type::Int32,
            Type::Int64,
            Type::Uint,
            Type::Uint8,
            Type::Uint16,
            Type::Uint32,
            Type::Uint64,
            Type::Float32,
            Type::Float64,
            Type::String,
            Type::Char,
            Type::Tuple { items: Vec::from_array([Type::Int, Type::String]) },
            Type::Con { name: "sample::Type" },
            Type::Dyn {
                trait_name: "sample::Trait",
                args: Vec::new(),
                associated_types: Vec::new(),
                additional_bounds: Vec::new(),
            },
            Type::Projection {
                for_ty: Type::Con { name: "sample::Type" },
                name: "Item",
                trait_ref: Option::Some(
                    TraitRef { name: "sample::Trait", args: Vec::from_array([Type::Int]) },
                ),
            },
            Type::App { ty: Type::Con { name: "Option" }, args: Vec::new() },
            Type::App { ty: Type::Con { name: "Option" }, args: Vec::from_array([Type::String]) },
            Type::Array { len: 4, elem: Type::Uint8 },
            Type::Slice { elem: Type::Char },
            Type::VecType { elem: Type::String },
            Type::RefType { elem: Type::Bool },
            Type::HashMap { key: Type::String, value: Type::Int },
            Type::Channel { elem: Type::Uint64, direction: ast::ChannelDirection::Both },
            Type::Param { name: "T" },
            Type::Func { params: Vec::from_array([Type::Int, Type::String]), ret_ty: Type::Bool },
            Type::Var(Ref::new(TypeVar::Unbound { id: 1, kind: VarKind::Any })),
            Type::Var(Ref::new(TypeVar::Unbound { id: 2, kind: VarKind::Integer })),
            Type::Var(Ref::new(TypeVar::Unbound { id: 3, kind: VarKind::Float })),
            Type::Var(Ref::new(TypeVar::Link(Type::Char))),
            Type::Error,
        ],
    );
    for value in values {
        testing::assert_eq(type_text(value), pretty::compact(type_doc(value)))
    }
}

#[test]
fn checks_select_channels_bindings_and_branch_types() -> () {
    let valid = checked_diagnostics(
        "fn choose(input: Channel[isize], output: Channel[isize]) -> isize { select { recv(input) as value => value.unwrap_or(0), send(output, 1) => 2, default => 3, } }",
    );
    testing::assert_eq(valid.len(), 0);
    let receive = checked_diagnostics(
        "fn main() -> () { let _ = select { recv(1) as value => value, }; }",
    );
    testing::assert(has_diagnostic_containing(receive, "Channel"));
    let send = checked_diagnostics(
        "fn main(channel: Channel[isize]) -> () { select { send(channel, \"wrong\") => (), } }",
    );
    testing::assert(has_diagnostic(send, "Type mismatch: expected isize, found string"));
    let branches = checked_diagnostics(
        "fn main(channel: Channel[isize]) -> isize { select { recv(channel) as _ => 1, default => \"wrong\", } }",
    );
    testing::assert(has_diagnostic(branches, "Type mismatch: expected isize, found string"))
}

#[test]
fn checks_directional_channel_operations() -> () {
    let valid = checked_diagnostics(
        "fn choose(channel: Channel[isize]) -> () { let sender: Sender[isize] = channel.sender(); let receiver: Receiver[isize] = channel.receiver(); select { recv(receiver) as _ => (), send(sender, 1) => (), default => (), } }",
    );
    testing::assert_eq(valid.len(), 0);
    let receive = checked_diagnostics(
        "fn main(sender: Sender[isize]) -> () { select { recv(sender) as _ => (), default => (), } }",
    );
    testing::assert(has_diagnostic(receive, "Cannot receive from Sender"));
    let send = checked_diagnostics(
        "fn main(receiver: Receiver[isize]) -> () { select { send(receiver, 1) => (), default => (), } }",
    );
    testing::assert(has_diagnostic(send, "Cannot send to Receiver"));
    let method = checked_diagnostics(
        "fn main(receiver: Receiver[isize]) -> () { receiver.close() }",
    );
    testing::assert(has_diagnostic_containing(method, "close"))
}

#[test]
fn checks_select_guards_and_receive_match_scope() -> () {
    let valid = checked_diagnostics(
        "fn choose(channel: Channel[isize]) -> isize { select priority { recv(channel) when true match { Some(value) => value, None => 0, }, default => -1, } }",
    );
    testing::assert_eq(valid.len(), 0);
    let invalid_guard = checked_diagnostics(
        "fn main(channel: Channel[isize]) -> () { select { recv(channel) when 1 as value => (), default => (), } }",
    );
    testing::assert(has_diagnostic(invalid_guard, "Numeric literal cannot be used as bool"));
    let invalid_scope = checked_diagnostics(
        "fn main(channel: Channel[isize]) -> () { select { recv(channel) when value.is_some() as value => (), default => (), } }",
    );
    testing::assert(has_diagnostic(invalid_scope, "Unresolved name value"))
}

#[test]
fn rejects_select_during_comptime_evaluation() -> () {
    let diagnostics = checked_diagnostics(
        "fn main(channel: Channel[isize]) -> () { let _ = comptime { select { recv(channel) as _ => (), } }; }",
    );
    testing::assert(has_diagnostic(diagnostics, "select is not available in comptime"))
}

#[test]
fn external_types_require_resolved_metadata_before_checking() -> () {
    let diagnostics = checked_diagnostics(
        "#[go_type(\"time\", \"Duration\")] extern type Duration;",
    );
    testing::assert(
        has_diagnostic_containing(diagnostics, "external type metadata is not yet connected"),
    )
}
