        ),
    )
}

#[test]
fn rejects_unsafe_dyn_body_annotations() -> () {
    let diagnostics = checked_diagnostics(
        "trait Cloneish { fn clone(self: Self) -> Self; } struct Value { value: i32 } impl Cloneish for Value { fn clone(self: Value) -> Value { self } } fn main() -> () { let _value: dyn Cloneish = Value { value: 1 } as dyn Cloneish; }",
    );
