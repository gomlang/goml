}

#[test]
fn resolves_dyn_dot_methods_and_reports_unavailable_methods() -> () {
    let _ = checked_file(
        "trait Parent { fn parent(self: Self) -> string; } trait Child: Parent { fn child(self: Self) -> string; } fn render(value: dyn Child) -> string { value.child() + value.parent() }",
    );
    let diagnostics = checked_diagnostics(
        "trait Display { fn show(self: Self) -> string; } trait Debug { fn debug(self: Self) -> string; } fn render(value: dyn Display) -> string { value.debug() }",
    );
