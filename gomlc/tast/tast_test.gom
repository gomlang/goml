        Function(value) => match value.body.tail {
            Some(Match { expr: _, arms, ty, .. }) => {
                testing::assert_eq(arms.len(), 2);
                match ty {
                    Int32 => (),
                    _ => testing::fail("expected i32 match result"),
                }
                match arms.get(0).pat {
                    Constr { constructor, args, ty: Con { name } } => {
                        testing::assert_eq(constructor.name, "Choice::Some");
                        testing::assert_eq(args.len(), 1);
                        testing::assert_eq(name, "Choice")
                    },
                    _ => testing::fail("expected constructor pattern"),
                }
                match arms.get(1).body {
                    Prim { value: Int { value }, ty: literal_ty } => {
                        testing::assert_eq(value, "0");
                        match resolve_type(literal_ty) {
                            Int32 => (),
                            _ => testing::fail("expected defaulted i32 literal"),
                        }
                    },
                    _ => testing::fail("expected defaulted i32 literal"),
                }
            },
            _ => testing::fail("expected match tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_contextual_enum_patterns_from_expected_types() -> () {
    let source = "enum First[T] { Shared(T), Empty, Named { value: T } } enum Second[T] { Shared(T) } type Alias = First[i32]; fn classify(value: Alias) -> i32 { match value { Shared(inner) => inner, Empty => 0, Named { value } => value } } fn nested(value: Option[Result[i32, string]]) -> i32 { match value { Some(Ok(inner)) => inner, Some(Err(_)) => -1, None => 0 } }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    let shared = Ref::new(false);
    let some = Ref::new(false);
    let ok = Ref::new(false);
    for reference in result.typeck_results.references {
        if let Constructor(constructor) = reference.target {
            if constructor.name == "First::Shared" {
                shared.set(true)
            } else if constructor.name == "Option::Some" {
                some.set(true)
            } else if constructor.name == "Result::Ok" {
                ok.set(true)
            }
        }
    }
    testing::assert(shared.get());
    testing::assert(some.get());
    testing::assert(ok.get());
    let missing = checked_diagnostics(
        "enum First { Shared } enum Second { Missing } fn classify(value: First) -> i32 { match value { Missing => 1 } }",
    );
    testing::assert(has_diagnostic(missing, "Enum First has no variant Missing"));
    let non_enum = checked_diagnostics(
        "fn classify(value: i32) -> i32 { match value { Some(inner) => inner } }",
    );
    testing::assert_eq(non_enum.len(), 1);
    testing::assert_eq(
        non_enum.get(0).message,
        "Contextual variant Some cannot match value of type i32",
    );
    let unknown = checked_diagnostics(
        "fn inspect() -> () { let matcher = |value| match value { Some(_) => (), _ => () }; let _ = matcher; }",
    );
    testing::assert(has_diagnostic(unknown, "Could not infer enum type for variant Some"))
}

#[test]
fn resolves_associated_types_and_bound_methods() -> () {
    let source = "trait Provider { type Item; fn get(self: Self) -> Self::Item; } struct Number { value: i32 } impl Provider for Number { type Item = i32; fn get(self: Number) -> i32 { self.value } } fn read[P: Provider](provider: P) -> P::Item { provider.get() } fn main() -> i32 { read(Number { value: 42 }) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 3);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Projection { for_ty: Param { name: owner }, name: associated, trait_ref: _ },
            }) => {
                testing::assert_eq(reference.name, "Provider");
                testing::assert_eq(name, "get");
                testing::assert_eq(owner, "P");
                testing::assert_eq(associated, "Item")
            },
            _ => testing::fail("expected bound trait method call"),
        },
        _ => testing::fail("expected read function"),
    }
    match file.items.get(2) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params: _, ret_ty } },
                args: _,
                ty,
            }) => {
                testing::assert_eq(name, "read");
                match (resolve_type(ret_ty), resolve_type(ty)) {
                    (Int32, Int32) => (),
                    _ => testing::fail("expected normalized associated type"),
                }
            },
            _ => testing::fail("expected read call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn preserves_projection_equality_owners() -> () {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } struct LeftSource {} struct RightSource {} impl Source for LeftSource { type Item = i32; fn get(self: LeftSource) -> i32 { 1 } } impl Source for RightSource { type Item = i32; fn get(self: RightSource) -> i32 { 2 } } fn combine[A: Source, B: Source](left: A, right: B) -> () where A::Item = B::Item { () } fn main() -> () { combine(LeftSource {}, RightSource {}) }";
    let file = checked_file(source);
    match file.items.get(3) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params, ret_ty: Unit } },
                args: _,
                ty: Unit,
            }) => {
                testing::assert_eq(name, "combine");
                match (resolve_type(params.get(0)), resolve_type(params.get(1))) {
                    (Con { name: left }, Con { name: right }) => {
                        testing::assert_eq(left, "LeftSource");
                        testing::assert_eq(right, "RightSource")
                    },
                    _ => testing::fail("expected distinct projection equality owners"),
                }
            },
            _ => testing::fail("expected combine call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn applies_where_type_equalities_in_function_bodies() -> () {
    let source = "package api; trait Render { fn render(self: Self) -> string; } fn same[T, U](value: T) -> U where T = U { value } fn structural[T, U](values: Vec[T]) -> Vec[U] where Vec[T] = Vec[U] { values } fn render_equal[T: Render, U](value: U) -> string where T = U { value.render() }";
    let result = check_for_link(
        hir::lower_package(ast::lower(parser::parse(source)), "api.gom", "where_predicates::api"),
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => testing::assert_eq(file.items.len(), 3),
        None => testing::fail("expected TAST"),
    }
}

#[test]
fn rejects_unsatisfied_impl_equality_predicates() -> () {
    let source = "trait Selected { fn selected(self: Self) -> (); } struct Wrap[T] { value: T } impl[T] Selected for Wrap[T] where T = i32 { fn selected(self: Wrap[T]) -> () { () } } fn require[T: Selected](value: T) -> () { () } fn main() -> () { require(Wrap { value: \"no\" }) }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert(!result.diagnostics.is_empty())
}

#[test]
fn checks_extended_builtin_method_catalog() -> () {
    let source = "fn exercise(text: string, values: Vec[isize], map: HashMap[string, i32]) -> () { let _ = text.decode_at(0); let _ = text.to_bytes(); let _ = text.chars(); let _ = text.char_indices(); let _ = text.starts_with(\"a\"); let _ = text.ends_with(\"z\"); let _ = text.contains(\"m\"); let _ = text.starts_with_at(1, \"b\"); let _ = text.find(\"b\"); let _ = text.rfind(\"b\"); let _ = text.find_bytes(\"b\"); let _ = text.char_count(); let _ = text.slice_chars(0, 1); let _ = text.trim(); let _ = text.trim_start(); let _ = text.trim_end(); let _ = text.split(\",\"); let _ = text.split_once(\",\"); let _ = text.lines(); let _ = text.replace(\"a\", \"b\"); let _ = text.repeat(2); let _ = text.is_ascii(); let _ = text.eq_ignore_ascii_case(\"a\"); let _ = text.to_ascii_lowercase(); let _ = text.to_ascii_uppercase(); values.reserve(1); values.insert(0, 1); let _ = values.remove(0); let _ = values.swap_remove(0); values.reverse(); let _ = values.last(); let _ = values.pop(); let _ = values.contains(1); let _ = values.position(|value: isize| value == 1); values.sort_by(|left: isize, right: isize| left - right); values.dedup(); let _ = values.join(\",\"); values.truncate(0); values.clear(); let _ = map.entries(); }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 1)
}

