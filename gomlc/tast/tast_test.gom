#[test]
fn normalizes_and_escapes_char_literals() -> () {
    match parse_char_literal("\\u0041") {
        Some(value) => testing::assert(value == 'A'),
        None => testing::fail("expected unicode char literal"),
    }
    testing::assert_eq(primitive_text(Primitive::Char { value: 'A' }), "'A'");
    testing::assert_eq(primitive_text(Primitive::Char { value: '\n' }), "'\\n'");
    testing::assert_eq(primitive_text(Primitive::Char { value: '\\' }), "'\\\\'")
}

#[test]
fn resolves_generic_trait_associated_applications() -> () {
    let source = "trait Convert[T] { type Output; fn convert(self: Self) -> Self::Output; } struct Value {} struct Wrapped[T] { value: T } impl Convert[i32] for Value { type Output = string; fn convert(self: Value) -> string { \"isize\" } } impl Convert[string] for Value { type Output = i32; fn convert(self: Value) -> i32 { 7 } } impl[T] Convert[T] for Wrapped[T] { type Output = T; fn convert(self: Wrapped[T]) -> T { self.value } } fn main() -> () { let text: string = Convert::[i32]::convert(Value {}); let number: i32 = Convert::[string]::convert(Value {}); let generic: string = Convert::[string]::convert(Wrapped { value: \"ok\" }); }";
    let file = checked_file(source);
    match file.items.get(3) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string associated output"),
            }
            match value.body.stmts.get(1) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected i32 associated output"),
            }
            match value.body.stmts.get(2) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected generic associated output"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn resolves_trait_methods_from_call_context() -> () {
    let source = "trait Put[T] { fn put(self: Self, arg1: T) -> string; } struct Target {} impl Put[i32] for Target { fn put(self: Target, value: i32) -> string { value.to_string() } } impl Put[string] for Target { fn put(self: Target, value: string) -> string { value } } trait Convert[T] { type Output; fn convert(self: Self) -> Self::Output; } struct Convertible {} impl Convert[i32] for Convertible { type Output = string; fn convert(self: Convertible) -> string { \"text\" } } impl Convert[string] for Convertible { type Output = i32; fn convert(self: Convertible) -> i32 { 7 } } trait Source[T] where Self::Item = T { type Item; fn get(self: Self) -> Self::Item; } struct Number { value: i32 } impl Source[i32] for Number { type Item = i32; fn get(self: Number) -> i32 { self.value } } fn read[T, S: Source[T]](source: S) -> T { Source::[T]::get(source) } trait ItemSource { type Item; fn item(self: Self) -> Self::Item; } trait Select[T] { fn select(self: Self) -> T; } impl[S: ItemSource, T] Select[T] for S where S::Item = T { fn select(self: S) -> T { ItemSource::item(self) } } fn invoke[T, S: Select[T]](source: S) -> T { source.select() } fn main() -> () { let numeric: string = (Target {}).put(1); let textual: string = (Target {}).put(\"goml\"); let text: string = (Convertible {}).convert(); let number: i32 = (Convertible {}).convert(); let value: i32 = read(Number { value: 8 }); }";
    let file = checked_file(source);
    match file.items.get(7) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Param { name: result },
            }) => {
                testing::assert_eq(reference.name, "Select");
                testing::assert_eq(name, "select");
                match reference.args.get(0) {
                    Param { name: arg } => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected contextual trait argument"),
                }
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected contextual bound method"),
        },
        _ => testing::fail("expected invoke function"),
    }
    match file.items.get(8) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected integer overload"),
            }
            match value.body.stmts.get(1) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string overload"),
            }
            match value.body.stmts.get(2) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: String },
                    value: Call { func: _, args: _, ty: String },
                } => (),
                _ => testing::fail("expected string return overload"),
            }
            match value.body.stmts.get(3) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected i32 return overload"),
            }
            match value.body.stmts.get(4) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: Int32 },
                    value: Call { func: _, args: _, ty: Int32 },
                } => (),
                _ => testing::fail("expected implied equality result"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn resolves_builtin_for_iterator_types() -> () {
    let source = "fn iterate(numbers: Vec[i32], words: Slice[string]) -> () { for _ in numbers {}; for _ in words {}; }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Expr {
                    expr: For {
                        pat: _,
                        iterator: _,
                        into_iter_trait_ref: _,
                        iterator_trait_ref: _,
                        iterator_ty: App { ty: Con { name: owner }, args },
                        body: _,
                        ty: _,
                    },
                } => {
                    testing::assert_eq(owner, "FnIterator");
                    match args.get(0) {
                        Int32 => (),
                        _ => testing::fail("expected i32 vector iterator"),
                    }
                },
                _ => testing::fail("expected vector for loop"),
            }
            match value.body.stmts.get(1) {
                Expr {
                    expr: For {
                        pat: _,
                        iterator: _,
                        into_iter_trait_ref: _,
                        iterator_trait_ref: _,
                        iterator_ty: App { ty: Con { name: owner }, args },
                        body: _,
                        ty: _,
                    },
                } => {
                    testing::assert_eq(owner, "FnIterator");
                    match args.get(0) {
                        String => (),
                        _ => testing::fail("expected string slice iterator"),
                    }
                },
                _ => testing::fail("expected slice for loop"),
            }
        },
        _ => testing::fail("expected iterate function"),
    }
}

#[test]
fn preserves_associated_into_iterator_item_projection() -> () {
    let file = checked_file(
        "trait Batch { type Items: IntoIterator; fn items(self: Self) -> Self::Items; } fn iterate[B: Batch](batch: B) -> () { for _ in Batch::items(batch) {} }",
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(For {
                pat: Wild {
                    ty: Projection {
                        for_ty: Projection {
                            for_ty: Projection {
                                for_ty: Param { name: owner },
                                name: items,
                                trait_ref: _,
                            },
                            name: into_iter,
                            trait_ref: _,
                        },
                        name: item,
                        trait_ref: _,
                    },
                },
                iterator: _,
                into_iter_trait_ref: _,
                iterator_trait_ref: _,
                iterator_ty: _,
                body: _,
                ty: Unit,
            }) => {
                testing::assert_eq(owner, "B");
                testing::assert_eq(items, "Items");
                testing::assert_eq(into_iter, "IntoIter");
                testing::assert_eq(item, "Item")
            },
            _ => testing::fail("expected associated iterator projection"),
        },
        _ => testing::fail("expected iterate function"),
    }
}

#[test]
fn resolves_iterator_item_for_for_loop_method_calls() -> () {
    let source = "struct Values {} impl Iterator for Values { type Item = i32; fn next(self: Values) -> Option[i32] { Option::None } } fn main() -> () { for value in (Values {}) { println(value.to_string()); }; }";
    let result = check_for_link(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0)
}

#[test]
fn accepts_builtin_into_iterator_predicates() -> () {
    let source = "fn sum[S: IntoIterator](source: S) -> i32 where S::Item = i32 { let total = Ref::new(0); for value in source { total.set(total.get() + value); }; total.get() } fn use_values(values: Vec[i32], slice: Slice[i32]) -> () { let _ = sum(values); let _ = sum(slice); }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => match file.items.get(0) {
            Function(value) => {
                testing::assert_eq(value.predicates.len(), 4);
                match value.predicates.get(0) {
                    Trait { for_ty: Param { name: param }, trait_ref: reference } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(reference.name, "IntoIterator")
                    },
                    _ => testing::fail("expected IntoIterator predicate"),
                }
                match value.predicates.get(1) {
                    Equality {
                        lhs: Projection {
                            for_ty: Param { name: param },
                            name,
                            trait_ref: Some(reference),
                        },
                        rhs: Int32,
                    } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(name, "Item");
                        testing::assert_eq(reference.name, "IntoIterator")
                    },
                    _ => testing::fail("expected explicit Item equality"),
                }
                match value.predicates.get(2) {
                    Equality {
                        lhs: Projection {
                            for_ty: Param { name: item_param },
                            name: item_name,
                            trait_ref: Some(into_iterator),
                        },
                        rhs: Projection {
                            for_ty: Projection {
                                for_ty: Param { name: iter_param },
                                name: iter_name,
                                trait_ref: Some(iter_owner),
                            },
                            name: iterator_item_name,
                            trait_ref: Some(iterator),
                        },
                    } => {
                        testing::assert_eq(item_param, "S");
                        testing::assert_eq(item_name, "Item");
                        testing::assert_eq(into_iterator.name, "IntoIterator");
                        testing::assert_eq(iter_param, "S");
                        testing::assert_eq(iter_name, "IntoIter");
                        testing::assert_eq(iter_owner.name, "IntoIterator");
                        testing::assert_eq(iterator_item_name, "Item");
                        testing::assert_eq(iterator.name, "Iterator")
                    },
                    _ => testing::fail("expected implied Item equality"),
                }
                match value.predicates.get(3) {
                    Trait {
                        for_ty: Projection {
                            for_ty: Param { name: param },
                            name,
                            trait_ref: Some(owner),
                        },
                        trait_ref: reference,
                    } => {
                        testing::assert_eq(param, "S");
                        testing::assert_eq(name, "IntoIter");
                        testing::assert_eq(owner.name, "IntoIterator");
                        testing::assert_eq(reference.name, "Iterator")
                    },
                    _ => testing::fail("expected IntoIter Iterator predicate"),
                }
            },
            _ => testing::fail("expected sum function"),
        },
        None => testing::fail("expected TAST"),
    }
}

#[test]
fn resolves_projected_trait_impls() -> () {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } trait Pick[T] { fn pick(self: Self) -> T; } impl[S: Source] Pick[S::Item] for S { fn pick(self: S) -> S::Item { Source::get(self) } } struct Value { value: i32 } impl Source for Value { type Item = i32; fn get(self: Value) -> i32 { self.value } } fn main() -> i32 { (Value { value: 41 }).pick() }";
    let file = checked_file(source);
    match file.items.get(2) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Int32,
            }) => {
                testing::assert_eq(reference.name, "Pick");
                testing::assert_eq(name, "pick");
                match resolve_type(reference.args.get(0)) {
                    Projection { for_ty: Con { name: owner }, name: item, trait_ref: _ } => {
                        testing::assert_eq(owner, "Value");
                        testing::assert_eq(item, "Item")
                    },
                    _ => testing::fail("expected projected trait argument"),
                }
            },
            _ => testing::fail("expected projected trait method call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn accepts_projected_trait_predicates() -> () {
    let source = "trait Source { type Item; fn get(self: Self) -> Self::Item; } trait Pick[T] { fn pick(self: Self) -> T; } impl[S: Source] Pick[S::Item] for S { fn pick(self: S) -> S::Item { Source::get(self) } } struct Value { value: i32 } impl Source for Value { type Item = i32; fn get(self: Value) -> i32 { self.value } } fn copy[S: Source + Pick[S::Item]](source: S) -> S::Item { Pick::[S::Item]::pick(source) } fn main() -> i32 { copy(Value { value: 42 }) }";
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0)
}

#[test]
fn resolves_constrained_blanket_methods() -> () {
    let source = "trait Mark { fn mark(self: Self) -> string; } trait Label { fn label(self: Self) -> string; } struct Box[T] { value: T } impl Mark for i32 { fn mark(self: i32) -> string { self.to_string() } } impl[T: Mark] Label for Box[T] { fn label(self: Box[T]) -> string { self.value.mark() } } impl Label for Box[string] { fn label(self: Box[string]) -> string { self.value } } fn string_label() -> string { (Box { value: \"text\" }).label() } fn marked_label() -> string { (Box { value: 7 }).label() }";
    let file = checked_file(source);
    for index in 3..5 {
        match file.items.get(index) {
            Function(value) => match value.body.tail {
                Some(Call {
                    func: Callable {
                        callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                        ty: Func { params, ret_ty: String },
                    },
                    args: _,
                    ty: String,
                }) => {
                    testing::assert_eq(reference.name, "Label");
                    testing::assert_eq(name, "label");
                    match resolve_type(params.get(0)) {
                        App { ty: Con { name: owner }, args } => {
                            testing::assert_eq(owner, "Box");
                            if index == 3 {
                                match resolve_type(args.get(0)) {
                                    String => (),
                                    _ => testing::fail("expected string impl"),
                                }
                            } else {
                                match resolve_type(args.get(0)) {
                                    Int32 => (),
                                    _ => testing::fail("expected constrained blanket impl"),
                                }
                            }
                        },
                        _ => testing::fail("expected instantiated Box receiver"),
                    }
                },
                _ => testing::fail("expected constrained trait method call"),
            },
            _ => testing::fail("expected label function"),
        }
    }
}

#[test]
fn normalizes_float_pattern_literals() -> () {
    let file = checked_file(
        "fn signed_zero(value: f64) -> string { match value { -0.0 => \"zero\", _ => \"other\" } }",
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Match { expr: _, arms, ty: String, .. }) => match arms.get(0).pat {
                Prim { value: Float { value: literal }, ty: Float64 } => {
                    testing::assert_eq(literal, "-0")
                },
                _ => testing::fail("expected normalized float pattern"),
            },
            _ => testing::fail("expected float match"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn rounds_float32_literals() -> () {
    testing::assert_eq(increment_decimal("99999999999999999999"), "100000000000000000000");
    testing::assert_eq(normalized_float32_literal("3.1400001"), "3.14");
    testing::assert_eq(normalized_float32_literal("16777217"), "16777216");
    testing::assert_eq(normalized_float32_literal("1.23456789"), "1.2345679");
    testing::assert_eq(normalized_float32_literal("1e20"), "100000000000000000000");
    testing::assert_eq(normalized_float32_literal("1e-20"), "0.00000000000000000001");
    testing::assert_eq(normalized_float32_literal("-0.0"), "-0");
    testing::assert_eq(
        normalized_float32_literal("1.0000000596046447753906249999999999999999"),
        "1",
    );
    testing::assert_eq(normalized_float32_literal("1.000000059604644775390625"), "1");
    testing::assert_eq(
        normalized_float32_literal("1.0000000596046447753906250000000000000001"),
        "1.0000001",
    );
    let file = checked_file("fn inferred() -> f32 { 3.14 } fn explicit() -> f32 { 3.14 }");
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Prim { value: Float { value: literal }, ty }) => {
                testing::assert_eq(literal, "3.14");
                match resolve_type(ty) {
                    Float32 => (),
                    _ => testing::fail("expected inferred f32 literal type"),
                }
            },
            _ => testing::fail("expected rounded inferred f32 literal"),
        },
        _ => testing::fail("expected inferred function"),
    }
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Prim { value: Float { value: literal }, ty: Float32 }) => {
                testing::assert_eq(literal, "3.14")
            },
            _ => testing::fail("expected rounded explicit f32 literal"),
        },
        _ => testing::fail("expected explicit function"),
    }
    let generic = checked_file(
        "fn identity[T](value: T) -> T { value } fn inferred() -> f32 { identity(3.14) }",
    );
    match generic.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call { func: _, args, ty: Float32 }) => match args.get(0) {
                Prim { value: Float { value: literal }, ty } => {
                    testing::assert_eq(literal, "3.14");
                    match resolve_type(ty) {
                        Float32 => (),
                        _ => testing::fail("expected generic f32 argument type"),
                    }
                },
                _ => testing::fail("expected generic float literal argument"),
            },
            _ => testing::fail("expected generic float call"),
        },
        _ => testing::fail("expected generic inferred function"),
    }
}

#[test]
fn rejects_overflowing_float_literals() -> () {
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn value() -> f32 { 1e39 }"),
            "Float literal 1e39 cannot be represented as f32",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn value() -> f64 { 1e309 }"),
            "Float literal 1e309 cannot be represented as f64",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn main() -> () { let _ = 1e309; }"),
            "Float literal 1e309 cannot be represented as f64",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "fn identity[T](value: T) -> T { value } fn value() -> f32 { identity(1e39) }",
            ),
            "Float literal 1e39 cannot be represented as f32",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "fn classify(value: f32) -> bool { match value { 1e39 => true, _ => false } }",
            ),
            "Float literal 1e39 cannot be represented as f32",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics(
                "fn classify(value: f64) -> bool { match value { 1e309 => true, _ => false } }",
            ),
            "Float literal 1e309 cannot be represented as f64",
        ),
    );
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn value() -> i64 { 1e309 }"),
            "Float literal 1e309 cannot be represented as i64",
        ),
    );
    testing::assert_eq(
        checked_diagnostics("fn tiny32() -> f32 { 1e-999999 } fn tiny64() -> f64 { 1e-999999 }").len(),
        0,
    );
    testing::assert_eq(
        checked_diagnostics(
            "fn maximum32() -> f32 { 3.4028235e38 } fn maximum64() -> f64 { 1.7976931348623157e308 }",
        ).len(),
        0,
    )
}

#[test]
fn checks_exact_float_literals_in_integer_patterns() -> () {
    let valid = checked_diagnostics(
        "fn exact() -> i64 { 9007199254740993.0 } fn signed_max() -> i64 { 9223372036854775807.0 } fn unsigned_max() -> u64 { 18446744073709551615.0 } fn signed(value: i64) -> bool { match value { -9223372036854775808.0 => true, _ => false } } fn unsigned(value: u64) -> bool { match value { 18446744073709551615.0 => true, _ => false } }",
    );
    testing::assert_eq(valid.len(), 0);
    let file = checked_file(
        "fn classify(value: i64) -> bool { match value { 9007199254740993.0 => true, _ => false } }",
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Match { expr: _, arms, .. }) => match arms.get(0).pat {
                Prim { value: Int { value }, ty: Int64 } => {
                    testing::assert_eq(value, "9007199254740993")
                },
                _ => testing::fail("expected exact integer pattern"),
            },
            _ => testing::fail("expected match expression"),
        },
        _ => testing::fail("expected classify function"),
    }
    let invalid = checked_diagnostics(
        "fn fractional(value: i64) -> bool { match value { 1.5 => true, _ => false } } fn precise(value: i64) -> bool { match value { 1.0000000000000001 => true, _ => false } } fn tiny(value: i64) -> bool { match value { 1e-999999 => true, _ => false } } fn signed_over(value: i64) -> bool { match value { 9223372036854775808.0 => true, _ => false } } fn unsigned_over(value: u64) -> bool { match value { 18446744073709551616.0 => true, _ => false } } fn huge(value: i64) -> bool { match value { 1e999999 => true, _ => false } }",
    );
    testing::assert_eq(invalid.len(), 6);
    testing::assert(has_diagnostic(invalid, "Float literal 1.5 cannot be represented as i64"));
    testing::assert(
        has_diagnostic(invalid, "Float literal 1.0000000000000001 cannot be represented as i64"),
    );
    testing::assert(has_diagnostic(invalid, "Float literal 1e-999999 cannot be represented as i64"));
    testing::assert(
        has_diagnostic(invalid, "Integer literal 9223372036854775808 does not fit in i64"),
    );
    testing::assert(
        has_diagnostic(invalid, "Integer literal 18446744073709551616 does not fit in u64"),
    );
    testing::assert(has_diagnostic(invalid, "Float literal 1e999999 cannot be represented as i64"))
}

#[test]
fn indents_array_control_flow_expressions() -> () {
    let file = checked_file("fn choose(flag: bool) -> [i32; 1] { [if flag { 1 } else { 2 }] }");
    let expected = "fn choose(flag/0: bool) -> [i32; 1] {\n" + "    [\n"
        + "      if (flag/0 : bool) {\n"
        + "          {\n"
        + "              1\n"
        + "          }\n"
        + "      } else {\n"
        + "          {\n"
        + "              2\n"
        + "          }\n"
        + "      }\n"
        + "    ]\n"
        + "}";
    testing::assert_eq(encode_file(file), expected)
}

#[test]
fn resolves_supertraits_and_implied_predicates() -> () {
    let source = "trait Parent[T] { fn parent(self: Self) -> T; } trait Render { fn render(self: Self) -> string; } trait Label { fn label(self: Self) -> string; } trait Marker { fn marker(self: Self) -> string; } trait Child[T: Label]: Parent[T] + Render where T: Marker { fn child(self: Self) -> string; } fn describe[T, B: Child[T]](value: B) -> string { value.parent().label() + value.parent().marker() + value.render() + value.child() } fn inherited[T, B: Child[T]](value: B) -> T { Child::[T]::parent(value) }";
    let file = checked_file(source);
    testing::assert_eq(file.items.len(), 2);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: Param { name: result },
            }) => {
                testing::assert_eq(reference.name, "Parent");
                testing::assert_eq(reference.args.len(), 1);
                match reference.args.get(0) {
                    Param { name: arg } => testing::assert_eq(arg, "T"),
                    _ => testing::fail("expected inherited trait argument"),
                }
                testing::assert_eq(name, "parent");
                testing::assert_eq(result, "T")
            },
            _ => testing::fail("expected inherited static trait call"),
        },
        _ => testing::fail("expected inherited function"),
    }
}

#[test]
fn validates_trait_associated_function_self_resolution() -> () {
    let valid = checked_diagnostics(
        "trait Decode { fn decode(input: string) -> Self; } trait TryDecode { fn try_decode(input: string) -> Result[Self, string]; } trait Default { fn default() -> Self; } struct Value { value: i32 } impl Decode for Value { fn decode(input: string) -> Value { Value { value: 1 } } } impl TryDecode for Value { fn try_decode(input: string) -> Result[Value, string] { Result::Ok(Value { value: 1 }) } } impl Default for Value { fn default() -> Value { Value { value: 0 } } } fn decode[T: Decode](input: string) -> T { Decode::decode(input) } fn try_decode[T: TryDecode](input: string) -> Result[T, string] { let value: T = TryDecode::try_decode(input)?; Result::Ok(value) } fn make[T: Default]() -> T { Default::default() }",
    );
    testing::assert_eq(valid.len(), 0);
    let ambiguous = checked_diagnostics(
        "trait Default { fn default() -> Self; } fn value() -> () { let result = Default::default(); () }",
    );
    testing::assert(
        has_diagnostic(
            ambiguous,
            "Could not infer the Self type for associated function Default::default",
        ),
    );
    let mismatched = checked_diagnostics(
        "trait Default { fn default() -> Self; } struct Value {} impl Default for Value { fn default(self: Value) -> Value { self } }",
    );
    testing::assert(
        has_diagnostic(mismatched, "Trait Default::default expects 0 parameters but impl has 1"),
    )
}

#[test]
fn rejects_trait_associated_functions_in_dyn_traits() -> () {
    let diagnostics = checked_diagnostics(
