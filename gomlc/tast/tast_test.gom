#[test]
fn restricts_expression_as_to_dyn_conversions() -> () {
    let diagnostics = checked_diagnostics(
        "fn main() -> () { let value: i16 = 257; let _ = value as u8; let _ = 'A' as u32; let _ = true as u8; }",
    );
    testing::assert_eq(diagnostics.len(), 3);
    testing::assert(
        has_diagnostic(
            diagnostics,
            "`as` only creates dyn trait values; use `value.to_u8()` for numeric conversion",
        ),
    );
    testing::assert(
        has_diagnostic(
            diagnostics,
            "`as` only creates dyn trait values; use `value.to_u32()` for numeric conversion",
        ),
    );
    testing::assert(
        has_diagnostic(
            diagnostics,
            "`as` only creates dyn trait values; target must be a dyn trait type",
        ),
    )
}

#[test]
fn requires_explicit_dyn_conversions_in_typed_contexts() -> () {
    for source in[
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn produce() -> dyn Label { 1 }",
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn main() -> () { let direct: dyn Label = 1; }",
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn accept(value: dyn Label) -> () {} fn main() -> () { accept(1); }",
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn main() -> () { let branch: dyn Label = if true { 1 as dyn Label } else { 2 }; }",
        "trait Label { fn label(self: Self) -> string; } impl Label for i32 { fn label(self: i32) -> string { self.to_string() } } fn main() -> () { let values: Vec[dyn Label] = Vec::new(); values.push(1); }",
    ] {
        testing::assert(
            has_diagnostic(
                checked_diagnostics(source),
                "explicit dyn conversion required; use `value as dyn Label`",
            ),
        )
    }
}

#[test]
fn validates_numeric_unary_operators() -> () {
    let diagnostics = checked_diagnostics("fn main() -> () { let a = -true; let b = ~false; }");
    testing::assert_eq(diagnostics.len(), 2);
    testing::assert(has_diagnostic(diagnostics, "Operator - is not defined for type bool"));
    testing::assert(has_diagnostic(diagnostics, "Operator ~ is not defined for type bool"))
}

#[test]
fn types_control_flow_member_subexpressions_as_unit() -> () {
    let source = "#[allow(unreachable_code)] fn projected() -> i32 { let _: i32 = (return 1).0; 0 } #[allow(unreachable_code)] fn indexed() -> i32 { let _: i32 = (return 1)[0]; 0 } #[allow(unreachable_code)] fn field() -> i32 { let _: i32 = (return 1).value; 0 }";
    let file = checked_file(source);
    for index in 0..3 {
        match file.items.get(index) {
            Function(value) => match value.body.stmts.get(0) {
                Let { is_mut: _, pat: Wild { ty: pattern_ty }, value: expression } => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (Int32, Unit) => (),
                        _ => testing::fail("expected () control flow expression type"),
                    }
                    if index == 1 {
                        match expression {
                            Index {
                                base: _,
                                index: Prim { value: Int { value }, ty: Int },
                                ty: Unit,
                            } => testing::assert_eq(value, "0"),
                            _ => testing::fail("expected preserved index expression"),
                        }
                    }
                },
                _ => testing::fail("expected typed control flow binding"),
            },
            _ => testing::fail("expected control flow function"),
        }
    }
}

#[test]
fn suppresses_unreachable_while_condition_type_errors() -> () {
    let wrapped_index = checked_diagnostics(
        "fn main() -> () { while (match 0 { 0 => break, _ => continue, })[0] { break; }; }",
    );
    testing::assert_eq(wrapped_index.len(), 2);
    testing::assert(has_diagnostic(wrapped_index, "`break` is not allowed in a while condition"));
    testing::assert(has_diagnostic(wrapped_index, "`continue` is not allowed in a while condition"));
    let wrapped_call = checked_diagnostics(
        "fn id_int(x: i32) -> i32 { x } fn main() -> () { while id_int(if true { break } else { continue }) { break; }; }",
    );
    testing::assert_eq(wrapped_call.len(), 2);
    testing::assert(has_diagnostic(wrapped_call, "`break` is not allowed in a while condition"));
    testing::assert(has_diagnostic(wrapped_call, "`continue` is not allowed in a while condition"))
}

