    dependencies.push(
        dependency_hir(
            "package data; use vendor::traits; pub struct Card { value: i32 } impl traits::Render for Card { fn render(self: Card) -> string { \"R\" } } impl traits::Fancy for Card { fn render(self: Card) -> string { \"F\" } }",
            "vendor::data",
        ),
    );
    let file = checked_package_file_with_dependencies(
        "package usepkg; use vendor::data; use vendor::traits; use traits::Render; fn render(value: data::Card) -> string { value.render() }",
        dependencies,
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable {
                    callable: TraitMethod { trait_ref: reference, method_name: name, .. },
                    ty: _,
                },
                args: _,
                ty: String,
            }) => {
                testing::assert_eq(reference.name, "vendor::traits::Render");
                testing::assert_eq(name, "render")
            },
            _ => testing::fail("expected scoped external trait method"),
        },
        _ => testing::fail("expected render function"),
    }
}

