package tast;

use module::ast;
use module::hir;
use module::parser;
use module::pretty;
use std::testing;
use std::text;

fn checked_file(source: string) -> File {
    let result = check(hir::lower(ast::lower(parser::parse(source)), "main.gom"));
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn checked_diagnostics(source: string) -> Vec[Diagnostic] {
    check(hir::lower(ast::lower(parser::parse(source)), "main.gom")).diagnostics
}

#[test]
fn checks_never_return_and_callback_annotations() -> () {
    let file = checked_file(
        "fn stop() -> never { loop {} } fn invoke(body: () -> never) -> never { body() } fn main() -> () {}",
    );
    testing::assert_eq(file.items.len(), 3);
    testing::assert(!checked_diagnostics("fn invalid() -> never { () }").is_empty())
}

#[test]
fn never_annotations_reject_returning_values_and_callback_signatures() -> () {
    for source in Vec::from_array(
        [
            "fn invalid() -> never { () }",
            "fn invalid() -> never {}",
            "fn invalid() -> never { return; }",
            "fn invalid() -> never { return 1; }",
            "fn invalid() -> never { loop { break; } }",
            "fn invalid() -> () { let _value: never = (); }",
            "fn invalid() -> () { let _value: never = 1; }",
            "fn invalid() -> () { let _callback: () -> never = || (); }",
            "fn invalid() -> () { let _callback: () -> never = || { return; }; }",
            "fn ordinary() -> () {} fn invalid() -> () -> never { ordinary }",
            "fn accept(callback: () -> never) -> () {} fn invalid() -> () { accept(|| ()); }",
            "fn ordinary() -> () {} fn accept(callback: () -> never) -> () {} fn invalid() -> () { accept(ordinary); }",
            "fn identity[T](value: T) -> T { value } fn invalid() -> never { identity(()) }",
            "fn invalid(flag: bool) -> never { if flag { loop {} } else { () } }",
            "fn invalid(flag: bool) -> never { match flag { true => loop {}, false => () } }",
            "fn invalid(value: Result[(), string]) -> never { value?; loop {} }",
        ],
    ) {
        let diagnostics = checked_diagnostics(source);
        if diagnostics.is_empty() {
            testing::fail("accepted returning value as never: " + source);
        }
    }
}

#[test]
fn never_is_invariant_inside_existing_container_and_function_values() -> () {
    for source in Vec::from_array(
        [
            "fn invalid(value: Vec[()]) -> Vec[never] { value }",
            "fn invalid(value: Vec[never]) -> Vec[()] { value }",
            "fn invalid(value: ((), isize)) -> (never, isize) { value }",
            "fn invalid(value: () -> ()) -> () -> never { value }",
            "fn invalid(value: () -> never) -> () -> isize { value }",
            "fn invalid(value: (never) -> ()) -> (isize) -> () { value }",
            "fn invalid(value: Option[() -> ()]) -> Option[() -> never] { value }",
        ],
    ) {
        if checked_diagnostics(source).is_empty() {
            testing::fail("accepted incompatible nested never type: " + source);
        }
    }
}

#[test]
fn never_expressions_preserve_branch_return_try_and_callback_inference() -> () {
    let prefix = "fn stop() -> never { loop {} } ";
    for source in Vec::from_array(
        [
            "fn value() -> isize { stop() }",
            "fn value() -> string { stop() }",
            "fn value() -> Vec[isize] { stop() }",
            "trait Item { fn value(self: Self) -> isize; } fn value() -> dyn Item { stop() }",
            "fn value(flag: bool) -> isize { if flag { stop() } else { 42 } }",
            "fn value(flag: bool) -> isize { if flag { 42 } else { stop() } }",
            "fn value(flag: bool) -> never { if flag { stop() } else { loop {} } }",
            "fn value(flag: bool) -> isize { match flag { true => stop(), false => 42 } }",
            "fn value(flag: bool) -> isize { if flag { return 42; } stop() }",
            "fn value(flag: bool) -> never { return if flag { stop() } else { loop {} }; }",
            "fn value(input: Result[(), string]) -> Result[isize, string] { input?; stop() }",
            "fn value(input: Option[()]) -> Option[isize] { input?; stop() }",
            "fn value() -> () -> never { || stop() }",
            "fn value() -> () -> isize { || stop() }",
            "fn accept[T](callback: () -> T) -> () {} fn value() -> () { accept(|| stop()); }",
            "fn value() -> () -> () { let callback = || stop(); callback }",
            "fn value() -> (isize, bool) { (stop(), true) }",
            "fn value() -> () { let _value: never = stop(); }",
        ],
    ) {
        let diagnostics = checked_diagnostics(prefix + source);
        if !diagnostics.is_empty() {
            let messages: Vec[string] = Vec::new();
            for diagnostic in diagnostics {
                messages.push(diagnostic.message);
            }
            testing::fail(
                "rejected nonreturning expression: " + source + "\n" + messages.join("\n"),
            );
        }
    }
}

fn has_diagnostic(values: Vec[Diagnostic], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.message == expected {
            found.set(true)
        }
    }
    found.get()
}

fn has_diagnostic_containing(values: Vec[Diagnostic], expected: string) -> bool {
    let found = Ref::new(false);
    for value in values {
        if value.message.contains(expected) {
            found.set(true)
        }
    }
    found.get()
}

fn assert_single_unreachable_code_warning(label: string, values: Vec[Diagnostic]) -> () {
    if values.len() != 1 {
        let mut messages = label + ": expected one unreachable code warning";
        for value in values {
            messages += "\n" + value.message;
        }
        testing::fail(messages)
    }
    testing::assert_eq(values[0].message, "unreachable_code: unreachable code")
}

#[test]
fn evaluates_explicit_comptime_functions() -> () {
    let file = checked_file(
        "#[comptime] fn fibonacci(n: isize) -> isize { if n < 2 { n } else { fibonacci(n - 1) + fibonacci(n - 2) } } fn main() -> isize { comptime { fibonacci(10) } }",
    );
    testing::assert_eq(file.items.len(), 2);
    match file.items[1] {
        Function(value) => match value.body.tail {
            Some(Prim { value: Primitive::Int { value }, ty: _ }) => {
                testing::assert_eq(value, "55")
            },
            _ => testing::fail("expected a reified comptime integer"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn validates_comptime_derive_capability_boundaries() -> () {
    let named = checked_file(
        "#[comptime_derive(Label)] pub fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    match named.items[0] {
        Function(value) => match value.derive_export_name {
            Some(name) => testing::assert_eq(name, "Label"),
            None => testing::fail("expected named derive export"),
        },
        _ => testing::fail("expected named derive handler"),
    }
    let private_named = checked_diagnostics(
        "#[comptime_derive(Label)] fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(
        has_diagnostic(private_named, "a named #[comptime_derive] export must be public"),
    );
    let invalid_name = checked_diagnostics(
        "#[comptime_derive(owner::Label)] pub fn handler(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(
        has_diagnostic(
            invalid_name,
            "#[comptime_derive] accepts at most one identifier export name",
        ),
    );
    let duplicate = checked_diagnostics(
        "#[comptime_derive(Label)] pub fn first(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") } #[comptime_derive(Label)] pub fn second(input: DeriveInput) -> DeriveOutput { derive_output_new(input, \"Label\") }",
    );
    testing::assert(has_diagnostic(duplicate, "duplicate comptime derive export `Label`"));
    let invalid_signature = checked_diagnostics(
        "#[comptime_derive] pub fn handler() -> isize { 1 }",
    );
    testing::assert(
        has_diagnostic(
            invalid_signature,
            "public #[comptime_derive] function must have signature (DeriveInput) -> DeriveOutput",
        ),
    );
    let runtime_call = checked_diagnostics(
        "#[comptime_derive] fn helper() -> isize { 1 } fn value() -> isize { helper() }",
    );
    testing::assert(
        has_diagnostic(
            runtime_call,
            "#[comptime_derive] function is only callable from another derive handler",
        ),
    );
    let intrinsic_call = checked_diagnostics("fn value() -> MetaExpr { meta_expr_unit() }");
    testing::assert(
        has_diagnostic(
            intrinsic_call,
            "derive intrinsic `meta_expr_unit` is only available in #[comptime_derive]",
        ),
    );
    let leaked_type = checked_diagnostics("fn value(input: DeriveInput) -> DeriveInput { input }");
    testing::assert(
        has_diagnostic(
            leaked_type,
            "derive metadata type DeriveInput is only available in #[comptime_derive]",
        ),
    )
}

#[test]
fn evaluates_comptime_shadowing_like_runtime() -> () {
    let file = checked_file(
        "#[comptime] fn shadow(value: isize) -> isize { let base = value; let nested = { let base = base + 1; base * 2 }; base + nested } fn main() -> isize { comptime { shadow(3) } }",
    );
    match file.items[1] {
        Function(value) => match value.body.tail {
            Some(Prim { value: Primitive::Int { value }, ty: _ }) => {
                testing::assert_eq(value, "12")
            },
            _ => testing::fail("expected a shadowed comptime integer"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn eliminates_comptime_before_core_lowering() -> () {
    let file = checked_file(
        "#[comptime] fn double(value: isize) -> isize { value * 2 } fn main() -> isize { comptime { double(21) } }",
    );
    testing::assert(!contains_comptime(file))
}

#[test]
fn evaluates_top_level_constants_with_comptime_functions() -> () {
    let file = checked_file(
        "#[comptime] fn square(value: isize) -> isize { value * value } const answer: isize = square(12); fn main() -> isize { answer }",
    );
    testing::assert_eq(file.constants.len(), 1);
    match file.constants[0].value {
        ConstExpr::Prim { value: Primitive::Int { value }, ty: _ } => {
            testing::assert_eq(value, "144")
        },
        _ => testing::fail("expected a finalized comptime constant"),
    }
}

#[test]
fn rejects_runtime_capture_and_runtime_only_calls_in_comptime() -> () {
    let capture = checked_diagnostics("fn main(value: isize) -> isize { comptime { value + 1 } }");
    testing::assert(
        has_diagnostic(capture, "comptime expression cannot capture runtime local `value/0`"),
    );
    let runtime_call = checked_diagnostics(
        "fn runtime_value() -> isize { 1 } fn main() -> isize { comptime { runtime_value() } }",
    );
    testing::assert(
        has_diagnostic(
            runtime_call,
            "comptime function calls runtime-only function `runtime_value`",
        ),
    );
    let source = "fn runtime_value() -> isize { 1 } #[comptime] fn checked() -> isize { runtime_value() } fn main() -> () {}";
    let diagnostics = checked_diagnostics(source);
    let expected_call = match text::rfind(source, "runtime_value") {
        Some(value) => value,
        None => {
            testing::fail("expected runtime-only call");
            0
        },
    };
    let expected_attribute = match text::find(source, "#[comptime]") {
        Some(value) => value,
        None => {
            testing::fail("expected comptime attribute");
            0
        },
    };
    let found = Ref::new(false);
    for diagnostic in diagnostics {
        if diagnostic.message.contains("runtime-only function `runtime_value`") {
            match diagnostic.span {
                Some(span) => testing::assert_eq(span.start, expected_call),
                None => testing::fail("expected runtime-only call span"),
            }
            testing::assert_eq(diagnostic.secondary_labels.len(), 1);
            testing::assert_eq(diagnostic.secondary_labels[0].span.start, expected_attribute);
            found.set(true)
        }
    }
    testing::assert(found.get())
}

#[test]
fn reports_compile_error_from_comptime() -> () {
    let source = "#[comptime] fn checked(value: isize) -> isize { if value < 0 { compile_error(\"value must be non-negative\") } else { value } } fn main() -> isize { comptime { checked(-1) } }";
    let diagnostics = checked_diagnostics(source);
    testing::assert(has_diagnostic_containing(diagnostics, "value must be non-negative"));
    testing::assert(has_diagnostic_containing(diagnostics, "comptime call stack:"));
    testing::assert(has_diagnostic_containing(diagnostics, "at checked"));
    let expected_start = match text::find(source, "compile_error") {
        Some(value) => value,
        None => {
            testing::fail("expected compile_error source");
            0
        },
    };
    let found = Ref::new(false);
    for diagnostic in diagnostics {
        if diagnostic.message.contains("value must be non-negative") {
            match diagnostic.span {
                Some(span) => {
                    testing::assert_eq(span.start, expected_start)
                },
                None => testing::fail("expected precise comptime failure span"),
            }
            testing::assert_eq(diagnostic.secondary_labels.len(), 1);
            found.set(true)
        }
    }
    testing::assert(found.get())
}

#[test]
fn validates_comptime_attributes_and_function_capabilities() -> () {
    let invalid = checked_diagnostics(
        "#[comptime(1)] #[comptime] #[comptime] fn generic[T](value: T) -> T { value } #[comptime] struct Value {} fn main() -> () {}",
    );
    testing::assert(has_diagnostic(invalid, "#[comptime] does not accept arguments"));
    testing::assert(has_diagnostic(invalid, "duplicate #[comptime] attribute"));
    testing::assert(
        has_diagnostic(
            invalid,
            "#[comptime] functions cannot declare generic parameters or predicates",
        ),
    );
    testing::assert(
        has_diagnostic(invalid, "#[comptime] is only valid on free function declarations"),
    );
    let closure = checked_diagnostics(
        "#[comptime] fn invalid() -> isize { let value = || 1; value() } fn main() -> () {}",
    );
    testing::assert(has_diagnostic_containing(closure, "closures are not available in comptime"));
    testing::assert(
        has_diagnostic(
            checked_diagnostics("fn main() -> () { compile_error(\"runtime\"); }"),
            "compile_error is only available in comptime",
        ),
    )
}

#[test]
fn checks_let_else_and_value_break_restrictions() -> () {
    let source = "enum Choice { Value(isize), Empty } fn non_exit(value: Choice) -> isize { let Value(item) = value else { 0 }; item } fn while_value() { while true { break 1; }; } fn irrefutable() { let item = 1 else { return; }; }";
    let diagnostics = checked_diagnostics(source);
    testing::assert(
        has_diagnostic(diagnostics, "`let else` branch must exit the surrounding control flow"),
    );
    testing::assert(has_diagnostic(diagnostics, "`break` with a value is only allowed in `loop`"));
    testing::assert(has_diagnostic(diagnostics, "`let else` requires a refutable pattern"));
    testing::assert_eq(
        checked_diagnostics(
            "fn exhaustive_exit(value: bool, flag: bool) -> () { let true = value else { match flag { true => return, false => return } }; }",
        ).len(),
        0,
    )
}

#[test]
fn checks_value_break_types_across_loop_paths() -> () {
    let source = "fn choose(flag: bool) -> isize { loop { if flag { break 1; } else { break \"wrong\"; }; } }";
    testing::assert(
        has_diagnostic(checked_diagnostics(source), "Type mismatch: expected isize, found string"),
    )
}

#[test]
fn checks_block_and_byte_string_types() -> () {
    let valid = checked_diagnostics(
        "fn answer() -> isize { { let base = 40; base + 2 } } fn main() -> () { let empty = b\"\"; let bytes: Vec[byte] = br#\"raw\"#; let fixed: [byte; 3] = b\"raw\"; let _ = empty.len() + bytes.len() + fixed[0].to_isize(); }",
    );
    testing::assert_eq(valid.len(), 0);
    let invalid = checked_diagnostics("fn wrong() -> Vec[isize] { b\"value\" }");
    testing::assert(!invalid.is_empty())
}

fn dependency_hir(source: string, package_name: string) -> hir::File {
    let result = hir::lower_package(ast::lower(parser::parse(source)), "package.gom", package_name);
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.hir {
        Some(file) => file,
        None => {
            testing::fail("expected dependency HIR");
            hir::File {
                package_name: "",
                path: "",
                source_path: "",
                imports: Vec::new(),
                import_aliases: Vec::new(),
                use_traits: Vec::new(),
                public_reexports: Vec::new(),
                items: Vec::new(),
                invalid_self_type_spans: Vec::new(),
            }
        },
    }
}

#[test]
fn environment_collection_preserves_hir_trait_scope() -> () {
    let file = dependency_hir(
        "package values; trait Local { fn value(self: Self) -> i32; }",
        "example::values",
    );
    testing::assert_eq(file.use_traits.len(), 0);
    if let Err(error) = package_signatures(file) {
        testing::fail(error.to_string())
    }
    testing::assert_eq(file.use_traits.len(), 0)
}

#[test]
fn source_dependency_constants_do_not_capture_local_function_values() -> () {
    let dependency = dependency_hir(
        "package constants; pub const OFFSET: usize = 7; pub static CURRENT: usize = 9;",
        "example::constants",
    );
    let file = dependency_hir(
        "package values; use example::constants; fn first(value: usize) -> usize { value } fn second(value: usize) -> usize { value } pub fn evaluate() -> usize { let first_fn: (usize) -> usize = first; let second_fn: (usize) -> usize = second; first_fn(constants::OFFSET) + second_fn(constants::CURRENT) }",
        "example::values",
    );
    let environments = testing::expect_ok(
        dependency_environments(Vec::from_array([dependency])),
        "expected source dependency environment",
    );
    testing::assert_eq(environments[0].constants.len(), 2);
    for constant in environments[0].constants {
        testing::assert(constant.def_id.is_none());
    }
    let result = check_package_files_for_link_with_environments(
        Vec::from_array([file]),
        environments,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(result.tast.is_some());
}

fn checked_file_with_dependencies(source: string, dependencies: Vec[hir::File]) -> File {
    let result = check_for_link_with_dependencies(
        hir::lower(ast::lower(parser::parse(source)), "main.gom"),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

fn checked_package_file_with_dependencies(source: string, dependencies: Vec[hir::File]) -> File {
    let result = check_for_link_with_dependencies(
        hir::lower_package(ast::lower(parser::parse(source)), "main.gom", "main"),
        dependencies,
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    match result.tast {
        Some(file) => file,
        None => {
            testing::fail("expected package TAST");
            File {
                items: Vec::new(),
                enums: Vec::new(),
                structs: Vec::new(),
                constants: Vec::new(),
                statics: Vec::new(),
            }
        },
    }
}

#[test]
fn records_typecheck_query_facts() -> () {
    let result = check(
        hir::lower(
            ast::lower(
                parser::parse(
                    "fn identity(value: i32) -> i32 { value } fn main() -> i32 { let answer = identity(42); answer }",
                ),
            ),
            "main.gom",
        ),
    );
    testing::assert_eq(result.diagnostics.len(), 0);
    testing::assert(!result.typeck_results.exprs.is_empty());
    testing::assert(!result.typeck_results.pats.is_empty());
    testing::assert(!result.typeck_results.locals.is_empty());
    testing::assert_eq(result.typeck_results.calls.len(), 1);
    match resolve_type(result.typeck_results.calls.get(0).callee_ty) {
        Func { params, ret_ty } => {
            testing::assert_eq(params.len(), 1);
            match resolve_type(params.get(0)) {
                Int32 => (),
                _ => testing::fail("expected call parameter type"),
            }
            match resolve_type(ret_ty) {
                Int32 => (),
                _ => testing::fail("expected call return type"),
            }
        },
        _ => testing::fail("expected callable type"),
    }
    let local_reference = Ref::new(false);
    let callable_reference = Ref::new(false);
    for reference in result.typeck_results.references {
        testing::assert_eq(reference.source_path, "main.gom");
        match reference.target {
            Local(_) => {
                local_reference.set(true);
                match resolve_type(reference.ty) {
                    Int32 => (),
                    _ => testing::fail("expected local reference type"),
                }
            },
            Definition(_) | Callable(_) => {
                callable_reference.set(true)
            },
            Constructor(_) => (),
            Unresolved(_) => (),
        }
    }
    testing::assert(local_reference.get());
    testing::assert(callable_reference.get())
}

#[test]
fn merges_typecheck_query_facts_for_package_files() -> () {
    let parsed = Vec::new();
    parsed.push(parser::parse("package values; fn value() -> i32 { 42 }"));
    parsed.push(parser::parse("package values; pub fn answer() -> i32 { value() }"));
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "value.gom"));
    inputs.push((ast_files.get(1), "answer.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected package HIR"),
        }
    }
    let result = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert_eq(result.diagnostics.len(), 0);
    let value_facts = Ref::new(0);
    let answer_facts = Ref::new(0);
    for fact in result.typeck_results.exprs {
        if fact.source_path == "value.gom" {
            value_facts.set(value_facts.get() + 1)
        } else if fact.source_path == "answer.gom" {
            answer_facts.set(answer_facts.get() + 1)
        }
    }
    testing::assert(value_facts.get() > 0);
    testing::assert(answer_facts.get() > 0)
}

#[test]
fn checks_cross_file_package_definitions() -> () {
    let parsed = Vec::new();
    parsed.push(
        parser::parse(
            "package main; trait Label { fn label(self: Self) -> string; } enum Status { Idle, Busy(i32) } impl Label for Status { fn label(self: Status) -> string { match self { Idle => \"idle\", Busy(value) => value.to_string() } } }",
        ),
    );
    parsed.push(
        parser::parse(
            "package main; fn main() -> () { println(Idle.label()); println(Busy(4).label()) }",
        ),
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "types.gom"));
    inputs.push((ast_files.get(1), "main.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "main") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected cross-file HIR"),
        }
    }
    let dependencies: Vec[DependencyEnvironment] = Vec::new();
    match implicit_builtin_dependency_environment() {
        Ok(environment) => dependencies.push(environment),
        Err(error) => testing::fail(error.to_string()),
    }
    match implicit_prelude_hir_files() {
        Ok(files) => match dependency_environments(files) {
            Ok(values) => for environment in values {
                dependencies.push(environment)
            },
            Err(error) => testing::fail(error.to_string()),
        },
        Err(error) => testing::fail(error.to_string()),
    }
    let checked = check_package_files_for_link_with_environments(hir_files, dependencies);
    testing::assert_eq(checked.diagnostics.len(), 0);
    match checked.tast {
        Some(file) => {
            testing::assert_eq(file.enums.len(), 1);
            testing::assert_eq(file.items.len(), 2)
        },
        None => testing::fail("expected cross-file TAST"),
    }
}

#[test]
fn diagnoses_overlapping_impls_across_package_files() -> () {
    let parsed = Vec::from_array(
        [
            parser::parse(
                "package values; trait Pick { fn pick(self: Self) -> i32; } struct Value {} impl Pick for Value { fn pick(self: Value) -> i32 { 1 } }",
            ),
            parser::parse(
                "package values; impl Pick for Value { fn pick(self: Value) -> i32 { 2 } }",
            ),
        ],
    );
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::from_array(
        [(ast_files[0], "first.gom"), (ast_files[1], "second.gom")],
    );
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected overlapping impl HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert(
        has_diagnostic(
            checked.diagnostics,
            "Trait example::values::Pick implementation for example::values::Value is already defined",
        ),
    )
}

#[test]
fn diagnoses_duplicate_functions_across_package_files() -> () {
    let parsed = Vec::new();
    parsed.push(parser::parse("package values; fn duplicate() -> () { () }"));
    parsed.push(parser::parse("package values; fn duplicate() -> () { () }"));
    let ast_files = ast::lower_package(parsed);
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    inputs.push((ast_files.get(0), "first.gom"));
    inputs.push((ast_files.get(1), "second.gom"));
    let hir_files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "example::values") {
        match lowered.hir {
            Some(file) => hir_files.push(file),
            None => testing::fail("expected duplicate function HIR"),
        }
    }
    let checked = check_package_files_for_link_with_dependencies(hir_files, Vec::new());
    testing::assert(
        has_diagnostic(
            checked.diagnostics,
            "function example::values::duplicate is defined multiple times",
        ),
    )
}

#[test]
fn diagnoses_duplicate_declaration_names() -> () {
    let diagnostics = checked_diagnostics(
        "enum E { A, A } struct S { x: i32, x: string } enum Both { A } struct Both { value: i32 } type Alias = i32; type Alias = string; struct Mixed {} type Mixed = i32; trait T[T, T] { type Item; type Item; fn f(self: Self) -> (); fn f(self: Self) -> (); } fn duplicate[T, T](x: i32, x: string) -> () {} fn duplicate() -> () {} const repeated: isize = 1; const repeated: isize = 2; fn conflict() -> isize { 1 } const conflict: isize = 1;",
    );
    let expected = Vec::new();
    expected.push("variant A is defined multiple times in enum E");
    expected.push("field x is defined multiple times in struct S");
    expected.push("type Both is defined as both a struct and an enum");
    expected.push("type alias Alias is defined multiple times");
    expected.push("type Mixed is defined as both a struct and a type alias");
    expected.push("type parameter T is defined multiple times");
    expected.push("associated type Item is defined multiple times in trait T");
    expected.push("method f is defined multiple times in trait T");
    expected.push("parameter x is defined multiple times");
    expected.push("function duplicate is defined multiple times");
    expected.push("constant repeated is defined multiple times");
    expected.push("value conflict is defined as both a function and a constant");
    for message in expected {
        testing::assert(has_diagnostic(diagnostics, message))
    }
}

#[test]
fn distinguishes_same_named_associated_types_from_different_traits() -> () {
    let diagnostics = checked_diagnostics(
        "trait Iterator { type Item; } trait IntoIterator { type Item; type IntoIter; } impl[I: Iterator] IntoIterator for I { type Item = I::Item; type IntoIter = I; }",
    );
    testing::assert_eq(diagnostics.len(), 0);
    let cyclic = checked_diagnostics(
        "trait Values { type Item; } struct Value {} impl Values for Value { type Item = Self::Item; }",
    );
    testing::assert(
        has_diagnostic(
            cyclic,
            "Associated type Item has a cyclic definition in impl of trait Values",
        ),
    )
}

#[test]
fn distinguishes_associated_type_cycles_by_receiver() -> () {
    let forwarding = checked_diagnostics(
        "trait FileSystem { type Handle; } struct SubFs[F] { filesystem: F } impl[F: FileSystem] FileSystem for SubFs[F] { type Handle = F::Handle; }",
    );
    for diagnostic in forwarding {
        testing::fail("forwarding receiver: " + diagnostic.message);
    }
    let indirect = checked_diagnostics(
        "trait Values { type First; type Second; } struct Wrapper[F] { value: F } impl[F: Values] Values for Wrapper[F] { type First = F::Second; type Second = Self::First; }",
    );
    for diagnostic in indirect {
        testing::fail("indirect forwarding receiver: " + diagnostic.message);
    }
    for definition in[
        "type First = Self::First; type Second = i32;",
        "type First = Self::Second; type Second = Self::First;",
        "type First = Vec[Self::Second]; type Second = Self::First;",
    ] {
        let diagnostics = checked_diagnostics(
            "trait Values { type First; type Second; } struct Value {} impl Values for Value { "
                + definition
                + " }",
        );
        if !has_diagnostic(
            diagnostics,
            "Associated type First has a cyclic definition in impl of trait Values",
        ) {
            let messages = Vec::new();
            for diagnostic in diagnostics {
                messages.push(diagnostic.message);
            }
            testing::fail(
                "missing associated type cycle: " + definition + " diagnostics: "
                    + messages.join("; "),
            );
        }
    }
}

#[test]
fn detects_associated_type_cycles_for_concrete_receivers() -> () {
    let unsupported = checked_diagnostics(
        "trait Values { type First; type Second; } struct Value {} impl Values for Value { type First = Value::First; type Second = i32; }",
    );
    testing::assert(has_diagnostic(unsupported, "Unknown type constructor Value::First"));
    let owner = Type::Con { name: "Value" };
    let reference = TraitRef { name: "Values", args: Vec::new() };
    for trait_ref in[Option::None, Option::Some(reference)] {
        let projection = Type::Projection { for_ty: owner, name: "First", trait_ref };
        let aliases = Vec::from_array([("First", projection), ("Second", Type::Int32)]);
        testing::assert(
            associated_type_reaches(aliases, projection, reference, owner, "First", Vec::new()),
        );
        testing::assert(
            !associated_type_reaches(
                aliases,
                projection,
                reference,
                Type::Con { name: "Other" },
                "First",
                Vec::new(),
            ),
        );
    }
}

#[test]
fn associated_type_cycle_edges_require_matching_trait_identity() -> () {
    let owner = Type::Con { name: "Owner" };
    let target = TraitRef { name: "Values", args: Vec::from_array([Type::Int32]) };
    let back_edge = Type::Projection {
        for_ty: owner,
        name: "First",
        trait_ref: Option::Some(target),
    };
    for reference in[
        TraitRef { name: "Other", args: Vec::from_array([Type::Int32]) },
        TraitRef { name: "Values", args: Vec::from_array([Type::String]) },
    ] {
        let foreign = Type::Projection {
            for_ty: owner,
            name: "Second",
            trait_ref: Option::Some(reference),
        };
        let aliases = Vec::from_array([("First", foreign), ("Second", back_edge)]);
        testing::assert(
            !associated_type_reaches(aliases, foreign, target, owner, "First", Vec::new()),
        );
        testing::assert(
            !associated_type_reaches(aliases, foreign, target, owner, "Second", Vec::new()),
        );
    }
    let local = Type::Projection { for_ty: owner, name: "Second", trait_ref: Option::Some(target) };
    let aliases = Vec::from_array([("First", local), ("Second", back_edge)]);
    testing::assert(associated_type_reaches(aliases, local, target, owner, "First", Vec::new()));
}

#[test]
fn resolves_generic_functions_from_package_interfaces() -> () {
    let dependencies: Vec[hir::File] = Vec::new();
    dependencies.push(
        dependency_hir(
            "package api; pub fn identity[T: ToString](value: T) -> T { value }",
            "vendor::api",
        ),
    );
    let file = checked_file_with_dependencies(
        "use vendor::api as service; fn main() -> string { service::identity(\"ok\") }",
        dependencies,
    );
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Call {
                func: Callable { callable: Function(name), ty: Func { params, ret_ty } },
                args: _,
                ty: String,
            }) => {
                testing::assert_eq(name, "vendor::api::identity");
                match resolve_type(params.get(0)) {
                    String => (),
                    _ => testing::fail("expected string package parameter"),
                }
                match resolve_type(ret_ty) {
                    String => (),
                    _ => testing::fail("expected string package return"),
                }
            },
            _ => testing::fail("expected package function call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn enforces_source_extern_capabilities() -> () {
    let source = "#[runtime(\"std.io.println\")] extern fn output(value: string) -> (); fn main() -> () { output(\"ok\") }";
    let rejected = checked_diagnostics(source);
    testing::assert_eq(rejected.len(), 2);
    testing::assert_eq(
        rejected.get(0).message,
        "Internal error: Function output not found in environment",
    );
    testing::assert_eq(rejected.get(1).message, "extern output is not permitted in this source");
    let allowed = check_for_link_with_dependencies_allowing_externs(
        hir::lower(ast::lower(parser::parse(source)), "host.gom"),
        Vec::new(),
    );
    testing::assert_eq(allowed.diagnostics.len(), 0);
    match allowed.tast {
        Some(file) => match file.items.get(0) {
            Function(value) => match value.body.tail {
                Some(Call { func: Callable { callable: Runtime(name), ty: _ }, args: _, ty: Unit }) => testing::assert_eq(
                    name,
                    "std.io.println",
                ),
                _ => testing::fail("expected allowed runtime call"),
            },
            _ => testing::fail("expected main function"),
        },
        None => testing::fail("expected allowed extern TAST"),
    }
}

