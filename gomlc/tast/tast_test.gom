                        }
                        match resolve_type(ret_ty) {
                            String => (),
                            _ => testing::fail("expected instantiated string return"),
                        }
                    },
                    _ => testing::fail("expected function callable"),
                }
            },
            _ => testing::fail("expected call tail"),
        },
        _ => testing::fail("expected function"),
    }
}

#[test]
fn resolves_reordered_result_try_tags() -> () {
    let source = "enum Result[T, E] { Err(E), Ok(T), } fn parse(flag: bool) -> Result[i32, string] { if flag { Result::Ok(1) } else { Result::Err(\"bad\") } } fn compute(flag: bool) -> Result[i32, string] { let value = parse(flag)?; Result::Ok(value) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.stmts.get(0) {
            Let { is_mut: _, pat: _, value: Match { expr: _, arms, ty: _, .. } } => {
                match arms.get(0).pat {
                    Constr { constructor, args: _, ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 1),
                            None => testing::fail("expected success tag"),
                        }
                    },
                    _ => testing::fail("expected success constructor pattern"),
                }
                match arms.get(1).pat {
                    Constr { constructor, args: _, ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 0),
                            None => testing::fail("expected residual tag"),
                        }
                    },
                    _ => testing::fail("expected residual constructor pattern"),
                }
                match arms.get(1).body {
                    Return { expr: Some(Constr { constructor, args: _, ty: _ }), ty: _ } => {
                        match constructor.tag {
                            Some(tag) => testing::assert_eq(tag, 0),
                            None => testing::fail("expected return tag"),
                        }
                    },
                    _ => testing::fail("expected residual return constructor"),
                }
            },
            _ => testing::fail("expected try match binding"),
        },
        _ => testing::fail("expected compute function"),
    }
}

#[test]
fn checks_closures_with_call_context() -> () {
    let source = "fn zip_with[A, B, C](a: A, b: B, f: (A, B) -> C) -> C { f(a, b) } fn main() -> string { zip_with(10, \"hello\", |number, text| text + \"=\" + number.to_string()) }";
    let file = checked_file(source);
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Call { func: _, args, ty: String }) => match args.get(2) {
                Closure { params, body, ty: closure_ty } => {
                    match resolve_type(closure_ty) {
                        Func { params: _, ret_ty: String } => (),
                        _ => testing::fail("expected contextual closure return"),
                    }
                    match (resolve_type(params.get(0).ty), resolve_type(params.get(1).ty)) {
                        (Int, String) => (),
                        _ => testing::fail("expected contextual closure parameters"),
                    }
                    match body {
                        Binary {
                            op: _,
                            lhs: _,
                            rhs: Call {
                                func: Callable {
                                    callable: InherentMethod {
                                        receiver_ty: owner,
                                        method_name: name,
                                    },
                                    ty: _,
                                },
                                args: _,
                                ty: call_ty,
                            },
                            ty: body_ty,
                            resolution: _,
                        } => {
                            testing::assert_eq(name, "to_string");
                            match (
                                resolve_type(owner),
                                resolve_type(call_ty),
                                resolve_type(body_ty),
                            ) {
                                (Int, String, String) => (),
                                _ => testing::fail("expected contextual isize method types"),
                            }
                        },
                        _ => testing::fail("expected contextual isize method"),
                    }
                },
                _ => testing::fail("expected contextual closure argument"),
            },
            _ => testing::fail("expected zip_with call"),
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn infers_trait_goals_from_function_calls() -> () {
    let source = "trait Measure { fn measure(self: Self) -> isize; } impl Measure for Vec[isize] { fn measure(self: Vec[isize]) -> isize { self.len() } } fn read_measure[T: Measure](value: T) -> isize { Measure::measure(value) } fn main() -> isize { let values = vec_new(); read_measure(values) }";
    let file = checked_file(source);
    match file.items.get(2) {
        Function(value) => {
            match value.body.stmts.get(0) {
                Let {
                    is_mut: _,
                    pat: Var { name: _, is_mut: _, ty: pattern_ty },
                    value: expression,
                } => {
                    match (resolve_type(pattern_ty), resolve_type(expr_type(expression))) {
                        (VecType { elem: Int }, VecType { elem: Int }) => (),
                        _ => testing::fail("expected inferred Vec[isize] binding"),
                    }
                },
                _ => testing::fail("expected inferred vector binding"),
            }
            match value.body.tail {
                Some(Call {
                    func: Callable { callable: Function(name), ty: Func { params, ret_ty: Int } },
                    args,
                    ty: Int,
                }) => {
                    testing::assert_eq(name, "read_measure");
                    match (resolve_type(params.get(0)), resolve_type(expr_type(args.get(0)))) {
                        (VecType { elem: Int }, VecType { elem: Int }) => (),
                        _ => testing::fail("expected inferred trait goal argument"),
                    }
                },
                _ => testing::fail("expected trait constrained function call"),
            }
        },
        _ => testing::fail("expected main function"),
    }
}

#[test]
fn checks_positional_struct_constructors() -> () {
    let source = "struct Point { x: i32, y: i32 } struct Wrapper[T] { value: T } fn point() -> Point { Point(1, 2) } fn wrapper() -> Wrapper[string] { Wrapper(\"ok\") }";
    let file = checked_file(source);
    match file.items.get(0) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: Con { name: owner } }) => {
                testing::assert_eq(owner, "Point");
                testing::assert_eq(constructor.name, "Point");
                testing::assert_eq(constructor.fields.get(0), "x");
                testing::assert_eq(constructor.fields.get(1), "y");
                match (
                    resolve_type(expr_type(values.get(0))),
                    resolve_type(expr_type(values.get(1))),
                ) {
                    (Int32, Int32) => (),
                    _ => testing::fail("expected i32 positional fields"),
                }
            },
            _ => testing::fail("expected positional Point constructor"),
        },
        _ => testing::fail("expected point function"),
    }
    match file.items.get(1) {
        Function(value) => match value.body.tail {
            Some(Constr { constructor, args: values, ty: App { ty: Con { name: owner }, args } }) => {
                testing::assert_eq(owner, "Wrapper");
                testing::assert_eq(constructor.name, "Wrapper");
                match (resolve_type(args.get(0)), resolve_type(expr_type(values.get(0)))) {
                    (String, String) => (),
                    _ => testing::fail("expected string Wrapper field"),
                }
            },
            _ => testing::fail("expected positional Wrapper constructor"),
        },
        _ => testing::fail("expected wrapper function"),
    }
}

#[test]
fn checks_enum_patterns_and_default_integer_literals() -> () {
    let source = "enum Choice { None, Some(i32) } fn unwrap(value: Choice) -> i32 { match value { Choice::Some(item) => item, Choice::None => 0 } }";
    let file = checked_file(source);
