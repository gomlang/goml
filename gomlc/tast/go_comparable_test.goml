package tast;

use module::hir;
use std::testing;

#[test]
fn go_comparable_predicates_instantiate_without_generalizing_unbound_keys() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let file = dependency_hir("package api; pub fn accept[T](value: T) -> () {}", "audit::api");
    let ctx = collect_environment(file, false, builtin);
    let key = Type::Param { name: "T" };
    let requirement = TypePredicate::GoComparable(key);
    testing::assert(!go_comparable_satisfied(ctx, key));
    ctx.predicates.push(requirement);
    testing::assert(go_comparable_satisfied(ctx, key));
    testing::assert(
        go_comparable_satisfied(ctx, Type::GoPointer { elem: Type::MutSlice { elem: key } }),
    );
    testing::assert(!go_comparable_satisfied(ctx, Type::MutSlice { elem: key }));
    testing::assert(predicate_equal(requirement, requirement));
    testing::assert(!predicate_equal(requirement, TypePredicate::GoComparable(Type::Int64)));
    let function = ctx.functions[0];
    function.predicates.push(requirement);
    for key in Vec::from_array([Type::Int64, Type::MutSlice { elem: Type::Int64 }]) {
        let candidate = instantiate_scheme_candidate(ctx, function, Vec::from_array([key]));
        testing::assert_eq(
            predicates_satisfied_at(ctx, candidate.predicates, Vec::new()),
            !go_map_key_definitely_uncomparable(key),
        );
    }
    let candidate = instantiate_scheme_candidate(ctx, function, Vec::new());
    testing::assert(!predicates_satisfied_at(ctx, candidate.predicates, Vec::new()));
    if let Func { params, .. } = candidate.ty {
        testing::assert(unify(params[0], Type::Int64));
    }
    testing::assert(predicates_satisfied_at(ctx, candidate.predicates, Vec::new()));
}

#[test]
fn go_comparable_function_requirements_reject_bad_calls_and_function_values() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    for ty in Vec::from_array(["i64", "Slice[i64]"]) {
        for body in Vec::from_array(["accept(value)", "let call = accept; call(value)"]) {
            let file = dependency_hir(
                "package api; fn accept[T](value: T) -> () {} fn caller(value: " + ty + ") -> () { "
                    + body
                    + " }",
                "audit::api",
            );
            let ctx = collect_environment(file, false, builtin);
            for function in ctx.functions {
                if function.name == "audit::api::accept" {
                    function.predicates.push(TypePredicate::GoComparable(Type::Param { name: "T" }));
                }
            }
            for item in file.items {
                if let hir::Item::Function(function) = item {
                    if function.name == "audit::api::caller" {
                        let _ = check_function(ctx, function, Vec::new(), Vec::new(), Option::None);
                    }
                }
            }
            let mut rejected = false;
            for diagnostic in ctx.diagnostics {
                if diagnostic.message.contains("Go map key is not comparable") {
                    rejected = true;
                }
            }
            testing::assert_eq(rejected, ty == "Slice[i64]");
        }
    }
}
