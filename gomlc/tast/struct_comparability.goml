package tast;

use module::ffi;

fn struct_comparability_substitutions(info: StructInfo, args: Vec[Type]) -> Vec[TypeSubst] {
    let result = Vec::new();
    for index in 0..info.generics.len() {
        if index < args.len() {
            result.push(TypeSubst { name: info.generics[index], ty: args[index] })
        }
    }
    result
}

fn struct_key_comparability(ctx: Checker, info: StructInfo) -> ffi::GoComparability {
    let diagnostic_count = ctx.diagnostics.len();
    let rule = infer_struct_key_comparability(ctx, info);
    ctx.diagnostics.truncate(diagnostic_count);
    rule
}

fn infer_struct_key_comparability(ctx: Checker, info: StructInfo) -> ffi::GoComparability {
    if let Some(rule) = info.go_comparable {
        return rule
    }
    if info.has_hidden_fields {
        return ffi::GoComparability::Unknown
    }
    let args = Vec::new();
    for name in info.generics {
        args.push(Type::Param { name })
    }
    let ty = nominal_type(ctx.builtin, info.name, args);
    if go_map_key_uncomparable(ctx, ty, Vec::new()) {
        return ffi::GoComparability::Never
    }
    let requirements = Vec::new();
    if !collect_go_comparable_requirements(ctx, ty, requirements, Vec::new()) {
        return ffi::GoComparability::Unknown
    }
    let rules = Vec::new();
    for requirement in requirements {
        let mut found = false;
        for index in 0..info.generics.len() {
            if types_equal(requirement, Type::Param { name: info.generics[index] }) {
                rules.push(ffi::GoComparability::Parameter(index));
                found = true;
            }
        }
        if !found {
            return ffi::GoComparability::Unknown
        }
    }
    if rules.is_empty() {
        ffi::GoComparability::Always
    } else {
        ffi::GoComparability::All(rules)
    }
}
