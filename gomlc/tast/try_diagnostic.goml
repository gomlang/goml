package tast;

use module::ast;

fn try_operator_span(span: ast::Span) -> ast::Span {
    if span.end > span.start {
        ast::span(span.end - 1, span.end)
    } else {
        span
    }
}

fn try_return_diagnostic(ctx: Checker, span: ast::Span, code: string, message: string) -> Diagnostic {
    let mut diagnostic = new_diagnostic(
        TYPER_STAGE,
        message,
        ctx.source_path,
        Option::Some(try_operator_span(span)),
    );
    diagnostic.code = Option::Some(code);
    if let Some(return_span) = ctx.return_span {
        diagnostic.secondary_labels.push(
            DiagnosticLabel {
                message: (if ctx.return_is_closure {
                    "this closure returns "
                } else {
                    "this function returns "
                })
                    + diagnostic_type_text(ctx.return_ty),
                source_path: ctx.source_path,
                span: return_span,
            },
        )
    }
    diagnostic
}

fn push_try_return_diagnostic(ctx: Checker, span: ast::Span, operand: Type) -> () {
    let mut diagnostic = try_return_diagnostic(
        ctx,
        span,
        "try_invalid_return",
        "cannot propagate " + diagnostic_type_text(operand)
            + " with `?` from a function or closure returning "
            + diagnostic_type_text(ctx.return_ty),
    );
    diagnostic.primary_label = Option::Some(
        "this `?` would return from the enclosing function or closure",
    );
    diagnostic.help.push(
        "Handle the value with `match`, or change the enclosing return type to a compatible Option or Result.",
    );
    ctx.diagnostics.push(diagnostic)
}

fn push_try_error_diagnostic(ctx: Checker, span: ast::Span, source: Type, target: Type) -> () {
    let from = diagnostic_type_text(source);
    let to = diagnostic_type_text(target);
    let mut diagnostic = try_return_diagnostic(
        ctx,
        span,
        "try_error_mismatch",
        "cannot propagate error type " + from + " as " + to + " with `?`",
    );
    diagnostic.primary_label = Option::Some("this `?` propagates " + from);
    diagnostic.notes.push(
        "`?` requires the same error type; it does not perform an implicit conversion.",
    );
    diagnostic.help.push(
        "Use `map_err` to convert " + from + " to " + to
            + " before `?`, or change the enclosing error type.",
    );
    ctx.diagnostics.push(diagnostic)
}

fn push_try_operand_diagnostic(ctx: Checker, span: ast::Span, ty: Type, message: string) -> () {
    let mut diagnostic = new_diagnostic(
        TYPER_STAGE,
        message,
        ctx.source_path,
        Option::Some(try_operator_span(span)),
    );
    diagnostic.code = Option::Some("try_invalid_operand");
    diagnostic.primary_label = Option::Some("the operand has type " + diagnostic_type_text(ty));
    diagnostic.help.push("Use `?` on an Option or Result, or handle this value explicitly.");
    ctx.diagnostics.push(diagnostic)
}
