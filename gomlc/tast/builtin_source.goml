package tast;

use module::ast;
use module::hir;
use module::parser;
use module::resources;

static builtin_source_traits: OnceCell[FrozenVec[TraitInfo]] = OnceCell::new();

static builtin_source_enums: OnceCell[FrozenVec[EnumInfo]] = OnceCell::new();

static builtin_source_structs: OnceCell[FrozenVec[StructInfo]] = OnceCell::new();

static builtin_source_functions: OnceCell[FrozenVec[FunctionScheme]] = OnceCell::new();

static builtin_source_arities: OnceCell[FrozenVec[(string, isize)]] = OnceCell::new();

static builtin_source_impls: OnceCell[FrozenVec[ImplInfo]] = OnceCell::new();

static builtin_source_lang_items: OnceCell[Result[FrozenVec[BuiltinLangItem], string]] = OnceCell::new();

#[derive(PartialEq, Eq)]
enum BuiltinLangItemKind {
    Enum,
    Struct,
    Trait,
    Function,
    Extern,
    TypeAlias,
    Constant,
    Static,
    Impl,
}

struct BuiltinLangItem {
    item: string,
    kind: BuiltinLangItemKind,
    name: string,
    properties: Vec[(string, string)],
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
}

fn builtin_lang_item_kind_name(value: BuiltinLangItemKind) -> string {
    match value {
        Enum => "enum",
        Struct => "struct",
        Trait => "trait",
        Function => "function",
        Extern => "extern function",
        TypeAlias => "type alias",
        Constant => "constant",
        Static => "static",
        Impl => "impl",
    }
}

fn builtin_lang_item_from_attrs(
    attrs: Vec[ast::Attribute],
    kind: BuiltinLangItemKind,
    name: string,
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
) -> Result[Option[BuiltinLangItem], string] {
    let found: Ref[Option[BuiltinLangItem]] = Ref::new(Option::None);
    let kind_name = builtin_lang_item_kind_name(kind);
    for attribute in attrs {
        if attribute.name == "lang" {
            if found.get().is_some() {
                return Result::Err(
                    "duplicate #[lang] attribute on builtin " + kind_name + " " + name,
                )
            } else if attribute.args.is_empty() {
                return Result::Err("missing lang item name on builtin " + kind_name + " " + name)
            }
            match attribute.args[0] {
                ast::AttributeArg::String(item) => {
                    if item.byte_len() == 0 {
                        return Result::Err(
                            "empty lang item name on builtin " + kind_name + " " + name,
                        )
                    }
                    let properties: Vec[(string, string)] = Vec::new();
                    for index in 1..attribute.args.len() {
                        match attribute.args[index] {
                            ast::AttributeArg::Named { name, value_kind, value } => if value_kind
                                == "string" {
                                for property in properties {
                                    if property.0 == name {
                                        return Result::Err(
                                            "duplicate property " + name + " on lang item " + item,
                                        )
                                    }
                                }
                                properties.push((name, value))
                            } else {
                                return Result::Err(
                                    "lang item " + item + " property " + name + " must be a string",
                                )
                            },
                            _ => return Result::Err(
                                "lang item " + item + " properties must be named strings",
                            ),
                        }
                    }
                    found.set(
                        Option::Some(
                            BuiltinLangItem {
                                item,
                                kind,
                                name,
                                properties,
                                variants,
                                variant_arities,
                                methods,
                                associated_types,
                            },
                        ),
                    )
                },
                _ => return Result::Err(
                    "lang item name on builtin " + kind_name + " " + name + " must be a string",
                ),
            }
        }
    }
    Result::Ok(found.get())
}

fn append_builtin_lang_item(
    result: Vec[BuiltinLangItem],
    attrs: Vec[ast::Attribute],
    kind: BuiltinLangItemKind,
    name: string,
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
) -> Result[(), string] {
    if let Some(value) = builtin_lang_item_from_attrs(
        attrs,
        kind,
        short_name(name),
        variants,
        variant_arities,
        methods,
        associated_types,
    )? {
        result.push(value)
    }
    Result::Ok(())
}

fn builtin_lang_item_type_name(value: hir::TypeExpr) -> Option[string] {
    match value {
        hir::TypeExpr::Con { name } => Option::Some(name),
        hir::TypeExpr::App { ty: hir::TypeExpr::Con { name }, args: _ } => Option::Some(name),
        _ => Option::None,
    }
}

fn builtin_lang_item_variant_arity(value: hir::EnumVariantFields) -> isize {
    match value {
        hir::EnumVariantFields::Unit => 0,
        hir::EnumVariantFields::Tuple(values) => values.len(),
        hir::EnumVariantFields::Struct(values) => values.len(),
    }
}

fn load_builtin_source_lang_items() -> Result[FrozenVec[BuiltinLangItem], string] {
    let result: Vec[BuiltinLangItem] = Vec::new();
    let files = implicit_builtin_hir_files()?;
    for file in files {
        for item in file.items {
            match item {
                hir::Item::ExternType(_) => return Result::Err(
                    "builtin resources cannot declare external Go types",
                ),
                hir::Item::EnumDef(value) => {
                    let variants: Vec[string] = Vec::new();
                    let variant_arities: Vec[isize] = Vec::new();
                    for variant in value.variants {
                        variants.push(variant.name);
                        variant_arities.push(builtin_lang_item_variant_arity(variant.fields))
                    }
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Enum,
                        value.name,
                        variants,
                        variant_arities,
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::StructDef(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Struct,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::TraitDef(value) => {
                    let methods: Vec[string] = Vec::new();
                    for method in value.method_sigs {
                        methods.push(method.name)
                    }
                    let associated_types: Vec[string] = Vec::new();
                    for associated in value.associated_types {
                        associated_types.push(associated.name)
                    }
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Trait,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        methods,
                        associated_types,
                    )?
                },
                hir::Item::Function(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Function,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::ExternFunction(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Extern,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::TypeAlias(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::TypeAlias,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::Constant(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Constant,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::Static(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Static,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::ImplBlock(value) => match builtin_lang_item_type_name(value.for_type) {
                    Some(name) => {
                        let methods: Vec[string] = Vec::new();
                        for method in value.methods {
                            methods.push(method.name)
                        }
                        append_builtin_lang_item(
                            result,
                            value.attrs,
                            BuiltinLangItemKind::Impl,
                            name,
                            Vec::new(),
                            Vec::new(),
                            methods,
                            Vec::new(),
                        )?
                    },
                    None => (),
                },
            }
        }
    }
    Result::Ok(result.freeze())
}

fn load_builtin_source_traits() -> FrozenVec[TraitInfo] {
    let result: Vec[TraitInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(source) = resources::builtin_contract_source() else {
        return result.freeze();
    };
    let inputs = Vec::from_array([(ast::lower(parser::parse(source.source)), source.path)]);
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let hir::Item::TraitDef(value) = item {
                    result.push(collect_trait(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_trait_info(name: string) -> Option[TraitInfo] {
    let values = builtin_source_traits.get_or_init(|| load_builtin_source_traits());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == name {
            return Option::Some(value)
        }
        index += 1;
    }
    Option::None
}

fn load_builtin_source_enums() -> FrozenVec[EnumInfo] {
    let result: Vec[EnumInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(sources) = resources::builtin_enum_sources() else {
        return result.freeze();
    };
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in sources {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let hir::Item::EnumDef(value) = item {
                    result.push(collect_enum(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_enum_infos() -> Vec[EnumInfo] {
    builtin_source_enums.get_or_init(|| load_builtin_source_enums()).to_vec()
}

fn builtin_source_enum_info(name: string) -> Option[EnumInfo] {
    let expected = short_name(name);
    let values = builtin_source_enums.get_or_init(|| load_builtin_source_enums());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == expected {
            return Option::Some(value)
        }
        index += 1;
    }
    Option::None
}

fn load_builtin_source_structs() -> FrozenVec[StructInfo] {
    let result: Vec[StructInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(source) = resources::builtin_contract_source() else {
        return result.freeze();
    };
    let inputs = Vec::from_array([(ast::lower(parser::parse(source.source)), source.path)]);
    for lowered in hir::lower_package_files(inputs, "builtin") {
        if let Some(file) = lowered.hir {
            for item in file.items {
                if let hir::Item::StructDef(value) = item {
                    result.push(collect_struct(builtin, value))
                }
            }
        }
    }
    result.freeze()
}

fn builtin_source_struct_info(name: string) -> Option[StructInfo] {
    let expected = short_name(name);
    let values = builtin_source_structs.get_or_init(|| load_builtin_source_structs());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == expected {
            return Option::Some(value)
        }
        index += 1;
    }
    Option::None
}

fn load_builtin_source_functions() -> FrozenVec[FunctionScheme] {
    let result: Vec[FunctionScheme] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for value in dependency_environment_from_hir_with_contract(file, builtin).functions {
            result.push(value)
        }
    }
    result.freeze()
}

fn builtin_source_function_scheme(name: string) -> Option[FunctionScheme] {
    let values = builtin_source_functions.get_or_init(|| load_builtin_source_functions());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.name == name {
            return Option::Some(value)
        }
        index += 1;
    }
    Option::None
}

fn append_builtin_source_arity(values: Vec[(string, isize)], name: string, arity: isize) -> () {
    for value in values {
        if value.0 == name {
            return
        }
    }
    values.push((name, arity))
}

fn append_builtin_source_type_arity(values: Vec[(string, isize)], value: hir::TypeExpr) -> () {
    match value {
        hir::TypeExpr::Con { name } => append_builtin_source_arity(values, name, 0),
        hir::TypeExpr::App { ty: hir::TypeExpr::Con { name }, args } => {
            append_builtin_source_arity(values, name, args.len())
        },
        _ => (),
    }
}

fn load_builtin_source_arities() -> FrozenVec[(string, isize)] {
    let result: Vec[(string, isize)] = Vec::new();
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for item in file.items {
            match item {
                hir::Item::EnumDef(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                hir::Item::StructDef(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                hir::Item::TypeAlias(value) => {
                    append_builtin_source_arity(result, value.name, value.generics.len())
                },
                hir::Item::ImplBlock(value) => {
                    append_builtin_source_type_arity(result, value.for_type)
                },
                _ => (),
            }
        }
    }
    result.freeze()
}

fn builtin_source_nominal_arity(name: string) -> Option[isize] {
    let expected = short_name(name);
    let values = builtin_source_arities.get_or_init(|| load_builtin_source_arities());
    let mut index = 0;
    while index < values.len() {
        let value = values.get(index);
        if value.0 == expected {
            return Option::Some(value.1)
        }
        index += 1;
    }
    Option::None
}

fn load_builtin_source_impls() -> FrozenVec[ImplInfo] {
    let result: Vec[ImplInfo] = Vec::new();
    let Ok(builtin) = builtin_contract() else {
        return result.freeze();
    };
    let Ok(files) = implicit_builtin_hir_files() else {
        return result.freeze();
    };
    for file in files {
        for value in dependency_environment_from_hir_with_contract(file, builtin).impls {
            result.push(
                ImplInfo {
                    generics: value.generics,
                    predicates: value.predicates,
                    trait_ref: value.trait_ref,
                    for_type: value.for_type,
                    associated_types: value.associated_types,
                    origin: f"builtin#source#{result.len()}",
                    span: value.span,
                },
            )
        }
    }
    result.freeze()
}

fn builtin_source_impl_infos() -> FrozenVec[ImplInfo] {
    builtin_source_impls.get_or_init(|| load_builtin_source_impls())
}

fn append_builtin_source_impls(ctx: Checker) -> () {
    if ctx.package_name == "builtin" {} else {
        let values = builtin_source_impl_infos();
        let mut index = 0;
        while index < values.len() {
            push_impl_info(ctx, values.get(index));
            index += 1;
        }
    }
}
