package tast;

use module::ast;
use module::hir;
use module::parser;
use module::resources;

static builtin_source_lang_items: OnceCell[Result[FrozenVec[BuiltinLangItem], string]] = OnceCell::new();

#[derive(PartialEq, Eq)]
enum BuiltinLangItemKind {
    Enum,
    Struct,
    Trait,
    Function,
    Extern,
    TypeAlias,
    Constant,
    Static,
    Impl,
}

struct BuiltinLangItem {
    item: string,
    kind: BuiltinLangItemKind,
    name: string,
    properties: Vec[(string, string)],
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
}

fn builtin_lang_item_kind_name(value: BuiltinLangItemKind) -> string {
    match value {
        Enum => "enum",
        Struct => "struct",
        Trait => "trait",
        Function => "function",
        Extern => "extern function",
        TypeAlias => "type alias",
        Constant => "constant",
        Static => "static",
        Impl => "impl",
    }
}

fn builtin_lang_item_from_attrs(
    attrs: Vec[ast::Attribute],
    kind: BuiltinLangItemKind,
    name: string,
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
) -> Result[Option[BuiltinLangItem], string] {
    let found: Ref[Option[BuiltinLangItem]] = Ref::new(Option::None);
    let kind_name = builtin_lang_item_kind_name(kind);
    for attribute in attrs {
        if attribute.name == "lang" {
            if found.get().is_some() {
                return Err("duplicate #[lang] attribute on builtin " + kind_name + " " + name)
            } else if attribute.args.is_empty() {
                return Err("missing lang item name on builtin " + kind_name + " " + name)
            }
            match attribute.args[0] {
                ast::AttributeArg::String(item) => {
                    if item.byte_len() == 0 {
                        return Err("empty lang item name on builtin " + kind_name + " " + name)
                    }
                    let properties: Vec[(string, string)] = Vec::new();
                    for index in 1..attribute.args.len() {
                        match attribute.args[index] {
                            Named { name, value_kind, value } => if value_kind == "string" {
                                for property in properties {
                                    if property.0 == name {
                                        return Err(
                                            "duplicate property " + name + " on lang item " + item,
                                        )
                                    }
                                }
                                properties.push((name, value))
                            } else {
                                return Err(
                                    "lang item " + item + " property " + name + " must be a string",
                                )
                            },
                            _ => return Err(
                                "lang item " + item + " properties must be named strings",
                            ),
                        }
                    }
                    found.set(
                        Some(
                            BuiltinLangItem {
                                item,
                                kind,
                                name,
                                properties,
                                variants,
                                variant_arities,
                                methods,
                                associated_types,
                            },
                        ),
                    )
                },
                _ => return Err(
                    "lang item name on builtin " + kind_name + " " + name + " must be a string",
                ),
            }
        }
    }
    Ok(found.get())
}

fn append_builtin_lang_item(
    result: Vec[BuiltinLangItem],
    attrs: Vec[ast::Attribute],
    kind: BuiltinLangItemKind,
    name: string,
    variants: Vec[string],
    variant_arities: Vec[isize],
    methods: Vec[string],
    associated_types: Vec[string],
) -> Result[(), string] {
    if let Some(value) = builtin_lang_item_from_attrs(
        attrs,
        kind,
        short_name(name),
        variants,
        variant_arities,
        methods,
        associated_types,
    )? {
        result.push(value)
    }
    Ok(())
}

fn builtin_lang_item_type_name(value: hir::TypeExpr) -> Option[string] {
    match value.kind {
        Named { reference } => Some(hir::type_reference_name(reference)),
        hir::TypeKind::App { ty, args: _ } => match ty.kind {
            Named { reference } => Some(hir::type_reference_name(reference)),
            _ => None,
        },
        _ => None,
    }
}

fn builtin_lang_item_variant_arity(value: hir::EnumVariantFields) -> isize {
    match value {
        hir::EnumVariantFields::Unit => 0,
        hir::EnumVariantFields::Tuple(values) => values.len(),
        hir::EnumVariantFields::Struct(values) => values.len(),
    }
}

fn load_builtin_source_lang_items() -> Result[FrozenVec[BuiltinLangItem], string] {
    let result: Vec[BuiltinLangItem] = Vec::new();
    let files = implicit_builtin_hir_files()?;
    for file in files {
        for item in file.items {
            match item {
                ExternType(_) => return Err("builtin resources cannot declare external Go types"),
                EnumDef(value) => {
                    let variants: Vec[string] = Vec::new();
                    let variant_arities: Vec[isize] = Vec::new();
                    for variant in value.variants {
                        variants.push(variant.name);
                        variant_arities.push(builtin_lang_item_variant_arity(variant.fields))
                    }
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        Enum,
                        value.name,
                        variants,
                        variant_arities,
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                StructDef(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Struct,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                TraitDef(value) => {
                    let methods: Vec[string] = Vec::new();
                    for method in value.method_sigs {
                        methods.push(method.name)
                    }
                    let associated_types: Vec[string] = Vec::new();
                    for associated in value.associated_types {
                        associated_types.push(associated.name)
                    }
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Trait,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        methods,
                        associated_types,
                    )?
                },
                hir::Item::Function(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Function,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                ExternFunction(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        Extern,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::TypeAlias(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        TypeAlias,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::Constant(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        BuiltinLangItemKind::Constant,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::Static(value) => {
                    append_builtin_lang_item(
                        result,
                        value.attrs,
                        Static,
                        value.name,
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                        Vec::new(),
                    )?
                },
                hir::Item::ImplBlock(value) => match builtin_lang_item_type_name(value.for_type) {
                    Some(name) => {
                        let methods: Vec[string] = Vec::new();
                        for method in value.methods {
                            methods.push(method.name)
                        }
                        append_builtin_lang_item(
                            result,
                            value.attrs,
                            Impl,
                            name,
                            Vec::new(),
                            Vec::new(),
                            methods,
                            Vec::new(),
                        )?
                    },
                    None => (),
                },
            }
        }
    }
    Ok(result.freeze())
}

static implicit_builtin_hir_cache: OnceCell[Result[FrozenVec[hir::File], string]] = OnceCell::new();

fn load_implicit_builtin_hir_files() -> Result[FrozenVec[hir::File], string] {
    let inputs: Vec[(ast::LowerResult, string)] = Vec::new();
    for source in resources::builtin_layer_sources()? {
        inputs.push((ast::lower(parser::parse(source.source)), source.path))
    }
    let files: Vec[hir::File] = Vec::new();
    for lowered in hir::lower_package_files(inputs, "builtin") {
        match lowered.hir {
            Some(file) => files.push(file),
            None => return Err("failed to lower builtin source " + lowered.source_path),
        }
    }
    Ok(files.freeze())
}

pub fn implicit_builtin_hir_files() -> Result[Vec[hir::File], string] {
    Ok(implicit_builtin_hir_cache.get_or_init(|| load_implicit_builtin_hir_files())?.to_vec())
}
