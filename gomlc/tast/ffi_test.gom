package tast;

use module::ffi;
use std::json;
use std::testing;

fn ffi_test_scheme(ret_ty: Type) -> FunctionScheme {
    FunctionScheme {
        def_id: Option::None,
        name: "demo::calc::value",
        comptime: ComptimeCapability::RuntimeOnly,
        generics: Vec::new(),
        predicates: Vec::new(),
        params: Vec::from_array([Type::Char]),
        ret_ty,
        callable: Callable::GoForeign {
            binding: "",
            import_path: "example.com/host/shim",
            symbol: "Value",
        },
    }
}

#[test]
fn foreign_bridge_preserves_tuple_and_char_representation() -> () {
    let scheme = ffi_test_scheme(Type::Tuple { items: Vec::from_array([Type::Int64, Type::Bool]) });
    match foreign_binding("demo::calc::value", scheme, Vec::new()) {
        Ok(Some(binding)) => {
            testing::assert_eq(binding.binding_id, "demo::calc::value");
            testing::assert_eq(binding.parameters.len(), 1);
            testing::assert_eq(binding.results.len(), 2);
            let shape = ffi::bridge_type_json(binding.parameters[0]);
            testing::assert_eq(
                json::as_string(json::field(shape, "tag").unwrap_or(json::Value::Null)).unwrap_or(
                    "",
                ),
                "int32",
            )
        },
        _ => testing::fail("failed to collect foreign binding"),
    }
    match foreign_binding("unit", ffi_test_scheme(Type::Unit), Vec::new()) {
        Ok(Some(binding)) => testing::assert_eq(binding.results.len(), 0),
        _ => testing::fail("failed to collect zero-result binding"),
    }
}

#[test]
fn foreign_bridge_rejects_unsupported_nested_values() -> () {
    let values = Vec::from_array(
        [
            Type::Unit,
            Type::Tuple { items: Vec::from_array([Type::Bool, Type::Bool]) },
            Type::VecType { elem: Type::Int },
            Type::RefType { elem: Type::Int },
            Type::Con { name: "Unknown" },
        ],
    );
    for value in values {
        testing::assert(foreign_bridge_type(value, Vec::new(), true).is_err())
    }
    let nested = Type::Tuple {
        items: Vec::from_array(
            [Type::Int, Type::Tuple { items: Vec::from_array([Type::Bool, Type::Int]) }],
        ),
    };
    testing::assert(foreign_binding("nested", ffi_test_scheme(nested), Vec::new()).is_err())
}

#[test]
fn foreign_marker_requires_complete_empty_trait_contract() -> () {
    let marker = TraitInfo {
        name: "Marker",
        generics: Vec::new(),
        predicates: Vec::new(),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        methods: Vec::new(),
    };
    let ty = Type::Dyn {
        trait_name: "Marker",
        args: Vec::new(),
        associated_types: Vec::new(),
        additional_bounds: Vec::new(),
    };
    testing::assert(foreign_bridge_type(ty, Vec::new(), true).is_err());
    let traits = Vec::from_array([marker]);
    testing::assert(foreign_bridge_type(ty, traits, true).is_ok());
    testing::assert(foreign_bridge_type(ty, traits, false).is_err());
    testing::assert(foreign_bridge_type(Type::Slice { elem: ty }, traits, true).is_err());
    testing::assert(foreign_binding("marker", ffi_test_scheme(ty), traits).is_ok());
    let qualified = TraitInfo {
        name: "demo::calc::Marker",
        generics: Vec::new(),
        predicates: Vec::new(),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        methods: Vec::new(),
    };
    testing::assert(
        foreign_binding("local", ffi_test_scheme(ty), Vec::from_array([qualified])).is_ok(),
    );
    testing::assert(foreign_bridge_type(ty, Vec::from_array([qualified]), true).is_err());
    marker.methods.push(
        TraitMethodInfo {
            default_map_requirements: Vec::new(),
            name: "run",
            has_receiver: true,
            generics: Vec::new(),
            predicates: Vec::new(),
            params: Vec::new(),
            ret_ty: Type::Unit,
            default_name: Option::None,
        },
    );
    testing::assert(foreign_bridge_type(ty, traits, true).is_err())
}

#[test]
fn foreign_metadata_cannot_enable_comptime_execution() -> () {
    let value = ffi_test_scheme(Type::Bool);
    let invalid = FunctionScheme {
        def_id: value.def_id,
        name: value.name,
        comptime: ComptimeCapability::Capable,
        generics: value.generics,
        predicates: value.predicates,
        params: value.params,
        ret_ty: value.ret_ty,
        callable: value.callable,
    };
    testing::assert(foreign_binding("invalid", invalid, Vec::new()).is_err())
}

#[test]
fn foreign_named_bridge_retains_nested_type_arguments() -> () {
    let duration = Type::External { import_path: "time", name: "Duration", args: Vec::new() };
    let container = Type::External {
        import_path: "host",
        name: "Box",
        args: Vec::from_array([duration]),
    };
    let expected_duration = ffi::BridgeType::Named {
        import_path: "time",
        name: "Duration",
        arguments: Vec::new(),
    };
    let expected = ffi::BridgeType::Named {
        import_path: "host",
        name: "Box",
        arguments: Vec::from_array([expected_duration]),
    };
    match foreign_bridge_type(container, Vec::new(), true) {
        Ok(actual) => testing::assert(ffi::bridge_types_equal(actual, expected)),
        Err(error) => testing::fail(error),
    }
    for arg in Vec::from_array(
        [Type::Param { name: "T" }, Type::Unit, Type::RefType { elem: Type::Int64 }],
    ) {
        testing::assert(
            foreign_bridge_type(
                Type::External { import_path: "host", name: "Box", args: Vec::from_array([arg]) },
                Vec::new(),
                true,
            ).is_err(),
        )
    }
    testing::assert(
        foreign_bridge_type(
            Type::External { import_path: "host", name: "private", args: Vec::new() },
            Vec::new(),
            true,
        ).is_err(),
    );
}
