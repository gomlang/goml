package tast;

use module::ctir;
use module::hir;
use std::cmp;
use std::collections;
use std::text;

struct CoverageConstructor {
    key: string,
    fields: Vec[Type],
}

struct CoverageNumber {
    negative: bool,
    magnitude: string,
}

struct CoverageScalar {
    kind: string,
    lo: CoverageNumber,
    hi: CoverageNumber,
}

struct CoverageSequence {
    prefix: isize,
    suffix: isize,
    has_rest: bool,
}

struct CoverageContext {
    enums: Vec[EnumInfo],
    structs: Vec[StructInfo],
    domains: HashMap[string, Vec[CoverageConstructor]],
    inhabited: HashMap[string, bool],
}

fn coverage_context(ctx: Checker) -> CoverageContext {
    CoverageContext {
        enums: ctx.enums,
        structs: ctx.structs,
        domains: ctx.coverage_domains,
        inhabited: ctx.coverage_inhabited,
    }
}

fn finalized_coverage_context(file: File, dependencies: Vec[DependencyEnvironment]) -> CoverageContext {
    let enums: Vec[EnumInfo] = Vec::new();
    let structs: Vec[StructInfo] = Vec::new();
    for value in file.enums {
        let variants: Vec[EnumVariantInfo] = Vec::new();
        for variant in value.variants {
            variants.push(EnumVariantInfo { name: variant.name, fields: variant.fields })
        }
        enums.push(
            EnumInfo {
                map_requirements: value.map_requirements,
                def_id: hir::DefId { pkg: -1, index: enums.len() },
                name: value.name,
                generics: value.generics,
                variants,
            },
        )
    }
    for value in file.structs {
        structs.push(
            StructInfo {
                map_requirements: value.map_requirements,
                def_id: hir::DefId { pkg: -1, index: structs.len() },
                name: value.name,
                generics: value.generics,
                fields: value.fields,
                public_fields: value.public_fields,
                has_hidden_fields: value.has_hidden_fields,
                go_comparable: value.go_comparable,
            },
        )
    }
    for dependency in dependencies {
        for value in dependency.enums {
            enums.push(value)
        }
        for value in dependency.structs {
            structs.push(value)
        }
    }
    CoverageContext { enums, structs, domains: HashMap::new(), inhabited: HashMap::new() }
}

fn coverage_find_enum(ctx: CoverageContext, name: string) -> Option[EnumInfo] {
    for value in ctx.enums {
        if value.name == name {
            return Option::Some(value)
        }
    }
    if name.contains("::") {
        Option::None
    } else {
        let mut result: Option[EnumInfo] = Option::None;
        for value in ctx.enums {
            if short_name(value.name) == name {
                if result.is_some() {
                    return Option::None
                } else {
                    result = Option::Some(value);
                }
            }
        }
        result
    }
}

fn coverage_find_struct(ctx: CoverageContext, name: string) -> Option[StructInfo] {
    for value in ctx.structs {
        if value.name == name {
            return Option::Some(value)
        }
    }
    if name.contains("::") {
        Option::None
    } else {
        let mut result: Option[StructInfo] = Option::None;
        for value in ctx.structs {
            if short_name(value.name) == name {
                if result.is_some() {
                    return Option::None
                } else {
                    result = Option::Some(value);
                }
            }
        }
        result
    }
}

struct CoveragePat {
    constructor: Option[CoverageConstructor],
    scalar: Option[CoverageScalar],
    sequence: Option[CoverageSequence],
    fields: Vec[CoveragePat],
    ty: Type,
}

struct CoverageWitness {
    constructor: Option[CoverageConstructor],
    scalar: Option[CoverageScalar],
    fields: Vec[CoverageWitness],
    ty: Type,
}

fn coverage_wild(ty: Type) -> CoveragePat {
    CoveragePat {
        constructor: Option::None,
        scalar: Option::None,
        sequence: Option::None,
        fields: Vec::new(),
        ty,
    }
}

fn coverage_one(value: CoveragePat) -> Vec[CoveragePat] {
    Vec::from_array([value])
}

fn coverage_copy(values: Vec[CoveragePat]) -> Vec[CoveragePat] {
    let result: Vec[CoveragePat] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn coverage_join(left: Vec[CoveragePat], right: Vec[CoveragePat]) -> Vec[CoveragePat] {
    let result = coverage_copy(left);
    for value in right {
        result.push(value)
    }
    result
}

fn coverage_lists_at(values: Vec[Pat], index: isize) -> Vec[Vec[CoveragePat]] {
    if index >= values.len() {
        Vec::from_array([Vec::new()])
    } else {
        let result: Vec[Vec[CoveragePat]] = Vec::new();
        let suffixes = coverage_lists_at(values, index + 1);
        for alternative in coverage_patterns(values[index]) {
            for suffix in suffixes {
                let row = Vec::from_array([alternative]);
                for value in suffix {
                    row.push(value)
                }
                result.push(row)
            }
        }
        result
    }
}

fn coverage_lists(values: Vec[Pat]) -> Vec[Vec[CoveragePat]] {
    coverage_lists_at(values, 0)
}

fn coverage_owner(value: string) -> string {
    match text::rfind(value, "::") {
        Some(index) => value.byte_slice(0, index),
        None => value,
    }
}

fn coverage_enum_key(name: string, tag: isize) -> string {
    f"enum:{name}:{tag}"
}

fn coverage_value_key(value: Constructor) -> string {
    if value.is_struct {
        "struct:" + value.name
    } else {
        match value.tag {
            Some(tag) => coverage_enum_key(coverage_owner(value.name), tag),
            None => "constructor:" + value.name,
        }
    }
}

fn coverage_primitive_value(value: Primitive) -> string {
    match value {
        Unit => "()",
        Bool { value } => if value {
            "bool:true"
        } else {
            "bool:false"
        },
        Int { value } => "isize:" + value,
        Int8 { value } => "i8:" + value,
        Int16 { value } => "i16:" + value,
        Int32 { value } => "i32:" + value,
        Int64 { value } => "i64:" + value,
        Uint { value } => "usize:" + value,
        Uint8 { value } => "u8:" + value,
        Uint16 { value } => "u16:" + value,
        Uint32 { value } => "u32:" + value,
        Uint64 { value } => "u64:" + value,
        Float { value } => "float:" + value,
        Float32 { value } => "f32:" + value,
        Float64 { value } => "f64:" + value,
        String { value } => "string:" + value,
        Char { value } => f"char:{value.to_u32()}",
        Bytes { values: _ } => "bytes",
    }
}

fn coverage_primitive_raw(value: Primitive) -> Option[string] {
    match value {
        Int { value } | Int8 { value } | Int16 { value } | Int32 { value } | Int64 { value } | Uint {
            value,
        } | Uint8 { value } | Uint16 { value } | Uint32 { value } | Uint64 { value } => Option::Some(
            value,
        ),
        Char { value } => Option::Some((value.to_u32()).to_string()),
        _ => Option::None,
    }
}

fn coverage_number(value: string) -> CoverageNumber {
    let magnitude = integer_magnitude(value);
    CoverageNumber {
        negative: value.byte_len() > 0 && value.byte_get(0) == b'-' && magnitude != "0",
        magnitude,
    }
}

fn coverage_magnitude_compare(left: string, right: string) -> cmp::Ordering {
    let length_ordering = cmp::compare(left.byte_len(), right.byte_len());
    if length_ordering.is_ne() {
        return length_ordering
    }
    for index in 0..left.byte_len() {
        let byte_ordering = cmp::compare(left.byte_get(index), right.byte_get(index));
        if byte_ordering.is_ne() {
            return byte_ordering
        }
    }
    cmp::Ordering::Equal
}

fn coverage_number_compare(left: CoverageNumber, right: CoverageNumber) -> cmp::Ordering {
    if left.negative && !(right.negative) {
        cmp::Ordering::Less
    } else if !(left.negative) && right.negative {
        cmp::Ordering::Greater
    } else {
        let result = coverage_magnitude_compare(left.magnitude, right.magnitude);
        if left.negative {
            result.reverse()
        } else {
            result
        }
    }
}

fn coverage_number_equal(left: CoverageNumber, right: CoverageNumber) -> bool {
    coverage_number_compare(left, right).is_eq()
}

fn coverage_number_min(left: CoverageNumber, right: CoverageNumber) -> CoverageNumber {
    if coverage_number_compare(left, right).is_le() {
        left
    } else {
        right
    }
}

fn coverage_number_max(left: CoverageNumber, right: CoverageNumber) -> CoverageNumber {
    if coverage_number_compare(left, right).is_ge() {
        left
    } else {
        right
    }
}

fn coverage_decimal_byte(value: u8) -> string {
    match value {
        48 => "0",
        49 => "1",
        50 => "2",
        51 => "3",
        52 => "4",
        53 => "5",
        54 => "6",
        55 => "7",
        56 => "8",
        _ => "9",
    }
}

fn coverage_decrement_magnitude(value: string) -> string {
    let digits: Vec[u8] = Vec::with_capacity(value.byte_len());
    for index in 0..value.byte_len() {
        digits.push(value.byte_get(index))
    }
    let mut index = digits.len() - 1;
    while index >= 0 {
        let digit = digits[index];
        if digit == 48 {
            digits[index] = 57.to_u8();
        } else {
            digits[index] = digit - 1;
            break
        }
        index -= 1;
    }
    let mut start = 0;
    while start + 1 < digits.len() && digits[start] == 48 {
        start += 1;
    }
    let builder = text::StringBuilder::with_capacity(digits.len() - start);
    for position in start..digits.len() {
        builder.write_string(coverage_decimal_byte(digits[position]))
    }
    builder.finish()
}

fn coverage_number_increment(value: CoverageNumber) -> CoverageNumber {
    if value.negative {
        if value.magnitude == "1" {
            coverage_number("0")
        } else {
            CoverageNumber {
                negative: true,
                magnitude: coverage_decrement_magnitude(value.magnitude),
            }
        }
    } else {
        CoverageNumber { negative: false, magnitude: increment_decimal(value.magnitude) }
    }
}

fn coverage_number_decrement(value: CoverageNumber) -> CoverageNumber {
    if value.negative {
        CoverageNumber { negative: true, magnitude: increment_decimal(value.magnitude) }
    } else if value.magnitude == "0" {
        coverage_number("-1")
    } else {
        CoverageNumber { negative: false, magnitude: coverage_decrement_magnitude(value.magnitude) }
    }
}

fn coverage_scalar_kind(ty: Type) -> Option[string] {
    match resolve_type(ty) {
        Int => Option::Some("isize"),
        Int8 => Option::Some("i8"),
        Int16 => Option::Some("i16"),
        Int32 => Option::Some("i32"),
        Int64 => Option::Some("i64"),
        Uint => Option::Some("usize"),
        Uint8 => Option::Some("u8"),
        Uint16 => Option::Some("u16"),
        Uint32 => Option::Some("u32"),
        Uint64 => Option::Some("u64"),
        Char => Option::Some("char"),
        _ => Option::None,
    }
}

fn coverage_scalar_primitive(value: Primitive, ty: Type) -> Option[CoverageScalar] {
    match (coverage_scalar_kind(ty), coverage_primitive_raw(value)) {
        (Some(kind), Some(value)) => {
            let value = coverage_number(value);
            Option::Some(CoverageScalar { kind, lo: value, hi: value })
        },
        _ => Option::None,
    }
}

fn coverage_scalar_range(start: Primitive, end: Primitive, inclusive: bool, ty: Type) -> Option[
    CoverageScalar,
] {
    match (coverage_scalar_kind(ty), coverage_primitive_raw(start), coverage_primitive_raw(end)) {
        (Some(kind), Some(start), Some(end)) => {
            Option::Some(
                CoverageScalar {
                    kind,
                    lo: coverage_number(start),
                    hi: if inclusive {
                        coverage_number(end)
                    } else {
                        coverage_number_decrement(coverage_number(end))
                    },
                },
            )
        },
        _ => Option::None,
    }
}

fn coverage_range_pattern(start: Primitive, end: Primitive, inclusive: bool, ty: Type) -> CoveragePat {
    CoveragePat {
        constructor: Option::Some(
            CoverageConstructor {
                key: "range:" + coverage_primitive_value(start) + ":"
                    + coverage_primitive_value(end),
                fields: Vec::new(),
            },
        ),
        scalar: coverage_scalar_range(start, end, inclusive, ty),
        sequence: Option::None,
        fields: Vec::new(),
        ty,
    }
}

fn coverage_scalar_domain(kind: string, lo: string, hi: string) -> CoverageScalar {
    CoverageScalar { kind, lo: coverage_number(lo), hi: coverage_number(hi) }
}

fn coverage_scalar_domains(ty: Type) -> Option[Vec[CoverageScalar]] {
    let result: Vec[CoverageScalar] = Vec::new();
    match resolve_type(ty) {
        Int => result.push(
            coverage_scalar_domain("isize", "-9223372036854775808", "9223372036854775807"),
        ),
        Int8 => result.push(coverage_scalar_domain("i8", "-128", "127")),
        Int16 => result.push(coverage_scalar_domain("i16", "-32768", "32767")),
        Int32 => result.push(coverage_scalar_domain("i32", "-2147483648", "2147483647")),
        Int64 => result.push(
            coverage_scalar_domain("i64", "-9223372036854775808", "9223372036854775807"),
        ),
        Uint => result.push(coverage_scalar_domain("usize", "0", "18446744073709551615")),
        Uint8 => result.push(coverage_scalar_domain("u8", "0", "255")),
        Uint16 => result.push(coverage_scalar_domain("u16", "0", "65535")),
        Uint32 => result.push(coverage_scalar_domain("u32", "0", "4294967295")),
        Uint64 => result.push(coverage_scalar_domain("u64", "0", "18446744073709551615")),
        Char => {
            result.push(coverage_scalar_domain("char", "0", "55295"));
            result.push(coverage_scalar_domain("char", "57344", "1114111"))
        },
        _ => return Option::None,
    }
    Option::Some(result)
}

fn coverage_scalar_intersection(left: CoverageScalar, right: CoverageScalar) -> Option[
    CoverageScalar,
] {
    if left.kind != right.kind {
        Option::None
    } else {
        let lo = coverage_number_max(left.lo, right.lo);
        let hi = coverage_number_min(left.hi, right.hi);
        if coverage_number_compare(lo, hi).is_le() {
            Option::Some(CoverageScalar { kind: left.kind, lo, hi })
        } else {
            Option::None
        }
    }
}

fn coverage_repeat(value: Type, count: isize) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for _ in 0..count {
        result.push(value)
    }
    result
}

fn coverage_fixed_array(prefix: Vec[Pat], suffix: Vec[Pat], length: isize, element: Type, ty: Type) -> Vec[
    CoveragePat,
] {
    let result: Vec[CoveragePat] = Vec::new();
    for prefix_values in coverage_lists(prefix) {
        for suffix_values in coverage_lists(suffix) {
            let fields: Vec[CoveragePat] = Vec::new();
            for _ in 0..length {
                fields.push(coverage_wild(element))
            }
            for index in 0..prefix_values.len() {
                if index < length {
                    fields[index] = prefix_values[index];
                }
            }
            for offset in 0..suffix_values.len() {
                let target = length - suffix_values.len() + offset;
                if target >= 0 && target < length {
                    fields[target] = suffix_values[offset];
                }
            }
            result.push(
                CoveragePat {
                    constructor: Option::Some(
                        CoverageConstructor {
                            key: f"array:{length}",
                            fields: coverage_repeat(element, length),
                        },
                    ),
                    scalar: Option::None,
                    sequence: Option::None,
                    fields,
                    ty,
                },
            )
        }
    }
    result
}

fn coverage_sequence_patterns(
    prefix: Vec[Pat],
    rest: Option[ArrayPatRest],
    suffix: Vec[Pat],
    element: Type,
    ty: Type,
) -> Vec[CoveragePat] {
    let result: Vec[CoveragePat] = Vec::new();
    let has_rest = rest.is_some();
    for prefix_values in coverage_lists(prefix) {
        for suffix_values in coverage_lists(suffix) {
            let fields = coverage_join(prefix_values, suffix_values);
            let field_types: Vec[Type] = Vec::new();
            for _ in fields {
                field_types.push(element)
            }
            result.push(
                CoveragePat {
                    constructor: Option::Some(
                        CoverageConstructor {
                            key: f"sequence:{prefix_values.len()}:{suffix_values.len()}:{has_rest}",
                            fields: field_types,
                        },
                    ),
                    scalar: Option::None,
                    sequence: Option::Some(
                        CoverageSequence {
                            prefix: prefix_values.len(),
                            suffix: suffix_values.len(),
                            has_rest,
                        },
                    ),
                    fields,
                    ty,
                },
            )
        }
    }
    result
}

fn coverage_patterns(value: Pat) -> Vec[CoveragePat] {
    match value {
        Var { name: _, is_mut: _, ty } | Wild { ty } => coverage_one(coverage_wild(ty)),
        Constant { name, ty } => coverage_one(
            CoveragePat {
                constructor: Option::Some(
                    CoverageConstructor { key: "constant:" + name, fields: Vec::new() },
                ),
                scalar: Option::None,
                sequence: Option::None,
                fields: Vec::new(),
                ty,
            },
        ),
        Prim { value, ty } => coverage_one(
            CoveragePat {
                constructor: Option::Some(
                    CoverageConstructor { key: coverage_primitive_value(value), fields: Vec::new() },
                ),
                scalar: coverage_scalar_primitive(value, ty),
                sequence: Option::None,
                fields: Vec::new(),
                ty,
            },
        ),
        Constr { constructor, args, ty } => {
            let result: Vec[CoveragePat] = Vec::new();
            for fields in coverage_lists(args) {
                let field_types: Vec[Type] = Vec::new();
                for field in fields {
                    field_types.push(field.ty)
                }
                result.push(
                    CoveragePat {
                        constructor: Option::Some(
                            CoverageConstructor {
                                key: coverage_value_key(constructor),
                                fields: field_types,
                            },
                        ),
                        scalar: Option::None,
                        sequence: Option::None,
                        fields,
                        ty,
                    },
                )
            }
            result
        },
        Tuple { items, ty } => {
            let result: Vec[CoveragePat] = Vec::new();
            for fields in coverage_lists(items) {
                let field_types: Vec[Type] = Vec::new();
                for field in fields {
                    field_types.push(field.ty)
                }
                result.push(
                    CoveragePat {
                        constructor: Option::Some(
                            CoverageConstructor {
                                key: f"tuple:{fields.len()}",
                                fields: field_types,
                            },
                        ),
                        scalar: Option::None,
                        sequence: Option::None,
                        fields,
                        ty,
                    },
                )
            }
            result
        },
        Array { prefix, rest, suffix, ty } => match prune(ty) {
            Array { len: length, elem: element } => coverage_fixed_array(
                prefix,
                suffix,
                length,
                element,
                ty,
            ),
            VecType { elem: element } | Slice { elem: element } | MutSlice { elem: element } => coverage_sequence_patterns(
                prefix,
                rest,
                suffix,
                element,
                ty,
            ),
            _ => coverage_one(coverage_wild(ty)),
        },
        Alias { name: _, pat, ty: _ } => coverage_patterns(pat),
        Or { pats: values, ty: _ } => {
            let result: Vec[CoveragePat] = Vec::new();
            for value in values {
                for alternative in coverage_patterns(value) {
                    result.push(alternative)
                }
            }
            result
        },
        Range { start, end, inclusive, ty } => coverage_one(
            coverage_range_pattern(start, end, inclusive, ty),
        ),
    }
}

fn coverage_type_args(value: Type) -> Vec[Type] {
    match prune(value) {
        App { ty: _, args } => args,
        _ => Vec::new(),
    }
}

fn coverage_substitutions(names: Vec[string], ty: Type) -> Vec[TypeSubst] {
    let args = coverage_type_args(ty);
    let result: Vec[TypeSubst] = Vec::new();
    for index in 0..names.len() {
        if index < args.len() {
            result.push(TypeSubst { name: names[index], ty: args[index] })
        }
    }
    result
}

fn coverage_enum_domain(info: EnumInfo, ty: Type) -> Vec[CoverageConstructor] {
    let result: Vec[CoverageConstructor] = Vec::new();
    let substitutions = coverage_substitutions(info.generics, ty);
    for index in 0..info.variants.len() {
        let fields: Vec[Type] = Vec::new();
        for field in enum_variant_field_types(info.variants[index].fields) {
            fields.push(substitute_type(field, substitutions))
        }
        result.push(CoverageConstructor { key: coverage_enum_key(info.name, index), fields })
    }
    result
}

fn coverage_builtin_domain(name: string, ty: Type) -> Option[Vec[CoverageConstructor]] {
    builtin_source_enum_info(name).map(|info| coverage_enum_domain(info, ty))
}

fn coverage_domain_uncached(ctx: CoverageContext, ty: Type) -> Option[Vec[CoverageConstructor]] {
    match prune(ty) {
        Never => Option::Some(Vec::new()),
        Unit => Option::Some(
            Vec::from_array([CoverageConstructor { key: "()", fields: Vec::new() }]),
        ),
        Bool => Option::Some(
            Vec::from_array(
                [
                    CoverageConstructor { key: "bool:false", fields: Vec::new() },
                    CoverageConstructor { key: "bool:true", fields: Vec::new() },
                ],
            ),
        ),
        Tuple { items: values } => Option::Some(
            Vec::from_array([CoverageConstructor { key: f"tuple:{values.len()}", fields: values }]),
        ),
        Array { len: length, elem: element } => Option::Some(
            Vec::from_array(
                [
                    CoverageConstructor {
                        key: f"array:{length}",
                        fields: coverage_repeat(element, length),
                    },
                ],
            ),
        ),
        Con { name } | App { ty: Con { name }, args: _ } => {
            match coverage_find_enum(ctx, name) {
                Some(info) => Option::Some(coverage_enum_domain(info, ty)),
                None => match coverage_builtin_domain(name, ty) {
                    Some(value) => Option::Some(value),
                    None => match coverage_find_struct(ctx, name) {
                        Some(info) => {
                            let fields: Vec[Type] = Vec::new();
                            let substitutions = coverage_substitutions(info.generics, ty);
                            for field in info.fields {
                                fields.push(substitute_type(field.1, substitutions))
                            }
                            Option::Some(
                                Vec::from_array(
                                    [CoverageConstructor { key: "struct:" + info.name, fields }],
                                ),
                            )
                        },
                        None => Option::None,
                    },
                },
            }
        },
        _ => Option::None,
    }
}

fn coverage_type_key(value: Type) -> string {
    let builder = text::StringBuilder::new();
    write_type(builder, value);
    builder.finish()
}

fn coverage_domain(ctx: CoverageContext, ty: Type) -> Option[Vec[CoverageConstructor]] {
    let resolved = prune(ty);
    let key = coverage_type_key(resolved);
    match ctx.domains[key] {
        Some(value) => Option::Some(value),
        None => match coverage_domain_uncached(ctx, resolved) {
            Some(value) => {
                ctx.domains[key] = value;
                Option::Some(value)
            },
            None => Option::None,
        },
    }
}

fn coverage_copy_strings(values: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn coverage_constructor_inhabited_at(
    ctx: CoverageContext,
    constructor: CoverageConstructor,
    visiting: Vec[string],
    depth: isize,
) -> bool {
    for field in constructor.fields {
        if !(coverage_type_inhabited_at(ctx, field, visiting, depth + 1)) {
            return false
        }
    }
    true
}

fn coverage_type_inhabited_at(ctx: CoverageContext, ty: Type, visiting: Vec[string], depth: isize) -> bool {
    if depth >= 128 {
        true
    } else {
        let key = coverage_type_key(ty);
        if visiting.contains(key) {
            false
        } else {
            let next = coverage_copy_strings(visiting);
            next.push(key);
            match coverage_domain(ctx, ty) {
                Some(domain) => {
                    for constructor in domain {
                        if coverage_constructor_inhabited_at(ctx, constructor, next, depth) {
                            return true
                        }
                    }
                    false
                },
                None => true,
            }
        }
    }
}

fn coverage_type_inhabited(ctx: CoverageContext, ty: Type) -> bool {
    let resolved = prune(ty);
    let key = coverage_type_key(resolved);
    match ctx.inhabited[key] {
        Some(value) => value,
        None => {
            let value = coverage_type_inhabited_at(ctx, resolved, Vec::new(), 0);
            ctx.inhabited[key] = value;
            value
        },
    }
}

fn coverage_inhabited_domain(ctx: CoverageContext, domain: Vec[CoverageConstructor]) -> Vec[
    CoverageConstructor,
] {
    let result: Vec[CoverageConstructor] = Vec::new();
    for constructor in domain {
        if coverage_constructor_inhabited_at(ctx, constructor, Vec::new(), 0) {
            result.push(constructor)
        }
    }
    result
}

fn coverage_present(matrix: Vec[Vec[CoveragePat]]) -> Vec[string] {
    let result = collections::IndexSet::new();
    for row in matrix {
        if !row.is_empty() {
            if let Some(value) = row[0].constructor {
                let _ = result.insert(value.key);
            }
        }
    }
    result.to_vec()
}

fn coverage_tail(row: Vec[CoveragePat]) -> Vec[CoveragePat] {
    let result: Vec[CoveragePat] = Vec::new();
    for index in 1..row.len() {
        result.push(row[index])
    }
    result
}

fn coverage_wild_fields(values: Vec[Type]) -> Vec[CoveragePat] {
    let result: Vec[CoveragePat] = Vec::new();
    for value in values {
        result.push(coverage_wild(value))
    }
    result
}

fn coverage_specialize(matrix: Vec[Vec[CoveragePat]], constructor: CoverageConstructor) -> Vec[
    Vec[CoveragePat],
] {
    let result: Vec[Vec[CoveragePat]] = Vec::new();
    for row in matrix {
        if !row.is_empty() {
            let fields = match row[0].constructor {
                Some(value) => if value.key == constructor.key {
                    Option::Some(row[0].fields)
                } else {
                    Option::None
                },
                None => Option::Some(coverage_wild_fields(constructor.fields)),
            };
            if let Some(fields) = fields {
                result.push(coverage_join(fields, coverage_tail(row)))
            }
        }
    }
    result
}

fn coverage_default(matrix: Vec[Vec[CoveragePat]]) -> Vec[Vec[CoveragePat]] {
    let result: Vec[Vec[CoveragePat]] = Vec::new();
    for row in matrix {
        if !row.is_empty() {
            if let None = row[0].constructor {
                result.push(coverage_tail(row))
            }
        }
    }
    result
}

fn coverage_sequence_element(ty: Type) -> Option[Type] {
    match prune(ty) {
        VecType { elem: element } | Slice { elem: element } | MutSlice { elem: element } => {
            Option::Some(element)
        },
        _ => Option::None,
    }
}

fn coverage_sequence_matches(shape: Option[CoverageSequence], length: isize) -> bool {
    match shape {
        Some(shape) => if shape.has_rest {
            length >= shape.prefix + shape.suffix
        } else {
            length == shape.prefix + shape.suffix
        },
        None => true,
    }
}

fn coverage_sequence_specialize_pattern(pattern: CoveragePat, length: isize, element: Type) -> Option[
    Vec[CoveragePat],
] {
    if !(coverage_sequence_matches(pattern.sequence, length)) {
        Option::None
    } else {
        let fields: Vec[CoveragePat] = Vec::new();
        for _ in 0..length {
            fields.push(coverage_wild(element))
        }
        if let Some(shape) = pattern.sequence {
            for index in 0..shape.prefix {
                fields[index] = pattern.fields[index];
            }
            for offset in 0..shape.suffix {
                fields.set(
                    length - offset - 1,
                    pattern.fields[shape.prefix + shape.suffix - offset - 1],
                )
            }
        }
        Option::Some(fields)
    }
}

fn coverage_sequence_specialize_row(row: Vec[CoveragePat], length: isize, element: Type) -> Option[
    Vec[CoveragePat],
] {
    if row.is_empty() {
        Option::None
    } else {
        coverage_sequence_specialize_pattern(row[0], length, element).map(
            |fields| coverage_join(fields, coverage_tail(row)),
        )
    }
}

fn coverage_useful_sequence(
    ctx: CoverageContext,
    matrix: Vec[Vec[CoveragePat]],
    candidate: Vec[CoveragePat],
    element: Type,
) -> bool {
    let head = candidate[0];
    let tail = coverage_tail(candidate);
    let mut max_prefix = 0;
    let mut max_suffix = 0;
    let exact_lengths = collections::IndexSet::new();
    for row in matrix {
        if !row.is_empty() {
            if let Some(shape) = row[0].sequence {
                if shape.has_rest {
                    if shape.prefix > max_prefix {
                        max_prefix = shape.prefix;
                    }
                    if shape.suffix > max_suffix {
                        max_suffix = shape.suffix;
                    }
                } else {
                    let _ = exact_lengths.insert(shape.prefix + shape.suffix);
                }
            }
        }
    }
    if let Some(shape) = head.sequence {
        if shape.has_rest {
            if shape.prefix > max_prefix {
                max_prefix = shape.prefix;
            }
            if shape.suffix > max_suffix {
                max_suffix = shape.suffix;
            }
        } else {
            let _ = exact_lengths.insert(shape.prefix + shape.suffix);
        }
    }
    let stable_length = max_prefix + max_suffix;
    let mut large_length = stable_length + 1;
    while exact_lengths.contains(large_length) {
        large_length += 1;
    }
    let lengths = collections::IndexSet::new();
    for length in 0..stable_length + 1 {
        let _ = lengths.insert(length);
    }
    let _ = lengths.insert(large_length);
    for length in exact_lengths {
        let _ = lengths.insert(length);
    }
    let element_inhabited = coverage_type_inhabited(ctx, element);
    for length in lengths {
        if coverage_sequence_matches(head.sequence, length) && (length == 0 || element_inhabited) {
            let specialized: Vec[Vec[CoveragePat]] = Vec::new();
            for row in matrix {
                if let Some(row) = coverage_sequence_specialize_row(row, length, element) {
                    specialized.push(row)
                }
            }
            if let Some(fields) = coverage_sequence_specialize_pattern(head, length, element) {
                if coverage_useful(ctx, specialized, coverage_join(fields, tail)) {
                    return true
                }
            }
        }
    }
    false
}

fn coverage_scalar_boundaries(matrix: Vec[Vec[CoveragePat]], interval: CoverageScalar) -> Vec[
    CoverageNumber,
] {
    let boundaries: Vec[CoverageNumber] = Vec::from_array(
        [interval.lo, coverage_number_increment(interval.hi)],
    );
    for row in matrix {
        if !row.is_empty() {
            if let Some(value) = row[0].scalar {
                if let Some(value) = coverage_scalar_intersection(value, interval) {
                    boundaries.push(value.lo);
                    boundaries.push(coverage_number_increment(value.hi));
                }
            }
        }
    }
    collections::sort_by_ordering(boundaries, coverage_number_compare);
    let result: Vec[CoverageNumber] = Vec::new();
    for value in boundaries {
        if result.is_empty() || !coverage_number_equal(result[result.len() - 1], value) {
            result.push(value)
        }
    }
    result
}

fn coverage_domain_complete(domain: Vec[CoverageConstructor], present: Vec[string]) -> bool {
    for constructor in domain {
        if !present.contains(constructor.key) {
            return false
        }
    }
    true
}

fn coverage_copy_scalars(values: Vec[CoverageScalar]) -> Vec[CoverageScalar] {
    let result: Vec[CoverageScalar] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn coverage_scalar_candidate_intervals(head: CoveragePat, domains: Vec[CoverageScalar]) -> Vec[
    CoverageScalar,
] {
    match head.constructor {
        None => coverage_copy_scalars(domains),
        Some(_) => match head.scalar {
            Some(value) => {
                let result: Vec[CoverageScalar] = Vec::new();
                for domain in domains {
                    if let Some(value) = coverage_scalar_intersection(value, domain) {
                        result.push(value)
                    }
                }
                result
            },
            None => coverage_copy_scalars(domains),
        },
    }
}

fn coverage_scalar_contains(container: CoverageScalar, value: CoverageScalar) -> bool {
    container.kind == value.kind && coverage_number_compare(container.lo, value.lo).is_le()
        && coverage_number_compare(container.hi, value.hi).is_ge()
}

fn coverage_scalar_specialize(matrix: Vec[Vec[CoveragePat]], atom: CoverageScalar) -> Vec[
    Vec[CoveragePat],
] {
    let result: Vec[Vec[CoveragePat]] = Vec::new();
    for row in matrix {
        if !row.is_empty() {
            let matches = match row[0].constructor {
                None => true,
                Some(_) => match row[0].scalar {
                    Some(value) => coverage_scalar_contains(value, atom),
                    None => false,
                },
            };
            if matches {
                result.push(coverage_tail(row))
            }
        }
    }
    result
}

fn coverage_useful_scalar(
    ctx: CoverageContext,
    matrix: Vec[Vec[CoveragePat]],
    candidate: Vec[CoveragePat],
    domains: Vec[CoverageScalar],
) -> bool {
    let head = candidate[0];
    let tail = coverage_tail(candidate);
    for interval in coverage_scalar_candidate_intervals(head, domains) {
        let boundaries = coverage_scalar_boundaries(matrix, interval);
        for index in 0..boundaries.len() - 1 {
            let atom = CoverageScalar {
                kind: interval.kind,
                lo: boundaries[index],
                hi: coverage_number_decrement(boundaries[index + 1]),
            };
            if coverage_number_compare(atom.lo, atom.hi).is_le()
                && coverage_useful(ctx, coverage_scalar_specialize(matrix, atom), tail) {
                return true
            }
        }
    }
    false
}

fn coverage_useful(ctx: CoverageContext, matrix: Vec[Vec[CoveragePat]], candidate: Vec[CoveragePat]) -> bool {
    if candidate.is_empty() {
        matrix.is_empty()
    } else {
        let head = candidate[0];
        let tail = coverage_tail(candidate);
        match coverage_sequence_element(head.ty) {
            Some(element) => coverage_useful_sequence(ctx, matrix, candidate, element),
            None => match coverage_scalar_domains(head.ty) {
                Some(domains) => coverage_useful_scalar(ctx, matrix, candidate, domains),
                None => match head.constructor {
                    Some(constructor) => coverage_useful(
                        ctx,
                        coverage_specialize(matrix, constructor),
                        coverage_join(head.fields, tail),
                    ),
                    None => match coverage_domain(ctx, head.ty) {
                        Some(domain) => {
                            let domain = coverage_inhabited_domain(ctx, domain);
                            let present = coverage_present(matrix);
                            if coverage_domain_complete(domain, present) {
                                for constructor in domain {
                                    if coverage_useful(
                                        ctx,
                                        coverage_specialize(matrix, constructor),
                                        coverage_join(
                                            coverage_wild_fields(constructor.fields),
                                            tail,
                                        ),
                                    ) {
                                        return true
                                    }
                                }
                                false
                            } else {
                                coverage_useful(ctx, coverage_default(matrix), tail)
                            }
                        },
                        None => coverage_useful(ctx, coverage_default(matrix), tail),
                    },
                },
            },
        }
    }
}

fn coverage_witness_wild(ty: Type) -> CoverageWitness {
    CoverageWitness { constructor: Option::None, scalar: Option::None, fields: Vec::new(), ty }
}

fn coverage_witness_pat(value: CoverageWitness) -> CoveragePat {
    let fields: Vec[CoveragePat] = Vec::new();
    for field in value.fields {
        fields.push(coverage_witness_pat(field))
    }
    CoveragePat {
        constructor: value.constructor,
        scalar: value.scalar,
        sequence: Option::None,
        fields,
        ty: value.ty,
    }
}

fn coverage_witness_prefix(values: Vec[CoverageWitness], count: isize) -> Vec[CoverageWitness] {
    let result: Vec[CoverageWitness] = Vec::new();
    for index in 0..count {
        result.push(values[index])
    }
    result
}

fn coverage_witness_suffix(values: Vec[CoverageWitness], start: isize) -> Vec[CoverageWitness] {
    let result: Vec[CoverageWitness] = Vec::new();
    for index in start..values.len() {
        result.push(values[index])
    }
    result
}

fn coverage_prepend_witness(head: CoverageWitness, tail: Vec[CoverageWitness]) -> Vec[
    CoverageWitness,
] {
    let result = Vec::from_array([head]);
    for value in tail {
        result.push(value)
    }
    result
}

fn coverage_find_scalar_witness(
    ctx: CoverageContext,
    matrix: Vec[Vec[CoveragePat]],
    candidate: Vec[CoveragePat],
    domains: Vec[CoverageScalar],
) -> Option[Vec[CoverageWitness]] {
    let head = candidate[0];
    let tail = coverage_tail(candidate);
    for interval in coverage_scalar_candidate_intervals(head, domains) {
        let boundaries = coverage_scalar_boundaries(matrix, interval);
        for index in 0..boundaries.len() - 1 {
            let atom = CoverageScalar {
                kind: interval.kind,
                lo: boundaries[index],
                hi: coverage_number_decrement(boundaries[index + 1]),
            };
            if coverage_number_compare(atom.lo, atom.hi).is_le() {
                if let Some(tail_witnesses) = coverage_find_witness(
                    ctx,
                    coverage_scalar_specialize(matrix, atom),
                    tail,
                ) {
                    return Option::Some(
                        coverage_prepend_witness(
                            CoverageWitness {
                                constructor: Option::Some(
                                    CoverageConstructor {
                                        key: "scalar:witness",
                                        fields: Vec::new(),
                                    },
                                ),
                                scalar: Option::Some(atom),
                                fields: Vec::new(),
                                ty: head.ty,
                            },
                            tail_witnesses,
                        ),
                    )
                }
            }
        }
    }
    Option::None
}

fn coverage_find_witness(
    ctx: CoverageContext,
    matrix: Vec[Vec[CoveragePat]],
    candidate: Vec[CoveragePat],
) -> Option[Vec[CoverageWitness]] {
    if candidate.is_empty() {
        if matrix.is_empty() {
            Option::Some(Vec::new())
        } else {
            Option::None
        }
    } else {
        let head = candidate[0];
        let tail = coverage_tail(candidate);
        match coverage_sequence_element(head.ty) {
            Some(_) => if coverage_useful(ctx, matrix, candidate) {
                Option::Some(coverage_prepend_witness(coverage_witness_wild(head.ty), Vec::new()))
            } else {
                Option::None
            },
            None => match coverage_scalar_domains(head.ty) {
                Some(domains) => coverage_find_scalar_witness(ctx, matrix, candidate, domains),
                None => match head.constructor {
                    Some(constructor) => {
                        let specialized = coverage_join(head.fields, tail);
                        match coverage_find_witness(
                            ctx,
                            coverage_specialize(matrix, constructor),
                            specialized,
                        ) {
                            Some(values) => {
                                let count = constructor.fields.len();
                                Option::Some(
                                    coverage_prepend_witness(
                                        CoverageWitness {
                                            constructor: Option::Some(constructor),
                                            scalar: head.scalar,
                                            fields: coverage_witness_prefix(values, count),
                                            ty: head.ty,
                                        },
                                        coverage_witness_suffix(values, count),
                                    ),
                                )
                            },
                            None => Option::None,
                        }
                    },
                    None => match coverage_domain(ctx, head.ty) {
                        Some(domain) => {
                            let domain = coverage_inhabited_domain(ctx, domain);
                            let present = coverage_present(matrix);
                            if coverage_domain_complete(domain, present) {
                                for constructor in domain {
                                    if let Some(values) = coverage_find_witness(
                                        ctx,
                                        coverage_specialize(matrix, constructor),
                                        coverage_join(
                                            coverage_wild_fields(constructor.fields),
                                            tail,
                                        ),
                                    ) {
                                        let count = constructor.fields.len();
                                        return Option::Some(
                                            coverage_prepend_witness(
                                                CoverageWitness {
                                                    constructor: Option::Some(constructor),
                                                    scalar: Option::None,
                                                    fields: coverage_witness_prefix(values, count),
                                                    ty: head.ty,
                                                },
                                                coverage_witness_suffix(values, count),
                                            ),
                                        )
                                    }
                                }
                                Option::None
                            } else {
                                match coverage_find_witness(ctx, coverage_default(matrix), tail) {
                                    Some(tail_witnesses) => {
                                        let missing: Vec[CoverageConstructor] = Vec::new();
                                        for constructor in domain {
                                            if missing.is_empty()
                                                && !(present.contains(constructor.key)) {
                                                missing.push(constructor)
                                            }
                                        }
                                        let witness = if !missing.is_empty() {
                                            let constructor = missing[0];
                                            let fields: Vec[CoverageWitness] = Vec::new();
                                            for ty in constructor.fields {
                                                fields.push(coverage_witness_wild(ty))
                                            }
                                            CoverageWitness {
                                                constructor: Option::Some(constructor),
                                                scalar: Option::None,
                                                fields,
                                                ty: head.ty,
                                            }
                                        } else {
                                            coverage_witness_wild(head.ty)
                                        };
                                        Option::Some(
                                            coverage_prepend_witness(witness, tail_witnesses),
                                        )
                                    },
                                    None => Option::None,
                                }
                            }
                        },
                        None => coverage_find_witness(ctx, coverage_default(matrix), tail).map(
                            |values| coverage_prepend_witness(
                                coverage_witness_wild(head.ty),
                                values,
                            ),
                        ),
                    },
                },
            },
        }
    }
}

fn coverage_number_text(value: CoverageNumber) -> string {
    if value.negative {
        "-" + value.magnitude
    } else {
        value.magnitude
    }
}

fn coverage_number_uint32(value: CoverageNumber) -> u32 {
    let mut result = 0.to_u32();
    for index in 0..value.magnitude.byte_len() {
        result = result * 10 + (value.magnitude.byte_get(index) - 48).to_u32();
    }
    result
}

fn coverage_char_text(value: CoverageNumber) -> string {
    let code = coverage_number_uint32(value);
    if code == 0 {
        "'\\u0000'"
    } else {
        match char_from_u32(code) {
            Some(value) => f"'{value}'",
            None => "'\\u0000'",
        }
    }
}

fn coverage_scalar_text(value: CoverageScalar) -> string {
    let lo = if value.kind == "char" {
        coverage_char_text(value.lo)
    } else {
        coverage_number_text(value.lo)
    };
    let hi = if value.kind == "char" {
        coverage_char_text(value.hi)
    } else {
        coverage_number_text(value.hi)
    };
    if coverage_number_equal(value.lo, value.hi) {
        lo
    } else {
        lo + "..=" + hi
    }
}

fn coverage_witness_list_text(ctx: CoverageContext, values: Vec[CoverageWitness]) -> string {
    let rendered: Vec[string] = Vec::new();
    for value in values {
        rendered.push(coverage_witness_text(ctx, value))
    }
    text::join(rendered, ", ")
}

fn coverage_enum_witness_text(
    ctx: CoverageContext,
    constructor: CoverageConstructor,
    fields: Vec[CoverageWitness],
    ty: Type,
) -> string {
    let name = match prune(ty) {
        Con { name } | App { ty: Con { name }, args: _ } => name,
        _ => "<unknown>",
    };
    let mut variant = "<unknown>";
    match coverage_find_enum(ctx, name) {
        Some(info) => for index in 0..info.variants.len() {
            if constructor.key == coverage_enum_key(info.name, index) {
                variant = info.variants[index].name;
            }
        },
        None => match builtin_source_enum_info(name) {
            Some(info) => for index in 0..info.variants.len() {
                if constructor.key == coverage_enum_key(name, index) {
                    variant = info.variants[index].name;
                }
            },
            None => (),
        },
    }
    let base = short_name(name) + "::" + variant;
    if fields.is_empty() {
        base
    } else {
        base + "(" + coverage_witness_list_text(ctx, fields) + ")"
    }
}

fn coverage_witness_text(ctx: CoverageContext, value: CoverageWitness) -> string {
    match value.scalar {
        Some(scalar) => coverage_scalar_text(scalar),
        None => match value.constructor {
            None => "_",
            Some(constructor) => if constructor.key == "()" {
                "()"
            } else if constructor.key == "bool:false" {
                "false"
            } else if constructor.key == "bool:true" {
                "true"
            } else if constructor.key.starts_with("tuple:") {
                "(" + coverage_witness_list_text(ctx, value.fields) + ")"
            } else if constructor.key.starts_with("enum:") {
                coverage_enum_witness_text(ctx, constructor, value.fields, value.ty)
            } else {
                "_"
            },
        },
    }
}

fn match_witnesses(ctx: CoverageContext, ty: Type, arms: Vec[Arm]) -> Vec[string] {
    if arms.is_empty() && contains_unbound_type_variable(ty) {
        return Vec::from_array(["_"])
    }
    let witness_ty = if !arms.is_empty() {
        resolve_type(ty)
    } else {
        ty
    };
    let matrix: Vec[Vec[CoveragePat]] = Vec::new();
    for arm in arms {
        if coverage_guard(arm.guard) {
            for pattern in coverage_patterns(arm.pat) {
                matrix.push(Vec::from_array([pattern]))
            }
        }
    }
    let witnesses: Vec[string] = Vec::new();
    while witnesses.len() < 8 {
        match coverage_find_witness(ctx, matrix, Vec::from_array([coverage_wild(witness_ty)])) {
            Some(values) => if !values.is_empty() {
                let witness = values[0];
                witnesses.push(coverage_witness_text(ctx, witness));
                matrix.push(Vec::from_array([coverage_witness_pat(witness)]))
            } else {
                return witnesses
            },
            None => return witnesses,
        }
    }
    witnesses
}

fn coverage_guard(value: Option[Expr]) -> bool {
    match value {
        None => true,
        Some(Prim { value: Bool { value }, ty: _ }) => value,
        Some(_) => false,
    }
}

fn coverage_guard_may_match(value: Option[Expr]) -> bool {
    match value {
        Some(Prim { value: Bool { value }, ty: _ }) => value,
        None | Some(_) => true,
    }
}

fn match_is_exhaustive(ctx: CoverageContext, ty: Type, arms: Vec[Arm]) -> bool {
    let matrix: Vec[Vec[CoveragePat]] = Vec::new();
    for arm in arms {
        if coverage_guard(arm.guard) {
            for pattern in coverage_patterns(arm.pat) {
                matrix.push(Vec::from_array([pattern]))
            }
        }
    }
    !coverage_useful(ctx, matrix, Vec::from_array([coverage_wild(ty)]))
}

fn match_useful_arms(ctx: CoverageContext, arms: Vec[Arm]) -> Vec[bool] {
    let matrix: Vec[Vec[CoveragePat]] = Vec::new();
    let result: Vec[bool] = Vec::new();
    for arm in arms {
        let patterns = coverage_patterns(arm.pat);
        result.push(
            coverage_guard_may_match(arm.guard) && coverage_patterns_useful(ctx, matrix, patterns),
        );
        if coverage_guard(arm.guard) {
            for pattern in patterns {
                matrix.push(Vec::from_array([pattern]))
            }
        }
    }
    result
}

fn coverage_patterns_useful(
    ctx: CoverageContext,
    matrix: Vec[Vec[CoveragePat]],
    patterns: Vec[CoveragePat],
) -> bool {
    for pattern in patterns {
        if coverage_useful(ctx, matrix, Vec::from_array([pattern])) {
            return true
        }
    }
    false
}

fn pattern_is_irrefutable(ctx: CoverageContext, value: Pat) -> bool {
    let matrix: Vec[Vec[CoveragePat]] = Vec::new();
    for pattern in coverage_patterns(value) {
        matrix.push(Vec::from_array([pattern]))
    }
    !coverage_useful(ctx, matrix, Vec::from_array([coverage_wild(pat_type(value))]))
}

fn pattern_has_constant(value: Pat) -> bool {
    match value {
        Constant { name: _, ty: _ } => true,
        Constr { constructor: _, args, ty: _ } => patterns_have_constants(args),
        Tuple { items, ty: _ } => patterns_have_constants(items),
        Array { prefix, rest: _, suffix, ty: _ } => {
            patterns_have_constants(prefix) || patterns_have_constants(suffix)
        },
        Alias { name: _, pat, ty: _ } => pattern_has_constant(pat),
        Or { pats, ty: _ } => patterns_have_constants(pats),
        Var { name: _, is_mut: _, ty: _ } | Prim { value: _, ty: _ } | Range {
            start: _,
            end: _,
            inclusive: _,
            ty: _,
        } | Wild { ty: _ } => false,
    }
}

fn patterns_have_constants(values: Vec[Pat]) -> bool {
    for value in values {
        if pattern_has_constant(value) {
            return true
        }
    }
    false
}

fn match_arms_have_constants(values: Vec[Arm]) -> bool {
    for value in values {
        if pattern_has_constant(value.pat) {
            return true
        }
    }
    false
}

fn finalized_constant_value(
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    name: string,
    ty: Type,
) -> Option[Primitive] {
    match module_constant_primitive(module, name, ty) {
        Some(value) => Option::Some(value),
        None => {
            for dependency in dependencies {
                if let Some(value) = module_constant_primitive(dependency, name, ty) {
                    return Option::Some(value)
                }
            }
            Option::None
        },
    }
}

fn resolve_finalized_patterns(
    values: Vec[Pat],
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
) -> Vec[Pat] {
    let result: Vec[Pat] = Vec::new();
    for value in values {
        result.push(resolve_finalized_pattern(value, module, dependencies))
    }
    result
}

fn resolve_finalized_pattern(value: Pat, module: ctir::CtModule, dependencies: Vec[ctir::CtModule]) -> Pat {
    match value {
        Constant { name, ty } => match finalized_constant_value(module, dependencies, name, ty) {
            Some(value) => Pat::Prim { value: normalize_pattern_primitive(value, ty), ty },
            None => Pat::Constant { name, ty },
        },
        Constr { constructor, args, ty } => Pat::Constr {
            constructor,
            args: resolve_finalized_patterns(args, module, dependencies),
            ty,
        },
        Tuple { items, ty } => Pat::Tuple {
            items: resolve_finalized_patterns(items, module, dependencies),
            ty,
        },
        Array { prefix, rest, suffix, ty } => Pat::Array {
            prefix: resolve_finalized_patterns(prefix, module, dependencies),
            rest,
            suffix: resolve_finalized_patterns(suffix, module, dependencies),
            ty,
        },
        Alias { name, pat, ty } => Pat::Alias {
            name,
            pat: resolve_finalized_pattern(pat, module, dependencies),
            ty,
        },
        Or { pats, ty } => Pat::Or {
            pats: resolve_finalized_patterns(pats, module, dependencies),
            ty,
        },
        Var { name, is_mut, ty } => Pat::Var { name, is_mut, ty },
        Prim { value, ty } => Pat::Prim { value, ty },
        Range { start, end, inclusive, ty } => Pat::Range { start, end, inclusive, ty },
        Wild { ty } => Pat::Wild { ty },
    }
}

fn resolve_finalized_arms(
    values: Vec[Arm],
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
) -> Vec[Arm] {
    let result: Vec[Arm] = Vec::new();
    for value in values {
        result.push(
            Arm {
                pat: resolve_finalized_pattern(value.pat, module, dependencies),
                guard: value.guard,
                body: value.body,
            },
        )
    }
    result
}

fn unreachable_match_diagnostic(value: MatchCoverageInfo, index: isize) -> Diagnostic {
    Diagnostic {
        severity: DiagnosticSeverity::Warning,
        stage: TYPER_STAGE,
        message: "Unreachable match arm",
        source_path: value.source_path,
        span: Option::Some(value.pattern_spans[index]),
        primary_label: Option::None,
        secondary_labels: Vec::new(),
        sort_order: 0,
    }
}

fn match_coverage_diagnostics(
    context: CoverageContext,
    value: MatchCoverageInfo,
    ty: Type,
    arms: Vec[Arm],
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
) -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::new();
    if value.invalid_patterns || bool_values_contain(value.invalid_pattern_arms, true) {
        return diagnostics
    }
    let arms = resolve_finalized_arms(arms, module, dependencies);
    if match_arms_have_constants(arms) {
        return diagnostics
    }
    let analysis_arms: Vec[Arm] = Vec::new();
    for index in 0..arms.len() {
        let arm = arms[index];
        analysis_arms.push(
            Arm {
                pat: if value.invalid_pattern_arms[index] {
                    Pat::Wild { ty }
                } else {
                    arm.pat
                },
                guard: arm.guard,
                body: arm.body,
            },
        )
    }
    let useful_arms = match_useful_arms(context, analysis_arms);
    let mut invalid_coverage_seen = false;
    for index in 0..useful_arms.len() {
        if invalid_coverage_seen || !(useful_arms[index]) {
            diagnostics.push(unreachable_match_diagnostic(value, index))
        }
        if value.invalid_pattern_arms[index] {
            invalid_coverage_seen = true;
        }
    }
    let witnesses = if value.invalid_patterns {
        Vec::new()
    } else {
        match_witnesses(context, ty, arms)
    };
    if value.invalid_patterns || witnesses.is_empty() {} else {
        let builder = text::StringBuilder::new();
        builder.write_string(
            "non-exhaustive match: missing pattern"
                + if witnesses.len() == 1 {
                    " "
                } else {
                    "s "
                },
        );
        builder.write_string(text::join(witnesses, ", "));
        diagnostics.push(
            new_diagnostic(TYPER_STAGE, builder.finish(), value.source_path, value.span),
        )
    }
    diagnostics
}

fn append_finalized_match_exprs_diagnostics(
    context: CoverageContext,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    values: Vec[Expr],
    diagnostics: Vec[Diagnostic],
) -> () {
    for value in values {
        append_finalized_match_expr_diagnostics(context, module, dependencies, value, diagnostics)
    }
}

fn append_finalized_match_block_diagnostics(
    context: CoverageContext,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    value: Block,
    diagnostics: Vec[Diagnostic],
) -> () {
    for statement in value.stmts {
        match statement {
            Defer { expr } | Stmt::Expr { expr } => {
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    expr,
                    diagnostics,
                )
            },
            Let { is_mut: _, pat: _, value } => {
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    value,
                    diagnostics,
                )
            },
            LetElse { is_mut: _, pat: _, value, else_branch } => {
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    value,
                    diagnostics,
                );
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    else_branch,
                    diagnostics,
                )
            },
            Assign { target, op: _, value } => {
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    target,
                    diagnostics,
                );
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    value,
                    diagnostics,
                )
            },
        }
    }
    if let Some(value) = value.tail {
        append_finalized_match_expr_diagnostics(context, module, dependencies, value, diagnostics)
    }
}

fn append_finalized_match_expr_diagnostics(
    context: CoverageContext,
    module: ctir::CtModule,
    dependencies: Vec[ctir::CtModule],
    value: Expr,
    diagnostics: Vec[Diagnostic],
) -> () {
    match value {
        Var { .. } | Callable { .. } | Prim { .. } | Continue { .. } => (),
        Constr { args, .. } | Tuple { items: args, .. } | Array { items: args, .. } => {
            append_finalized_match_exprs_diagnostics(
                context,
                module,
                dependencies,
                args,
                diagnostics,
            )
        },
        Closure { body, .. } | Comptime { body, .. } | Loop { body, .. } | Go { expr: body, .. } | Unary {
            expr: body,
            ..,
        } | Cast { expr: body, .. } | ToDyn { expr: body, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                body,
                diagnostics,
            )
        },
        Block { block, .. } => {
            append_finalized_match_block_diagnostics(
                context,
                module,
                dependencies,
                block,
                diagnostics,
            )
        },
        Match { expr, arms, coverage, ty: _ } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                expr,
                diagnostics,
            );
            for arm in arms {
                if let Some(guard) = arm.guard {
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        guard,
                        diagnostics,
                    )
                }
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    arm.body,
                    diagnostics,
                )
            }
            if let Some(value) = coverage {
                for diagnostic in match_coverage_diagnostics(
                    context,
                    value,
                    expr_type(expr),
                    arms,
                    module,
                    dependencies,
                ) {
                    diagnostics.push(diagnostic)
                }
            }
        },
        Select { arms, .. } => for arm in arms {
            match arm {
                Receive { channel, guard, binding: _, binding_ty: _, body } => {
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        channel,
                        diagnostics,
                    );
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        body,
                        diagnostics,
                    );
                    if let Some(value) = guard {
                        append_finalized_match_expr_diagnostics(
                            context,
                            module,
                            dependencies,
                            value,
                            diagnostics,
                        )
                    }
                },
                Send { channel, value, guard, body } => {
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        channel,
                        diagnostics,
                    );
                    if let Some(value) = guard {
                        append_finalized_match_expr_diagnostics(
                            context,
                            module,
                            dependencies,
                            value,
                            diagnostics,
                        )
                    }
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        value,
                        diagnostics,
                    );
                    append_finalized_match_expr_diagnostics(
                        context,
                        module,
                        dependencies,
                        body,
                        diagnostics,
                    )
                },
                Default { body } => append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    body,
                    diagnostics,
                ),
            }
        },
        If { cond, then_branch, else_branch, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                cond,
                diagnostics,
            );
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                then_branch,
                diagnostics,
            );
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                else_branch,
                diagnostics,
            )
        },
        While { cond, body, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                cond,
                diagnostics,
            );
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                body,
                diagnostics,
            )
        },
        For { iterator, body, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                iterator,
                diagnostics,
            );
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                body,
                diagnostics,
            )
        },
        Break { value, .. } | Return { expr: value, .. } => match value {
            Some(value) => {
                append_finalized_match_expr_diagnostics(
                    context,
                    module,
                    dependencies,
                    value,
                    diagnostics,
                )
            },
            None => (),
        },
        Call { func, args, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                func,
                diagnostics,
            );
            append_finalized_match_exprs_diagnostics(
                context,
                module,
                dependencies,
                args,
                diagnostics,
            )
        },
        Proj { tuple, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                tuple,
                diagnostics,
            )
        },
        Field { expr, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                expr,
                diagnostics,
            )
        },
        Index { base, index, .. } | Binary { lhs: base, rhs: index, .. } => {
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                base,
                diagnostics,
            );
            append_finalized_match_expr_diagnostics(
                context,
                module,
                dependencies,
                index,
                diagnostics,
            )
        },
    }
}

fn finalized_match_diagnostics(
    file: File,
    module: ctir::CtModule,
    comptime_dependencies: Vec[ctir::CtModule],
    dependencies: Vec[DependencyEnvironment],
) -> Vec[Diagnostic] {
    let diagnostics: Vec[Diagnostic] = Vec::new();
    let context = finalized_coverage_context(file, dependencies);
    for item in file.items {
        match item {
            Item::Function(value) => append_finalized_match_block_diagnostics(
                context,
                module,
                comptime_dependencies,
                value.body,
                diagnostics,
            ),
            Item::ImplBlock(value) => for method in value.methods {
                append_finalized_match_block_diagnostics(
                    context,
                    module,
                    comptime_dependencies,
                    method.body,
                    diagnostics,
                )
            },
        }
    }
    diagnostics
}
