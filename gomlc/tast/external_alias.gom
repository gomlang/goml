package tast;

use module::ffi;

pub struct ExternalAliasRequirement {
    pub declaration: ffi::TypeDeclarationQuery,
    pub arguments: Vec[Type],
    pub applications: Vec[ExternalTypeApplication],
}

fn record_external_alias_requirements(ctx: Checker, alias: TypeAliasInfo, arguments: Vec[Type]) -> () {
    let substitutions = Vec::new();
    for index in 0..alias.generics.len() {
        if index < arguments.len() {
            substitutions.push(TypeSubst { name: alias.generics[index], ty: arguments[index] })
        }
    }
    for requirement in alias.external_requirements {
        let applied = Vec::new();
        for argument in requirement.arguments {
            applied.push(substitute_type(argument, substitutions))
        }
        requirement.applications.push(
            ExternalTypeApplication {
                function_name: ctx.current_function.get(),
                arguments: applied,
                source_path: ctx.source_path,
                span: ctx.current_span.get(),
            },
        )
    }
}

fn normalize_external_alias_target(ctx: Checker, value: TypeAliasInfo) -> Type {
    let collectors: Vec[(ffi::TypeDeclarationQuery, Vec[ExternalTypeApplication], isize)] = Vec::new();
    for alias in ctx.type_aliases {
        if let Some(query) = alias.external_query {
            if let Some(applications) = alias.applications {
                collectors.push((query, applications, applications.len()))
            }
        }
        for requirement in alias.external_requirements {
            collectors.push(
                (requirement.declaration, requirement.applications, requirement.applications.len()),
            )
        }
    }
    let previous = ctx.current_function.get();
    ctx.current_function.set(Option::Some(value.name));
    let result = expand_type_alias_inner(ctx, value.ty, Vec::from_array([value.name]), false);
    ctx.current_function.set(previous);
    for (declaration, applications, before) in collectors {
        let captured = Vec::new();
        for index in before..applications.len() {
            captured.push(applications[index])
        }
        applications.truncate(before);
        for application in captured {
            let mut concrete = true;
            for argument in application.arguments {
                if !type_is_concrete(argument) {
                    concrete = false;
                }
            }
            if concrete {
                applications.push(application)
            }
            let mut duplicate = false;
            for requirement in value.external_requirements {
                if requirement.declaration.type_id == declaration.type_id
                    && type_lists_equal(requirement.arguments, application.arguments) {
                    duplicate = true;
                }
            }
            if !duplicate {
                value.external_requirements.push(
                    ExternalAliasRequirement {
                        declaration,
                        arguments: application.arguments,
                        applications,
                    },
                )
            }
        }
    }
    result
}
