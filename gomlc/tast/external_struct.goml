package tast;

use module::hir;

pub struct ExternalStructInfo {
    pub fields: Vec[(string, Type)],
    pub pointer: bool,
}

fn opaque_external_receiver(value: Type) -> Option[Type] {
    match prune(value) {
        External { .. } => Option::Some(value),
        GoPointer { elem } => opaque_external_receiver(elem),
        _ => Option::None,
    }
}

fn resolve_external_field_type(ctx: Checker, receiver: Type, name: string) -> Option[Type] {
    let target = opaque_external_receiver(receiver)?;
    push_diagnostic(
        ctx,
        "Cannot access field " + name + " on opaque external Go type " + type_text(target)
            + "; declare a Go FFI accessor",
    );
    Option::Some(Type::Error)
}

fn check_external_struct_expr(
    ctx: Checker,
    name: string,
    fields: Vec[(string, hir::Expr)],
    expected: Option[Type],
) -> Option[Expr] {
    let alias = find_type_alias(ctx, name)?;
    let substitutions = instantiate_substitutions(ctx.counter, alias.generics, Vec::new());
    let ty = normalize_type(
        ctx,
        expand_type_aliases(ctx, substitute_type(alias.ty, substitutions), false),
    );
    let _ = opaque_external_receiver(ty)?;
    push_diagnostic(
        ctx,
        "Cannot construct opaque external Go type " + name
            + " with a struct literal; declare a Go FFI constructor",
    );
    for field in fields {
        let _ = check_expr(ctx, field.1, Option::None);
    }
    report_error_inference(ctx, expected);
    Option::Some(Expr::Prim { value: Primitive::Unit, ty: Type::Error })
}
