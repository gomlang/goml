package tast;

use module::ast;
use module::hir;

pub fn go_export_name(attrs: Vec[ast::Attribute]) -> Option[string] {
    for attribute in attrs {
        if attribute.name == "go_export" && attribute.has_argument_list && attribute.args.len() == 1 {
            if let ast::AttributeArg::String(name) = attribute.args[0] {
                return Option::Some(name)
            }
        }
    }
    Option::None
}

pub fn go_export_value_type(value: Type) -> bool {
    match value {
        Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 => true,
        External { import_path, name, args } => import_path == "" && name == "string"
            && args.is_empty(),
        Array { len, elem } => len >= 0 && go_export_value_type(elem),
        _ => false,
    }
}

pub fn go_export_return_type(value: Type) -> bool {
    match value {
        Unit => true,
        Tuple { items } => {
            for item in items {
                if !go_export_value_type(item) {
                    return false
                }
            }
            true
        },
        _ => go_export_value_type(value),
    }
}

fn go_export_error(ctx: Checker, span: ast::Span, message: string) -> () {
    ctx.diagnostics.push(new_diagnostic(TYPER_STAGE, message, ctx.source_path, Option::Some(span)))
}

fn validate_go_export_function(ctx: Checker, function: hir::Function) -> () {
    let mut seen = false;
    for attribute in function.attrs {
        if attribute.name != "go_export" {
            continue
        }
        if seen {
            go_export_error(ctx, attribute.span, "duplicate go_export attribute")
        }
        seen = true;
        match go_export_name(Vec::from_array([attribute])) {
            Some(name) => if !go_ffi_symbol_is_valid(name) {
                go_export_error(
                    ctx,
                    attribute.span,
                    "go_export name must start with an ASCII uppercase letter and contain only ASCII letters, digits, or underscores",
                )
            },
            None => go_export_error(
                ctx,
                attribute.span,
                "go_export expects one Go name string argument",
            ),
        }
    }
    if !seen {
        return
    }
    if let ast::Visibility::Private = function.visibility {
        go_export_error(ctx, function.name_span, "go_export requires a pub function")
    }
    if !function.generics.is_empty() || !function.generic_bounds.is_empty()
        || !function.predicates.is_empty() {
        go_export_error(ctx, function.name_span, "go_export requires a non-generic function");
        return
    }
    for attribute in function.attrs {
        if attribute.name == "comptime" || attribute.name == "comptime_derive"
            || attribute.name == "test"
            || attribute.name == "property" {
            go_export_error(
                ctx,
                attribute.span,
                "go_export cannot export comptime, derive, or test functions",
            )
        }
    }
    for index in 0..function.params.len() {
        let ty = expand_type_aliases(
            ctx,
            type_from_hir(ctx.builtin, function.params[index].1, Vec::new(), Option::None),
            false,
        );
        if !go_export_value_type(ty) {
            let span = if index < function.param_type_spans.len() {
                function.param_type_spans[index]
            } else {
                function.name_span
            };
            go_export_error(
                ctx,
                span,
                "unsupported go_export parameter type " + diagnostic_type_text(ty),
            )
        }
    }
    let ret_ty = match function.ret_ty {
        Some(ty) => expand_type_aliases(
            ctx,
            type_from_hir(ctx.builtin, ty, Vec::new(), Option::None),
            false,
        ),
        None => Type::Unit,
    };
    if !go_export_return_type(ret_ty) {
        go_export_error(
            ctx,
            function.ret_ty_span.unwrap_or(function.name_span),
            "unsupported go_export return type " + diagnostic_type_text(ret_ty),
        )
    }
}

fn validate_go_exports(ctx: Checker, file: hir::File, package_files: Vec[hir::File]) -> () {
    let names: HashMap[string, bool] = HashMap::new();
    for other in package_files {
        for item in other.items {
            if let Function(function) = item {
                if let Some(name) = go_export_name(function.attrs) {
                    names[name] = true;
                }
            }
        }
    }
    for item in file.items {
        if let Function(function) = item {
            validate_go_export_function(ctx, function);
            if let Some(name) = go_export_name(function.attrs) {
                if names[name].is_some() {
                    go_export_error(ctx, function.name_span, "duplicate Go export name " + name)
                }
                names[name] = true;
            }
        }
    }
}

pub fn go_export_symbol_is_valid(name: string) -> bool {
    go_ffi_symbol_is_valid(name)
}
