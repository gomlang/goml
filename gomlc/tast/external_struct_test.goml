package tast;

use std::testing;

#[test]
fn opaque_external_fields_and_struct_literals_require_explicit_bindings() -> () {
    let declarations = "package api; #[go_type(\"example.com/host\", \"Record\")] extern type Record[T]; type Local = Record[i64]; ";
    for body in Vec::from_array(
        [
            "pub fn field(value: Record[i64]) -> i64 { value.Value }",
            "pub fn alias_field(value: Local) -> i64 { value.Value }",
            "pub fn construct() -> Record[i64] { Record { Value: 1 } }",
            "pub fn alias_construct() -> Local { Local { Value: 1 } }",
            "pub fn update(value: Local) -> Local { Local { Value: 1, ..value } }",
        ],
    ) {
        match check_external_source(Vec::from_array([declarations + body])) {
            Ok(result) => {
                testing::assert(
                    has_diagnostic_containing(result.diagnostics, "opaque external Go type"),
                );
                testing::assert(!has_diagnostic_containing(result.diagnostics, "not found"));
                for diagnostic in result.diagnostics {
                    testing::assert(diagnostic.span.is_some())
                }
            },
            Err(error) => testing::fail(error),
        }
    }
}

#[test]
fn opaque_external_fields_through_go_pointers_report_recoverable_errors() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let file = dependency_hir("package api;", "opaque::api");
    let ctx = collect_environment(file, false, builtin);
    let target = Type::External {
        import_path: "example.com/host",
        name: "Record",
        args: Vec::new(),
    };
    testing::assert(
        resolve_external_field_type(ctx, Type::GoPointer { elem: target }, "Value").is_some(),
    );
    testing::assert_eq(ctx.diagnostics.len(), 1);
    testing::assert(has_diagnostic_containing(ctx.diagnostics, "opaque external Go type"));
    testing::assert(resolve_external_field_type(ctx, Type::Int64, "Value").is_none());
    testing::assert_eq(ctx.diagnostics.len(), 1);
}
