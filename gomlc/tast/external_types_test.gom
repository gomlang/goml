fn imported_external_aliases_collect_concrete_arguments_and_validate_metadata() -> () {
    if let Err(error) = exercise_imported_external_collection() {
        testing::fail(error)
    }
}

fn exercise_external_application_owners() -> Result[(), string] {
    let applications = Vec::new();
    let aliases = Vec::from_array(
        [
            TypeAliasInfo {
                go_comparable: Option::None,
                applications: Option::Some(applications),
                name: "test::api::Constrained",
                generics: Vec::from_array(["T"]),
                ty: Type::Int64,
            },
        ],
    );
    let files = external_source_files(
        Vec::from_array(
            [
                "package api; #[go_type(\"example.com/host\", \"Constrained\")] extern type Constrained[T]; type Concrete = Constrained[i64]; pub fn outer[T](value: T) -> T { let closure = |item: Constrained[T]| item; let _ = closure; value } pub fn signature[T](value: Constrained[T]) -> i64 { value }",
            ],
        ),
    );
    let dependencies = Vec::from_array([implicit_builtin_dependency_environment()?]);
    let checked = check_package_files_for_link_with_environments_options(
        files,
        dependencies,
        false,
        false,
        aliases,
    );
    for diagnostic in checked.diagnostics {
        testing::fail(diagnostic.message)
    }
    let mut outer = false;
    let mut signature = false;
    let mut unowned = false;
    for application in applications {
        match application.function_name {
            Some(name) if name == "test::api::outer" => {
                testing::assert(types_equal(application.arguments[0], Type::Param { name: "T" }));
                outer = true;
            },
            Some(name) if name == "test::api::signature" => {
                testing::assert(types_equal(application.arguments[0], Type::Param { name: "T" }));
                signature = true;
            },
            None => {
                testing::assert(types_equal(application.arguments[0], Type::Int64));
                unowned = true;
            },
            _ => testing::fail("unexpected external application owner"),
        }
    }
    testing::assert(outer);
    testing::assert(signature);
    testing::assert(unowned);
    let plan = partition_external_applications(
        ffi::TypeDeclarationQuery {
            type_id: "test::api::Constrained",
            import_path: "example.com/host",
            name: "Constrained",
        },
        applications,
    )?;
    testing::assert_eq(plan.concrete.len(), 1);
    testing::assert_eq(plan.symbolic.len(), 2);
    for application in plan.symbolic {
        testing::assert(application.source_path != "");
        testing::assert_eq(application.declaration.name, "Constrained");
        testing::assert(types_equal(application.arguments[0], Type::Param { name: "T" }))
    }
    Result::Ok(())
}

#[test]
fn external_applications_track_signature_and_closure_owners_without_leaking_scope() -> () {
    if let Err(error) = exercise_external_application_owners() {
        testing::fail(error)
    }
}

#[test]
fn external_pointer_types_substitute_without_becoming_references() -> () {
    let pointer = Type::GoPointer { elem: Type::Param { name: "T" } };
    let actual = substitute_params(pointer, Vec::from_array(["T"]), Vec::from_array([Type::Int64]));
    testing::assert(types_equal(actual, Type::GoPointer { elem: Type::Int64 }));
    testing::assert(!types_equal(actual, Type::RefType { elem: Type::Int64 }));
    testing::assert(!unify(actual, Type::Int64));
    testing::assert(!unify(actual, Type::RefType { elem: Type::Int64 }));
    testing::assert(type_is_concrete(actual));
    testing::assert(!type_is_concrete(pointer));
    let variable = fresh_type(Ref::new(300), VarKind::Any);
    testing::assert(!unify(variable, Type::GoPointer { elem: variable }));
}
