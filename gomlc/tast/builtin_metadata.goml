package tast;

pub struct BuiltinMetadata {
    pub lang_items: Vec[BuiltinLangItem],
    pub traits: Vec[TraitInfo],
    pub enums: Vec[EnumInfo],
    pub structs: Vec[StructInfo],
    pub functions: Vec[FunctionScheme],
    pub arities: Vec[(string, isize)],
    pub impls: Vec[ImplInfo],
    pub inherent_methods: Vec[(string, string)],
}

pub fn builtin_lang_items() -> Result[Vec[BuiltinLangItem], string] {
    Ok(builtin_source_lang_items.get_or_init(|| load_builtin_source_lang_items())?.to_vec())
}

pub fn builtin_inherent_methods() -> Vec[(string, string)] {
    builtin_source_inherent_methods.get_or_init(|| load_builtin_source_inherent_methods()).to_vec()
}

pub fn install_builtin_metadata(value: BuiltinMetadata) -> Result[(), string] {
    let _ = builtin_source_lang_items.get_or_init(|| Ok(value.lang_items.freeze()))?;
    let _ = builtin_type_implementations.get_or_init(|| value.impls.freeze());
    let _ = builtin_source_inherent_methods.get_or_init(|| value.inherent_methods.freeze());
    builtin_contract()?;
    Ok(())
}
