package tast;

use module::ast;

struct FieldConstraint {
    receiver: Type,
    name: string,
    field_ty: Type,
    span: Option[ast::Span],
}

struct PredicateRequirement {
    predicate: TypePredicate,
    message: string,
    span: Option[ast::Span],
}

struct CoercionConstraint {
    actual: Type,
    expected: Type,
    span: Option[ast::Span],
}

struct NumericLiteralConstraint {
    raw: string,
    ty: Type,
    float: bool,
    negative: Ref[bool],
    span: Option[ast::Span],
}

struct InferenceContext {
    deferred_methods: Vec[DeferredMethod],
    counter: Ref[isize],
    coercion_constraints: Vec[CoercionConstraint],
    numeric_literal_constraints: Vec[NumericLiteralConstraint],
    defer_coercion_depth: Ref[isize],
    active_projections: Vec[string],
    field_constraints: Vec[FieldConstraint],
    silent_field_receivers: Vec[Type],
    required_predicates: Vec[PredicateRequirement],
    generic_arguments: Vec[(Type, Option[ast::Span])],
    unresolved_inference_vars: Vec[Ref[TypeVar]],
    reported_inference_spans: Vec[isize],
}

fn inference_context(counter: Ref[isize]) -> InferenceContext {
    InferenceContext {
        counter,
        deferred_methods: Vec::new(),
        coercion_constraints: Vec::new(),
        numeric_literal_constraints: Vec::new(),
        defer_coercion_depth: Ref::new(0),
        active_projections: Vec::new(),
        field_constraints: Vec::new(),
        silent_field_receivers: Vec::new(),
        required_predicates: Vec::new(),
        generic_arguments: Vec::new(),
        unresolved_inference_vars: Vec::new(),
        reported_inference_spans: Vec::new(),
    }
}

struct InferenceBinding {
    variable: Ref[TypeVar],
    value: TypeVar,
}

struct InferenceSnapshot {
    bindings: Vec[InferenceBinding],
}

impl InferenceSnapshot {
    fn include(self, value: Type) -> () {
        match value {
            Var(variable) => {
                for binding in self.bindings {
                    if ptr_eq(binding.variable, variable) {
                        return
                    }
                }
                let value = variable.get();
                self.bindings.push(InferenceBinding { variable, value });
                if let Link(inner) = value {
                    self.include(inner)
                }
            },
            App { ty, args } => {
                self.include(ty);
                self.include_types(args)
            },
            value => for_each_child_type(value, |child| self.include(child)),
        }
    }

    fn include_types(self, values: Vec[Type]) -> () {
        for value in values {
            self.include(value)
        }
    }

    fn include_predicates(self, values: Vec[TypePredicate]) -> () {
        for value in values {
            match value {
                GoComparable(ty) => self.include(ty),
                Trait { for_ty, trait_ref } => {
                    self.include(for_ty);
                    self.include_types(trait_ref.args)
                },
                Equality { lhs, rhs } => {
                    self.include(lhs);
                    self.include(rhs)
                },
            }
        }
    }

    fn changed(self) -> bool {
        for binding in self.bindings {
            let unchanged = match (binding.value, binding.variable.get()) {
                (Unbound { kind: left, .. }, Unbound { kind: right, .. }) => match (left, right) {
                    (Any, Any) | (Integer, Integer) | (Float, Float) => true,
                    _ => false,
                },
                (Link(left), Link(right)) => types_equal(left, right),
                _ => false,
            };
            if !unchanged {
                return true
            }
        }
        false
    }

    fn restore(self) -> () {
        for binding in self.bindings {
            binding.variable.set(binding.value)
        }
    }

    fn capture(self) -> InferenceSnapshot {
        let result = InferenceSnapshot { bindings: Vec::new() };
        for binding in self.bindings {
            result.include(Type::Var(binding.variable))
        }
        result
    }
}

fn inference_snapshot(values: Vec[Type]) -> InferenceSnapshot {
    let result = InferenceSnapshot { bindings: Vec::new() };
    result.include_types(values);
    result
}

fn method_inference_snapshot(
    receiver: Type,
    args: Vec[Type],
    expected: Option[Type],
    explicit: Vec[Type],
) -> InferenceSnapshot {
    let result = inference_snapshot(Vec::from_array([receiver]));
    result.include_types(args);
    result.include_types(explicit);
    if let Some(value) = expected {
        result.include(value)
    }
    result
}

fn resolved_inference_type(value: Type) -> Type {
    map_child_types(prune(value), resolved_inference_type)
}
