package tast;

use module::ast;

struct DiscardedExpr {
    span: ast::Span,
    statement_span: ast::Span,
    ty: Type,
}

fn is_builtin_result(ctx: Checker, ty: Type) -> bool {
    let ty = resolve_signature_type(ctx, ty, ctx.predicates, false);
    let Some(parts) = try_type_parts(ctx.builtin, ty) else {
        return false;
    };
    if parts.0 != ctx.builtin.result.name || parts.1.len() != 2 {
        return false
    }
    for value in ctx.structs {
        if value.name == parts.0 {
            return false
        }
    }
    if let Some(value) = find_enum_by_exact_name(ctx, parts.0) {
        if value.def_id.pkg >= 0 {
            let Some(builtin) = builtin_source_enum_info(ctx.builtin.result.name) else {
                return false;
            };
            return value.def_id.pkg == builtin.def_id.pkg
        }
    }
    true
}

fn warn_unused_results(ctx: Checker) -> () {
    for value in ctx.discarded_exprs {
        if is_builtin_result(ctx, value.ty) {
            let mut diagnostic = new_diagnostic(
                TYPER_STAGE,
                "unused Result value",
                ctx.source_path,
                Option::Some(value.span),
            );
            diagnostic.severity = DiagnosticSeverity::Warning;
            diagnostic.code = Option::Some("unused_result");
            diagnostic.help.push("Handle the error or use `let _ = ...` to explicitly ignore it.");
            diagnostic.primary_label = Option::Some("this Result may contain an error");
            if value.statement_span.start <= value.span.start
                && value.statement_span.end >= value.span.end
                && value.statement_span.end > value.statement_span.start {
                let edits = Vec::from_array(
                    [
                        DiagnosticEdit {
                            source_path: ctx.source_path,
                            span: ast::span(value.statement_span.start, value.statement_span.start),
                            replacement: "let _ = ",
                        },
                    ],
                );
                if value.statement_span.end == value.span.end {
                    edits.push(
                        DiagnosticEdit {
                            source_path: ctx.source_path,
                            span: ast::span(value.statement_span.end, value.statement_span.end),
                            replacement: ";",
                        },
                    )
                }
                diagnostic.fixes.push(
                    DiagnosticFix {
                        title: "Explicitly ignore this Result",
                        applicability: FixApplicability::RequiresReview,
                        edits,
                    },
                )
            }
            ctx.diagnostics.push(diagnostic)
        }
    }
}
