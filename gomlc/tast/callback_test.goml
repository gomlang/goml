package tast;

use std::testing;

#[test]
fn callback_conversion_text_boundaries_preserve_raw_handles() -> () {
    for value in[
        Type::String,
        Type::Char,
        Type::Array { len: 2, elem: Type::String },
        Type::Slice { elem: Type::Char },
        Type::GoMap { key: Type::Int32, value: Type::String },
    ] {
        testing::assert(
            validate_go_callback_signature(
                Type::Func { params: Vec::from_array([value]), ret_ty: Type::Unit },
            ).is_err(),
        );
        testing::assert(
            validate_go_callback_signature(
                Type::Func {
                    params: Vec::new(),
                    ret_ty: Type::Tuple { items: Vec::from_array([Type::Int32, value]) },
                },
            ).is_err(),
        );
    }
    for value in[
        Type::Int32,
        Type::External { import_path: "", name: "string", args: Vec::new() },
        Type::GoPointer { elem: Type::String },
        Type::GoFunction {
            signature: Type::Func { params: Vec::from_array([Type::String]), ret_ty: Type::String },
        },
    ] {
        testing::assert(
            validate_go_callback_signature(
                Type::Func { params: Vec::from_array([value]), ret_ty: value },
            ).is_ok(),
        );
    }
}
