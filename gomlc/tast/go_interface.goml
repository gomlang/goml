package tast;

use module::ast;
use module::hir;

pub fn validate_go_interface_bridge_callable(methods: Vec[string], ty: Type) -> Result[(), string] {
    let Func { params, ret_ty } = resolve_type(ty) else {
        return Result::Err("Go interface bridge requires a constructor function type")
    };
    let External { import_path, name, .. } = resolve_type(ret_ty) else {
        return Result::Err("Go interface bridge requires a native interface target")
    };
    if import_path == "" && name != "error" {
        return Result::Err("Go interface bridge requires a native interface target")
    }
    let _ = foreign_bridge_type(ret_ty, Vec::new(), false)?;
    if !type_is_concrete(ty) || params.len() != methods.len() {
        return Result::Err("Go interface bridge constructor does not match its method plan")
    }
    let seen: Vec[string] = Vec::new();
    for index in 0..methods.len() {
        let name = methods[index];
        if !go_ffi_symbol_is_valid(name) || seen.contains(name) {
            return Result::Err("Go interface bridge requires distinct exported method names")
        }
        seen.push(name);
        interface_boundary_type(params[index])?;
        let _ = foreign_function_bridge(params[index], Vec::new())?;
    }
    Result::Ok(())
}

fn interface_boundary_type(value: Type) -> Result[(), string] {
    match resolve_type(value) {
        String | Char => Result::Err(
            "go_interface text boundaries require ffi::String and ffi::Rune",
        ),
        Slice { .. } => Result::Err(
            "go_interface slice boundaries require ffi::RawSlice and an explicit copy/share policy",
        ),
        GoPointer { elem } | MutSlice { elem } | Array { elem, .. } | Channel { elem, .. } => interface_boundary_type(
            elem,
        ),
        GoMap { key, value } => {
            interface_boundary_type(key)?;
            interface_boundary_type(value)
        },
        GoFunction { signature } => interface_boundary_type(signature),
        Func { params, ret_ty } => {
            for param in params {
                interface_boundary_type(param)?;
            }
            interface_boundary_type(ret_ty)
        },
        Tuple { items } => {
            for item in items {
                interface_boundary_type(item)?;
            }
            Result::Ok(())
        },
        External { args, .. } => {
            for arg in args {
                interface_boundary_type(arg)?;
            }
            Result::Ok(())
        },
        _ => Result::Ok(()),
    }
}

fn validate_go_interface_bridges(ctx: Checker, file: hir::File) -> () {
    for item in file.items {
        let hir::Item::ExternFunction(definition) = item else {
            continue
        };
        let Some(function) = find_function_by_name(ctx, definition.name) else {
            continue
        };
        let Callable::GoInterfaceBridge { methods, .. } = function.callable else {
            continue
        };
        let ty = Type::Func { params: function.params, ret_ty: function.ret_ty };
        if let Err(message) = validate_go_interface_bridge_callable(methods, ty) {
            let mut span = Option::None;
            for attribute in definition.attrs {
                if attribute.name == "go_interface_bridge" {
                    span = Option::Some(attribute.span);
                }
            }
            ctx.diagnostics.push(new_diagnostic(TYPER_STAGE, message, file.source_path, span));
        }
    }
}

fn validate_go_interface_members(
    ctx: Checker,
    file: hir::File,
    package_files: Vec[hir::File],
    items: Vec[Item],
) -> () {
    let declarations = Vec::from_array([file]);
    for candidate in package_files {
        if candidate.source_path != file.source_path {
            declarations.push(candidate);
        }
    }
    for owner in declarations {
        for item in owner.items {
            let hir::Item::TraitDef(definition) = item else {
                continue
            };
            let Ok(Some(specification)) = ast::go_interface_spec(definition.attrs) else {
                continue
            };
            let prefix = definition.name.byte_slice(
                0,
                definition.name.byte_len() - short_name(definition.name).byte_len(),
            );
            let wrapper = prefix + specification.wrapper_name;
            for item in items {
                let Item::ImplBlock(block) = item else {
                    continue
                };
                if !types_equal(block.for_type, Type::Con { name: wrapper }) {
                    continue
                }
                for method in block.methods {
                    let mut reserved = method.name == "from_go" || method.name == "into_go"
                        || method.name == "from_trait";
                    for mapping in specification.methods {
                        if mapping.0 == method.name {
                            reserved = true;
                        }
                    }
                    if reserved
                        && (method.source_path != owner.source_path
                            || method.name_span.start != specification.span.start
                            || method.name_span.end != specification.span.end) {
                        ctx.diagnostics.push(
                            new_diagnostic(
                                TYPER_STAGE,
                                "go_interface generated member collides with " + wrapper + "::"
                                    + method.name,
                                method.source_path,
                                Option::Some(method.name_span),
                            ),
                        );
                    }
                }
            }
        }
    }
}
