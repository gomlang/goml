package tast;

pub fn validate_go_interface_bridge_callable(methods: Vec[string], ty: Type) -> Result[(), string] {
    let Func { params, ret_ty } = resolve_type(ty) else {
        return Err("Go interface bridge requires a constructor function type")
    };
    let External { import_path, name, .. } = resolve_type(ret_ty) else {
        return Err("Go interface bridge requires a native interface target")
    };
    if import_path == "" && name != "error" {
        return Err("Go interface bridge requires a native interface target")
    }
    let _ = foreign_bridge_type(ret_ty, Vec::new(), false)?;
    if !type_is_concrete(ty) || params.len() != methods.len() {
        return Err("Go interface bridge constructor does not match its method plan")
    }
    let seen: Vec[string] = Vec::new();
    for index in 0..methods.len() {
        let name = methods[index];
        if !go_ffi_symbol_is_valid(name) || seen.contains(name) {
            return Err("Go interface bridge requires distinct exported method names")
        }
        seen.push(name);
        interface_boundary_type(params[index])?;
        let _ = foreign_function_bridge(params[index], Vec::new())?;
    }
    Ok(())
}

fn interface_boundary_type(value: Type) -> Result[(), string] {
    match resolve_type(value) {
        String | Char => Err("go_interface text boundaries require ffi::String and ffi::Rune"),
        Slice { .. } => Err(
            "go_interface slice boundaries require ffi::RawSlice and an explicit copy/share policy",
        ),
        GoPointer { elem } | MutSlice { elem } | Array { elem, .. } | Channel { elem, .. } => interface_boundary_type(
            elem,
        ),
        GoMap { key, value } => {
            interface_boundary_type(key)?;
            interface_boundary_type(value)
        },
        GoFunction { signature } => interface_boundary_type(signature),
        Func { params, ret_ty } => {
            for param in params {
                interface_boundary_type(param)?;
            }
            interface_boundary_type(ret_ty)
        },
        Tuple { items } => {
            for item in items {
                interface_boundary_type(item)?;
            }
            Ok(())
        },
        External { args, .. } => {
            for arg in args {
                interface_boundary_type(arg)?;
            }
            Ok(())
        },
        _ => Ok(()),
    }
}
