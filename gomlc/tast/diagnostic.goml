package tast;

use std::text;

pub fn diagnostic_guidance(value: Diagnostic) -> string {
    let builder = text::StringBuilder::new();
    for note in value.notes {
        builder.write_string("\nnote: ");
        builder.write_string(note)
    }
    for help in value.help {
        builder.write_string("\nhelp: ");
        builder.write_string(help)
    }
    builder.finish()
}

pub fn fix_applicability_text(value: FixApplicability) -> string {
    match value {
        MachineApplicable => "machine-applicable",
        RequiresReview => "requires-review",
    }
}
