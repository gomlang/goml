package tast;

fn any_type(values: Vec[Type], predicate: (Type) -> bool) -> bool {
    for value in values {
        if predicate(value) {
            return true
        }
    }
    false
}

fn any_associated_type(values: Vec[(string, Type)], predicate: (Type) -> bool) -> bool {
    for value in values {
        if predicate(value.1) {
            return true
        }
    }
    false
}

fn any_child_type(value: Type, predicate: (Type) -> bool) -> bool {
    match value {
        Tuple { items } => any_type(items, predicate),
        Dyn { trait_name: _, args, associated_types, additional_bounds } => {
            if any_type(args, predicate) || any_associated_type(associated_types, predicate) {
                return true
            }
            for bound in additional_bounds {
                if any_type(bound.args, predicate)
                    || any_associated_type(bound.associated_types, predicate) {
                    return true
                }
            }
            false
        },
        Projection { for_ty, name: _, trait_ref } => {
            predicate(for_ty)
                || match trait_ref {
                    Some(reference) => any_type(reference.args, predicate),
                    None => false,
                }
        },
        External { import_path: _, name: _, args } => any_type(args, predicate),
        App { ty, args } => predicate(ty) || any_type(args, predicate),
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => predicate(
            elem,
        ),
        HashMap { key, value } | GoMap { key, value } => predicate(key) || predicate(value),
        Func { params, ret_ty } => predicate(ret_ty) || any_type(params, predicate),
        Var(_) | Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Con {
            name: _,
        } | Param { name: _ } | Error => false,
    }
}

fn for_each_child_type(value: Type, visit: (Type) -> ()) -> () {
    let _ = any_child_type(
        value,
        |child| {
            visit(child);
            false
        },
    );
}

fn map_types(values: Vec[Type], transform: (Type) -> Type) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for value in values {
        result.push(transform(value))
    }
    result
}

fn map_associated_types(values: Vec[(string, Type)], transform: (Type) -> Type) -> Vec[
    (string, Type),
] {
    let result: Vec[(string, Type)] = Vec::new();
    for value in values {
        result.push((value.0, transform(value.1)))
    }
    result
}

fn map_child_types(value: Type, transform: (Type) -> Type) -> Type {
    match value {
        Tuple { items } => Type::Tuple { items: map_types(items, transform) },
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let bounds: Vec[DynTraitBound] = Vec::new();
            for bound in additional_bounds {
                bounds.push(
                    DynTraitBound {
                        trait_name: bound.trait_name,
                        args: map_types(bound.args, transform),
                        associated_types: map_associated_types(bound.associated_types, transform),
                    },
                )
            }
            Type::Dyn {
                trait_name,
                args: map_types(args, transform),
                associated_types: map_associated_types(associated_types, transform),
                additional_bounds: bounds,
            }
        },
        Projection { for_ty, name, trait_ref } => Type::Projection {
            for_ty: transform(for_ty),
            name,
            trait_ref: trait_ref.map(
                |reference| TraitRef {
                    name: reference.name,
                    args: map_types(reference.args, transform),
                },
            ),
        },
        External { import_path, name, args } => Type::External {
            import_path,
            name,
            args: map_types(args, transform),
        },
        App { ty, args } => Type::App { ty: transform(ty), args: map_types(args, transform) },
        Array { len, elem } => Type::Array { len, elem: transform(elem) },
        Slice { elem } => Type::Slice { elem: transform(elem) },
        MutSlice { elem } => Type::MutSlice { elem: transform(elem) },
        VecType { elem } => Type::VecType { elem: transform(elem) },
        GoPointer { elem } => Type::GoPointer { elem: transform(elem) },
        GoFunction { signature } => Type::GoFunction { signature: transform(signature) },
        RefType { elem } => Type::RefType { elem: transform(elem) },
        Channel { elem, direction } => Type::Channel { elem: transform(elem), direction },
        HashMap { key, value } => Type::HashMap { key: transform(key), value: transform(value) },
        GoMap { key, value } => Type::GoMap { key: transform(key), value: transform(value) },
        Func { params, ret_ty } => Type::Func {
            params: map_types(params, transform),
            ret_ty: transform(ret_ty),
        },
        Var(_) | Unit | Never | Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char | Con {
            name: _,
        } | Param { name: _ } | Error => value,
    }
}
