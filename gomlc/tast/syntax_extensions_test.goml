package tast;

use std::testing;

fn syntax_extensions_valid(source: string) -> () {
    let diagnostics = checked_diagnostics(source);
    for diagnostic in diagnostics {
        println(diagnostic.message)
    }
    testing::assert(diagnostics.is_empty())
}

#[test]
fn syntax_extensions_contextual_constructors_use_expected_enum_types() -> () {
    syntax_extensions_valid(
        "enum A { Value(isize), Empty, Named { value: isize } } enum B { Value(string), Empty, Named { value: string } } fn a() -> A { Value(1) } fn b() -> B { Named { value: \"ok\" } } fn empty() -> B { Empty } type Factory = (isize) -> A; fn make() -> Factory { Value } fn nested() -> Option[Result[A, string]] { Some(Ok(Value(1))) }",
    );
    testing::assert(
        !checked_diagnostics(
            "enum A { Value(isize) } enum B { Value(isize) } fn f() -> () { let value = Value(1); }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics("enum A { Value(isize) } fn f() -> A { Missing(1) }").is_empty(),
    );
    testing::assert(
        !checked_diagnostics("enum A { Value(isize) } fn f() -> A { Value(\"bad\") }").is_empty(),
    )
}

#[test]
fn syntax_extensions_condition_chains_keep_bindings_scoped_to_success() -> () {
    syntax_extensions_valid(
        "fn f(value: Option[isize]) -> isize { let item = \"outer\"; if let Some(item) = value && item > 0 && let Some(next) = Option::Some(item + 1) { next } else { item.byte_len() } }",
    );
    testing::assert(
        !checked_diagnostics(
            "fn f(value: Option[isize]) -> isize { if let Some(item) = value && item > 0 { item } else { item } }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            "fn f(value: Option[isize]) -> () { if let Some(item) = value && item { () } }",
        ).is_empty(),
    )
}

#[test]
fn syntax_extensions_repetition_lengths_and_elements_are_checked() -> () {
    syntax_extensions_valid(
        "fn repeat[T, const N: usize](value: T) -> [T; N] { [value; N] } fn f() -> [isize; 6] { [3; 2 * 3] }",
    );
    for source in Vec::from_array(
        [
            "fn f() -> () { let value = [0; -1]; }",
            "fn f(count: isize) -> () { let value = [0; count]; }",
            "fn f() -> [isize; 2] { [0; 3] }",
            "fn f() -> [string; 2] { [0; 2] }",
        ],
    ) {
        if checked_diagnostics(source).is_empty() {
            testing::fail("accepted invalid source: " + source)
        }
    }
}

#[test]
fn syntax_extensions_opaque_returns_enforce_bounds_and_identity() -> () {
    syntax_extensions_valid(
        "trait Label { fn label(self) -> string; } struct Value {} impl Label for Value { fn label(self) -> string { \"ok\" } } fn make() -> impl Label { Value {} } fn use_value() -> string { make().label() }",
    );
    for source in Vec::from_array(
        [
            "trait Label { fn label(self) -> string; } fn make() -> impl Label { 1 }",
            "trait Label { fn label(self) -> string; } struct Value { field: isize } impl Label for Value { fn label(self) -> string { \"ok\" } } fn make() -> impl Label { Value { field: 1 } } fn leak() -> isize { make().field }",
            "trait Label { fn label(self) -> string; } struct Value {} impl Label for Value { fn label(self) -> string { \"ok\" } } fn make() -> impl Label { Value {} } fn leak() -> Value { make() }",
        ],
    ) {
        if checked_diagnostics(source).is_empty() {
            testing::fail("accepted invalid opaque return: " + source)
        }
    }
}

#[test]
fn syntax_extensions_dyn_bounds_check_all_traits() -> () {
    syntax_extensions_valid(
        "trait Consumer[T] { fn consume(self, value: T) -> T; } struct Value {} impl Consumer[isize] for Value { fn consume(self, value: isize) -> isize { value } } fn use_value() -> isize { let value = Value {} as dyn Consumer[isize]; value.consume(7) }",
    );
    for source in Vec::from_array(
        [
            "trait A { fn a(self) -> (); } trait B { fn b(self) -> (); } struct Value {} impl A for Value { fn a(self) -> () {} } fn invalid() -> dyn A + B { Value {} as dyn A + B }",
            "trait Consumer[T] { fn consume(self, value: T) -> T; } fn invalid(value: dyn Consumer) -> () {}",
            "trait A { fn method[T](self, value: T) -> T; } fn invalid(value: dyn A) -> () {}",
            "trait A { fn value(self) -> isize; } trait B { fn value(self) -> isize; } fn invalid(value: dyn A + B) -> isize { value.value() }",
        ],
    ) {
        if checked_diagnostics(source).is_empty() {
            testing::fail("accepted invalid dyn type: " + source)
        }
    }
}
