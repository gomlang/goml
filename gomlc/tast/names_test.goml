package tast;

use std::testing;

#[test]
fn short_names_preserve_unicode_and_namespace_boundaries() -> () {
    for (name, expected) in Vec::from_array(
        [
            ("", ""),
            ("Item", "Item"),
            ("pkg::nested::Item", "Item"),
            ("包::类型", "类型"),
            ("😀::值", "值"),
            ("pkg:Item", "pkg:Item"),
            ("pkg::", ""),
            ("::", ""),
            ("pkg:::Item", "Item"),
        ],
    ) {
        testing::assert_eq(short_name(name), expected)
    }
}

#[test]
fn name_matching_disambiguates_qualified_names() -> () {
    for (left, right, expected) in Vec::from_array(
        [
            ("Item", "pkg::Item", true),
            ("Item", "pkg::nested::Item", true),
            ("pkg::Item", "pkg::Item", true),
            ("left::Item", "right::Item", false),
            ("Item", "pkg::OtherItem", false),
            ("LongItem", "pkg::Item", false),
            ("类型", "包::类型", true),
            ("包::类型", "别的包::类型", false),
            ("😀", "pkg::😀", true),
            ("值", "pkg:值", false),
            ("", "pkg::", true),
            ("", "", true),
        ],
    ) {
        testing::assert_eq(names_match(left, right), expected);
        testing::assert_eq(names_match(right, left), expected)
    }
}
