package tast;

use module::ast;
use module::hir;
use module::parser;
use std::testing;

#[test]
fn go_export_accepts_scalar_arrays_aliases_unit_and_flat_returns() -> () {
    let _ = checked_file(
        "type Word = i64; #[go_export(\"Add\")] pub fn add(x: Word, y: Word) -> Word { x + y } #[go_export(\"Pair\")] pub fn pair(x: [bool; 2]) -> ([bool; 2], u64) { (x, 1) } #[go_export(\"Nothing\")] pub fn nothing() -> () {} pub fn ordinary() -> string { \"internal API\" }",
    );
    for ty in Vec::from_array(
        [
            Type::Bool,
            Type::Int,
            Type::Int8,
            Type::Int16,
            Type::Int32,
            Type::Int64,
            Type::Uint,
            Type::Uint8,
            Type::Uint16,
            Type::Uint32,
            Type::Uint64,
            Type::Float32,
            Type::Float64,
        ],
    ) {
        testing::assert(go_export_value_type(ty));
        testing::assert(go_export_value_type(Type::Array { len: 2, elem: ty }));
    }
}

#[test]
fn go_export_rejects_invalid_names_and_declarations() -> () {
    for name in Vec::from_array(["", "lower", "1Name", "A-B", "Écho"]) {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics("#[go_export(\"" + name + "\")] pub fn f() -> () {}"),
                "go_export name must start",
            ),
        );
    }
    let cases = Vec::from_array(
        [
            ("#[go_export] pub fn f() -> () {}", "go_export expects one"),
            ("#[go_export(\"A\", \"B\")] pub fn f() -> () {}", "go_export expects one"),
            (
                "#[go_export(\"A\")] #[go_export(\"B\")] pub fn f() -> () {}",
                "duplicate go_export attribute",
            ),
            ("#[go_export(\"A\")] fn f() -> () {}", "requires a pub function"),
            ("#[go_export(\"A\")] pub fn f[T](x: T) -> T { x }", "requires a non-generic function"),
            ("#[go_export(\"A\")] #[comptime] pub fn f() -> () {}", "cannot export comptime"),
            ("#[go_export(\"A\")] #[test] pub fn f() -> () {}", "cannot export comptime"),
            (
                "#[go_export(\"A\")] pub fn a() -> () {} #[go_export(\"A\")] pub fn b() -> () {}",
                "duplicate Go export name A",
            ),
        ],
    );
    for (source, message) in cases {
        testing::assert(has_diagnostic_containing(checked_diagnostics(source), message))
    }
}

#[test]
fn go_export_rejects_values_outside_the_export_boundary() -> () {
    for ty in Vec::from_array(
        [
            "string",
            "char",
            "Slice[i64]",
            "Vec[i64]",
            "(i64, i64)",
            "(i64) -> i64",
            "()",
            "[string; 2]",
        ],
    ) {
        testing::assert(
            has_diagnostic_containing(
                checked_diagnostics(
                    "#[go_export(\"Identity\")] pub fn identity(x: " + ty + ") -> " + ty + " { x }",
                ),
                "unsupported go_export parameter type",
            ),
        );
    }
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics(
                "#[go_export(\"Nested\")] pub fn nested() -> ((i64, i64), i64) { ((1, 2), 3) }",
            ),
            "unsupported go_export return type",
        ),
    );
    testing::assert(
        has_diagnostic_containing(
            checked_diagnostics("#[go_export(\"UnitPair\")] pub fn pair() -> ((), i64) { ((), 1) }"),
            "unsupported go_export return type",
        ),
    );
}

#[test]
fn go_export_names_are_unique_across_package_files() -> () {
    let files = Vec::from_array(
        [
            hir::lower(
                ast::lower(
                    parser::parse(
                        "package calc; #[go_export(\"Shared\")] pub fn first() -> i64 { 1 }",
                    ),
                ),
                "first.gom",
            ),
            hir::lower(
                ast::lower(
                    parser::parse(
                        "package calc; #[go_export(\"Shared\")] pub fn second() -> i64 { 2 }",
                    ),
                ),
                "second.gom",
            ),
        ],
    );
    let lowered: Vec[hir::File] = Vec::new();
    for file in files {
        if let Some(value) = file.hir {
            lowered.push(value)
        } else {
            testing::fail("expected HIR")
        }
    }
    let checked = check_package_files_for_link_with_dependencies(lowered, Vec::new());
    testing::assert(
        has_diagnostic_containing(checked.diagnostics, "duplicate Go export name Shared"),
    );
}

#[test]
fn exports_raw_go_strings_without_implicit_unicode_conversions() -> () {
    let raw = Type::External { import_path: "", name: "string", args: Vec::new() };
    testing::assert(go_export_value_type(raw));
    testing::assert(go_export_value_type(Type::Array { len: 2, elem: raw }));
    testing::assert(
        go_export_return_type(Type::Tuple { items: Vec::from_array([raw, Type::Bool]) }),
    );
    for value in Vec::from_array(
        [
            Type::String,
            Type::Char,
            Type::External { import_path: "", name: "string", args: Vec::from_array([Type::Int64]) },
            Type::External { import_path: "host", name: "string", args: Vec::new() },
            Type::External { import_path: "", name: "error", args: Vec::new() },
        ],
    ) {
        testing::assert(!go_export_value_type(value));
        testing::assert(!go_export_return_type(value));
    }
}
