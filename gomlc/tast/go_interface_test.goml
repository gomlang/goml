package tast;

use module::ast;
use module::ffi;
use std::testing;

fn interface_reader_spec() -> ast::GoInterfaceSpec {
    ast::GoInterfaceSpec {
        span: ast::Span { start: 0, end: 1 },
        raw_type: "RawReader",
        wrapper_name: "ReaderAdapter",
        methods: Vec::from_array([("read", "Read")]),
    }
}

fn interface_reader_shape() -> ffi::GoInterfaceShape {
    ffi::GoInterfaceShape {
        template: ffi::GoTypeTemplate {
            identity: ffi::GoTypeIdentity::Named {
                import_path: "io",
                name: "Reader",
                arguments: Vec::new(),
            },
            parameter_constraints: Vec::new(),
            declaration_kind: "defined",
            underlying_kind: "interface",
        },
        methods: Vec::from_array(
            [
                ffi::GoInterfaceMethod {
                    name: "Read",
                    import_path: "io",
                    signature: ffi::GoTypeIdentity::Function {
                        parameters: Vec::from_array(
                            [ffi::GoTypeIdentity::Slice(ffi::GoTypeIdentity::Basic("uint8"))],
                        ),
                        results: Vec::from_array(
                            [
                                ffi::GoTypeIdentity::Basic("int"),
                                ffi::GoTypeIdentity::Named {
                                    import_path: "",
                                    name: "error",
                                    arguments: Vec::new(),
                                },
                            ],
                        ),
                    },
                },
            ],
        ),
    }
}

fn interface_reader_trait(parameter: Type, result: Type) -> TraitInfo {
    TraitInfo {
        name: "sample::Reader",
        generics: Vec::new(),
        predicates: Vec::new(),
        supertraits: Vec::new(),
        associated_types: Vec::new(),
        methods: Vec::from_array(
            [
                TraitMethodInfo {
                    name: "read",
                    has_receiver: true,
                    generics: Vec::new(),
                    predicates: Vec::new(),
                    params: Vec::from_array([Type::Param { name: "Self" }, parameter]),
                    ret_ty: result,
                    default_name: Option::None,
                    default_map_requirements: Vec::new(),
                },
            ],
        ),
    }
}

fn interface_reader_result() -> Type {
    Type::Tuple {
        items: Vec::from_array(
            [Type::Int, Type::External { import_path: "", name: "error", args: Vec::new() }],
        ),
    }
}

#[test]
fn go_interface_plan_preserves_raw_buffer_partial_result_and_error_types() -> () {
    let parameter = Type::MutSlice { elem: Type::Uint8 };
    let Ok(plan) = plan_go_interface_adapter(
        interface_reader_spec(),
        interface_reader_trait(parameter, interface_reader_result()),
        interface_reader_shape(),
    ) else {
        testing::fail("expected complete native interface plan");
        return
    };
    testing::assert_eq(plan.methods.len(), 1);
    testing::assert_eq(plan.methods[0].go_name, "Read");
    testing::assert(types_equal(plan.methods[0].parameters[0], parameter));
    testing::assert(types_equal(plan.methods[0].ret_ty, interface_reader_result()));
    testing::assert(
        types_equal(
            plan.raw_type,
            Type::External { import_path: "io", name: "Reader", args: Vec::new() },
        ),
    );
}

#[test]
fn go_interface_plan_rejects_implicit_boundary_conversions_and_result_loss() -> () {
    for parameter in Vec::from_array(
        [
            Type::Slice { elem: Type::Uint8 },
            Type::String,
            Type::Char,
            Type::GoPointer { elem: Type::String },
            Type::MutSlice { elem: Type::Int8 },
            Type::Param { name: "Self" },
        ],
    ) {
        testing::assert(
            plan_go_interface_adapter(
                interface_reader_spec(),
                interface_reader_trait(parameter, interface_reader_result()),
                interface_reader_shape(),
            ).is_err(),
        );
    }
    let parameter = Type::MutSlice { elem: Type::Uint8 };
    for result in Vec::from_array(
        [Type::Unit, Type::Int, Type::External { import_path: "", name: "error", args: Vec::new() }],
    ) {
        testing::assert(
            plan_go_interface_adapter(
                interface_reader_spec(),
                interface_reader_trait(parameter, result),
                interface_reader_shape(),
            ).is_err(),
        );
    }
    let spec = interface_reader_spec();
    spec.methods.clear();
    testing::assert(
        plan_go_interface_adapter(
            spec,
            interface_reader_trait(parameter, interface_reader_result()),
            interface_reader_shape(),
        ).is_err(),
    );
}

#[test]
fn go_interface_bridge_shape_requires_exact_target_and_complete_methods() -> () {
    let signature = Type::Func {
        params: Vec::from_array([Type::MutSlice { elem: Type::Uint8 }]),
        ret_ty: interface_reader_result(),
    };
    let target = Type::External { import_path: "io", name: "Reader", args: Vec::new() };
    let constructor = Type::Func { params: Vec::from_array([signature]), ret_ty: target };
    let methods = Vec::from_array(["Read"]);
    testing::assert(
        validate_go_interface_bridge_shape(methods, constructor, interface_reader_shape()).is_ok(),
    );
    testing::assert(
        validate_go_interface_bridge_shape(
            Vec::from_array(["Write"]),
            constructor,
            interface_reader_shape(),
        ).is_err(),
    );
    testing::assert(
        validate_go_interface_bridge_shape(
            Vec::new(),
            Type::Func { params: Vec::new(), ret_ty: target },
            interface_reader_shape(),
        ).is_err(),
    );
    testing::assert(
        validate_go_interface_bridge_shape(
            methods,
            Type::Func {
                params: Vec::from_array([signature]),
                ret_ty: Type::External { import_path: "io", name: "Writer", args: Vec::new() },
            },
            interface_reader_shape(),
        ).is_err(),
    );
    let shape = interface_reader_shape();
    shape.methods.push(shape.methods[0]);
    testing::assert(validate_go_interface_bridge_shape(methods, constructor, shape).is_err());
    for result in Vec::from_array([Type::Unit, Type::Int]) {
        testing::assert(
            validate_go_interface_bridge_shape(
                methods,
                Type::Func {
                    params: Vec::from_array(
                        [
                            Type::Func {
                                params: Vec::from_array([Type::MutSlice { elem: Type::Uint8 }]),
                                ret_ty: result,
                            },
                        ],
                    ),
                    ret_ty: target,
                },
                interface_reader_shape(),
            ).is_err(),
        );
    }
}
