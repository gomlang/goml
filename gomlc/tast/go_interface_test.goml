package tast;

use module::ast;
use module::expand;
use module::hir;
use module::parser;
use std::testing;

fn interface_reader_raw_type() -> Type {
    External { import_path: "io", name: "Reader", args: Vec::new() }
}

fn interface_reader_result() -> Type {
    Type::Tuple {
        items: Vec::from_array(
            [Type::Int, Type::External { import_path: "", name: "error", args: Vec::new() }],
        ),
    }
}

#[test]
fn go_interface_bridge_callable_requires_consistent_explicit_method_plan() -> () {
    let signature = Type::Func {
        params: Vec::from_array([Type::MutSlice { elem: Type::Uint8 }]),
        ret_ty: interface_reader_result(),
    };
    let target = interface_reader_raw_type();
    let constructor = Type::Func { params: Vec::from_array([signature]), ret_ty: target };
    testing::assert(
        validate_go_interface_bridge_callable(Vec::from_array(["Read"]), constructor).is_ok(),
    );
    testing::assert(
        validate_go_interface_bridge_callable(Vec::from_array(["Write"]), constructor).is_ok(),
    );
    testing::assert(
        validate_go_interface_bridge_callable(
            Vec::new(),
            Func { params: Vec::new(), ret_ty: target },
        ).is_ok(),
    );
    testing::assert(validate_go_interface_bridge_callable(Vec::new(), constructor).is_err());
    testing::assert(
        validate_go_interface_bridge_callable(
            Vec::from_array(["Read", "Read"]),
            Func { params: Vec::from_array([signature, signature]), ret_ty: target },
        ).is_err(),
    );
    testing::assert(
        validate_go_interface_bridge_callable(
            Vec::from_array(["Read"]),
            Func { params: Vec::from_array([Type::Int]), ret_ty: target },
        ).is_err(),
    );
}

fn checked_go_interface_sources(package_name: string, sources: Vec[(string, string)]) -> CheckResult {
    let inputs = Vec::new();
    for source in sources {
        inputs.push((expand::expand_go_interfaces(ast::lower(parser::parse(source.1))), source.0));
    }
    let files = Vec::new();
    for lowered in hir::lower_expanded_package_files(inputs, package_name) {
        testing::assert(lowered.diagnostics.is_empty());
        if let Some(file) = lowered.hir {
            files.push(file);
        }
    }
    check_package_files_for_link_with_environments(files, Vec::new())
}

fn go_interface_source_declaration() -> string {
    "#[go_type(\"io\", \"Reader\")] extern type Raw; #[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self) -> (); } "
}

#[test]
fn interface_expansion_rejects_unsupported_trait_and_method_constraints() -> () {
    for entry in Vec::from_array(
        [
            ("#[go_interface(Raw, Wrapped)] trait Reader[T] {}", "non-generic trait"),
            ("#[go_interface(Raw, Wrapped)] trait Reader: Parent {}", "non-generic trait"),
            (
                "#[go_interface(Raw, Wrapped)] trait Reader where Self: Parent {}",
                "non-generic trait",
            ),
            ("#[go_interface(Raw, Wrapped)] trait Reader { type Item; }", "non-generic trait"),
            (
                "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read[T](self: Self, value: T) -> (); }",
                "non-generic instance methods",
            ),
            (
                "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self) -> () where Self: Parent; }",
                "non-generic instance methods",
            ),
            (
                "#[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(value: i64) -> (); }",
                "non-generic instance methods",
            ),
            (
                "#[go_interface(Raw, Wrapped)] trait Reader { fn read(self: Self) -> (); }",
                "mapping for every trait method",
            ),
            (
                "#[go_interface(Raw, Wrapped, other = \"Read\")] trait Reader { fn read(self: Self) -> (); }",
                "omitted trait method read",
            ),
        ],
    ) {
        let lowered = ast::lower(parser::parse(entry.0));
        testing::assert(lowered.diagnostics.is_empty());
        let expanded = expand::expand_go_interfaces(lowered);
        let mut found = false;
        for diagnostic in expanded.diagnostics {
            if diagnostic.message.contains(entry.1) {
                found = true;
            }
        }
        testing::assert(found);
    }
}

#[test]
fn shared_interface_check_rejects_implicit_boundaries_and_invalid_raw_targets() -> () {
    for entry in Vec::from_array(
        [
            ("string", "text boundaries"),
            ("Slice[u8]", "slice boundaries"),
            ("Text", "text boundaries"),
        ],
    ) {
        let source = "type Text = string; #[go_type(\"io\", \"Reader\")] extern type Raw; #[go_interface(Raw, Wrapped, read = \"Read\")] trait Reader { fn read(self: Self, value: "
            + entry.0
            + ") -> (); }";
        let result = checked_go_interface_sources(
            "sample::reader",
            Vec::from_array([("reader.goml", source)]),
        );
        let mut found = false;
        for diagnostic in result.diagnostics {
            if diagnostic.message.contains(entry.1) {
                found = true;
                testing::assert_eq(diagnostic.source_path, "reader.goml");
                testing::assert(diagnostic.span.is_some());
            }
        }
        testing::assert(found);
    }
    let result = checked_go_interface_sources(
        "main",
        Vec::from_array(
            [("main.goml", "type Raw = i64; #[go_interface(Raw, Wrapped)] trait Reader {}")],
        ),
    );
    testing::assert(
        has_diagnostic_containing(result.diagnostics, "requires a native interface target"),
    );
}

#[test]
fn shared_interface_check_rejects_reserved_members_across_files_and_aliases() -> () {
    for method in Vec::from_array(
        [
            "fn from_go(raw: Raw) -> Wrapped { Wrapped { raw } }",
            "fn into_go(self: Wrapped) -> Raw { self.raw }",
            "fn from_trait(value: dyn Reader) -> Wrapped { loop {} }",
            "fn read(self: Wrapped) -> () {}",
        ],
    ) {
        let result = checked_go_interface_sources(
            "main",
            Vec::from_array(
                [
                    (
                        "main.goml",
                        go_interface_source_declaration() + "impl Wrapped { " + method + " }",
                    ),
                ],
            ),
        );
        testing::assert(has_diagnostic_containing(result.diagnostics, "generated member collides"));
    }
    let result = checked_go_interface_sources(
        "sample::reader",
        Vec::from_array(
            [
                ("reader.goml", go_interface_source_declaration()),
                (
                    "extension.goml",
                    "type Alias = Wrapped; impl Alias { fn into_go(self: Alias) -> Raw { self.raw } }",
                ),
            ],
        ),
    );
    let mut found = false;
    for diagnostic in result.diagnostics {
        if diagnostic.message.contains("generated member collides") {
            found = true;
            testing::assert_eq(diagnostic.source_path, "extension.goml");
            testing::assert(diagnostic.span.is_some());
        }
    }
    testing::assert(found);
}

#[test]
fn shared_interface_check_accepts_generated_members_and_unrelated_extensions() -> () {
    for package_name in Vec::from_array(["main", "sample::reader"]) {
        let result = checked_go_interface_sources(
            package_name,
            Vec::from_array(
                [
                    ("reader.goml", go_interface_source_declaration()),
                    (
                        "extension.goml",
                        "impl Wrapped { fn raw_value(self: Wrapped) -> Raw { self.raw } }",
                    ),
                ],
            ),
        );
        testing::assert(!diagnostics_have_errors(result.diagnostics));
    }
}
