package tast;

use module::ctir;

fn lower_ct_closure(ctx: CtLowerContext, params: Vec[ClosureParam], body: Expr) -> Result[
    ctir::CtExprKind,
    string,
] {
    let local_start = ctx.next_slot.get();
    let locals = Vec::new();
    for local in ctx.locals {
        locals.push(local)
    }
    let inner = CtLowerContext { locals, loop_targets: Vec::new(), ..ctx };
    let parameters = Vec::new();
    let base = inner.locals.len();
    for param in params {
        parameters.push(bind_pattern_slot(inner, param.name, param.ty, base)?)
    }
    Result::Ok(
        ctir::CtExprKind::Closure { parameters, local_start, body: lower_ct_expr(inner, body)? },
    )
}

fn lower_ct_function_value(ctx: CtLowerContext, callable: Callable, ty: Type) -> Result[
    ctir::CtExprKind,
    string,
] {
    let Callable::Function(name) = callable else {
        return Result::Err("only comptime functions can be used as compile-time function values")
    };
    let Some(target) = function_call_target(ctx, name) else {
        return Result::Err("comptime function value refers to runtime-only function `" + name + "`")
    };
    let Type::Func { params, ret_ty } = resolve_type(ty) else {
        return Result::Err("comptime callable requires a function type")
    };
    let local_start = ctx.next_slot.get();
    let parameters = Vec::new();
    let args = Vec::new();
    for param in params {
        let slot = ctx.next_slot.get();
        ctx.next_slot.set(slot + 1);
        let ty = lower_ct_type(ctx, param)?;
        ctx.local_types.push(ty);
        parameters.push(slot);
        args.push(ctir::CtExpr { kind: ctir::CtExprKind::Local(slot), ty, origin: ctx.origin });
    }
    Result::Ok(
        ctir::CtExprKind::Closure {
            parameters,
            local_start,
            body: ctir::CtExpr {
                kind: ctir::CtExprKind::Call { target, args },
                ty: lower_ct_type(ctx, ret_ty)?,
                origin: ctx.origin,
            },
        },
    )
}
