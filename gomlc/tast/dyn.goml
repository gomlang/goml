package tast;

pub fn dyn_bounds(value: Type) -> Vec[DynTraitBound] {
    let result: Vec[DynTraitBound] = Vec::new();
    if let Dyn { trait_name, args, associated_types, additional_bounds } = prune(value) {
        result.push(DynTraitBound { trait_name, args, associated_types });
        for bound in additional_bounds {
            result.push(bound)
        }
    }
    result
}
