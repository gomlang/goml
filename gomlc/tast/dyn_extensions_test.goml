package tast;

use std::testing;

#[test]
fn dyn_extensions_inherited_generic_dispatch_and_bound_order() -> () {
    syntax_extensions_valid(
        "trait Parent[T] { fn get(self) -> T; } trait Child[T]: Parent[T] {} fn inherited(value: dyn Child[string]) -> string { value.get() } fn qualified(value: dyn Child[string]) -> string { Parent::[string]::get(value) } trait A { fn a(self) -> (); } trait B { fn b(self) -> (); } fn reorder(value: dyn B + A) -> dyn A + B { value }",
    )
}

#[test]
fn dyn_extensions_associated_bindings_are_trait_qualified() -> () {
    syntax_extensions_valid(
        "trait A { type Item; fn value(self) -> Self::Item; } trait B { type Item; fn value(self) -> Self::Item; } trait Family: A + B {} fn a(value: dyn Family + A[Item = isize] + B[Item = string]) -> isize { A::value(value) } fn b(value: dyn B[Item = string] + A[Item = isize]) -> string { B::value(value) } trait Parent { type Item; fn get(self) -> Self::Item; } trait Child: Parent { type Other; fn other(self) -> Self::Other; } fn inherited(value: dyn Child[Item = string, Other = isize]) -> string { value.get() }",
    )
}

#[test]
fn dyn_extensions_reject_conflicting_and_unsatisfied_bounds() -> () {
    for source in Vec::from_array(
        [
            "trait A[T] {} fn bad(value: dyn A[isize] + A[string]) -> () {}",
            "trait A[T] {} trait B: A[isize] {} trait C: A[string] {} fn bad(value: dyn B + C) -> () {}",
            "trait A { type Item; } fn bad(value: dyn A[Item = isize, Item = isize]) -> () {}",
            "trait A { type Item; } trait B { type Item; } trait C: A + B {} fn bad(value: dyn C[Item = isize]) -> () {}",
            "trait A { type Item; } trait B: A {} fn bad(value: dyn B) -> () {}",
            "trait A { type Item; } trait B: A {} fn bad(value: dyn B[Unknown = isize]) -> () {}",
            "trait Marker {} trait A[T: Marker] {} fn bad(value: dyn A[isize]) -> () {}",
            "trait Marker {} trait A { type Item: Marker; } fn bad(value: dyn A[Item = isize]) -> () {}",
            "trait A { type Item; } trait B: A {} fn bad(value: dyn B[Item = isize] + A[Item = string]) -> () {}",
        ],
    ) {
        if checked_diagnostics(source).is_empty() {
            testing::fail("accepted invalid dyn bounds: " + source)
        }
    }
}

#[test]
fn dyn_extensions_numeric_literals_infer_all_object_bounds() -> () {
    syntax_extensions_valid("fn builtin() -> dyn ToString { 1000 as dyn ToString }");
    syntax_extensions_valid(
        "trait Printable { fn text(self) -> string; } impl Printable for i32 { fn text(self) -> string { self.to_string() } } impl Printable for bool { fn text(self) -> string { self.to_string() } } fn single() -> dyn Printable { 42 as dyn Printable }",
    );
    syntax_extensions_valid(
        "trait Consumer[T] { fn consume(self, value: T) -> (); } impl Consumer[string] for i32 { fn consume(self, value: string) -> () {} } impl Consumer[isize] for i64 { fn consume(self, value: isize) -> () {} } fn generic() -> dyn Consumer[isize] { 42 as dyn Consumer[isize] }",
    );
    syntax_extensions_valid(
        "trait A { fn a(self) -> (); } trait B { fn b(self) -> (); } impl A for i32 { fn a(self) -> () {} } impl A for i64 { fn a(self) -> () {} } impl B for i64 { fn b(self) -> () {} } fn composite() -> dyn A + B { 42 as dyn B + A }",
    );
    syntax_extensions_valid(
        "trait Source { type Item; fn get(self) -> Self::Item; } impl Source for i32 { type Item = string; fn get(self) -> string { self.to_string() } } impl Source for i64 { type Item = bool; fn get(self) -> bool { true } } fn associated() -> dyn Source[Item = bool] { 42 as dyn Source[Item = bool] }",
    )
}
