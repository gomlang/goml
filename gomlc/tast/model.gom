package tast;

use module::ast;
use module::ctir;
use module::ffi;

pub enum VarKind {
    Any,
    Integer,
    Float,
}

pub enum TypeVar {
    Unbound {
        id: isize,
        kind: VarKind,
    },
    Link(Type),
}

pub enum Type {
    Var(Ref[TypeVar]),
    Unit,
    Never,
    Bool,
    Int,
    Int8,
    Int16,
    Int32,
    Int64,
    Uint,
    Uint8,
    Uint16,
    Uint32,
    Uint64,
    Float32,
    Float64,
    String,
    Char,
    External {
        import_path: string,
        name: string,
        args: Vec[Type],
    },
    Tuple {
        items: Vec[Type],
    },
    Con {
        name: string,
    },
    Dyn {
        trait_name: string,
        args: Vec[Type],
        associated_types: Vec[(string, Type)],
        additional_bounds: Vec[DynTraitBound],
    },
    Projection {
        for_ty: Type,
        name: string,
        trait_ref: Option[TraitRef],
    },
    App {
        ty: Type,
        args: Vec[Type],
    },
    Array {
        len: isize,
        elem: Type,
    },
    Slice {
        elem: Type,
    },
    MutSlice {
        elem: Type,
    },
    VecType {
        elem: Type,
    },
    GoFunction {
        signature: Type,
    },
    GoPointer {
        elem: Type,
    },
    RefType {
        elem: Type,
    },
    GoMap {
        key: Type,
        value: Type,
    },
    HashMap {
        key: Type,
        value: Type,
    },
    Channel {
        elem: Type,
        direction: ast::ChannelDirection,
    },
    Param {
        name: string,
    },
    Func {
        params: Vec[Type],
        ret_ty: Type,
    },
    Error,
}

pub struct DynTraitBound {
    pub trait_name: string,
    pub args: Vec[Type],
    pub associated_types: Vec[(string, Type)],
}

pub struct TraitRef {
    pub name: string,
    pub args: Vec[Type],
}

pub enum Primitive {
    Unit,
    Bool { value: bool },
    Int { value: string },
    Int8 { value: string },
    Int16 { value: string },
    Int32 { value: string },
    Int64 { value: string },
    Uint { value: string },
    Uint8 { value: string },
    Uint16 { value: string },
    Uint32 { value: string },
    Uint64 { value: string },
    Float { value: string },
    Float32 { value: string },
    Float64 { value: string },
    String { value: string },
    Char { value: char },
    Bytes { values: Vec[string] },
}

pub enum ConstExpr {
    Prim {
        value: Primitive,
        ty: Type,
    },
    Ref {
        name: string,
        ty: Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: ConstExpr,
        ty: Type,
    },
    Cast {
        expr: ConstExpr,
        ty: Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: ConstExpr,
        rhs: ConstExpr,
        ty: Type,
    },
    Tuple {
        items: Vec[ConstExpr],
        ty: Type,
    },
    Array {
        items: Vec[ConstExpr],
        ty: Type,
    },
    Constr {
        constructor: Constructor,
        args: Vec[ConstExpr],
        ty: Type,
    },
    Error {
        ty: Type,
    },
}

pub struct Constant {
    pub name: string,
    pub ty: Type,
    pub value: ConstExpr,
}

pub struct Static {
    pub name: string,
    pub ty: Type,
}

pub struct PendingConstant {
    pub name: string,
    pub ty: Type,
    pub value: Expr,
    pub source_path: string,
    pub start: isize,
    pub end: isize,
    pub comptime_origins: Vec[ast::Span],
}

pub struct Constructor {
    pub name: string,
    pub fields: Vec[string],
    pub is_struct: bool,
    pub tag: Option[isize],
}

pub enum Callable {
    GoInterfaceBridge {
        binding: string,
        methods: Vec[string],
    },
    Function(string),
    FunctionInstance {
        name: string,
        bindings: Vec[(string, Type)],
    },
    LangItem {
        item: string,
        function_name: string,
    },
    Runtime(string),
    Intrinsic(string),
    GoMethod {
        binding: string,
        symbol: string,
    },
    GoForeign {
        binding: string,
        import_path: string,
        symbol: string,
    },
    TraitMethod {
        trait_ref: TraitRef,
        method_name: string,
        for_ty: Type,
        has_receiver: bool,
    },
    DynTraitMethod {
        trait_name: string,
        dispatch_name: string,
        method_name: string,
    },
    InherentMethod {
        receiver_ty: Type,
        method_name: string,
    },
}

pub enum BinaryResolution {
    Builtin,
    Overloaded { trait_name: string },
}

pub struct ClosureParam {
    pub name: string,
    pub ty: Type,
}

pub enum ComptimeCapability {
    RuntimeOnly,
    Capable,
    Derive,
}

pub enum SelectArm {
    Receive {
        channel: Expr,
        guard: Option[Expr],
        binding: string,
        binding_ty: Type,
        body: Expr,
    },
    Send {
        channel: Expr,
        value: Expr,
        guard: Option[Expr],
        body: Expr,
    },
    Default {
        body: Expr,
    },
}

pub enum Expr {
    Var {
        name: string,
        ty: Type,
    },
    Callable {
        callable: Callable,
        ty: Type,
    },
    Prim {
        value: Primitive,
        ty: Type,
    },
    Constr {
        constructor: Constructor,
        args: Vec[Expr],
        ty: Type,
    },
    Tuple {
        items: Vec[Expr],
        ty: Type,
    },
    Array {
        items: Vec[Expr],
        ty: Type,
    },
    Closure {
        params: Vec[ClosureParam],
        body: Expr,
        ty: Type,
    },
    Block {
        block: Block,
        ty: Type,
    },
    Comptime {
        site_id: isize,
        source_path: string,
        start: isize,
        end: isize,
        origins: Vec[ast::Span],
        body: Expr,
        ty: Type,
    },
    Match {
        expr: Expr,
        arms: Vec[Arm],
        coverage: Option[MatchCoverageInfo],
        ty: Type,
    },
    Select {
        mode: ast::SelectMode,
        arms: Vec[SelectArm],
        ty: Type,
    },
    If {
        cond: Expr,
        then_branch: Expr,
        else_branch: Expr,
        ty: Type,
    },
    While {
        cond: Expr,
        body: Expr,
        ty: Type,
    },
    Loop {
        body: Expr,
        ty: Type,
    },
    For {
        pat: Pat,
        iterator: Expr,
        into_iter_trait_ref: TraitRef,
        iterator_trait_ref: TraitRef,
        iterator_ty: Type,
        body: Expr,
        ty: Type,
    },
    Break {
        target: isize,
        value: Option[Expr],
        ty: Type,
    },
    Continue {
        target: isize,
        ty: Type,
    },
    Return {
        expr: Option[Expr],
        ty: Type,
    },
    Go {
        expr: Expr,
        ty: Type,
    },
    Call {
        func: Expr,
        args: Vec[Expr],
        ty: Type,
    },
    Unary {
        op: ast::UnaryOp,
        expr: Expr,
        ty: Type,
    },
    Cast {
        expr: Expr,
        ty: Type,
    },
    Proj {
        tuple: Expr,
        index: isize,
        ty: Type,
    },
    Field {
        expr: Expr,
        field_name: string,
        ty: Type,
    },
    Index {
        base: Expr,
        index: Expr,
        ty: Type,
    },
    Binary {
        op: ast::BinaryOp,
        lhs: Expr,
        rhs: Expr,
        ty: Type,
        resolution: BinaryResolution,
    },
    ToDyn {
        trait_name: string,
        for_ty: Type,
        expr: Expr,
        ty: Type,
    },
}

pub struct Block {
    pub stmts: Vec[Stmt],
    pub tail: Option[Expr],
}

pub enum Stmt {
    Defer {
        expr: Expr,
    },
    Let {
        is_mut: bool,
        pat: Pat,
        value: Expr,
    },
    LetElse {
        is_mut: bool,
        pat: Pat,
        value: Expr,
        else_branch: Expr,
    },
    Assign {
        target: Expr,
        op: ast::AssignmentOp,
        value: Expr,
    },
    Expr {
        expr: Expr,
    },
}

pub struct Arm {
    pub pat: Pat,
    pub guard: Option[Expr],
    pub body: Expr,
}

pub struct MatchCoverageInfo {
    pub source_path: string,
    pub span: Option[ast::Span],
    pub pattern_spans: Vec[ast::Span],
    pub invalid_pattern_arms: Vec[bool],
    pub invalid_patterns: bool,
}

pub struct ArrayPatRest {
    pub binding: Option[string],
    pub ty: Type,
}

pub enum Pat {
    Var {
        name: string,
        is_mut: bool,
        ty: Type,
    },
    Constant {
        name: string,
        ty: Type,
    },
    Prim {
        value: Primitive,
        ty: Type,
    },
    Constr {
        constructor: Constructor,
        args: Vec[Pat],
        ty: Type,
    },
    Tuple {
        items: Vec[Pat],
        ty: Type,
    },
    Array {
        prefix: Vec[Pat],
        rest: Option[ArrayPatRest],
        suffix: Vec[Pat],
        ty: Type,
    },
    Alias {
        name: string,
        pat: Pat,
        ty: Type,
    },
    Or {
        pats: Vec[Pat],
        ty: Type,
    },
    Range {
        start: Primitive,
        end: Primitive,
        inclusive: bool,
        ty: Type,
    },
    Wild {
        ty: Type,
    },
}

pub struct Function {
    pub name_span: ast::Span,
    pub visibility: ast::Visibility,
    pub name: string,
    pub comptime: ComptimeCapability,
    pub derive_export_name: Option[string],
    pub source_path: string,
    pub start: isize,
    pub end: isize,
    pub comptime_origins: Vec[ast::Span],
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub params: Vec[(string, Type)],
    pub ret_ty: Type,
    pub body: Block,
}

pub struct ImplBlock {
    pub generics: Vec[string],
    pub predicates: Vec[TypePredicate],
    pub trait_ref: Option[TraitRef],
    pub for_type: Type,
    pub associated_types: Vec[(string, Type)],
    pub methods: Vec[Function],
}

pub enum Item {
    ImplBlock(ImplBlock),
    Function(Function),
}

pub struct EnumVariantDef {
    pub name: string,
    pub fields: EnumVariantFields,
}

pub enum EnumVariantFields {
    Unit,
    Tuple(Vec[Type]),
    Struct(Vec[(string, Type)]),
}

pub struct EnumDef {
    pub map_requirements: Vec[Type],
    pub name: string,
    pub generics: Vec[string],
    pub variants: Vec[EnumVariantDef],
    pub option_variants: Option[(string, string)],
}

pub struct StructDef {
    pub map_requirements: Vec[Type],
    pub name: string,
    pub generics: Vec[string],
    pub fields: Vec[(string, Type)],
    pub public_fields: Vec[string],
    pub has_hidden_fields: bool,
    pub go_comparable: Option[ffi::GoComparability],
}

pub struct File {
    pub items: Vec[Item],
    pub enums: Vec[EnumDef],
    pub structs: Vec[StructDef],
    pub constants: Vec[Constant],
    pub statics: Vec[Static],
}

pub struct DiagnosticLabel {
    pub message: string,
    pub source_path: string,
    pub span: ast::Span,
}

pub enum DiagnosticSeverity {
    Error,
    Warning,
}

pub struct Diagnostic {
    pub severity: DiagnosticSeverity,
    pub stage: string,
    pub message: string,
    pub source_path: string,
    pub span: Option[ast::Span],
    pub primary_label: Option[string],
    pub secondary_labels: Vec[DiagnosticLabel],
    pub sort_order: isize,
}

pub struct CheckResult {
    pub tast: Option[File],
    pub comptime: ctir::CtModule,
    pub pending_constants: Vec[PendingConstant],
    pub diagnostics: Vec[Diagnostic],
    pub typeck_results: TypeckResults,
}

pub fn diagnostic_message(value: Diagnostic) -> string {
    value.message
}

pub fn diagnostics_have_errors(values: Vec[Diagnostic]) -> bool {
    for value in values {
        match value.severity {
            Error => return true,
            Warning => (),
        }
    }
    false
}

pub fn expr_type(value: Expr) -> Type {
    match value {
        Var { ty, .. } | Callable { ty, .. } | Prim { ty, .. } | Constr { ty, .. } | Tuple {
            ty,
            ..,
        } | Array { ty, .. } | Closure { ty, .. } | Block { ty, .. } | Comptime { ty, .. } | Match {
            ty,
            ..,
        } | Select { ty, .. } | If { ty, .. } | While { ty, .. } | Loop { ty, .. } | For { ty, .. } | Break {
            ty,
            ..,
        } | Continue { ty, .. } | Return { ty, .. } | Go { ty, .. } | Call { ty, .. } | Unary {
            ty,
            ..,
        } | Cast { ty, .. } | Proj { ty, .. } | Field { ty, .. } | Index { ty, .. } | Binary {
            ty,
            ..,
        } | ToDyn { ty, .. } => ty,
    }
}

pub fn pat_type(value: Pat) -> Type {
    match value {
        Var { ty, .. } | Constant { ty, .. } | Prim { ty, .. } | Constr { ty, .. } | Tuple {
            ty,
            ..,
        } | Array { ty, .. } | Alias { ty, .. } | Or { ty, .. } | Range { ty, .. } | Wild { ty } => ty,
    }
}
