package tast;

use module::ast;
use module::ctir;
use module::hir;
use std::collections;
use std::text;

fn function_context(
    base: Checker,
    ret_ty: Type,
    self_ty: Option[Type],
    type_params: Vec[string],
    predicates: Vec[TypePredicate],
    allow_unstructured_go: bool,
    allow_unreachable_code: bool,
    comptime: ComptimeCapability,
) -> Checker {
    let predicates = expand_implied_predicates(base, predicates);
    let param_aliases = predicate_type_aliases(predicates);
    let projection_aliases = predicate_projection_aliases(predicates);
    Checker {
        current_function: base.current_function,
        builtin: base.builtin,
        counter: base.counter,
        diagnostics: base.diagnostics,
        typeck_results: base.typeck_results,
        package_name: base.package_name,
        source_path: base.source_path,
        current_span: base.current_span,
        coercion_constraints: Vec::new(),
        numeric_literal_constraints: Vec::new(),
        defer_coercion_depth: Ref::new(0),
        package_aliases: base.package_aliases,
        symbol_aliases: base.symbol_aliases,
        imported_items: base.imported_items,
        in_scope_traits: base.in_scope_traits,
        enums: base.enums,
        structs: base.structs,
        type_aliases: base.type_aliases,
        constants: base.constants,
        enum_names: base.enum_names,
        enum_short_names: base.enum_short_names,
        struct_names: base.struct_names,
        struct_short_names: base.struct_short_names,
        coverage_domains: base.coverage_domains,
        coverage_inhabited: base.coverage_inhabited,
        traits: base.traits,
        functions: base.functions,
        rejected_externs: base.rejected_externs,
        methods: base.methods,
        impls: base.impls,
        impl_indices: base.impl_indices,
        invalid_impl_origins: base.invalid_impl_origins,
        invalid_impl_arity_owners: base.invalid_impl_arity_owners,
        predicates,
        param_aliases,
        projection_aliases,
        active_projections: Vec::new(),
        field_constraints: Vec::new(),
        silent_field_receivers: Vec::new(),
        required_predicates: Vec::new(),
        locals: Vec::new(),
        unresolved_locals: Vec::new(),
        unresolved_inference_vars: Vec::new(),
        reported_inference_spans: Vec::new(),
        suppress_unresolved_ref_diagnostic: Ref::new(0),
        mutable_locals: Vec::new(),
        return_ty: ret_ty,
        self_ty,
        type_params,
        loop_depth: Ref::new(0),
        loop_results: Vec::new(),
        condition_depth: Ref::new(0),
        condition_loop_depth: Ref::new(0),
        comptime_depth: Ref::new(
            match comptime {
                ComptimeCapability::Capable | ComptimeCapability::Derive => 1,
                ComptimeCapability::RuntimeOnly => 0,
            },
        ),
        comptime_capability: comptime,
        allow_unstructured_go,
        allow_unreachable_code,
    }
}

fn closure_context(base: Checker, ret_ty: Type) -> Checker {
    Checker {
        current_function: base.current_function,
        builtin: base.builtin,
        counter: base.counter,
        diagnostics: base.diagnostics,
        typeck_results: base.typeck_results,
        package_name: base.package_name,
        source_path: base.source_path,
        current_span: base.current_span,
        coercion_constraints: base.coercion_constraints,
        numeric_literal_constraints: base.numeric_literal_constraints,
        defer_coercion_depth: base.defer_coercion_depth,
        package_aliases: base.package_aliases,
        symbol_aliases: base.symbol_aliases,
        imported_items: base.imported_items,
        in_scope_traits: base.in_scope_traits,
        enums: base.enums,
        structs: base.structs,
        type_aliases: base.type_aliases,
        constants: base.constants,
        enum_names: base.enum_names,
        enum_short_names: base.enum_short_names,
        struct_names: base.struct_names,
        struct_short_names: base.struct_short_names,
        coverage_domains: base.coverage_domains,
        coverage_inhabited: base.coverage_inhabited,
        traits: base.traits,
        functions: base.functions,
        rejected_externs: base.rejected_externs,
        methods: base.methods,
        impls: base.impls,
        impl_indices: base.impl_indices,
        invalid_impl_origins: base.invalid_impl_origins,
        invalid_impl_arity_owners: base.invalid_impl_arity_owners,
        predicates: base.predicates,
        param_aliases: base.param_aliases,
        projection_aliases: base.projection_aliases,
        active_projections: base.active_projections,
        field_constraints: base.field_constraints,
        silent_field_receivers: base.silent_field_receivers,
        required_predicates: base.required_predicates,
        locals: base.locals,
        unresolved_locals: base.unresolved_locals,
        unresolved_inference_vars: base.unresolved_inference_vars,
        reported_inference_spans: base.reported_inference_spans,
        suppress_unresolved_ref_diagnostic: base.suppress_unresolved_ref_diagnostic,
        mutable_locals: base.mutable_locals,
        return_ty: ret_ty,
        self_ty: base.self_ty,
        type_params: base.type_params,
        loop_depth: Ref::new(0),
        loop_results: Vec::new(),
        condition_depth: Ref::new(0),
        condition_loop_depth: Ref::new(0),
        comptime_depth: base.comptime_depth,
        comptime_capability: base.comptime_capability,
        allow_unstructured_go: base.allow_unstructured_go,
        allow_unreachable_code: base.allow_unreachable_code,
    }
}

fn attribute_allows(attrs: Vec[ast::Attribute], lint: string) -> bool {
    for attribute in attrs {
        if attribute.name == "allow" {
            for argument in attribute.args {
                match argument {
                    ast::AttributeArg::Ident(value) => if value == lint {
                        return true
                    },
                    ast::AttributeArg::String(_) | ast::AttributeArg::Path(_) | ast::AttributeArg::Named {
                        ..,
                    } => (),
                }
            }
        }
    }
    false
}

fn deferred_method_name(value: Callable) -> Option[string] {
    match value {
        Function(name) => {
            let prefix = "__goml_deferred_method:";
            if name.byte_len() > prefix.byte_len() && name.starts_with(prefix) {
                Option::Some(name.byte_slice(prefix.byte_len(), name.byte_len()))
            } else {
                Option::None
            }
        },
        _ => Option::None,
    }
}

fn resolve_deferred_exprs(ctx: Checker, values: Vec[Expr]) -> Vec[Expr] {
    let result: Vec[Expr] = Vec::new();
    for value in values {
        result.push(resolve_deferred_expr(ctx, value))
    }
    result
}

fn resolve_deferred_block(ctx: Checker, value: Block) -> Block {
    let stmts: Vec[Stmt] = Vec::new();
    for stmt in value.stmts {
        stmts.push(
            match stmt {
                Defer { expr } => Stmt::Defer { expr: resolve_deferred_expr(ctx, expr) },
                Let { is_mut, pat, value } => Stmt::Let {
                    is_mut,
                    pat,
                    value: resolve_deferred_expr(ctx, value),
                },
                LetElse { is_mut, pat, value, else_branch } => Stmt::LetElse {
                    is_mut,
                    pat,
                    value: resolve_deferred_expr(ctx, value),
                    else_branch: resolve_deferred_expr(ctx, else_branch),
                },
                Assign { target, op, value } => Stmt::Assign {
                    target: resolve_deferred_expr(ctx, target),
                    op,
                    value: resolve_deferred_expr(ctx, value),
                },
                Expr { expr } => Stmt::Expr { expr: resolve_deferred_expr(ctx, expr) },
            },
        )
    }
    Block { stmts, tail: value.tail.map(|expr| resolve_deferred_expr(ctx, expr)) }
}

fn resolve_deferred_expr(ctx: Checker, value: Expr) -> Expr {
    match value {
        Closure { params, body, ty } => Expr::Closure {
            params,
            body: resolve_deferred_expr(ctx, body),
            ty,
        },
        Block { block, ty } => Expr::Block { block: resolve_deferred_block(ctx, block), ty },
        Call { func, args, ty } => {
            let args = resolve_deferred_exprs(ctx, args);
            let func = match func {
                Callable { callable, ty: callable_ty } => {
                    match deferred_method_name(callable) {
                        Some(name) => if !args.is_empty() {
                            let arg_types: Vec[Type] = Vec::new();
                            for index in 1..args.len() {
                                arg_types.push(expr_type(args[index]))
                            }
                            match resolve_method(
                                ctx,
                                expr_type(args[0]),
                                name,
                                arg_types,
                                Option::Some(ty),
                                Vec::new(),
                            ) {
                                Some(value) => Expr::Callable {
                                    callable: value.callable,
                                    ty: value.ty,
                                },
                                None => Expr::Callable { callable, ty: callable_ty },
                            }
                        } else {
                            Expr::Callable { callable, ty: callable_ty }
                        },
                        None => Expr::Callable { callable, ty: callable_ty },
                    }
                },
                other => resolve_deferred_expr(ctx, other),
            };
            Expr::Call { func, args, ty }
        },
        other => other,
    }
}

fn pattern_has_unresolved_inference(ctx: Checker, value: hir::Pat) -> bool {
    match value.kind {
        Var { name, is_mut: _ } => match find_local(ctx, name) {
            Some(ty) => contains_unresolved_inference(ctx, ty),
            None => false,
        },
        Constr { head: _, args } | Tuple { items: args } | Or { pats: args } => {
            for arg in args {
                if pattern_has_unresolved_inference(ctx, arg) {
                    return true
                }
            }
            false
        },
        Struct { head: _, fields, has_rest: _ } => {
            for field in fields {
                if pattern_has_unresolved_inference(ctx, field.1) {
                    return true
                }
            }
            false
        },
        Array { prefix, rest: _, suffix } => {
            for arg in prefix {
                if pattern_has_unresolved_inference(ctx, arg) {
                    return true
                }
            }
            for arg in suffix {
                if pattern_has_unresolved_inference(ctx, arg) {
                    return true
                }
            }
            false
        },
        Alias { name, pat } => {
            let alias_unresolved = match find_local(ctx, name) {
                Some(ty) => contains_unresolved_inference(ctx, ty),
                None => false,
            };
            alias_unresolved || pattern_has_unresolved_inference(ctx, pat)
        },
        Range { start, end, inclusive: _ } => {
            pattern_has_unresolved_inference(ctx, start)
                || pattern_has_unresolved_inference(ctx, end)
        },
        _ => false,
    }
}

fn report_unresolved_exprs(ctx: Checker, values: Vec[hir::Expr], report_all: bool) -> () {
    for value in values {
        report_unresolved_expr(ctx, value, report_all)
    }
}

fn report_unresolved_block(ctx: Checker, value: hir::Block, report_all: bool) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => report_unresolved_expr(ctx, expr, report_all),
            Let { is_mut: _, pat, annotation, value, else_branch } => {
                if report_all && annotation.is_none() && pattern_has_unresolved_inference(ctx, pat) {
                    push_inference_diagnostic_at(ctx, pat.span, 1);
                    mark_unresolved_pattern_locals(ctx, pat)
                }
                report_unresolved_expr(ctx, value, report_all);
                if let Some(value) = else_branch {
                    report_unresolved_expr(ctx, value, report_all)
                }
            },
            Assign { target, op: _, value } => {
                report_unresolved_expr(ctx, target, report_all);
                report_unresolved_expr(ctx, value, report_all)
            },
            Expr { expr } => report_unresolved_expr(ctx, expr, report_all),
        }
    }
    if let Some(expr) = value.tail {
        report_unresolved_expr(ctx, expr, report_all)
    }
}

fn report_unresolved_expr(ctx: Checker, value: hir::Expr, report_all: bool) -> () {
    match value.kind {
        NameRef { name_ref: Local(local) } => if report_all {
            if let Some(ty) = find_local(ctx, local) {
                if contains_unresolved_inference(ctx, ty) {
                    push_inference_diagnostic_at(ctx, value.span, 2)
                }
            }
        },
        ConstructorValue { constructor: _ } => (),
        Constr { constructor: _, args } | Tuple { items: args } | Array { items: args } => {
            report_unresolved_exprs(ctx, args, report_all)
        },
        InterpolatedString { parts } => for part in parts {
            match part {
                Expr(value) => report_unresolved_expr(ctx, value, report_all),
                Text(_) => (),
            }
        },
        StructLiteral { name: _, fields, base } => {
            for field in fields {
                report_unresolved_expr(ctx, field.1, report_all)
            }
            if let Some(value) = base {
                report_unresolved_expr(ctx, value, report_all)
            }
        },
        Closure { params, body } => {
            report_unresolved_expr(ctx, body, report_all);
            if report_all {
                for param in params {
                    if let Some(ty) = find_local(ctx, param.name) {
                        if contains_unresolved_inference(ctx, ty) {
                            push_inference_diagnostic_at(ctx, param.span, 3)
                        }
                    }
                }
            }
        },
        Match { expr, arms } => {
            report_unresolved_expr(ctx, expr, report_all);
            for arm in arms {
                if let Some(guard) = arm.guard {
                    report_unresolved_expr(ctx, guard, report_all)
                }
                report_unresolved_expr(ctx, arm.body, report_all)
            }
        },
        If { cond, then_branch, else_branch } => {
            report_unresolved_expr(ctx, cond, report_all);
            report_unresolved_expr(ctx, then_branch, report_all);
            report_unresolved_expr(ctx, else_branch, report_all)
        },
        While { cond, body, .. } => {
            report_unresolved_expr(ctx, cond, report_all);
            report_unresolved_expr(ctx, body, report_all)
        },
        Loop { body, .. } => report_unresolved_expr(ctx, body, report_all),
        For { pat: _, iterator, body, .. } => {
            report_unresolved_expr(ctx, iterator, report_all);
            report_unresolved_expr(ctx, body, report_all)
        },
        Return { expr } => if let Some(expr) = expr {
            report_unresolved_expr(ctx, expr, report_all)
        },
        Break { value, .. } => if let Some(expr) = value {
            report_unresolved_expr(ctx, expr, report_all)
        },
        Call { func, args } => {
            report_unresolved_expr(ctx, func, report_all);
            report_unresolved_exprs(ctx, args, report_all)
        },
        Unary { op: _, expr } | Cast { expr, ty: _ } | Try { depth: _, expr } | Proj {
            tuple: expr,
            index: _,
        } | Field { expr, .. } | Go { expr } => report_unresolved_expr(ctx, expr, report_all),
        Range { start, end, inclusive: _ } | Binary { op: _, lhs: start, rhs: end } | Index {
            base: start,
            index: end,
        } => {
            report_unresolved_expr(ctx, start, report_all);
            report_unresolved_expr(ctx, end, report_all)
        },
        Block { block } => report_unresolved_block(ctx, block, report_all),
        _ => (),
    }
}

fn check_function(
    base: Checker,
    value: hir::Function,
    inherited_generics: Vec[string],
    inherited_predicates: Vec[TypePredicate],
    self_ty: Option[Type],
) -> Function {
    let previous = base.current_function.get();
    base.current_function.set(
        if self_ty.is_none() {
            Option::Some(value.name)
        } else {
            Option::None
        },
    );
    let result = check_function_inner(
        base,
        value,
        inherited_generics,
        inherited_predicates,
        self_ty,
    );
    base.current_function.set(previous);
    result
}

fn check_function_inner(
    base: Checker,
    value: hir::Function,
    inherited_generics: Vec[string],
    inherited_predicates: Vec[TypePredicate],
    self_ty: Option[Type],
) -> Function {
    let derive_export_name = comptime_derive_export_name(value.attrs);
    let comptime = match self_ty {
        None => function_comptime_capability(
            value.attrs,
            Callable::Function(value.name),
            !value.generics.is_empty() || !value.generic_bounds.is_empty()
                || !value.predicates.is_empty(),
        ),
        Some(_) => ComptimeCapability::RuntimeOnly,
    };
    let comptime_span = Ref::new(Option::None);
    for attribute in value.attrs {
        if attribute.name == "comptime" || attribute.name == "comptime_derive" {
            comptime_span.set(Option::Some(attribute.span))
        }
    }
    if let Some(_) = derive_export_name {
        match value.visibility {
            ast::Visibility::Public => (),
            ast::Visibility::Private => push_diagnostic_at(
                base,
                "a named #[comptime_derive] export must be public",
                comptime_span.get(),
            ),
        }
    }
    if let None = self_ty {
        if value.name == "main" {
            if !value.params.is_empty() {
                push_diagnostic_at(base, "main function must not have parameters", Option::None)
            }
            if !value.generics.is_empty() {
                push_diagnostic_at(
                    base,
                    "main function must not have type parameters",
                    Option::None,
                )
            }
        }
    }
    let type_params = append_names(inherited_generics, value.generics);
    let raw_ret_ty = match value.ret_ty {
        Some(ty) => type_from_hir(base.builtin, ty, type_params, self_ty),
        None => Type::Unit,
    };
    let predicates = resolve_signature_predicates(
        base,
        append_predicates(
            inherited_predicates,
            predicates_from_hir(
                base.builtin,
                value.generic_bounds,
                value.predicates,
                type_params,
                self_ty,
            ),
        ),
        true,
    );
    let signature_ctx = function_context(
        base,
        Type::Unit,
        self_ty,
        type_params,
        predicates,
        false,
        false,
        comptime,
    );
    let previous_span = base.current_span.get();
    base.current_span.set(value.ret_ty_span);
    let ret_ty = resolve_signature_type(signature_ctx, raw_ret_ty, predicates, true);
    base.current_span.set(previous_span);
    let ctx = function_context(
        base,
        ret_ty,
        self_ty,
        type_params,
        predicates,
        attribute_allows(value.attrs, "unstructured_go"),
        attribute_allows(value.attrs, "unreachable_code"),
        comptime,
    );
    let comptime_origin_start = base.typeck_results.exprs.len();
    let params: Vec[(string, Type)] = Vec::new();
    for param in value.params {
        let index = params.len();
        let previous_span = ctx.current_span.get();
        ctx.current_span.set(
            if index < value.param_type_spans.len() {
                Option::Some(value.param_type_spans[index])
            } else {
                Option::None
            },
        );
        let ty = resolve_signature_type(
            ctx,
            type_from_hir(ctx.builtin, param.1, type_params, self_ty),
            predicates,
            true,
        );
        ctx.current_span.set(previous_span);
        insert_local(ctx, param.0, ty);
        params.push((local_name(param.0), ty))
    }
    let checked_body = check_block(ctx, value.body, Option::Some(ret_ty));
    resolve_field_constraints(ctx);
    resolve_coercion_constraints(ctx);
    resolve_numeric_literal_constraints(ctx);
    infer_function_map_predicates(ctx, params, ret_ty, comptime_origin_start, predicates);
    let report_all_unresolved = resolve_required_predicates(ctx);
    report_unresolved_block(ctx, value.body, report_all_unresolved);
    let body = resolve_deferred_block(ctx, checked_body.0);
    for index in comptime_origin_start..base.typeck_results.exprs.len() {
        let fact = base.typeck_results.exprs[index];
        if let Some(error) = invalid_go_function_signature(ctx, fact.ty) {
            push_diagnostic_at(ctx, error, Option::Some(fact.span));
            break
        }
        if let Some(key) = invalid_go_map_key(ctx, fact.ty) {
            push_diagnostic_at(
                ctx,
                "Go map key is not comparable: " + type_text(key),
                Option::Some(fact.span),
            );
            break
        }
    }
    if let ComptimeCapability::Derive = comptime {
        if match value.visibility {
            ast::Visibility::Public => true,
            ast::Visibility::Private => false,
        } {
            let valid_param = params.len() == 1
                && match resolve_type(params[0].1) {
                    Type::Con { name } => name == "DeriveInput",
                    _ => false,
                };
            let valid_return = match resolve_type(ret_ty) {
                Type::Con { name } => name == "DeriveOutput",
                _ => false,
            };
            if !valid_param || !valid_return {
                push_diagnostic_at(
                    base,
                    "public #[comptime_derive] function must have signature (DeriveInput) -> DeriveOutput",
                    comptime_span.get(),
                )
            }
        }
    }
    let comptime_origins: Vec[ast::Span] = Vec::new();
    for index in comptime_origin_start..base.typeck_results.exprs.len() {
        comptime_origins.push(base.typeck_results.exprs[index].span)
    }
    Function {
        name_span: value.name_span,
        visibility: value.visibility,
        name: value.name,
        comptime,
        derive_export_name,
        source_path: base.source_path,
        start: match comptime_span.get() {
            Some(value) => value.start,
            None => 0,
        },
        end: match comptime_span.get() {
            Some(value) => value.end,
            None => 0,
        },
        comptime_origins,
        generics: type_params,
        predicates,
        params,
        ret_ty,
        body,
    }
}

fn lower_constant_expr(ctx: Checker, value: Expr) -> ConstExpr {
    match value {
        Prim { value, ty } => ConstExpr::Prim { value, ty },
        Var { name, ty } => match find_constant_by_name(ctx, name) {
            Some(_) => ConstExpr::Ref { name, ty },
            None => {
                push_diagnostic(ctx, "constant expression cannot reference " + name);
                ConstExpr::Error { ty }
            },
        },
        Unary { op, expr, ty } => ConstExpr::Unary { op, expr: lower_constant_expr(ctx, expr), ty },
        Cast { expr, ty } => ConstExpr::Cast { expr: lower_constant_expr(ctx, expr), ty },
        Binary { op, lhs, rhs, ty, resolution } => match resolution {
            Builtin | Overloaded { trait_name: _ } => ConstExpr::Binary {
                op,
                lhs: lower_constant_expr(ctx, lhs),
                rhs: lower_constant_expr(ctx, rhs),
                ty,
            },
        },
        other => {
            let ty = expr_type(other);
            push_diagnostic(
                ctx,
                "constant values support only literals, constant references, unary operators, binary operators, and casts",
            );
            ConstExpr::Error { ty }
        },
    }
}

fn constant_type_supported(ctx: Checker, value: Type, active: Vec[string]) -> bool {
    match prune(normalize_type(ctx, value)) {
        Bool | Int | Int8 | Int16 | Int32 | Int64 | Uint | Uint8 | Uint16 | Uint32 | Uint64 | Float32 | Float64 | String | Char => true,
        Tuple { items } => {
            for item in items {
                if !constant_type_supported(ctx, item, active) {
                    return false
                }
            }
            true
        },
        Array { len: _, elem } => constant_type_supported(ctx, elem, active),
        value => match struct_application_parts(value) {
            Some(parts) => if active.contains(parts.0) {
                false
            } else {
                let next = copied_names(active);
                next.push(parts.0);
                match find_struct_by_name(ctx, parts.0) {
                    Some(info) => {
                        for field in info.fields {
                            if !constant_type_supported(
                                ctx,
                                substitute_params(field.1, info.generics, parts.1),
                                next,
                            ) {
                                return false
                            }
                        }
                        true
                    },
                    None => match find_enum_by_name(ctx, parts.0) {
                        Some(info) => {
                            for variant in info.variants {
                                for field in enum_variant_field_types(variant.fields) {
                                    if !constant_type_supported(
                                        ctx,
                                        substitute_params(field, info.generics, parts.1),
                                        next,
                                    ) {
                                        return false
                                    }
                                }
                            }
                            true
                        },
                        None => false,
                    },
                }
            },
            None => false,
        },
    }
}

fn direct_constant_expr(value: Expr) -> bool {
    match value {
        Prim { .. } | Var { .. } => true,
        Unary { expr, .. } | Cast { expr, .. } => direct_constant_expr(expr),
        Binary { lhs, rhs, .. } => direct_constant_expr(lhs) && direct_constant_expr(rhs),
        _ => false,
    }
}

fn check_constant(base: Checker, value: hir::Constant) -> (
    Option[Constant],
    Option[PendingConstant],
) {
    let previous_span = base.current_span.get();
    base.current_span.set(Option::Some(value.ty_span));
    let ty = resolve_signature_type(
        base,
        type_from_hir(base.builtin, value.ty, Vec::new(), Option::None),
        Vec::new(),
        true,
    );
    let supported_type = constant_type_supported(base, ty, Vec::new());
    if !supported_type {
        push_diagnostic(
            base,
            "constant type must be recursively immutable and cannot contain Vec, HashMap, Ref, Channel, closures, or dynamic values",
        )
    }
    base.current_span.set(Option::Some(value.value.span));
    let ctx = function_context(
        base,
        ty,
        Option::None,
        Vec::new(),
        Vec::new(),
        false,
        false,
        ComptimeCapability::Capable,
    );
    let comptime_origin_start = base.typeck_results.exprs.len();
    let checked = check_expr(ctx, value.value, Option::Some(ty));
    resolve_field_constraints(ctx);
    resolve_coercion_constraints(ctx);
    resolve_numeric_literal_constraints(ctx);
    let checked = resolve_deferred_expr(ctx, checked);
    let comptime_origins: Vec[ast::Span] = Vec::new();
    for index in comptime_origin_start..base.typeck_results.exprs.len() {
        comptime_origins.push(base.typeck_results.exprs[index].span)
    }
    let resolved_ty = resolve_type(ty);
    let result = if !supported_type {
        (Option::None, Option::None)
    } else if direct_constant_expr(checked) {
        (
            Option::Some(
                Constant {
                    name: value.name,
                    ty: resolved_ty,
                    value: lower_constant_expr(ctx, checked),
                },
            ),
            Option::None,
        )
    } else {
        (
            Option::None,
            Option::Some(
                PendingConstant {
                    name: value.name,
                    ty: resolved_ty,
                    value: checked,
                    source_path: base.source_path,
                    start: value.value.span.start,
                    end: value.value.span.end,
                    comptime_origins,
                },
            ),
        )
    };
    base.current_span.set(previous_span);
    result
}

fn once_cell_type(builtin: BuiltinContract, value: Type) -> bool {
    match resolve_type(value) {
        App { ty: Con { name }, args } => {
            names_match(name, builtin.static_cell.name) && args.len() == 1
        },
        _ => false,
    }
}

fn hir_once_cell_initializer(builtin: BuiltinContract, value: hir::Expr) -> bool {
    match value.kind {
        Call {
            func: hir::Expr {
                kind: StaticMember {
                    owner,
                    member,
                    owner_type_args: _,
                    owner_type_arg_spans: _,
                    member_type_args: _,
                    member_type_arg_spans: _,
                },
                span: _,
            },
            args,
        } => names_match(owner, builtin.static_cell.name)
            && member == builtin.static_cell.constructor
            && args.is_empty(),
        _ => false,
    }
}

fn check_static(base: Checker, value: hir::Static) -> Static {
    let valid_initializer = hir_once_cell_initializer(base.builtin, value.value);
    let previous_span = base.current_span.get();
    base.current_span.set(Option::Some(value.ty_span));
    let ty = resolve_signature_type(
        base,
        type_from_hir(base.builtin, value.ty, Vec::new(), Option::None),
        Vec::new(),
        true,
    );
    base.current_span.set(Option::Some(value.value.span));
    let ctx = function_context(
        base,
        ty,
        Option::None,
        Vec::new(),
        Vec::new(),
        false,
        false,
        ComptimeCapability::RuntimeOnly,
    );
    let checked = check_expr(ctx, value.value, Option::Some(ty));
    resolve_field_constraints(ctx);
    resolve_coercion_constraints(ctx);
    resolve_numeric_literal_constraints(ctx);
    let _ = resolve_deferred_expr(ctx, checked);
    if !once_cell_type(base.builtin, ty) || !valid_initializer {
        push_diagnostic(base, "static initializer must be `OnceCell::new()`")
    }
    base.current_span.set(previous_span);
    Static { name: value.name, ty: resolve_type(ty) }
}

fn constant_expr_references(value: ConstExpr, result: collections::IndexSet[string]) -> () {
    match value {
        Ref { name, ty: _ } => {
            let _ = result.insert(name);
        },
        Unary { op: _, expr, ty: _ } | Cast { expr, ty: _ } => constant_expr_references(
            expr,
            result,
        ),
        Binary { op: _, lhs, rhs, ty: _ } => {
            constant_expr_references(lhs, result);
            constant_expr_references(rhs, result)
        },
        Tuple { items, ty: _ } | Array { items, ty: _ } | Constr {
            constructor: _,
            args: items,
            ty: _,
        } => for item in items {
            constant_expr_references(item, result)
        },
        _ => (),
    }
}

fn checked_constant_by_name(values: Vec[Constant], name: string) -> Option[Constant] {
    for value in values {
        if value.name == name {
            return Option::Some(value)
        }
    }
    Option::None
}

fn constant_reaches(
    values: Vec[Constant],
    current: string,
    target: string,
    visited: collections::HashSet[string],
) -> bool {
    if !visited.insert(current) {
        false
    } else {
        match checked_constant_by_name(values, current) {
            Some(value) => {
                let references = collections::IndexSet::new();
                constant_expr_references(value.value, references);
                for reference in references {
                    if reference == target || constant_reaches(values, reference, target, visited) {
                        return true
                    }
                }
                false
            },
            None => false,
        }
    }
}

fn validate_constant_cycles(ctx: Checker, values: Vec[Constant]) -> () {
    for value in values {
        if constant_reaches(values, value.name, value.name, collections::HashSet::new()) {
            push_global_diagnostic(ctx, "Cyclic constant " + short_name(value.name))
        }
    }
}

fn collect_injective_type_params(value: Type, result: collections::IndexSet[string]) -> () {
    match prune(value) {
        Param { name } => {
            let _ = result.insert(name);
        },
        External { import_path: _, name: _, args: items } => for item in items {
            collect_injective_type_params(item, result)
        },
        Tuple { items } => for item in items {
            collect_injective_type_params(item, result)
        },
        Projection { for_ty: _, name: _, trait_ref: _ } => (),
        App { ty, args } => {
            collect_injective_type_params(ty, result);
            for arg in args {
                collect_injective_type_params(arg, result)
            }
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => collect_injective_type_params(
            elem,
            result,
        ),
        HashMap { key, value } => {
            collect_injective_type_params(key, result);
            collect_injective_type_params(value, result)
        },
        GoMap { key, value } => {
            collect_injective_type_params(key, result);
            collect_injective_type_params(value, result)
        },
        Func { params, ret_ty } => {
            for param in params {
                collect_injective_type_params(param, result)
            }
            collect_injective_type_params(ret_ty, result)
        },
        _ => (),
    }
}

fn type_contains_projection(value: Type) -> bool {
    match prune(value) {
        Projection { for_ty: _, name: _, trait_ref: _ } => true,
        External { import_path: _, name: _, args: items } => {
            for item in items {
                if type_contains_projection(item) {
                    return true
                }
            }
            false
        },
        Tuple { items } => {
            for item in items {
                if type_contains_projection(item) {
                    return true
                }
            }
            false
        },
        App { ty, args } => {
            if type_contains_projection(ty) {
                return true
            }
            for arg in args {
                if type_contains_projection(arg) {
                    return true
                }
            }
            false
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => type_contains_projection(
            elem,
        ),
        HashMap { key, value } => {
            type_contains_projection(key) || type_contains_projection(value)
        },
        GoMap { key, value } => {
            type_contains_projection(key) || type_contains_projection(value)
        },
        Func { params, ret_ty } => {
            if type_contains_projection(ret_ty) {
                return true
            }
            for param in params {
                if type_contains_projection(param) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn validate_impl_type_params(
    ctx: Checker,
    generics: Vec[string],
    reference: Option[TraitRef],
    for_type: Type,
    span: ast::Span,
) -> () {
    let constrained = collections::IndexSet::new();
    collect_injective_type_params(for_type, constrained);
    if let Some(reference) = reference {
        for arg in reference.args {
            collect_injective_type_params(arg, constrained)
        }
    }
    for generic in generics {
        if constrained.contains(generic) {} else {
            push_diagnostic_at(
                ctx,
                "Implementation type parameter " + generic + " is not constrained by type "
                    + type_text(for_type),
                if type_contains_projection(for_type) {
                    Option::Some(span)
                } else {
                    Option::None
                },
            )
        }
    }
}

fn mark_impl_invalid_at(ctx: Checker, span: ast::Span) -> () {
    for value in ctx.impls {
        if value.span.start == span.start && value.span.end == span.end {
            let _ = ctx.invalid_impl_origins.insert(value.origin);
        }
    }
}

fn trait_reference_has_wrong_arity(ctx: Checker, reference: TraitRef) -> bool {
    match find_trait(ctx, reference.name) {
        Some(info) => info.generics.len() != reference.args.len(),
        None => false,
    }
}

fn hir_type_uses_self_projection(value: hir::TypeExpr) -> bool {
    match value {
        Projection { base: Con { name }, associated: _ } => {
            name == "Self"
        },
        Projection { base, associated: _ } | Array { len: _, elem: base } => hir_type_uses_self_projection(
            base,
        ),
        Tuple { items } => {
            for item in items {
                if hir_type_uses_self_projection(item) {
                    return true
                }
            }
            false
        },
        App { ty, args } => {
            if hir_type_uses_self_projection(ty) {
                true
            } else {
                for arg in args {
                    if hir_type_uses_self_projection(arg) {
                        return true
                    }
                }
                false
            }
        },
        Func { params, ret_ty } => {
            for param in params {
                if hir_type_uses_self_projection(param) {
                    return true
                }
            }
            hir_type_uses_self_projection(ret_ty)
        },
        _ => false,
    }
}

fn check_impl(base: Checker, value: hir::ImplBlock) -> ImplBlock {
    let mut invalid = false;
    let previous_span = base.current_span.get();
    base.current_span.set(Option::Some(value.for_type_span));
    let raw_for_type = type_from_hir(base.builtin, value.for_type, value.generics, Option::None);
    let wrong_arity = nominal_application_has_wrong_arity(base, raw_for_type);
    let for_type = resolve_signature_type(
        base,
        raw_for_type,
        Vec::new(),
        !type_contains_projection(raw_for_type),
    );
    base.current_span.set(previous_span);
    if wrong_arity {
        return ImplBlock {
            generics: value.generics,
            predicates: Vec::new(),
            trait_ref: Option::None,
            for_type,
            associated_types: Vec::new(),
            methods: Vec::new(),
        }
    }
    let predicates = resolve_signature_predicates(
        base,
        predicates_from_hir(
            base.builtin,
            value.generic_bounds,
            value.predicates,
            value.generics,
            Option::Some(for_type),
        ),
        true,
    );
    let trait_ref = match value.trait_ref {
        Some(reference) => {
            let reference = trait_ref_from_hir(
                base.builtin,
                reference,
                value.generics,
                Option::Some(for_type),
            );
            match find_trait(base, reference.name) {
                Some(_) => validate_trait_reference(base, reference),
                None => push_diagnostic(
                    base,
                    "Trait " + reference.name + " is not defined, cannot implement it for "
                        + type_text(for_type),
                ),
            }
            Option::Some(canonical_resolved_trait_ref(base, normalize_trait_ref(base, reference)))
        },
        None => Option::None,
    };
    let validation_start = base.diagnostics.len();
    validate_impl_type_params(base, value.generics, trait_ref, for_type, value.for_type_span);
    if base.diagnostics.len() > validation_start {
        invalid = true;
    }
    if let Some(reference) = trait_ref {
        if trait_reference_has_wrong_arity(base, reference) {
            mark_impl_invalid_at(base, value.for_type_span);
            return ImplBlock {
                generics: value.generics,
                predicates,
                trait_ref,
                for_type,
                associated_types: Vec::new(),
                methods: Vec::new(),
            }
        }
    }
    let associated_types: Vec[(string, Type)] = Vec::new();
    for associated in value.associated_types {
        let associated_predicates = match trait_ref {
            Some(reference) => if hir_type_uses_self_projection(associated.1) {
                append_predicates(
                    predicates,
                    Vec::from_array(
                        [TypePredicate::Trait { for_ty: for_type, trait_ref: reference }],
                    ),
                )
            } else {
                predicates
            },
            None => predicates,
        };
        associated_types.push(
            (
                associated.0,
                resolve_signature_type(
                    base,
                    type_from_hir(
                        base.builtin,
                        associated.1,
                        value.generics,
                        Option::Some(for_type),
                    ),
                    associated_predicates,
                    true,
                ),
            ),
        )
    }
    if let Some(reference) = trait_ref {
        let validation_span = base.current_span.get();
        base.current_span.set(Option::Some(value.for_type_span));
        let validation_start = base.diagnostics.len();
        validate_trait_impl_definition_requirements(
            base,
            reference,
            for_type,
            associated_types,
            predicates,
            value.generics,
        );
        if base.diagnostics.len() > validation_start {
            invalid = true;
        }
        base.current_span.set(validation_span)
    }
    let methods: Vec[Function] = Vec::new();
    for method in value.methods {
        methods.push(
            check_function(base, method, value.generics, predicates, Option::Some(for_type)),
        )
    }
    match trait_ref {
        Some(reference) => {
            let validation_start = base.diagnostics.len();
            validate_trait_impl(
                base,
                reference,
                for_type,
                associated_types,
                methods,
                value.generics,
                predicates,
            );
            if base.diagnostics.len() > validation_start {
                invalid = true;
            }
        },
        None => validate_inherent_impl(base, for_type, methods),
    }
    if invalid {
        mark_impl_invalid_at(base, value.for_type_span)
    }
    ImplBlock {
        generics: value.generics,
        predicates,
        trait_ref,
        for_type,
        associated_types,
        methods,
    }
}

fn type_matches(ctx: Checker, left: Type, right: Type) -> bool {
    types_equal(normalize_type(ctx, left), normalize_type(ctx, right))
}

fn contains_type_predicate(values: Vec[TypePredicate], expected: TypePredicate) -> bool {
    for value in values {
        if predicate_equal(value, expected) {
            return true
        }
    }
    false
}

fn type_predicate_sets_equal(left: Vec[TypePredicate], right: Vec[TypePredicate]) -> bool {
    if left.len() != right.len() {
        false
    } else {
        for value in left {
            if !contains_type_predicate(right, value) {
                return false
            }
        }
        true
    }
}

fn validate_method_signature(
    ctx: Checker,
    trait_name: string,
    expected: TraitMethodInfo,
    actual: Function,
    substitutions: Vec[TypeSubst],
    owner_generic_count: isize,
    owner_predicate_count: isize,
) -> () {
    let actual_method_generics: Vec[string] = Vec::new();
    for index in owner_generic_count..actual.generics.len() {
        actual_method_generics.push(actual.generics[index])
    }
    if expected.generics.len() != actual_method_generics.len() {
        push_diagnostic(
            ctx,
            f"Trait {trait_name}::{actual.name} expects {expected.generics.len()} method type parameters but impl has {actual_method_generics.len()}",
        )
    }
    let generic_count = if expected.generics.len() < actual_method_generics.len() {
        expected.generics.len()
    } else {
        actual_method_generics.len()
    };
    for index in 0..generic_count {
        substitutions.push(
            TypeSubst {
                name: expected.generics[index],
                ty: Type::Param { name: actual_method_generics[index] },
            },
        )
    }
    let expected_params: Vec[Type] = Vec::new();
    for param in expected.params {
        expected_params.push(normalize_type(ctx, substitute_type(param, substitutions)))
    }
    let expected_ret = normalize_type(ctx, substitute_type(expected.ret_ty, substitutions));
    if expected_params.len() != actual.params.len() {
        push_diagnostic(
            ctx,
            f"Trait {trait_name}::{actual.name} expects {expected_params.len()} parameters but impl has {actual.params.len()}",
        )
    }
    let common = if expected_params.len() < actual.params.len() {
        expected_params.len()
    } else {
        actual.params.len()
    };
    for index in 0..common {
        let expected_ty = expected_params[index];
        let actual_ty = normalize_type(ctx, actual.params[index].1);
        if !type_matches(ctx, expected_ty, actual_ty) {
            push_diagnostic(
                ctx,
                f"Trait {trait_name}::{actual.name} parameter {index} expected type "
                    + type_text(expected_ty)
                    + " but found "
                    + type_text(actual_ty),
            )
        }
    }
    let actual_ret = normalize_type(ctx, actual.ret_ty);
    if !type_matches(ctx, expected_ret, actual_ret) {
        push_diagnostic(
            ctx,
            "Trait " + trait_name + "::" + actual.name + " expected return type "
                + type_text(expected_ret)
                + " but found "
                + type_text(actual_ret),
        )
    }
    let expected_predicates: Vec[TypePredicate] = Vec::new();
    for predicate in expected.predicates {
        expected_predicates.push(substitute_predicate(predicate, substitutions))
    }
    let actual_predicates: Vec[TypePredicate] = Vec::new();
    for index in owner_predicate_count..actual.predicates.len() {
        actual_predicates.push(actual.predicates[index])
    }
    if !type_predicate_sets_equal(expected_predicates, actual_predicates) {
        push_diagnostic(
            ctx,
            "Trait " + trait_name + "::" + actual.name
                + " method bounds do not match the trait declaration",
        )
    }
}

fn validate_trait_associated_types(
    ctx: Checker,
    info: TraitInfo,
    reference: TraitRef,
    for_type: Type,
    associated_types: Vec[(string, Type)],
) -> () {
    let seen: collections::HashSet[string] = collections::HashSet::new();
    for associated in associated_types {
        if !contains_associated_type(info.associated_types, associated.0) {
            push_diagnostic(
                ctx,
                "Associated type " + associated.0 + " is not declared in trait " + reference.name,
            )
        } else if !seen.insert(associated.0) {
            push_diagnostic(
                ctx,
                "Associated type " + associated.0 + " is bound multiple times in impl of trait "
                    + reference.name,
            )
        }
    }
    for expected in info.associated_types {
        if !seen.contains(expected.name) {
            push_diagnostic(
                ctx,
                "Trait " + reference.name + " implementation for " + type_text(for_type)
                    + " is missing associated type "
                    + expected.name,
            )
        }
    }
}

fn contains_associated_type(values: Vec[AssociatedTypeInfo], name: string) -> bool {
    for value in values {
        if value.name == name {
            return true
        }
    }
    false
}

fn impl_associated_type(values: Vec[(string, Type)], name: string) -> Option[Type] {
    for offset in 0..values.len() {
        let value = values[values.len() - 1 - offset];
        if value.0 == name {
            return Option::Some(value.1)
        }
    }
    Option::None
}

fn associated_type_reaches(
    values: Vec[(string, Type)],
    value: Type,
    target_trait: string,
    target: string,
    active: Vec[string],
) -> bool {
    match prune(value) {
        Projection { for_ty, name, trait_ref } => {
            if name == target
                && match trait_ref {
                    Some(reference) => reference.name == target_trait,
                    None => true,
                } {
                return true
            }
            if !active.contains(name) {
                if let Some(next) = impl_associated_type(values, name) {
                    active.push(name);
                    let reaches = associated_type_reaches(
                        values,
                        next,
                        target_trait,
                        target,
                        active,
                    );
                    active.truncate(active.len() - 1);
                    if reaches {
                        return true
                    }
                }
            }
            if associated_type_reaches(values, for_ty, target_trait, target, active) {
                return true
            }
            if let Some(reference) = trait_ref {
                for arg in reference.args {
                    if associated_type_reaches(values, arg, target_trait, target, active) {
                        return true
                    }
                }
            }
            false
        },
        External { import_path: _, name: _, args: items } => {
            for item in items {
                if associated_type_reaches(values, item, target_trait, target, active) {
                    return true
                }
            }
            false
        },
        Tuple { items } => {
            for item in items {
                if associated_type_reaches(values, item, target_trait, target, active) {
                    return true
                }
            }
            false
        },
        App { ty, args } => {
            if associated_type_reaches(values, ty, target_trait, target, active) {
                return true
            }
            for arg in args {
                if associated_type_reaches(values, arg, target_trait, target, active) {
                    return true
                }
            }
            false
        },
        Array { len: _, elem } | Slice { elem } | MutSlice { elem } | VecType { elem } | GoPointer {
            elem,
        } | GoFunction { signature: elem } | RefType { elem } | Channel { elem, direction: _ } => {
            associated_type_reaches(values, elem, target_trait, target, active)
        },
        HashMap { key, value } => {
            associated_type_reaches(values, key, target_trait, target, active)
                || associated_type_reaches(values, value, target_trait, target, active)
        },
        GoMap { key, value } => {
            associated_type_reaches(values, key, target_trait, target, active)
                || associated_type_reaches(values, value, target_trait, target, active)
        },
        Func { params, ret_ty } => {
            if associated_type_reaches(values, ret_ty, target_trait, target, active) {
                return true
            }
            for param in params {
                if associated_type_reaches(values, param, target_trait, target, active) {
                    return true
                }
            }
            false
        },
        _ => false,
    }
}

fn validate_associated_type_cycles(
    ctx: Checker,
    reference: TraitRef,
    associated_types: Vec[(string, Type)],
) -> () {
    for associated in associated_types {
        if associated_type_reaches(
            associated_types,
            associated.1,
            reference.name,
            associated.0,
            Vec::new(),
        ) {
            push_diagnostic_at(
                ctx,
                "Associated type " + associated.0 + " has a cyclic definition in impl of trait "
                    + short_name(reference.name),
                Option::None,
            )
        }
    }
}

fn predicate_text(value: TypePredicate) -> string {
    match value {
        GoComparable(ty) => "go_comparable(" + type_text(ty) + ")",
        Trait { for_ty, trait_ref } => {
            type_text(for_ty) + ": " + trait_ref_text(trait_ref)
        },
        Equality { lhs, rhs } => {
            type_text(lhs) + " == " + type_text(rhs)
        },
    }
}

fn resolve_impl_alias_types(ctx: Checker, values: Vec[Type]) -> Vec[Type] {
    let result: Vec[Type] = Vec::new();
    for value in values {
        result.push(resolve_impl_alias_type(ctx, value))
    }
    result
}

fn resolve_impl_alias_trait_ref(ctx: Checker, value: TraitRef) -> TraitRef {
    TraitRef { name: value.name, args: resolve_impl_alias_types(ctx, value.args) }
}

fn resolve_impl_alias_type(ctx: Checker, value: Type) -> Type {
    match prune(value) {
        projection @ Projection { for_ty, name, trait_ref } => {
            match projection_equality(ctx, for_ty, name, trait_ref) {
                Some(resolved) => resolved,
                None => Type::Projection {
                    for_ty: resolve_impl_alias_type(ctx, for_ty),
                    name,
                    trait_ref: trait_ref.map(|value| resolve_impl_alias_trait_ref(ctx, value)),
                },
            }
        },
        External { import_path, name, args: items } => Type::External {
            import_path,
            name,
            args: resolve_impl_alias_types(ctx, items),
        },
        Tuple { items } => Type::Tuple { items: resolve_impl_alias_types(ctx, items) },
        App { ty, args } => Type::App {
            ty: resolve_impl_alias_type(ctx, ty),
            args: resolve_impl_alias_types(ctx, args),
        },
        Array { len, elem } => Type::Array { len, elem: resolve_impl_alias_type(ctx, elem) },
        Slice { elem } => Type::Slice { elem: resolve_impl_alias_type(ctx, elem) },
        MutSlice { elem } => Type::MutSlice { elem: resolve_impl_alias_type(ctx, elem) },
        VecType { elem } => Type::VecType { elem: resolve_impl_alias_type(ctx, elem) },
        GoPointer { elem } => Type::GoPointer { elem: resolve_impl_alias_type(ctx, elem) },
        GoFunction { signature } => Type::GoFunction {
            signature: resolve_impl_alias_type(ctx, signature),
        },
        RefType { elem } => Type::RefType { elem: resolve_impl_alias_type(ctx, elem) },
        HashMap { key, value } => Type::HashMap {
            key: resolve_impl_alias_type(ctx, key),
            value: resolve_impl_alias_type(ctx, value),
        },
        GoMap { key, value } => Type::GoMap {
            key: resolve_impl_alias_type(ctx, key),
            value: resolve_impl_alias_type(ctx, value),
        },
        Channel { elem, direction } => Type::Channel {
            elem: resolve_impl_alias_type(ctx, elem),
            direction,
        },
        Func { params, ret_ty } => Type::Func {
            params: resolve_impl_alias_types(ctx, params),
            ret_ty: resolve_impl_alias_type(ctx, ret_ty),
        },
        other => other,
    }
}

fn resolve_impl_alias_predicate(ctx: Checker, value: TypePredicate) -> TypePredicate {
    match value {
        GoComparable(ty) => TypePredicate::GoComparable(resolve_impl_alias_type(ctx, ty)),
        Trait { for_ty, trait_ref } => TypePredicate::Trait {
            for_ty: resolve_impl_alias_type(ctx, for_ty),
            trait_ref: resolve_impl_alias_trait_ref(ctx, trait_ref),
        },
        Equality { lhs, rhs } => TypePredicate::Equality {
            lhs: resolve_impl_alias_type(ctx, lhs),
            rhs: resolve_impl_alias_type(ctx, rhs),
        },
    }
}

fn validate_associated_type_bounds(
    ctx: Checker,
    info: TraitInfo,
    reference: TraitRef,
    associated_types: Vec[(string, Type)],
    substitutions: Vec[TypeSubst],
) -> () {
    for definition in info.associated_types {
        if let Some(actual) = impl_associated_type(associated_types, definition.name) {
            for bound in definition.bounds {
                let bound = substitute_trait_ref(bound, substitutions);
                let actual = normalize_type(ctx, actual);
                if trait_bound_satisfied_at(ctx, actual, bound, Vec::new()) {} else {
                    push_diagnostic(
                        ctx,
                        "Associated type " + definition.name + " = " + type_text(actual)
                            + " does not satisfy bound "
                            + trait_ref_text(bound)
                            + " in impl of "
                            + short_name(reference.name),
                    )
                }
            }
        }
    }
}

fn validate_trait_impl_requirements(
    ctx: Checker,
    info: TraitInfo,
    reference: TraitRef,
    for_type: Type,
    substitutions: Vec[TypeSubst],
) -> () {
    for supertrait in info.supertraits {
        let supertrait = substitute_trait_ref(supertrait, substitutions);
        if trait_bound_satisfied_at(ctx, for_type, supertrait, Vec::new()) {} else {
            push_diagnostic(
                ctx,
                "Trait " + short_name(reference.name) + " implementation for " + type_text(for_type)
                    + " requires supertrait "
                    + trait_ref_text(supertrait),
            )
        }
    }
    for predicate in substitute_predicates(info.predicates, substitutions) {
        let predicate = resolve_impl_alias_predicate(ctx, predicate);
        if predicates_satisfied_at(ctx, Vec::from_array([predicate]), Vec::new()) {} else {
            push_diagnostic(
                ctx,
                "Trait " + short_name(reference.name) + " implementation for " + type_text(for_type)
                    + " does not satisfy declared requirement "
                    + predicate_text(predicate),
            )
        }
    }
}

fn type_contains_any_parameter(value: Type, parameters: Vec[string]) -> bool {
    for parameter in parameters {
        if type_contains_parameter(value, parameter) {
            return true
        }
    }
    false
}

fn trait_ref_contains_any_parameter(reference: TraitRef, parameters: Vec[string]) -> bool {
    for arg in reference.args {
        if type_contains_any_parameter(arg, parameters) {
            return true
        }
    }
    false
}

fn predicate_contains_any_parameter(value: TypePredicate, parameters: Vec[string]) -> bool {
    match value {
        GoComparable(ty) => type_contains_any_parameter(ty, parameters),
        Trait { for_ty, trait_ref } => {
            type_contains_any_parameter(for_ty, parameters)
                || trait_ref_contains_any_parameter(trait_ref, parameters)
        },
        Equality { lhs, rhs } => {
            type_contains_any_parameter(lhs, parameters)
                || type_contains_any_parameter(rhs, parameters)
        },
    }
}

fn validate_concrete_impl_predicates(
    ctx: Checker,
    predicates: Vec[TypePredicate],
    owner_generics: Vec[string],
) -> () {
    for predicate in predicates {
        if predicate_contains_any_parameter(predicate, owner_generics)
            || predicates_satisfied_at(ctx, Vec::from_array([predicate]), Vec::new()) {} else {
            push_diagnostic(
                ctx,
                predicate_requirement_message(ctx, predicate, "type predicate not satisfied"),
            )
        }
    }
}

fn validate_trait_impl_definition_requirements(
    ctx: Checker,
    reference: TraitRef,
    for_type: Type,
    associated_types: Vec[(string, Type)],
    predicates: Vec[TypePredicate],
    owner_generics: Vec[string],
) -> () {
    validate_concrete_impl_predicates(ctx, predicates, owner_generics);
    if let Some(info) = find_trait(ctx, reference.name) {
        let validation_ctx = function_context(
            ctx,
            Type::Unit,
            Option::Some(for_type),
            Vec::new(),
            predicates,
            false,
            false,
            ComptimeCapability::RuntimeOnly,
        );
        validate_associated_type_cycles(validation_ctx, reference, associated_types);
        let substitutions = trait_substitutions(
            validation_ctx,
            info,
            reference,
            Option::Some(for_type),
        );
        for associated in associated_types {
            validation_ctx.projection_aliases.push(
                ProjectionAlias {
                    projection: Type::Projection {
                        for_ty: for_type,
                        name: associated.0,
                        trait_ref: Option::Some(reference),
                    },
                    ty: associated.1,
                },
            );
            validation_ctx.projection_aliases.push(
                ProjectionAlias {
                    projection: Type::Projection {
                        for_ty: for_type,
                        name: associated.0,
                        trait_ref: Option::None,
                    },
                    ty: associated.1,
                },
            )
        }
        validate_trait_impl_requirements(validation_ctx, info, reference, for_type, substitutions);
        validate_associated_type_bounds(
            validation_ctx,
            info,
            reference,
            associated_types,
            substitutions,
        )
    }
}

fn validate_trait_impl(
    ctx: Checker,
    reference: TraitRef,
    for_type: Type,
    associated_types: Vec[(string, Type)],
    methods: Vec[Function],
    owner_generics: Vec[string],
    owner_predicates: Vec[TypePredicate],
) -> () {
    if let Some(info) = find_trait(ctx, reference.name) {
        validate_trait_associated_types(ctx, info, reference, for_type, associated_types);
        let substitutions = trait_substitutions(ctx, info, reference, Option::Some(for_type));
        let projection_alias_count = ctx.projection_aliases.len();
        for associated in associated_types {
            ctx.projection_aliases.push(
                ProjectionAlias {
                    projection: Type::Projection {
                        for_ty: for_type,
                        name: associated.0,
                        trait_ref: Option::Some(reference),
                    },
                    ty: associated.1,
                },
            );
            ctx.projection_aliases.push(
                ProjectionAlias {
                    projection: Type::Projection {
                        for_ty: for_type,
                        name: associated.0,
                        trait_ref: Option::None,
                    },
                    ty: associated.1,
                },
            )
        }
        for expected in info.methods {
            if !contains_function_named(methods, expected.name) {
                if let Some(default_name) = expected.default_name {
                    methods.push(
                        default_trait_method(
                            ctx,
                            expected,
                            default_name,
                            substitutions,
                            owner_generics,
                            owner_predicates,
                        ),
                    )
                }
            }
        }
        let seen: collections::HashSet[string] = collections::HashSet::new();
        for method in methods {
            match find_trait_method(info, method.name) {
                Some(expected) => if !seen.insert(method.name) {
                    push_diagnostic(
                        ctx,
                        "Method " + method.name + " implemented multiple times in impl of trait "
                            + reference.name,
                    )
                } else {
                    validate_method_signature(
                        ctx,
                        reference.name,
                        expected,
                        method,
                        substitutions,
                        owner_generics.len(),
                        owner_predicates.len(),
                    )
                },
                None => push_diagnostic(
                    ctx,
                    "Method " + method.name + " is not declared in trait " + reference.name,
                ),
            }
        }
        for expected in info.methods {
            if !seen.contains(expected.name) && expected.default_name.is_none() {
                push_diagnostic(
                    ctx,
                    "Trait " + reference.name + " implementation for " + type_text(for_type)
                        + " is missing method "
                        + expected.name,
                )
            }
        }
        ctx.projection_aliases.truncate(projection_alias_count)
    }
}

fn contains_function_named(values: Vec[Function], name: string) -> bool {
    for value in values {
        if value.name == name {
            return true
        }
    }
    false
}

fn canonical_resolved_trait_ref(ctx: Checker, value: TraitRef) -> TraitRef {
    TraitRef {
        name: match find_trait(ctx, value.name) {
            Some(info) => info.name,
            None => value.name,
        },
        args: value.args,
    }
}

fn canonical_default_predicates(ctx: Checker, values: Vec[TypePredicate]) -> Vec[TypePredicate] {
    let result: Vec[TypePredicate] = Vec::new();
    for value in values {
        result.push(
            match value {
                GoComparable(ty) => TypePredicate::GoComparable(ty),
                Trait { for_ty, trait_ref } => TypePredicate::Trait {
                    for_ty,
                    trait_ref: canonical_resolved_trait_ref(ctx, trait_ref),
                },
                Equality { lhs, rhs } => TypePredicate::Equality { lhs, rhs },
            },
        )
    }
    result
}

fn default_trait_method(
    ctx: Checker,
    expected: TraitMethodInfo,
    default_name: string,
    substitutions: Vec[TypeSubst],
    owner_generics: Vec[string],
    owner_predicates: Vec[TypePredicate],
) -> Function {
    let generics = append_names(owner_generics, expected.generics);
    for generic in expected.generics {
        substitutions.push(TypeSubst { name: generic, ty: Type::Param { name: generic } })
    }
    let params: Vec[(string, Type)] = Vec::new();
    let args: Vec[Expr] = Vec::new();
    let param_types: Vec[Type] = Vec::new();
    for index in 0..expected.params.len() {
        let name = f"default_arg{index}";
        let ty = resolve_impl_alias_type(
            ctx,
            substitute_type(expected.params[index], substitutions),
        );
        params.push((name, ty));
        args.push(Expr::Var { name, ty });
        param_types.push(ty)
    }
    let ret_ty = resolve_impl_alias_type(ctx, substitute_type(expected.ret_ty, substitutions));
    let predicates = append_predicates(
        owner_predicates,
        canonical_default_predicates(ctx, substitute_predicates(expected.predicates, substitutions)),
    );
    validate_default_map_requirements(ctx, expected, substitutions, generics, predicates);
    let function_ty = Type::Func { params: param_types, ret_ty };
    Function {
        name_span: ast::Span { start: 0, end: 0 },
        visibility: ast::Visibility::Private,
        name: expected.name,
        comptime: ComptimeCapability::RuntimeOnly,
        derive_export_name: Option::None,
        source_path: ctx.source_path,
        start: 0,
        end: 0,
        comptime_origins: Vec::new(),
        generics,
        predicates,
        params,
        ret_ty,
        body: Block {
            stmts: Vec::new(),
            tail: Option::Some(
                Expr::Call {
                    func: Expr::Callable {
                        callable: Callable::Function(default_name),
                        ty: function_ty,
                    },
                    args,
                    ty: ret_ty,
                },
            ),
        },
    }
}

fn validate_inherent_impl(ctx: Checker, for_type: Type, methods: Vec[Function]) -> () {
    let seen: collections::HashSet[string] = collections::HashSet::new();
    for method in methods {
        if !seen.insert(method.name) {
            push_diagnostic(
                ctx,
                "Method " + method.name + " implemented multiple times in impl for "
                    + type_text(for_type),
            )
        }
    }
}

fn copied_names(values: Vec[string]) -> Vec[string] {
    let result: Vec[string] = Vec::new();
    for value in values {
        result.push(value)
    }
    result
}

fn struct_application_parts(value: Type) -> Option[(string, Vec[Type])] {
    match prune(value) {
        Con { name } => Option::Some((name, Vec::new())),
        App { ty: Con { name }, args } => Option::Some((name, args)),
        _ => Option::None,
    }
}

fn by_value_type_has_cycle(ctx: Checker, value: Type, active: Vec[string]) -> bool {
    match prune(normalize_type(ctx, value)) {
        Tuple { items: values } => {
            for value in values {
                if by_value_type_has_cycle(ctx, value, active) {
                    return true
                }
            }
            false
        },
        Array { len: _, elem } => by_value_type_has_cycle(ctx, elem, active),
        value => match struct_application_parts(value) {
            Some(parts) => match find_struct_by_name(ctx, parts.0) {
                Some(info) => if active.contains(info.name) {
                    true
                } else {
                    let next = copied_names(active);
                    next.push(info.name);
                    for field in info.fields {
                        if by_value_type_has_cycle(
                            ctx,
                            substitute_params(field.1, info.generics, parts.1),
                            next,
                        ) {
                            return true
                        }
                    }
                    false
                },
                None => false,
            },
            None => false,
        },
    }
}

fn validate_struct_sizes(ctx: Checker, struct_count: isize) -> () {
    for index in 0..struct_count {
        let info = ctx.structs[index];
        let active = Vec::from_array([info.name]);
        for field in info.fields {
            if by_value_type_has_cycle(ctx, field.1, active) {
                push_diagnostic(
                    ctx,
                    "Struct " + info.name + " has infinite size due to recursive field; use Ref["
                        + info.name
                        + "] for indirection",
                );
                break
            }
        }
    }
}

fn supertrait_path(
    ctx: Checker,
    current: string,
    target: string,
    active: Vec[string],
    path: Vec[string],
) -> bool {
    if names_match(current, target) {
        true
    } else if active.contains(current) {
        false
    } else {
        active.push(current);
        if let Some(info) = find_trait(ctx, current) {
            for reference in info.supertraits {
                let length = path.len();
                path.push(short_name(reference.name));
                if supertrait_path(ctx, reference.name, target, active, path) {
                    active.truncate(active.len() - 1);
                    return true
                } else {
                    path.truncate(length)
                }
            }
        }
        active.truncate(active.len() - 1);
        false
    }
}

fn cycle_text(values: Vec[string]) -> string {
    text::join(values, " -> ")
}

fn validate_supertrait_cycles(ctx: Checker, trait_count: isize) -> () {
    for index in 0..trait_count {
        let info = ctx.traits[index];
        for reference in info.supertraits {
            let path = Vec::from_array([short_name(info.name), short_name(reference.name)]);
            if supertrait_path(ctx, reference.name, info.name, Vec::new(), path) {
                push_diagnostic_at(
                    ctx,
                    "Supertrait cycle detected: " + cycle_text(path),
                    Option::None,
                );
                return
            }
        }
    }
}

fn validate_local_definitions(
    ctx: Checker,
    enum_count: isize,
    struct_count: isize,
    trait_count: isize,
) -> () {
    for index in 0..enum_count {
        for variant in ctx.enums[index].variants {
            for field in enum_variant_field_types(variant.fields) {
                validate_signature_type(ctx, field)
            }
        }
    }
    for index in 0..struct_count {
        for field in ctx.structs[index].fields {
            validate_signature_type(ctx, field.1)
        }
    }
    validate_struct_sizes(ctx, struct_count);
    validate_supertrait_cycles(ctx, trait_count);
    for index in 0..trait_count {
        let info = ctx.traits[index];
        for predicate in info.predicates {
            match predicate {
                GoComparable(ty) => validate_signature_type(ctx, ty),
                Trait { for_ty, trait_ref: reference } => {
                    validate_signature_type(ctx, for_ty);
                    validate_trait_reference(ctx, reference)
                },
                Equality { lhs: left, rhs: right } => {
                    validate_signature_type(ctx, left);
                    validate_signature_type(ctx, right)
                },
            }
        }
        for reference in info.supertraits {
            validate_trait_reference(ctx, reference)
        }
        for associated in info.associated_types {
            for reference in associated.bounds {
                validate_trait_reference(ctx, reference)
            }
        }
        for method in info.methods {
            for predicate in method.predicates {
                match predicate {
                    GoComparable(ty) => validate_signature_type(ctx, ty),
                    Trait { for_ty, trait_ref: reference } => {
                        validate_signature_type(ctx, for_ty);
                        validate_trait_reference(ctx, reference)
                    },
                    Equality { lhs, rhs } => {
                        validate_signature_type(ctx, lhs);
                        validate_signature_type(ctx, rhs)
                    },
                }
            }
            for param in method.params {
                validate_signature_type(ctx, param)
            }
            validate_signature_type(ctx, method.ret_ty)
        }
    }
}

fn builtin_enum_definitions(builtin: BuiltinContract) -> Vec[EnumDef] {
    let result: Vec[EnumDef] = Vec::new();
    for value in builtin_source_enum_infos() {
        let variants: Vec[EnumVariantDef] = Vec::new();
        for variant in value.variants {
            variants.push(EnumVariantDef { name: variant.name, fields: variant.fields })
        }
        let option_variants = enum_option_variants(builtin, value.name, variants);
        result.push(
            EnumDef {
                map_requirements: value.map_requirements,
                name: value.name,
                generics: value.generics,
                variants,
                option_variants,
            },
        )
    }
    result
}

fn enum_option_variants(builtin: BuiltinContract, name: string, variants: Vec[EnumVariantDef]) -> Option[
    (string, string),
] {
    if !names_match(name, builtin.option.name) {
        return Option::None
    }
    let expected_some = builtin.option.some.name;
    let expected_none = builtin.option.none.name;
    let some_name = Ref::new(Option::None);
    let none_name = Ref::new(Option::None);
    let payload_name = Ref::new(Option::None);
    let empty_name = Ref::new(Option::None);
    let payload_count = Ref::new(0);
    let empty_count = Ref::new(0);
    for variant in variants {
        let fields = enum_variant_field_types(variant.fields);
        if fields.len() == 1 {
            payload_count.set(payload_count.get() + 1);
            payload_name.set(Option::Some(variant.name));
            if variant.name == expected_some {
                some_name.set(Option::Some(variant.name))
            }
        } else if fields.is_empty() {
            empty_count.set(empty_count.get() + 1);
            empty_name.set(Option::Some(variant.name));
            if variant.name == expected_none {
                none_name.set(Option::Some(variant.name))
            }
        }
    }
    match (some_name.get(), none_name.get()) {
        (Some(some), Some(none)) => Option::Some((some, none)),
        _ => if payload_count.get() == 1 && empty_count.get() == 1 {
            match (payload_name.get(), empty_name.get()) {
                (Some(some), Some(none)) => Option::Some((some, none)),
                _ => Option::None,
            }
        } else {
            Option::None
        },
    }
}

fn push_declaration_diagnostic(ctx: Checker, message: string) -> () {
    push_diagnostic_at(ctx, message, Option::None)
}

fn validate_type_parameter_names(ctx: Checker, values: Vec[string]) -> () {
    let names: collections::HashSet[string] = collections::HashSet::new();
    for name in values {
        if !names.insert(name) {
            push_declaration_diagnostic(
                ctx,
                "type parameter " + name + " is defined multiple times",
            )
        }
    }
}

fn validate_function_parameter_names(ctx: Checker, value: hir::Function) -> () {
    let names: collections::HashSet[string] = collections::HashSet::new();
    for param in value.params {
        let name = param.0.hint;
        if !names.insert(name) {
            push_declaration_diagnostic(ctx, "parameter " + name + " is defined multiple times")
        }
    }
}

fn validate_enum_variant_names(ctx: Checker, value: hir::EnumDef) -> () {
    let names: collections::HashSet[string] = collections::HashSet::new();
    for variant in value.variants {
        if !names.insert(variant.name) {
            push_declaration_diagnostic(
                ctx,
                "variant " + variant.name + " is defined multiple times in enum " + value.name,
            )
        }
        if let Struct(fields) = variant.fields {
            let field_names: collections::HashSet[string] = collections::HashSet::new();
            for field in fields {
                if !field_names.insert(field.0) {
                    push_declaration_diagnostic(
                        ctx,
                        "field " + field.0 + " is defined multiple times in variant " + value.name
                            + "::"
                            + variant.name,
                    )
                }
            }
        }
    }
}

fn validate_struct_field_names(ctx: Checker, value: hir::StructDef) -> () {
    let names: collections::HashSet[string] = collections::HashSet::new();
    for field in value.fields {
        if !names.insert(field.0) {
            push_declaration_diagnostic(
                ctx,
                "field " + field.0 + " is defined multiple times in struct " + value.name,
            )
        }
    }
}

fn validate_trait_member_names(ctx: Checker, value: hir::TraitDef) -> () {
    let methods: collections::HashSet[string] = collections::HashSet::new();
    for method in value.method_sigs {
        if !methods.insert(method.name) {
            push_declaration_diagnostic(
                ctx,
                "method " + method.name + " is defined multiple times in trait " + value.name,
            )
        }
    }
    let associated_types: collections::HashSet[string] = collections::HashSet::new();
    for associated in value.associated_types {
        if !associated_types.insert(associated.name) {
            push_declaration_diagnostic(
                ctx,
                "associated type " + associated.name + " is defined multiple times in trait "
                    + value.name,
            )
        }
    }
}

fn nominal_kind_name(kind: isize) -> string {
    if kind == 1 {
        "enum"
    } else if kind == 2 {
        "struct"
    } else {
        "type alias"
    }
}

fn mixed_nominal_declaration_message(name: string, first: isize, second: isize) -> string {
    if (first == 1 && second == 2) || (first == 2 && second == 1) {
        "type " + name + " is defined as both a struct and an enum"
    } else {
        "type " + name + " is defined as both a " + nominal_kind_name(first) + " and a "
            + nominal_kind_name(second)
    }
}

fn value_kind_name(kind: isize) -> string {
    if kind == 1 {
        "function"
    } else {
        "constant"
    }
}

fn mixed_value_declaration_message(name: string) -> string {
    "value " + name + " is defined as both a function and a constant"
}

fn validate_file_declaration_names(ctx: Checker, value: hir::File) -> () {
    let nominal_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
    let function_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
    for item in value.items {
        let nominal = match item {
            EnumDef(definition) => Option::Some((definition.name, 1)),
            StructDef(definition) => Option::Some((definition.name, 2)),
            TypeAlias(definition) => Option::Some((definition.name, 3)),
            ExternType(definition) => Option::Some((definition.name, 3)),
            _ => Option::None,
        };
        if let Some(value) = nominal {
            match nominal_kinds.get(value.0) {
                Some(previous) => if previous == value.1 {
                    push_declaration_diagnostic(
                        ctx,
                        (if value.1 == 1 {
                            "enum "
                        } else if value.1 == 2 {
                            "struct "
                        } else {
                            "type alias "
                        })
                            + value.0
                            + " is defined multiple times",
                    )
                } else {
                    push_declaration_diagnostic(
                        ctx,
                        mixed_nominal_declaration_message(value.0, previous, value.1),
                    )
                },
                None => {
                    let _ = nominal_kinds.insert(value.0, value.1);
                },
            }
        }
        let function_name = match item {
            Function(function) => Option::Some((function.name, 1)),
            ExternFunction(function) => Option::Some((function.name, 1)),
            Constant(value) => Option::Some((value.name, 2)),
            Static(value) => Option::Some((value.name, 2)),
            _ => Option::None,
        };
        if let Some(value) = function_name {
            match function_kinds.get(value.0) {
                Some(previous) => if previous == value.1 {
                    push_declaration_diagnostic(
                        ctx,
                        value_kind_name(value.1) + " " + value.0 + " is defined multiple times",
                    )
                } else {
                    push_declaration_diagnostic(ctx, mixed_value_declaration_message(value.0))
                },
                None => {
                    let _ = function_kinds.insert(value.0, value.1);
                },
            }
        }
    }
    for item in value.items {
        match item {
            EnumDef(definition) => {
                validate_type_parameter_names(ctx, definition.generics);
                validate_enum_variant_names(ctx, definition)
            },
            StructDef(definition) => {
                validate_type_parameter_names(ctx, definition.generics);
                validate_struct_field_names(ctx, definition)
            },
            TraitDef(definition) => {
                validate_type_parameter_names(ctx, definition.generics);
                validate_trait_member_names(ctx, definition);
                for method in definition.method_sigs {
                    validate_type_parameter_names(
                        ctx,
                        append_names(definition.generics, method.generics),
                    )
                }
            },
            ImplBlock(block) => {
                validate_type_parameter_names(ctx, block.generics);
                for method in block.methods {
                    validate_type_parameter_names(
                        ctx,
                        append_names(block.generics, method.generics),
                    );
                    validate_function_parameter_names(ctx, method)
                }
            },
            Function(function) => {
                validate_type_parameter_names(ctx, function.generics);
                validate_function_parameter_names(ctx, function)
            },
            ExternFunction(function) => {
                validate_type_parameter_names(ctx, function.generics)
            },
            ExternType(definition) => {
                validate_type_parameter_names(ctx, definition.generics);
                if find_type_alias(ctx, definition.name).is_none() {
                    push_diagnostic_at(
                        ctx,
                        "external type metadata is not yet connected: " + definition.name,
                        Option::Some(definition.name_span),
                    )
                }
            },
            TypeAlias(alias) => {
                validate_type_parameter_names(ctx, alias.generics)
            },
            Constant(_) => (),
            Static(_) => (),
        }
    }
}

fn validate_cross_file_declaration_names(
    ctx: Checker,
    value: hir::File,
    package_files: Vec[hir::File],
) -> () {
    let files: Vec[hir::File] = Vec::new();
    files.push(value);
    for file in package_files {
        files.push(file)
    }
    let nominal_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
    let function_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
    for file in files {
        let local_nominal_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
        let local_function_kinds: collections::IndexMap[string, isize] = collections::IndexMap::new();
        for item in file.items {
            let nominal = match item {
                EnumDef(definition) => Option::Some((definition.name, 1)),
                StructDef(definition) => Option::Some((definition.name, 2)),
                TypeAlias(definition) => Option::Some((definition.name, 3)),
                ExternType(definition) => Option::Some((definition.name, 3)),
                _ => Option::None,
            };
            if let Some(value) = nominal {
                if !local_nominal_kinds.contains(value.0) {
                    let _ = local_nominal_kinds.insert(value.0, value.1);
                }
            }
            let function_name = match item {
                Function(function) => Option::Some((function.name, 1)),
                ExternFunction(function) => Option::Some((function.name, 1)),
                Constant(value) => Option::Some((value.name, 2)),
                _ => Option::None,
            };
            if let Some(value) = function_name {
                if !local_function_kinds.contains(value.0) {
                    let _ = local_function_kinds.insert(value.0, value.1);
                }
            }
        }
        for (name, kind) in local_nominal_kinds {
            match nominal_kinds.get(name) {
                Some(previous) => if previous == kind {
                    push_global_diagnostic(
                        ctx,
                        (if kind == 1 {
                            "enum "
                        } else if kind == 2 {
                            "struct "
                        } else {
                            "type alias "
                        })
                            + name
                            + " is defined multiple times",
                    )
                } else {
                    push_global_diagnostic(
                        ctx,
                        mixed_nominal_declaration_message(name, previous, kind),
                    )
                },
                None => {
                    let _ = nominal_kinds.insert(name, kind);
                },
            }
        }
        for (name, kind) in local_function_kinds {
            match function_kinds.get(name) {
                Some(previous) => if previous == kind {
                    push_global_diagnostic(
                        ctx,
                        value_kind_name(kind) + " " + name + " is defined multiple times",
                    )
                } else {
                    push_global_diagnostic(ctx, mixed_value_declaration_message(name))
                },
                None => {
                    let _ = function_kinds.insert(name, kind);
                },
            }
        }
    }
}

fn validate_extern_declarations(ctx: Checker) -> () {
    for value in ctx.rejected_externs {
        if value.local {
            ctx.diagnostics.push(
                new_diagnostic(
                    TYPER_STAGE,
                    "extern " + short_name(value.name) + " is not permitted in this source",
                    value.source_path,
                    Option::None,
                ),
            )
        }
    }
}

fn validate_lang_item_attributes(ctx: Checker, attrs: Vec[ast::Attribute], allow_lang_items: bool) -> () {
    if allow_lang_items {} else {
        for attribute in attrs {
            if attribute.name == "lang" {
                let name = lang_item_attribute(Vec::from_array([attribute])).unwrap_or("<invalid>");
                ctx.diagnostics.push(
                    new_diagnostic(
                        TYPER_STAGE,
                        "lang item " + name + " is not permitted in this source",
                        ctx.source_path,
                        Option::None,
                    ),
                )
            }
        }
    }
}

fn validate_lang_item_declarations(ctx: Checker, value: hir::File, allow_lang_items: bool) -> () {
    for item in value.items {
        match item {
            EnumDef(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            StructDef(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            TraitDef(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            Function(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            ExternFunction(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            ExternType(value) => validate_lang_item_attributes(ctx, value.attrs, allow_lang_items),
            TypeAlias(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            Constant(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            Static(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
            ImplBlock(value) => {
                validate_lang_item_attributes(ctx, value.attrs, allow_lang_items)
            },
        }
    }
}

fn comptime_attribute_diagnostic(ctx: Checker, attribute: ast::Attribute, message: string) -> () {
    ctx.diagnostics.push(
        new_diagnostic(TYPER_STAGE, message, ctx.source_path, Option::Some(attribute.span)),
    )
}

fn validate_comptime_attributes(
    ctx: Checker,
    attrs: Vec[ast::Attribute],
    free_function: bool,
    generic: bool,
) -> () {
    let mut count = 0;
    let mut derive_count = 0;
    for attribute in attrs {
        if attribute.name == "comptime" {
            count += 1;
            if !free_function {
                comptime_attribute_diagnostic(
                    ctx,
                    attribute,
                    "#[comptime] is only valid on free function declarations",
                )
            } else {
                if attribute.has_argument_list {
                    comptime_attribute_diagnostic(
                        ctx,
                        attribute,
                        "#[comptime] does not accept arguments",
                    )
                }
                if count > 1 {
                    comptime_attribute_diagnostic(ctx, attribute, "duplicate #[comptime] attribute")
                }
                if generic {
                    comptime_attribute_diagnostic(
                        ctx,
                        attribute,
                        "#[comptime] functions cannot declare generic parameters or predicates",
                    )
                }
            }
        } else if attribute.name == "comptime_derive" {
            derive_count += 1;
            if !free_function {
                comptime_attribute_diagnostic(
                    ctx,
                    attribute,
                    "#[comptime_derive] is only valid on free function declarations",
                )
            } else {
                if !valid_comptime_derive_attribute(attribute) {
                    comptime_attribute_diagnostic(
                        ctx,
                        attribute,
                        "#[comptime_derive] accepts at most one identifier export name",
                    )
                }
                if derive_count > 1 {
                    comptime_attribute_diagnostic(
                        ctx,
                        attribute,
                        "duplicate #[comptime_derive] attribute",
                    )
                }
                if generic {
                    comptime_attribute_diagnostic(
                        ctx,
                        attribute,
                        "#[comptime_derive] functions cannot declare generic parameters or predicates",
                    )
                }
            }
        }
    }
    if count > 0 && derive_count > 0 {
        for attribute in attrs {
            if attribute.name == "comptime_derive" {
                comptime_attribute_diagnostic(
                    ctx,
                    attribute,
                    "function cannot be both #[comptime] and #[comptime_derive]",
                )
            }
        }
    }
}

fn validate_comptime_declarations(ctx: Checker, value: hir::File) -> () {
    for item in value.items {
        match item {
            Function(value) => validate_comptime_attributes(
                ctx,
                value.attrs,
                true,
                !value.generics.is_empty() || !value.generic_bounds.is_empty()
                    || !value.predicates.is_empty(),
            ),
            ImplBlock(value) => {
                validate_comptime_attributes(ctx, value.attrs, false, false);
                for method in value.methods {
                    validate_comptime_attributes(ctx, method.attrs, false, false)
                }
            },
            EnumDef(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            StructDef(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            TraitDef(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            ExternFunction(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            ExternType(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            TypeAlias(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            Constant(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
            Static(value) => validate_comptime_attributes(ctx, value.attrs, false, false),
        }
    }
}

fn move_diagnostics_before(values: Vec[Diagnostic], message: string, anchor: string) -> Vec[
    Diagnostic,
] {
    let anchor_index = diagnostic_message_index(values, anchor);
    if anchor_index < 0 {
        values
    } else {
        let moved: Vec[Diagnostic] = Vec::new();
        for value in values {
            if value.message == message {
                moved.push(value)
            }
        }
        let result: Vec[Diagnostic] = Vec::new();
        for index in 0..values.len() {
            let value = values[index];
            if value.message == message {} else {
                if index == anchor_index {
                    for diagnostic in moved {
                        result.push(diagnostic)
                    }
                }
                result.push(value)
            }
        }
        result
    }
}

fn diagnostic_message_index(values: Vec[Diagnostic], message: string) -> isize {
    for index in 0..values.len() {
        if values[index].message == message {
            return index
        }
    };
    -1
}

fn diagnostics_have_message(values: Vec[Diagnostic], message: string) -> bool {
    for value in values {
        if value.message == message {
            return true
        }
    }
    false
}

fn order_extern_diagnostics(ctx: Checker) -> Vec[Diagnostic] {
    let mut result = ctx.diagnostics;
    for value in ctx.rejected_externs {
        if value.local {
            let name = short_name(value.name);
            result = move_diagnostics_before(
                result,
                "Internal error: Function " + name + " not found in environment",
                "extern " + name + " is not permitted in this source",
            );
        }
    }
    result
}

fn attach_diagnostic_span(ctx: Checker, message: string, span: Option[ast::Span]) -> () {
    if let Some(span) = span {
        for index in 0..ctx.diagnostics.len() {
            let value = ctx.diagnostics[index];
            if value.message == message && value.source_path == ctx.source_path {
                ctx.diagnostics.set(
                    index,
                    Diagnostic {
                        severity: value.severity,
                        stage: value.stage,
                        message: value.message,
                        source_path: value.source_path,
                        span: Option::Some(span),
                        primary_label: value.primary_label,
                        secondary_labels: value.secondary_labels,
                        sort_order: value.sort_order,
                    },
                );
                return
            }
        }
    }
}

fn attach_type_diagnostic_span(ctx: Checker, value: hir::TypeExpr, span: Option[ast::Span]) -> () {
    match value {
        Con { name } => match nominal_arity(ctx, name) {
            Some(expected) => if expected != 0 {
                attach_diagnostic_span(
                    ctx,
                    "Type " + short_name(name) + f" expects {expected} type arguments, but got 0",
                    span,
                )
            },
            None => attach_diagnostic_span(ctx, "Unknown type constructor " + name, span),
        },
        App { ty, args } => {
            match ty {
                Con { name } => match nominal_arity(ctx, name) {
                    Some(expected) => if expected != args.len() {
                        let category = if expected == 0 && !args.is_empty() {
                            match find_struct_by_name(ctx, name) {
                                Some(_) => "Struct",
                                None => "Type",
                            }
                        } else {
                            "Type"
                        };
                        attach_diagnostic_span(
                            ctx,
                            category + " " + short_name(name)
                                + f" expects {expected} type arguments, but got {args.len()}",
                            span,
                        )
                    },
                    None => attach_type_diagnostic_span(ctx, ty, span),
                },
                _ => attach_type_diagnostic_span(ctx, ty, span),
            }
            for arg in args {
                attach_type_diagnostic_span(ctx, arg, span)
            }
        },
        _ => (),
    }
}

fn attach_trait_ref_diagnostic_spans(ctx: Checker, value: hir::TraitRef) -> () {
    for index in 0..value.args.len() {
        attach_type_diagnostic_span(
            ctx,
            value.args[index],
            if index < value.arg_spans.len() {
                value.arg_spans[index]
            } else {
                Option::None
            },
        )
    }
}

fn attach_expr_list_diagnostic_spans(ctx: Checker, values: Vec[hir::Expr]) -> () {
    for value in values {
        attach_expr_diagnostic_spans(ctx, value)
    }
}

fn attach_block_diagnostic_spans(ctx: Checker, value: hir::Block) -> () {
    for stmt in value.stmts {
        match stmt {
            Defer { expr } => attach_expr_diagnostic_spans(ctx, expr),
            Let { is_mut: _, pat: _, annotation: _, value, else_branch } => {
                attach_expr_diagnostic_spans(ctx, value);
                if let Some(value) = else_branch {
                    attach_expr_diagnostic_spans(ctx, value)
                }
            },
            Assign { target, op: _, value } => {
                attach_expr_diagnostic_spans(ctx, target);
                attach_expr_diagnostic_spans(ctx, value)
            },
            Expr { expr } => attach_expr_diagnostic_spans(ctx, expr),
        }
    }
    if let Some(expr) = value.tail {
        attach_expr_diagnostic_spans(ctx, expr)
    }
}

fn attach_expr_diagnostic_spans(ctx: Checker, value: hir::Expr) -> () {
    match value.kind {
        StaticMember {
            owner: _,
            member: _,
            owner_type_args,
            owner_type_arg_spans,
            member_type_args,
            member_type_arg_spans,
        } => {
            for index in 0..owner_type_args.len() {
                attach_type_diagnostic_span(
                    ctx,
                    owner_type_args[index],
                    if index < owner_type_arg_spans.len() {
                        owner_type_arg_spans[index]
                    } else {
                        Option::None
                    },
                )
            }
            for index in 0..member_type_args.len() {
                attach_type_diagnostic_span(
                    ctx,
                    member_type_args[index],
                    if index < member_type_arg_spans.len() {
                        member_type_arg_spans[index]
                    } else {
                        Option::None
                    },
                )
            }
        },
        ConstructorValue { constructor: _ } => (),
        Constr { constructor: _, args } | Tuple { items: args } | Array { items: args } => {
            attach_expr_list_diagnostic_spans(ctx, args)
        },
        InterpolatedString { parts } => for part in parts {
            match part {
                Expr(value) => {
                    attach_expr_diagnostic_spans(ctx, value)
                },
                Text(_) => (),
            }
        },
        StructLiteral { name: _, fields, base } => {
            for field in fields {
                attach_expr_diagnostic_spans(ctx, field.1)
            }
            if let Some(value) = base {
                attach_expr_diagnostic_spans(ctx, value)
            }
        },
        Closure { params: _, body } | Unary { op: _, expr: body } | Cast { expr: body, ty: _ } | Try {
            depth: _,
            expr: body,
        } | Proj { tuple: body, index: _ } | Field { expr: body, .. } | Go { expr: body } => {
            attach_expr_diagnostic_spans(ctx, body)
        },
        Match { expr, arms } => {
            attach_expr_diagnostic_spans(ctx, expr);
            for arm in arms {
                if let Some(guard) = arm.guard {
                    attach_expr_diagnostic_spans(ctx, guard)
                }
                attach_expr_diagnostic_spans(ctx, arm.body)
            }
        },
        If { cond, then_branch, else_branch } => {
            attach_expr_diagnostic_spans(ctx, cond);
            attach_expr_diagnostic_spans(ctx, then_branch);
            attach_expr_diagnostic_spans(ctx, else_branch)
        },
        While { cond, body, .. } => {
            attach_expr_diagnostic_spans(ctx, cond);
            attach_expr_diagnostic_spans(ctx, body)
        },
        Loop { body, .. } => attach_expr_diagnostic_spans(ctx, body),
        For { pat: _, iterator, body, .. } => {
            attach_expr_diagnostic_spans(ctx, iterator);
            attach_expr_diagnostic_spans(ctx, body)
        },
        Return { expr } => if let Some(expr) = expr {
            attach_expr_diagnostic_spans(ctx, expr)
        },
        Break { value, .. } => if let Some(expr) = value {
            attach_expr_diagnostic_spans(ctx, expr)
        },
        Call { func, args } => {
            attach_expr_diagnostic_spans(ctx, func);
            attach_expr_list_diagnostic_spans(ctx, args)
        },
        Range { start, end, inclusive: _ } | Binary { op: _, lhs: start, rhs: end } | Index {
            base: start,
            index: end,
        } => {
            attach_expr_diagnostic_spans(ctx, start);
            attach_expr_diagnostic_spans(ctx, end)
        },
        Block { block } => attach_block_diagnostic_spans(ctx, block),
        _ => (),
    }
}

fn attach_file_diagnostic_spans(ctx: Checker, value: hir::File) -> () {
    for item in value.items {
        match item {
            EnumDef(value) => for variant in value.variants {
                match variant.fields {
                    Unit => (),
                    Tuple(types) => {
                        for index in 0..types.len() {
                            attach_type_diagnostic_span(
                                ctx,
                                types[index],
                                if index < variant.field_type_spans.len() {
                                    Option::Some(variant.field_type_spans[index])
                                } else {
                                    Option::None
                                },
                            )
                        }
                    },
                    Struct(values) => {
                        for index in 0..values.len() {
                            attach_type_diagnostic_span(
                                ctx,
                                values[index].1,
                                if index < variant.field_type_spans.len() {
                                    Option::Some(variant.field_type_spans[index])
                                } else {
                                    Option::None
                                },
                            )
                        }
                    },
                }
            },
            StructDef(value) => if value.generics.is_empty() {
                for index in 0..value.fields.len() {
                    attach_type_diagnostic_span(
                        ctx,
                        value.fields[index].1,
                        if index < value.field_type_spans.len() {
                            Option::Some(value.field_type_spans[index])
                        } else {
                            Option::None
                        },
                    )
                }
            },
            TraitDef(value) => {
                for bound in value.generic_bounds {
                    for reference in bound.1 {
                        attach_trait_ref_diagnostic_spans(ctx, reference)
                    }
                }
                for method in value.method_sigs {
                    attach_type_diagnostic_span(ctx, method.ret_ty, method.ret_ty_span)
                }
            },
            Function(value) => {
                for bound in value.generic_bounds {
                    for reference in bound.1 {
                        attach_trait_ref_diagnostic_spans(ctx, reference)
                    }
                }
                attach_block_diagnostic_spans(ctx, value.body)
            },
            ImplBlock(value) => for method in value.methods {
                attach_block_diagnostic_spans(ctx, method.body)
            },
            _ => (),
        }
    }
}

fn check_file_with_package_inferred(
    value: hir::File,
    package_files: Vec[hir::File],
    package_environments: Vec[PackageEnvironment],
    dependencies: Vec[DependencyEnvironment],
    diagnostics: Vec[Diagnostic],
    include_builtin_types: bool,
    validate_function_names: bool,
    allow_externs: bool,
    external_aliases: Vec[TypeAliasInfo],
    inferred: Vec[InferredMapPredicates],
) -> CheckResult {
    let builtin = match builtin_contract() {
        Ok(value) => value,
        Err(error) => {
            diagnostics.push(new_diagnostic("builtin", error, value.source_path, Option::None));
            return CheckResult {
                tast: Option::None,
                comptime: ctir::empty_module(value.package_name),
                pending_constants: Vec::new(),
                diagnostics,
                typeck_results: empty_typeck_results(),
            }
        },
    };
    let ctx = collect_environment_with_external_aliases(
        value,
        allow_externs,
        builtin,
        external_aliases,
    );
    for diagnostic in diagnostics {
        ctx.diagnostics.push(diagnostic)
    }
    for span in value.invalid_self_type_spans {
        push_diagnostic_at(ctx, "Self type is only valid in impl methods", Option::Some(span))
    }
    validate_extern_declarations(ctx);
    validate_lang_item_declarations(ctx, value, allow_externs);
    validate_comptime_declarations(ctx, value);
    validate_file_declaration_names(ctx, value);
    if validate_function_names {
        validate_cross_file_declaration_names(ctx, value, package_files)
    }
    let local_enum_count = ctx.enums.len();
    let local_struct_count = ctx.structs.len();
    let local_trait_count = ctx.traits.len();
    let local_impl_count = ctx.impls.len();
    for package_environment in package_environments {
        append_package_environment(ctx, package_environment)
    }
    for dependency in dependencies {
        append_dependency_environment(ctx, dependency)
    }
    attach_inferred_map_predicates(ctx, inferred);
    append_builtin_source_impls(ctx);
    validate_go_ffi_signatures(ctx, value);
    validate_go_exports(ctx, value, package_files);
    let canonical_traits = collections::IndexSet::new();
    for name in ctx.in_scope_traits {
        let _ = canonical_traits.insert(canonical_imported_name(ctx, name));
    }
    ctx.in_scope_traits = canonical_traits;
    for imported in value.imports {
        let canonical = canonical_imported_name(ctx, imported);
        match find_trait(ctx, canonical) {
            Some(_) => {
                let _ = ctx.in_scope_traits.insert(canonical);
            },
            None => if find_enum_by_name(ctx, canonical).is_some()
                || find_struct_by_name(ctx, canonical).is_some()
                || find_type_alias(ctx, canonical).is_some()
                || find_constant_by_name(ctx, canonical).is_some()
                || find_function_by_name(ctx, canonical).is_some()
                || builtin_nominal_arity(canonical).is_some()
                || scoped_builtin_function_scheme(ctx, imported).is_some() {} else {
                push_diagnostic_at(ctx, "Imported item " + imported + " not found", Option::None)
            },
        }
    }
    for index in 0..ctx.constants.len() {
        let constant = ctx.constants[index];
        ctx.constants.set(
            index,
            ConstantScheme {
                def_id: constant.def_id,
                name: constant.name,
                ty: resolve_signature_type(ctx, constant.ty, Vec::new(), false),
                value: constant.value,
            },
        )
    }
    for index in 0..ctx.enums.len() {
        ctx.enums.set(index, resolve_enum_info_signature(ctx, ctx.enums[index]))
    }
    for index in 0..ctx.structs.len() {
        ctx.structs.set(index, resolve_struct_info_signature(ctx, ctx.structs[index]))
    }
    infer_nominal_map_requirements(ctx);
    for index in 0..ctx.traits.len() {
        ctx.traits.set(index, resolve_trait_info_signature(ctx, ctx.traits[index]))
    }
    for index in 0..ctx.functions.len() {
        ctx.functions.set(index, resolve_function_scheme_signature(ctx, ctx.functions[index]))
    }
    for index in 0..ctx.methods.len() {
        ctx.methods.set(index, resolve_method_info_signature(ctx, ctx.methods[index]))
    }
    for index in 0..ctx.impls.len() {
        ctx.impls.set(index, resolve_impl_info_signature(ctx, ctx.impls[index]))
    }
    for item in value.items {
        if let TypeAlias(alias) = item {
            let previous = ctx.current_span.get();
            ctx.current_span.set(Option::Some(alias.ty_span));
            let _ = resolve_signature_type(
                ctx,
                type_from_hir(ctx.builtin, alias.ty, alias.generics, Option::None),
                Vec::new(),
                true,
            );
            ctx.current_span.set(previous)
        }
    }
    for trait_name in value.use_traits {
        let canonical = canonical_imported_name(ctx, trait_name);
        if let None = find_trait(ctx, canonical) {
            let mut imported = false;
            for name in value.imports {
                if canonical_imported_name(ctx, name) == canonical {
                    imported = true;
                }
            }
            if imported {} else {
                push_global_diagnostic(ctx, INFERENCE_FAILURE_MESSAGE);
                push_diagnostic_at(ctx, "Unknown trait " + canonical, Option::None)
            }
        }
    }
    append_default_trait_method_schemes(ctx);
    validate_local_definitions(ctx, local_enum_count, local_struct_count, local_trait_count);
    expand_in_scope_supertraits(ctx);
    validate_impl_overlaps(ctx, local_impl_count);
    let constants: Vec[Constant] = Vec::new();
    let statics: Vec[Static] = Vec::new();
    let pending_constants: Vec[PendingConstant] = Vec::new();
    for item in value.items {
        match item {
            Constant(value) => {
                let checked = check_constant(ctx, value);
                if let Some(value) = checked.0 {
                    constants.push(value)
                }
                if let Some(value) = checked.1 {
                    pending_constants.push(value)
                }
            },
            Static(value) => statics.push(check_static(ctx, value)),
            _ => (),
        }
    }
    validate_constant_cycles(ctx, constants);
    let pattern_dependencies: Vec[ctir::CtModule] = Vec::new();
    for dependency in dependencies {
        if let Some(module) = dependency.comptime {
            pattern_dependencies.push(module)
        }
    }
    let pattern_values = evaluate_pattern_constants(
        ctx.builtin,
        File {
            items: Vec::new(),
            enums: Vec::new(),
            structs: Vec::new(),
            constants,
            statics: Vec::new(),
        },
        ctx.package_name,
        pattern_dependencies,
    );
    for index in 0..ctx.constants.len() {
        let scheme = ctx.constants[index];
        let mut resolved = scheme.value;
        for value in pattern_values {
            if value.0 == scheme.name {
                resolved = Option::Some(value.1);
            }
        }
        ctx.constants.set(
            index,
            ConstantScheme {
                def_id: scheme.def_id,
                name: scheme.name,
                ty: scheme.ty,
                value: resolved,
            },
        )
    }
    let items: Vec[Item] = Vec::new();
    for item in value.items {
        match item {
            ImplBlock(value) => items.push(Item::ImplBlock(check_impl(ctx, value))),
            Function(value) => items.push(
                Item::Function(check_function(ctx, value, Vec::new(), Vec::new(), Option::None)),
            ),
            _ => (),
        }
    }
    attach_file_diagnostic_spans(ctx, value);
    let enums = if include_builtin_types {
        builtin_enum_definitions(ctx.builtin)
    } else {
        Vec::new()
    };
    for index in 0..local_enum_count {
        let value = ctx.enums[index];
        let variants: Vec[EnumVariantDef] = Vec::new();
        for variant in value.variants {
            variants.push(EnumVariantDef { name: variant.name, fields: variant.fields })
        }
        let option_variants = enum_option_variants(ctx.builtin, value.name, variants);
        enums.push(
            EnumDef {
                map_requirements: value.map_requirements,
                name: value.name,
                generics: value.generics,
                variants,
                option_variants,
            },
        )
    }
    let structs: Vec[StructDef] = Vec::new();
    for index in 0..local_struct_count {
        let value = ctx.structs[index];
        structs.push(
            StructDef {
                map_requirements: value.map_requirements,
                name: value.name,
                generics: value.generics,
                fields: value.fields,
                public_fields: value.public_fields,
                has_hidden_fields: false,
                go_comparable: Option::Some(struct_key_comparability(ctx, value)),
            },
        )
    }
    CheckResult {
        tast: Option::Some(File { items, enums, structs, constants, statics }),
        comptime: ctir::empty_module(ctx.package_name),
        pending_constants,
        diagnostics: order_extern_diagnostics(ctx),
        typeck_results: ctx.typeck_results,
    }
}

fn contains_impl_method_scheme(
    values: Vec[MethodInfo],
    implementation: ImplInfo,
    method_name: string,
) -> bool {
    for value in values {
        if let Some(reference) = value.trait_ref {
            if value.function.name == method_name
                && trait_ref_equal(reference, implementation.trait_ref)
                && types_equal(value.for_type, implementation.for_type) {
                return true
            }
        }
    }
    false
}

fn default_trait_method_scheme(
    ctx: Checker,
    implementation: ImplInfo,
    info: TraitInfo,
    method: TraitMethodInfo,
) -> MethodInfo {
    let substitutions = trait_substitutions(
        ctx,
        info,
        implementation.trait_ref,
        Option::Some(implementation.for_type),
    );
    let method_substitutions = substitutions;
    for generic in method.generics {
        method_substitutions.push(TypeSubst { name: generic, ty: Type::Param { name: generic } })
    }
    let params: Vec[Type] = Vec::new();
    for param in method.params {
        params.push(substitute_type(param, method_substitutions))
    }
    let callable = match method.default_name {
        Some(name) => Callable::Function(name),
        None => Callable::TraitMethod {
            trait_ref: implementation.trait_ref,
            method_name: method.name,
            for_ty: implementation.for_type,
            has_receiver: method.has_receiver,
        },
    };
    MethodInfo {
        owner_generics: implementation.generics,
        method_generics: method.generics,
        owner_predicate_count: implementation.predicates.len(),
        trait_ref: Option::Some(implementation.trait_ref),
        for_type: implementation.for_type,
        function: FunctionScheme {
            def_id: Option::None,
            name: method.name,
            comptime: ComptimeCapability::RuntimeOnly,
            generics: append_names(implementation.generics, method.generics),
            predicates: append_predicates(
                implementation.predicates,
                canonical_default_predicates(
                    ctx,
                    substitute_predicates(method.predicates, method_substitutions),
                ),
            ),
            params,
            ret_ty: substitute_type(method.ret_ty, method_substitutions),
            callable,
        },
    }
}

fn append_default_trait_method_schemes(ctx: Checker) -> () {
    for implementation in ctx.impls {
        let visible = !builtin_impl(implementation)
            || trait_reference_uses_builtin(ctx, implementation.trait_ref);
        match if visible {
            find_trait(ctx, implementation.trait_ref.name)
        } else {
            Option::None
        } {
            Some(info) => for method in info.methods {
                if method.default_name.is_some()
                    && !contains_impl_method_scheme(ctx.methods, implementation, method.name) {
                    ctx.methods.push(default_trait_method_scheme(ctx, implementation, info, method))
                }
            },
            None => (),
        }
    }
}

fn check_file(
    value: hir::File,
    dependencies: Vec[hir::File],
    diagnostics: Vec[Diagnostic],
    include_builtin_types: bool,
    allow_externs: bool,
) -> CheckResult {
    let environments = match dependency_environments(dependencies) {
        Ok(values) => values,
        Err(error) => {
            diagnostics.push(new_diagnostic("builtin", error, value.source_path, Option::None));
            return CheckResult {
                tast: Option::None,
                comptime: ctir::empty_module(value.package_name),
                pending_constants: Vec::new(),
                diagnostics,
                typeck_results: empty_typeck_results(),
            }
        },
    };
    check_file_with_dependency_environments(
        value,
        environments,
        diagnostics,
        include_builtin_types,
        allow_externs,
    )
}

fn check_file_with_dependency_environments(
    value: hir::File,
    environments: Vec[DependencyEnvironment],
    diagnostics: Vec[Diagnostic],
    include_builtin_types: bool,
    allow_externs: bool,
) -> CheckResult {
    let package_name = value.package_name;
    let checked = check_file_with_package(
        value,
        Vec::new(),
        Vec::new(),
        environments,
        diagnostics,
        include_builtin_types,
        true,
        allow_externs,
        Vec::new(),
    );
    finalize_check_comptime(checked, package_name, Vec::new(), environments)
}

fn dependency_comptime_enums(values: Vec[DependencyEnvironment]) -> Vec[EnumDef] {
    let result: Vec[EnumDef] = Vec::new();
    for dependency in values {
        for value in dependency.enums {
            let variants: Vec[EnumVariantDef] = Vec::new();
            for variant in value.variants {
                variants.push(EnumVariantDef { name: variant.name, fields: variant.fields })
            }
            result.push(
                EnumDef {
                    map_requirements: value.map_requirements,
                    name: value.name,
                    generics: value.generics,
                    variants,
                    option_variants: Option::None,
                },
            )
        }
    }
    result
}

fn dependency_comptime_structs(values: Vec[DependencyEnvironment]) -> Vec[StructDef] {
    let result: Vec[StructDef] = Vec::new();
    for dependency in values {
        for value in dependency.structs {
            result.push(
                StructDef {
                    map_requirements: value.map_requirements,
                    name: value.name,
                    generics: value.generics,
                    fields: value.fields,
                    public_fields: value.public_fields,
                    has_hidden_fields: value.has_hidden_fields,
                    go_comparable: value.go_comparable,
                },
            )
        }
    }
    result
}

fn finalize_check_comptime(
    checked: CheckResult,
    package_name: string,
    dependencies: Vec[ctir::CtModule],
    environments: Vec[DependencyEnvironment],
) -> CheckResult {
    let Ok(builtin) = builtin_contract() else {
        return checked;
    };
    match checked.tast {
        Some(file) => {
            let finalized = finalize_comptime(
                builtin,
                file,
                checked.pending_constants,
                package_name,
                dependencies,
                dependency_comptime_enums(environments),
                dependency_comptime_structs(environments),
            );
            for diagnostic in finalized.diagnostics {
                checked.diagnostics.push(diagnostic)
            }
            for diagnostic in finalized_match_diagnostics(
                finalized.file,
                finalized.module,
                dependencies,
                environments,
            ) {
                checked.diagnostics.push(diagnostic)
            }
            CheckResult {
                tast: Option::Some(finalized.file),
                comptime: finalized.module,
                pending_constants: Vec::new(),
                diagnostics: checked.diagnostics,
                typeck_results: checked.typeck_results,
            }
        },
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module(package_name),
            pending_constants: Vec::new(),
            diagnostics: checked.diagnostics,
            typeck_results: checked.typeck_results,
        },
    }
}

fn check_file_with_implicit_prelude(
    file: hir::File,
    diagnostics: Vec[Diagnostic],
    include_builtins: bool,
) -> CheckResult {
    let dependencies: Vec[DependencyEnvironment] = Vec::new();
    match implicit_builtin_dependency_environment() {
        Ok(environment) => dependencies.push(environment),
        Err(error) => {
            diagnostics.push(new_diagnostic("builtin", error, file.source_path, Option::None));
        },
    }
    let prelude_dependencies = match implicit_prelude_hir_files() {
        Ok(files) => files,
        Err(error) => {
            diagnostics.push(new_diagnostic("prelude", error, file.source_path, Option::None));
            Vec::new()
        },
    };
    match dependency_environments(prelude_dependencies) {
        Ok(values) => for dependency in values {
            dependencies.push(dependency)
        },
        Err(error) => {
            diagnostics.push(new_diagnostic("builtin", error, file.source_path, Option::None))
        },
    }
    check_file_with_dependency_environments(
        file,
        dependencies,
        diagnostics,
        include_builtins,
        false,
    )
}

pub fn check(value: hir::LowerResult) -> CheckResult {
    match value.hir {
        Some(file) => check_file_with_implicit_prelude(
            file,
            diagnostics_from_lower(value.diagnostics, value.source_path),
            true,
        ),
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module("<unknown>"),
            pending_constants: Vec::new(),
            diagnostics: diagnostics_from_lower(value.diagnostics, value.source_path),
            typeck_results: empty_typeck_results(),
        },
    }
}

pub fn check_for_link(value: hir::LowerResult) -> CheckResult {
    match value.hir {
        Some(file) => check_file_with_implicit_prelude(
            file,
            diagnostics_from_lower(value.diagnostics, value.source_path),
            false,
        ),
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module("<unknown>"),
            pending_constants: Vec::new(),
            diagnostics: diagnostics_from_lower(value.diagnostics, value.source_path),
            typeck_results: empty_typeck_results(),
        },
    }
}

pub fn check_for_link_with_dependencies(value: hir::LowerResult, dependencies: Vec[hir::File]) -> CheckResult {
    match value.hir {
        Some(file) => check_file(
            file,
            dependencies,
            diagnostics_from_lower(value.diagnostics, value.source_path),
            false,
            false,
        ),
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module("<unknown>"),
            pending_constants: Vec::new(),
            diagnostics: diagnostics_from_lower(value.diagnostics, value.source_path),
            typeck_results: empty_typeck_results(),
        },
    }
}

pub fn check_for_link_with_environments(
    value: hir::LowerResult,
    dependencies: Vec[DependencyEnvironment],
) -> CheckResult {
    match value.hir {
        Some(file) => check_file_with_dependency_environments(
            file,
            dependencies,
            diagnostics_from_lower(value.diagnostics, value.source_path),
            false,
            false,
        ),
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module("<unknown>"),
            pending_constants: Vec::new(),
            diagnostics: diagnostics_from_lower(value.diagnostics, value.source_path),
            typeck_results: empty_typeck_results(),
        },
    }
}

pub fn check_for_link_with_dependencies_allowing_externs(
    value: hir::LowerResult,
    dependencies: Vec[hir::File],
) -> CheckResult {
    match value.hir {
        Some(file) => check_file(
            file,
            dependencies,
            diagnostics_from_lower(value.diagnostics, value.source_path),
            false,
            true,
        ),
        None => CheckResult {
            tast: Option::None,
            comptime: ctir::empty_module("<unknown>"),
            pending_constants: Vec::new(),
            diagnostics: diagnostics_from_lower(value.diagnostics, value.source_path),
            typeck_results: empty_typeck_results(),
        },
    }
}

pub fn check_package_files_for_link_with_dependencies(
    values: Vec[hir::File],
    dependencies: Vec[hir::File],
) -> CheckResult {
    let dependencies = dependency_environments(dependencies).unwrap_or_else(|_| Vec::new());
    check_package_files_for_link_with_environments_options(
        values,
        dependencies,
        false,
        false,
        Vec::new(),
    )
}

pub fn check_builtin_package_files(values: Vec[hir::File]) -> CheckResult {
    check_package_files_for_link_with_environments_options(
        values,
        Vec::new(),
        true,
        false,
        Vec::new(),
    )
}

pub fn check_package_files_for_link_with_dependencies_allowing_externs(
    values: Vec[hir::File],
    dependencies: Vec[hir::File],
) -> CheckResult {
    let dependencies = dependency_environments(dependencies).unwrap_or_else(|_| Vec::new());
    check_package_files_for_link_with_environments_options(
        values,
        dependencies,
        true,
        false,
        Vec::new(),
    )
}

pub fn check_package_files_for_link_with_environments(
    values: Vec[hir::File],
    dependencies: Vec[DependencyEnvironment],
) -> CheckResult {
    check_package_files_for_link_with_environments_options(
        values,
        dependencies,
        false,
        false,
        Vec::new(),
    )
}

fn check_package_files_for_link_with_environments_pass(
    values: Vec[hir::File],
    dependencies: Vec[DependencyEnvironment],
    allow_externs: bool,
    include_builtin_types: bool,
    external_aliases: Vec[TypeAliasInfo],
    inferred: Vec[InferredMapPredicates],
) -> CheckResult {
    let items: Vec[Item] = Vec::new();
    let enums: Vec[EnumDef] = Vec::new();
    let structs: Vec[StructDef] = Vec::new();
    let constants: Vec[Constant] = Vec::new();
    let statics: Vec[Static] = Vec::new();
    let pending_constants: Vec[PendingConstant] = Vec::new();
    let diagnostics: Vec[Diagnostic] = Vec::new();
    let typeck_results = empty_typeck_results();
    let comptime_dependencies: Vec[ctir::CtModule] = Vec::new();
    for dependency in dependencies {
        if let Some(value) = dependency.comptime {
            comptime_dependencies.push(value)
        }
    }
    let package_environments: Vec[PackageEnvironment] = Vec::new();
    if let Ok(builtin) = builtin_contract() {
        for value in values {
            package_environments.push(
                package_environment_with_external_aliases(
                    value,
                    allow_externs,
                    builtin,
                    external_aliases,
                ),
            )
        }
    }
    let mut valid = true;
    for index in 0..values.len() {
        let package_files: Vec[hir::File] = Vec::new();
        let other_environments: Vec[PackageEnvironment] = Vec::new();
        for other in 0..values.len() {
            if other != index {
                package_files.push(values[other]);
                if other < package_environments.len() {
                    other_environments.push(package_environments[other])
                }
            }
        }
        let checked = check_file_with_package_inferred(
            values[index],
            package_files,
            other_environments,
            dependencies,
            Vec::new(),
            include_builtin_types && index == 0,
            index == 0,
            allow_externs,
            external_aliases,
            inferred,
        );
        for diagnostic in checked.diagnostics {
            diagnostics.push(diagnostic)
        }
        for value in checked.pending_constants {
            pending_constants.push(value)
        }
        append_typeck_results(typeck_results, checked.typeck_results);
        match checked.tast {
            Some(file) => {
                for item in file.items {
                    items.push(item)
                }
                for definition in file.enums {
                    enums.push(definition)
                }
                for definition in file.structs {
                    structs.push(definition)
                }
                for value in file.constants {
                    constants.push(value)
                }
                for value in file.statics {
                    statics.push(value)
                }
            },
            None => {
                valid = false;
            },
        }
    }
    warn_unused_functions(values, diagnostics);
    let diagnostic_source = if !values.is_empty() {
        values[0].source_path
    } else {
        "<unknown>"
    };
    for value in constants {
        let message = "Cyclic constant " + short_name(value.name);
        if constant_reaches(constants, value.name, value.name, collections::HashSet::new())
            && !diagnostics_have_message(diagnostics, message) {
            diagnostics.push(new_diagnostic(TYPER_STAGE, message, diagnostic_source, Option::None))
        }
    }
    let raw = CheckResult {
        tast: if valid {
            Option::Some(File { items, enums, structs, constants, statics })
        } else {
            Option::None
        },
        comptime: ctir::empty_module(diagnostic_source),
        pending_constants,
        diagnostics,
        typeck_results,
    };
    finalize_check_comptime(
        raw,
        if !values.is_empty() {
            values[0].package_name
        } else {
            diagnostic_source
        },
        comptime_dependencies,
        dependencies,
    )
}
