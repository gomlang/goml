package tast;

use module::hir;
use std::testing;

#[test]
fn inferred_map_predicates_accumulate_once_per_definition() -> () {
    let values = Vec::new();
    let first = hir::DefId { pkg: 1, index: 2 };
    let second = hir::DefId { pkg: 2, index: 2 };
    let predicate = TypePredicate::GoComparable(Type::Param { name: "T" });
    let predicates = Vec::from_array([predicate]);
    testing::assert(!record_function_map_predicates(values, first, Vec::new()));
    testing::assert(values.is_empty());
    testing::assert(record_function_map_predicates(values, first, predicates));
    testing::assert(!record_function_map_predicates(values, first, predicates));
    testing::assert_eq(values.len(), 1);
    testing::assert(
        record_function_map_predicates(
            values,
            first,
            Vec::from_array([TypePredicate::GoComparable(Type::Param { name: "U" })]),
        ),
    );
    testing::assert_eq(values.len(), 1);
    testing::assert_eq(inferred_map_predicates(values, first).unwrap_or(Vec::new()).len(), 2);
    testing::assert(inferred_map_predicates(values, second).is_none());
    testing::assert(record_function_map_predicates(values, second, predicates));
    testing::assert_eq(values.len(), 2);
    testing::assert_eq(inferred_map_predicates(values, second).unwrap_or(Vec::new()).len(), 1);
}
