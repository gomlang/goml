package tast;

pub fn integer_range_pattern_endpoint(value: Primitive) -> Option[string] {
    match value {
        Int { value } | Int8 { value } | Int16 { value } | Int32 { value } | Int64 { value } | Uint {
            value,
        } | Uint8 { value } | Uint16 { value } | Uint32 { value } | Uint64 { value } => Some(value),
        _ => None,
    }
}
