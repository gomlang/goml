package tast;

use module::hir;
use module::consts;
use std::collections;
use std::testing;

#[test]
fn hir_bound_types_do_not_resolve_against_use_site_parameters() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let nominal = hir::TypeExpr {
        kind: hir::TypeKind::Named {
            reference: hir::TypeReference::Definition {
                definition: hir::source_definition("example::model", 0),
                name: "example::model::T",
            },
        },
        span: Option::None,
    };
    let parameter = hir::TypeExpr { kind: hir::TypeKind::Param { name: "T" }, span: Option::None };
    testing::assert(
        types_equal(
            type_from_hir(builtin, nominal, Vec::from_array(["example::model::T"]), Option::None),
            Con { name: "example::model::T" },
        ),
    );
    testing::assert(
        types_equal(
            type_from_hir(builtin, parameter, Vec::new(), Option::None),
            Param { name: "T" },
        ),
    );
    testing::assert(
        types_equal(
            type_from_hir(
                builtin,
                hir::TypeExpr { kind: hir::TypeKind::SelfType, span: Option::None },
                Vec::new(),
                Option::Some(Type::Bool),
            ),
            Type::Bool,
        ),
    );
}

#[test]
fn hir_symbolic_array_lengths_keep_const_parameters() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let length = hir::ConstExpr {
        kind: hir::ConstKind::Binary {
            op: "+",
            left: hir::ConstExpr { kind: hir::ConstKind::Param("N"), span: Option::None },
            right: hir::ConstExpr { kind: hir::ConstKind::Value(1), span: Option::None },
        },
        span: Option::None,
    };
    let value = hir::TypeExpr {
        kind: hir::TypeKind::Array {
            len: length,
            elem: hir::TypeExpr { kind: hir::TypeKind::Bool, span: Option::None },
        },
        span: Option::None,
    };
    let ty = type_from_hir(builtin, value, Vec::new(), Option::None);
    testing::assert(symbolic_array(ty).is_some());
    let concrete = substitute_type(
        ty,
        Vec::from_array([TypeSubst { name: consts::parameter("N"), ty: const_type(2) }]),
    );
    testing::assert(types_equal(concrete, Type::Array { len: 3, elem: Type::Bool }));
}

#[test]
fn hir_invalid_array_lengths_remain_error_types() -> () {
    let Ok(builtin) = builtin_contract() else {
        testing::fail("missing builtin contract");
        return
    };
    let invalid = hir::ConstExpr {
        kind: hir::ConstKind::Binary {
            op: "+",
            left: hir::ConstExpr { kind: hir::ConstKind::Error, span: Option::None },
            right: hir::ConstExpr { kind: hir::ConstKind::Value(1), span: Option::None },
        },
        span: Option::None,
    };
    let value = hir::TypeExpr {
        kind: hir::TypeKind::Array {
            len: invalid,
            elem: hir::TypeExpr { kind: hir::TypeKind::Bool, span: Option::None },
        },
        span: Option::None,
    };
    testing::assert(
        match type_from_hir(builtin, value, Vec::new(), Option::None) {
            Type::Error => true,
            _ => false,
        },
    );
}

#[test]
fn hir_unresolved_generic_arguments_preserve_diagnostic_locations() -> () {
    let source = "enum Value[T] { Empty } fn test() -> () { let _ = Value::[Missing]::Empty; }";
    let diagnostics = checked_diagnostics(source);
    let mut found = false;
    for diagnostic in diagnostics {
        if diagnostic.message == "Unknown type constructor Missing" {
            let span = testing::expect_some(diagnostic.span, "expected generic argument location");
            testing::assert_eq(source.byte_slice(span.start, span.end), "Missing");
            found = true;
        }
    }
    testing::assert(found);
}

#[test]
fn hir_repeated_type_errors_keep_distinct_diagnostic_locations() -> () {
    let source = "struct First { value: Missing } struct Second { value: Missing }";
    let diagnostics = checked_diagnostics(source);
    let positions: collections::HashSet[isize] = collections::HashSet::new();
    for diagnostic in diagnostics {
        if diagnostic.message == "Unknown type constructor Missing" {
            if let Some(span) = diagnostic.span {
                testing::assert_eq(source.byte_slice(span.start, span.end), "Missing");
                let _ = positions.insert(span.start);
            }
        }
    }
    testing::assert_eq(positions.len(), 2);
}
