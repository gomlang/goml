package tast;

use std::testing;

#[test]
fn const_generics_infer_lengths_and_keep_distinct_instances() -> () {
    let _ = checked_file(
        "struct Buffer[T, const N: usize] { values: [T; N] } fn first[T, const N: usize](values: [T; N]) -> T { values[0] } fn count[const N: usize](values: [i32; N]) -> usize { N } fn main() -> () { let short: Buffer[i32, 2] = Buffer { values: [1, 2] }; let long: Buffer[i32, 3] = Buffer { values: [3, 4, 5] }; let _a: i32 = first(short.values); let _b: i32 = first::[i32, 3](long.values); let _n: usize = count(long.values); }",
    );
    testing::assert(
        !checked_diagnostics(
            "struct Buffer[const N: usize] { values: [i32; N] } fn invalid(value: Buffer[2]) -> Buffer[3] { value }",
        ).is_empty(),
    );
    testing::assert(
        !checked_diagnostics(
            "fn count[const N: usize]() -> usize { N } fn invalid() -> usize { count::[string]() }",
        ).is_empty(),
    );
}

#[test]
fn checks_integer_array_expressions_and_associated_constants() -> () {
    let _ = checked_file(
        "const WIDTH: usize = 2; trait Measure { const WIDTH: usize; const DEFAULT: i32 = 9; } struct Packet {} impl Packet { pub const HEADER: usize = 2; } impl Measure for Packet { const WIDTH: usize = 4; } fn width[T: Measure]() -> usize { T::WIDTH } fn main() -> () { let _values: [i32; WIDTH + 1] = [1, 2, 3]; let _header: [i32; Packet::HEADER] = [1, 2]; let _width: usize = width::[Packet](); let _default: i32 = Packet::DEFAULT; }",
    );
    testing::assert(
        !checked_diagnostics(
            "trait Measure { const WIDTH: usize; } struct Packet {} impl Measure for Packet {}",
        ).is_empty(),
    );
}
