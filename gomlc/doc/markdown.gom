package doc;

use module::doc_comment;
use module::query;
use std::text;

pub fn escape_html(value: string) -> string {
    let result = text::StringBuilder::new();
    for character in value.chars() {
        result.write_string(
            match character {
                '&' => "&amp;",
                '<' => "&lt;",
                '>' => "&gt;",
                '"' => "&quot;",
                '\'' => "&#39;",
                _ => character.to_string(),
            },
        )
    }
    result.finish()
}

fn safe_url(value: string) -> bool {
    if !(value.starts_with("https://") || value.starts_with("http://")
        || value.starts_with("mailto:")
        || value.starts_with("#")) {
        return false
    }
    for character in value.chars() {
        if character <= ' ' || character == '\\' {
            return false
        }
    }
    true
}

fn inline_html(value: string, links: Vec[query::DocLink], urls: HashMap[string, string]) -> string {
    let result = text::StringBuilder::new();
    let mut cursor = 0;
    let mut plain = 0;
    while cursor < value.byte_len() {
        let mut end = cursor;
        let mut rendered = "";
        if value.byte_get(cursor) == b'`' {
            let mut close = cursor + 1;
            while close < value.byte_len() && value.byte_get(close) != b'`' {
                close += 1;
            }
            if close < value.byte_len() {
                rendered = "<code>" + escape_html(value.byte_slice(cursor + 1, close)) + "</code>";
                end = close + 1;
            }
        } else if let Some(link) = doc_comment::link_at(value, cursor) {
            let mut destination = "";
            if link.reference {
                for resolved in links {
                    if resolved.text == link.destination {
                        destination = urls.get(resolved.target).unwrap_or("");
                    }
                }
            } else if safe_url(link.destination) {
                destination = link.destination;
            }
            let label = if link.label.starts_with("`") && link.label.ends_with("`")
                && link.label.byte_len() >= 2 {
                "<code>" + escape_html(link.label.byte_slice(1, link.label.byte_len() - 1))
                    + "</code>"
            } else {
                escape_html(link.label)
            };
            rendered = if destination == "" {
                label
            } else {
                "<a href=\"" + escape_html(destination) + "\">" + label + "</a>"
            };
            end = link.end;
        }
        if end > cursor {
            result.write_string(escape_html(value.byte_slice(plain, cursor)));
            result.write_string(rendered);
            cursor = end;
            plain = end;
        } else {
            cursor += 1;
        }
    }
    result.write_string(escape_html(value.byte_slice(plain, value.byte_len())));
    result.finish()
}

pub fn render_markdown(value: string, links: Vec[query::DocLink], urls: HashMap[string, string]) -> string {
    let result = text::StringBuilder::new();
    let mut fenced = false;
    let mut paragraph = false;
    let mut list = false;
    for line in text::split(value, "\n") {
        if line.starts_with("```") {
            if paragraph {
                result.write_string("</p>\n");
                paragraph = false;
            }
            if list {
                result.write_string("</ul>\n");
                list = false;
            }
            result.write_string(
                if fenced {
                    "</code></pre>\n"
                } else {
                    "<pre><code>"
                },
            );
            fenced = !fenced;
        } else if fenced {
            result.write_string(escape_html(line) + "\n")
        } else if line == "" {
            if paragraph {
                result.write_string("</p>\n");
                paragraph = false;
            }
            if list {
                result.write_string("</ul>\n");
                list = false;
            }
        } else if line.starts_with("- ") || line.starts_with("* ") {
            if paragraph {
                result.write_string("</p>\n");
                paragraph = false;
            }
            if !list {
                result.write_string("<ul>\n");
                list = true;
            }
            result.write_string(
                "<li>" + inline_html(line.byte_slice(2, line.byte_len()), links, urls) + "</li>\n",
            )
        } else {
            if list {
                result.write_string("</ul>\n");
                list = false;
            }
            let mut level = 0;
            while level < line.byte_len() && line.byte_get(level) == b'#' {
                level += 1;
            }
            if level > 0 && level <= 6 && level < line.byte_len() && line.byte_get(level) == b' ' {
                if paragraph {
                    result.write_string("</p>\n");
                    paragraph = false;
                }
                let tag = (if level < 5 {
                    level + 1
                } else {
                    6
                }).to_string();
                result.write_string(
                    "<h" + tag + ">"
                        + inline_html(line.byte_slice(level + 1, line.byte_len()), links, urls)
                        + "</h"
                        + tag
                        + ">\n",
                )
            } else {
                result.write_string(
                    if paragraph {
                        "\n"
                    } else {
                        "<p>"
                    },
                );
                result.write_string(inline_html(line, links, urls));
                paragraph = true;
            }
        }
    }
    if fenced {
        result.write_string("</code></pre>\n")
    }
    if paragraph {
        result.write_string("</p>\n")
    }
    if list {
        result.write_string("</ul>\n")
    }
    result.finish()
}
