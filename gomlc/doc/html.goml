package doc;

use module::hash;
use module::query;
use std::text;

pub struct Page {
    pub name: string,
    pub content: string,
}

fn anchor(id: string) -> string {
    "item-" + hash::sha256_hex(id)
}

fn package_page(name: string) -> string {
    "package-" + hash::sha256_hex(name) + ".html"
}

fn type_page(item: query::DocItem) -> bool {
    item.kind == "struct" || item.kind == "enum" || item.kind == "trait"
}

fn item_page(item: query::DocItem, parent: string) -> string {
    if type_page(item) {
        "type-" + hash::sha256_hex(item.id) + ".html"
    } else {
        parent
    }
}

fn collect_urls(items: Vec[query::DocItem], page: string, urls: HashMap[string, string]) -> () {
    for item in items {
        let name = item_page(item, page);
        let _ = urls.insert(item.id, name + "#" + anchor(item.id));
        if item.qualified_name != item.id {
            let destination = name + "#" + anchor(item.id);
            let destination = match urls.get(item.qualified_name) {
                Some(previous) => if previous == destination {
                    destination
                } else {
                    ""
                },
                None => destination,
            };
            let _ = urls.insert(item.qualified_name, destination);
        }
        collect_urls(item.members, name, urls)
    }
}

fn page(title: string, body: string) -> string {
    "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>"
        + escape_html(title)
        + "</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><nav><a href=\"index.html\">Module index</a></nav><main><h1>"
        + escape_html(title)
        + "</h1>"
        + body
        + "</main><footer>Generated by gomldoc</footer></body></html>\n"
}

fn item_html(item: query::DocItem, urls: HashMap[string, string]) -> string {
    let result = text::StringBuilder::new();
    result.write_string(
        "<section id=\"" + anchor(item.id) + "\"><h2>" + escape_html(item.name) + "</h2><pre><code>"
            + escape_html(item.signature)
            + "</code></pre>",
    );
    if item.generated {
        result.write_string("<p class=\"source\">Generated API</p>")
    } else {
        result.write_string(
            "<p class=\"source\">" + escape_html(item.source) + ":" + item.line.to_string() + "</p>",
        )
    }
    if !item.public {
        result.write_string("<p>Private</p>")
    }
    if item.target != "" {
        result.write_string(
            "<p>"
                + if let Some(url) = urls.get(item.target) {
                    "<a href=\"" + escape_html(url) + "\">" + escape_html(item.target) + "</a>"
                } else {
                    escape_html(item.target)
                }
                + "</p>",
        )
    }
    result.write_string(render_markdown(item.documentation, item.links, urls));
    for member in item.members {
        result.write_string(item_html(member, urls))
    }
    result.write_string("</section>");
    result.finish()
}

pub fn render_html(value: query::DocModule) -> Vec[Page] {
    let pages = Vec::new();
    let urls: HashMap[string, string] = HashMap::new();
    for package_value in value.packages {
        let name = package_page(package_value.name);
        let _ = urls.insert(package_value.name, name);
        collect_urls(package_value.items, name, urls)
    }
    let index = text::StringBuilder::new();
    index.write_string("<ul>");
    for package_value in value.packages {
        let name = package_page(package_value.name);
        index.write_string(
            "<li><a href=\"" + name + "\">" + escape_html(package_value.name) + "</a></li>",
        );
        let body = text::StringBuilder::new();
        for section in package_value.sections {
            body.write_string(render_markdown(section.documentation, section.links, urls))
        }
        body.write_string("<ul>");
        for item in package_value.items {
            body.write_string(
                "<li><a href=\"" + urls.get(item.id).unwrap_or("") + "\">" + escape_html(item.name)
                    + "</a> <small>"
                    + escape_html(item.kind)
                    + "</small></li>",
            )
        }
        body.write_string("</ul>");
        for item in package_value.items {
            if type_page(item) {
                let content = text::StringBuilder::new();
                content.write_string(
                    "<p><a href=\"" + name + "\">" + escape_html(package_value.name) + "</a></p>",
                );
                content.write_string(item_html(item, urls));
                for implementation in package_value.items {
                    if implementation.kind == "impl" && implementation.target == item.qualified_name {
                        content.write_string(
                            "<p><a href=\"" + urls.get(implementation.id).unwrap_or("") + "\">"
                                + escape_html(implementation.signature)
                                + "</a></p>",
                        )
                    }
                }
                pages.push(
                    Page {
                        name: item_page(item, name),
                        content: page(item.qualified_name, content.finish()),
                    },
                )
            } else {
                body.write_string(item_html(item, urls))
            }
        }
        pages.push(Page { name, content: page(package_value.name, body.finish()) })
    }
    index.write_string("</ul>");
    pages.push(Page { name: "index.html", content: page(value.name, index.finish()) });
    pages.push(
        Page {
            name: "style.css",
            content: "body{font:16px/1.6 system-ui,sans-serif;max-width:76rem;margin:auto;padding:2rem;color:#202838;background:#fafbfc}a{color:#165eb0}pre{padding:1rem;background:#edf0f5;overflow:auto;border-radius:.4rem}code{font-family:ui-monospace,monospace}section{border-top:1px solid #d8dfe8;margin-top:2rem;padding-top:1rem}section section{margin-left:1rem}nav,footer,.source,small{color:#566175}footer{margin-top:3rem}h1,h2{overflow-wrap:anywhere}\n",
        },
    );
    pages
}
