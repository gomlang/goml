package doc;

use module::query;
use std::json;

fn links_json(links: Vec[query::DocLink]) -> json::Value {
    let values = Vec::new();
    for link in links {
        values.push(
            json::object(
                Vec::from_array(
                    [
                        ("text", json::Value::String(link.text)),
                        ("target", json::Value::String(link.target)),
                    ],
                ),
            ),
        )
    }
    json::Value::Array(values)
}

fn items_json(items: Vec[query::DocItem]) -> json::Value {
    let values = Vec::new();
    for item in items {
        values.push(
            json::object(
                Vec::from_array(
                    [
                        ("id", json::Value::String(item.id)),
                        ("name", json::Value::String(item.name)),
                        ("qualified_name", json::Value::String(item.qualified_name)),
                        ("kind", json::Value::String(item.kind)),
                        ("public", json::Value::Bool(item.public)),
                        ("signature", json::Value::String(item.signature)),
                        ("documentation", json::Value::String(item.documentation)),
                        ("source", json::Value::String(item.source)),
                        ("line", json::Value::Number(item.line.to_string())),
                        ("generated", json::Value::Bool(item.generated)),
                        ("target", json::Value::String(item.target)),
                        ("links", links_json(item.links)),
                        ("members", items_json(item.members)),
                    ],
                ),
            ),
        )
    }
    json::Value::Array(values)
}

pub fn render_json(value: query::DocModule) -> string {
    let packages = Vec::new();
    for package_value in value.packages {
        let sections = Vec::new();
        for section in package_value.sections {
            sections.push(
                json::object(
                    Vec::from_array(
                        [
                            ("source", json::Value::String(section.source)),
                            ("documentation", json::Value::String(section.documentation)),
                            ("links", links_json(section.links)),
                        ],
                    ),
                ),
            )
        }
        packages.push(
            json::object(
                Vec::from_array(
                    [
                        ("name", json::Value::String(package_value.name)),
                        ("documentation", json::Value::String(package_value.documentation)),
                        ("sections", json::Value::Array(sections)),
                        ("items", items_json(package_value.items)),
                    ],
                ),
            ),
        )
    }
    json::encode(
        json::object(
            Vec::from_array(
                [
                    ("schema_version", json::Value::Number("1")),
                    ("module", json::Value::String(value.name)),
                    ("packages", json::Value::Array(packages)),
                ],
            ),
        ),
    )
        + "\n"
}
