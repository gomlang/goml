package doc;

use module::query;
use std::json;
use std::testing;

#[test]
fn documentation_html_escapes_and_resolves_links() -> () {
    let urls: HashMap[string, string] = HashMap::new();
    let _ = urls.insert("sample::Value", "type.html#value");
    let links = Vec::from_array([query::DocLink { text: "Value", target: "sample::Value" }]);
    let rendered = render_markdown(
        "# Title\n\n<script>alert(1)</script> [Value] [bad](javascript:alert)\n\n- one\n- two\n\n```goml\na < b\n```",
        links,
        urls,
    );
    testing::assert(rendered.contains("&lt;script&gt;"));
    testing::assert(!rendered.contains("<script>"));
    testing::assert(!rendered.contains("href=\"javascript:"));
    testing::assert(rendered.contains("href=\"type.html#value\""));
    testing::assert(rendered.contains("<ul>"));
    testing::assert(rendered.contains("a &lt; b"));
}

#[test]
fn documentation_markdown_closes_blocks_in_order() -> () {
    let rendered = render_markdown(
        "a\nb\n- c\n* d\n# e\nf\n```goml\n<g>\n```\nh",
        Vec::new(),
        HashMap::new(),
    );
    testing::assert_eq(
        rendered,
        "<p>a\nb</p>\n<ul>\n<li>c</li>\n<li>d</li>\n</ul>\n<h2>e</h2>\n<p>f</p>\n<pre><code>&lt;g&gt;\n</code></pre>\n<p>h</p>\n",
    );
    for (source, expected) in[
        ("```goml\n<value>", "<pre><code>&lt;value&gt;\n</code></pre>\n"),
        ("- item\n```\ncode", "<ul>\n<li>item</li>\n</ul>\n<pre><code>code\n</code></pre>\n"),
        ("- item\n\ntext", "<ul>\n<li>item</li>\n</ul>\n<p>text</p>\n"),
        ("##### five\n###### six", "<h6>five</h6>\n<h6>six</h6>\n"),
        ("####### seven\n#no-space\n ", "<p>####### seven\n#no-space\n </p>\n"),
    ] {
        testing::assert_eq(render_markdown(source, Vec::new(), HashMap::new()), expected)
    }
}

fn documentation_item(id: string, kind: string, target: string) -> query::DocItem {
    query::DocItem {
        id,
        name: id,
        qualified_name: id,
        kind,
        public: true,
        signature: id,
        documentation: "",
        source: "source.goml",
        line: 1,
        generated: false,
        target,
        links: Vec::new(),
        members: Vec::new(),
    }
}

#[test]
fn documentation_type_pages_link_only_matching_implementations_in_order() -> () {
    let first = documentation_item("sample::First", "struct", "");
    let second = documentation_item("sample::Second", "enum", "");
    let first_impl = documentation_item("first_impl", "impl", first.qualified_name);
    let second_impl = documentation_item("second_impl", "impl", second.qualified_name);
    let later_impl = documentation_item("later_impl", "impl", first.qualified_name);
    let other = documentation_item("unrelated", "function", first.qualified_name);
    let package_value = query::DocPackage {
        name: "sample",
        documentation: "",
        sections: Vec::new(),
        items: Vec::from_array([first, first_impl, second_impl, second, later_impl, other]),
    };
    let pages = render_html(
        query::DocModule {
            name: "sample",
            packages: Vec::from_array([package_value]),
            warnings: Vec::new(),
        },
    );
    let package_name = package_page(package_value.name);
    testing::assert_eq(pages.len(), 5);
    testing::assert_eq(pages[0].name, item_page(first, package_name));
    testing::assert_eq(pages[1].name, item_page(second, package_name));
    testing::assert(
        pages[0].content.contains(
            "<p><a href=\"" + package_name + "#" + anchor(first_impl.id)
                + "\">first_impl</a></p><p><a href=\""
                + package_name
                + "#"
                + anchor(later_impl.id)
                + "\">later_impl</a></p>",
        ),
    );
    testing::assert(!pages[0].content.contains("second_impl"));
    testing::assert(!pages[0].content.contains("unrelated"));
    testing::assert(
        pages[1].content.contains(
            "<p><a href=\"" + package_name + "#" + anchor(second_impl.id) + "\">second_impl</a></p>",
        ),
    );
    testing::assert(!pages[1].content.contains("first_impl"));
    testing::assert(!pages[1].content.contains("later_impl"));
}

#[test]
fn documentation_json_has_versioned_schema() -> () {
    let value = query::DocModule { name: "example", packages: Vec::new(), warnings: Vec::new() };
    let encoded = testing::expect_ok(render_json(value), "documentation JSON");
    let parsed = json::parse(encoded).unwrap_or_else(
        |error| {
            testing::fail(error.to_string());
            loop {}
        },
    );
    testing::assert(json::field(parsed, "schema_version").and_then(json::as_int) == Option::Some(1));
    testing::assert_eq(testing::expect_ok(render_json(value), "documentation JSON"), encoded);
}

#[test]
fn documentation_json_preserves_nested_schema_and_escaping() -> () {
    let link = query::DocLink { text: "<Value>", target: "sample::Value" };
    let item = query::DocItem {
        id: "value",
        name: "Value",
        qualified_name: "sample::Value",
        kind: "struct",
        public: true,
        signature: "pub struct Value",
        documentation: "Quoted \"λ\"\n",
        source: "value.goml",
        line: 2,
        generated: false,
        target: "",
        links: Vec::from_array([link]),
        members: Vec::new(),
    };
    let package_value = query::DocPackage {
        name: "sample",
        documentation: "Package",
        sections: Vec::from_array(
            [
                query::DocSection {
                    source: "value.goml",
                    documentation: "Section",
                    links: Vec::from_array([link]),
                },
            ],
        ),
        items: Vec::from_array([item]),
    };
    let value = query::DocModule {
        name: "example",
        packages: Vec::from_array([package_value]),
        warnings: Vec::from_array(["internal warning"]),
    };
    let encoded = testing::expect_ok(render_json(value), "documentation JSON");
    let expected = "{\"schema_version\":1,\"module\":\"example\",\"packages\":[{\"name\":\"sample\",\"documentation\":\"Package\",\"sections\":[{\"source\":\"value.goml\",\"documentation\":\"Section\",\"links\":[{\"text\":\"<Value>\",\"target\":\"sample::Value\"}]}],\"items\":[{\"id\":\"value\",\"name\":\"Value\",\"qualified_name\":\"sample::Value\",\"kind\":\"struct\",\"public\":true,\"signature\":\"pub struct Value\",\"documentation\":\"Quoted \\\"λ\\\"\\n\",\"source\":\"value.goml\",\"line\":2,\"generated\":false,\"target\":\"\",\"links\":[{\"text\":\"<Value>\",\"target\":\"sample::Value\"}],\"members\":[]}]}]}\n";
    testing::assert_eq(encoded, expected);
}
