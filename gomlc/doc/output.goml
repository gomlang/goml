package doc;

use module::query;
use std::fs;
use std::path;

pub fn output_path(project: query::DocProject, requested: Option[string]) -> Result[string, string] {
    let output = path::absolute_structured(
        requested.unwrap_or(path::join(project.target_dir, "doc")),
    ).map_err(|error| error.to_string())?;
    let output = path::clean(output);
    if output == project.root || project.root.starts_with(output + "/") {
        return Result::Err("documentation output must not contain the module sources")
    }
    if fs::exists(output) {
        if fs::canonicalize(output).map_err(|error| error.to_string())? != output {
            return Result::Err("documentation output must not be a symbolic link")
        }
        if !fs::is_dir(output)
            || fs::read_file_structured(path::join(output, ".gomldoc")).unwrap_or("")
                != "gomldoc 1\n" {
            return Result::Err(
                "documentation output already exists and is not a gomldoc directory: " + output,
            )
        }
    }
    Result::Ok(output)
}

pub fn write_output(output: string, pages: Vec[Page]) -> Result[(), string] {
    let parent = path::parent(output).ok_or("documentation output has no parent")?;
    fs::create_dir_all(parent).map_err(|error| error.to_string())?;
    let parent = fs::canonicalize(parent).map_err(|error| error.to_string())?;
    let output = path::join(
        parent,
        path::file_name(output).ok_or("documentation output has no name")?,
    );
    let temporary = output + ".gomldoc-tmp";
    let backup = output + ".gomldoc-backup";
    if fs::exists(backup) {
        return Result::Err("documentation backup already exists: " + backup)
    }
    fs::create_dir(temporary).map_err(|error| error.to_string())?;
    defer {
        let _ = fs::remove_dir_all(temporary);
    };
    for page in pages {
        fs::write_file_structured(path::join(temporary, page.name), page.content).map_err(
            |error| error.to_string(),
        )?
    }
    fs::write_file_structured(path::join(temporary, ".gomldoc"), "gomldoc 1\n").map_err(
        |error| error.to_string(),
    )?;
    let existing = fs::exists(output);
    if existing {
        if fs::read_file_structured(path::join(output, ".gomldoc")).unwrap_or("") != "gomldoc 1\n" {
            return Result::Err("documentation output changed while generating")
        }
        fs::rename(output, backup).map_err(|error| error.to_string())?
    }
    if let Err(error) = fs::rename(temporary, output) {
        if existing {
            if let Err(restore) = fs::rename(backup, output) {
                return Result::Err(
                    error.to_string() + "; restore failed: " + restore.to_string()
                        + "; previous output: "
                        + backup,
                )
            }
        }
        return Result::Err(error.to_string())
    }
    if existing {
        fs::remove_dir_all(backup).map_err(|error| error.to_string())?
    }
    Result::Ok(())
}
