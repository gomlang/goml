package doc;

use module::query;
use std::json;
use json::Serialize;

#[derive(Serialize)]
struct DocOutput {
    schema_version: isize,
    #[serde(rename = "module")]
    name: string,
    packages: Vec[query::DocPackage],
}

pub fn render_json(value: query::DocModule) -> Result[string, string] {
    json::try_to_string(DocOutput { schema_version: 1, name: value.name, packages: value.packages }).map(
        |encoded| encoded + "\n",
    )
}
