package api;

use module::ast;
use module::ctir;
use module::ffi;
use module::tast;
use std::collections;
use std::json;
use std::text;

fn object(kind: string, fields: Vec[(string, json::Value)]) -> json::Value {
    let result = Vec::from_array([("kind", json::Value::String(kind))]);
    for field in fields {
        result.push(field)
    }
    Object(result)
}

fn strings(values: Vec[string]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(json::Value::String(value))
    }
    Array(result)
}

fn types(values: Vec[tast::Type]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(type_value(value))
    }
    Array(result)
}

fn named_types(values: Vec[(string, tast::Type)]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push((value.0, type_value(value.1)))
    }
    Object(result)
}

fn trait_value(value: tast::TraitRef) -> json::Value {
    object(
        "trait",
        Vec::from_array([("name", json::Value::String(value.name)), ("args", types(value.args))]),
    )
}

fn traits(values: Vec[tast::TraitRef]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(trait_value(value))
    }
    sorted_values(result)
}

fn sorted_values(values: Vec[json::Value]) -> json::Value {
    for index in 0..values.len() {
        values[index] = canonical(values[index]);
    }
    collections::sort_by(
        values,
        |left, right| {
            let a = json::encode(left);
            let b = json::encode(right);
            if a < b {
                -1
            } else if a > b {
                1
            } else {
                0
            }
        },
    );
    Array(values)
}

fn predicates(values: Vec[tast::TypePredicate]) -> json::Value {
    let result = Vec::new();
    for value in values {
        result.push(
            match value {
                GoComparable(ty) => object(
                    "go_comparable",
                    Vec::from_array([("type", type_value(ty))]),
                ),
                Trait { for_ty, trait_ref } => object(
                    "trait",
                    Vec::from_array(
                        [("type", type_value(for_ty)), ("trait", trait_value(trait_ref))],
                    ),
                ),
                Equality { lhs, rhs } => object(
                    "equality",
                    Vec::from_array([("left", type_value(lhs)), ("right", type_value(rhs))]),
                ),
            },
        )
    }
    sorted_values(result)
}

fn type_value(value: tast::Type) -> json::Value {
    match tast::resolve_type(value) {
        External { import_path, name, args } => object(
            "external",
            Vec::from_array(
                [
                    ("import", json::Value::String(import_path)),
                    ("name", json::Value::String(name)),
                    ("args", types(args)),
                ],
            ),
        ),
        Con { name } => object("named", Vec::from_array([("name", json::Value::String(name))])),
        Param { name } => object(
            "parameter",
            Vec::from_array([("name", json::Value::String(name))]),
        ),
        Tuple { items } => object("tuple", Vec::from_array([("items", types(items))])),
        Func { params, ret_ty } => object(
            "function",
            Vec::from_array([("parameters", types(params)), ("result", type_value(ret_ty))]),
        ),
        App { ty, args } => object(
            "application",
            Vec::from_array([("type", type_value(ty)), ("args", types(args))]),
        ),
        Array { len, elem } => object(
            "array",
            Vec::from_array(
                [("length", json::Value::Number(len.to_string())), ("element", type_value(elem))],
            ),
        ),
        Slice { elem } => object("slice", Vec::from_array([("element", type_value(elem))])),
        MutSlice { elem } => object(
            "mutable_slice",
            Vec::from_array([("element", type_value(elem))]),
        ),
        VecType { elem } => object("vec", Vec::from_array([("element", type_value(elem))])),
        GoPointer { elem } => object("go_pointer", Vec::from_array([("element", type_value(elem))])),
        RefType { elem } => object("reference", Vec::from_array([("element", type_value(elem))])),
        GoFunction { signature } => object(
            "go_function",
            Vec::from_array([("signature", type_value(signature))]),
        ),
        HashMap { key, value } => object(
            "hash_map",
            Vec::from_array([("key", type_value(key)), ("value", type_value(value))]),
        ),
        GoMap { key, value } => object(
            "go_map",
            Vec::from_array([("key", type_value(key)), ("value", type_value(value))]),
        ),
        Channel { elem, direction } => object(
            "channel",
            Vec::from_array(
                [
                    ("element", type_value(elem)),
                    (
                        "direction",
                        json::Value::String(
                            match direction {
                                ast::ChannelDirection::Both => "both",
                                ast::ChannelDirection::Send => "send",
                                ast::ChannelDirection::Receive => "receive",
                            },
                        ),
                    ),
                ],
            ),
        ),
        Projection { for_ty, name, trait_ref } => object(
            "projection",
            Vec::from_array(
                [
                    ("type", type_value(for_ty)),
                    ("name", json::Value::String(name)),
                    ("trait", trait_ref.map(trait_value).unwrap_or(json::Value::Null)),
                ],
            ),
        ),
        Dyn { trait_name, args, associated_types, additional_bounds } => {
            let bounds = Vec::new();
            for bound in additional_bounds {
                bounds.push(
                    object(
                        "bound",
                        Vec::from_array(
                            [
                                ("name", json::Value::String(bound.trait_name)),
                                ("args", types(bound.args)),
                                ("associated_types", named_types(bound.associated_types)),
                            ],
                        ),
                    ),
                )
            }
            object(
                "dyn",
                Vec::from_array(
                    [
                        ("name", json::Value::String(trait_name)),
                        ("args", types(args)),
                        ("associated_types", named_types(associated_types)),
                        ("bounds", sorted_values(bounds)),
                    ],
                ),
            )
        },
        _ => object(
            "primitive",
            Vec::from_array([("name", json::Value::String(tast::type_text(value)))]),
        ),
    }
}

fn comparability(value: ffi::GoComparability) -> json::Value {
    match value {
        Always => object("always", Vec::new()),
        Never => object("never", Vec::new()),
        Unknown => object("unknown", Vec::new()),
        Parameter(index) => object(
            "parameter",
            Vec::from_array([("index", json::Value::Number(index.to_string()))]),
        ),
        All(values) => {
            let result = Vec::new();
            for value in values {
                result.push(comparability(value))
            }
            object("all", Vec::from_array([("requirements", sorted_values(result))]))
        },
    }
}

fn receiver_name(value: tast::Type) -> string {
    match tast::resolve_type(value) {
        Con { name } => name,
        App { .. } => tast::type_text(value),
        _ => tast::type_text(value),
    }
}

fn constant_value(value: tast::Primitive) -> json::Value {
    let builder = text::StringBuilder::new();
    tast::write_primitive(builder, value);
    json::Value::String(builder.finish())
}

fn compile_time_values(values: Vec[ctir::CtValue]) -> Result[json::Value, string] {
    let result = Vec::new();
    for value in values {
        result.push(compile_time_value(value)?)
    }
    Ok(json::Value::Array(result))
}

fn compile_time_value(value: ctir::CtValue) -> Result[json::Value, string] {
    Ok(
        match value {
            Unit => object("unit", Vec::new()),
            Bool(value) => object("bool", Vec::from_array([("value", json::Value::Bool(value))])),
            Integer { signed, width, bits } => object(
                "integer",
                Vec::from_array(
                    [
                        ("signed", json::Value::Bool(signed)),
                        ("width", json::Value::Number(width.to_string())),
                        ("bits", json::Value::String(bits.to_string())),
                    ],
                ),
            ),
            String(value) => object(
                "string",
                Vec::from_array([("value", json::Value::String(value))]),
            ),
            Char(value) => object(
                "char",
                Vec::from_array([("value", json::Value::String(value.to_string()))]),
            ),
            Tuple(values) => object(
                "tuple",
                Vec::from_array([("items", compile_time_values(values)?)]),
            ),
            Array(values) => object(
                "array",
                Vec::from_array([("items", compile_time_values(values)?)]),
            ),
            Struct { name, fields } => object(
                "struct",
                Vec::from_array(
                    [("name", json::Value::String(name)), ("fields", compile_time_values(fields)?)],
                ),
            ),
            Enum { name, variant, fields } => object(
                "enum",
                Vec::from_array(
                    [
                        ("name", json::Value::String(name)),
                        ("variant", json::Value::Number(variant.to_string())),
                        ("fields", compile_time_values(fields)?),
                    ],
                ),
            ),
            _ => return Err("API snapshot cannot represent a dynamic compile-time constant"),
        },
    )
}
