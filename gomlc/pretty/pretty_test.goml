package pretty;

use std::testing;
use std::text as std_text;

fn assert_pretty(width: isize, value: Doc, expected: string) -> () {
    testing::assert_eq(pretty(width, value), expected)
}

#[test]
fn nil_is_the_unit_of_append() -> () {
    let value = append(text("left"), nest(2, append(line(), text("right"))));
    testing::assert_eq(layout(append(nil(), value)), layout(value));
    testing::assert_eq(layout(append(value, nil())), layout(value))
}

#[test]
fn append_is_associative() -> () {
    let first = text("a");
    let second = nest(2, append(line(), text("b")));
    let third = append(line(), text("c"));
    let left = append(append(first, second), third);
    let right = append(first, append(second, third));
    testing::assert_eq(layout(left), layout(right));
    testing::assert_eq(
        layout(left),
        \\a
        \\  b
        \\c
        ,
    )
}

#[test]
fn nesting_only_changes_indentation_after_a_line() -> () {
    testing::assert_eq(layout(nest(4, text("start"))), "start");
    testing::assert_eq(
        layout(append(nest(2, append(line(), text("inside"))), append(line(), text("outside")))),
        \\
        \\  inside
        \\outside
        ,
    );
    testing::assert_eq(layout(nest(2, line())), "\n  ")
}

#[test]
fn nesting_distributes_and_adds() -> () {
    let left = append(text("a"), append(line(), append(text("b"), append(line(), text("c")))));
    let distributed = append(
        nest(3, text("a")),
        nest(3, append(line(), append(text("b"), append(line(), text("c"))))),
    );
    testing::assert_eq(layout(nest(3, left)), layout(distributed));
    testing::assert_eq(layout(nest(2, nest(3, left))), layout(nest(5, left)));
    testing::assert_eq(layout(nest(-4, left)), layout(left))
}

#[test]
fn text_normalizes_embedded_newlines() -> () {
    testing::assert_eq(
        layout(
            nest(
                2,
                text(
                    \\a
                    \\b
                    \\
                    ,
                ),
            ),
        ),
        \\a
        \\  b
        \\  
        ,
    );
    testing::assert_eq(layout(text("")), "");
    testing::assert_eq(
        pretty(
            20,
            group(
                text(
                    \\a
                    \\b
                    ,
                ),
            ),
        ),
        "a b",
    )
}

#[test]
fn group_uses_flat_layout_exactly_at_the_width() -> () {
    let value = group(above(text("abc"), text("de")));
    assert_pretty(6, value, "abc de");
    assert_pretty(
        5,
        value,
        \\abc
        \\de
        ,
    );
    assert_pretty(
        0,
        value,
        \\abc
        \\de
        ,
    )
}

#[test]
fn group_accounts_for_the_existing_column() -> () {
    let value = append(text("xx"), group(above(text("abc"), text("d"))));
    assert_pretty(7, value, "xxabc d");
    assert_pretty(
        6,
        value,
        \\xxabc
        \\d
        ,
    )
}

#[test]
fn nested_groups_choose_independently() -> () {
    let value = group(above(text("a"), group(above(text("bb"), text("cc")))));
    assert_pretty(7, value, "a bb cc");
    assert_pretty(
        6,
        value,
        \\a
        \\bb cc
        ,
    );
    assert_pretty(
        4,
        value,
        \\a
        \\bb
        \\cc
        ,
    );
    testing::assert_eq(pretty(4, group(value)), pretty(4, value))
}

#[test]
fn unavoidable_overflow_uses_the_shorter_first_line() -> () {
    let value = group(above(text("abcdefgh"), text("x")));
    assert_pretty(
        3,
        value,
        \\abcdefgh
        \\x
        ,
    )
}

#[test]
fn concat_join_and_folddoc_cover_empty_and_nil_elements() -> () {
    testing::assert_eq(layout(concat(Vec::new())), "");
    testing::assert_eq(layout(concat(Vec::from_array([text("a"), nil(), text("b")]))), "ab");
    testing::assert_eq(layout(join(text(","), Vec::new())), "");
    testing::assert_eq(
        layout(join(text(","), Vec::from_array([text("a"), nil(), text("b")]))),
        "a,,b",
    );
    testing::assert_eq(
        layout(folddoc(above, Vec::from_array([text("a"), text("b"), text("c")]))),
        \\a
        \\b
        \\c
        ,
    );
    testing::assert_eq(layout(folddoc(append, Vec::new())), "");
    testing::assert_eq(layout(folddoc(append, Vec::from_array([text("only")]))), "only")
}

#[test]
fn spread_stack_beside_and_above_match_the_paper() -> () {
    testing::assert_eq(layout(spread(Vec::from_array([text("a"), text("b"), text("c")]))), "a b c");
    testing::assert_eq(
        layout(stack(Vec::from_array([text("a"), text("b"), text("c")]))),
        \\a
        \\b
        \\c
        ,
    );
    testing::assert_eq(layout(beside(text("a"), text("b"))), "a b");
    testing::assert_eq(
        layout(above(text("a"), text("b"))),
        \\a
        \\b
        ,
    )
}

#[test]
fn softline_and_bracket_have_flat_and_broken_layouts() -> () {
    let soft = append(text("a"), append(softline(), text("b")));
    assert_pretty(3, soft, "a b");
    assert_pretty(
        2,
        soft,
        \\a
        \\b
        ,
    );
    assert_pretty(3, soft_beside(text("a"), text("b")), "a b");
    assert_pretty(
        2,
        soft_beside(text("a"), text("b")),
        \\a
        \\b
        ,
    );
    let value = bracket("[", spread(Vec::from_array([text("a"), text("b")])), "]");
    assert_pretty(7, value, "[ a b ]");
    assert_pretty(
        6,
        value,
        \\[
        \\  a b
        \\]
        ,
    )
}

#[test]
fn fill_greedily_packs_plain_documents() -> () {
    let value = fill(Vec::from_array([text("aaa"), text("bb"), text("c"), text("dddd")]));
    assert_pretty(100, value, "aaa bb c dddd");
    assert_pretty(
        6,
        value,
        \\aaa bb
        \\c dddd
        ,
    );
    assert_pretty(
        5,
        value,
        \\aaa
        \\bb c
        \\dddd
        ,
    );
    testing::assert_eq(pretty(5, group(value)), pretty(5, value));
    testing::assert_eq(pretty(5, fill(Vec::new())), "");
    testing::assert_eq(pretty(5, fill(Vec::from_array([text("only")]))), "only")
}

#[test]
fn fill_flattens_a_document_only_when_put_beside_another() -> () {
    let element = group(above(text("<em>"), above(text("word"), text("</em>"))));
    let value = fill(Vec::from_array([text("before"), element, text("after")]));
    assert_pretty(40, value, "before <em> word </em> after");
    assert_pretty(
        16,
        value,
        \\before
        \\<em> word </em>
        \\after
        ,
    );
    assert_pretty(
        13,
        value,
        \\before
        \\<em>
        \\word
        \\</em>
        \\after
        ,
    )
}

#[test]
fn fill_copies_its_input_vector() -> () {
    let values = Vec::from_array([text("a"), text("b")]);
    let value = fill(values);
    values.set(0, text("changed"));
    testing::assert_eq(pretty(20, value), "a b")
}

#[test]
fn fillwords_collapses_ascii_whitespace() -> () {
    let value = fillwords("  alpha\tbeta\n gamma\r\n ");
    assert_pretty(40, value, "alpha beta gamma");
    assert_pretty(
        10,
        value,
        \\alpha beta
        \\gamma
        ,
    );
    testing::assert_eq(pretty(10, fillwords(" \n\t ")), "")
}

#[test]
fn unicode_width_is_counted_in_scalars_not_bytes() -> () {
    testing::assert_eq(text_width("语言a"), 3);
    let value = group(above(text("语言"), text("a")));
    assert_pretty(4, value, "语言 a");
    assert_pretty(
        3,
        value,
        \\语言
        \\a
        ,
    )
}

enum Tree {
    Node(string, Vec[Tree]),
}

fn show_tree(value: Tree) -> Doc {
    match value {
        Node(label, children) => group(
            append(text(label), nest(text_width(label), show_bracket(children))),
        ),
    }
}

fn show_bracket(values: Vec[Tree]) -> Doc {
    if values.is_empty() {
        nil()
    } else {
        append(text("["), append(nest(1, show_trees(values, 0)), text("]")))
    }
}

fn show_trees(values: Vec[Tree], index: isize) -> Doc {
    if index + 1 >= values.len() {
        show_tree(values.get(index))
    } else {
        append(
            show_tree(values.get(index)),
            append(text(","), append(line(), show_trees(values, index + 1))),
        )
    }
}

fn paper_tree() -> Tree {
    Tree::Node(
        "aaa",
        Vec::from_array(
            [
                Tree::Node(
                    "bbbbb",
                    Vec::from_array([Tree::Node("ccc", Vec::new()), Tree::Node("dd", Vec::new())]),
                ),
                Tree::Node("eee", Vec::new()),
                Tree::Node(
                    "ffff",
                    Vec::from_array(
                        [
                            Tree::Node("gg", Vec::new()),
                            Tree::Node("hhh", Vec::new()),
                            Tree::Node("ii", Vec::new()),
                        ],
                    ),
                ),
            ],
        ),
    )
}

#[test]
fn reproduces_wadlers_tree_example_at_width_30() -> () {
    testing::assert_eq(
        pretty(30, show_tree(paper_tree())),
        \\aaa[bbbbb[ccc, dd],
        \\    eee,
        \\    ffff[gg, hhh, ii]]
        ,
    )
}

#[test]
fn explicit_work_stack_handles_deep_left_association() -> () {
    let mut value = nil();
    for _ in 0..5000 {
        value = append(value, text("x"));
    }
    testing::assert_eq(pretty(80, value).byte_len(), 5000)
}

#[test]
fn fill_is_constructed_lazily_for_many_choices() -> () {
    let values: Vec[Doc] = Vec::new();
    for _ in 0..250 {
        values.push(text("x"))
    }
    let rendered = pretty(9, fill(values));
    let lines = std_text::lines(rendered);
    testing::assert_eq(lines.len(), 50);
    for value in lines {
        testing::assert_eq(value, "x x x x x")
    }
}

#[test]
fn doc_methods_are_equivalent_to_functions() -> () {
    let with_functions = pretty(3, group(append(text("a"), nest(2, append(line(), text("b"))))));
    let with_methods = text("a").then(line().then(text("b")).indented(2)).grouped().render(3);
    testing::assert_eq(with_methods, with_functions)
}

#[test]
fn hard_lines_and_break_lines_have_distinct_flat_layouts() -> () {
    let with_space = group(append(text("a"), append(line(), text("b"))));
    let without_space = group(append(text("a"), append(break_line(), text("b"))));
    let forced = group(append(text("a"), append(hardline(), text("b"))));
    testing::assert_eq(pretty(10, with_space), "a b");
    testing::assert_eq(pretty(10, without_space), "ab");
    testing::assert_eq(
        pretty(10, forced),
        \\a
        \\b
        ,
    )
}

#[test]
fn delimited_and_block_build_structured_documents() -> () {
    let arguments = delimited("(", ",", ")", Vec::from_array([text("first"), text("second")]));
    testing::assert_eq(pretty(20, arguments), "(first, second)");
    testing::assert_eq(
        pretty(8, arguments),
        \\(
        \\  first,
        \\  second
        \\)
        ,
    );
    let body = block(text("fn main()"), Vec::from_array([text("first"), text("second")]));
    testing::assert_eq(
        layout(body),
        \\fn main() {
        \\  first
        \\  second
        \\}
        ,
    )
}

#[test]
fn compact_uses_the_fully_flat_layout() -> () {
    let value = enclose(
        "(",
        join(append(text(","), line()), Vec::from_array([text("a"), text("b")])),
        ")",
    );
    testing::assert_eq(compact(value), "(a, b)")
}
