package pretty;

use std::testing;
use std::text as std_text;

#[test]
fn quoted_strings_preserve_unicode_and_escape_delimiters_and_controls() -> () {
    let builder = std_text::StringBuilder::new();
    write_quoted_string(builder, "\"\\\n\r\t\u0000\u0001\u001f\u007fé中😀");
    testing::assert_eq(builder.to_string(), "\"\\\"\\\\\\n\\r\\t\\0\\u{1}\\u{1f}\\u{7f}é中😀\"")
}

#[test]
fn quoted_characters_preserve_unicode_and_escape_delimiters_and_controls() -> () {
    for value in Vec::from_array(
        [
            ('\'', "'\\''"),
            ('"', "'\"'"),
            ('\\', "'\\\\'"),
            ('\n', "'\\n'"),
            ('\r', "'\\r'"),
            ('\t', "'\\t'"),
            ('\u0000', "'\\0'"),
            ('\u0001', "'\\u{1}'"),
            ('\u001f', "'\\u{1f}'"),
            ('\u007f', "'\\u{7f}'"),
            ('é', "'é'"),
            ('中', "'中'"),
            ('😀', "'😀'"),
        ],
    ) {
        let builder = std_text::StringBuilder::new();
        write_quoted_char(builder, value.0);
        testing::assert_eq(builder.to_string(), value.1)
    }
}
